// USA Faction Units - Complete unit definitions for C&C Generals Zero Hour
// Based on original INI files and Thyme source code
// Implements all USA infantry, vehicles, and aircraft

const std = @import("std")
const math = @import("math")

// Import game systems
import engine/unit_system {UnitDefinition, UnitCategory, create_unit_definition}
import engine/combat_system {DamageType, ArmorType}
import engine/locomotor {LocomotorType}
import engine/veterancy {VeterancyLevel}

// ============================================================================
// USA Infantry Units
// ============================================================================

pub const USA_RANGER: UnitDefinition = blk: {
    var unit = create_unit_definition("AmericaInfantryRanger", .INFANTRY)
    unit.display_name = "Ranger"
    unit.faction = .USA

    // Combat stats
    unit.max_health = 100.0
    unit.armor_type = .INFANTRY
    unit.vision_range = 150.0
    unit.stealth_detect_range = 0.0

    // Movement
    unit.speed = 30.0
    unit.turn_rate = 500.0
    unit.can_crush_infantry = false
    unit.locomotor_type = .INFANTRY

    // Weapons
    unit.primary_weapon = "RangerGun"
    unit.secondary_weapon = ""

    // Production
    unit.build_cost = 225
    unit.build_time = 5.0
    unit.prerequisite = "AmericaBarracks"

    // Experience
    unit.experience_value = 25

    // Audio
    unit.select_sound = "RangerVoiceSelect"
    unit.move_sound = "RangerVoiceMove"
    unit.attack_sound = "RangerVoiceAttack"
    unit.death_sound = "InfantryDeath"

    // Model
    unit.model_name = "AVRanger"
    unit.portrait_image = "SARanger"
    unit.button_image = "SARanger"

    // Special
    unit.garrison_slots = 1
    unit.transport_slots = 1
    unit.can_capture = true
    unit.can_heal = false

    break :blk unit
}

