// ============================================================================
// USA Unit Registry
// ============================================================================

pub const USA_UNIT_COUNT: usize = 15

pub const USA_UNITS: [USA_UNIT_COUNT]*const UnitDefinition = .{
    // Infantry
    &USA_RANGER,
    &USA_MISSILE_DEFENDER,
    &USA_PATHFINDER,
    &USA_COLONEL_BURTON,
    &USA_PILOT,
    // Vehicles
    &USA_HUMVEE,
    &USA_CRUSADER_TANK,
    &USA_PALADIN_TANK,
    &USA_TOMAHAWK_LAUNCHER,
    // Aircraft
    &USA_COMANCHE,
    &USA_CHINOOK,
    &USA_RAPTOR,
    &USA_STEALTH_FIGHTER,
    &USA_AURORA_BOMBER,
    &USA_B52_STRATOFORTRESS,
}

pub fn getUSAUnit(name: []const u8) ?*const UnitDefinition {
    for (USA_UNITS) |unit| {
        if (std.mem.eql(u8, unit.name, name)) {
            return unit
        }
    }
    return null
}

pub fn getUSAUnitByDisplayName(display_name: []const u8) ?*const UnitDefinition {
    for (USA_UNITS) |unit| {
        if (std.mem.eql(u8, unit.display_name, display_name)) {
            return unit
        }
    }
    return null
}

// ============================================================================
// Tests
// ============================================================================

test "USA unit definitions" {
    // Test Ranger
    try std.testing.expect(USA_RANGER.max_health == 100.0)
    try std.testing.expect(USA_RANGER.build_cost == 225)
    try std.testing.expect(USA_RANGER.category == .INFANTRY)

    // Test Crusader
    try std.testing.expect(USA_CRUSADER_TANK.max_health == 400.0)
    try std.testing.expect(USA_CRUSADER_TANK.can_crush_infantry == true)
    try std.testing.expect(USA_CRUSADER_TANK.category == .VEHICLE)

    // Test Colonel Burton (Hero)
    try std.testing.expect(USA_COLONEL_BURTON.armor_type == .HERO)
    try std.testing.expect(USA_COLONEL_BURTON.max_health == 500.0)
}

test "USA unit lookup" {
    const ranger = getUSAUnit("AmericaInfantryRanger")
    try std.testing.expect(ranger != null)
    try std.testing.expect(std.mem.eql(u8, ranger.?.display_name, "Ranger"))

    const unknown = getUSAUnit("NonExistentUnit")
    try std.testing.expect(unknown == null)
}
