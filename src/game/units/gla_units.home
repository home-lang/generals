// GLA Faction Units - Complete unit definitions for C&C Generals Zero Hour
// Based on original INI files and Thyme source code
// Implements all GLA infantry, vehicles, and aircraft

const std = @import("std")
const math = @import("math")

import engine/unit_system {UnitDefinition, UnitCategory, create_unit_definition}
import engine/combat_system {DamageType, ArmorType}
import engine/locomotor {LocomotorType}

// ============================================================================
// GLA Infantry Units
// ============================================================================

pub const GLA_REBEL: UnitDefinition = blk: {
    var unit = create_unit_definition("GLAInfantryRebel", .INFANTRY)
    unit.display_name = "Rebel"
    unit.faction = .GLA

    unit.max_health = 100.0
    unit.armor_type = .INFANTRY
    unit.vision_range = 100.0

    unit.speed = 25.0
    unit.turn_rate = 500.0
    unit.locomotor_type = .INFANTRY

    unit.primary_weapon = "RebelGun"
    unit.secondary_weapon = ""

    unit.build_cost = 150
    unit.build_time = 3.0
    unit.prerequisite = "GLABarracks"

    unit.experience_value = 15

    unit.select_sound = "RebelVoiceSelect"
    unit.move_sound = "RebelVoiceMove"
    unit.attack_sound = "RebelVoiceAttack"
    unit.death_sound = "InfantryDeath"

    unit.model_name = "GVRebel"
    unit.portrait_image = "SGRebel"
    unit.button_image = "SGRebel"

    unit.garrison_slots = 1
    unit.transport_slots = 1
    unit.can_capture = true
    unit.can_heal = false

    break :blk unit
}

