// ============================================================================
// GLA Unit Registry
// ============================================================================

pub const GLA_UNIT_COUNT: usize = 12

pub const GLA_UNITS: [GLA_UNIT_COUNT]*const UnitDefinition = .{
    // Infantry
    &GLA_REBEL,
    &GLA_RPG_TROOPER,
    &GLA_TERRORIST,
    &GLA_HIJACKER,
    &GLA_JARMEN_KELL,
    // Vehicles
    &GLA_TECHNICAL,
    &GLA_SCORPION_TANK,
    &GLA_MARAUDER_TANK,
    &GLA_QUAD_CANNON,
    &GLA_ROCKET_BUGGY,
    &GLA_SCUD_LAUNCHER,
    &GLA_BOMB_TRUCK,
}

pub fn getGLAUnit(name: []const u8) ?*const UnitDefinition {
    for (GLA_UNITS) |unit| {
        if (std.mem.eql(u8, unit.name, name)) {
            return unit
        }
    }
    return null
}

pub fn getGLAUnitByDisplayName(display_name: []const u8) ?*const UnitDefinition {
    for (GLA_UNITS) |unit| {
        if (std.mem.eql(u8, unit.display_name, display_name)) {
            return unit
        }
    }
    return null
}

// ============================================================================
// Tests
// ============================================================================

test "GLA unit definitions" {
    // Test Rebel - cheap basic infantry
    try std.testing.expect(GLA_REBEL.max_health == 100.0)
    try std.testing.expect(GLA_REBEL.build_cost == 150)
    try std.testing.expect(GLA_REBEL.can_capture == true)

    // Test Technical - fast transport
    try std.testing.expect(GLA_TECHNICAL.speed == 90.0)
    try std.testing.expect(GLA_TECHNICAL.transport_slots == 5)

    // Test Bomb Truck - suicide vehicle
    try std.testing.expect(GLA_BOMB_TRUCK.build_cost == 1200)

    // Test Jarmen Kell (Hero)
    try std.testing.expect(GLA_JARMEN_KELL.armor_type == .HERO)
    try std.testing.expect(GLA_JARMEN_KELL.vision_range == 400.0)
}

test "GLA unit lookup" {
    const scorpion = getGLAUnit("GLAVehicleScorpion")
    try std.testing.expect(scorpion != null)
    try std.testing.expect(std.mem.eql(u8, scorpion.?.display_name, "Scorpion Tank"))
}
