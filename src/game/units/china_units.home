// ============================================================================
// China Unit Registry
// ============================================================================

pub const CHINA_UNIT_COUNT: usize = 11

pub const CHINA_UNITS: [CHINA_UNIT_COUNT]*const UnitDefinition = .{
    // Infantry
    &CHINA_RED_GUARD,
    &CHINA_TANK_HUNTER,
    &CHINA_HACKER,
    &CHINA_BLACK_LOTUS,
    // Vehicles
    &CHINA_BATTLEMASTER,
    &CHINA_DRAGON_TANK,
    &CHINA_OVERLORD,
    &CHINA_INFERNO_CANNON,
    &CHINA_NUKE_CANNON,
    // Aircraft
    &CHINA_MIG,
    &CHINA_HELIX,
}

pub fn getChinaUnit(name: []const u8) ?*const UnitDefinition {
    for (CHINA_UNITS) |unit| {
        if (std.mem.eql(u8, unit.name, name)) {
            return unit
        }
    }
    return null
}

pub fn getChinaUnitByDisplayName(display_name: []const u8) ?*const UnitDefinition {
    for (CHINA_UNITS) |unit| {
        if (std.mem.eql(u8, unit.display_name, display_name)) {
            return unit
        }
    }
    return null
}

// ============================================================================
// Tests
// ============================================================================

test "China unit definitions" {
    // Test Red Guard - spawns 2 for cost
    try std.testing.expect(CHINA_RED_GUARD.max_health == 80.0)
    try std.testing.expect(CHINA_RED_GUARD.build_cost == 300)

    // Test Overlord - heavy tank
    try std.testing.expect(CHINA_OVERLORD.max_health == 1100.0)
    try std.testing.expect(CHINA_OVERLORD.armor_type == .HEAVY_VEHICLE)
    try std.testing.expect(CHINA_OVERLORD.can_crush_infantry == true)

    // Test Black Lotus (Hero)
    try std.testing.expect(CHINA_BLACK_LOTUS.armor_type == .HERO)
    try std.testing.expect(CHINA_BLACK_LOTUS.can_capture == true)
}

test "China unit lookup" {
    const battlemaster = getChinaUnit("ChinaVehicleBattlemaster")
    try std.testing.expect(battlemaster != null)
    try std.testing.expect(std.mem.eql(u8, battlemaster.?.display_name, "Battlemaster Tank"))
}
