// China Faction Units - Complete unit definitions for C&C Generals Zero Hour
// Based on original INI files and Thyme source code
// Implements all China infantry, vehicles, and aircraft

const std = @import("std")
const math = @import("math")

import engine/unit_system {UnitDefinition, UnitCategory, create_unit_definition}
import engine/combat_system {DamageType, ArmorType}
import engine/locomotor {LocomotorType}

// ============================================================================
// China Infantry Units
// ============================================================================

pub const CHINA_RED_GUARD: UnitDefinition = blk: {
    var unit = create_unit_definition("ChinaInfantryRedGuard", .INFANTRY)
    unit.display_name = "Red Guard"
    unit.faction = .CHINA

    unit.max_health = 80.0
    unit.armor_type = .INFANTRY
    unit.vision_range = 120.0

    unit.speed = 28.0
    unit.turn_rate = 500.0
    unit.locomotor_type = .INFANTRY

    unit.primary_weapon = "RedGuardGun"
    unit.secondary_weapon = ""

    unit.build_cost = 300  // Spawns 2 at once
    unit.build_time = 5.0
    unit.prerequisite = "ChinaBarracks"

    unit.experience_value = 20

    unit.select_sound = "RedGuardVoiceSelect"
    unit.move_sound = "RedGuardVoiceMove"
    unit.attack_sound = "RedGuardVoiceAttack"
    unit.death_sound = "InfantryDeath"

    unit.model_name = "CVRedGuard"
    unit.portrait_image = "SCRedGuard"
    unit.button_image = "SCRedGuard"

    unit.garrison_slots = 1
    unit.transport_slots = 1
    unit.can_capture = true
    unit.can_heal = false

    break :blk unit
}

