// C&C Generals Zero Hour - Home Port
// Radar and Fog of War System
//
// Original: Radar.cpp (~49KB - Westwood Studios/EA)
// Manages visibility, fog of war, and radar functionality
//
// The fog of war system tracks:
// - What each player has seen (explored but not currently visible)
// - What each player can currently see (units provide vision)
// - Radar coverage (special buildings provide enhanced vision)
// - Shroud (completely unexplored areas)

import basics/allocator
import engine/math

let MAP_SIZE: u32 = 512
let FOG_TILE_SIZE: u32 = 8  // Each fog tile is 8x8 units
let FOG_MAP_SIZE: u32 = MAP_SIZE / FOG_TILE_SIZE  // 64x64 fog tiles

// Visibility state for a fog tile
enum VisibilityState {
    Shroud      // Never seen (black)
    Fog         // Seen but not currently visible (gray)
    Visible     // Currently visible (clear)
}

// Fog of war tile
struct FogTile {
    visibility: [VisibilityState]  // One per player
    explored: [bool]               // Has player ever seen this tile?
    visible_unit_count: [u32]      // Number of units providing vision

    fn init(): FogTile {
        return FogTile {
            visibility: []
            explored: []
            visible_unit_count: []
        }
    }

    fn add_visibility(self, player_id: u32) {
        if player_id >= 8 {
            return
        }

        self.visible_unit_count[player_id] += 1
        self.visibility[player_id] = VisibilityState.Visible
        self.explored[player_id] = true
    }

    fn remove_visibility(self, player_id: u32) {
        if player_id >= 8 {
            return
        }

        if self.visible_unit_count[player_id] > 0 {
            self.visible_unit_count[player_id] -= 1
        }

        if self.visible_unit_count[player_id] == 0 {
            if self.explored[player_id] {
                self.visibility[player_id] = VisibilityState.Fog
            } else {
                self.visibility[player_id] = VisibilityState.Shroud
            }
        }
    }

    fn is_visible(&self, player_id: u32): bool {
        if player_id >= 8 {
            return false
        }
        return self.visibility[player_id] == VisibilityState.Visible
    }

    fn is_explored(&self, player_id: u32): bool {
        if player_id >= 8 {
            return false
        }
        return self.explored[player_id]
    }

    fn reveal(self, player_id: u32) {
        if player_id >= 8 {
            return
        }
        self.explored[player_id] = true
        self.visibility[player_id] = VisibilityState.Visible
    }

    fn shroud(self, player_id: u32) {
        if player_id >= 8 {
            return
        }
        self.explored[player_id] = false
        self.visibility[player_id] = VisibilityState.Shroud
        self.visible_unit_count[player_id] = 0
    }
}

// Vision provider (unit or building that provides sight)
struct VisionProvider {
    id: u32
    position: Vec3
    sight_range: f32
    player_id: u32
    is_active: bool

    // Special vision types
    has_radar: bool        // Can see through fog
    reveals_stealth: bool  // Can see stealth units

    fn init(id: u32, position: Vec3, sight_range: f32, player_id: u32): VisionProvider {
        return VisionProvider {
            id: id
            position: position
            sight_range: sight_range
            player_id: player_id
            is_active: true
            has_radar: false
            reveals_stealth: false
        }
    }
}

// Radar object - represents an object on the minimap radar
// @bugfix xezon 22/11/2025 (#1893) - Heroes now stored in separate list
// to prevent dangling cached hero data causing undefined behavior
struct RadarObject {
    object_id: u32
    position: Vec3
    player_id: u32
    is_active: bool
    is_hero: bool           // Is this object a hero unit?
    is_local_player: bool   // Belongs to local player?
    icon_type: i32          // Radar icon to display
    color: u32              // RGBA color for radar blip
    next: ?*RadarObject     // Linked list pointer
}

fn create_radar_object(object_id: u32, position: Vec3, player_id: u32, is_hero: bool): RadarObject {
    return RadarObject {
        object_id: object_id,
        position: position,
        player_id: player_id,
        is_active: true,
        is_hero: is_hero,
        is_local_player: false,
        icon_type: 0,
        color: 0xFFFFFFFF,
        next: null,
    }
}

// Radar system
struct RadarSystem {
    // Fog of war map
    fog_map: [[FogTile]]

    // Vision providers (units and buildings)
    vision_providers: [VisionProvider]
    vision_provider_count: u32
    next_provider_id: u32

    // Radar object lists
    // @bugfix xezon 22/11/2025 (#1893) - Separate lists for different object types
    // to prevent hero cache dangling issues from retail version
    object_list: ?*RadarObject           // All non-local objects
    local_object_list: ?*RadarObject     // Local player objects (non-hero)
    local_hero_object_list: ?*RadarObject // Local player hero objects (NEW - fixes #1893)

    // Radar objects pool
    radar_objects: [RadarObject]
    radar_object_count: u32
    max_radar_objects: u32

    // Local player tracking
    local_player_id: u32

    // Map bounds
    map_min: Vec3
    map_max: Vec3
    tile_size: f32

    // Radar state
    radar_hidden: [bool]     // Per-player radar visibility
    radar_force_on: [bool]   // Per-player forced radar

    // Terrain data for radar rendering
    terrain_average_z: f32
    water_average_z: f32

    allocator: Allocator

    fn init(allocator: Allocator, map_size: f32): RadarSystem {
        return RadarSystem {
            fog_map: []
            vision_providers: []
            vision_provider_count: 0
            next_provider_id: 1
            object_list: null
            local_object_list: null
            local_hero_object_list: null
            radar_objects: []
            radar_object_count: 0
            max_radar_objects: 4096
            local_player_id: 0
            map_min: Vec3.init(0.0, 0.0, 0.0)
            map_max: Vec3.init(map_size, map_size, 0.0)
            tile_size: @intToFloat(f32, FOG_TILE_SIZE)
            radar_hidden: []
            radar_force_on: []
            terrain_average_z: 0.0
            water_average_z: 0.0
            allocator: allocator
        }
    }

    // Add object to radar
    // @bugfix xezon 22/11/2025 (#1893) - Heroes go to separate list
    // Returns true if object was added to radar
    fn add_object(self, object_id: u32, position: Vec3, player_id: u32, is_hero: bool): bool {
        if self.radar_object_count >= self.max_radar_objects {
            return false
        }

        let is_local = player_id == self.local_player_id

        // Create radar object
        let radar_obj = create_radar_object(object_id, position, player_id, is_hero)
        radar_obj.is_local_player = is_local

        // Store in pool
        self.radar_objects[self.radar_object_count] = radar_obj
        let obj_ptr = &self.radar_objects[self.radar_object_count]
        self.radar_object_count += 1

        // Add to appropriate list based on type
        // @bugfix (#1893): Local heroes go to their own list to prevent cache issues
        if is_local {
            if is_hero {
                // Add to local hero list (NEW - fixes dangling cache bug)
                obj_ptr.next = self.local_hero_object_list
                self.local_hero_object_list = obj_ptr
            } else {
                // Add to local non-hero list
                obj_ptr.next = self.local_object_list
                self.local_object_list = obj_ptr
            }
        } else {
            // Add to general object list
            obj_ptr.next = self.object_list
            self.object_list = obj_ptr
        }

        return true
    }

    // Remove object from radar
    // @bugfix xezon 22/11/2025 (#1893) - Properly removes from hero list
    fn remove_object(self, object_id: u32): bool {
        // Try to remove from each list
        if self.remove_from_list(&self.object_list, object_id) {
            return true
        }
        if self.remove_from_list(&self.local_object_list, object_id) {
            return true
        }
        // @bugfix (#1893): Also check hero list
        if self.remove_from_list(&self.local_hero_object_list, object_id) {
            return true
        }
        return false
    }

    fn remove_from_list(self, list: *?*RadarObject, object_id: u32): bool {
        let prev: ?*RadarObject = null
        let current = list.*

        while current != null {
            if current.?.object_id == object_id {
                // Remove from list
                if prev != null {
                    prev.?.next = current.?.next
                } else {
                    list.* = current.?.next
                }
                current.?.is_active = false
                return true
            }
            prev = current
            current = current.?.next
        }
        return false
    }

    // Delete all radar object resources
    // @bugfix xezon 22/11/2025 (#1893) - Simplified version
    fn delete_list_resources(self) {
        self.object_list = null
        self.local_object_list = null
        self.local_hero_object_list = null
        self.radar_object_count = 0
    }

    // Set local player for radar
    fn set_local_player(self, player_id: u32) {
        self.local_player_id = player_id
    }

    // Hide/show radar for a player
    fn hide_radar(self, player_index: u32, hide: bool) {
        if player_index < 8 {
            self.radar_hidden[player_index] = hide
        }
    }

    // Force radar on for a player
    fn force_radar_on(self, player_index: u32, force: bool) {
        if player_index < 8 {
            self.radar_force_on[player_index] = force
        }
    }

    // Check if radar is visible for player
    fn is_radar_visible(self, player_index: u32): bool {
        if player_index >= 8 {
            return false
        }
        if self.radar_force_on[player_index] {
            return true
        }
        return !self.radar_hidden[player_index]
    }

    fn world_to_fog_coords(&self, world_pos: Vec3): (u32, u32) {
        let x = @floatToInt(u32, world_pos.x / self.tile_size)
        let y = @floatToInt(u32, world_pos.z / self.tile_size)

        // Clamp to map bounds
        let clamped_x = if x >= FOG_MAP_SIZE { FOG_MAP_SIZE - 1 } else { x }
        let clamped_y = if y >= FOG_MAP_SIZE { FOG_MAP_SIZE - 1 } else { y }

        return (clamped_x, clamped_y)
    }

    fn register_vision_provider(self, position: Vec3, sight_range: f32, player_id: u32): u32 {
        if self.vision_provider_count >= 4096 {
            return 0
        }

        let provider_id = self.next_provider_id
        self.next_provider_id += 1

        self.vision_providers[self.vision_provider_count] = VisionProvider.init(
            provider_id,
            position,
            sight_range,
            player_id
        )
        self.vision_provider_count += 1

        // Add initial vision
        self.add_vision_circle(position, sight_range, player_id)

        return provider_id
    }

    fn unregister_vision_provider(self, provider_id: u32) {
        for i in 0..self.vision_provider_count {
            if self.vision_providers[i].id == provider_id {
                // Remove vision before removing provider
                self.remove_vision_circle(
                    self.vision_providers[i].position,
                    self.vision_providers[i].sight_range,
                    self.vision_providers[i].player_id
                )

                // Shift remaining providers
                for j in i..(self.vision_provider_count - 1) {
                    self.vision_providers[j] = self.vision_providers[j + 1]
                }
                self.vision_provider_count -= 1
                return
            }
        }
    }

    fn update_vision_provider(self, provider_id: u32, new_position: Vec3) {
        for i in 0..self.vision_provider_count {
            if self.vision_providers[i].id == provider_id {
                let old_pos = self.vision_providers[i].position
                let range = self.vision_providers[i].sight_range
                let player_id = self.vision_providers[i].player_id

                // Remove old vision
                self.remove_vision_circle(old_pos, range, player_id)

                // Update position
                self.vision_providers[i].position = new_position

                // Add new vision
                self.add_vision_circle(new_position, range, player_id)
                return
            }
        }
    }

    fn add_vision_circle(self, center: Vec3, radius: f32, player_id: u32) {
        let radius_tiles = @floatToInt(u32, radius / self.tile_size) + 1

        let (center_x, center_y) = self.world_to_fog_coords(center)

        for dy in 0..(radius_tiles * 2) {
            let y = if dy < radius_tiles {
                if center_y < dy { 0 } else { center_y - dy }
            } else {
                center_y + (dy - radius_tiles)
            }

            if y >= FOG_MAP_SIZE {
                continue
            }

            for dx in 0..(radius_tiles * 2) {
                let x = if dx < radius_tiles {
                    if center_x < dx { 0 } else { center_x - dx }
                } else {
                    center_x + (dx - radius_tiles)
                }

                if x >= FOG_MAP_SIZE {
                    continue
                }

                // Check if within circle
                let tile_center_x = (@intToFloat(f32, x) + 0.5) * self.tile_size
                let tile_center_y = (@intToFloat(f32, y) + 0.5) * self.tile_size
                let tile_center = Vec3.init(tile_center_x, 0.0, tile_center_y)

                let distance = Vec3.distance(center, tile_center)
                if distance <= radius {
                    self.fog_map[y][x].add_visibility(player_id)
                }
            }
        }
    }

    fn remove_vision_circle(self, center: Vec3, radius: f32, player_id: u32) {
        let radius_tiles = @floatToInt(u32, radius / self.tile_size) + 1

        let (center_x, center_y) = self.world_to_fog_coords(center)

        for dy in 0..(radius_tiles * 2) {
            let y = if dy < radius_tiles {
                if center_y < dy { 0 } else { center_y - dy }
            } else {
                center_y + (dy - radius_tiles)
            }

            if y >= FOG_MAP_SIZE {
                continue
            }

            for dx in 0..(radius_tiles * 2) {
                let x = if dx < radius_tiles {
                    if center_x < dx { 0 } else { center_x - dx }
                } else {
                    center_x + (dx - radius_tiles)
                }

                if x >= FOG_MAP_SIZE {
                    continue
                }

                // Check if within circle
                let tile_center_x = (@intToFloat(f32, x) + 0.5) * self.tile_size
                let tile_center_y = (@intToFloat(f32, y) + 0.5) * self.tile_size
                let tile_center = Vec3.init(tile_center_x, 0.0, tile_center_y)

                let distance = Vec3.distance(center, tile_center)
                if distance <= radius {
                    self.fog_map[y][x].remove_visibility(player_id)
                }
            }
        }
    }

    fn is_position_visible(&self, position: Vec3, player_id: u32): bool {
        let (x, y) = self.world_to_fog_coords(position)
        return self.fog_map[y][x].is_visible(player_id)
    }

    fn is_position_explored(&self, position: Vec3, player_id: u32): bool {
        let (x, y) = self.world_to_fog_coords(position)
        return self.fog_map[y][x].is_explored(player_id)
    }

    fn get_visibility_state(&self, position: Vec3, player_id: u32): VisibilityState {
        let (x, y) = self.world_to_fog_coords(position)
        if player_id >= 8 {
            return VisibilityState.Shroud
        }
        return self.fog_map[y][x].visibility[player_id]
    }

    fn reveal_area(self, center: Vec3, radius: f32, player_id: u32) {
        let radius_tiles = @floatToInt(u32, radius / self.tile_size) + 1
        let (center_x, center_y) = self.world_to_fog_coords(center)

        for dy in 0..(radius_tiles * 2) {
            let y = if dy < radius_tiles {
                if center_y < dy { 0 } else { center_y - dy }
            } else {
                center_y + (dy - radius_tiles)
            }

            if y >= FOG_MAP_SIZE {
                continue
            }

            for dx in 0..(radius_tiles * 2) {
                let x = if dx < radius_tiles {
                    if center_x < dx { 0 } else { center_x - dx }
                } else {
                    center_x + (dx - radius_tiles)
                }

                if x >= FOG_MAP_SIZE {
                    continue
                }

                let tile_center_x = (@intToFloat(f32, x) + 0.5) * self.tile_size
                let tile_center_y = (@intToFloat(f32, y) + 0.5) * self.tile_size
                let tile_center = Vec3.init(tile_center_x, 0.0, tile_center_y)

                let distance = Vec3.distance(center, tile_center)
                if distance <= radius {
                    self.fog_map[y][x].reveal(player_id)
                }
            }
        }
    }

    fn reveal_all(self, player_id: u32) {
        for y in 0..FOG_MAP_SIZE {
            for x in 0..FOG_MAP_SIZE {
                self.fog_map[y][x].reveal(player_id)
            }
        }
    }

    fn shroud_all(self, player_id: u32) {
        for y in 0..FOG_MAP_SIZE {
            for x in 0..FOG_MAP_SIZE {
                self.fog_map[y][x].shroud(player_id)
            }
        }
    }

    fn get_exploration_percentage(&self, player_id: u32): f32 {
        let mut explored_count: u32 = 0
        let total_tiles = FOG_MAP_SIZE * FOG_MAP_SIZE

        for y in 0..FOG_MAP_SIZE {
            for x in 0..FOG_MAP_SIZE {
                if self.fog_map[y][x].is_explored(player_id) {
                    explored_count += 1
                }
            }
        }

        return @intToFloat(f32, explored_count) / @intToFloat(f32, total_tiles)
    }
}

// Global radar system
var g_radar_system: ?RadarSystem = null

export fn init_radar_system(allocator: Allocator, map_size: f32) {
    g_radar_system = RadarSystem.init(allocator, map_size)
    println("RadarSystem: System initialized")
}

export fn shutdown_radar_system() {
    g_radar_system = null
    println("RadarSystem: System shutdown")
}

export fn register_vision_provider(position: Vec3, sight_range: f32, player_id: u32): u32 {
    if g_radar_system {
        return g_radar_system.?.register_vision_provider(position, sight_range, player_id)
    }
    return 0
}

export fn unregister_vision_provider(provider_id: u32) {
    if g_radar_system {
        g_radar_system.?.unregister_vision_provider(provider_id)
    }
}

export fn update_vision_provider(provider_id: u32, new_position: Vec3) {
    if g_radar_system {
        g_radar_system.?.update_vision_provider(provider_id, new_position)
    }
}

export fn is_position_visible(position: Vec3, player_id: u32): bool {
    if g_radar_system {
        return g_radar_system.?.is_position_visible(position, player_id)
    }
    return false
}

export fn reveal_map_area(center: Vec3, radius: f32, player_id: u32) {
    if g_radar_system {
        g_radar_system.?.reveal_area(center, radius, player_id)
    }
}

fn get_global_allocator(): Allocator {
    // TODO: Return global allocator
    return Allocator {}
}
