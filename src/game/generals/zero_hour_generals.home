// ============================================================================
// General Registry
// ============================================================================

pub const GENERAL_COUNT: usize = 9

pub const ALL_GENERALS: [GENERAL_COUNT]*const GeneralDefinition = .{
    // USA Generals
    &USA_AIR_FORCE_GENERAL,
    &USA_LASER_GENERAL,
    &USA_SUPERWEAPON_GENERAL,
    // China Generals
    &CHINA_TANK_GENERAL,
    &CHINA_INFANTRY_GENERAL,
    &CHINA_NUKE_GENERAL,
    // GLA Generals
    &GLA_TOXIN_GENERAL,
    &GLA_DEMOLITION_GENERAL,
    &GLA_STEALTH_GENERAL,
}

pub fn getGeneral(name: []const u8) ?*const GeneralDefinition {
    for (ALL_GENERALS) |gen| {
        if (std.mem.eql(u8, gen.name, name)) {
            return gen
        }
    }
    return null
}

pub fn getGeneralsByFaction(faction: GeneralFaction) [3]*const GeneralDefinition {
    switch (faction) {
        .USA => return .{&USA_AIR_FORCE_GENERAL, &USA_LASER_GENERAL, &USA_SUPERWEAPON_GENERAL},
        .CHINA => return .{&CHINA_TANK_GENERAL, &CHINA_INFANTRY_GENERAL, &CHINA_NUKE_GENERAL},
        .GLA => return .{&GLA_TOXIN_GENERAL, &GLA_DEMOLITION_GENERAL, &GLA_STEALTH_GENERAL},
    }
}

// ============================================================================
// Unique Units Registry
// ============================================================================

pub const GENERALS_UNIQUE_UNITS: []*const UnitDefinition = &.{
    // USA Air Force
    &KING_RAPTOR,
    &COMBAT_CHINOOK,
    // USA Laser
    &LASER_TANK,
    // China Tank
    &EMPEROR_OVERLORD,
    // China Infantry
    &MINI_GUNNER,
    // China Nuke
    &NUKE_MIG,
    // GLA Toxin
    &TOXIN_REBEL,
    &TOXIN_TRACTOR,
    // GLA Demolition
    &COMBAT_CYCLE,
    // GLA Stealth
    &STEALTH_REBEL,
    &GPS_SCRAMBLER,
}

// ============================================================================
// Tests
// ============================================================================

test "General definitions" {
    try std.testing.expect(USA_AIR_FORCE_GENERAL.faction == .USA)
    try std.testing.expect(CHINA_TANK_GENERAL.faction == .CHINA)
    try std.testing.expect(GLA_STEALTH_GENERAL.faction == .GLA)

    // Check unique units exist
    try std.testing.expect(KING_RAPTOR.build_cost == 1100)
    try std.testing.expect(EMPEROR_OVERLORD.max_health == 1400.0)
    try std.testing.expect(STEALTH_REBEL.is_stealthed == true)
}

test "General lookup" {
    const gen = getGeneral("USAAirForceGeneral")
    try std.testing.expect(gen != null)
    try std.testing.expect(std.mem.eql(u8, gen.?.display_name, "Air Force General"))
}
