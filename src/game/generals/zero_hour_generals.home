// Zero Hour Generals - Complete general definitions for C&C Generals Zero Hour
// Based on original INI files and Thyme source code
// Implements all 9 generals with unique units, abilities, and bonuses

const std = @import("std")
const math = @import("math")

import engine/unit_system {UnitDefinition, UnitCategory, create_unit_definition}
import engine/building_system {BuildingDefinition, BuildingCategory, create_building_definition}
import engine/combat_system {DamageType, ArmorType}

// ============================================================================
// General Definition Types
// ============================================================================

pub const GeneralFaction = enum {
    USA,
    CHINA,
    GLA,
}

pub const GeneralType = enum {
    // USA Generals
    USA_AIR_FORCE,
    USA_LASER,
    USA_SUPERWEAPON,
    // China Generals
    CHINA_TANK,
    CHINA_INFANTRY,
    CHINA_NUKE,
    // GLA Generals
    GLA_TOXIN,
    GLA_DEMOLITION,
    GLA_STEALTH,
}

pub const GeneralAbility = struct {
    name: []const u8,
    display_name: []const u8,
    description: []const u8,
    generals_points_cost: u8,
    cooldown: f32,
    icon: []const u8,
}

pub const GeneralBonus = struct {
    name: []const u8,
    description: []const u8,
    modifier_type: BonusType,
    modifier_value: f32,
}

pub const BonusType = enum {
    DAMAGE_BONUS,
    ARMOR_BONUS,
    SPEED_BONUS,
    BUILD_SPEED_BONUS,
    COST_REDUCTION,
    RANGE_BONUS,
    RATE_OF_FIRE_BONUS,
    VETERANCY_BONUS,
}

pub const GeneralDefinition = struct {
    name: []const u8,
    display_name: []const u8,
    faction: GeneralFaction,
    general_type: GeneralType,
    description: []const u8,
    portrait: []const u8,

    // Unique units this general has
    unique_units: []const []const u8,
    // Units this general cannot build
    disabled_units: []const []const u8,
    // Unique buildings
    unique_buildings: []const []const u8,
    // Buildings this general cannot build
    disabled_buildings: []const []const u8,

    // Passive bonuses
    bonuses: []const GeneralBonus,

    // Special abilities unlocked through generals points
    abilities: []const GeneralAbility,

    // Starting generals points
    starting_points: u8,
}

pub fn create_general_definition(name: []const u8, faction: GeneralFaction, general_type: GeneralType) GeneralDefinition {
    return GeneralDefinition{
        .name = name,
        .display_name = "",
        .faction = faction,
        .general_type = general_type,
        .description = "",
        .portrait = "",
        .unique_units = &[_][]const u8{},
        .disabled_units = &[_][]const u8{},
        .unique_buildings = &[_][]const u8{},
        .disabled_buildings = &[_][]const u8{},
        .bonuses = &[_]GeneralBonus{},
        .abilities = &[_]GeneralAbility{},
        .starting_points = 1,
    }
}

// ============================================================================
// USA Air Force General - Malcolm "Ace" Granger
// ============================================================================

pub const USA_AIR_FORCE_GENERAL: GeneralDefinition = blk: {
    var gen = create_general_definition("USAAirForceGeneral", .USA, .USA_AIR_FORCE)
    gen.display_name = "Air Force General"
    gen.description = "General Malcolm 'Ace' Granger commands the most powerful air force in the world."
    gen.portrait = "GeneralGranger"

    gen.unique_units = &[_][]const u8{
        "KingRaptor",        // Upgraded Raptor with point defense laser
        "CombatChinook",     // Armed transport helicopter
        "StealthComanche",   // Stealth-capable Comanche
    }

    gen.disabled_units = &[_][]const u8{
        "Crusader",
        "Paladin",
        "Tomahawk",
    }

    gen.bonuses = &[_]GeneralBonus{
        GeneralBonus{
            .name = "AircraftCostReduction",
            .description = "All aircraft cost 20% less",
            .modifier_type = .COST_REDUCTION,
            .modifier_value = 0.20,
        },
        GeneralBonus{
            .name = "AircraftArmorBonus",
            .description = "All aircraft have 25% more armor",
            .modifier_type = .ARMOR_BONUS,
            .modifier_value = 0.25,
        },
    }

    gen.abilities = &[_]GeneralAbility{
        GeneralAbility{
            .name = "CarpetBomb",
            .display_name = "Carpet Bomb",
            .description = "B-52 drops a line of bombs across the target area",
            .generals_points_cost = 3,
            .cooldown = 240.0,
            .icon = "SCarpetBomb",
        },
        GeneralAbility{
            .name = "SpecterGunship",
            .display_name = "Spectre Gunship",
            .description = "Call in a Spectre gunship to circle and provide fire support",
            .generals_points_cost = 3,
            .cooldown = 300.0,
            .icon = "SSpectreGunship",
        },
    }

    break :blk gen
}

