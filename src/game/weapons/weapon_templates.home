// Weapon Templates - Complete weapon definitions for C&C Generals Zero Hour
// Based on original INI files and Thyme source code
// Implements all weapons for infantry, vehicles, aircraft, and buildings

const std = @import("std")
const math = @import("math")

import engine/combat_system {DamageType, ArmorType}

// ============================================================================
// Weapon System Types
// ============================================================================

pub const WeaponCategory = enum {
    SMALL_ARMS,        // Rifles, pistols, SMGs
    HEAVY_ARMS,        // Machine guns, gatling
    ANTI_ARMOR,        // Rockets, tank guns
    ARTILLERY,         // Mortars, howitzers
    MISSILE,           // Guided missiles
    FLAME,             // Flamethrowers
    LASER,             // Laser weapons
    TOXIN,             // Chemical weapons
    RADIATION,         // Nuclear weapons
    EXPLOSIVE,         // Bombs, C4
    MELEE,             // Close combat
    SPECIAL,           // Unique abilities
}

pub const ProjectileType = enum {
    INSTANT,           // Hitscan
    BULLET,            // Fast projectile
    ROCKET,            // Guided/unguided rockets
    MISSILE,           // Smart missiles
    SHELL,             // Artillery shells
    GRENADE,           // Arcing grenades
    FLAME,             // Flame stream
    LASER_BEAM,        // Continuous laser
    BOMB,              // Dropped bombs
    TOXIN_STREAM,      // Toxin spray
    RADIATION,         // Radiation effect
    NONE,              // No projectile (melee)
}

pub const DamageDelivery = enum {
    SINGLE_TARGET,     // Hits one unit
    AREA_OF_EFFECT,    // Splash damage
    LINE,              // Damages units in a line
    CONE,              // Cone-shaped damage
    CONTINUOUS,        // Damage over time
}

pub const TargetType = enum {
    GROUND,
    AIR,
    GROUND_AND_AIR,
    STRUCTURE_ONLY,
    INFANTRY_ONLY,
    VEHICLE_ONLY,
}

pub const WeaponDefinition = struct {
    name: []const u8,
    display_name: []const u8,
    category: WeaponCategory,
    projectile_type: ProjectileType,
    damage_delivery: DamageDelivery,
    target_type: TargetType,

    // Damage stats
    damage: f32,
    damage_type: DamageType,
    damage_radius: f32,  // For AOE weapons
    damage_scalar_vs_infantry: f32,
    damage_scalar_vs_vehicle: f32,
    damage_scalar_vs_structure: f32,
    damage_scalar_vs_aircraft: f32,

    // Range and accuracy
    min_range: f32,
    max_range: f32,
    accuracy: f32,  // 0-1, affects scatter

    // Rate of fire
    rate_of_fire: f32,  // Shots per second
    clip_size: u16,
    reload_time: f32,
    pre_attack_delay: f32,
    firing_duration: f32,  // For continuous weapons

    // Projectile properties
    projectile_speed: f32,
    projectile_arc: f32,  // For arcing projectiles
    projectile_model: []const u8,
    impact_fx: []const u8,
    muzzle_fx: []const u8,

    // Special effects
    leaves_residue: bool,
    residue_type: []const u8,
    residue_duration: f32,
    can_scatter: bool,
    scatter_radius: f32,

    // Audio
    fire_sound: []const u8,
    impact_sound: []const u8,
}

pub fn create_weapon_definition(name: []const u8, category: WeaponCategory) WeaponDefinition {
    return WeaponDefinition{
        .name = name,
        .display_name = "",
        .category = category,
        .projectile_type = .BULLET,
        .damage_delivery = .SINGLE_TARGET,
        .target_type = .GROUND,

        .damage = 10.0,
        .damage_type = .SMALL_ARMS,
        .damage_radius = 0.0,
        .damage_scalar_vs_infantry = 1.0,
        .damage_scalar_vs_vehicle = 1.0,
        .damage_scalar_vs_structure = 1.0,
        .damage_scalar_vs_aircraft = 1.0,

        .min_range = 0.0,
        .max_range = 100.0,
        .accuracy = 1.0,

        .rate_of_fire = 1.0,
        .clip_size = 0,
        .reload_time = 0.0,
        .pre_attack_delay = 0.0,
        .firing_duration = 0.0,

        .projectile_speed = 999999.0,  // Instant by default
        .projectile_arc = 0.0,
        .projectile_model = "",
        .impact_fx = "",
        .muzzle_fx = "",

        .leaves_residue = false,
        .residue_type = "",
        .residue_duration = 0.0,
        .can_scatter = false,
        .scatter_radius = 0.0,

        .fire_sound = "",
        .impact_sound = "",
    }
}

