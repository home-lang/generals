// ============================================================================
// Weapon Registry
// ============================================================================

pub const WEAPON_COUNT: usize = 54

pub const ALL_WEAPONS: [WEAPON_COUNT]*const WeaponDefinition = .{
    // USA Small Arms
    &RANGER_GUN,
    &RANGER_FLASHBANG,
    &MISSILE_DEFENDER_ROCKET,
    &PATHFINDER_SNIPER,
    &COLONEL_BURTON_GUN,
    &COLONEL_BURTON_KNIFE,
    &REMOTE_DEMO_CHARGE,
    // USA Vehicle
    &HUMVEE_GUN,
    &TOW_MISSILE,
    &CRUSADER_CANNON,
    &PALADIN_CANNON,
    &PALADIN_LASER,
    &TOMAHAWK_MISSILE,
    // USA Aircraft
    &COMANCHE_GUN,
    &COMANCHE_ROCKET,
    &RAPTOR_MISSILE,
    &AURORA_BOMB,
    // USA Defense
    &PATRIOT_MISSILE,
    // China Infantry
    &RED_GUARD_GUN,
    &TANK_HUNTER_ROCKET,
    &TANK_HUNTER_TNT,
    // China Vehicle
    &BATTLEMASTER_CANNON,
    &DRAGON_TANK_FLAME,
    &DRAGON_TANK_FIREWALL,
    &OVERLORD_CANNON,
    &INFERNO_CANNON_SHELL,
    &NUKE_CANNON_SHELL,
    // China Aircraft
    &MIG_MISSILE,
    &MIG_NAPALM,
    &HELIX_NAPALM,
    // China Defense
    &GATTLING_CANNON_GUN,
    // GLA Infantry
    &REBEL_GUN,
    &RPG_TROOPER_ROCKET,
    &TERRORIST_BOMB,
    &JARMEN_KELL_SNIPER,
    &JARMEN_KELL_VEHICLE_SNIPE,
    // GLA Vehicle
    &TECHNICAL_GUN,
    &SCORPION_CANNON,
    &SCORPION_ROCKET,
    &MARAUDER_CANNON,
    &QUAD_CANNON_GUN,
    &ROCKET_BUGGY_ROCKETS,
    &SCUD_LAUNCHER_MISSILE,
    &SCUD_ANTHRAX_MISSILE,
    &BOMB_TRUCK_BOMB,
    &BOMB_TRUCK_BIO_BOMB,
    // GLA Defense
    &STINGER_MISSILE,
    &TUNNEL_RPG,
    &DEMO_TRAP_EXPLOSION,
    // Superweapons
    &PARTICLE_CANNON_BEAM,
    &NUCLEAR_MISSILE_STRIKE,
    &SCUD_STORM_MISSILES,
}

pub fn getWeapon(name: []const u8) ?*const WeaponDefinition {
    for (ALL_WEAPONS) |wpn| {
        if (std.mem.eql(u8, wpn.name, name)) {
            return wpn
        }
    }
    return null
}

pub fn getWeaponsByCategory(category: WeaponCategory) []*const WeaponDefinition {
    var result: [64]*const WeaponDefinition = undefined
    var count: usize = 0

    for (ALL_WEAPONS) |wpn| {
        if (wpn.category == category) {
            result[count] = wpn
            count += 1
        }
    }

    return result[0..count]
}

// ============================================================================
// Tests
// ============================================================================

test "Weapon definitions" {
    // Test damage values
    try std.testing.expect(RANGER_GUN.damage == 8.0)
    try std.testing.expect(PATHFINDER_SNIPER.damage == 500.0)
    try std.testing.expect(NUCLEAR_MISSILE_STRIKE.damage == 2000.0)

    // Test weapon categories
    try std.testing.expect(RANGER_GUN.category == .SMALL_ARMS)
    try std.testing.expect(DRAGON_TANK_FLAME.category == .FLAME)
    try std.testing.expect(SCUD_STORM_MISSILES.category == .TOXIN)

    // Test range values
    try std.testing.expect(PATHFINDER_SNIPER.max_range == 300.0)
    try std.testing.expect(TOMAHAWK_MISSILE.min_range == 100.0)
}

test "Weapon lookup" {
    const wpn = getWeapon("RangerGun")
    try std.testing.expect(wpn != null)
    try std.testing.expect(wpn.?.damage == 8.0)
}
