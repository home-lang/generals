// ============================================================================
// China Building Registry
// ============================================================================

pub const CHINA_BUILDING_COUNT: usize = 10

pub const CHINA_BUILDINGS: [CHINA_BUILDING_COUNT]*const BuildingDefinition = .{
    &CHINA_COMMAND_CENTER,
    &CHINA_NUCLEAR_REACTOR,
    &CHINA_BARRACKS,
    &CHINA_WAR_FACTORY,
    &CHINA_AIRFIELD,
    &CHINA_SUPPLY_CENTER,
    &CHINA_PROPAGANDA_CENTER,
    &CHINA_NUCLEAR_MISSILE,
    &CHINA_GATTLING_CANNON,
    &CHINA_BUNKER,
}

pub fn getChinaBuilding(name: []const u8) ?*const BuildingDefinition {
    for (CHINA_BUILDINGS) |bld| {
        if (std.mem.eql(u8, bld.name, name)) {
            return bld
        }
    }
    return null
}

// ============================================================================
// Tests
// ============================================================================

test "China building definitions" {
    try std.testing.expect(CHINA_COMMAND_CENTER.max_health == 2500.0)
    try std.testing.expect(CHINA_NUCLEAR_REACTOR.power_production == 10)
    try std.testing.expect(CHINA_NUCLEAR_MISSILE.power_consumption == 10)
    try std.testing.expect(CHINA_BUNKER.garrison_slots == 5)
}
