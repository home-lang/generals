pub const CHINA_COMMAND_CENTER: BuildingDefinition = blk: {
    var bld = create_building_definition("ChinaCommandCenter", .COMMAND)
    bld.display_name = "Command Center"
    bld.faction = .CHINA

    bld.max_health = 2500.0
    bld.armor_type = .STRUCTURE
    bld.vision_range = 200.0

    bld.build_cost = 2000
    bld.build_time = 30.0
    bld.prerequisite = ""

    bld.power_production = 0
    bld.power_consumption = 0

    bld.size_x = 5
    bld.size_y = 5

    bld.can_rally = true
    bld.produces_units = true

    bld.model_name = "CBCommandCenter"
    bld.portrait_image = "SCCommandCenter"
    bld.button_image = "SCCommandCenter"

    // Produces: Dozer
    // Abilities: Radar Scan

    break :blk bld
}

