// ============================================================================
// GLA Building Registry
// ============================================================================

pub const GLA_BUILDING_COUNT: usize = 10

pub const GLA_BUILDINGS: [GLA_BUILDING_COUNT]*const BuildingDefinition = .{
    &GLA_COMMAND_CENTER,
    &GLA_SUPPLY_STASH,
    &GLA_BARRACKS,
    &GLA_ARMS_DEALER,
    &GLA_BLACK_MARKET,
    &GLA_PALACE,
    &GLA_SCUD_STORM,
    &GLA_STINGER_SITE,
    &GLA_TUNNEL_NETWORK,
    &GLA_DEMO_TRAP,
}

pub fn getGLABuilding(name: []const u8) ?*const BuildingDefinition {
    for (GLA_BUILDINGS) |bld| {
        if (std.mem.eql(u8, bld.name, name)) {
            return bld
        }
    }
    return null
}

// ============================================================================
// Tests
// ============================================================================

test "GLA building definitions" {
    // GLA has no power requirements
    try std.testing.expect(GLA_COMMAND_CENTER.power_consumption == 0)
    try std.testing.expect(GLA_ARMS_DEALER.power_consumption == 0)

    // Tunnel network has lots of garrison slots
    try std.testing.expect(GLA_TUNNEL_NETWORK.garrison_slots == 10)

    // Demo trap is very fragile
    try std.testing.expect(GLA_DEMO_TRAP.max_health == 50.0)
}
