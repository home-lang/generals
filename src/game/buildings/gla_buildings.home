pub const GLA_COMMAND_CENTER: BuildingDefinition = blk: {
    var bld = create_building_definition("GLACommandCenter", .COMMAND)
    bld.display_name = "Command Center"
    bld.faction = .GLA

    bld.max_health = 1500.0
    bld.armor_type = .STRUCTURE
    bld.vision_range = 200.0

    bld.build_cost = 2000
    bld.build_time = 30.0
    bld.prerequisite = ""

    bld.power_production = 0
    bld.power_consumption = 0

    bld.size_x = 4
    bld.size_y = 4

    bld.can_rally = true
    bld.produces_units = true

    bld.model_name = "GBCommandCenter"
    bld.portrait_image = "SGCommandCenter"
    bld.button_image = "SGCommandCenter"

    // Produces: Worker
    // Can rebuild as GLA Hole when destroyed

    break :blk bld
}

