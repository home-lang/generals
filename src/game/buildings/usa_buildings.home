// ============================================================================
// USA Building Registry
// ============================================================================

pub const USA_BUILDING_COUNT: usize = 10

pub const USA_BUILDINGS: [USA_BUILDING_COUNT]*const BuildingDefinition = .{
    &USA_COMMAND_CENTER,
    &USA_POWER_PLANT,
    &USA_BARRACKS,
    &USA_WAR_FACTORY,
    &USA_AIRFIELD,
    &USA_SUPPLY_CENTER,
    &USA_STRATEGY_CENTER,
    &USA_PARTICLE_CANNON,
    &USA_PATRIOT_MISSILE,
    &USA_FIREBASE,
}

pub fn getUSABuilding(name: []const u8) ?*const BuildingDefinition {
    for (USA_BUILDINGS) |bld| {
        if (std.mem.eql(u8, bld.name, name)) {
            return bld
        }
    }
    return null
}

// ============================================================================
// Tests
// ============================================================================

test "USA building definitions" {
    try std.testing.expect(USA_COMMAND_CENTER.max_health == 2000.0)
    try std.testing.expect(USA_POWER_PLANT.power_production == 5)
    try std.testing.expect(USA_PARTICLE_CANNON.power_consumption == 10)
}
