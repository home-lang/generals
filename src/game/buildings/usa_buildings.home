pub const USA_COMMAND_CENTER: BuildingDefinition = blk: {
    var bld = create_building_definition("AmericaCommandCenter", .COMMAND)
    bld.display_name = "Command Center"
    bld.faction = .USA

    bld.max_health = 2000.0
    bld.armor_type = .STRUCTURE
    bld.vision_range = 200.0

    bld.build_cost = 2000
    bld.build_time = 30.0
    bld.prerequisite = ""

    bld.power_production = 0
    bld.power_consumption = 0

    bld.size_x = 5
    bld.size_y = 5

    bld.can_rally = true
    bld.produces_units = true

    bld.model_name = "ABCommandCenter"
    bld.portrait_image = "SACommandCenter"
    bld.button_image = "SACommandCenter"

    // Produces: Dozer
    // Abilities: Radar Scan, Spy Satellite (upgrades)

    break :blk bld
}

