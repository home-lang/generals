    fn shake(&self, epicenter: Vec3, shake_type: CameraShakeType) {
        // Calculate shake intensity based on distance from epicenter
        let dx = self.base.pos.x - epicenter.x
        let dy = self.base.pos.y - epicenter.y
        let dist = sqrt_f32(dx * dx + dy * dy)

        // Determine intensity based on shake type
        let base_intensity = match shake_type {
            CameraShakeType::Subtle => 2.0,
            CameraShakeType::Normal => 5.0,
            CameraShakeType::Strong => 10.0,
            CameraShakeType::Severe => 20.0,
            CameraShakeType::CineExtreme => 40.0,
            CameraShakeType::CineInsane => 80.0,
            _ => 5.0,
        }

        // Apply distance falloff
        let falloff_dist = 500.0
        let intensity = base_intensity * max_f32(0.0, 1.0 - dist / falloff_dist)

        if intensity > self.shake_intensity {
            self.shake_intensity = intensity
            // Random angle for shake direction
            self.shake_angle_cos = cos_f32(dx)
            self.shake_angle_sin = sin_f32(dy)
        }
    }

    // Update methods
    fn update_camera_movements(&self): bool {
        let did_update = false

        if self.doing_zoom_camera {
            self.zoom_camera_one_frame()
            did_update = true
        }
        if self.doing_pitch_camera {
            self.pitch_camera_one_frame()
            did_update = true
        }
        if self.doing_rotate_camera {
            self.previous_look_at_position = self.base.get_position()
            self.rotate_camera_one_frame()
            did_update = true
        } else if self.doing_move_camera_on_waypoint_path {
            self.previous_look_at_position = self.base.get_position()
            // TheSuperHackers @tweak The scripted camera movement is now decoupled from the render update.
            self.move_along_waypoint_path(33.0)  // Assume 33ms per frame
            did_update = true
        }
        if self.doing_scripted_camera_lock {
            did_update = true
        }
        return did_update
    }

    fn update_view(&self) {
        self.update()
    }

    // TheSuperHackers @tweak xezon 12/08/2025 The camera shaker is no longer tied to the render
    // update. The shake does sharp shakes on every fixed time step.
    fn step_view(&self) {
        // Process camera shake
        if self.shake_intensity > 0.01 {
            self.shake_offset.x = self.shake_intensity * self.shake_angle_cos
            self.shake_offset.y = self.shake_intensity * self.shake_angle_sin

            // Fake a stiff spring/damper
            let damping_coeff = 0.75
            self.shake_intensity = self.shake_intensity * damping_coeff

            // Spring is so "stiff", it pulls 180 degrees opposite each frame
            self.shake_angle_cos = -self.shake_angle_cos
            self.shake_angle_sin = -self.shake_angle_sin
        } else {
            self.shake_intensity = 0.0
            self.shake_offset.x = 0.0
            self.shake_offset.y = 0.0
        }
    }

    fn update(&self) {
        let recalc_camera = false
        let did_scripted_movement = false

        // Update camera movements
        if self.update_camera_movements() {
            recalc_camera = true
            did_scripted_movement = true
        }

        // Handle camera lock
        let camera_lock = self.base.get_camera_lock()
        if camera_lock != -1 {
            self.doing_move_camera_on_waypoint_path = false
            self.camera_arrived_at_waypoint_on_path_flag = false
            // In real implementation, follow the locked object
        }

        self.camera_has_moved_since_request = true
    }

