let g_tactical_view: W3DView? = null

fn init_tactical_view(): W3DView {
    let view = W3DView::init()
    g_tactical_view = view
    return view
}

fn get_tactical_view(): W3DView? {
    return g_tactical_view
}

fn shutdown_tactical_view() {
    g_tactical_view = null
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn tan_f32(x: f32): f32 {
    return sin_f32(x) / cos_f32(x)
}

fn sin_f32(x: f32): f32 {
    // Simple Taylor series approximation
    let x2 = x * x
    return x - (x * x2 / 6.0) + (x * x2 * x2 / 120.0)
}

fn cos_f32(x: f32): f32 {
    // Simple Taylor series approximation
    let x2 = x * x
    return 1.0 - (x2 / 2.0) + (x2 * x2 / 24.0)
}

fn sqrt_f32(x: f32): f32 {
    // Newton's method approximation
    if x <= 0.0 {
        return 0.0
    }
    let mut guess = x / 2.0
    for i in 0..10 {
        guess = (guess + x / guess) / 2.0
    }
    return guess
}

fn atan2_f32(y: f32, x: f32): f32 {
    // Approximation of atan2
    let pi = 3.14159265
    if x == 0.0 {
        if y > 0.0 {
            return pi / 2.0
        } else if y < 0.0 {
            return -pi / 2.0
        }
        return 0.0
    }
    let atan = y / x
    if x > 0.0 {
        return atan
    } else if y >= 0.0 {
        return atan + pi
    }
    return atan - pi
}

fn max_f32(a: f32, b: f32): f32 {
    if a > b { return a }
    return b
}

fn min_f32(a: f32, b: f32): f32 {
    if a < b { return a }
    return b
}

fn norm_angle(angle: f32): f32 {
    let pi = 3.14159265
    let mut a = angle
    while a > pi {
        a = a - 2.0 * pi
    }
    while a < -pi {
        a = a + 2.0 * pi
    }
    return a
}

fn get_height_around_pos(x: f32, y: f32): f32 {
    // In real implementation, sample terrain heights around position
    // and return max height for camera clearance
    return 0.0
}
