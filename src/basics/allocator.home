// Basic Allocator trait and implementations for Generals
// Provides memory allocation abstractions

trait Allocator {
    fn alloc(&mut self, size: usize): ?*void;
    fn free(&mut self, ptr: *void): void;
    fn realloc(&mut self, ptr: *void, new_size: usize): ?*void;
}

// System allocator using malloc/free
struct SystemAllocator {
    allocated_bytes: usize,
}

impl SystemAllocator {
    fn new(): SystemAllocator {
        SystemAllocator {
            allocated_bytes: 0,
        }
    }
}

impl Allocator for SystemAllocator {
    fn alloc(&mut self, size: usize): ?*void {
        // In a real implementation, this would call malloc
        // For now, return None
        self.allocated_bytes = self.allocated_bytes + size
        None
    }

    fn free(&mut self, ptr: *void): void {
        // In a real implementation, this would call free
        _ = ptr
    }

    fn realloc(&mut self, ptr: *void, new_size: usize): ?*void {
        // In a real implementation, this would call realloc
        _ = ptr
        self.alloc(new_size)
    }
}

// Arena allocator for fast bulk allocations
// 1024 * 1024 = 1048576
struct ArenaAllocator {
    buffer: [1048576]u8,
    offset: usize,
}

impl ArenaAllocator {
    fn new(): ArenaAllocator {
        ArenaAllocator {
            buffer: [0; 1048576],
            offset: 0,
        }
    }

    fn reset(self: &mut Self): void {
        self.offset = 0;
    }
}

impl Allocator for ArenaAllocator {
    fn alloc(&mut self, size: usize): ?*void {
        if self.offset + size > 1048576 {
            return None
        }

        self.offset = self.offset + size
        None
    }

    fn free(&mut self, ptr: *void): void {
        // Arena allocator doesn't free individual allocations
        _ = ptr
    }

    fn realloc(&mut self, ptr: *void, new_size: usize): ?*void {
        // For arena, just allocate new memory
        _ = ptr
        self.alloc(new_size)
    }
}
