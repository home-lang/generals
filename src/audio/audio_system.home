// Audio System - OpenAL-based audio for game sounds and music
// Ported from Thyme Engine (GPL licensed)
// Reference: Thyme/src/platform/audio/

// Audio format
enum AudioFormat {
    MONO8,      // 8-bit mono
    MONO16,     // 16-bit mono
    STEREO8,    // 8-bit stereo
    STEREO16,   // 16-bit stereo
}

// Vector3 for 3D audio positioning
struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

impl Vec3 {
    fn init(x: f64, y: f64, z: f64): Vec3 {
        return Vec3 { x: x, y: y, z: z }
    }

    fn zero(): Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }
}

// Audio buffer - stores decoded audio data
struct AudioBuffer {
    id: i32,
    format: AudioFormat,
    sample_rate: i32,
    size: i32,
    duration: f64,  // seconds
    name: string,
}

impl AudioBuffer {
    fn init(): AudioBuffer {
        return AudioBuffer {
            id: 0,
            format: AudioFormat::STEREO16,
            sample_rate: 44100,
            size: 0,
            duration: 0.0,
            name: "",
        }
    }

    fn is_valid(&self): bool {
        return self.id != 0
    }

    fn delete(&self) {
        if self.id != 0 {
            // alDeleteBuffers(1, &self.id)
            self.id = 0
        }
    }
}

// Audio source - represents a sound playing in 3D space
struct AudioSource {
    id: i32,
    buffer_id: i32,
    position: Vec3,
    velocity: Vec3,
    pitch: f64,
    gain: f64,          // Volume (0.0 - 1.0)
    looping: bool,
    relative: bool,     // Position relative to listener
    playing: bool,
}

impl AudioSource {
    fn init(): AudioSource {
        return AudioSource {
            id: 0,
            buffer_id: 0,
            position: Vec3::zero(),
            velocity: Vec3::zero(),
            pitch: 1.0,
            gain: 1.0,
            looping: false,
            relative: false,
            playing: false,
        }
    }

    fn set_buffer(&self, buffer: AudioBuffer) {
        self.buffer_id = buffer.id
        // alSourcei(self.id, AL_BUFFER, buffer.id)
    }

    fn set_position(&self, position: Vec3) {
        self.position = position
        // alSource3f(self.id, AL_POSITION, position.x, position.y, position.z)
    }

    fn set_velocity(&self, velocity: Vec3) {
        self.velocity = velocity
        // alSource3f(self.id, AL_VELOCITY, velocity.x, velocity.y, velocity.z)
    }

    fn set_pitch(&self, pitch: f64) {
        self.pitch = pitch
        // alSourcef(self.id, AL_PITCH, pitch)
    }

    fn set_gain(&self, gain: f64) {
        self.gain = gain
        // alSourcef(self.id, AL_GAIN, gain)
    }

    fn set_looping(&self, looping: bool) {
        self.looping = looping
        // alSourcei(self.id, AL_LOOPING, if looping { 1 } else { 0 })
    }

    fn play(&self) {
        // alSourcePlay(self.id)
        self.playing = true
    }

    fn pause(&self) {
        // alSourcePause(self.id)
        self.playing = false
    }

    fn stop(&self) {
        // alSourceStop(self.id)
        self.playing = false
    }

    fn is_playing(&self): bool {
        return self.playing
    }

    fn delete(&self) {
        if self.id != 0 {
            self.stop()
            // alDeleteSources(1, &self.id)
            self.id = 0
        }
    }
}

// Audio listener - represents the player's ears
struct AudioListener {
    position: Vec3,
    velocity: Vec3,
    forward: Vec3,
    up: Vec3,
    gain: f64,
}

impl AudioListener {
    fn init(): AudioListener {
        return AudioListener {
            position: Vec3::zero(),
            velocity: Vec3::zero(),
            forward: Vec3::init(0.0, 0.0, -1.0),
            up: Vec3::init(0.0, 1.0, 0.0),
            gain: 1.0,
        }
    }

    fn set_position(&self, position: Vec3) {
        self.position = position
        // alListener3f(AL_POSITION, position.x, position.y, position.z)
    }

    fn set_velocity(&self, velocity: Vec3) {
        self.velocity = velocity
        // alListener3f(AL_VELOCITY, velocity.x, velocity.y, velocity.z)
    }

    fn set_orientation(&self, forward: Vec3, up: Vec3) {
        self.forward = forward
        self.up = up
        // alListenerfv(AL_ORIENTATION, &orientation)
    }

    fn set_gain(&self, gain: f64) {
        self.gain = gain
        // alListenerf(AL_GAIN, gain)
    }
}

// Buffer entry for audio cache
struct BufferEntry {
    name: string,
    buffer: AudioBuffer,
}

// Main audio system
struct AudioSystem {
    // Audio resources
    buffers: [BufferEntry],
    buffer_count: i32,
    sources: [AudioSource],
    free_sources: [i32],  // Pool of available source indices
    source_count: i32,

    // Listener
    listener: AudioListener,

    // Settings
    master_volume: f64,
    music_volume: f64,
    sfx_volume: f64,

    // Music
    music_source: AudioSource?,
    current_music: string,

    // State
    is_initialized: bool,
}

impl AudioSystem {
    fn init(): AudioSystem {
        // Pre-allocate sound sources
        let sources: [AudioSource] = []
        let free_sources: [i32] = []

        for i in 0..32 {  // Create 32 sources
            sources = sources + [AudioSource::init()]
            free_sources = free_sources + [i]
        }

        return AudioSystem {
            buffers: [],
            buffer_count: 0,
            sources: sources,
            free_sources: free_sources,
            source_count: 32,
            listener: AudioListener::init(),
            master_volume: 1.0,
            music_volume: 0.7,
            sfx_volume: 1.0,
            music_source: null,
            current_music: "",
            is_initialized: true,
        }
    }

    fn load_sound(&self, path: string): bool {
        // Check cache
        for i in 0..self.buffer_count {
            if self.buffers[i].name == path {
                return true  // Already loaded
            }
        }

        // Create new buffer
        let buffer = AudioBuffer::init()
        buffer.name = path
        // In real implementation: load and decode WAV/OGG file

        let entry = BufferEntry {
            name: path,
            buffer: buffer,
        }
        self.buffers = self.buffers + [entry]
        self.buffer_count = self.buffer_count + 1

        return true
    }

    fn get_buffer(&self, name: string): AudioBuffer? {
        for i in 0..self.buffer_count {
            if self.buffers[i].name == name {
                return self.buffers[i].buffer
            }
        }
        return null
    }

    fn get_free_source(&self): i32 {
        if self.free_sources.length > 0 {
            let idx = self.free_sources[self.free_sources.length - 1]
            // Remove last element
            let new_free: [i32] = []
            for i in 0..(self.free_sources.length - 1) {
                new_free = new_free + [self.free_sources[i]]
            }
            self.free_sources = new_free
            return idx
        }
        return -1
    }

    fn return_source(&self, idx: i32) {
        self.free_sources = self.free_sources + [idx]
    }

    fn play_sound(&self, sound_name: string, position: Vec3, volume: f64): bool {
        // Get buffer
        let buffer = self.get_buffer(sound_name)
        if buffer == null {
            return false
        }

        // Get free source
        let source_idx = self.get_free_source()
        if source_idx < 0 {
            return false  // No free sources
        }

        // Configure source
        let source = self.sources[source_idx]
        source.set_buffer(buffer)
        source.set_position(position)
        source.set_gain(volume * self.sfx_volume * self.master_volume)
        source.set_looping(false)
        source.play()

        return true
    }

    fn play_sound_2d(&self, sound_name: string, volume: f64): bool {
        // Get buffer
        let buffer = self.get_buffer(sound_name)
        if buffer == null {
            return false
        }

        // Get free source
        let source_idx = self.get_free_source()
        if source_idx < 0 {
            return false
        }

        // Configure source (relative to listener)
        let source = self.sources[source_idx]
        source.set_buffer(buffer)
        source.relative = true
        source.set_position(Vec3::zero())
        source.set_gain(volume * self.sfx_volume * self.master_volume)
        source.set_looping(false)
        source.play()

        return true
    }

    fn play_music(&self, music_path: string): bool {
        // Stop current music
        self.stop_music()

        // Load music
        if !self.load_sound(music_path) {
            return false
        }

        let buffer = self.get_buffer(music_path)
        if buffer == null {
            return false
        }

        // Create music source
        let source = AudioSource::init()
        source.set_buffer(buffer)
        source.relative = true
        source.set_position(Vec3::zero())
        source.set_gain(self.music_volume * self.master_volume)
        source.set_looping(true)
        source.play()

        self.music_source = source
        self.current_music = music_path

        return true
    }

    fn stop_music(&self) {
        if self.music_source != null {
            self.music_source.stop()
        }
        self.music_source = null
        self.current_music = ""
    }

    fn set_master_volume(&self, volume: f64) {
        if volume < 0.0 {
            self.master_volume = 0.0
        } else if volume > 1.0 {
            self.master_volume = 1.0
        } else {
            self.master_volume = volume
        }
        self.listener.set_gain(self.master_volume)
    }

    fn set_music_volume(&self, volume: f64) {
        if volume < 0.0 {
            self.music_volume = 0.0
        } else if volume > 1.0 {
            self.music_volume = 1.0
        } else {
            self.music_volume = volume
        }
        if self.music_source != null {
            self.music_source.set_gain(self.music_volume * self.master_volume)
        }
    }

    fn set_sfx_volume(&self, volume: f64) {
        if volume < 0.0 {
            self.sfx_volume = 0.0
        } else if volume > 1.0 {
            self.sfx_volume = 1.0
        } else {
            self.sfx_volume = volume
        }
    }

    fn update_listener(&self, position: Vec3, forward: Vec3, up: Vec3, velocity: Vec3) {
        self.listener.set_position(position)
        self.listener.set_orientation(forward, up)
        self.listener.set_velocity(velocity)
    }

    fn update(&self) {
        // Return finished sources to pool
        for i in 0..self.source_count {
            if !self.sources[i].is_playing() {
                // Check if not already in free list
                let in_free = false
                for j in 0..self.free_sources.length {
                    if self.free_sources[j] == i {
                        in_free = true
                        break
                    }
                }
                if !in_free {
                    self.return_source(i)
                }
            }
        }
    }

    fn shutdown(&self) {
        // Stop all sounds
        self.stop_music()
        for i in 0..self.source_count {
            self.sources[i].delete()
        }

        // Delete buffers
        for i in 0..self.buffer_count {
            self.buffers[i].buffer.delete()
        }
        self.buffers = []
        self.buffer_count = 0

        self.is_initialized = false
    }
}

// WAV file format constants
let WAV_RIFF_MAGIC: i32 = 0x46464952  // "RIFF"
let WAV_WAVE_MAGIC: i32 = 0x45564157  // "WAVE"
let WAV_FMT_MAGIC: i32 = 0x20746D66   // "fmt "
let WAV_DATA_MAGIC: i32 = 0x61746164  // "data"

// WAV file data
struct WAVFile {
    format: AudioFormat,
    sample_rate: i32,
    num_channels: i32,
    bits_per_sample: i32,
    data_size: i32,
    duration: f64,
}

impl WAVFile {
    fn init(): WAVFile {
        return WAVFile {
            format: AudioFormat::STEREO16,
            sample_rate: 44100,
            num_channels: 2,
            bits_per_sample: 16,
            data_size: 0,
            duration: 0.0,
        }
    }

    fn get_al_format(&self): i32 {
        if self.num_channels == 1 {
            if self.bits_per_sample == 8 {
                return 0x1100  // AL_FORMAT_MONO8
            } else {
                return 0x1101  // AL_FORMAT_MONO16
            }
        } else {
            if self.bits_per_sample == 8 {
                return 0x1102  // AL_FORMAT_STEREO8
            } else {
                return 0x1103  // AL_FORMAT_STEREO16
            }
        }
    }
}

// Global audio system instance
let g_audio_system: AudioSystem? = null

fn init_audio_system(): AudioSystem {
    let system = AudioSystem::init()
    g_audio_system = system
    return system
}

fn get_audio_system(): AudioSystem? {
    return g_audio_system
}

fn shutdown_audio_system() {
    if g_audio_system != null {
        g_audio_system.shutdown()
        g_audio_system = null
    }
}
