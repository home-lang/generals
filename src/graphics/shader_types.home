        layer1_scale: 8.0
        layer2_scale: 8.0
        layer3_scale: 8.0
        blend_sharpness: 3.0
        sun_direction: [0.4, 0.6, 0.5]
        sun_color: [0.95, 0.95, 1.0]
        ambient_color: [0.3, 0.3, 0.35]
        fog_start: 400.0
        fog_end: 1500.0
        fog_color: [0.6, 0.6, 0.65, 1.0]
    }
    water_params: WaterShaderParams.default()
    shroud_params: ShroudShaderParams.default()
    cloud_params: CloudShaderParams {
        cloud_color: [0.0, 0.0, 0.0, 0.25]
        shadow_intensity: 0.25
        wind_direction: [1.0, 0.2]
        wind_speed: 0.01
        cloud_scale: 0.0012
        detail_scale: 0.012
        coverage: 0.6
        softness: 0.25
    }
}

export fn apply_shader_preset(preset: *ShaderPreset) {
    if g_shader_type_manager != null {
        g_shader_type_manager.?.set_terrain_params(preset.terrain_params)
        g_shader_type_manager.?.set_water_params(preset.water_params)
        g_shader_type_manager.?.set_shroud_params(preset.shroud_params)
        g_shader_type_manager.?.set_cloud_params(preset.cloud_params)
    }
}
