// C&C Generals Zero Hour - Shader Types System
// All 16 shader types from the original W3DShaderManager
//
// Original shader types from EA's Westwood renderer:
// - Terrain shaders (base, blend, roads, cliffs)
// - Object shaders (vehicles, infantry, buildings)
// - Effect shaders (particles, decals, water, shroud)
// - Post-process shaders (blur, color correction)

import graphics/shader

// ============================================================================
// SHADER TYPE ENUMERATION
// ============================================================================

enum W3DShaderType {
    // Terrain shaders
    TerrainBase = 0         // Base terrain rendering
    TerrainBlend = 1        // Terrain texture blending (4 layers)
    TerrainRoad = 2         // Road overlay rendering
    TerrainCliff = 3        // Cliff face rendering
    TerrainWater = 4        // Water surface with reflection/refraction

    // Object shaders
    ObjectDefault = 5       // Default W3D object shader
    ObjectSkinned = 6       // Skinned mesh (infantry, animated)
    ObjectBuilding = 7      // Building with construction states
    ObjectVehicle = 8       // Vehicle with tracks/wheels

    // Effect shaders
    ParticleBillboard = 9   // Billboard particle sprites
    ParticleStreak = 10     // Streak/trail particles
    DecalProjected = 11     // Projected decals (scorch marks, shadows)
    LaserBeam = 12          // Laser/beam weapons

    // Overlay shaders
    Shroud = 13             // Fog of war shroud
    Cloud = 14              // Cloud shadow overlay

    // Post-process
    PostProcess = 15        // Post-processing effects
}

// ============================================================================
// SHADER VARIANT FLAGS
// ============================================================================

enum ShaderVariantFlags {
    None = 0
    Textured = 1            // Has diffuse texture
    NormalMapped = 2        // Has normal map
    Specular = 4            // Has specular map
    Emissive = 8            // Has emissive/glow
    Skinned = 16            // Has bone weights
    Instanced = 32          // Supports instancing
    AlphaTest = 64          // Uses alpha testing
    AlphaBlend = 128        // Uses alpha blending
    DoubleSided = 256       // Render both sides
    Fog = 512               // Affected by fog
    Shadows = 1024          // Casts/receives shadows
    Reflection = 2048       // Has environment reflection
}

// ============================================================================
// SHADER MATERIAL PROPERTIES
// ============================================================================

struct ShaderMaterialProps {
    diffuse_color: [f32; 4]
    specular_color: [f32; 4]
    emissive_color: [f32; 4]
    ambient_color: [f32; 4]
    shininess: f32
    opacity: f32
    alpha_test_ref: f32
    uv_offset: [f32; 2]
    uv_scale: [f32; 2]
    time: f32

    fn default(): ShaderMaterialProps {
        return ShaderMaterialProps {
            diffuse_color: [1.0, 1.0, 1.0, 1.0]
            specular_color: [0.5, 0.5, 0.5, 1.0]
            emissive_color: [0.0, 0.0, 0.0, 1.0]
            ambient_color: [0.2, 0.2, 0.2, 1.0]
            shininess: 32.0
            opacity: 1.0
            alpha_test_ref: 0.5
            uv_offset: [0.0, 0.0]
            uv_scale: [1.0, 1.0]
            time: 0.0
        }
    }
}

// ============================================================================
// TERRAIN SHADER PARAMS
// ============================================================================

struct TerrainShaderParams {
    // Texture layers
    layer0_scale: f32
    layer1_scale: f32
    layer2_scale: f32
    layer3_scale: f32

    // Blend weights
    blend_sharpness: f32

    // Lighting
    sun_direction: [f32; 3]
    sun_color: [f32; 3]
    ambient_color: [f32; 3]

    // Fog
    fog_start: f32
    fog_end: f32
    fog_color: [f32; 4]

    fn default(): TerrainShaderParams {
        return TerrainShaderParams {
            layer0_scale: 16.0
            layer1_scale: 16.0
            layer2_scale: 16.0
            layer3_scale: 16.0
            blend_sharpness: 2.0
            sun_direction: [0.5, 0.8, 0.3]
            sun_color: [1.0, 0.95, 0.85]
            ambient_color: [0.3, 0.35, 0.4]
            fog_start: 500.0
            fog_end: 2000.0
            fog_color: [0.7, 0.75, 0.8, 1.0]
        }
    }
}

// ============================================================================
// WATER SHADER PARAMS
// ============================================================================

struct WaterShaderParams {
    // Wave animation
    wave_speed: f32
    wave_scale: f32
    wave_amplitude: f32

    // Colors
    shallow_color: [f32; 4]
    deep_color: [f32; 4]

    // Reflection/refraction
    reflection_strength: f32
    refraction_strength: f32
    fresnel_bias: f32
    fresnel_scale: f32
    fresnel_power: f32

    // Flow
    flow_direction: [f32; 2]
    flow_speed: f32

    fn default(): WaterShaderParams {
        return WaterShaderParams {
            wave_speed: 0.5
            wave_scale: 8.0
            wave_amplitude: 0.1
            shallow_color: [0.2, 0.4, 0.5, 0.6]
            deep_color: [0.1, 0.15, 0.3, 0.9]
            reflection_strength: 0.4
            refraction_strength: 0.3
            fresnel_bias: 0.1
            fresnel_scale: 1.0
            fresnel_power: 2.0
            flow_direction: [1.0, 0.0]
            flow_speed: 0.1
        }
    }
}

// ============================================================================
// SHROUD SHADER PARAMS
// ============================================================================

struct ShroudShaderParams {
    // Shroud colors
    unexplored_color: [f32; 4]
    explored_color: [f32; 4]
    visible_color: [f32; 4]

    // Transition
    edge_softness: f32
    transition_speed: f32

    // Texture
    noise_scale: f32
    noise_intensity: f32

    fn default(): ShroudShaderParams {
        return ShroudShaderParams {
            unexplored_color: [0.0, 0.0, 0.0, 1.0]
            explored_color: [0.0, 0.0, 0.0, 0.5]
            visible_color: [0.0, 0.0, 0.0, 0.0]
            edge_softness: 0.1
            transition_speed: 2.0
            noise_scale: 4.0
            noise_intensity: 0.1
        }
    }
}

// ============================================================================
// PARTICLE SHADER PARAMS
// ============================================================================

struct ParticleShaderParams {
    // Color modulation
    start_color: [f32; 4]
    end_color: [f32; 4]

    // Size
    start_size: f32
    end_size: f32

    // Soft particles
    soft_particle_depth_scale: f32

    // Animation
    sprite_sheet_rows: i32
    sprite_sheet_cols: i32
    animation_speed: f32

    fn default(): ParticleShaderParams {
        return ParticleShaderParams {
            start_color: [1.0, 1.0, 1.0, 1.0]
            end_color: [1.0, 1.0, 1.0, 0.0]
            start_size: 1.0
            end_size: 2.0
            soft_particle_depth_scale: 0.5
            sprite_sheet_rows: 1
            sprite_sheet_cols: 1
            animation_speed: 1.0
        }
    }
}

// ============================================================================
// DECAL SHADER PARAMS
// ============================================================================

struct DecalShaderParams {
    // Decal properties
    decal_color: [f32; 4]
    decal_opacity: f32
    decal_size: f32

    // Fading
    fade_start_distance: f32
    fade_end_distance: f32
    lifetime: f32
    fade_time: f32

    // Projection
    projection_bias: f32

    fn default(): DecalShaderParams {
        return DecalShaderParams {
            decal_color: [1.0, 1.0, 1.0, 1.0]
            decal_opacity: 1.0
            decal_size: 1.0
            fade_start_distance: 100.0
            fade_end_distance: 200.0
            lifetime: 10.0
            fade_time: 2.0
            projection_bias: 0.001
        }
    }
}

// ============================================================================
// LASER BEAM SHADER PARAMS
// ============================================================================

struct LaserShaderParams {
    // Beam properties
    beam_color: [f32; 4]
    core_color: [f32; 4]
    glow_color: [f32; 4]

    // Size
    beam_width: f32
    core_width: f32
    glow_radius: f32

    // Animation
    pulse_speed: f32
    pulse_intensity: f32
    noise_scale: f32
    scroll_speed: f32

    fn default(): LaserShaderParams {
        return LaserShaderParams {
            beam_color: [1.0, 0.2, 0.2, 0.8]
            core_color: [1.0, 1.0, 1.0, 1.0]
            glow_color: [1.0, 0.5, 0.5, 0.3]
            beam_width: 0.5
            core_width: 0.1
            glow_radius: 2.0
            pulse_speed: 5.0
            pulse_intensity: 0.2
            noise_scale: 10.0
            scroll_speed: 2.0
        }
    }
}

// ============================================================================
// CLOUD SHADOW SHADER PARAMS
// ============================================================================

struct CloudShaderParams {
    // Cloud properties
    cloud_color: [f32; 4]
    shadow_intensity: f32

    // Movement
    wind_direction: [f32; 2]
    wind_speed: f32

    // Scale
    cloud_scale: f32
    detail_scale: f32

    // Coverage
    coverage: f32
    softness: f32

    fn default(): CloudShaderParams {
        return CloudShaderParams {
            cloud_color: [0.0, 0.0, 0.0, 0.3]
            shadow_intensity: 0.3
            wind_direction: [1.0, 0.5]
            wind_speed: 0.02
            cloud_scale: 0.001
            detail_scale: 0.01
            coverage: 0.5
            softness: 0.3
        }
    }
}

// ============================================================================
// SHADER TYPE INFO
// ============================================================================

struct ShaderTypeInfo {
    shader_type: W3DShaderType
    name: string
    vertex_shader: string
    fragment_shader: string
    supported_variants: i32
    required_textures: i32

    fn init(shader_type: W3DShaderType, name: string, vs: string, fs: string): ShaderTypeInfo {
        return ShaderTypeInfo {
            shader_type: shader_type
            name: name
            vertex_shader: vs
            fragment_shader: fs
            supported_variants: 0
            required_textures: 1
        }
    }
}

