// ============================================================================
// SHADER TYPE MANAGER
// ============================================================================

struct ShaderTypeManager {
    // Loaded shaders by type
    shaders: [?*Shader; 16]
    shader_params: [*anyopaque; 16]

    // GPU feature detection
    supports_instancing: bool
    supports_geometry_shaders: bool
    supports_compute_shaders: bool
    max_texture_units: i32
    max_uniform_buffer_size: i32

    fn init(): ShaderTypeManager {
        return ShaderTypeManager {
            shaders: [null; 16]
            shader_params: [null as *anyopaque; 16]
            supports_instancing: true
            supports_geometry_shaders: false
            supports_compute_shaders: false
            max_texture_units: 16
            max_uniform_buffer_size: 65536
        }
    }

    fn detect_gpu_features(&self) {
        // Query GPU capabilities
        // This would use platform-specific APIs
        // Metal: MTLDevice.supportsFeatureSet()
        // Vulkan: vkGetPhysicalDeviceFeatures()
        // OpenGL: glGetIntegerv(GL_MAX_TEXTURE_IMAGE_UNITS)
    }

    fn load_shader_type(&self, shader_type: W3DShaderType): bool {
        let index = shader_type as i32
        if index < 0 or index >= 16 {
            return false
        }

        let info = SHADER_TYPE_INFO[index]

        // Load shader from files
        let shader = load_shader(info.name, info.vertex_shader, info.fragment_shader, RendererAPI::Metal)
        if shader == null {
            return false
        }

        self.shaders[index] = shader

        return true
    }

    fn get_shader(&self, shader_type: W3DShaderType): ?*Shader {
        let index = shader_type as i32
        if index < 0 or index >= 16 {
            return null
        }

        return self.shaders[index]
    }

    fn set_terrain_params(&self, params: TerrainShaderParams) {
        let shader = self.get_shader(W3DShaderType::TerrainBlend)
        if shader != null {
            shader.?.set_uniform_float("u_Layer0Scale", params.layer0_scale)
            shader.?.set_uniform_float("u_Layer1Scale", params.layer1_scale)
            shader.?.set_uniform_float("u_Layer2Scale", params.layer2_scale)
            shader.?.set_uniform_float("u_Layer3Scale", params.layer3_scale)
            shader.?.set_uniform_vec3("u_SunDirection", Vec3 { x: params.sun_direction[0], y: params.sun_direction[1], z: params.sun_direction[2] })
            shader.?.set_uniform_float("u_FogStart", params.fog_start)
            shader.?.set_uniform_float("u_FogEnd", params.fog_end)
        }
    }

    fn set_water_params(&self, params: WaterShaderParams) {
        let shader = self.get_shader(W3DShaderType::TerrainWater)
        if shader != null {
            shader.?.set_uniform_float("u_WaveSpeed", params.wave_speed)
            shader.?.set_uniform_float("u_WaveScale", params.wave_scale)
            shader.?.set_uniform_float("u_WaveAmplitude", params.wave_amplitude)
            shader.?.set_uniform_float("u_ReflectionStrength", params.reflection_strength)
            shader.?.set_uniform_float("u_RefractionStrength", params.refraction_strength)
        }
    }

    fn set_shroud_params(&self, params: ShroudShaderParams) {
        let shader = self.get_shader(W3DShaderType::Shroud)
        if shader != null {
            shader.?.set_uniform_float("u_EdgeSoftness", params.edge_softness)
            shader.?.set_uniform_float("u_TransitionSpeed", params.transition_speed)
            shader.?.set_uniform_float("u_NoiseScale", params.noise_scale)
            shader.?.set_uniform_float("u_NoiseIntensity", params.noise_intensity)
        }
    }

    fn set_particle_params(&self, params: ParticleShaderParams) {
        let shader = self.get_shader(W3DShaderType::ParticleBillboard)
        if shader != null {
            shader.?.set_uniform_float("u_StartSize", params.start_size)
            shader.?.set_uniform_float("u_EndSize", params.end_size)
            shader.?.set_uniform_float("u_SoftParticleScale", params.soft_particle_depth_scale)
        }
    }

    fn set_cloud_params(&self, params: CloudShaderParams) {
        let shader = self.get_shader(W3DShaderType::Cloud)
        if shader != null {
            shader.?.set_uniform_float("u_ShadowIntensity", params.shadow_intensity)
            shader.?.set_uniform_float("u_WindSpeed", params.wind_speed)
            shader.?.set_uniform_float("u_CloudScale", params.cloud_scale)
            shader.?.set_uniform_float("u_Coverage", params.coverage)
            shader.?.set_uniform_float("u_Softness", params.softness)
        }
    }

    fn load_all_shaders(&self): bool {
        let mut success = true

        for i in 0..16 {
            let shader_type = i as W3DShaderType
            if !self.load_shader_type(shader_type) {
                success = false
            }
        }

        return success
    }

    fn reload_all_shaders(&self): bool {
        // Hot-reload support for development
        return self.load_all_shaders()
    }
}

// ============================================================================
// GLOBAL SHADER TYPE MANAGER
// ============================================================================

var g_shader_type_manager: ?ShaderTypeManager = null

export fn init_shader_types() {
    g_shader_type_manager = ShaderTypeManager.init()
    g_shader_type_manager.?.detect_gpu_features()
}

export fn shutdown_shader_types() {
    g_shader_type_manager = null
}

export fn load_all_shader_types(): bool {
    if g_shader_type_manager == null {
        return false
    }

    return g_shader_type_manager.?.load_all_shaders()
}

export fn get_shader_by_type(shader_type: W3DShaderType): ?*Shader {
    if g_shader_type_manager == null {
        return null
    }

    return g_shader_type_manager.?.get_shader(shader_type)
}

export fn reload_shader_types(): bool {
    if g_shader_type_manager == null {
        return false
    }

    return g_shader_type_manager.?.reload_all_shaders()
}

export fn get_shader_type_info(shader_type: W3DShaderType): ShaderTypeInfo {
    let index = shader_type as i32
    if index >= 0 and index < 16 {
        return SHADER_TYPE_INFO[index]
    }

    return ShaderTypeInfo.init(W3DShaderType::ObjectDefault, "Unknown", "", "")
}

