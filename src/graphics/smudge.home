// C&C Generals Zero Hour - Home Port
// Smudge System
//
// Original: Smudge.cpp / Smudge.h + W3DSmudge.cpp / W3DSmudge.h (EA/Westwood)
// Ground effect system for scorch marks, oil slicks, blood splatter, etc.
//
// Smudges are decals projected onto the terrain that fade over time.
// Used for:
// - Explosion craters and scorch marks
// - Vehicle oil/fuel leaks
// - Infantry blood splatter
// - Building destruction debris
//
// @unify xezon 28/11/2025 (#1920) - Merge Smudge, W3DSmudge code into Core

import math/vector

// ============================================================================
// Constants
// ============================================================================

const MAX_SMUDGES_PER_SET: i32 = 64
const MAX_SMUDGE_SETS: i32 = 128
const MAX_POINTS_PER_GROUP: i32 = 512

// ============================================================================
// Smudge Vertex
// ============================================================================

struct SmudgeVertex {
    pos: Vec3       // World-space position of vertex
    uv: Vec2        // UV coordinates of vertex
}

impl SmudgeVertex {
    fn init(): SmudgeVertex {
        return SmudgeVertex {
            pos: Vec3 { x: 0.0, y: 0.0, z: 0.0 }
            uv: Vec2 { x: 0.0, y: 0.0 }
        }
    }
}

// ============================================================================
// Vector Types (simplified for smudge system)
// ============================================================================

struct Vec2 {
    x: f32
    y: f32
}

struct Vec3 {
    x: f32
    y: f32
    z: f32
}

// ============================================================================
// Smudge - Individual decal on the terrain
// ============================================================================

struct Smudge {
    pos: Vec3           // Position of smudge center
    offset: Vec2        // Difference in position between texture extraction and re-insertion
    size: f32           // Size of smudge in world space
    opacity: f32        // Alpha of center vertex (corners are 0)

    // 5 vertices: top-left, top-right, bottom-right, bottom-left, center
    verts: [SmudgeVertex; 5]

    // Linked list pointers (for pool management)
    next: ?*Smudge
    prev: ?*Smudge

    is_active: bool
}

impl Smudge {
    fn init(): Smudge {
        let verts: [SmudgeVertex; 5] = [SmudgeVertex.init(); 5]

        return Smudge {
            pos: Vec3 { x: 0.0, y: 0.0, z: 0.0 }
            offset: Vec2 { x: 0.0, y: 0.0 }
            size: 1.0
            opacity: 1.0
            verts: verts
            next: null
            prev: null
            is_active: false
        }
    }

    // Set smudge parameters (macro equivalent from original)
    fn set_parameters(mut self, pos: Vec3, offset: Vec2, size: f32, opacity: f32) {
        self.pos = pos
        self.offset = offset
        self.size = size
        self.opacity = opacity
    }

    // Calculate vertex positions from center and size
    fn calculate_vertices(mut self) {
        let half_size = self.size * 0.5

        // Top-left
        self.verts[0].pos = Vec3 {
            x: self.pos.x - half_size
            y: self.pos.y
            z: self.pos.z - half_size
        }
        self.verts[0].uv = Vec2 { x: 0.0, y: 0.0 }

        // Top-right
        self.verts[1].pos = Vec3 {
            x: self.pos.x + half_size
            y: self.pos.y
            z: self.pos.z - half_size
        }
        self.verts[1].uv = Vec2 { x: 1.0, y: 0.0 }

        // Bottom-right
        self.verts[2].pos = Vec3 {
            x: self.pos.x + half_size
            y: self.pos.y
            z: self.pos.z + half_size
        }
        self.verts[2].uv = Vec2 { x: 1.0, y: 1.0 }

        // Bottom-left
        self.verts[3].pos = Vec3 {
            x: self.pos.x - half_size
            y: self.pos.y
            z: self.pos.z + half_size
        }
        self.verts[3].uv = Vec2 { x: 0.0, y: 1.0 }

        // Center
        self.verts[4].pos = self.pos
        self.verts[4].uv = Vec2 { x: 0.5, y: 0.5 }
    }
}

// ============================================================================
// Smudge Set - Collection of related smudges
// ============================================================================

struct SmudgeSet {
    used_smudge_list: ?*Smudge
    used_smudge_count: i32

    // Linked list pointers (for pool management)
    next: ?*SmudgeSet
    prev: ?*SmudgeSet

    is_active: bool
}

// Static free list for smudges (shared across all sets)
var g_free_smudge_list: ?*Smudge = null

impl SmudgeSet {
    fn init(): SmudgeSet {
        return SmudgeSet {
            used_smudge_list: null
            used_smudge_count: 0
            next: null
            prev: null
            is_active: false
        }
    }

    fn reset(mut self) {
        // Move all used smudges back to free list
        while self.used_smudge_list != null {
            let smudge = self.used_smudge_list.?
            self.remove_smudge_from_set(smudge)
        }
        self.used_smudge_count = 0
    }

    fn add_smudge_to_set(mut self): ?*Smudge {
        // Get smudge from free list
        if g_free_smudge_list == null {
            println("SmudgeSet: No free smudges available")
            return null
        }

        let smudge = g_free_smudge_list.?
        g_free_smudge_list = smudge.next

        // Add to used list
        smudge.next = self.used_smudge_list
        smudge.prev = null
        if self.used_smudge_list != null {
            self.used_smudge_list.?.prev = smudge
        }
        self.used_smudge_list = smudge

        smudge.is_active = true
        self.used_smudge_count += 1

        return smudge
    }

    fn remove_smudge_from_set(mut self, smudge: *Smudge) {
        // Remove from used list
        if smudge.prev != null {
            smudge.prev.?.next = smudge.next
        } else {
            self.used_smudge_list = smudge.next
        }
        if smudge.next != null {
            smudge.next.?.prev = smudge.prev
        }

        // Add back to free list
        smudge.next = g_free_smudge_list
        smudge.prev = null
        g_free_smudge_list = smudge

        smudge.is_active = false
        self.used_smudge_count -= 1
    }

    fn get_used_smudge_count(self): i32 {
        return self.used_smudge_count
    }
}

// ============================================================================
// Hardware Support Status
// ============================================================================

enum HardwareSmudgeSupport {
    Unknown
    No
    Yes
}

// ============================================================================
// Smudge Manager
// ============================================================================

struct SmudgeManager {
    hardware_support_status: HardwareSmudgeSupport
    used_smudge_set_list: ?*SmudgeSet
    free_smudge_set_list: ?*SmudgeSet
    smudge_count_last_frame: i32

    // Pre-allocated pools
    smudge_pool: [Smudge; MAX_SMUDGES_PER_SET * MAX_SMUDGE_SETS]
    smudge_set_pool: [SmudgeSet; MAX_SMUDGE_SETS]

    is_initialized: bool
}

impl SmudgeManager {
    fn init(): SmudgeManager {
        let smudge_pool: [Smudge; MAX_SMUDGES_PER_SET * MAX_SMUDGE_SETS]
        let smudge_set_pool: [SmudgeSet; MAX_SMUDGE_SETS]

        return SmudgeManager {
            hardware_support_status: HardwareSmudgeSupport.Unknown
            used_smudge_set_list: null
            free_smudge_set_list: null
            smudge_count_last_frame: 0
            smudge_pool: smudge_pool
            smudge_set_pool: smudge_set_pool
            is_initialized: false
        }
    }

    fn initialize(mut self) {
        println("SmudgeManager: Initializing...")

        // Initialize smudge pool
        let total_smudges = MAX_SMUDGES_PER_SET * MAX_SMUDGE_SETS
        for i in 0..total_smudges {
            self.smudge_pool[i] = Smudge.init()
            if i > 0 {
                self.smudge_pool[i - 1].next = &self.smudge_pool[i]
            }
        }
        g_free_smudge_list = &self.smudge_pool[0]

        // Initialize smudge set pool
        for i in 0..MAX_SMUDGE_SETS {
            self.smudge_set_pool[i] = SmudgeSet.init()
            if i > 0 {
                self.smudge_set_pool[i - 1].next = &self.smudge_set_pool[i]
            }
        }
        self.free_smudge_set_list = &self.smudge_set_pool[0]

        // Test hardware support
        self.hardware_support_status = self.test_hardware_support()

        self.is_initialized = true
        println("SmudgeManager: Initialized with hardware_support={self.hardware_support_status}")
    }

    fn reset(mut self) {
        // Reset all used smudge sets
        while self.used_smudge_set_list != null {
            let set = self.used_smudge_set_list.?
            set.reset()
            self.remove_smudge_set(set)
        }
        self.smudge_count_last_frame = 0
    }

    fn shutdown(mut self) {
        println("SmudgeManager: Shutting down...")
        self.reset()
        self.is_initialized = false
    }

    fn add_smudge_set(mut self): ?*SmudgeSet {
        if self.free_smudge_set_list == null {
            println("SmudgeManager: No free smudge sets available")
            return null
        }

        let set = self.free_smudge_set_list.?
        self.free_smudge_set_list = set.next

        // Add to used list
        set.next = self.used_smudge_set_list
        set.prev = null
        if self.used_smudge_set_list != null {
            self.used_smudge_set_list.?.prev = set
        }
        self.used_smudge_set_list = set

        set.is_active = true
        return set
    }

    fn remove_smudge_set(mut self, set: *SmudgeSet) {
        // Remove from used list
        if set.prev != null {
            set.prev.?.next = set.next
        } else {
            self.used_smudge_set_list = set.next
        }
        if set.next != null {
            set.next.?.prev = set.prev
        }

        // Add back to free list
        set.next = self.free_smudge_set_list
        set.prev = null
        self.free_smudge_set_list = set

        set.is_active = false
    }

    fn get_smudge_count_last_frame(self): i32 {
        return self.smudge_count_last_frame
    }

    fn set_smudge_count_last_frame(mut self, count: i32) {
        self.smudge_count_last_frame = count
    }

    fn get_hardware_support(self): bool {
        return self.hardware_support_status != HardwareSmudgeSupport.No
    }

    fn test_hardware_support(self): HardwareSmudgeSupport {
        // Modern hardware easily supports this effect
        // TODO: Query actual hardware capabilities
        return HardwareSmudgeSupport.Yes
    }

    // Render all smudges (W3D-specific rendering)
    fn render(mut self) {
        if !self.get_hardware_support() {
            return
        }

        var total_smudges = 0

        // Iterate through all used smudge sets
        var set = self.used_smudge_set_list
        while set != null {
            var smudge = set.?.used_smudge_list
            while smudge != null {
                // Calculate vertices for rendering
                smudge.?.calculate_vertices()

                // TODO: Submit to renderer
                // This would submit the 5 vertices as a fan or triangles

                total_smudges += 1
                smudge = smudge.?.next
            }
            set = set.?.next
        }

        self.smudge_count_last_frame = total_smudges
    }

    fn release_resources(mut self) {
        // Release GPU resources
        // TODO: Release render textures, buffers, etc.
    }

    fn reacquire_resources(mut self) {
        // Reacquire GPU resources after device reset
        // TODO: Recreate render textures, buffers, etc.
    }
}

// ============================================================================
// Global Instance
// ============================================================================

var g_smudge_manager: ?SmudgeManager = null

export fn init_smudge_manager() {
    g_smudge_manager = SmudgeManager.init()
    g_smudge_manager.?.initialize()
}

export fn shutdown_smudge_manager() {
    if g_smudge_manager != null {
        g_smudge_manager.?.shutdown()
        g_smudge_manager = null
    }
}

export fn get_smudge_manager(): ?*SmudgeManager {
    if g_smudge_manager != null {
        return &g_smudge_manager.?
    }
    return null
}

export fn render_smudges() {
    if g_smudge_manager != null {
        g_smudge_manager.?.render()
    }
}

// ============================================================================
// Helper Functions
// ============================================================================

// Create a scorch mark at a position
export fn create_scorch_mark(pos: Vec3, size: f32): bool {
    let manager = get_smudge_manager()
    if manager == null {
        return false
    }

    let set = manager.?.add_smudge_set()
    if set == null {
        return false
    }

    let smudge = set.?.add_smudge_to_set()
    if smudge == null {
        return false
    }

    smudge.?.set_parameters(
        pos,
        Vec2 { x: 0.0, y: 0.0 },
        size,
        1.0
    )

    return true
}

// Create a blood splatter at a position
export fn create_blood_splatter(pos: Vec3, size: f32): bool {
    return create_scorch_mark(pos, size * 0.5)  // Blood is smaller
}

// Create vehicle oil leak
export fn create_oil_leak(pos: Vec3, size: f32): bool {
    return create_scorch_mark(pos, size * 0.3)  // Oil leaks are small
}
