// ============================================================================
// Particle Effect Manager
// ============================================================================

pub const ParticleEffectManager = struct {
    emitter_defs: std.StringHashMap(*const ParticleEmitterDef),
    active_emitters: std.ArrayList(*ParticleEmitter),
    allocator: std.mem.Allocator,
    global_wind: math.Vec3,
    gravity: f32,

    pub fn init(allocator: std.mem.Allocator) ParticleEffectManager {
        var manager = ParticleEffectManager{
            .emitter_defs = std.StringHashMap(*const ParticleEmitterDef).init(allocator),
            .active_emitters = std.ArrayList(*ParticleEmitter).init(allocator),
            .allocator = allocator,
            .global_wind = math.Vec3.zero(),
            .gravity = 9.81,
        }

        // Register built-in effects
        manager.registerEffect("SmokeSmall", &SMOKE_SMALL_DEF)
        manager.registerEffect("ExplosionMedium", &EXPLOSION_MEDIUM_DEF)
        manager.registerEffect("DebrisDirt", &DEBRIS_DIRT_DEF)
        manager.registerEffect("MissileTrail", &MISSILE_TRAIL_DEF)
        manager.registerEffect("MuzzleFlash", &MUZZLE_FLASH_DEF)

        return manager
    }

    pub fn deinit(self: *ParticleEffectManager) void {
        for (self.active_emitters.items) |emitter| {
            emitter.deinit(self.allocator)
            self.allocator.destroy(emitter)
        }
        self.active_emitters.deinit()
        self.emitter_defs.deinit()
    }

    pub fn registerEffect(self: *ParticleEffectManager, name: []const u8, def: *const ParticleEmitterDef) void {
        self.emitter_defs.put(name, def) catch {}
    }

    pub fn spawnEffect(self: *ParticleEffectManager, name: []const u8, position: math.Vec3) ?*ParticleEmitter {
        const def = self.emitter_defs.get(name) orelse return null

        const emitter = self.allocator.create(ParticleEmitter) catch return null
        emitter.* = ParticleEmitter.init(def, self.allocator) catch {
            self.allocator.destroy(emitter)
            return null
        }
        emitter.position = position
        emitter.play()

        self.active_emitters.append(emitter) catch {
            emitter.deinit(self.allocator)
            self.allocator.destroy(emitter)
            return null
        }

        return emitter
    }

    pub fn update(self: *ParticleEffectManager, delta_time: f32) void {
        var i: usize = 0
        while (i < self.active_emitters.items.len) {
            const emitter = self.active_emitters.items[i]
            emitter.update(delta_time, self.global_wind, self.gravity)

            // Remove completed one-shot emitters
            if (!emitter.is_playing and !emitter.is_looping and emitter.particle_count == 0) {
                emitter.deinit(self.allocator)
                self.allocator.destroy(emitter)
                _ = self.active_emitters.swapRemove(i)
            } else {
                i += 1
            }
        }
    }

    pub fn setWind(self: *ParticleEffectManager, wind: math.Vec3) void {
        self.global_wind = wind
    }

    pub fn getActiveParticleCount(self: *const ParticleEffectManager) u32 {
        var count: u32 = 0
        for (self.active_emitters.items) |emitter| {
            count += emitter.particle_count
        }
        return count
    }
}

// ============================================================================
// Tests
// ============================================================================

test "Particle emitter initialization" {
    var emitter = try ParticleEmitter.init(&SMOKE_SMALL_DEF, std.testing.allocator)
    defer emitter.deinit(std.testing.allocator)

    try std.testing.expect(emitter.is_playing == true)
    try std.testing.expect(emitter.particle_count == 0)
}

test "Value range sampling" {
    const vr = ValueRange.range(10.0, 20.0)

    const v0 = vr.sample(0.0)
    const v1 = vr.sample(1.0)
    const v_mid = vr.sample(0.5)

    try std.testing.expect(v0 == 10.0)
    try std.testing.expect(v1 == 20.0)
    try std.testing.expect(v_mid == 15.0)
}

test "Particle manager effect spawning" {
    var manager = ParticleEffectManager.init(std.testing.allocator)
    defer manager.deinit()

    const emitter = manager.spawnEffect("SmokeSmall", math.Vec3.zero())
    try std.testing.expect(emitter != null)
    try std.testing.expect(manager.active_emitters.items.len == 1)
}
