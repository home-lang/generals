// Matrix4 - 4x4 Matrix Math
// Ported from Thyme Engine (GPL licensed)
// Reference: Thyme/src/w3d/math/matrix4.h

// Vec3 for 3D positions/directions
struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(): Vec3 {
        return Vec3 {
            x: 0.0,
            y: 0.0,
            z: 0.0,
        }
    }

    fn create(x: f32, y: f32, z: f32): Vec3 {
        return Vec3 {
            x: x,
            y: y,
            z: z,
        }
    }
}

// Vec4 for 4D vectors (homogeneous coordinates)
struct Vec4 {
    x: f32,
    y: f32,
    z: f32,
    w: f32,
}

impl Vec4 {
    fn init(): Vec4 {
        return Vec4 {
            x: 0.0,
            y: 0.0,
            z: 0.0,
            w: 0.0,
        }
    }

    fn create(x: f32, y: f32, z: f32, w: f32): Vec4 {
        return Vec4 {
            x: x,
            y: y,
            z: z,
            w: w,
        }
    }

    fn zero(): Vec4 {
        return Vec4::init()
    }

    fn add(&self, other: Vec4): Vec4 {
        return Vec4 {
            x: self.x + other.x,
            y: self.y + other.y,
            z: self.z + other.z,
            w: self.w + other.w,
        }
    }

    fn sub(&self, other: Vec4): Vec4 {
        return Vec4 {
            x: self.x - other.x,
            y: self.y - other.y,
            z: self.z - other.z,
            w: self.w - other.w,
        }
    }

    fn mul_scalar(&self, s: f32): Vec4 {
        return Vec4 {
            x: self.x * s,
            y: self.y * s,
            z: self.z * s,
            w: self.w * s,
        }
    }

    fn equals(&self, other: Vec4): bool {
        return self.x == other.x && self.y == other.y && self.z == other.z && self.w == other.w
    }
}

// 4x4 Matrix stored as 4 Vec4 rows (row-major)
struct Mat4 {
    row0: Vec4,
    row1: Vec4,
    row2: Vec4,
    row3: Vec4,
}

impl Mat4 {
    // Create identity matrix
    fn identity(): Mat4 {
        return Mat4 {
            row0: Vec4::create(1.0, 0.0, 0.0, 0.0),
            row1: Vec4::create(0.0, 1.0, 0.0, 0.0),
            row2: Vec4::create(0.0, 0.0, 1.0, 0.0),
            row3: Vec4::create(0.0, 0.0, 0.0, 1.0),
        }
    }

    // Create zero matrix
    fn zero(): Mat4 {
        return Mat4 {
            row0: Vec4::zero(),
            row1: Vec4::zero(),
            row2: Vec4::zero(),
            row3: Vec4::zero(),
        }
    }

    // Create from row vectors
    fn from_rows(r0: Vec4, r1: Vec4, r2: Vec4, r3: Vec4): Mat4 {
        return Mat4 {
            row0: r0,
            row1: r1,
            row2: r2,
            row3: r3,
        }
    }

    // Create from 16 floats (row-major order)
    fn from_floats(
        f00: f32, f01: f32, f02: f32, f03: f32,
        f10: f32, f11: f32, f12: f32, f13: f32,
        f20: f32, f21: f32, f22: f32, f23: f32,
        f30: f32, f31: f32, f32_val: f32, f33: f32
    ): Mat4 {
        return Mat4 {
            row0: Vec4::create(f00, f01, f02, f03),
            row1: Vec4::create(f10, f11, f12, f13),
            row2: Vec4::create(f20, f21, f22, f23),
            row3: Vec4::create(f30, f31, f32_val, f33),
        }
    }

    // Create orthographic projection matrix
    fn ortho(left: f32, right: f32, bottom: f32, top: f32, near: f32, far: f32): Mat4 {
        let m = Mat4::identity()

        m.row0.x = 2.0 / (right - left)
        m.row0.w = -(right + left) / (right - left)

        m.row1.y = 2.0 / (top - bottom)
        m.row1.w = -(top + bottom) / (top - bottom)

        m.row2.z = -2.0 / (far - near)
        m.row2.w = -(far + near) / (far - near)

        return m
    }

    // Create perspective projection matrix from FOV
    fn perspective_fov(h_fov: f32, v_fov: f32, near: f32, far: f32): Mat4 {
        let m = Mat4::identity()

        m.row0.x = 1.0 / tan(h_fov * 0.5)
        m.row1.y = 1.0 / tan(v_fov * 0.5)
        m.row2.z = -(far + near) / (far - near)
        m.row2.w = -(2.0 * far * near) / (far - near)
        m.row3.z = -1.0
        m.row3.w = 0.0

        return m
    }

    // Create perspective projection matrix from frustum
    fn perspective(left: f32, right: f32, bottom: f32, top: f32, near: f32, far: f32): Mat4 {
        let m = Mat4::identity()

        m.row0.x = (2.0 * near) / (right - left)
        m.row0.z = (right + left) / (right - left)

        m.row1.y = (2.0 * near) / (top - bottom)
        m.row1.z = (top + bottom) / (top - bottom)

        m.row2.z = -(far + near) / (far - near)
        m.row2.w = -(2.0 * far * near) / (far - near)

        m.row3.z = -1.0
        m.row3.w = 0.0

        return m
    }

    // Get element at [row][col]
    fn get(&self, row: i32, col: i32): f32 {
        let r: Vec4 = Vec4::zero()
        if row == 0 {
            r = self.row0
        } else if row == 1 {
            r = self.row1
        } else if row == 2 {
            r = self.row2
        } else if row == 3 {
            r = self.row3
        }

        if col == 0 {
            return r.x
        } else if col == 1 {
            return r.y
        } else if col == 2 {
            return r.z
        } else if col == 3 {
            return r.w
        }
        return 0.0
    }

    // Set element at [row][col]
    fn set(&self, row: i32, col: i32, value: f32) {
        if row == 0 {
            if col == 0 {
                self.row0.x = value
            } else if col == 1 {
                self.row0.y = value
            } else if col == 2 {
                self.row0.z = value
            } else if col == 3 {
                self.row0.w = value
            }
        } else if row == 1 {
            if col == 0 {
                self.row1.x = value
            } else if col == 1 {
                self.row1.y = value
            } else if col == 2 {
                self.row1.z = value
            } else if col == 3 {
                self.row1.w = value
            }
        } else if row == 2 {
            if col == 0 {
                self.row2.x = value
            } else if col == 1 {
                self.row2.y = value
            } else if col == 2 {
                self.row2.z = value
            } else if col == 3 {
                self.row2.w = value
            }
        } else if row == 3 {
            if col == 0 {
                self.row3.x = value
            } else if col == 1 {
                self.row3.y = value
            } else if col == 2 {
                self.row3.z = value
            } else if col == 3 {
                self.row3.w = value
            }
        }
    }

    // Transpose matrix
    fn transpose(&self): Mat4 {
        return Mat4::from_rows(
            Vec4::create(self.row0.x, self.row1.x, self.row2.x, self.row3.x),
            Vec4::create(self.row0.y, self.row1.y, self.row2.y, self.row3.y),
            Vec4::create(self.row0.z, self.row1.z, self.row2.z, self.row3.z),
            Vec4::create(self.row0.w, self.row1.w, self.row2.w, self.row3.w),
        )
    }

    // Calculate determinant
    fn determinant(&self): f32 {
        let det: f32 = 0.0

        det = det + (self.row0.x * self.row1.y - self.row0.y * self.row1.x) * (self.row2.z * self.row3.w - self.row2.w * self.row3.z)
        det = det - (self.row0.x * self.row1.z - self.row0.z * self.row1.x) * (self.row2.y * self.row3.w - self.row2.w * self.row3.y)
        det = det + (self.row0.x * self.row1.w - self.row0.w * self.row1.x) * (self.row2.y * self.row3.z - self.row2.z * self.row3.y)
        det = det + (self.row0.y * self.row1.z - self.row0.z * self.row1.y) * (self.row2.x * self.row3.w - self.row2.w * self.row3.x)
        det = det - (self.row0.y * self.row1.w - self.row0.w * self.row1.y) * (self.row2.x * self.row3.z - self.row2.z * self.row3.x)
        det = det + (self.row0.z * self.row1.w - self.row0.w * self.row1.z) * (self.row2.x * self.row3.y - self.row2.y * self.row3.x)

        return det
    }

    // Calculate inverse matrix
    fn inverse(&self): Mat4 {
        let s = self.determinant()
        if s == 0.0 {
            return Mat4::zero()
        }

        let s_inv = 1.0 / s
        let t = Mat4::zero()

        // Row 0
        t.row0.x = s_inv * (
            self.row1.y * (self.row2.z * self.row3.w - self.row2.w * self.row3.z) +
            self.row1.z * (self.row2.w * self.row3.y - self.row2.y * self.row3.w) +
            self.row1.w * (self.row2.y * self.row3.z - self.row2.z * self.row3.y)
        )
        t.row0.y = s_inv * (
            self.row2.y * (self.row0.z * self.row3.w - self.row0.w * self.row3.z) +
            self.row2.z * (self.row0.w * self.row3.y - self.row0.y * self.row3.w) +
            self.row2.w * (self.row0.y * self.row3.z - self.row0.z * self.row3.y)
        )
        t.row0.z = s_inv * (
            self.row3.y * (self.row0.z * self.row1.w - self.row0.w * self.row1.z) +
            self.row3.z * (self.row0.w * self.row1.y - self.row0.y * self.row1.w) +
            self.row3.w * (self.row0.y * self.row1.z - self.row0.z * self.row1.y)
        )
        t.row0.w = s_inv * (
            self.row0.y * (self.row1.w * self.row2.z - self.row1.z * self.row2.w) +
            self.row0.z * (self.row1.y * self.row2.w - self.row1.w * self.row2.y) +
            self.row0.w * (self.row1.z * self.row2.y - self.row1.y * self.row2.z)
        )

        // Row 1
        t.row1.x = s_inv * (
            self.row1.z * (self.row2.x * self.row3.w - self.row2.w * self.row3.x) +
            self.row1.w * (self.row2.z * self.row3.x - self.row2.x * self.row3.z) +
            self.row1.x * (self.row2.w * self.row3.z - self.row2.z * self.row3.w)
        )
        t.row1.y = s_inv * (
            self.row2.z * (self.row0.x * self.row3.w - self.row0.w * self.row3.x) +
            self.row2.w * (self.row0.z * self.row3.x - self.row0.x * self.row3.z) +
            self.row2.x * (self.row0.w * self.row3.z - self.row0.z * self.row3.w)
        )
        t.row1.z = s_inv * (
            self.row3.z * (self.row0.x * self.row1.w - self.row0.w * self.row1.x) +
            self.row3.w * (self.row0.z * self.row1.x - self.row0.x * self.row1.z) +
            self.row3.x * (self.row0.w * self.row1.z - self.row0.z * self.row1.w)
        )
        t.row1.w = s_inv * (
            self.row0.z * (self.row1.w * self.row2.x - self.row1.x * self.row2.w) +
            self.row0.w * (self.row1.x * self.row2.z - self.row1.z * self.row2.x) +
            self.row0.x * (self.row1.z * self.row2.w - self.row1.w * self.row2.z)
        )

        // Row 2
        t.row2.x = s_inv * (
            self.row1.w * (self.row2.x * self.row3.y - self.row2.y * self.row3.x) +
            self.row1.x * (self.row2.y * self.row3.w - self.row2.w * self.row3.y) +
            self.row1.y * (self.row2.w * self.row3.x - self.row2.x * self.row3.w)
        )
        t.row2.y = s_inv * (
            self.row2.w * (self.row0.x * self.row3.y - self.row0.y * self.row3.x) +
            self.row2.x * (self.row0.y * self.row3.w - self.row0.w * self.row3.y) +
            self.row2.y * (self.row0.w * self.row3.x - self.row0.x * self.row3.w)
        )
        t.row2.z = s_inv * (
            self.row3.w * (self.row0.x * self.row1.y - self.row0.y * self.row1.x) +
            self.row3.x * (self.row0.y * self.row1.w - self.row0.w * self.row1.y) +
            self.row3.y * (self.row0.w * self.row1.x - self.row0.x * self.row1.w)
        )
        t.row2.w = s_inv * (
            self.row0.w * (self.row1.y * self.row2.x - self.row1.x * self.row2.y) +
            self.row0.x * (self.row1.w * self.row2.y - self.row1.y * self.row2.w) +
            self.row0.y * (self.row1.x * self.row2.w - self.row1.w * self.row2.x)
        )

        // Row 3
        t.row3.x = s_inv * (
            self.row1.x * (self.row2.z * self.row3.y - self.row2.y * self.row3.z) +
            self.row1.y * (self.row2.x * self.row3.z - self.row2.z * self.row3.x) +
            self.row1.z * (self.row2.y * self.row3.x - self.row2.x * self.row3.y)
        )
        t.row3.y = s_inv * (
            self.row2.x * (self.row0.z * self.row3.y - self.row0.y * self.row3.z) +
            self.row2.y * (self.row0.x * self.row3.z - self.row0.z * self.row3.x) +
            self.row2.z * (self.row0.y * self.row3.x - self.row0.x * self.row3.y)
        )
        t.row3.z = s_inv * (
            self.row3.x * (self.row0.z * self.row1.y - self.row0.y * self.row1.z) +
            self.row3.y * (self.row0.x * self.row1.z - self.row0.z * self.row1.x) +
            self.row3.z * (self.row0.y * self.row1.x - self.row0.x * self.row1.y)
        )
        t.row3.w = s_inv * (
            self.row0.x * (self.row1.y * self.row2.z - self.row1.z * self.row2.y) +
            self.row0.y * (self.row1.z * self.row2.x - self.row1.x * self.row2.z) +
            self.row0.z * (self.row1.x * self.row2.y - self.row1.y * self.row2.x)
        )

        return t
    }

    // Transform a Vec3 (treat as position with w=1)
    fn transform_point(&self, v: Vec3): Vec3 {
        return Vec3 {
            x: self.row0.x * v.x + self.row0.y * v.y + self.row0.z * v.z + self.row0.w,
            y: self.row1.x * v.x + self.row1.y * v.y + self.row1.z * v.z + self.row1.w,
            z: self.row2.x * v.x + self.row2.y * v.y + self.row2.z * v.z + self.row2.w,
        }
    }

    // Transform a Vec3 as direction (w=0, ignore translation)
    fn transform_direction(&self, v: Vec3): Vec3 {
        return Vec3 {
            x: self.row0.x * v.x + self.row0.y * v.y + self.row0.z * v.z,
            y: self.row1.x * v.x + self.row1.y * v.y + self.row1.z * v.z,
            z: self.row2.x * v.x + self.row2.y * v.y + self.row2.z * v.z,
        }
    }

    // Transform a Vec4
    fn transform_vec4(&self, v: Vec4): Vec4 {
        return Vec4 {
            x: self.row0.x * v.x + self.row0.y * v.y + self.row0.z * v.z + self.row0.w * v.w,
            y: self.row1.x * v.x + self.row1.y * v.y + self.row1.z * v.z + self.row1.w * v.w,
            z: self.row2.x * v.x + self.row2.y * v.y + self.row2.z * v.z + self.row2.w * v.w,
            w: self.row3.x * v.x + self.row3.y * v.y + self.row3.z * v.z + self.row3.w * v.w,
        }
    }

    // Matrix multiplication
    fn mul(&self, other: Mat4): Mat4 {
        let result = Mat4::zero()

        // Row 0
        result.row0.x = self.row0.x * other.row0.x + self.row0.y * other.row1.x + self.row0.z * other.row2.x + self.row0.w * other.row3.x
        result.row0.y = self.row0.x * other.row0.y + self.row0.y * other.row1.y + self.row0.z * other.row2.y + self.row0.w * other.row3.y
        result.row0.z = self.row0.x * other.row0.z + self.row0.y * other.row1.z + self.row0.z * other.row2.z + self.row0.w * other.row3.z
        result.row0.w = self.row0.x * other.row0.w + self.row0.y * other.row1.w + self.row0.z * other.row2.w + self.row0.w * other.row3.w

        // Row 1
        result.row1.x = self.row1.x * other.row0.x + self.row1.y * other.row1.x + self.row1.z * other.row2.x + self.row1.w * other.row3.x
        result.row1.y = self.row1.x * other.row0.y + self.row1.y * other.row1.y + self.row1.z * other.row2.y + self.row1.w * other.row3.y
        result.row1.z = self.row1.x * other.row0.z + self.row1.y * other.row1.z + self.row1.z * other.row2.z + self.row1.w * other.row3.z
        result.row1.w = self.row1.x * other.row0.w + self.row1.y * other.row1.w + self.row1.z * other.row2.w + self.row1.w * other.row3.w

        // Row 2
        result.row2.x = self.row2.x * other.row0.x + self.row2.y * other.row1.x + self.row2.z * other.row2.x + self.row2.w * other.row3.x
        result.row2.y = self.row2.x * other.row0.y + self.row2.y * other.row1.y + self.row2.z * other.row2.y + self.row2.w * other.row3.y
        result.row2.z = self.row2.x * other.row0.z + self.row2.y * other.row1.z + self.row2.z * other.row2.z + self.row2.w * other.row3.z
        result.row2.w = self.row2.x * other.row0.w + self.row2.y * other.row1.w + self.row2.z * other.row2.w + self.row2.w * other.row3.w

        // Row 3
        result.row3.x = self.row3.x * other.row0.x + self.row3.y * other.row1.x + self.row3.z * other.row2.x + self.row3.w * other.row3.x
        result.row3.y = self.row3.x * other.row0.y + self.row3.y * other.row1.y + self.row3.z * other.row2.y + self.row3.w * other.row3.y
        result.row3.z = self.row3.x * other.row0.z + self.row3.y * other.row1.z + self.row3.z * other.row2.z + self.row3.w * other.row3.z
        result.row3.w = self.row3.x * other.row0.w + self.row3.y * other.row1.w + self.row3.z * other.row2.w + self.row3.w * other.row3.w

        return result
    }

    // Matrix addition
    fn add(&self, other: Mat4): Mat4 {
        return Mat4::from_rows(
            self.row0.add(other.row0),
            self.row1.add(other.row1),
            self.row2.add(other.row2),
            self.row3.add(other.row3),
        )
    }

    // Matrix subtraction
    fn sub(&self, other: Mat4): Mat4 {
        return Mat4::from_rows(
            self.row0.sub(other.row0),
            self.row1.sub(other.row1),
            self.row2.sub(other.row2),
            self.row3.sub(other.row3),
        )
    }

    // Scalar multiplication
    fn mul_scalar(&self, s: f32): Mat4 {
        return Mat4::from_rows(
            self.row0.mul_scalar(s),
            self.row1.mul_scalar(s),
            self.row2.mul_scalar(s),
            self.row3.mul_scalar(s),
        )
    }

    // Scalar division
    fn div_scalar(&self, s: f32): Mat4 {
        let inv = 1.0 / s
        return self.mul_scalar(inv)
    }

    // Check equality
    fn equals(&self, other: Mat4): bool {
        return self.row0.equals(other.row0) &&
               self.row1.equals(other.row1) &&
               self.row2.equals(other.row2) &&
               self.row3.equals(other.row3)
    }
}

