    return ""
}

// Substring extraction
fn substring(str: string, start: i32, end: i32): string {
    // Placeholder - in real implementation would extract substring
    return str
}

// String trimming
fn trim(str: string): string {
    let start = 0
    let end = str.len()

    // Find first non-whitespace
    while start < end {
        let ch = str.char_code_at(start)
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {  // space, tab, lf, cr
            break
        }
        start = start + 1
    }

    // Find last non-whitespace
    while end > start {
        let ch = str.char_code_at(end - 1)
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        end = end - 1
    }

    return substring(str, start, end)
}

// Global string pool
let g_string_pool: StringPool? = null

fn init_string_pool() {
    g_string_pool = StringPool::init()
}

fn shutdown_string_pool() {
    if g_string_pool != null {
        g_string_pool.deinit()
        g_string_pool = null
    }
}

fn intern_string(str: string): string {
    if g_string_pool != null {
        return g_string_pool.intern(str)
    }
    return str
}
