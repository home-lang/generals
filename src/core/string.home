// Ported to Home with modern string handling

// String pool size constant
let STRING_POOL_SIZE: i32 = 4096

// String pool entry
struct StringPoolEntry {
    value: string,
    hash: i32,
}

// String pool for interning common strings
struct StringPool {
    entries: [StringPoolEntry],
    count: i32,
}

impl StringPool {
    fn init(): StringPool {
        return StringPool {
            entries: [],
            count: 0,
        }
    }

    fn intern(&self, str: string): string {
        // Check if string already exists in pool
        let hash = hash_string(str)
        for i in 0..self.count {
            if self.entries[i].hash == hash {
                if string_eq(self.entries[i].value, str) {
                    return self.entries[i].value
                }
            }
        }

        // Add new string to pool
        if self.count < STRING_POOL_SIZE {
            let entry = StringPoolEntry {
                value: str,
                hash: hash,
            }
            self.entries = self.entries + [entry]
            self.count = self.count + 1
            return str
        }

        // Pool full, return original
        return str
    }

    fn deinit(&self) {
        self.entries = []
        self.count = 0
    }
}

// Dynamic string builder
struct StringBuilder {
    buffer: string,
    length: i32,
}

impl StringBuilder {
    fn init(): StringBuilder {
        return StringBuilder {
            buffer: "",
            length: 0,
        }
    }

    fn from_string(str: string): StringBuilder {
        return StringBuilder {
            buffer: str,
            length: str.len(),
        }
    }

    fn append(&self, str: string) {
        self.buffer = self.buffer + str
        self.length = self.buffer.len()
    }

    fn append_char(&self, ch: string) {
        self.buffer = self.buffer + ch
        self.length = self.buffer.len()
    }

    fn append_int(&self, value: i32) {
        self.buffer = self.buffer + int_to_string(value)
        self.length = self.buffer.len()
    }

    fn clear(&self) {
        self.buffer = ""
        self.length = 0
    }

    fn to_string(&self): string {
        return self.buffer
    }
}

// String utilities
fn hash_string(str: string): i32 {
    let hash = 0
    let len = str.len()
    for i in 0..len {
        hash = hash * 31 + str.char_code_at(i)
    }
    return hash
}

fn string_eq(a: string, b: string): bool {
    if a.len() != b.len() {
        return false
    }

    let len = a.len()
    for i in 0..len {
        if a.char_at(i) != b.char_at(i) {
            return false
        }
    }

    return true
}

fn string_starts_with(str: string, prefix: string): bool {
    if prefix.len() > str.len() {
        return false
    }

    let len = prefix.len()
    for i in 0..len {
        if str.char_at(i) != prefix.char_at(i) {
            return false
        }
    }

    return true
}

fn string_ends_with(str: string, suffix: string): bool {
    if suffix.len() > str.len() {
        return false
    }

    let offset = str.len() - suffix.len()
    let len = suffix.len()
    for i in 0..len {
        if str.char_at(offset + i) != suffix.char_at(i) {
            return false
        }
    }

    return true
}

fn string_contains(str: string, needle: string): bool {
    if needle.len() > str.len() {
        return false
    }

    let search_len = str.len() - needle.len() + 1
    for i in 0..search_len {
        let found = true
        for j in 0..needle.len() {
            if str.char_at(i + j) != needle.char_at(j) {
                found = false
                break
            }
        }
        if found {
            return true
        }
    }

    return false
}

fn string_find(str: string, needle: string): i32 {
    if needle.len() > str.len() {
        return -1
    }

    let search_len = str.len() - needle.len() + 1
    for i in 0..search_len {
        let found = true
        for j in 0..needle.len() {
            if str.char_at(i + j) != needle.char_at(j) {
                found = false
                break
            }
        }
        if found {
            return i
        }
    }

    return -1
}

fn to_lower(str: string): string {
    let result = ""
    let len = str.len()

    for i in 0..len {
        let ch = str.char_code_at(i)
        if ch >= 65 && ch <= 90 {  // A-Z
            result = result + char_from_code(ch + 32)
        } else {
            result = result + str.char_at(i)
        }
    }

    return result
}

fn to_upper(str: string): string {
    let result = ""
    let len = str.len()

    for i in 0..len {
        let ch = str.char_code_at(i)
        if ch >= 97 && ch <= 122 {  // a-z
            result = result + char_from_code(ch - 32)
        } else {
            result = result + str.char_at(i)
        }
    }

    return result
}

fn int_to_string(value: i32): string {
    if value == 0 {
        return "0"
    }

    let result = ""
    let n = value
    let negative = n < 0

    if negative {
        n = -n
    }

    while n > 0 {
        let digit = n % 10
        result = char_from_code(48 + digit) + result  // '0' = 48
        n = n / 10
    }

    if negative {
        result = "-" + result
    }

    return result
}

