    // ControlBarScheme.ini - Control bar layouts
    let ctrlbar_default = game.file_system.read_file_as_string("Data/INI/Default/ControlBarScheme.ini")
    if ctrlbar_default != null {
        let doc = parser.parse(ctrlbar_default)
