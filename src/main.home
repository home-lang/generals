    }

    // InGameUI.ini - In-game UI settings
    let ingameui_ini = game.file_system.read_file_as_string("Data/INI/InGameUI.ini")
    if ingameui_ini != null {
        let doc = parser.parse(ingameui_ini)
        if doc != null {
            process_ingameui_ini(game, doc)
        }
    }

    // =========================================================================
    // SHELL AND MENUS
    // =========================================================================

    // ShellMenuScheme.ini - Main menu layout
    let shell_default = game.file_system.read_file_as_string("Data/INI/Default/ShellMenuScheme.ini")
    if shell_default != null {
        let doc = parser.parse(shell_default)
        if doc != null {
            process_shell_ini(game, doc)
        }
    }
    let shell_ini = game.file_system.read_file_as_string("Data/INI/ShellMenuScheme.ini")
    if shell_ini != null {
        let doc = parser.parse(shell_ini)
        if doc != null {
            process_shell_ini(game, doc)
        }
    }

    // WindowTransitions.ini - UI transition animations
    let wndtrans_ini = game.file_system.read_file_as_string("Data/INI/WindowTransitions.ini")
    if wndtrans_ini != null {
        let doc = parser.parse(wndtrans_ini)
        if doc != null {
            process_windowtransitions_ini(game, doc)
        }
    }

    // =========================================================================
    // CAMPAIGN AND CHALLENGE
    // =========================================================================

    // Campaign.ini - Campaign mission definitions
    let campaign_ini = game.file_system.read_file_as_string("Data/INI/Campaign.ini")
    if campaign_ini != null {
        let doc = parser.parse(campaign_ini)
        if doc != null {
            process_campaign_ini(game, doc)
        }
    }

    // ChallengeMode.ini - Generals Challenge definitions
    let challenge_ini = game.file_system.read_file_as_string("Data/INI/ChallengeMode.ini")
    if challenge_ini != null {
        let doc = parser.parse(challenge_ini)
        if doc != null {
            process_challenge_ini(game, doc)
        }
    }

    // =========================================================================
    // MISCELLANEOUS
    // =========================================================================

    // GameLOD.ini - Level of detail settings
    let gamelod_ini = game.file_system.read_file_as_string("Data/INI/GameLOD.ini")
    if gamelod_ini != null {
        let doc = parser.parse(gamelod_ini)
        if doc != null {
            process_gamelod_ini(game, doc)
        }
    }

    // GameLODPresets.ini - LOD presets
    let gamelodpresets_ini = game.file_system.read_file_as_string("Data/INI/GameLODPresets.ini")
    if gamelodpresets_ini != null {
        let doc = parser.parse(gamelodpresets_ini)
        if doc != null {
            process_gamelod_ini(game, doc)
        }
    }

    // Mouse.ini - Mouse cursor settings
    let mouse_ini = game.file_system.read_file_as_string("Data/INI/Mouse.ini")
    if mouse_ini != null {
        let doc = parser.parse(mouse_ini)
        if doc != null {
            process_mouse_ini(game, doc)
        }
    }

    // Video.ini - Video definitions
    let video_default = game.file_system.read_file_as_string("Data/INI/Default/Video.ini")
    if video_default != null {
        let doc = parser.parse(video_default)
        if doc != null {
            process_video_ini(game, doc)
        }
    }
    let video_ini = game.file_system.read_file_as_string("Data/INI/Video.ini")
    if video_ini != null {
        let doc = parser.parse(video_ini)
        if doc != null {
            process_video_ini(game, doc)
        }
    }

    // Eva.ini - EVA voice announcements
    let eva_ini = game.file_system.read_file_as_string("Data/INI/Eva.ini")
    if eva_ini != null {
        let doc = parser.parse(eva_ini)
        if doc != null {
            process_eva_ini(game, doc)
        }
    }

    // Credits.ini - Credits screen data
    let credits_ini = game.file_system.read_file_as_string("Data/INI/Credits.ini")
    if credits_ini != null {
        let doc = parser.parse(credits_ini)
        if doc != null {
            process_credits_ini(game, doc)
        }
    }

    // Animation2D.ini - 2D animation definitions
    let anim2d_ini = game.file_system.read_file_as_string("Data/INI/Animation2D.ini")
    if anim2d_ini != null {
        let doc = parser.parse(anim2d_ini)
        if doc != null {
            process_animation2d_ini(game, doc)
        }
    }

    // DrawGroupInfo.ini - Draw group settings
    let drawgroup_ini = game.file_system.read_file_as_string("Data/INI/DrawGroupInfo.ini")
    if drawgroup_ini != null {
        let doc = parser.parse(drawgroup_ini)
        if doc != null {
            process_drawgroup_ini(game, doc)
        }
    }

    return true
}

