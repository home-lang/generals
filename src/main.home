    // =========================================================================
    // LOCOMOTOR AND MOVEMENT
    // =========================================================================

    // Locomotor.ini - Movement types for units
    let locomotor_ini = game.file_system.read_file_as_string("Data/INI/Locomotor.ini")
    if locomotor_ini != null {
        let doc = parser.parse(locomotor_ini)
        if doc != null {
            process_locomotor_ini(game, doc)
        }
    }

    // =========================================================================
    // SPECIAL POWERS
    // =========================================================================

    // SpecialPower.ini - General abilities and superweapons
    let sp_default = game.file_system.read_file_as_string("Data/INI/Default/SpecialPower.ini")
    if sp_default != null {
        let doc = parser.parse(sp_default)
        if doc != null {
            process_specialpower_ini(game, doc)
        }
    }
    let sp_ini = game.file_system.read_file_as_string("Data/INI/SpecialPower.ini")
    if sp_ini != null {
        let doc = parser.parse(sp_ini)
        if doc != null {
            process_specialpower_ini(game, doc)
        }
    }

    // =========================================================================
    // OBJECT CREATION LISTS
    // =========================================================================

    // ObjectCreationList.ini - Object spawning definitions
    let ocl_default = game.file_system.read_file_as_string("Data/INI/Default/ObjectCreationList.ini")
    if ocl_default != null {
        let doc = parser.parse(ocl_default)
        if doc != null {
            process_objectcreationlist_ini(game, doc)
        }
    }
    let ocl_ini = game.file_system.read_file_as_string("Data/INI/ObjectCreationList.ini")
    if ocl_ini != null {
        let doc = parser.parse(ocl_ini)
        if doc != null {
            process_objectcreationlist_ini(game, doc)
        }
    }

    // =========================================================================
    // OBJECT DEFINITIONS (Units, Buildings, Props)
    // =========================================================================

    // Default objects first
    let object_default = game.file_system.read_file_as_string("Data/INI/Default/Object.ini")
    if object_default != null {
        let doc = parser.parse(object_default)
        if doc != null {
            process_object_ini(game, doc)
        }
    }

    // Load all object INI files from the Object directory
    let object_files = game.file_system.find_files("Data/INI/Object/*.ini")
    let file_index = 0
    while file_index < object_files.len() {
        let object_file = object_files[file_index]
        let object_data = game.file_system.read_file_as_string(object_file)
        if object_data != null {
            let doc = parser.parse(object_data)
            if doc != null {
                process_object_ini(game, doc)
            }
        }
        file_index = file_index + 1
    }

    // =========================================================================
    // UPGRADES
    // =========================================================================

    // Upgrade.ini - All upgrade definitions
    let upgrade_default = game.file_system.read_file_as_string("Data/INI/Default/Upgrade.ini")
