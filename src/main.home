    // Rank.ini - Player rank progression
    let rank_ini = game.file_system.read_file_as_string("Data/INI/Rank.ini")
    if rank_ini != null {
        let doc = parser.parse(rank_ini)
        if doc != null {
            process_rank_ini(game, doc)
        }
    }

    // =========================================================================
    // EFFECTS DEFINITIONS
    // =========================================================================

    // FXList.ini - Visual and sound effects
    let fx_default = game.file_system.read_file_as_string("Data/INI/Default/FXList.ini")
    if fx_default != null {
        let doc = parser.parse(fx_default)
        if doc != null {
            process_fxlist_ini(game, doc)
        }
    }
    let fx_ini = game.file_system.read_file_as_string("Data/INI/FXList.ini")
    if fx_ini != null {
        let doc = parser.parse(fx_ini)
        if doc != null {
            process_fxlist_ini(game, doc)
        }
    }

    // ParticleSystem.ini - Particle effects
    let particle_ini = game.file_system.read_file_as_string("Data/INI/ParticleSystem.ini")
    if particle_ini != null {
        let doc = parser.parse(particle_ini)
        if doc != null {
            process_particle_ini(game, doc)
        }
    }

    // =========================================================================
    // COMBAT DEFINITIONS
    // =========================================================================

    // Weapon.ini - All weapon definitions
    let weapon_ini = game.file_system.read_file_as_string("Data/INI/Weapon.ini")
    if weapon_ini != null {
        let doc = parser.parse(weapon_ini)
        if doc != null {
            process_weapon_ini(game, doc)
