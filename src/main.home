    cheat_system: CheatSystem,
    script_engine: ScriptEngine,
    video_player: VideoPlayer,
    cinematic_system: CinematicSystem,

    // Camera and display
    camera: RTSCamera,
    shell_map: ShellMap,

    // Command system
    command_system: CommandSystem,

    // State
    is_running: bool,
    is_paused: bool,
    current_mode: GameMode,
}

impl GeneralsGame {
    fn init(): GeneralsGame {
        let game = GeneralsGame {
            file_system: BigFileSystem::init(),
            renderer: MetalRenderer::init(),
            w3d_loader: W3DLoader::init(),
            texture_manager: TextureManager::init(),
            audio_engine: AudioEngine::init(),
            game_state: GameState::init(),
            world: World::init(),
            player_manager: PlayerManager::init(),
            entity_manager: EntityManager::init(),
            combat_system: CombatSystem::init(),
            damage_system: DamageSystem::init(),
            projectile_manager: ProjectileManager::init(),
            pathfinder: HPAPathfinder::init(),
            ai_controllers: [],
            terrain_renderer: TerrainRenderer::init(),
            particle_system: ParticleSystem::init(),
            shadow_renderer: ShadowRenderer::init(),
            water_renderer: WaterRenderer::init(),
            post_processor: PostProcessor::init(),
            ui_system: UISystem::init(),
            minimap: Minimap::init(),
            menu_system: MenuSystem::init(),
            audio_system: AudioSystem::init(),
            eva_system: EVASystem::init(),
            fog_of_war: FogOfWar::init(),
            veterancy_system: VeterancySystem::init(),
            upgrade_system: UpgradeSystem::init(),
            economy_system: EconomySystem::init(),
            campaign_system: CampaignSystem::init(),
            generals_challenge: GeneralsChallenge::init(),
            multiplayer_system: MultiplayerSystem::init(),
            save_load_manager: SaveLoadManager::init(),
            replay_system: ReplaySystem::init(),
            localization: Localization::init(),
            cheat_system: CheatSystem::init(),
            script_engine: ScriptEngine::init(),
            video_player: VideoPlayer::init(),
            cinematic_system: CinematicSystem::init(),
            camera: RTSCamera::init(),
            shell_map: ShellMap::init(),
            command_system: CommandSystem::init(),
            is_running: false,
            is_paused: false,
            current_mode: GameMode::MainMenu,
        }
        return game
    }
}

// ============================================================================
// INITIALIZATION
// ============================================================================

fn initialize(game: GeneralsGame, game_path: string): bool {
    // 1. Load game archives (BIG files)
    if !load_archives(game, game_path) {
        return false
    }

    // 2. Initialize renderer
    if !init_renderer(game) {
        return false
    }

    // 3. Load localization
    if !load_localization(game) {
        return false
    }

    // 4. Load game data from INI files
    if !load_game_data(game) {
        return false
    }

    // 5. Initialize audio
    if !init_audio(game) {
        return false
    }

    // 6. Initialize UI
    if !init_ui(game) {
        return false
    }

    // 7. Show intro videos (optional)
    // game.video_player.play("data/movies/ea_logo.bik")
    // game.video_player.play("data/movies/intro.bik")

    game.is_running = true
    return true
}

fn load_archives(game: GeneralsGame, game_path: string): bool {
    // Load all standard BIG archives
    let count = game.file_system.load_directory(game_path)

    if count == 0 {
        return false
    }

    // Connect W3D loader to file system
    game.w3d_loader.set_file_system(game.file_system)

    return true
}

fn init_renderer(game: GeneralsGame): bool {
    // Initialize Metal rendering pipeline
    // In production: create window and Metal device

    return true
}

fn load_localization(game: GeneralsGame): bool {
    // Load CSF string files
    // Assets are in: assets/data/English/generals.csf
    let csf_data = game.file_system.read_file("assets/data/English/generals.csf")
    if csf_data != null {
        game.localization.load_csf(csf_data)
    }

    // Zero Hour strings
    let csf_zh_data = game.file_system.read_file("assets/data/English/generalszh.csf")
    if csf_zh_data != null {
        game.localization.load_csf(csf_zh_data)
    }

    return true
}

fn load_game_data(game: GeneralsGame): bool {
    // Load game data INI files in order matching Thyme's gameengine.cpp initialization
    // This follows the authentic C&C Generals Zero Hour loading sequence

    let parser = INIParser::init()

    // =========================================================================
    // CORE GAME DATA
    // =========================================================================

    // GameData.ini - Core game settings (frame rate, memory, debug options)
    let gamedata_ini = game.file_system.read_file_as_string("Data/INI/Default/GameData.ini")
    if gamedata_ini != null {
        let doc = parser.parse(gamedata_ini)
        if doc != null {
            process_gamedata_ini(game, doc)
        }
    }
    let gamedata_override = game.file_system.read_file_as_string("Data/INI/GameData.ini")
    if gamedata_override != null {
        let doc = parser.parse(gamedata_override)
        if doc != null {
            process_gamedata_ini(game, doc)
        }
    }

    // =========================================================================
    // ENVIRONMENT INI FILES
    // =========================================================================

    // Water.ini - Water rendering settings
    let water_default = game.file_system.read_file_as_string("Data/INI/Default/Water.ini")
    if water_default != null {
        let doc = parser.parse(water_default)
        if doc != null {
            process_water_ini(game, doc)
        }
    }
    let water_ini = game.file_system.read_file_as_string("Data/INI/Water.ini")
    if water_ini != null {
        let doc = parser.parse(water_ini)
        if doc != null {
            process_water_ini(game, doc)
        }
    }

    // Weather.ini - Weather effects settings
    let weather_default = game.file_system.read_file_as_string("Data/INI/Default/Weather.ini")
    if weather_default != null {
        let doc = parser.parse(weather_default)
        if doc != null {
            process_weather_ini(game, doc)
        }
    }
    let weather_ini = game.file_system.read_file_as_string("Data/INI/Weather.ini")
    if weather_ini != null {
        let doc = parser.parse(weather_ini)
        if doc != null {
            process_weather_ini(game, doc)
        }
    }

    // =========================================================================
    // SCIENCE AND TECH TREE
    // =========================================================================

    // Science.ini - Technology research definitions
    let science_default = game.file_system.read_file_as_string("Data/INI/Default/Science.ini")
    if science_default != null {
        let doc = parser.parse(science_default)
        if doc != null {
            process_science_ini(game, doc)
        }
    }
    let science_ini = game.file_system.read_file_as_string("Data/INI/Science.ini")
    if science_ini != null {
        let doc = parser.parse(science_ini)
        if doc != null {
            process_science_ini(game, doc)
        }
    }

    // =========================================================================
    // MULTIPLAYER SETTINGS
    // =========================================================================

    // Multiplayer.ini - Multiplayer game settings
    let mp_default = game.file_system.read_file_as_string("Data/INI/Default/Multiplayer.ini")
    if mp_default != null {
        let doc = parser.parse(mp_default)
        if doc != null {
            process_multiplayer_ini(game, doc)
        }
    }
    let mp_ini = game.file_system.read_file_as_string("Data/INI/Multiplayer.ini")
    if mp_ini != null {
        let doc = parser.parse(mp_ini)
        if doc != null {
            process_multiplayer_ini(game, doc)
        }
    }

    // =========================================================================
    // TERRAIN DEFINITIONS
    // =========================================================================

    // Terrain.ini - Terrain types and properties
    let terrain_default = game.file_system.read_file_as_string("Data/INI/Default/Terrain.ini")
    if terrain_default != null {
        let doc = parser.parse(terrain_default)
        if doc != null {
            process_terrain_ini(game, doc)
        }
    }
    let terrain_ini = game.file_system.read_file_as_string("Data/INI/Terrain.ini")
    if terrain_ini != null {
        let doc = parser.parse(terrain_ini)
        if doc != null {
            process_terrain_ini(game, doc)
        }
    }

    // Roads.ini - Road definitions
    let roads_default = game.file_system.read_file_as_string("Data/INI/Default/Roads.ini")
    if roads_default != null {
        let doc = parser.parse(roads_default)
        if doc != null {
            process_roads_ini(game, doc)
        }
    }
    let roads_ini = game.file_system.read_file_as_string("Data/INI/Roads.ini")
    if roads_ini != null {
        let doc = parser.parse(roads_ini)
        if doc != null {
            process_roads_ini(game, doc)
