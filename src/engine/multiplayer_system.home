// Multiplayer Networking System - Complete lobby, matchmaking, synchronization
// Implements C&C Generals Zero Hour multiplayer mechanics

// ============================================================================
// NETWORK CONSTANTS
// ============================================================================

let DEFAULT_PORT: i32 = 8086
let MAX_PLAYERS: i32 = 8
let MAX_PACKET_SIZE: i32 = 1400
let TICK_RATE: i32 = 15          // Game ticks per second
let COMMAND_DELAY: i32 = 2       // Ticks of command delay for lockstep

// Protocol version for compatibility
let PROTOCOL_VERSION: i32 = 100

// ============================================================================
// NETWORK TYPES
// ============================================================================

enum NetworkMode {
    OFFLINE,
    LAN_HOST,
    LAN_CLIENT,
    ONLINE_HOST,
    ONLINE_CLIENT,
}

enum ConnectionState {
    DISCONNECTED,
    CONNECTING,
    CONNECTED,
    IN_LOBBY,
    IN_GAME,
    LOADING,
    SYNCING,
    ERROR,
}

enum PacketType {
    // Connection
    PING,
    PONG,
    CONNECT_REQUEST,
    CONNECT_ACCEPT,
    CONNECT_REJECT,
    DISCONNECT,
    HEARTBEAT,

    // Lobby
    LOBBY_INFO,
    PLAYER_JOIN,
    PLAYER_LEAVE,
    PLAYER_UPDATE,
    CHAT_MESSAGE,
    GAME_SETTINGS,
    READY_STATE,
    START_GAME,

    // Game sync
    GAME_COMMAND,
    SYNC_CHECK,
    SYNC_ERROR,
    TICK_ACK,
    GAME_STATE,

    // Misc
    FILE_TRANSFER,
    MAP_REQUEST,
    MAP_DATA,
}

// ============================================================================
// PACKET STRUCTURES
// ============================================================================

struct PacketHeader {
    magic: i32,              // "GNRL"
    version: i32,
    packet_type: i32,
    sequence: i32,
    timestamp: i32,
    payload_size: i32,
}

impl PacketHeader {
    fn init(): PacketHeader {
        return PacketHeader {
            magic: 0x4C524E47,   // "GNRL"
            version: PROTOCOL_VERSION,
            packet_type: 0,
            sequence: 0,
            timestamp: 0,
            payload_size: 0,
        }
    }
}

let PACKET_MAGIC: i32 = 0x4C524E47   // "GNRL"

struct Packet {
    header: PacketHeader,
    data: [i32],
    data_size: i32,
}

impl Packet {
    fn init(packet_type: PacketType, sequence: i32): Packet {
        return Packet {
            header: PacketHeader {
                magic: PACKET_MAGIC,
                version: PROTOCOL_VERSION,
                packet_type: cast(i32, packet_type),
                sequence: sequence,
                timestamp: get_timestamp(),
                payload_size: 0,
            },
            data: [],
            data_size: 0,
        }
    }

    fn write_i32(&self, value: i32) {
        if self.data_size < MAX_PACKET_SIZE - 4 {
            self.data = self.data + [value & 0xFF]
            self.data = self.data + [(value >> 8) & 0xFF]
            self.data = self.data + [(value >> 16) & 0xFF]
            self.data = self.data + [(value >> 24) & 0xFF]
            self.data_size = self.data_size + 4
            self.header.payload_size = self.data_size
        }
    }

    fn write_f32(&self, value: f32) {
        // Simplified - would use proper float bits
        self.write_i32(cast(i32, value * 1000.0))
    }

    fn write_string(&self, str: string, len: i32) {
        self.data = self.data + [len]
        self.data_size = self.data_size + 1
        // Would write string bytes
    }
}

fn read_i32(data: [i32], offset: i32): i32 {
    if offset + 3 >= data.length {
        return 0
    }
    return data[offset] |
           (data[offset + 1] << 8) |
           (data[offset + 2] << 16) |
           (data[offset + 3] << 24)
}

fn read_f32(data: [i32], offset: i32): f32 {
    return cast(f32, read_i32(data, offset)) / 1000.0
}

// ============================================================================
// PLAYER INFO
// ============================================================================

struct NetworkPlayer {
    id: i32,
    name: string,
    ip_address: string,
    port: i32,
    ping: i32,

    // Game settings
    faction: i32,            // -1 for random
    color: i32,
    team: i32,
    handicap: i32,           // 0-100
    general_type: i32,       // For Generals Challenge

    // State
    connection_state: ConnectionState,
    is_ready: bool,
    is_host: bool,
    is_ai: bool,
    ai_difficulty: i32,

    // Sync
    last_ack_tick: i32,
    commands_pending: i32,
}

impl NetworkPlayer {
    fn init(name: string): NetworkPlayer {
        return NetworkPlayer {
            id: 0,
            name: name,
            ip_address: "127.0.0.1",
            port: DEFAULT_PORT,
            ping: 0,
            faction: -1,
            color: 0,
            team: 0,
            handicap: 100,
            general_type: -1,
            connection_state: ConnectionState::DISCONNECTED,
            is_ready: false,
            is_host: false,
            is_ai: false,
            ai_difficulty: 1,
            last_ack_tick: 0,
            commands_pending: 0,
        }
    }

    fn init_ai(id: i32, difficulty: i32): NetworkPlayer {
        return NetworkPlayer {
            id: id,
            name: "Computer",
            ip_address: "",
            port: 0,
            ping: 0,
            faction: -1,
            color: id,
            team: id,
            handicap: 100,
            general_type: -1,
            connection_state: ConnectionState::CONNECTED,
            is_ready: true,
            is_host: false,
            is_ai: true,
            ai_difficulty: difficulty,
            last_ack_tick: 0,
            commands_pending: 0,
        }
    }
}

// ============================================================================
// GAME COMMANDS
// ============================================================================

enum CommandType {
    // Unit commands
    MOVE,
    ATTACK,
    ATTACK_MOVE,
    STOP,
    GUARD,
    PATROL,
    FORCE_ATTACK,
    SCATTER,

    // Building commands
    BUILD_STRUCTURE,
    SELL_STRUCTURE,
    SET_RALLY_POINT,
    REPAIR,

    // Production commands
    PRODUCE_UNIT,
    CANCEL_PRODUCTION,
    RESEARCH_UPGRADE,

    // Special commands
    USE_ABILITY,
    USE_GENERAL_POWER,
    DEPLOY,
    UNLOAD,
    GARRISON,
    EVACUATE,

    // Control
    SET_STANCE,
    SET_FORMATION,
    CREATE_GROUP,
    SELECT_GROUP,
}

struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(): Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }
}

struct GameCommand {
    command_type: CommandType,
    player_id: i32,
    tick: i32,
    sequence: i32,

    // Target data
    unit_ids: [i32],
    unit_count: i32,
    target_id: i32,
    target_position: Vec3,

    // Parameters
    int_param: i32,
    float_param: f32,
    string_param: string,
}

impl GameCommand {
    fn init(): GameCommand {
        return GameCommand {
            command_type: CommandType::MOVE,
            player_id: 0,
            tick: 0,
            sequence: 0,
            unit_ids: [],
            unit_count: 0,
            target_id: -1,
            target_position: Vec3::init(),
            int_param: 0,
            float_param: 0.0,
            string_param: "",
        }
    }

    fn create_move(player: i32, tick: i32, units: [i32], count: i32, target: Vec3): GameCommand {
        return GameCommand {
            command_type: CommandType::MOVE,
            player_id: player,
            tick: tick,
            sequence: 0,
            unit_ids: units,
            unit_count: count,
            target_id: -1,
            target_position: target,
            int_param: 0,
            float_param: 0.0,
            string_param: "",
        }
    }

    fn create_attack(player: i32, tick: i32, units: [i32], count: i32, target_unit: i32): GameCommand {
        return GameCommand {
            command_type: CommandType::ATTACK,
            player_id: player,
            tick: tick,
            sequence: 0,
            unit_ids: units,
            unit_count: count,
            target_id: target_unit,
            target_position: Vec3::init(),
            int_param: 0,
            float_param: 0.0,
            string_param: "",
        }
    }

    fn create_build(player: i32, tick: i32, building_type: string, position: Vec3): GameCommand {
        return GameCommand {
            command_type: CommandType::BUILD_STRUCTURE,
            player_id: player,
            tick: tick,
            sequence: 0,
            unit_ids: [],
            unit_count: 0,
            target_id: -1,
            target_position: position,
            int_param: 0,
            float_param: 0.0,
            string_param: building_type,
        }
    }

    fn create_produce(player: i32, tick: i32, building_id: i32, unit_type: string): GameCommand {
        return GameCommand {
            command_type: CommandType::PRODUCE_UNIT,
            player_id: player,
            tick: tick,
            sequence: 0,
            unit_ids: [building_id],
            unit_count: 1,
            target_id: -1,
            target_position: Vec3::init(),
            int_param: 0,
            float_param: 0.0,
            string_param: unit_type,
        }
    }

    fn serialize(&self, packet: Packet) {
        packet.write_i32(cast(i32, self.command_type))
        packet.write_i32(self.player_id)
        packet.write_i32(self.tick)
        packet.write_i32(self.sequence)

        packet.write_i32(self.unit_count)
        for i in 0..self.unit_count {
            packet.write_i32(self.unit_ids[i])
        }

        packet.write_i32(self.target_id)
        packet.write_f32(self.target_position.x)
        packet.write_f32(self.target_position.y)
        packet.write_f32(self.target_position.z)

        packet.write_i32(self.int_param)
        packet.write_f32(self.float_param)
        packet.write_string(self.string_param, 32)
    }
}

// ============================================================================
// GAME LOBBY
// ============================================================================

enum GameType {
    SKIRMISH,
    RANKED,
    CUSTOM,
    GENERALS_CHALLENGE,
}

struct LobbySettings {
    game_name: string,
    map_name: string,
    game_type: GameType,
    max_players: i32,
    starting_supplies: i32,
    superweapons: bool,
    tech_level: i32,
    game_speed: i32,         // 0-5
    is_private: bool,
    password: string,
}

impl LobbySettings {
    fn init(): LobbySettings {
        return LobbySettings {
            game_name: "New Game",
            map_name: "TestMap",
            game_type: GameType::SKIRMISH,
            max_players: 4,
            starting_supplies: 10000,
            superweapons: true,
            tech_level: 1,
            game_speed: 3,
            is_private: false,
            password: "",
        }
    }
}

struct ChatMessage {
    player_id: i32,
    player_name: string,
    message: string,
    timestamp: i32,
    is_system: bool,
}

impl ChatMessage {
    fn init(): ChatMessage {
        return ChatMessage {
            player_id: 0,
            player_name: "",
            message: "",
            timestamp: 0,
            is_system: false,
        }
    }
}

struct GameLobby {
    settings: LobbySettings,
    players: [NetworkPlayer],
    player_count: i32,
    host_id: i32,

    // Chat
    chat_messages: [ChatMessage],
    chat_count: i32,

    // State
    is_open: bool,
    all_ready: bool,
    countdown_timer: f32,
    is_starting: bool,
}

impl GameLobby {
    fn init(host: NetworkPlayer, settings: LobbySettings): GameLobby {
        let host_player = host
        host_player.is_host = true
        host_player.connection_state = ConnectionState::IN_LOBBY

        return GameLobby {
            settings: settings,
            players: [host_player],
            player_count: 1,
            host_id: host.id,
            chat_messages: [],
            chat_count: 0,
            is_open: true,
            all_ready: false,
            countdown_timer: 0.0,
            is_starting: false,
        }
    }

    fn join(&self, player: NetworkPlayer): bool {
        if !self.is_open {
            return false
        }

        if self.player_count >= self.settings.max_players {
            return false
        }

        // Assign unique color
        let new_player = player
        new_player.color = self.player_count
        new_player.connection_state = ConnectionState::IN_LOBBY

        self.players = self.players + [new_player]
        self.player_count = self.player_count + 1

        // Add system message
        self.add_system_message("Player joined")

        return true
    }

    fn leave(&self, player_id: i32) {
        let found = -1
        for i in 0..self.player_count {
            if self.players[i].id == player_id {
                found = i
                break
            }
        }

        if found >= 0 {
            // Remove player
            let new_players: [NetworkPlayer] = []
            for i in 0..self.player_count {
                if i != found {
                    new_players = new_players + [self.players[i]]
                }
            }
            self.players = new_players
            self.player_count = self.player_count - 1

            self.add_system_message("Player left")

            // If host left, assign new host
            if player_id == self.host_id and self.player_count > 0 {
                self.host_id = self.players[0].id
                self.players[0].is_host = true
            }
        }
    }

    fn add_chat_message(&self, player_id: i32, message: string) {
        let player_name = "Unknown"
        for i in 0..self.player_count {
            if self.players[i].id == player_id {
                player_name = self.players[i].name
                break
            }
        }

        let chat = ChatMessage {
            player_id: player_id,
            player_name: player_name,
            message: message,
            timestamp: get_timestamp(),
            is_system: false,
        }
        self.chat_messages = self.chat_messages + [chat]
        self.chat_count = self.chat_count + 1
    }

    fn add_system_message(&self, message: string) {
        let chat = ChatMessage {
            player_id: -1,
            player_name: "System",
            message: message,
            timestamp: get_timestamp(),
            is_system: true,
        }
        self.chat_messages = self.chat_messages + [chat]
        self.chat_count = self.chat_count + 1
    }

    fn set_player_ready(&self, player_id: i32, ready: bool) {
        for i in 0..self.player_count {
            if self.players[i].id == player_id {
                self.players[i].is_ready = ready
                break
            }
        }

        // Check if all ready
        self.all_ready = true
        for i in 0..self.player_count {
            if !self.players[i].is_ready and !self.players[i].is_ai {
                self.all_ready = false
                break
            }
        }
    }

    fn start_countdown(&self): bool {
        if !self.all_ready {
            return false
        }

        if self.player_count < 2 {
            return false
        }

        self.is_starting = true
        self.countdown_timer = 5.0    // 5 second countdown
        self.add_system_message("Game starting in 5 seconds...")

        return true
    }

    fn update(&self, delta_time: f32): bool {
        // Returns true when game should start
        if self.is_starting {
            self.countdown_timer = self.countdown_timer - delta_time
            if self.countdown_timer <= 0.0 {
                return true
            }
        }
        return false
    }
}

// ============================================================================
// LOCKSTEP SYNCHRONIZATION
// ============================================================================

struct SyncState {
    current_tick: i32,
    commands_by_tick: [[GameCommand]],    // Commands per tick (ring buffer)
    command_counts: [i32],
    tick_confirmed: [bool],

    // Checksums for sync validation
    checksums: [i32],

    // Timing
    tick_accumulator: f32,
    tick_interval: f32,

    // Network stats
    local_player_id: i32,
    round_trip_times: [i32],
    sync_errors: i32,
}

impl SyncState {
    fn init(local_player: i32): SyncState {
        let commands: [[GameCommand]] = []
        let counts: [i32] = []
        let confirmed: [bool] = []
        let checksums: [i32] = []

        for i in 0..32 {
            commands = commands + [[]]
            counts = counts + [0]
            confirmed = confirmed + [false]
            checksums = checksums + [0]
        }

        return SyncState {
            current_tick: 0,
            commands_by_tick: commands,
            command_counts: counts,
            tick_confirmed: confirmed,
            checksums: checksums,
            tick_accumulator: 0.0,
            tick_interval: 1.0 / cast(f32, TICK_RATE),
            local_player_id: local_player,
            round_trip_times: [],
            sync_errors: 0,
        }
    }

    fn queue_command(&self, cmd: GameCommand) {
        // Commands are queued for future ticks (command delay)
        let target_tick = self.current_tick + COMMAND_DELAY
        let ring_idx = target_tick % 32

        self.commands_by_tick[ring_idx] = self.commands_by_tick[ring_idx] + [cmd]
        self.command_counts[ring_idx] = self.command_counts[ring_idx] + 1
    }

    fn receive_command(&self, cmd: GameCommand) {
        let ring_idx = cmd.tick % 32
        self.commands_by_tick[ring_idx] = self.commands_by_tick[ring_idx] + [cmd]
        self.command_counts[ring_idx] = self.command_counts[ring_idx] + 1
    }

    fn get_commands_for_tick(&self, tick: i32): [GameCommand] {
        let ring_idx = tick % 32
        return self.commands_by_tick[ring_idx]
    }

    fn get_command_count_for_tick(&self, tick: i32): i32 {
        let ring_idx = tick % 32
        return self.command_counts[ring_idx]
    }

    fn confirm_tick(&self, tick: i32, checksum: i32) {
        let ring_idx = tick % 32
        self.tick_confirmed[ring_idx] = true
        self.checksums[ring_idx] = checksum
    }

    fn can_advance_tick(&self): bool {
        // Check if we have all commands for current tick from all players
        let ring_idx = self.current_tick % 32
        return self.tick_confirmed[ring_idx]
    }

    fn advance_tick(&self) {
        let ring_idx = self.current_tick % 32

        // Clear old tick data
        self.commands_by_tick[ring_idx] = []
        self.command_counts[ring_idx] = 0
        self.tick_confirmed[ring_idx] = false

        self.current_tick = self.current_tick + 1
    }

    fn verify_sync(&self, tick: i32, remote_checksum: i32): bool {
        let ring_idx = tick % 32

        if self.checksums[ring_idx] != remote_checksum {
            self.sync_errors = self.sync_errors + 1
            return false
        }
        return true
    }
}

fn calculate_game_checksum(units_hash: i32, buildings_hash: i32, resources_hash: i32): i32 {
    // Simple checksum combining game state hashes
    return units_hash ^ (buildings_hash << 8) ^ (resources_hash << 16)
}

// ============================================================================
// NETWORK MANAGER
// ============================================================================

struct NetworkConnection {
    player_id: i32,
    address: string,
    port: i32,
    state: ConnectionState,
    last_recv_time: i32,
    last_send_time: i32,
    ping: i32,

    // Reliability
    send_sequence: i32,
    recv_sequence: i32,
    ack_bitfield: i32,
}

impl NetworkConnection {
    fn init(): NetworkConnection {
        return NetworkConnection {
            player_id: 0,
            address: "",
            port: 0,
            state: ConnectionState::DISCONNECTED,
            last_recv_time: 0,
            last_send_time: 0,
            ping: 0,
            send_sequence: 0,
            recv_sequence: 0,
            ack_bitfield: 0,
        }
    }
}

struct NetworkManager {
    mode: NetworkMode,
    state: ConnectionState,

    // Local info
    local_player: NetworkPlayer,
    local_ip: string,
    local_port: i32,

    // Remote connections
    connections: [NetworkConnection],
    connection_count: i32,

    // Game state
    lobby: GameLobby?,
    sync: SyncState,

    // Packet handling
    send_sequence: i32,
    recv_sequence: i32,
    pending_packets: [Packet],
    pending_count: i32,

    // Stats
    bytes_sent: i64,
    bytes_received: i64,
    packets_sent: i32,
    packets_received: i32,
    packets_lost: i32,
}

impl NetworkManager {
    fn init(): NetworkManager {
        return NetworkManager {
            mode: NetworkMode::OFFLINE,
            state: ConnectionState::DISCONNECTED,
            local_player: NetworkPlayer::init("Player"),
            local_ip: "0.0.0.0",
            local_port: DEFAULT_PORT,
            connections: [],
            connection_count: 0,
            lobby: null,
            sync: SyncState::init(0),
            send_sequence: 0,
            recv_sequence: 0,
            pending_packets: [],
            pending_count: 0,
            bytes_sent: 0,
            bytes_received: 0,
            packets_sent: 0,
            packets_received: 0,
            packets_lost: 0,
        }
    }

    fn host_game(&self, settings: LobbySettings): bool {
        self.mode = NetworkMode::LAN_HOST
        self.state = ConnectionState::IN_LOBBY
        self.local_player.is_host = true
        self.local_player.id = 0

        self.lobby = GameLobby::init(self.local_player, settings)

        // Would bind to socket here
        return true
    }

    fn join_game(&self, host_ip: string, port: i32): bool {
        self.mode = NetworkMode::LAN_CLIENT
        self.state = ConnectionState::CONNECTING

        // Send connect request
        let packet = Packet::init(PacketType::CONNECT_REQUEST, self.send_sequence)
        packet.write_string(self.local_player.name, 32)
        packet.write_i32(PROTOCOL_VERSION)

        self.queue_send(packet, host_ip, port)

        return true
    }

    fn disconnect(&self) {
        // Send disconnect to all connections
        for i in 0..self.connection_count {
            let packet = Packet::init(PacketType::DISCONNECT, self.send_sequence)
            packet.write_i32(self.local_player.id)
            // Would send packet
        }

        self.mode = NetworkMode::OFFLINE
        self.state = ConnectionState::DISCONNECTED
        self.connection_count = 0
    }

    fn queue_send(&self, packet: Packet, address: string, port: i32) {
        self.pending_packets = self.pending_packets + [packet]
        self.pending_count = self.pending_count + 1
        self.send_sequence = self.send_sequence + 1
    }

    fn send_command(&self, cmd: GameCommand) {
        // Queue locally
        self.sync.queue_command(cmd)

        // Send to all peers
        let packet = Packet::init(PacketType::GAME_COMMAND, self.send_sequence)
        cmd.serialize(packet)

        for i in 0..self.connection_count {
            let conn = self.connections[i]
            self.queue_send(packet, conn.address, conn.port)
        }
    }

    fn broadcast_tick_ack(&self, tick: i32, checksum: i32) {
        let packet = Packet::init(PacketType::TICK_ACK, self.send_sequence)
        packet.write_i32(tick)
        packet.write_i32(checksum)
        packet.write_i32(self.local_player.id)

        for i in 0..self.connection_count {
            let conn = self.connections[i]
            self.queue_send(packet, conn.address, conn.port)
        }
    }

    fn handle_packet(&self, packet: Packet, from_addr: string, from_port: i32) {
        let packet_type = packet.header.packet_type
        let offset = 0

        if packet_type == cast(i32, PacketType::CONNECT_REQUEST) {
            if self.local_player.is_host {
                // Accept connection
                let response = Packet::init(PacketType::CONNECT_ACCEPT, self.send_sequence)
                if self.lobby != null {
                    response.write_i32(self.lobby.player_count)   // New player ID
                }
                self.queue_send(response, from_addr, from_port)
            }
        } else if packet_type == cast(i32, PacketType::CONNECT_ACCEPT) {
            self.state = ConnectionState::IN_LOBBY
            self.local_player.id = read_i32(packet.data, offset)
        } else if packet_type == cast(i32, PacketType::GAME_COMMAND) {
            let cmd = GameCommand::init()
            cmd.command_type = cast(CommandType, read_i32(packet.data, 0))
            cmd.player_id = read_i32(packet.data, 4)
            cmd.tick = read_i32(packet.data, 8)
            cmd.sequence = read_i32(packet.data, 12)
            // Would parse remaining fields

            self.sync.receive_command(cmd)
        } else if packet_type == cast(i32, PacketType::TICK_ACK) {
            let tick = read_i32(packet.data, 0)
            let checksum = read_i32(packet.data, 4)
            let player_id = read_i32(packet.data, 8)

            self.sync.confirm_tick(tick, checksum)

            if !self.sync.verify_sync(tick, checksum) {
                print("DESYNC detected at tick " + str(tick))
            }
        } else if packet_type == cast(i32, PacketType::PING) {
            let pong = Packet::init(PacketType::PONG, self.send_sequence)
            pong.write_i32(packet.header.timestamp)
            self.queue_send(pong, from_addr, from_port)
        } else if packet_type == cast(i32, PacketType::PONG) {
            let sent_time = read_i32(packet.data, 0)
            let rtt = get_timestamp() - sent_time
            // Update ping for connection
        } else if packet_type == cast(i32, PacketType::CHAT_MESSAGE) {
            let player_id = read_i32(packet.data, 0)
            // Would read message
            if self.lobby != null {
                self.lobby.add_chat_message(player_id, "Message")
            }
        }

        self.packets_received = self.packets_received + 1
        self.bytes_received = self.bytes_received + cast(i64, packet.header.payload_size + 12)
    }

    fn update(&self, delta_time: f32) {
        // Update tick timing
        self.sync.tick_accumulator = self.sync.tick_accumulator + delta_time

        // Process ticks
        while self.sync.tick_accumulator >= self.sync.tick_interval {
            if self.sync.can_advance_tick() {
                // Execute commands for this tick
                let commands = self.sync.get_commands_for_tick(self.sync.current_tick)
                let count = self.sync.get_command_count_for_tick(self.sync.current_tick)

                // Commands would be executed here

                // Calculate and broadcast checksum
                let checksum = calculate_game_checksum(0, 0, 0)
                self.broadcast_tick_ack(self.sync.current_tick, checksum)

                self.sync.advance_tick()
            } else {
                // Waiting for other players
                break
            }

            self.sync.tick_accumulator = self.sync.tick_accumulator - self.sync.tick_interval
        }

        // Update lobby
        if self.state == ConnectionState::IN_LOBBY {
            if self.lobby != null {
                if self.lobby.update(delta_time) {
                    // Start game
                    self.state = ConnectionState::LOADING
                }
            }
        }

        // Send heartbeats
        let current_time = get_timestamp()
        for i in 0..self.connection_count {
            if current_time - self.connections[i].last_send_time > 1000 {
                let ping = Packet::init(PacketType::PING, self.send_sequence)
                self.queue_send(ping, self.connections[i].address, self.connections[i].port)
                self.connections[i].last_send_time = current_time
            }
        }

        // Flush pending packets (would be actual network send)
        self.packets_sent = self.packets_sent + self.pending_count
        self.pending_count = 0
        self.pending_packets = []
    }

    fn get_stats(&self): [i32] {
        return [
            cast(i32, self.bytes_sent),
            cast(i32, self.bytes_received),
            self.packets_sent,
            self.packets_received,
            self.packets_lost,
            self.sync.sync_errors,
        ]
    }
}

// ============================================================================
// LAN DISCOVERY
// ============================================================================

struct LANGame {
    host_name: string,
    game_name: string,
    map_name: string,
    players: i32,
    max_players: i32,
    ip_address: string,
    port: i32,
    ping: i32,
    version: i32,
}

impl LANGame {
    fn init(): LANGame {
        return LANGame {
            host_name: "",
            game_name: "",
            map_name: "",
            players: 0,
            max_players: 0,
            ip_address: "",
            port: 0,
            ping: 0,
            version: PROTOCOL_VERSION,
        }
    }
}

struct LANBrowser {
    games: [LANGame],
    game_count: i32,
    is_scanning: bool,
    last_scan_time: i32,
}

impl LANBrowser {
    fn init(): LANBrowser {
        return LANBrowser {
            games: [],
            game_count: 0,
            is_scanning: false,
            last_scan_time: 0,
        }
    }

    fn start_scan(&self) {
        self.is_scanning = true
        self.game_count = 0
        self.games = []
        self.last_scan_time = get_timestamp()

        // Would broadcast UDP discovery packet
    }

    fn add_discovered_game(&self, game: LANGame) {
        // Check if already in list
        for i in 0..self.game_count {
            if self.games[i].ip_address == game.ip_address and
               self.games[i].port == game.port {
                self.games[i] = game   // Update
                return
            }
        }

        // Add new
        self.games = self.games + [game]
        self.game_count = self.game_count + 1
    }

    fn stop_scan(&self) {
        self.is_scanning = false
    }
}

// ============================================================================
// MATCHMAKING (for online play)
// ============================================================================

enum MatchmakingState {
    IDLE,
    SEARCHING,
    FOUND,
    CONNECTING,
    FAILED,
}

struct MatchmakingRequest {
    player_skill: i32,
    preferred_faction: i32,
    map_size: i32,
    game_type: GameType,
    search_radius: i32,       // Skill range
}

impl MatchmakingRequest {
    fn init(): MatchmakingRequest {
        return MatchmakingRequest {
            player_skill: 1000,
            preferred_faction: -1,
            map_size: 0,
            game_type: GameType::RANKED,
            search_radius: 100,
        }
    }
}

struct MatchmakingResult {
    state: MatchmakingState,
    match_id: i32,
    opponent_name: string,
    opponent_skill: i32,
    server_ip: string,
    server_port: i32,
    wait_time: f32,
}

impl MatchmakingResult {
    fn init(): MatchmakingResult {
        return MatchmakingResult {
            state: MatchmakingState::IDLE,
            match_id: 0,
            opponent_name: "",
            opponent_skill: 0,
            server_ip: "",
            server_port: 0,
            wait_time: 0.0,
        }
    }
}

fn request_matchmaking(request: MatchmakingRequest): MatchmakingResult {
    let result = MatchmakingResult::init()
    result.state = MatchmakingState::SEARCHING
    return result
}

fn cancel_matchmaking() {
    // Would send cancel to matchmaking server
}

// ============================================================================
// GLOBAL INSTANCE
// ============================================================================

let g_network_manager: NetworkManager? = null
let g_lan_browser: LANBrowser? = null

fn init_multiplayer_system(): NetworkManager {
    let nm = NetworkManager::init()
    g_network_manager = nm
    g_lan_browser = LANBrowser::init()
    return nm
}

fn get_network_manager(): NetworkManager? {
    return g_network_manager
}

fn get_lan_browser(): LANBrowser? {
    return g_lan_browser
}

fn shutdown_multiplayer_system() {
    if g_network_manager != null {
        g_network_manager.disconnect()
    }
    g_network_manager = null
    g_lan_browser = null
}

