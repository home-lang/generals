// Mask Shader - Selection/highlight masks and outline rendering
// Handles unit selection, ability range indicators, and highlight effects

// ============================================================================
// Configuration
// ============================================================================

struct MaskShaderConfig {
    outline_width: f32,
    outline_softness: f32,
    selection_color: Vec4,
    enemy_color: Vec4,
    ally_color: Vec4,
    neutral_color: Vec4,
    hover_color: Vec4,
    pulse_speed: f32,
    pulse_intensity: f32,
    glow_radius: f32,
    glow_intensity: f32,
    silhouette_alpha: f32,
}

impl MaskShaderConfig {
    fn init(): MaskShaderConfig {
        return MaskShaderConfig {
            outline_width: 2.0,
            outline_softness: 0.5,
            selection_color: Vec4 { x: 0.2, y: 0.8, z: 0.2, w: 1.0 },
            enemy_color: Vec4 { x: 0.9, y: 0.2, z: 0.2, w: 1.0 },
            ally_color: Vec4 { x: 0.2, y: 0.5, z: 0.9, w: 1.0 },
            neutral_color: Vec4 { x: 0.8, y: 0.8, z: 0.2, w: 1.0 },
            hover_color: Vec4 { x: 1.0, y: 1.0, z: 1.0, w: 0.5 },
            pulse_speed: 2.0,
            pulse_intensity: 0.3,
            glow_radius: 4.0,
            glow_intensity: 0.5,
            silhouette_alpha: 0.3,
        }
    }
}

// ============================================================================
// Mask Types
// ============================================================================

enum MaskType {
    SELECTION,
    HOVER,
    SILHOUETTE,
    RANGE_INDICATOR,
    AREA_EFFECT,
    BUILD_PLACEMENT,
    INVALID,
    WAYPOINT,
    ATTACK_MOVE,
}

enum OwnershipType {
    OWN,
    ALLY,
    ENEMY,
    NEUTRAL,
}

// ============================================================================
// Mask Instance
// ============================================================================

struct MaskInstance {
    mask_type: MaskType,
    ownership: OwnershipType,
    position: Vec3,
    scale: Vec3,
    rotation: f32,
    color_override: Vec4,
    use_color_override: bool,
    alpha: f32,
    pulse_offset: f32,
    is_pulsing: bool,
    inner_radius: f32,
    outer_radius: f32,
    fill_amount: f32,
    is_valid: bool,
}

impl MaskInstance {
    fn init(mask_type: MaskType, position: Vec3): MaskInstance {
        return MaskInstance {
            mask_type: mask_type,
            ownership: OwnershipType::OWN,
            position: position,
            scale: Vec3 { x: 1.0, y: 1.0, z: 1.0 },
            rotation: 0.0,
            color_override: Vec4 { x: 1.0, y: 1.0, z: 1.0, w: 1.0 },
            use_color_override: false,
            alpha: 1.0,
            pulse_offset: 0.0,
            is_pulsing: true,
            inner_radius: 0.0,
            outer_radius: 10.0,
            fill_amount: 1.0,
            is_valid: true,
        }
    }
}

// ============================================================================
// Shader Uniforms
// ============================================================================

struct MaskShaderUniforms {
    view_projection: Mat4,
    model_matrix: Mat4,
    screen_size: Vec2,
    pixel_size: Vec2,
    mask_color: Vec4,
    outline_width: f32,
    outline_softness: f32,
    glow_radius: f32,
    glow_intensity: f32,
    time: f32,
    pulse_speed: f32,
    pulse_intensity: f32,
    pulse_offset: f32,
    inner_radius: f32,
    outer_radius: f32,
    fill_amount: f32,
    is_silhouette: bool,
    silhouette_alpha: f32,
    is_valid: bool,
}

impl MaskShaderUniforms {
    fn init(): MaskShaderUniforms {
        return MaskShaderUniforms {
            view_projection: mat4_identity(),
            model_matrix: mat4_identity(),
            screen_size: Vec2 { x: 1920.0, y: 1080.0 },
            pixel_size: Vec2 { x: 1.0 / 1920.0, y: 1.0 / 1080.0 },
            mask_color: Vec4 { x: 0.2, y: 0.8, z: 0.2, w: 1.0 },
            outline_width: 2.0,
            outline_softness: 0.5,
            glow_radius: 4.0,
            glow_intensity: 0.5,
            time: 0.0,
            pulse_speed: 2.0,
            pulse_intensity: 0.3,
            pulse_offset: 0.0,
            inner_radius: 0.0,
            outer_radius: 10.0,
            fill_amount: 1.0,
            is_silhouette: false,
            silhouette_alpha: 0.3,
            is_valid: true,
        }
    }
}

// ============================================================================
// Outline Shader
// ============================================================================

struct OutlineVertex {
    position: Vec3,
    normal: Vec3,
    uv: Vec2,
}

struct OutlineVertexOutput {
    clip_position: Vec3,
    world_position: Vec3,
    uv: Vec2,
    distance_from_edge: f32,
}

fn outline_vertex_shader(vertex: OutlineVertex, uniforms: MaskShaderUniforms): OutlineVertexOutput {
    let expand_amount = uniforms.outline_width * uniforms.pixel_size.x * 100.0

    let expanded_pos = Vec3 {
        x: vertex.position.x + vertex.normal.x * expand_amount,
        y: vertex.position.y + vertex.normal.y * expand_amount,
        z: vertex.position.z + vertex.normal.z * expand_amount,
    }

    let world_pos = mat4_transform_point(uniforms.model_matrix, expanded_pos)
    let clip_pos = mat4_transform_point(uniforms.view_projection, world_pos)

    return OutlineVertexOutput {
        clip_position: clip_pos,
        world_position: world_pos,
        uv: vertex.uv,
        distance_from_edge: expand_amount,
    }
}

fn outline_fragment_shader(input: OutlineVertexOutput, uniforms: MaskShaderUniforms): Vec4 {
    let color = uniforms.mask_color

    // Apply pulse animation
    let pulse = sin_approx(uniforms.time * uniforms.pulse_speed + uniforms.pulse_offset)
    let pulse_factor = 1.0 + pulse * uniforms.pulse_intensity
    color.x = color.x * pulse_factor
    color.y = color.y * pulse_factor
    color.z = color.z * pulse_factor

    // Edge softness
    let edge_factor = clamp_f32(input.distance_from_edge / uniforms.outline_softness, 0.0, 1.0)
    color.w = color.w * edge_factor

    // Invalid placement turns red
    if !uniforms.is_valid {
        color = Vec4 { x: 0.9, y: 0.1, z: 0.1, w: color.w }
    }

    return color
}

// ============================================================================
// Silhouette Shader
// ============================================================================

fn silhouette_fragment_shader(uniforms: MaskShaderUniforms): Vec4 {
    let color = uniforms.mask_color
    color.w = uniforms.silhouette_alpha

    // Pulse
    let pulse = sin_approx(uniforms.time * uniforms.pulse_speed * 0.5 + uniforms.pulse_offset)
    color.w = color.w * (0.8 + pulse * 0.2)

    return color
}

// ============================================================================
// Range Indicator Shader
// ============================================================================

struct RangeIndicatorVertex {
    position: Vec2,
    uv: Vec2,
}

struct RangeIndicatorOutput {
    clip_position: Vec3,
    local_position: Vec2,
    uv: Vec2,
}

fn range_indicator_vertex_shader(vertex: RangeIndicatorVertex, uniforms: MaskShaderUniforms, center: Vec3): RangeIndicatorOutput {
    let world_pos = Vec3 {
        x: center.x + vertex.position.x * uniforms.outer_radius,
        y: center.y + vertex.position.y * uniforms.outer_radius,
        z: center.z,
    }

    let clip_pos = mat4_transform_point(uniforms.view_projection, world_pos)

    return RangeIndicatorOutput {
        clip_position: clip_pos,
        local_position: vertex.position,
        uv: vertex.uv,
    }
}

fn range_indicator_fragment_shader(input: RangeIndicatorOutput, uniforms: MaskShaderUniforms): Vec4 {
    // Calculate distance from center (normalized)
    let dist = sqrt_f32(input.local_position.x * input.local_position.x +
                   input.local_position.y * input.local_position.y)

    // Inner and outer radius ratios
    let inner_ratio = uniforms.inner_radius / uniforms.outer_radius

    // Ring shape
    let inner_edge = smoothstep(inner_ratio - 0.02, inner_ratio + 0.02, dist)
    let outer_edge = smoothstep(1.02, 0.98, dist)
    let ring = inner_edge * outer_edge

    // Dashed pattern
    let angle = atan2_approx(input.local_position.y, input.local_position.x)
    let dash_pattern = sin_approx(angle * 16.0 + uniforms.time * 2.0)
    let dash = smoothstep(-0.2, 0.2, dash_pattern)

    // Fill amount (for radial progress)
    let fill_angle = angle + 3.14159
    let fill_threshold = uniforms.fill_amount * 6.28318
    let fill_mask = smoothstep(fill_threshold - 0.1, fill_threshold, fill_angle)

    let color = uniforms.mask_color

    // Apply ring and dash
    color.w = color.w * ring * (0.5 + dash * 0.5)

    // Apply fill mask
    if uniforms.fill_amount < 1.0 {
        color.w = color.w * (1.0 - fill_mask)
    }

    // Pulse on outer edge
    let pulse = sin_approx(uniforms.time * uniforms.pulse_speed)
    let outer_pulse = outer_edge * (1.0 - inner_edge) * pulse * 0.3
    color.w = color.w + outer_pulse

    // Invalid turns red
    if !uniforms.is_valid {
        color = Vec4 { x: 0.9, y: 0.1, z: 0.1, w: color.w }
    }

    return color
}

// ============================================================================
// Glow Effect
// ============================================================================

fn apply_glow(color: Vec4, uniforms: MaskShaderUniforms, uv: Vec2): Vec4 {
    let glow_color = color

    // Sample in circle pattern
    let samples: i32 = 8
    let accumulated = Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }

    for i in 0..samples {
        let angle = (i / samples) * 6.28318
        let offset_x = cos_approx(angle) * uniforms.glow_radius * uniforms.pixel_size.x
        let offset_y = sin_approx(angle) * uniforms.glow_radius * uniforms.pixel_size.y

        // Simulated texture sample at offset
        accumulated.x = accumulated.x + color.x
        accumulated.y = accumulated.y + color.y
        accumulated.z = accumulated.z + color.z
        accumulated.w = accumulated.w + color.w
    }

    accumulated.x = accumulated.x / samples
    accumulated.y = accumulated.y / samples
    accumulated.z = accumulated.z / samples
    accumulated.w = accumulated.w / samples

    // Blend glow with original
    glow_color.x = color.x + accumulated.x * uniforms.glow_intensity
    glow_color.y = color.y + accumulated.y * uniforms.glow_intensity
    glow_color.z = color.z + accumulated.z * uniforms.glow_intensity
    glow_color.w = max_f32(color.w, accumulated.w * uniforms.glow_intensity)

    return glow_color
}

// ============================================================================
// Mask Shader Manager
// ============================================================================

let MAX_ACTIVE_MASKS: i32 = 256

struct MaskShaderManager {
    config: MaskShaderConfig,
    uniforms: MaskShaderUniforms,
    active_masks: [MaskInstance],
    mask_count: i32,
    current_time: f32,
}

impl MaskShaderManager {
    fn init(config: MaskShaderConfig): MaskShaderManager {
        let masks: [MaskInstance] = []

        return MaskShaderManager {
            config: config,
            uniforms: MaskShaderUniforms::init(),
            active_masks: masks,
            mask_count: 0,
            current_time: 0.0,
        }
    }

    fn add_mask(&self, mask: MaskInstance): i32 {
        if self.mask_count >= MAX_ACTIVE_MASKS {
            return -1
        }

        self.active_masks = self.active_masks + [mask]
        let index = self.mask_count
        self.mask_count = self.mask_count + 1
        return index
    }

    fn remove_mask(&self, index: i32) {
        if index < 0 || index >= self.mask_count {
            return
        }

        // Shift remaining masks
        let new_masks: [MaskInstance] = []
        for i in 0..self.mask_count {
            if i != index {
                new_masks = new_masks + [self.active_masks[i]]
            }
        }
        self.active_masks = new_masks
        self.mask_count = self.mask_count - 1
    }

    fn clear_masks(&self) {
        self.active_masks = []
        self.mask_count = 0
    }

    fn get_color_for_ownership(&self, ownership: OwnershipType): Vec4 {
        if ownership == OwnershipType::OWN {
            return self.config.selection_color
        } else if ownership == OwnershipType::ALLY {
            return self.config.ally_color
        } else if ownership == OwnershipType::ENEMY {
            return self.config.enemy_color
        } else {
            return self.config.neutral_color
        }
    }

    fn update(&self, delta_time: f32, view_proj: Mat4) {
        self.current_time = self.current_time + delta_time
        self.uniforms.time = self.current_time
        self.uniforms.view_projection = view_proj
        self.uniforms.pulse_speed = self.config.pulse_speed
        self.uniforms.pulse_intensity = self.config.pulse_intensity
        self.uniforms.outline_width = self.config.outline_width
        self.uniforms.outline_softness = self.config.outline_softness
        self.uniforms.glow_radius = self.config.glow_radius
        self.uniforms.glow_intensity = self.config.glow_intensity
        self.uniforms.silhouette_alpha = self.config.silhouette_alpha
    }

    fn render_masks(&self) {
        for i in 0..self.mask_count {
            let mask = self.active_masks[i]
            self.render_single_mask(mask)
        }
    }

    fn render_single_mask(&self, mask: MaskInstance) {
        let uniforms = self.uniforms

        // Set color based on ownership or override
        if mask.use_color_override {
            uniforms.mask_color = mask.color_override
        } else {
            uniforms.mask_color = self.get_color_for_ownership(mask.ownership)
        }

        uniforms.mask_color.w = uniforms.mask_color.w * mask.alpha
        uniforms.pulse_offset = mask.pulse_offset
        uniforms.is_valid = mask.is_valid
        uniforms.inner_radius = mask.inner_radius
        uniforms.outer_radius = mask.outer_radius
        uniforms.fill_amount = mask.fill_amount
        uniforms.is_silhouette = mask.mask_type == MaskType::SILHOUETTE

        // Create model matrix from position/scale/rotation
        uniforms.model_matrix = create_transform_matrix(mask.position, mask.scale, mask.rotation)

        // Render based on mask type
        if mask.mask_type == MaskType::SELECTION {
            render_outline_mask(uniforms)
        } else if mask.mask_type == MaskType::HOVER {
            render_hover_mask(uniforms)
        } else if mask.mask_type == MaskType::SILHOUETTE {
            render_silhouette_mask(uniforms)
        } else if mask.mask_type == MaskType::RANGE_INDICATOR {
            render_range_indicator(uniforms, mask.position)
        } else if mask.mask_type == MaskType::AREA_EFFECT {
            render_area_effect(uniforms, mask.position)
        } else if mask.mask_type == MaskType::BUILD_PLACEMENT {
            render_build_placement(uniforms)
        } else if mask.mask_type == MaskType::INVALID {
            render_invalid_placement(uniforms)
        } else if mask.mask_type == MaskType::WAYPOINT {
            render_waypoint_marker(uniforms, mask.position)
        } else if mask.mask_type == MaskType::ATTACK_MOVE {
            render_attack_move_marker(uniforms, mask.position)
        }
    }
}

