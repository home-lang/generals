// Shroud Manager - Fog of War and Shroud system
// Implements C&C Generals vision and shroud mechanics

// Cell visibility states
enum ShroudState {
    Unexplored,  // Never seen (black shroud)
    Fogged,      // Was seen but not currently visible (semi-transparent)
    Visible,     // Currently visible
}

// Vision source type
enum VisionSourceType {
    Unit,
    Structure,
    Radar,
    Aircraft,
    Garrison,
    SpecialPower,
}

// Individual vision source
struct VisionSource {
    id: i32
    owner_player: i32
    position_x: f32
    position_y: f32
    vision_range: f32
    shroud_clearing_range: f32
    source_type: VisionSourceType
    is_active: bool

    fn default(): VisionSource {
        return VisionSource {
            id: 0
            owner_player: 0
            position_x: 0.0
            position_y: 0.0
            vision_range: 0.0
            shroud_clearing_range: 0.0
            source_type: VisionSourceType::Unit
            is_active: false
        }
    }
}

// Shroud cell data
struct ShroudCell {
    state: ShroudState
    visibility_count: i32  // Number of vision sources seeing this cell
    last_seen_frame: i32   // Frame when last visible
    reveal_player_mask: i32 // Bit mask of which players have revealed this

    fn default(): ShroudCell {
        return ShroudCell {
            state: ShroudState::Unexplored
            visibility_count: 0
            last_seen_frame: 0
            reveal_player_mask: 0
        }
    }
}

// Position
struct Vec2 {
    x: f32
    y: f32
}

let MAX_VISION_SOURCES: i32 = 2048
let MAX_PLAYERS: i32 = 8

struct ShroudManager {
    // Shroud grid per player (flattened - player * grid_size + index)
    shroud_grids: [ShroudCell]
    grid_width: i32
    grid_height: i32
    cell_size: f32

    // Vision sources
    vision_sources: [VisionSource]
    vision_source_count: i32
    next_vision_id: i32

    // Per-player shroud state
    player_shroud_enabled: [bool]
    player_allies: [i32] // Bit mask of allied players

    // GPU texture for rendering shroud
    shroud_textures: [i64]
    shroud_texture_dirty: [bool]

    // Update batching
    needs_full_update: bool

    // Current frame
    current_frame: i32

    // Settings
    fog_of_war_enabled: bool
    shroud_enabled: bool
    reveal_all: bool

    // Precomputed circle masks for vision
    max_vision_radius: i32

    fn init(width: i32, height: i32, cell_size: f32): ShroudManager {
        let grid_size = width * height

        // Initialize shroud grids for all players
        let shroud_grids = []
        for player in 0..MAX_PLAYERS {
            for i in 0..grid_size {
                shroud_grids = shroud_grids + [ShroudCell.default()]
            }
        }

        // Initialize vision sources
        let vision_sources = []
        for i in 0..MAX_VISION_SOURCES {
            vision_sources = vision_sources + [VisionSource.default()]
        }

        // Initialize per-player arrays
        let player_shroud_enabled = []
        let player_allies = []
        let shroud_textures = []
        let shroud_texture_dirty = []

        for i in 0..MAX_PLAYERS {
            player_shroud_enabled = player_shroud_enabled + [true]
            player_allies = player_allies + [0]
            shroud_textures = shroud_textures + [0]
            shroud_texture_dirty = shroud_texture_dirty + [true]
        }

        return ShroudManager {
            shroud_grids: shroud_grids
            grid_width: width
            grid_height: height
            cell_size: cell_size
            vision_sources: vision_sources
            vision_source_count: 0
            next_vision_id: 1
            player_shroud_enabled: player_shroud_enabled
            player_allies: player_allies
            shroud_textures: shroud_textures
            shroud_texture_dirty: shroud_texture_dirty
            needs_full_update: true
            current_frame: 0
            fog_of_war_enabled: true
            shroud_enabled: true
            reveal_all: false
            max_vision_radius: 20
        }
    }

    // Get index into shroud grid for a player and position
    fn get_grid_index(&self, player: i32, x: i32, y: i32): i32 {
        let grid_size = self.grid_width * self.grid_height
        return player * grid_size + y * self.grid_width + x
    }

    // Add a vision source
    fn add_vision_source(self, owner: i32, x: f32, y: f32,
                         vision_range: f32, shroud_range: f32,
                         source_type: VisionSourceType): i32 {
        if self.vision_source_count >= MAX_VISION_SOURCES {
            return 0
        }

        // Find free slot
        let slot = -1
        for i in 0..MAX_VISION_SOURCES {
            if self.vision_sources[i].is_active == false {
                slot = i
                break
            }
        }

        if slot < 0 {
            return 0
        }

        let id = self.next_vision_id
        self.next_vision_id += 1

        self.vision_sources[slot] = VisionSource {
            id: id
            owner_player: owner
            position_x: x
            position_y: y
            vision_range: vision_range
            shroud_clearing_range: shroud_range
            source_type: source_type
            is_active: true
        }

        self.vision_source_count += 1

        // Apply vision immediately
        self.apply_vision_source(slot)

        return id
    }

    fn remove_vision_source(self, id: i32) {
        for i in 0..MAX_VISION_SOURCES {
            if self.vision_sources[i].id == id and self.vision_sources[i].is_active {
                // Remove vision contribution
                self.remove_vision_contribution(i)

                self.vision_sources[i].is_active = false
                self.vision_source_count -= 1
                break
            }
        }
    }

    fn update_vision_source_position(self, id: i32, new_x: f32, new_y: f32) {
        for i in 0..MAX_VISION_SOURCES {
            if self.vision_sources[i].id == id and self.vision_sources[i].is_active {
                let old_x = self.vision_sources[i].position_x
                let old_y = self.vision_sources[i].position_y

                // Only update if position changed significantly
                let dx = new_x - old_x
                let dy = new_y - old_y
                if dx * dx + dy * dy > self.cell_size * self.cell_size * 0.25 {
                    // Remove old vision
                    self.remove_vision_contribution(i)

                    // Update position
                    self.vision_sources[i].position_x = new_x
                    self.vision_sources[i].position_y = new_y

                    // Apply new vision
                    self.apply_vision_source(i)
                }
                break
            }
        }
    }

    fn apply_vision_source(self, source_idx: i32) {
        let source = self.vision_sources[source_idx]
        let owner = source.owner_player
        let range = source.vision_range / self.cell_size
        let shroud_range = source.shroud_clearing_range / self.cell_size

        let center_x = (source.position_x / self.cell_size) as i32
        let center_y = (source.position_y / self.cell_size) as i32

        let range_i = range as i32
        let shroud_range_i = shroud_range as i32

        // Get allied players mask
        let allies = self.player_allies[owner] | (1 << owner)

        let max_range = range_i
        if shroud_range_i > max_range {
            max_range = shroud_range_i
        }

        for dy in -max_range..max_range + 1 {
            for dx in -max_range..max_range + 1 {
                let dist_sq = (dx * dx + dy * dy) as f32

                let gx = center_x + dx
                let gy = center_y + dy

                if gx < 0 || gx >= self.grid_width ||
                   gy < 0 || gy >= self.grid_height {
                    continue
                }

                // Apply shroud clearing (permanent reveal)
                if dist_sq <= (shroud_range * shroud_range) {
                    for player in 0..MAX_PLAYERS {
                        if (allies & (1 << player)) != 0 {
                            let idx = self.get_grid_index(player, gx, gy)
                            self.shroud_grids[idx].reveal_player_mask = self.shroud_grids[idx].reveal_player_mask | (1 << owner)
                        }
                    }
                }

                // Apply visibility (current sight)
                if dist_sq <= (range * range) {
                    for player in 0..MAX_PLAYERS {
                        if (allies & (1 << player)) != 0 {
                            let idx = self.get_grid_index(player, gx, gy)
                            self.shroud_grids[idx].visibility_count += 1
                            self.shroud_grids[idx].state = ShroudState::Visible
                            self.shroud_grids[idx].last_seen_frame = self.current_frame
                        }
                    }
                }
            }
        }

        // Mark dirty for texture update
        for player in 0..MAX_PLAYERS {
            if (allies & (1 << player)) != 0 {
                self.shroud_texture_dirty[player] = true
            }
        }
    }

    fn remove_vision_contribution(self, source_idx: i32) {
        let source = self.vision_sources[source_idx]
        let owner = source.owner_player
        let range = source.vision_range / self.cell_size

        let center_x = (source.position_x / self.cell_size) as i32
        let center_y = (source.position_y / self.cell_size) as i32

        let range_i = range as i32
        let allies = self.player_allies[owner] | (1 << owner)

        for dy in -range_i..range_i + 1 {
            for dx in -range_i..range_i + 1 {
                let dist_sq = (dx * dx + dy * dy) as f32

                if dist_sq > range * range {
                    continue
                }

                let gx = center_x + dx
                let gy = center_y + dy

                if gx < 0 || gx >= self.grid_width ||
                   gy < 0 || gy >= self.grid_height {
                    continue
                }

                for player in 0..MAX_PLAYERS {
                    if (allies & (1 << player)) != 0 {
                        let idx = self.get_grid_index(player, gx, gy)
                        if self.shroud_grids[idx].visibility_count > 0 {
                            self.shroud_grids[idx].visibility_count -= 1
                        }

                        // Update state based on visibility
                        if self.shroud_grids[idx].visibility_count == 0 {
                            if self.shroud_grids[idx].reveal_player_mask != 0 {
                                self.shroud_grids[idx].state = ShroudState::Fogged
                            } else {
                                self.shroud_grids[idx].state = ShroudState::Unexplored
                            }
                        }
                    }
                }
            }
        }

        // Mark dirty
        for player in 0..MAX_PLAYERS {
            if (allies & (1 << player)) != 0 {
                self.shroud_texture_dirty[player] = true
            }
        }
    }

    // Update shroud state (called each frame)
    fn update(self) {
        self.current_frame += 1

        // Full update if needed
        if self.needs_full_update {
            self.recalculate_all_vision()
            self.needs_full_update = false
        }
    }

    fn recalculate_all_vision(self) {
        let grid_size = self.grid_width * self.grid_height

        // Clear all visibility counts
        for player in 0..MAX_PLAYERS {
            for i in 0..grid_size {
                let idx = player * grid_size + i
                self.shroud_grids[idx].visibility_count = 0
                if self.shroud_grids[idx].reveal_player_mask != 0 || self.shroud_grids[idx].state == ShroudState::Visible {
                    self.shroud_grids[idx].state = ShroudState::Fogged
                }
            }
        }

        // Reapply all active vision sources
        for i in 0..MAX_VISION_SOURCES {
            if self.vision_sources[i].is_active {
                self.apply_vision_source(i)
            }
        }

        // Mark all textures dirty
        for player in 0..MAX_PLAYERS {
            self.shroud_texture_dirty[player] = true
        }
    }

    // Query functions
    fn is_visible(&self, player: i32, world_x: f32, world_y: f32): bool {
        if self.reveal_all || self.fog_of_war_enabled == false {
            return true
        }

        let gx = (world_x / self.cell_size) as i32
        let gy = (world_y / self.cell_size) as i32

        if gx >= self.grid_width || gy >= self.grid_height || gx < 0 || gy < 0 {
            return false
        }

        let idx = self.get_grid_index(player, gx, gy)
        return self.shroud_grids[idx].state == ShroudState::Visible
    }

    fn is_explored(&self, player: i32, world_x: f32, world_y: f32): bool {
        if self.reveal_all || self.shroud_enabled == false {
            return true
        }

        let gx = (world_x / self.cell_size) as i32
        let gy = (world_y / self.cell_size) as i32

        if gx >= self.grid_width || gy >= self.grid_height || gx < 0 || gy < 0 {
            return false
        }

        let idx = self.get_grid_index(player, gx, gy)
        return self.shroud_grids[idx].state != ShroudState::Unexplored
    }

    fn get_shroud_state(&self, player: i32, world_x: f32, world_y: f32): ShroudState {
        if self.reveal_all {
            return ShroudState::Visible
        }

        let gx = (world_x / self.cell_size) as i32
        let gy = (world_y / self.cell_size) as i32

        if gx >= self.grid_width || gy >= self.grid_height || gx < 0 || gy < 0 {
            return ShroudState::Unexplored
        }

        let idx = self.get_grid_index(player, gx, gy)
        return self.shroud_grids[idx].state
    }

    // Set allies for shared vision
    fn set_allies(self, player: i32, allies_mask: i32) {
        self.player_allies[player] = allies_mask
        self.needs_full_update = true
    }

    // Reveal area (for special powers, etc.)
    fn reveal_area(self, player: i32, center_x: f32, center_y: f32,
                   radius: f32, duration_frames: i32) {
        let cx = (center_x / self.cell_size) as i32
        let cy = (center_y / self.cell_size) as i32
        let r = (radius / self.cell_size) as i32

        for dy in -r..r + 1 {
            for dx in -r..r + 1 {
                if dx * dx + dy * dy > r * r {
                    continue
                }

                let gx = cx + dx
                let gy = cy + dy

                if gx < 0 || gx >= self.grid_width ||
                   gy < 0 || gy >= self.grid_height {
                    continue
                }

                let idx = self.get_grid_index(player, gx, gy)
                self.shroud_grids[idx].reveal_player_mask = self.shroud_grids[idx].reveal_player_mask | (1 << player)
                self.shroud_grids[idx].state = ShroudState::Visible
                self.shroud_grids[idx].visibility_count += 1 // Temporary
            }
        }

        self.shroud_texture_dirty[player] = true
    }

    // Generate shroud texture for rendering
    fn update_shroud_texture(self, player: i32): [i32] {
        let grid_size = self.grid_width * self.grid_height
        let texture_data = []

        for y in 0..self.grid_height {
            for x in 0..self.grid_width {
                let idx = self.get_grid_index(player, x, y)
                let cell = self.shroud_grids[idx]

                let value = 0
                if cell.state == ShroudState::Unexplored {
                    value = 0    // Full black
                } else if cell.state == ShroudState::Fogged {
                    value = 128  // Half transparent
                } else {
                    value = 255  // Fully visible
                }
                texture_data = texture_data + [value]
            }
        }

        self.shroud_texture_dirty[player] = false
        return texture_data
    }

    fn is_texture_dirty(&self, player: i32): bool {
        return self.shroud_texture_dirty[player]
    }

    // Enable/disable features
    fn set_fog_of_war_enabled(self, enabled: bool) {
        self.fog_of_war_enabled = enabled
        self.needs_full_update = true
    }

    fn set_shroud_enabled(self, enabled: bool) {
        self.shroud_enabled = enabled
        self.needs_full_update = true
    }

    fn set_reveal_all(self, reveal: bool) {
        self.reveal_all = reveal
    }

    fn get_grid_width(&self): i32 {
        return self.grid_width
    }

    fn get_grid_height(&self): i32 {
        return self.grid_height
    }

    fn get_cell_size(&self): f32 {
        return self.cell_size
    }
}
