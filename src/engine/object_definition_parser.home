// Object Definition Parser - Parses Object INI files for C&C Generals
// Handles Object blocks from Data/INI/Object/*.ini files
//
// Object definitions include:
// - Units (infantry, vehicles, aircraft)
// - Buildings
// - Projectiles
// - Props and decorations
// - System objects

let MAX_OBJECTS: i32 = 4096
let MAX_MODULES_PER_OBJECT: i32 = 32
let MAX_PARAMS_PER_MODULE: i32 = 16
let MAX_PARSE_ERRORS: i32 = 128

// ============================================================================
// INI Token Types
// ============================================================================

enum TokenType {
    IDENTIFIER,
    STRING,
    NUMBER,
    EQUALS,
    SEMICOLON,
    OPEN_BRACE,
    CLOSE_BRACE,
    NEWLINE,
    END_OF_FILE,
}

struct Token {
    token_type: TokenType,
    text: string,
    line: i32,
    column: i32,
}

impl Token {
    fn init(): Token {
        return Token {
            token_type: TokenType::END_OF_FILE,
            text: "",
            line: 0,
            column: 0,
        }
    }
}

// ============================================================================
// Parse Error
// ============================================================================

struct ParseError {
    message: string,
    file: string,
    line: i32,
    column: i32,
}

impl ParseError {
    fn init(): ParseError {
        return ParseError {
            message: "",
            file: "",
            line: 0,
            column: 0,
        }
    }
}

// ============================================================================
// Parse Context
// ============================================================================

struct ParseContext {
    current_file: string,
    line: i32,
    column: i32,
    errors: [ParseError],
    error_count: i32,
}

impl ParseContext {
    fn init(): ParseContext {
        let errors: [ParseError] = []
        for i in 0..MAX_PARSE_ERRORS {
            errors = errors + [ParseError::init()]
        }

        return ParseContext {
            current_file: "",
            line: 1,
            column: 1,
            errors: errors,
            error_count: 0,
        }
    }

    fn add_error(&self, message: string) {
        if self.error_count >= MAX_PARSE_ERRORS {
            return
        }

        self.errors[self.error_count] = ParseError {
            message: message,
            file: self.current_file,
            line: self.line,
            column: self.column,
        }
        self.error_count = self.error_count + 1
    }
}

// ============================================================================
// Kind Of Enum
// ============================================================================

enum KindOf {
    INFANTRY,
    VEHICLE,
    AIRCRAFT,
    BUILDING,
    STRUCTURE,
    PROJECTILE,
    CRATE,
    DEBRIS,
    BRIDGE,
    PROP,
    SHRUBBERY,
    GARRISON,
    TUNNEL,
}

// ============================================================================
// Geometry Type
// ============================================================================

enum GeometryType {
    SPHERE,
    CYLINDER,
    BOX,
}

// ============================================================================
// Module Parameter
// ============================================================================

struct ModuleParam {
    key: string,
    value: string,
}

impl ModuleParam {
    fn init(): ModuleParam {
        return ModuleParam {
            key: "",
            value: "",
        }
    }
}

// ============================================================================
// Module Template
// ============================================================================

struct ModuleTemplate {
    module_type: string,
    module_tag: string,
    parameters: [ModuleParam],
    param_count: i32,
}

impl ModuleTemplate {
    fn init(): ModuleTemplate {
        let params: [ModuleParam] = []
        for i in 0..MAX_PARAMS_PER_MODULE {
            params = params + [ModuleParam::init()]
        }

        return ModuleTemplate {
            module_type: "",
            module_tag: "",
            parameters: params,
            param_count: 0,
        }
    }

    fn add_param(&self, key: string, value: string) {
        if self.param_count >= MAX_PARAMS_PER_MODULE {
            return
        }
        self.parameters[self.param_count] = ModuleParam { key: key, value: value }
        self.param_count = self.param_count + 1
    }

    fn get_param(&self, key: string): string {
        for i in 0..self.param_count {
            if self.parameters[i].key == key {
                return self.parameters[i].value
            }
        }
        return ""
    }
}

// ============================================================================
// Thing Template
// ============================================================================

struct ThingTemplate {
    name: string,
    display_name: string,
    side: string,
    model_name: string,
    portrait_image: string,
    button_image: string,
    selection_decal: string,

    kind_of: [KindOf],
    kind_of_count: i32,

    buildable: bool,
    prerequisite_count: i32,
    prerequisites: [string],

    build_cost: i32,
    build_time: f64,
    max_health: f64,
    armor_set: string,
    vision_range: f64,
    shroud_clearing_range: f64,

    locomotor: string,
    speed: f64,
    turn_rate: f64,

    weapon_set: string,
    primary_weapon: string,
    secondary_weapon: string,
    attack_range: f64,

    can_produce: bool,
    production_queue_type: string,
    energy_production: i32,
    energy_consumption: i32,

    experience_value: i32,
    experience_required: [i32],

    modules: [ModuleTemplate],
    module_count: i32,

    voice_select: string,
    voice_move: string,
    voice_attack: string,
    voice_created: string,
    sound_ambient: string,
    sound_die: string,

    geometry_type: GeometryType,
    geometry_major_radius: f64,
    geometry_minor_radius: f64,
    geometry_height: f64,
    scale: f64,
    draw_priority: i32,
}

impl ThingTemplate {
    fn init(): ThingTemplate {
        let kind_of: [KindOf] = []
        for i in 0..8 {
            kind_of = kind_of + [KindOf::PROP]
        }

        let prereqs: [string] = []
        for i in 0..8 {
            prereqs = prereqs + [""]
        }

        let exp_req: [i32] = [0, 100, 200, 400]

        let modules: [ModuleTemplate] = []
        for i in 0..MAX_MODULES_PER_OBJECT {
            modules = modules + [ModuleTemplate::init()]
        }

        return ThingTemplate {
            name: "",
            display_name: "",
            side: "Civilian",
            model_name: "",
            portrait_image: "",
            button_image: "",
            selection_decal: "decals/selection.tga",
            kind_of: kind_of,
            kind_of_count: 0,
            buildable: false,
            prerequisite_count: 0,
            prerequisites: prereqs,
            build_cost: 0,
            build_time: 0.0,
            max_health: 100.0,
            armor_set: "None",
            vision_range: 200.0,
            shroud_clearing_range: 200.0,
            locomotor: "",
            speed: 0.0,
            turn_rate: 180.0,
            weapon_set: "",
            primary_weapon: "",
            secondary_weapon: "",
            attack_range: 0.0,
            can_produce: false,
            production_queue_type: "",
            energy_production: 0,
            energy_consumption: 0,
            experience_value: 0,
            experience_required: exp_req,
            modules: modules,
            module_count: 0,
            voice_select: "",
            voice_move: "",
            voice_attack: "",
            voice_created: "",
            sound_ambient: "",
            sound_die: "",
            geometry_type: GeometryType::CYLINDER,
            geometry_major_radius: 10.0,
            geometry_minor_radius: 10.0,
            geometry_height: 20.0,
            scale: 1.0,
            draw_priority: 0,
        }
    }

    fn add_module(&self, module: ModuleTemplate): bool {
        if self.module_count >= MAX_MODULES_PER_OBJECT {
            return false
        }
        self.modules[self.module_count] = module
        self.module_count = self.module_count + 1
        return true
    }

    fn add_kind(&self, kind: KindOf) {
        if self.kind_of_count < 8 {
            self.kind_of[self.kind_of_count] = kind
            self.kind_of_count = self.kind_of_count + 1
        }
    }

    fn add_prerequisite(&self, prereq: string) {
        if self.prerequisite_count < 8 {
            self.prerequisites[self.prerequisite_count] = prereq
            self.prerequisite_count = self.prerequisite_count + 1
        }
    }
}

// ============================================================================
// INI Reader
// ============================================================================

struct INIReader {
    content: string,
    pos: i32,
    length: i32,
}

fn get_string_length(s: string): i32 {
    // Get string length - platform specific
    return 0
}

impl INIReader {
    fn init(content: string): INIReader {
        return INIReader {
            content: content,
            pos: 0,
            length: get_string_length(content),
        }
    }

    fn is_eof(&self): bool {
        return self.pos >= self.length
    }

    fn is_eol(&self): bool {
        if self.pos >= self.length {
            return true
        }
        let c = char_at(self.content, self.pos)
        return c == "\n" || c == "\r"
    }

    fn peek(&self): string {
        if self.pos >= self.length {
            return ""
        }
        return char_at(self.content, self.pos)
    }

    fn peek_identifier(&self): string {
        let temp_pos = self.pos
        self.skip_whitespace_at(temp_pos)

        let result = ""
        while temp_pos < self.length {
            let c = char_at(self.content, temp_pos)
            if self.is_identifier_char(c) {
                result = result + c
                temp_pos = temp_pos + 1
            } else {
                break
            }
        }
        return result
    }

    fn advance(&self) {
        self.pos = self.pos + 1
    }

    fn skip_whitespace(&self) {
        while self.pos < self.length {
            let c = char_at(self.content, self.pos)
            if c == " " || c == "\t" {
                self.pos = self.pos + 1
            } else {
                break
            }
        }
    }

    fn skip_whitespace_at(&self, pos: i32): i32 {
        let p = pos
        while p < self.length {
            let c = char_at(self.content, p)
            if c == " " || c == "\t" {
                p = p + 1
            } else {
                break
            }
        }
        return p
    }

    fn skip_whitespace_and_comments(&self) {
        while self.pos < self.length {
            let c = char_at(self.content, self.pos)

            if c == " " || c == "\t" || c == "\n" || c == "\r" {
                self.pos = self.pos + 1
            } else if c == ";" {
                // Comment - skip to end of line
                while self.pos < self.length && char_at(self.content, self.pos) != "\n" {
                    self.pos = self.pos + 1
                }
            } else {
                break
            }
        }
    }

    fn skip_to_newline(&self) {
        while self.pos < self.length && char_at(self.content, self.pos) != "\n" {
            self.pos = self.pos + 1
        }
        if self.pos < self.length {
            self.pos = self.pos + 1
        }
    }

    fn skip_block(&self) {
        let depth = 0

        while self.pos < self.length {
            let c = char_at(self.content, self.pos)

            if is_open_brace(c) {
                depth = depth + 1
            } else if is_close_brace(c) {
                depth = depth - 1
                if depth <= 0 {
                    self.pos = self.pos + 1
                    break
                }
            }

            self.pos = self.pos + 1
        }
    }

    fn expect(&self, expected: string): bool {
        self.skip_whitespace_and_comments()

        if self.pos < self.length && char_at(self.content, self.pos) == expected {
            self.pos = self.pos + 1
            return true
        }
        return false
    }

    fn read_identifier(&self): string {
        self.skip_whitespace_and_comments()

        let result = ""
        while self.pos < self.length {
            let c = char_at(self.content, self.pos)
            if self.is_identifier_char(c) {
                result = result + c
                self.pos = self.pos + 1
            } else {
                break
            }
        }
        return result
    }

    fn read_string(&self): string {
        self.skip_whitespace()

        if self.pos >= self.length {
            return ""
        }

        // Check for quoted string
        if char_at(self.content, self.pos) == "\"" {
            self.pos = self.pos + 1
            let result = ""
            while self.pos < self.length && char_at(self.content, self.pos) != "\"" {
                result = result + char_at(self.content, self.pos)
                self.pos = self.pos + 1
            }
            if self.pos < self.length {
                self.pos = self.pos + 1  // Skip closing quote
            }
            return result
        }

        // Unquoted - read until whitespace
        return self.read_identifier()
    }

    fn read_int(&self): i32 {
        self.skip_whitespace()

        let result = 0
        let negative = false

        if self.pos < self.length && char_at(self.content, self.pos) == "-" {
            negative = true
            self.pos = self.pos + 1
        }

        while self.pos < self.length {
            let c = char_at(self.content, self.pos)
            if self.is_digit(c) {
                result = result * 10 + self.digit_value(c)
                self.pos = self.pos + 1
            } else {
                break
            }
        }

        if negative {
            return -result
        }
        return result
    }

    fn read_float(&self): f64 {
        self.skip_whitespace()

        let result = 0.0
        let negative = false
        let decimal_place = 0.0

        if self.pos < self.length && char_at(self.content, self.pos) == "-" {
            negative = true
            self.pos = self.pos + 1
        }

        // Integer part
        while self.pos < self.length {
            let c = char_at(self.content, self.pos)
            if self.is_digit(c) {
                result = result * 10.0 + self.digit_value(c) as f64
                self.pos = self.pos + 1
            } else {
                break
            }
        }

        // Decimal part
        if self.pos < self.length && char_at(self.content, self.pos) == "." {
            self.pos = self.pos + 1
            decimal_place = 0.1

            while self.pos < self.length {
                let c = char_at(self.content, self.pos)
                if self.is_digit(c) {
                    result = result + self.digit_value(c) as f64 * decimal_place
                    decimal_place = decimal_place * 0.1
                    self.pos = self.pos + 1
                } else {
                    break
                }
            }
        }

        if negative {
            return -result
        }
        return result
    }

    fn read_bool(&self): bool {
        let value = self.read_identifier()
        return value == "Yes" || value == "yes" || value == "true" || value == "1"
    }

    fn read_value_as_string(&self): string {
        self.skip_whitespace()

        let result = ""
        while self.pos < self.length {
            let c = char_at(self.content, self.pos)
            if c == "\n" || c == "\r" || c == ";" {
                break
            }
            result = result + c
            self.pos = self.pos + 1
        }

        return trim(result)
    }

    fn is_identifier_char(&self, c: string): bool {
        return (c >= "a" && c <= "z") ||
               (c >= "A" && c <= "Z") ||
               (c >= "0" && c <= "9") ||
               c == "_" || c == ":"
    }

    fn is_digit(&self, c: string): bool {
        return c >= "0" && c <= "9"
    }

    fn digit_value(&self, c: string): i32 {
        if c == "0" { return 0 }
        if c == "1" { return 1 }
        if c == "2" { return 2 }
        if c == "3" { return 3 }
        if c == "4" { return 4 }
        if c == "5" { return 5 }
        if c == "6" { return 6 }
        if c == "7" { return 7 }
        if c == "8" { return 8 }
        if c == "9" { return 9 }
        return 0
    }
}

// ============================================================================
// Object Definition Parser
// ============================================================================

struct ObjectDefinitionParser {
    context: ParseContext,
    templates: [ThingTemplate],
    template_count: i32,
}

impl ObjectDefinitionParser {
    fn init(): ObjectDefinitionParser {
        let templates: [ThingTemplate] = []
        for i in 0..MAX_OBJECTS {
            templates = templates + [ThingTemplate::init()]
        }

        return ObjectDefinitionParser {
            context: ParseContext::init(),
            templates: templates,
            template_count: 0,
        }
    }

    fn parse_file(&self, file_path: string): bool {
        self.context.current_file = file_path
        self.context.line = 1
        self.context.column = 1

        let content = read_file_to_string(file_path)
        if get_string_length(content) == 0 {
            self.context.add_error("Failed to read file")
            return false
        }

        let reader = INIReader::init(content)

        while !reader.is_eof() {
            let keyword = reader.read_identifier()

            if keyword == "Object" {
                self.parse_object(reader)
            } else if keyword == "ChildObject" {
                self.parse_child_object(reader)
            } else if keyword == "Include" {
                let include_path = reader.read_string()
                self.parse_file(include_path)
            } else if keyword.length > 0 {
                reader.skip_block()
            }

            reader.skip_whitespace_and_comments()
        }

        return self.context.error_count == 0
    }

    fn parse_object(&self, reader: INIReader) {
        if self.template_count >= MAX_OBJECTS {
            reader.skip_block()
            return
        }

        let template = ThingTemplate::init()

        // Read object name
        template.name = reader.read_identifier()

        // Check for inheritance
        let maybe_parent = reader.peek_identifier()
        if maybe_parent.length > 0 && !is_open_brace(reader.peek()) {
            let parent_name = reader.read_identifier()
            let parent = self.get_template(parent_name)
            if parent != null {
                template = self.copy_template(parent)
                template.name = template.name  // Keep new name
            }
        }

        reader.expect(open_brace())

        // Parse object body
        while !reader.is_eof() && !is_close_brace(reader.peek()) {
            let field = reader.read_identifier()

            if field == "End" {
                break
            }

            self.parse_object_field(template, field, reader)
        }

        reader.expect(close_brace())

        // Store the template
        self.templates[self.template_count] = template
        self.template_count = self.template_count + 1
    }

    fn parse_child_object(&self, reader: INIReader) {
        let child_name = reader.read_identifier()
        let parent_name = reader.read_identifier()

        let parent = self.get_template(parent_name)
        if parent == null {
            self.context.add_error("Parent object not found: " + parent_name)
            reader.skip_block()
            return
        }

        let template = self.copy_template(parent)
        template.name = child_name

        reader.expect(open_brace())

        while !reader.is_eof() && !is_close_brace(reader.peek()) {
            let field = reader.read_identifier()
            if field == "End" {
                break
            }
            self.parse_object_field(template, field, reader)
        }

        reader.expect(close_brace())

        self.templates[self.template_count] = template
        self.template_count = self.template_count + 1
    }

    fn parse_object_field(&self, template: ThingTemplate, field: string, reader: INIReader) {
        reader.expect("=")

        // Basic info
        if field == "DisplayName" {
            template.display_name = reader.read_string()
        } else if field == "Side" {
            template.side = reader.read_identifier()
        } else if field == "Draw" {
            self.parse_draw_block(template, reader)
        } else if field == "SelectPortrait" {
            template.portrait_image = reader.read_string()
        } else if field == "ButtonImage" {
            template.button_image = reader.read_string()
        } else if field == "KindOf" {
            self.parse_kind_of(template, reader)
        } else if field == "Buildable" {
            template.buildable = reader.read_bool()
        } else if field == "BuildCost" {
            template.build_cost = reader.read_int()
        } else if field == "BuildTime" {
            template.build_time = reader.read_float()
        } else if field == "MaxHealth" {
            template.max_health = reader.read_float()
        } else if field == "VisionRange" {
            template.vision_range = reader.read_float()
        } else if field == "ShroudClearingRange" {
            template.shroud_clearing_range = reader.read_float()
        } else if field == "Speed" {
            template.speed = reader.read_float()
        } else if field == "TurnRate" {
            template.turn_rate = reader.read_float()
        } else if field == "WeaponSet" {
            self.parse_weapon_set_block(template, reader)
        } else if field == "ArmorSet" {
            self.parse_armor_set_block(template, reader)
        } else if field == "CommandSet" {
            template.production_queue_type = reader.read_identifier()
        } else if field == "CanProduceUnits" {
            template.can_produce = reader.read_bool()
        } else if field == "EnergyProduction" {
            template.energy_production = reader.read_int()
        } else if field == "EnergyBonus" {
            template.energy_consumption = reader.read_int()
        } else if field == "ExperienceValue" {
            template.experience_value = reader.read_int()
        } else if field == "ExperienceRequired" {
            self.parse_experience_required(template, reader)
        } else if field == "Body" {
            self.parse_module(template, "Body", reader)
        } else if field == "Behavior" {
            self.parse_module(template, "Behavior", reader)
        } else if field == "LocomotorSet" {
            self.parse_module(template, "LocomotorSet", reader)
        } else if field == "VoiceSelect" {
            template.voice_select = reader.read_string()
        } else if field == "VoiceMove" {
            template.voice_move = reader.read_string()
        } else if field == "VoiceAttack" {
            template.voice_attack = reader.read_string()
        } else if field == "VoiceCreated" {
            template.voice_created = reader.read_string()
        } else if field == "SoundAmbient" {
            template.sound_ambient = reader.read_string()
        } else if field == "SoundDie" {
            template.sound_die = reader.read_string()
        } else if field == "Geometry" {
            template.geometry_type = self.parse_geometry_type(reader.read_identifier())
        } else if field == "GeometryMajorRadius" {
            template.geometry_major_radius = reader.read_float()
        } else if field == "GeometryMinorRadius" {
            template.geometry_minor_radius = reader.read_float()
        } else if field == "GeometryHeight" {
            template.geometry_height = reader.read_float()
        } else if field == "Prerequisites" {
            self.parse_prerequisites(template, reader)
        } else if field == "Scale" {
            template.scale = reader.read_float()
        } else {
            reader.skip_to_newline()
        }
    }

    fn parse_kind_of(&self, template: ThingTemplate, reader: INIReader) {
        template.kind_of_count = 0

        while !reader.is_eol() {
            let kind = reader.read_identifier()
            if kind.length == 0 {
                break
            }

            let kind_enum = self.parse_kind_of_enum(kind)
            template.add_kind(kind_enum)
        }
    }

    fn parse_kind_of_enum(&self, name: string): KindOf {
        if name == "INFANTRY" { return KindOf::INFANTRY }
        if name == "VEHICLE" { return KindOf::VEHICLE }
        if name == "AIRCRAFT" { return KindOf::AIRCRAFT }
        if name == "STRUCTURE" { return KindOf::STRUCTURE }
        if name == "BUILDING" { return KindOf::BUILDING }
        if name == "PROJECTILE" { return KindOf::PROJECTILE }
        if name == "CRATE" { return KindOf::CRATE }
        if name == "DEBRIS" { return KindOf::DEBRIS }
        if name == "BRIDGE" { return KindOf::BRIDGE }
        if name == "PROP" { return KindOf::PROP }
        if name == "SHRUBBERY" { return KindOf::SHRUBBERY }
        if name == "CAN_ATTACK" { return KindOf::INFANTRY }
        return KindOf::PROP
    }

    fn parse_geometry_type(&self, name: string): GeometryType {
        if name == "SPHERE" { return GeometryType::SPHERE }
        if name == "CYLINDER" { return GeometryType::CYLINDER }
        if name == "BOX" { return GeometryType::BOX }
        return GeometryType::CYLINDER
    }

    fn parse_prerequisites(&self, template: ThingTemplate, reader: INIReader) {
        reader.expect(open_brace())
        template.prerequisite_count = 0

        while !reader.is_eof() && !is_close_brace(reader.peek()) {
            let obj_name = reader.read_identifier()
            if obj_name == "End" || obj_name.length == 0 {
                break
            }

            template.add_prerequisite(obj_name)
        }

        reader.expect(close_brace())
    }

    fn parse_experience_required(&self, template: ThingTemplate, reader: INIReader) {
        for i in 0..4 {
            template.experience_required[i] = reader.read_int()
            if reader.is_eol() {
                break
            }
        }
    }

    fn parse_draw_block(&self, template: ThingTemplate, reader: INIReader) {
        let draw_type = reader.read_identifier()

        reader.expect(open_brace())

        while !reader.is_eof() && !is_close_brace(reader.peek()) {
            let field = reader.read_identifier()
            if field == "End" {
                break
            }

            reader.expect("=")

            if field == "Model" {
                template.model_name = reader.read_string()
            } else {
                reader.skip_to_newline()
            }
        }

        reader.expect(close_brace())
    }

    fn parse_weapon_set_block(&self, template: ThingTemplate, reader: INIReader) {
        reader.expect(open_brace())

        while !reader.is_eof() && !is_close_brace(reader.peek()) {
            let field = reader.read_identifier()
            if field == "End" {
                break
            }

            reader.expect("=")

            if field == "Weapon" {
                let slot = reader.read_identifier()
                let weapon_name = reader.read_identifier()

                if slot == "PRIMARY" {
                    template.primary_weapon = weapon_name
                } else if slot == "SECONDARY" {
                    template.secondary_weapon = weapon_name
                }
            } else {
                reader.skip_to_newline()
            }
        }

        reader.expect(close_brace())
    }

    fn parse_armor_set_block(&self, template: ThingTemplate, reader: INIReader) {
        reader.expect(open_brace())

        while !reader.is_eof() && !is_close_brace(reader.peek()) {
            let field = reader.read_identifier()
            if field == "End" {
                break
            }

            reader.expect("=")

            if field == "Armor" {
                template.armor_set = reader.read_identifier()
            } else {
                reader.skip_to_newline()
            }
        }

        reader.expect(close_brace())
    }

    fn parse_module(&self, template: ThingTemplate, module_type: string, reader: INIReader) {
        if template.module_count >= MAX_MODULES_PER_OBJECT {
            reader.skip_block()
            return
        }

        let module = ModuleTemplate::init()
        module.module_type = module_type
        module.module_tag = reader.read_identifier()

        reader.expect(open_brace())

        while !reader.is_eof() && !is_close_brace(reader.peek()) {
            let param_name = reader.read_identifier()
            if param_name == "End" || param_name.length == 0 {
                break
            }

            reader.expect("=")
            let param_value = reader.read_value_as_string()

            module.add_param(param_name, param_value)
        }

        reader.expect(close_brace())

        template.add_module(module)
    }

    fn get_template(&self, name: string): ThingTemplate? {
        for i in 0..self.template_count {
            if self.templates[i].name == name {
                return self.templates[i]
            }
        }
        return null
    }

    fn copy_template(&self, src: ThingTemplate): ThingTemplate {
        let dest = ThingTemplate::init()

        dest.name = src.name
        dest.display_name = src.display_name
        dest.side = src.side
        dest.model_name = src.model_name
        dest.portrait_image = src.portrait_image
        dest.button_image = src.button_image
        dest.selection_decal = src.selection_decal

        for i in 0..src.kind_of_count {
            dest.kind_of[i] = src.kind_of[i]
        }
        dest.kind_of_count = src.kind_of_count

        dest.buildable = src.buildable
        for i in 0..src.prerequisite_count {
            dest.prerequisites[i] = src.prerequisites[i]
        }
        dest.prerequisite_count = src.prerequisite_count

        dest.build_cost = src.build_cost
        dest.build_time = src.build_time
        dest.max_health = src.max_health
        dest.armor_set = src.armor_set
        dest.vision_range = src.vision_range
        dest.shroud_clearing_range = src.shroud_clearing_range

        dest.locomotor = src.locomotor
        dest.speed = src.speed
        dest.turn_rate = src.turn_rate

        dest.weapon_set = src.weapon_set
        dest.primary_weapon = src.primary_weapon
        dest.secondary_weapon = src.secondary_weapon
        dest.attack_range = src.attack_range

        dest.can_produce = src.can_produce
        dest.production_queue_type = src.production_queue_type
        dest.energy_production = src.energy_production
        dest.energy_consumption = src.energy_consumption

        dest.experience_value = src.experience_value
        for i in 0..4 {
            dest.experience_required[i] = src.experience_required[i]
        }

        // Deep copy modules
        for i in 0..src.module_count {
            dest.modules[i] = src.modules[i]
        }
        dest.module_count = src.module_count

        dest.voice_select = src.voice_select
        dest.voice_move = src.voice_move
        dest.voice_attack = src.voice_attack
        dest.voice_created = src.voice_created
        dest.sound_ambient = src.sound_ambient
        dest.sound_die = src.sound_die

        dest.geometry_type = src.geometry_type
        dest.geometry_major_radius = src.geometry_major_radius
        dest.geometry_minor_radius = src.geometry_minor_radius
        dest.geometry_height = src.geometry_height
        dest.scale = src.scale
        dest.draw_priority = src.draw_priority

        return dest
    }

    fn get_template_count(&self): i32 {
        return self.template_count
    }

    fn get_error_count(&self): i32 {
        return self.context.error_count
    }
}

