// Helper Functions
// ============================================================================

fn read_file_to_string(path: string): string {
    // Platform-specific implementation
    return ""
}

fn char_at(s: string, index: i32): string {
    // Get character at index as string
    return ""
}

fn trim(s: string): string {
    // Remove leading/trailing whitespace
    return s
}

fn is_open_brace(c: string): bool {
    // Check if character is open brace '{'
    let code = char_code(c)
    return code == 123
}

fn is_close_brace(c: string): bool {
    // Check if character is close brace '}'
    let code = char_code(c)
    return code == 125
}

fn open_brace(): string {
    // Return '{'
    return from_char_code(123)
}

fn close_brace(): string {
    // Return '}'
    return from_char_code(125)
}

fn char_code(c: string): i32 {
    // Get ASCII code of first character
    return 0
}

fn from_char_code(code: i32): string {
    // Create string from ASCII code
    return ""
}

// ============================================================================
// Tests
// ============================================================================

fn test_ini_reader() {
    print("Testing INI reader...")

    let content = "Name = TestObject\nHealth = 100\nSpeed = 25.5"
    let reader = INIReader::init(content)

    let name_key = reader.read_identifier()
    reader.expect("=")
    let name_val = reader.read_identifier()

    print("Key: " + name_key + ", Value: " + name_val)
}

fn test_thing_template() {
    print("Testing thing template...")

    let template = ThingTemplate::init()
    template.name = "AmericaInfantryRanger"
    template.display_name = "Ranger"
    template.side = "America"
    template.build_cost = 250
    template.max_health = 100.0
    template.speed = 20.0

    template.add_kind(KindOf::INFANTRY)

    print("Created: " + template.name)
    print("Cost: " + str(template.build_cost))
}

fn test_module_template() {
    print("Testing module template...")

    let module = ModuleTemplate::init()
    module.module_type = "Body"
    module.module_tag = "ModuleTag_Body"
    module.add_param("MaxHealth", "100")
    module.add_param("DamageStates", "5")

    print("Module type: " + module.module_type)
    print("Param count: " + str(module.param_count))
}

fn run_all_tests() {
    print("Running object definition parser tests...")
    test_ini_reader()
    test_thing_template()
    test_module_template()
    print("All object definition parser tests complete!")
}
