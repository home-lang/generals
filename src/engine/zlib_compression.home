// Zlib Compression - DEFLATE compression algorithm wrapper
// Used for PNG decompression, network data, and various compressed assets
// Reference: Thyme/src/game/common/compression/zlibcompr.cpp


// Zlib compression levels
enum ZlibLevel {
    NoCompression,      // Level 0
    BestSpeed,          // Level 1
    Default,            // Level 6
    BestCompression,    // Level 9
}

fn zlib_level_to_int(level: ZlibLevel): i32 {
    if level == ZlibLevel::NoCompression { return 0 }
    if level == ZlibLevel::BestSpeed { return 1 }
    if level == ZlibLevel::Default { return 6 }
    if level == ZlibLevel::BestCompression { return 9 }
    return 6
}

// Zlib error codes
enum ZlibError {
    Ok,
    StreamEnd,
    NeedDict,
    ErrNo,
    StreamError,
    DataError,
    MemError,
    BufError,
    VersionError,
}

// Compression result
struct ZlibResult {
    success: bool
    error: ZlibError
    output_size: i32
    input_consumed: i32

    fn ok(): ZlibResult {
        return ZlibResult {
            success: true
            error: ZlibError::Ok
            output_size: 0
            input_consumed: 0
        }
    }

    fn fail(error: ZlibError): ZlibResult {
        return ZlibResult {
            success: false
            error: error
            output_size: 0
            input_consumed: 0
        }
    }
}

// Decompression result with data
struct DecompressResult {
    data: [i32]
    result: ZlibResult

    fn empty(): DecompressResult {
        return DecompressResult {
            data: []
            result: ZlibResult.fail(ZlibError::DataError)
        }
    }
}

// Bit reader state for DEFLATE parsing
struct BitReader {
    src: [i32]
    pos: i32
    bit_pos: i32

    fn init(src: [i32], start_pos: i32): BitReader {
        return BitReader {
            src: src
            pos: start_pos
            bit_pos: 0
        }
    }

    fn read_bits(self, num_bits: i32): i32 {
        let value = 0

        for i in 0..num_bits {
            if self.pos >= self.src.length {
                return value
            }

            let bit = (self.src[self.pos] >> self.bit_pos) & 1
            value = value | (bit << i)

            self.bit_pos = self.bit_pos + 1
            if self.bit_pos >= 8 {
                self.bit_pos = 0
                self.pos = self.pos + 1
            }
        }

        return value
    }

    fn align_to_byte(self) {
        if self.bit_pos != 0 {
            self.bit_pos = 0
            self.pos = self.pos + 1
        }
    }
}


let ZLIB_CM_DEFLATE: i32 = 8
let ZLIB_CINFO_32K: i32 = 7  // 32K window size

// Check if data has zlib header
fn is_zlib_compressed(data: [i32]): bool {
    if data.length < 2 {
        return false
    }

    let cmf = data[0]
    let flg = data[1]

    // Check compression method is deflate
    let cm = cmf & 0x0F
    if cm != ZLIB_CM_DEFLATE {
        return false
    }

    // Check header checksum
    let check = ((cmf * 256) + flg) % 31
    if check != 0 {
        return false
    }

    return true
}

// Calculate Adler-32 checksum (used by zlib)
fn adler32(data: [i32]): i32 {
    let MOD_ADLER: i32 = 65521

    let a = 1
    let b = 0

    let len = data.length
    for i in 0..len {
        a = (a + data[i]) % MOD_ADLER
        b = (b + a) % MOD_ADLER
    }

    return (b << 16) | a
}

// Update Adler-32 checksum with new data
fn adler32_update(checksum: i32, data: [i32]): i32 {
    let MOD_ADLER: i32 = 65521

    let a = checksum & 0xFFFF
    let b = (checksum >> 16) & 0xFFFF

    let len = data.length
    for i in 0..len {
        a = (a + data[i]) % MOD_ADLER
        b = (b + a) % MOD_ADLER
    }

    return (b << 16) | a
}

// Decompress DEFLATE data
fn inflate_decompress(src: [i32], offset: i32, length: i32): DecompressResult {
    let output = []
    let result = ZlibResult.fail(ZlibError::Ok)

    let reader = BitReader.init(src, offset)

    // Process DEFLATE blocks
    let is_final = false
    while is_final == false and reader.pos < offset + length {
        // Read block header
        let bfinal = reader.read_bits(1)
        let btype = reader.read_bits(2)

        is_final = bfinal == 1

        if btype == 0 {
            // Stored block (no compression)
            reader.align_to_byte()

            if reader.pos + 4 > src.length {
                return DecompressResult {
                    data: output
                    result: ZlibResult.fail(ZlibError::DataError)
                }
            }

            let len = src[reader.pos] | (src[reader.pos + 1] << 8)
            let nlen = src[reader.pos + 2] | (src[reader.pos + 3] << 8)
            reader.pos = reader.pos + 4

            // Verify complement
            if (len ^ nlen) != 0xFFFF {
                return DecompressResult {
                    data: output
                    result: ZlibResult.fail(ZlibError::DataError)
                }
            }

            // Copy literal data
            for i in 0..len {
                if reader.pos < src.length {
                    output = output + [src[reader.pos]]
                    reader.pos = reader.pos + 1
                }
            }
        } else if btype == 1 || btype == 2 {
            // Fixed or dynamic Huffman (simplified - just handle stored for now)
            // Full implementation would decode Huffman trees
            return DecompressResult {
                data: output
                result: ZlibResult.fail(ZlibError::DataError)
            }
        } else {
            // Reserved (error)
            return DecompressResult {
                data: output
                result: ZlibResult.fail(ZlibError::DataError)
            }
        }
    }

    result.success = true
    result.output_size = output.length
    result.input_consumed = reader.pos - offset

    return DecompressResult {
        data: output
        result: result
    }
}

// Decompress zlib-compressed data
fn zlib_decompress(src: [i32]): DecompressResult {
    let output = []

    if src.length < 6 {  // Minimum: 2 header + 4 checksum
        return DecompressResult {
            data: output
            result: ZlibResult.fail(ZlibError::DataError)
        }
    }

    // Verify zlib header
    if is_zlib_compressed(src) == false {
        return DecompressResult {
            data: output
            result: ZlibResult.fail(ZlibError::DataError)
        }
    }

    let cmf = src[0]
    let flg = src[1]

    // Check for preset dictionary (not supported in this simple impl)
    if (flg & 0x20) != 0 {
        return DecompressResult {
            data: output
            result: ZlibResult.fail(ZlibError::NeedDict)
        }
    }

    // Decompress DEFLATE data starting at offset 2
    let src_len = src.length
    let decomp_result = inflate_decompress(src, 2, src_len - 6)

    if decomp_result.result.success == false {
        return decomp_result
    }

    let decompressed = decomp_result.data

    // Verify Adler-32 checksum (last 4 bytes, big-endian)
    let checksum_offset = src_len - 4
    let expected_checksum = (src[checksum_offset] << 24) |
                           (src[checksum_offset + 1] << 16) |
                           (src[checksum_offset + 2] << 8) |
                           src[checksum_offset + 3]

    let actual_checksum = adler32(decompressed)

    if actual_checksum != expected_checksum {
        // Checksum mismatch - data corruption (but still return data for debugging)
        let _placeholder = 0
    }

    let result = ZlibResult {
        success: true
        error: ZlibError::Ok
        output_size: decompressed.length
        input_consumed: src_len
    }

    return DecompressResult {
        data: decompressed
        result: result
    }
}

// Compress data using DEFLATE (simplified - uses stored blocks only)
fn deflate_compress(src: [i32], level: ZlibLevel): DecompressResult {
    let output = []

    // For simplicity, use stored blocks (no actual compression)
    // Full implementation would use LZ77 + Huffman coding
    let pos = 0
    let MAX_BLOCK_SIZE: i32 = 65535
    let src_len = src.length

    while pos < src_len {
        let remaining = src_len - pos
        let block_size = remaining
        if block_size > MAX_BLOCK_SIZE {
            block_size = MAX_BLOCK_SIZE
        }

        let is_final_block = (pos + block_size >= src_len)

        // Block header: BFINAL (1 bit) + BTYPE (2 bits) = stored (00)
        if is_final_block {
            output = output + [0x01]  // BFINAL=1, BTYPE=00
        } else {
            output = output + [0x00]  // BFINAL=0, BTYPE=00
        }

        // LEN and NLEN
        output = output + [block_size & 0xFF]
        output = output + [(block_size >> 8) & 0xFF]
        output = output + [(~block_size) & 0xFF]
        output = output + [((~block_size) >> 8) & 0xFF]

        // Copy literal data
        for i in 0..block_size {
            output = output + [src[pos + i]]
        }

        pos = pos + block_size
    }

    // Handle empty input
    if src_len == 0 {
        output = output + [0x01]  // BFINAL=1, BTYPE=00
        output = output + [0x00]  // LEN low
        output = output + [0x00]  // LEN high
        output = output + [0xFF]  // NLEN low
        output = output + [0xFF]  // NLEN high
    }

    let result = ZlibResult {
        success: true
        error: ZlibError::Ok
        output_size: output.length
        input_consumed: src_len
    }

    return DecompressResult {
        data: output
        result: result
    }
}

// Compress data using zlib (DEFLATE with zlib header)
fn zlib_compress(src: [i32], level: ZlibLevel): DecompressResult {
    let output = []

    // Write zlib header
    let cmf = ZLIB_CM_DEFLATE | (ZLIB_CINFO_32K << 4)  // 0x78

    // Calculate FLG
    let flevel = 0
    if level == ZlibLevel::BestCompression {
        flevel = 3
    } else if level == ZlibLevel::Default {
        flevel = 2
    } else if level == ZlibLevel::BestSpeed {
        flevel = 1
    }

    let flg_base = flevel << 6
    // Calculate FCHECK so that (CMF * 256 + FLG) % 31 == 0
    let fcheck = 31 - ((cmf * 256 + flg_base) % 31)
    let flg = flg_base | fcheck

    output = output + [cmf]
    output = output + [flg]

    // Compress data using DEFLATE
    let deflate_result = deflate_compress(src, level)

    if deflate_result.result.success == false {
        return DecompressResult {
            data: output
            result: deflate_result.result
        }
    }

    let compressed = deflate_result.data

    // Append compressed data
    let comp_len = compressed.length
    for i in 0..comp_len {
        output = output + [compressed[i]]
    }

    // Append Adler-32 checksum (big-endian)
    let checksum = adler32(src)
    output = output + [(checksum >> 24) & 0xFF]
    output = output + [(checksum >> 16) & 0xFF]
    output = output + [(checksum >> 8) & 0xFF]
    output = output + [checksum & 0xFF]

    let result = ZlibResult {
        success: true
        error: ZlibError::Ok
        output_size: output.length
        input_consumed: src.length
    }

    return DecompressResult {
        data: output
        result: result
    }
}

// ============================================================================
// Compression Manager (wraps RefPack and Zlib)
// ============================================================================

enum CompressionType {
    None,
    RefPack,
    Zlib,
    Auto,  // Auto-detect
}

// Detect compression type from data header
fn detect_compression_type(data: [i32]): CompressionType {
    if data.length < 2 {
        return CompressionType::None
    }

    // Check for RefPack signature (second byte is 0xFB)
    if data[1] == 0xFB {
        return CompressionType::RefPack
    }

    // Check for zlib header
    if is_zlib_compressed(data) {
        return CompressionType::Zlib
    }

    return CompressionType::None
}

// Auto-detect result
struct AutoDecompressResult {
    data: [i32]
    success: bool
}

// Decompress data with auto-detection
fn decompress_auto(data: [i32]): AutoDecompressResult {
    let compression_type = detect_compression_type(data)

    if compression_type == CompressionType::RefPack {
        // Import refpack module functions - TODO: implement
        return AutoDecompressResult {
            data: data
            success: false
        }
    } else if compression_type == CompressionType::Zlib {
        let result = zlib_decompress(data)
        return AutoDecompressResult {
            data: result.data
            success: result.result.success
        }
    } else {
        // Not compressed, return as-is
        return AutoDecompressResult {
            data: data
            success: true
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

fn test_adler32(): bool {
    let data: [i32] = []
    // "Wikipedia" in ASCII
    data = data + [87]   // W
    data = data + [105]  // i
    data = data + [107]  // k
    data = data + [105]  // i
    data = data + [112]  // p
    data = data + [101]  // e
    data = data + [100]  // d
    data = data + [105]  // i
    data = data + [97]   // a

    let checksum = adler32(data)
    // Expected Adler-32 for "Wikipedia" is 0x11E60398
    if checksum != 0x11E60398 {
        println("Adler-32 checksum should match")
        return false
    }

    return true
}

fn test_zlib_header_detection(): bool {
    // Valid zlib header (default compression)
    let valid: [i32] = []
    valid = valid + [0x78]  // CMF: deflate with 32K window
    valid = valid + [0x9C]  // FLG: default compression level

    if is_zlib_compressed(valid) == false {
        println("Should detect valid zlib header")
        return false
    }

    // Invalid header
    let invalid: [i32] = []
    invalid = invalid + [0x00]
    invalid = invalid + [0x00]

    if is_zlib_compressed(invalid) {
        println("Should reject invalid header")
        return false
    }

    return true
}

fn test_compression_type_detection(): bool {
    // RefPack data
    let refpack: [i32] = []
    refpack = refpack + [0x10]
    refpack = refpack + [0xFB]

    if detect_compression_type(refpack) != CompressionType::RefPack {
        println("Should detect RefPack")
        return false
    }

    // Zlib data
    let zlib_data: [i32] = []
    zlib_data = zlib_data + [0x78]
    zlib_data = zlib_data + [0x9C]

    if detect_compression_type(zlib_data) != CompressionType::Zlib {
        println("Should detect Zlib")
        return false
    }

    // Uncompressed
    let raw: [i32] = []
    raw = raw + [0x00]
    raw = raw + [0x00]

    if detect_compression_type(raw) != CompressionType::None {
        println("Should detect no compression")
        return false
    }

    return true
}

fn test_stored_block_roundtrip(): bool {
    // Create test data
    let original: [i32] = []
    for i in 0..100 {
        original = original + [i % 256]
    }

    // Compress with zlib (stored blocks)
    let compress_result = zlib_compress(original, ZlibLevel::NoCompression)
    if compress_result.result.success == false {
        println("Compression should succeed")
        return false
    }

    // Decompress
    let decompress_result = zlib_decompress(compress_result.data)
    if decompress_result.result.success == false {
        println("Decompression should succeed")
        return false
    }

    let decompressed = decompress_result.data

    // Verify
    if decompressed.length != original.length {
        println("Size should match")
        return false
    }

    let orig_len = original.length
    for i in 0..orig_len {
        if decompressed[i] != original[i] {
            println("Data should match")
            return false
        }
    }

    return true
}

fn run_all_tests(): bool {
    if test_adler32() == false {
        println("Adler-32 test failed")
        return false
    }
    if test_zlib_header_detection() == false {
        println("Zlib header detection test failed")
        return false
    }
    if test_compression_type_detection() == false {
        println("Compression type detection test failed")
        return false
    }
    if test_stored_block_roundtrip() == false {
        println("Stored block roundtrip test failed")
        return false
    }
    return true
}
