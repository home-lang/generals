// C&C Generals Zero Hour - Home Port
// PNG Image Loader - Portable Network Graphics Format
//
// Original: PngLoader from Thyme/SAGE engine
// Used for UI textures and other images in C&C Generals
// Reference: PNG Specification (RFC 2083)

// PNG signature (8 bytes)
let PNG_SIGNATURE: [i32] = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A]

// Critical chunk types
let CHUNK_IHDR: i32 = 0x49484452  // Image header
let CHUNK_PLTE: i32 = 0x504C5445  // Palette
let CHUNK_IDAT: i32 = 0x49444154  // Image data
let CHUNK_IEND: i32 = 0x49454E44  // Image end

// Ancillary chunk types
let CHUNK_tRNS: i32 = 0x74524E53  // Transparency
let CHUNK_gAMA: i32 = 0x67414D41  // Gamma
let CHUNK_cHRM: i32 = 0x6348524D  // Chromaticity
let CHUNK_sRGB: i32 = 0x73524742  // Standard RGB
let CHUNK_bKGD: i32 = 0x624B4744  // Background color
let CHUNK_pHYs: i32 = 0x70485973  // Physical dimensions
let CHUNK_tEXt: i32 = 0x74455874  // Text
let CHUNK_iTXt: i32 = 0x69545874  // International text
let CHUNK_tIME: i32 = 0x74494D45  // Last modification time

// Color types
let COLOR_GRAYSCALE: i32 = 0
let COLOR_RGB: i32 = 2
let COLOR_INDEXED: i32 = 3
let COLOR_GRAYSCALE_ALPHA: i32 = 4
let COLOR_RGBA: i32 = 6

// Filter types
let FILTER_NONE: i32 = 0
let FILTER_SUB: i32 = 1
let FILTER_UP: i32 = 2
let FILTER_AVERAGE: i32 = 3
let FILTER_PAETH: i32 = 4

// Interlace methods
let INTERLACE_NONE: i32 = 0
let INTERLACE_ADAM7: i32 = 1

// ============================================================================
// PNG HEADER
// ============================================================================

struct PNGHeader {
    width: i32,
    height: i32,
    bit_depth: i32,
    color_type: i32,
    compression: i32,
    filter: i32,
    interlace: i32,
}

impl PNGHeader {
    fn init(): PNGHeader {
        return PNGHeader {
            width: 0,
            height: 0,
            bit_depth: 0,
            color_type: 0,
            compression: 0,
            filter: 0,
            interlace: 0,
        }
    }
}

// ============================================================================
// PNG IMAGE
// ============================================================================

struct PNGImage {
    width: i32,
    height: i32,
    channels: i32,
    bit_depth: i32,
    pixels: [i32],       // RGBA pixel data
    name: string,
    has_alpha: bool,
}

impl PNGImage {
    fn init(): PNGImage {
        return PNGImage {
            width: 0,
            height: 0,
            channels: 4,
            bit_depth: 8,
            pixels: [],
            name: "",
            has_alpha: false,
        }
    }

    fn get_pixel(&self, x: i32, y: i32): (i32, i32, i32, i32) {
        if x < 0 || x >= self.width || y < 0 || y >= self.height {
            return (0, 0, 0, 0)
        }

        let offset = (y * self.width + x) * 4
        if offset + 4 > self.pixels.length {
            return (0, 0, 0, 0)
        }

        return (
            self.pixels[offset],
            self.pixels[offset + 1],
            self.pixels[offset + 2],
            self.pixels[offset + 3]
        )
    }
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn read_u32_be(data: [i32], offset: i32): i32 {
    if offset + 4 > data.length {
        return 0
    }
    return (data[offset] << 24) |
           (data[offset + 1] << 16) |
           (data[offset + 2] << 8) |
           data[offset + 3]
}

fn read_byte(data: [i32], offset: i32): i32 {
    if offset >= data.length {
        return 0
    }
    return data[offset]
}

fn check_signature(data: [i32]): bool {
    if data.length < 8 {
        return false
    }

    for i in 0..8 {
        if data[i] != PNG_SIGNATURE[i] {
            return false
        }
    }

    return true
}

fn get_channels(color_type: i32): i32 {
    if color_type == COLOR_GRAYSCALE {
        return 1
    } else if color_type == COLOR_RGB {
        return 3
    } else if color_type == COLOR_INDEXED {
        return 1
    } else if color_type == COLOR_GRAYSCALE_ALPHA {
        return 2
    } else if color_type == COLOR_RGBA {
        return 4
    }
    return 4
}

fn abs(x: i32): i32 {
    if x < 0 {
        return -x
    }
    return x
}

// Paeth predictor function
fn paeth_predictor(a: i32, b: i32, c: i32): i32 {
    let p = a + b - c
    let pa = abs(p - a)
    let pb = abs(p - b)
    let pc = abs(p - c)

    if pa <= pb && pa <= pc {
        return a
    } else if pb <= pc {
        return b
    }
    return c
}

// ============================================================================
// FILTER FUNCTIONS
// ============================================================================

fn unfilter_scanline(scanline: [i32], prev_scanline: [i32], filter_type: i32, bpp: i32): [i32] {
    let result: [i32] = []
    let width = scanline.length

    for i in 0..width {
        let x = scanline[i]

        let a: i32 = 0
        if i >= bpp && result.length > i - bpp {
            a = result[i - bpp]
        }

        let b: i32 = 0
        if prev_scanline.length > i {
            b = prev_scanline[i]
        }

        let c: i32 = 0
        if i >= bpp && prev_scanline.length > i - bpp {
            c = prev_scanline[i - bpp]
        }

        let value: i32 = 0
        if filter_type == FILTER_NONE {
            value = x
        } else if filter_type == FILTER_SUB {
            value = (x + a) & 0xFF
        } else if filter_type == FILTER_UP {
            value = (x + b) & 0xFF
        } else if filter_type == FILTER_AVERAGE {
            value = (x + ((a + b) / 2)) & 0xFF
        } else if filter_type == FILTER_PAETH {
            value = (x + paeth_predictor(a, b, c)) & 0xFF
        } else {
            value = x
        }

        result = result + [value]
    }

    return result
}

// ============================================================================
// PARSE FUNCTIONS
// ============================================================================

fn parse_ihdr(data: [i32], offset: i32): (PNGHeader, bool) {
    let header = PNGHeader::init()

    if offset + 13 > data.length {
        return (header, false)
    }

    header.width = read_u32_be(data, offset)
    header.height = read_u32_be(data, offset + 4)
    header.bit_depth = read_byte(data, offset + 8)
    header.color_type = read_byte(data, offset + 9)
    header.compression = read_byte(data, offset + 10)
    header.filter = read_byte(data, offset + 11)
    header.interlace = read_byte(data, offset + 12)

    // Validate
    if header.width == 0 || header.height == 0 {
        return (header, false)
    }

    if header.compression != 0 {
        return (header, false)  // Only deflate compression supported
    }

    return (header, true)
}

// ============================================================================
// MAIN LOAD FUNCTION
// ============================================================================

fn is_png_file(data: [i32]): bool {
    return check_signature(data)
}

fn load_png(data: [i32]): (PNGImage, bool) {
    let image = PNGImage::init()

    if !check_signature(data) {
        return (image, false)
    }

    // Parse chunks
    let offset = 8
    let header_found = false
    let header = PNGHeader::init()
    let palette: [i32] = []
    let compressed_data: [i32] = []
    let transparency: [i32] = []

    while offset + 12 <= data.length {
        let chunk_length = read_u32_be(data, offset)
        let chunk_type = read_u32_be(data, offset + 4)
        let chunk_data_start = offset + 8

        if chunk_type == CHUNK_IHDR {
            let (h, ok) = parse_ihdr(data, chunk_data_start)
            if ok {
                header = h
                header_found = true
            }
        } else if chunk_type == CHUNK_PLTE {
            // Parse palette
            for i in 0..chunk_length {
                palette = palette + [read_byte(data, chunk_data_start + i)]
            }
        } else if chunk_type == CHUNK_IDAT {
            // Collect compressed image data
            for i in 0..chunk_length {
                compressed_data = compressed_data + [read_byte(data, chunk_data_start + i)]
            }
        } else if chunk_type == CHUNK_tRNS {
            // Transparency data
            for i in 0..chunk_length {
                transparency = transparency + [read_byte(data, chunk_data_start + i)]
            }
        } else if chunk_type == CHUNK_IEND {
            break
        }

        offset = offset + 12 + chunk_length
    }

    if !header_found {
        return (image, false)
    }

    image.width = header.width
    image.height = header.height
    image.bit_depth = header.bit_depth
    image.channels = get_channels(header.color_type)
    image.has_alpha = header.color_type == COLOR_RGBA ||
                      header.color_type == COLOR_GRAYSCALE_ALPHA ||
                      transparency.length > 0

    // Decompress image data (placeholder - would use zlib)
    let decompressed = decompress_deflate(compressed_data)

    if decompressed.length == 0 {
        // Decompression not implemented - create placeholder
        let total = image.width * image.height * 4
        for i in 0..total {
            image.pixels = image.pixels + [128]   // Gray placeholder
        }
        return (image, true)
    }

    // Unfilter and convert to RGBA
    let bpp = (image.channels * header.bit_depth + 7) / 8
    let scanline_length = image.width * bpp
    let prev_scanline: [i32] = []

    let data_offset = 0
    for y in 0..image.height {
        if data_offset >= decompressed.length {
            break
        }

        let filter_type = decompressed[data_offset]
        data_offset = data_offset + 1

        // Extract scanline
        let scanline: [i32] = []
        for x in 0..scanline_length {
            if data_offset < decompressed.length {
                scanline = scanline + [decompressed[data_offset]]
                data_offset = data_offset + 1
            } else {
                scanline = scanline + [0]
            }
        }

        // Unfilter
        let unfiltered = unfilter_scanline(scanline, prev_scanline, filter_type, bpp)
        prev_scanline = unfiltered

        // Convert to RGBA
        for x in 0..image.width {
            let pixel_offset = x * bpp

            if header.color_type == COLOR_RGBA {
                image.pixels = image.pixels + [unfiltered[pixel_offset]]
                image.pixels = image.pixels + [unfiltered[pixel_offset + 1]]
                image.pixels = image.pixels + [unfiltered[pixel_offset + 2]]
                image.pixels = image.pixels + [unfiltered[pixel_offset + 3]]
            } else if header.color_type == COLOR_RGB {
                image.pixels = image.pixels + [unfiltered[pixel_offset]]
                image.pixels = image.pixels + [unfiltered[pixel_offset + 1]]
                image.pixels = image.pixels + [unfiltered[pixel_offset + 2]]
                image.pixels = image.pixels + [255]
            } else if header.color_type == COLOR_GRAYSCALE {
                let gray = unfiltered[pixel_offset]
                image.pixels = image.pixels + [gray]
                image.pixels = image.pixels + [gray]
                image.pixels = image.pixels + [gray]
                image.pixels = image.pixels + [255]
            } else if header.color_type == COLOR_GRAYSCALE_ALPHA {
                let gray = unfiltered[pixel_offset]
                image.pixels = image.pixels + [gray]
                image.pixels = image.pixels + [gray]
                image.pixels = image.pixels + [gray]
                image.pixels = image.pixels + [unfiltered[pixel_offset + 1]]
            } else if header.color_type == COLOR_INDEXED {
                let index = unfiltered[pixel_offset] * 3
                if index + 2 < palette.length {
                    image.pixels = image.pixels + [palette[index]]
                    image.pixels = image.pixels + [palette[index + 1]]
                    image.pixels = image.pixels + [palette[index + 2]]

                    // Check transparency
                    let alpha = 255
                    if unfiltered[pixel_offset] < transparency.length {
                        alpha = transparency[unfiltered[pixel_offset]]
                    }
                    image.pixels = image.pixels + [alpha]
                } else {
                    image.pixels = image.pixels + [0]
                    image.pixels = image.pixels + [0]
                    image.pixels = image.pixels + [0]
                    image.pixels = image.pixels + [255]
                }
            }
        }
    }

    return (image, true)
}

// ============================================================================
// ZLIB DECOMPRESSION (placeholder)
// ============================================================================

fn decompress_deflate(compressed: [i32]): [i32] {
    // This is a placeholder - real implementation would decompress DEFLATE
    // Would use zlib or implement RFC 1951
    return []
}

// ============================================================================
// GLOBAL PNG LOADER
// ============================================================================

struct PNGLoader {
    loaded_images: [PNGImage],
}

impl PNGLoader {
    fn init(): PNGLoader {
        return PNGLoader {
            loaded_images: [],
        }
    }

    fn load(&self, data: [i32], name: string): PNGImage? {
        let (image, ok) = load_png(data)
        if !ok {
            return null
        }

        image.name = name
        self.loaded_images = self.loaded_images + [image]
        return image
    }

    fn get_by_name(&self, name: string): PNGImage? {
        for i in 0..self.loaded_images.length {
            if self.loaded_images[i].name == name {
                return self.loaded_images[i]
            }
        }
        return null
    }

    fn clear(&self) {
        self.loaded_images = []
    }
}

let g_png_loader: PNGLoader? = null

fn init_png_loader(): PNGLoader {
    let loader = PNGLoader::init()
    g_png_loader = loader
    return loader
}

fn get_png_loader(): PNGLoader? {
    return g_png_loader
}

fn shutdown_png_loader() {
    g_png_loader = null
}
