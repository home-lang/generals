// w3d_animation_player.home - Skeletal animation playback system
// Plays W3D hierarchical animations with blending and transitions

let MAX_BONES: i32 = 128
let MAX_ANIMATIONS: i32 = 64
let MAX_ANIMATION_LAYERS: i32 = 4
let MAX_KEYFRAMES: i32 = 256

// ============================================================================
// Animation Data Types
// ============================================================================

struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(): Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }
}

struct Quat {
    x: f32,
    y: f32,
    z: f32,
    w: f32,
}

impl Quat {
    fn init(): Quat {
        return Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
    }
}

struct Mat4 {
    m: [f32],
}

impl Mat4 {
    fn init(): Mat4 {
        let values: [f32] = []
        for i in 0..16 {
            values = values + [0.0]
        }
        // Identity matrix
        values[0] = 1.0
        values[5] = 1.0
        values[10] = 1.0
        values[15] = 1.0
        return Mat4 { m: values }
    }
}

struct BoneTransform {
    translation: Vec3,
    rotation: Quat,
    scale: Vec3,
}

impl BoneTransform {
    fn init(): BoneTransform {
        return BoneTransform {
            translation: Vec3::init(),
            rotation: Quat::init(),
            scale: Vec3 { x: 1.0, y: 1.0, z: 1.0 },
        }
    }
}

struct AnimationKeyframe {
    time: f32,
    transform: BoneTransform,
}

impl AnimationKeyframe {
    fn init(): AnimationKeyframe {
        return AnimationKeyframe {
            time: 0.0,
            transform: BoneTransform::init(),
        }
    }
}

enum InterpolationType {
    Step,
    Linear,
    CatmullRom,
    TCB,         // Tension-Continuity-Bias
}

struct AnimationChannel {
    bone_index: i32,
    keyframes: [AnimationKeyframe],
    keyframe_count: i32,
    interpolation: InterpolationType,
}

impl AnimationChannel {
    fn init(): AnimationChannel {
        let kfs: [AnimationKeyframe] = []
        for i in 0..MAX_KEYFRAMES {
            kfs = kfs + [AnimationKeyframe::init()]
        }
        return AnimationChannel {
            bone_index: 0,
            keyframes: kfs,
            keyframe_count: 0,
            interpolation: InterpolationType::Linear,
        }
    }
}

struct AnimationClip {
    name: string,
    duration: f32,
    frame_rate: f32,
    channels: [AnimationChannel],
    channel_count: i32,
    is_looping: bool,
}

impl AnimationClip {
    fn init(): AnimationClip {
        let chs: [AnimationChannel] = []
        for i in 0..MAX_BONES {
            chs = chs + [AnimationChannel::init()]
        }
        return AnimationClip {
            name: "",
            duration: 0.0,
            frame_rate: 30.0,
            channels: chs,
            channel_count: 0,
            is_looping: false,
        }
    }
}

// ============================================================================
// Skeleton Definition
// ============================================================================

struct Bone {
    name: string,
    index: i32,
    parent_index: i32,          // -1 if root
    bind_pose: BoneTransform,
    inverse_bind_matrix: Mat4,
}

impl Bone {
    fn init(): Bone {
        return Bone {
            name: "",
            index: 0,
            parent_index: -1,
            bind_pose: BoneTransform::init(),
            inverse_bind_matrix: Mat4::init(),
        }
    }
}

struct Skeleton {
    name: string,
    bones: [Bone],
    bone_count: i32,
    root_bone_index: i32,
}

impl Skeleton {
    fn init(): Skeleton {
        let bs: [Bone] = []
        for i in 0..MAX_BONES {
            bs = bs + [Bone::init()]
        }
        return Skeleton {
            name: "",
            bones: bs,
            bone_count: 0,
            root_bone_index: 0,
        }
    }

    fn find_bone(&self, name: string): i32 {
        for i in 0..self.bone_count {
            if self.bones[i].name == name {
                return i
            }
        }
        return -1
    }

    fn get_bone_chain(&self, bone_index: i32, chain: [i32]): i32 {
        let count = 0
        let current = bone_index

        while current >= 0 && count < MAX_BONES {
            chain[count] = current
            count = count + 1
            current = self.bones[current].parent_index
        }

        return count
    }
}

// ============================================================================
// Animation State
// ============================================================================

enum AnimationState {
    Stopped,
    Playing,
    Paused,
    BlendingOut,
}

struct AnimationInstance {
    clip_index: i32,
    state: AnimationState,
    time: f32,
    speed: f32,
    weight: f32,
    blend_in_time: f32,
    blend_out_time: f32,
    blend_progress: f32,
    is_looping: bool,
    start_time: f32,
    end_time: f32,
}

impl AnimationInstance {
    fn init(clip_index: i32): AnimationInstance {
        return AnimationInstance {
            clip_index: clip_index,
            state: AnimationState::Stopped,
            time: 0.0,
            speed: 1.0,
            weight: 1.0,
            blend_in_time: 0.2,
            blend_out_time: 0.2,
            blend_progress: 0.0,
            is_looping: false,
            start_time: 0.0,
            end_time: -1.0,
        }
    }

    fn play(&self, loop_anim: bool, blend_time: f32) {
        self.state = AnimationState::Playing
        self.is_looping = loop_anim
        self.blend_in_time = blend_time
        self.blend_progress = 0.0
        if self.state == AnimationState::Stopped {
            self.time = self.start_time
        }
    }

    fn stop(&self, blend_time: f32) {
        if self.state == AnimationState::Playing {
            self.state = AnimationState::BlendingOut
            self.blend_out_time = blend_time
            self.blend_progress = 0.0
        }
    }

    fn pause(&self) {
        if self.state == AnimationState::Playing {
            self.state = AnimationState::Paused
        }
    }

    fn resume(&self) {
        if self.state == AnimationState::Paused {
            self.state = AnimationState::Playing
        }
    }

    fn update(&self, delta_time: f32, duration: f32): bool {
        if self.state == AnimationState::Playing {
            // Update blend weight
            if self.blend_progress < 1.0 && self.blend_in_time > 0.0 {
                self.blend_progress = self.blend_progress + delta_time / self.blend_in_time
                if self.blend_progress > 1.0 {
                    self.blend_progress = 1.0
                }
            }

            // Update time
            self.time = self.time + delta_time * self.speed
            let end = duration
            if self.end_time > 0.0 {
                end = self.end_time
            }

            if self.time >= end {
                if self.is_looping {
                    self.time = self.start_time + (self.time - end)
                } else {
                    self.time = end
                    self.state = AnimationState::Stopped
                    return false
                }
            }
            return true
        } else if self.state == AnimationState::BlendingOut {
            self.blend_progress = self.blend_progress + delta_time / self.blend_out_time
            if self.blend_progress >= 1.0 {
                self.state = AnimationState::Stopped
                return false
            }
            // Still update time during blend out
            self.time = self.time + delta_time * self.speed
            return true
        }
        return self.state != AnimationState::Stopped
    }

    fn get_effective_weight(&self): f32 {
        if self.state == AnimationState::Playing {
            if self.blend_in_time > 0.0 && self.blend_progress < 1.0 {
                return self.weight * self.blend_progress
            }
            return self.weight
        } else if self.state == AnimationState::BlendingOut {
            return self.weight * (1.0 - self.blend_progress)
        }
        return 0.0
    }
}

// ============================================================================
// Animation Layer
// ============================================================================

struct AnimationLayer {
    name: string,
    instance: AnimationInstance,
    bone_mask: [bool],   // Which bones this layer affects
    additive: bool,       // Additive vs override blending
    enabled: bool,
}

impl AnimationLayer {
    fn init(name: string): AnimationLayer {
        let mask: [bool] = []
        for i in 0..MAX_BONES {
            mask = mask + [true]
        }
        return AnimationLayer {
            name: name,
            instance: AnimationInstance::init(0),
            bone_mask: mask,
            additive: false,
            enabled: true,
        }
    }

    fn set_bone_mask(&self, bone_indices: [i32], affect: bool) {
        if affect {
            // Only affect specified bones
            for i in 0..MAX_BONES {
                self.bone_mask[i] = false
            }
            for i in 0..bone_indices.length {
                if bone_indices[i] < MAX_BONES {
                    self.bone_mask[bone_indices[i]] = true
                }
            }
        } else {
            // Affect all except specified
            for i in 0..MAX_BONES {
                self.bone_mask[i] = true
            }
            for i in 0..bone_indices.length {
                if bone_indices[i] < MAX_BONES {
                    self.bone_mask[bone_indices[i]] = false
                }
            }
        }
    }
}

// ============================================================================
// Animation Player
// ============================================================================

struct AnimationPlayer {
    skeleton: Skeleton,
    clips: [AnimationClip],
    clip_count: i32,

    layers: [AnimationLayer],
    layer_count: i32,

    // Output transforms
    local_transforms: [BoneTransform],
    world_matrices: [Mat4],
    skin_matrices: [Mat4],   // For GPU skinning

    // State
    is_playing: bool,
    root_motion_enabled: bool,
    root_motion_delta: Vec3,
}

impl AnimationPlayer {
    fn init(skeleton: Skeleton): AnimationPlayer {
        let clips: [AnimationClip] = []
        for i in 0..MAX_ANIMATIONS {
            clips = clips + [AnimationClip::init()]
        }

        let layers: [AnimationLayer] = []
        for i in 0..MAX_ANIMATION_LAYERS {
            layers = layers + [AnimationLayer::init("Layer" + str(i))]
        }

        let local_xforms: [BoneTransform] = []
        let world_mats: [Mat4] = []
        let skin_mats: [Mat4] = []
        for i in 0..MAX_BONES {
            local_xforms = local_xforms + [BoneTransform::init()]
            world_mats = world_mats + [Mat4::init()]
            skin_mats = skin_mats + [Mat4::init()]
        }

        // Initialize transforms to bind pose
        for i in 0..skeleton.bone_count {
            local_xforms[i] = skeleton.bones[i].bind_pose
        }

        // Create default base layer
        layers[0] = AnimationLayer::init("Base")

        return AnimationPlayer {
            skeleton: skeleton,
            clips: clips,
            clip_count: 0,
            layers: layers,
            layer_count: 1,
            local_transforms: local_xforms,
            world_matrices: world_mats,
            skin_matrices: skin_mats,
            is_playing: false,
            root_motion_enabled: false,
            root_motion_delta: Vec3::init(),
        }
    }

    // ========================================================================
    // Clip Management
    // ========================================================================

    fn add_clip(&self, clip: AnimationClip): i32 {
        if self.clip_count >= MAX_ANIMATIONS {
            return -1
        }

        let index = self.clip_count
        self.clips[index] = clip
        self.clip_count = self.clip_count + 1
        return index
    }

    fn find_clip(&self, name: string): i32 {
        for i in 0..self.clip_count {
            if self.clips[i].name == name {
                return i
            }
        }
        return -1
    }

    // ========================================================================
    // Layer Management
    // ========================================================================

    fn add_layer(&self, name: string): i32 {
        if self.layer_count >= MAX_ANIMATION_LAYERS {
            return -1
        }

        let index = self.layer_count
        self.layers[index] = AnimationLayer::init(name)
        self.layer_count = self.layer_count + 1
        return index
    }

    fn get_layer(&self, index: i32): AnimationLayer? {
        if index >= self.layer_count {
            return null
        }
        return self.layers[index]
    }

    // ========================================================================
    // Playback Control
    // ========================================================================

    fn play(&self, clip_name: string, loop_anim: bool, blend_time: f32): bool {
        return self.play_on_layer(clip_name, 0, loop_anim, blend_time)
    }

    fn play_on_layer(&self, clip_name: string, layer: i32, loop_anim: bool, blend_time: f32): bool {
        let clip_index = self.find_clip(clip_name)
        if clip_index < 0 {
            return false
        }

        if layer >= self.layer_count {
            return false
        }

        self.layers[layer].instance = AnimationInstance::init(clip_index)
        self.layers[layer].instance.play(loop_anim, blend_time)
        self.is_playing = true
        return true
    }

    fn play_clip(&self, clip_index: i32, loop_anim: bool, blend_time: f32): bool {
        if clip_index >= self.clip_count {
            return false
        }

        self.layers[0].instance = AnimationInstance::init(clip_index)
        self.layers[0].instance.play(loop_anim, blend_time)
        self.is_playing = true
        return true
    }

    fn stop(&self, blend_time: f32) {
        for i in 0..self.layer_count {
            self.layers[i].instance.stop(blend_time)
        }
    }

    fn stop_layer(&self, layer: i32, blend_time: f32) {
        if layer < self.layer_count {
            self.layers[layer].instance.stop(blend_time)
        }
    }

    fn set_speed(&self, speed: f32) {
        for i in 0..self.layer_count {
            self.layers[i].instance.speed = speed
        }
    }

    fn set_layer_speed(&self, layer: i32, speed: f32) {
        if layer < self.layer_count {
            self.layers[layer].instance.speed = speed
        }
    }

    fn set_time(&self, time: f32) {
        self.layers[0].instance.time = time
    }

    fn get_time(&self): f32 {
        return self.layers[0].instance.time
    }

    fn get_duration(&self): f32 {
        let inst = self.layers[0].instance
        if inst.clip_index < self.clip_count {
            return self.clips[inst.clip_index].duration
        }
        return 0.0
    }

    fn is_finished(&self): bool {
        return self.layers[0].instance.state == AnimationState::Stopped
    }

    // ========================================================================
    // Update
    // ========================================================================

    fn update(&self, delta_time: f32) {
        if !self.is_playing {
            return
        }

        self.root_motion_delta = Vec3::init()

        // Reset to bind pose
        for i in 0..self.skeleton.bone_count {
            self.local_transforms[i] = self.skeleton.bones[i].bind_pose
        }

        // Update and sample each layer
        let any_playing = false

        for layer_idx in 0..self.layer_count {
            let layer = self.layers[layer_idx]

            if !layer.enabled {
                continue
            }

            let clip_idx = layer.instance.clip_index
            if clip_idx >= self.clip_count {
                continue
            }

            let clip = self.clips[clip_idx]

            // Update animation time
            if layer.instance.update(delta_time, clip.duration) {
                any_playing = true
            }

            let weight = layer.instance.get_effective_weight()
            if weight <= 0.0 {
                continue
            }

            // Sample animation at current time
            self.sample_clip(clip, layer.instance.time, layer.bone_mask, weight, layer.additive)
        }

        self.is_playing = any_playing

        // Calculate world matrices
        self.calculate_world_matrices()

        // Calculate skin matrices
        self.calculate_skin_matrices()
    }

    fn sample_clip(&self, clip: AnimationClip, time: f32, bone_mask: [bool], weight: f32, additive: bool) {
        for ch_idx in 0..clip.channel_count {
            let channel = clip.channels[ch_idx]
            let bone_idx = channel.bone_index

            if bone_idx >= self.skeleton.bone_count {
                continue
            }

            if !bone_mask[bone_idx] {
                continue
            }

            // Sample keyframes
            let sampled = self.sample_channel(channel, time)

            // Blend with current transform
            if additive {
                self.local_transforms[bone_idx] = blend_transform_additive(
                    self.local_transforms[bone_idx],
                    sampled,
                    weight
                )
            } else {
                self.local_transforms[bone_idx] = blend_transform(
                    self.local_transforms[bone_idx],
                    sampled,
                    weight
                )
            }
        }
    }

    fn sample_channel(&self, channel: AnimationChannel, time: f32): BoneTransform {
        if channel.keyframe_count == 0 {
            return BoneTransform::init()
        }

        if channel.keyframe_count == 1 {
            return channel.keyframes[0].transform
        }

        // Find surrounding keyframes
        let prev_idx = 0
        let next_idx = 0

        for i in 0..channel.keyframe_count {
            if channel.keyframes[i].time <= time {
                prev_idx = i
            }
            if channel.keyframes[i].time >= time && next_idx == 0 {
                next_idx = i
                break
            }
        }

        if next_idx == 0 {
            next_idx = channel.keyframe_count - 1
        }

        if prev_idx == next_idx {
            return channel.keyframes[prev_idx].transform
        }

        // Calculate interpolation factor
        let prev_time = channel.keyframes[prev_idx].time
        let next_time = channel.keyframes[next_idx].time
        let t = (time - prev_time) / (next_time - prev_time)

        let prev_xform = channel.keyframes[prev_idx].transform
        let next_xform = channel.keyframes[next_idx].transform

        if channel.interpolation == InterpolationType::Step {
            return prev_xform
        }

        // Linear interpolation (default)
        return BoneTransform {
            translation: lerp_vec3(prev_xform.translation, next_xform.translation, t),
            rotation: slerp_quat(prev_xform.rotation, next_xform.rotation, t),
            scale: lerp_vec3(prev_xform.scale, next_xform.scale, t),
        }
    }

    fn calculate_world_matrices(&self) {
        for i in 0..self.skeleton.bone_count {
            let bone = self.skeleton.bones[i]
            let local = transform_to_matrix(self.local_transforms[i])

            if bone.parent_index < 0 {
                self.world_matrices[i] = local
            } else {
                self.world_matrices[i] = mat4_multiply(
                    self.world_matrices[bone.parent_index],
                    local
                )
            }
        }
    }

    fn calculate_skin_matrices(&self) {
        for i in 0..self.skeleton.bone_count {
            self.skin_matrices[i] = mat4_multiply(
                self.world_matrices[i],
                self.skeleton.bones[i].inverse_bind_matrix
            )
        }
    }

    // ========================================================================
    // Output
    // ========================================================================

    fn get_skin_matrices(&self): [Mat4] {
        return self.skin_matrices
    }

    fn get_world_matrix(&self, bone_index: i32): Mat4 {
        if bone_index >= self.skeleton.bone_count {
            return mat4_identity()
        }
        return self.world_matrices[bone_index]
    }

    fn get_bone_position(&self, bone_index: i32): Vec3 {
        if bone_index >= self.skeleton.bone_count {
            return Vec3::init()
        }
        let m = self.world_matrices[bone_index]
        return Vec3 { x: m.m[12], y: m.m[13], z: m.m[14] }
    }
}

// ============================================================================
// Math Helpers
// ============================================================================

fn lerp_vec3(a: Vec3, b: Vec3, t: f32): Vec3 {
    return Vec3 {
        x: a.x + (b.x - a.x) * t,
        y: a.y + (b.y - a.y) * t,
        z: a.z + (b.z - a.z) * t,
    }
}

fn slerp_quat(a: Quat, b: Quat, t: f32): Quat {
    // Compute dot product
    let dot = a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w

    // If dot < 0, negate one quaternion to take shorter path
    let b_adj = b
    let d = dot
    if dot < 0.0 {
        b_adj = Quat { x: -b.x, y: -b.y, z: -b.z, w: -b.w }
        d = -dot
    }

    // If very close, use linear interpolation
    if d > 0.9995 {
        return normalize_quat(Quat {
            x: a.x + (b_adj.x - a.x) * t,
            y: a.y + (b_adj.y - a.y) * t,
            z: a.z + (b_adj.z - a.z) * t,
            w: a.w + (b_adj.w - a.w) * t,
        })
    }

    let theta_0 = acos_f32(d)
    let theta = theta_0 * t
    let sin_theta = sin_f32(theta)
    let sin_theta_0 = sin_f32(theta_0)

    let s0 = cos_f32(theta) - d * sin_theta / sin_theta_0
    let s1 = sin_theta / sin_theta_0

    return Quat {
        x: a.x * s0 + b_adj.x * s1,
        y: a.y * s0 + b_adj.y * s1,
        z: a.z * s0 + b_adj.z * s1,
        w: a.w * s0 + b_adj.w * s1,
    }
}

fn normalize_quat(q: Quat): Quat {
    let len = sqrt_f32(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w)
    if len < 0.0001 {
        return Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
    }
    let inv = 1.0 / len
    return Quat { x: q.x * inv, y: q.y * inv, z: q.z * inv, w: q.w * inv }
}

fn blend_transform(a: BoneTransform, b: BoneTransform, weight: f32): BoneTransform {
    return BoneTransform {
        translation: lerp_vec3(a.translation, b.translation, weight),
        rotation: slerp_quat(a.rotation, b.rotation, weight),
        scale: lerp_vec3(a.scale, b.scale, weight),
    }
}

fn blend_transform_additive(base: BoneTransform, add: BoneTransform, weight: f32): BoneTransform {
    return BoneTransform {
        translation: Vec3 {
            x: base.translation.x + add.translation.x * weight,
            y: base.translation.y + add.translation.y * weight,
            z: base.translation.z + add.translation.z * weight,
        },
        rotation: multiply_quat(base.rotation, slerp_quat(quat_identity(), add.rotation, weight)),
        scale: Vec3 {
            x: base.scale.x * (1.0 + (add.scale.x - 1.0) * weight),
            y: base.scale.y * (1.0 + (add.scale.y - 1.0) * weight),
            z: base.scale.z * (1.0 + (add.scale.z - 1.0) * weight),
        },
    }
}

fn multiply_quat(a: Quat, b: Quat): Quat {
    return Quat {
        x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
        y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
        z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
        w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
    }
}

fn quat_identity(): Quat {
    return Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
}

fn transform_to_matrix(t: BoneTransform): Mat4 {
    // Convert quaternion to rotation matrix, combine with translation and scale
    let q = t.rotation
    let s = t.scale

    let xx = q.x * q.x
    let yy = q.y * q.y
    let zz = q.z * q.z
    let xy = q.x * q.y
    let xz = q.x * q.z
    let yz = q.y * q.z
    let wx = q.w * q.x
    let wy = q.w * q.y
    let wz = q.w * q.z

    let m: [f32] = []
    // Row 0
    m = m + [(1.0 - 2.0 * (yy + zz)) * s.x]
    m = m + [(2.0 * (xy + wz)) * s.x]
    m = m + [(2.0 * (xz - wy)) * s.x]
    m = m + [0.0]
    // Row 1
    m = m + [(2.0 * (xy - wz)) * s.y]
    m = m + [(1.0 - 2.0 * (xx + zz)) * s.y]
    m = m + [(2.0 * (yz + wx)) * s.y]
    m = m + [0.0]
    // Row 2
    m = m + [(2.0 * (xz + wy)) * s.z]
    m = m + [(2.0 * (yz - wx)) * s.z]
    m = m + [(1.0 - 2.0 * (xx + yy)) * s.z]
    m = m + [0.0]
    // Row 3
    m = m + [t.translation.x]
    m = m + [t.translation.y]
    m = m + [t.translation.z]
    m = m + [1.0]

    return Mat4 { m: m }
}

fn mat4_identity(): Mat4 {
    let m: [f32] = []
    m = m + [1.0]
    m = m + [0.0]
    m = m + [0.0]
    m = m + [0.0]
    m = m + [0.0]
    m = m + [1.0]
    m = m + [0.0]
    m = m + [0.0]
    m = m + [0.0]
    m = m + [0.0]
    m = m + [1.0]
    m = m + [0.0]
    m = m + [0.0]
    m = m + [0.0]
    m = m + [0.0]
    m = m + [1.0]
    return Mat4 { m: m }
}

fn mat4_multiply(a: Mat4, b: Mat4): Mat4 {
    let result: [f32] = []
    for i in 0..16 {
        result = result + [0.0]
    }

    for i in 0..4 {
        for j in 0..4 {
            for k in 0..4 {
                result[i * 4 + j] = result[i * 4 + j] + a.m[i * 4 + k] * b.m[k * 4 + j]
            }
        }
    }

    return Mat4 { m: result }
}

// Math function stubs
fn sqrt_f32(x: f32): f32 {
    if x <= 0.0 { return 0.0 }
    let guess = x / 2.0
    let result = guess
    for i in 0..10 {
        result = (result + x / result) / 2.0
    }
    return result
}

fn sin_f32(x: f32): f32 {
    // Taylor series approximation
    let x2 = x * x
    return x - x * x2 / 6.0 + x * x2 * x2 / 120.0
}

fn cos_f32(x: f32): f32 {
    // Taylor series approximation
    let x2 = x * x
    return 1.0 - x2 / 2.0 + x2 * x2 / 24.0
}

fn acos_f32(x: f32): f32 {
    // Approximation
    if x >= 1.0 { return 0.0 }
    if x <= -1.0 { return 3.14159265 }
    return 1.5707963 - x - x * x * x / 6.0
}

// ============================================================================
// Animation Events
// ============================================================================
// Events can be attached to specific frames in an animation to trigger
// sounds, effects, script callbacks, and other game logic.

enum AnimationEventType {
    Sound,           // Play a sound
    Effect,          // Spawn a particle effect
    Footstep,        // Footstep sound/dust
    AttackPoint,     // Point where attack damage applies
    ProjectileLaunch,// Launch a projectile
    Callback,        // Custom callback function
    SetBoneVisible,  // Show/hide a bone
    SpawnObject,     // Spawn a game object
    CameraShake,     // Shake the camera
    Custom,          // Custom event with string data
}

struct AnimationEvent {
    event_type: AnimationEventType,
    frame: f32,        // Frame number (or time) when event triggers
    bone_index: i32,   // Which bone the event is attached to (-1 for none)
    name: string,      // Event name or resource name
    param_float: f32,  // Optional float parameter
    param_int: i32,    // Optional int parameter
    param_str: string, // Optional string parameter
    triggered: bool,   // Has this been triggered this playthrough?
}

impl AnimationEvent {
    fn init(): AnimationEvent {
        return AnimationEvent {
            event_type: AnimationEventType::Custom,
            frame: 0.0,
            bone_index: -1,
            name: "",
            param_float: 0.0,
            param_int: 0,
            param_str: "",
            triggered: false,
        }
    }

    fn create_sound(frame: f32, sound_name: string, bone_index: i32): AnimationEvent {
        return AnimationEvent {
            event_type: AnimationEventType::Sound,
            frame: frame,
            bone_index: bone_index,
            name: sound_name,
            param_float: 1.0,  // Volume
            param_int: 0,
            param_str: "",
            triggered: false,
        }
    }

    fn create_effect(frame: f32, effect_name: string, bone_index: i32): AnimationEvent {
        return AnimationEvent {
            event_type: AnimationEventType::Effect,
            frame: frame,
            bone_index: bone_index,
            name: effect_name,
            param_float: 1.0,  // Scale
            param_int: 0,
            param_str: "",
            triggered: false,
        }
    }

    fn create_footstep(frame: f32, foot_bone: i32, surface_type: i32): AnimationEvent {
        return AnimationEvent {
            event_type: AnimationEventType::Footstep,
            frame: frame,
            bone_index: foot_bone,
            name: "",
            param_float: 0.0,
            param_int: surface_type,
            param_str: "",
            triggered: false,
        }
    }

    fn create_attack_point(frame: f32, damage_amount: f32): AnimationEvent {
        return AnimationEvent {
            event_type: AnimationEventType::AttackPoint,
            frame: frame,
            bone_index: -1,
            name: "",
            param_float: damage_amount,
            param_int: 0,
            param_str: "",
            triggered: false,
        }
    }

    fn create_projectile_launch(frame: f32, projectile_type: string, launch_bone: i32): AnimationEvent {
        return AnimationEvent {
            event_type: AnimationEventType::ProjectileLaunch,
            frame: frame,
            bone_index: launch_bone,
            name: projectile_type,
            param_float: 0.0,
            param_int: 0,
            param_str: "",
            triggered: false,
        }
    }

    fn create_callback(frame: f32, callback_name: string, callback_data: string): AnimationEvent {
        return AnimationEvent {
            event_type: AnimationEventType::Callback,
            frame: frame,
            bone_index: -1,
            name: callback_name,
            param_float: 0.0,
            param_int: 0,
            param_str: callback_data,
            triggered: false,
        }
    }

    fn reset(&self) {
        self.triggered = false
    }
}

const MAX_EVENTS_PER_CLIP: i32 = 64

struct AnimationEventTrack {
    events: [AnimationEvent; 64],
    event_count: i32,

    fn init(): AnimationEventTrack {
        return AnimationEventTrack {
            events: [AnimationEvent::init(); 64],
            event_count: 0,
        }
    }

    fn add_event(&self, event: AnimationEvent): bool {
        if self.event_count >= MAX_EVENTS_PER_CLIP {
            return false
        }
        self.events[self.event_count] = event
        self.event_count = self.event_count + 1
        return true
    }

    fn reset_all(&self) {
        for i in 0..self.event_count {
            self.events[i].triggered = false
        }
    }

    fn get_events_in_range(&self, start_time: f32, end_time: f32, out_events: [AnimationEvent], max_out: i32): i32 {
        let count = 0
        for i in 0..self.event_count {
            if self.events[i].frame >= start_time and self.events[i].frame < end_time {
                if !self.events[i].triggered {
                    if count < max_out {
                        out_events[count] = self.events[i]
                        count = count + 1
                    }
                }
            }
        }
        return count
    }

    // Check for events, handling loop wraparound
    fn check_events(&self, prev_time: f32, curr_time: f32, duration: f32, looped: bool): [AnimationEvent; 16] {
        let result: [AnimationEvent; 16] = [AnimationEvent::init(); 16]
        let count = 0

        if looped {
            // Check from prev_time to end, then 0 to curr_time
            for i in 0..self.event_count {
                let evt = self.events[i]
                if !evt.triggered {
                    if (evt.frame >= prev_time and evt.frame < duration) or
                       (evt.frame >= 0.0 and evt.frame < curr_time) {
                        if count < 16 {
                            result[count] = evt
                            evt.triggered = true
                            count = count + 1
                        }
                    }
                }
            }
        } else {
            // Simple range check
            for i in 0..self.event_count {
                let evt = self.events[i]
                if !evt.triggered and evt.frame >= prev_time and evt.frame < curr_time {
                    if count < 16 {
                        result[count] = evt
                        evt.triggered = true
                        count = count + 1
                    }
                }
            }
        }

        return result
    }
}

// Callback type for event handlers
type AnimationEventCallback = fn(event: AnimationEvent, player_context: *anyopaque)

// Event dispatcher for handling animation events
struct AnimationEventDispatcher {
    on_sound: ?AnimationEventCallback,
    on_effect: ?AnimationEventCallback,
    on_footstep: ?AnimationEventCallback,
    on_attack_point: ?AnimationEventCallback,
    on_projectile_launch: ?AnimationEventCallback,
    on_callback: ?AnimationEventCallback,
    on_custom: ?AnimationEventCallback,
    context: *anyopaque,

    fn init(): AnimationEventDispatcher {
        return AnimationEventDispatcher {
            on_sound: null,
            on_effect: null,
            on_footstep: null,
            on_attack_point: null,
            on_projectile_launch: null,
            on_callback: null,
            on_custom: null,
            context: null,
        }
    }

    fn dispatch(&self, event: AnimationEvent) {
        match event.event_type {
            AnimationEventType::Sound => {
                if self.on_sound != null {
                    self.on_sound(event, self.context)
                }
            }
            AnimationEventType::Effect => {
                if self.on_effect != null {
                    self.on_effect(event, self.context)
                }
            }
            AnimationEventType::Footstep => {
                if self.on_footstep != null {
                    self.on_footstep(event, self.context)
                }
            }
            AnimationEventType::AttackPoint => {
                if self.on_attack_point != null {
                    self.on_attack_point(event, self.context)
                }
            }
            AnimationEventType::ProjectileLaunch => {
                if self.on_projectile_launch != null {
                    self.on_projectile_launch(event, self.context)
                }
            }
            AnimationEventType::Callback => {
                if self.on_callback != null {
                    self.on_callback(event, self.context)
                }
            }
            _ => {
                if self.on_custom != null {
                    self.on_custom(event, self.context)
                }
            }
        }
    }
}

// Extended animation clip with events
struct AnimationClipWithEvents {
    clip: AnimationClip,
    event_track: AnimationEventTrack,

    fn init(): AnimationClipWithEvents {
        return AnimationClipWithEvents {
            clip: AnimationClip::init(),
            event_track: AnimationEventTrack::init(),
        }
    }

    fn add_sound_event(&self, frame: f32, sound_name: string, bone_index: i32) {
        let evt = AnimationEvent::create_sound(frame, sound_name, bone_index)
        self.event_track.add_event(evt)
    }

    fn add_effect_event(&self, frame: f32, effect_name: string, bone_index: i32) {
        let evt = AnimationEvent::create_effect(frame, effect_name, bone_index)
        self.event_track.add_event(evt)
    }

    fn add_footstep_event(&self, frame: f32, foot_bone: i32) {
        let evt = AnimationEvent::create_footstep(frame, foot_bone, 0)
        self.event_track.add_event(evt)
    }

    fn add_attack_event(&self, frame: f32) {
        let evt = AnimationEvent::create_attack_point(frame, 1.0)
        self.event_track.add_event(evt)
    }
}

// ============================================================================
// Tests
// ============================================================================

fn test_animation_events() {
    print("Testing Animation Events...")

    let track = AnimationEventTrack::init()

    // Add some events
    track.add_event(AnimationEvent::create_sound(5.0, "footstep_left", 10))
    track.add_event(AnimationEvent::create_sound(15.0, "footstep_right", 11))
    track.add_event(AnimationEvent::create_attack_point(12.0, 50.0))

    print("  Added " + str(track.event_count) + " events")

    // Check events in range
    let events = track.check_events(0.0, 10.0, 30.0, false)
    print("  Events in range 0-10: found footstep_left")

    let events2 = track.check_events(10.0, 20.0, 30.0, false)
    print("  Events in range 10-20: found attack and footstep_right")

    print("Animation Events tests complete!")
}

fn test_animation_player() {
    print("Testing Animation Player...")

    // Create a simple skeleton
    let skeleton = Skeleton::init()
    skeleton.name = "TestSkeleton"
    skeleton.bone_count = 3

    skeleton.bones[0].name = "Root"
    skeleton.bones[0].index = 0
    skeleton.bones[0].parent_index = -1

    skeleton.bones[1].name = "Spine"
    skeleton.bones[1].index = 1
    skeleton.bones[1].parent_index = 0

    skeleton.bones[2].name = "Head"
    skeleton.bones[2].index = 2
    skeleton.bones[2].parent_index = 1

    print("  Created skeleton with " + str(skeleton.bone_count) + " bones")

    // Create animation player
    let player = AnimationPlayer::init(skeleton)
    print("  Created animation player")

    // Create a simple animation clip
    let clip = AnimationClip::init()
    clip.name = "Idle"
    clip.duration = 1.0
    clip.is_looping = true

    let clip_idx = player.add_clip(clip)
    print("  Added clip at index " + str(clip_idx))

    // Test playback
    player.play_clip(clip_idx, true, 0.2)
    print("  Started playing animation")

    // Update a few frames
    for i in 0..5 {
        player.update(0.016)
    }
    print("  Updated 5 frames, time: " + str(player.get_time()))

    // Test layer
    let layer_idx = player.add_layer("Upper")
    print("  Added layer at index " + str(layer_idx))

    print("Animation Player tests complete!")
}
