// Camera System - RTS camera with pan, zoom, rotate for C&C Generals
// Implements authentic Generals camera behavior

// ============================================================================
// CAMERA TYPES
// ============================================================================

enum CameraMode {
    FREE,               // Normal gameplay
    CINEMATIC,          // Cutscene mode
    LOCKED,             // Fixed position
    FOLLOW_UNIT,        // Follow selected unit
    TACTICAL,           // Top-down view
}

struct Camera {
    // Position
    position: Vec3,
    target: Vec3,
    up: Vec3,

    // Orientation
    yaw: f32,           // Rotation around Y
    pitch: f32,         // Tilt angle
    distance: f32,      // Distance from target

    // Projection
    fov: f32,
    aspect: f32,
    near: f32,
    far: f32,

    // Constraints
    min_pitch: f32,
    max_pitch: f32,
    min_distance: f32,
    max_distance: f32,
    min_y: f32,
    max_y: f32,

    // Movement
    pan_speed: f32,
    zoom_speed: f32,
    rotate_speed: f32,

    // State
    mode: CameraMode,
    follow_target_id: i32,

    // Smoothing
    smooth_position: Vec3,
    smooth_target: Vec3,
    smooth_factor: f32,
}

fn create_camera(): Camera {
    return Camera {
        position: Vec3 { x: 0.0, y: 100.0, z: 100.0 },
        target: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        up: Vec3 { x: 0.0, y: 1.0, z: 0.0 },

        yaw: 0.0,
        pitch: 45.0,        // Generals default angle
        distance: 150.0,

        fov: 45.0,
        aspect: 1.333,
        near: 1.0,
        far: 2000.0,

        min_pitch: 20.0,
        max_pitch: 70.0,
        min_distance: 50.0,
        max_distance: 400.0,
        min_y: 0.0,
        max_y: 500.0,

        pan_speed: 500.0,
        zoom_speed: 200.0,
        rotate_speed: 90.0,

        mode: CameraMode::FREE,
        follow_target_id: -1,

        smooth_position: Vec3 { x: 0.0, y: 100.0, z: 100.0 },
        smooth_target: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        smooth_factor: 10.0,
    }
}

fn set_camera_defaults_generals(camera: Camera) {
    // Authentic C&C Generals camera settings
    camera.pitch = 50.0
    camera.distance = 175.0
    camera.fov = 45.0
    camera.min_pitch = 30.0
    camera.max_pitch = 65.0
    camera.min_distance = 80.0
    camera.max_distance = 350.0
    camera.pan_speed = 600.0
    camera.zoom_speed = 300.0
}

// ============================================================================
// CAMERA CONTROLS
// ============================================================================

fn pan_camera(camera: Camera, dx: f32, dz: f32, delta_time: f32) {
    // Calculate forward and right vectors (ignoring Y)
    let forward_x: f32 = sin(camera.yaw * 0.0174533)
    let forward_z: f32 = cos(camera.yaw * 0.0174533)
    let right_x: f32 = cos(camera.yaw * 0.0174533)
    let right_z: f32 = -sin(camera.yaw * 0.0174533)

    let move_x: f32 = (forward_x * dz + right_x * dx) * camera.pan_speed * delta_time
    let move_z: f32 = (forward_z * dz + right_z * dx) * camera.pan_speed * delta_time

    camera.target.x = camera.target.x + move_x
    camera.target.z = camera.target.z + move_z

    update_camera_position(camera)
}

fn zoom_camera(camera: Camera, delta: f32, delta_time: f32) {
    camera.distance = camera.distance - delta * camera.zoom_speed * delta_time

    // Clamp
    if camera.distance < camera.min_distance {
        camera.distance = camera.min_distance
    }
    if camera.distance > camera.max_distance {
        camera.distance = camera.max_distance
    }

    update_camera_position(camera)
}

fn rotate_camera(camera: Camera, delta_yaw: f32, delta_pitch: f32, delta_time: f32) {
    camera.yaw = camera.yaw + delta_yaw * camera.rotate_speed * delta_time
    camera.pitch = camera.pitch + delta_pitch * camera.rotate_speed * delta_time

    // Wrap yaw
    while camera.yaw > 360.0 { camera.yaw = camera.yaw - 360.0 }
    while camera.yaw < 0.0 { camera.yaw = camera.yaw + 360.0 }

    // Clamp pitch
    if camera.pitch < camera.min_pitch {
        camera.pitch = camera.min_pitch
    }
    if camera.pitch > camera.max_pitch {
        camera.pitch = camera.max_pitch
    }

    update_camera_position(camera)
}

fn update_camera_position(camera: Camera) {
    // Calculate position from target, yaw, pitch, distance
    let pitch_rad: f32 = camera.pitch * 0.0174533
    let yaw_rad: f32 = camera.yaw * 0.0174533

    let horiz_dist: f32 = camera.distance * cos(pitch_rad)
    let vert_dist: f32 = camera.distance * sin(pitch_rad)

    camera.position.x = camera.target.x - horiz_dist * sin(yaw_rad)
    camera.position.y = camera.target.y + vert_dist
    camera.position.z = camera.target.z - horiz_dist * cos(yaw_rad)

    // Clamp height
    if camera.position.y < camera.min_y {
        camera.position.y = camera.min_y
    }
    if camera.position.y > camera.max_y {
        camera.position.y = camera.max_y
    }
}

fn center_on_position(camera: Camera, x: f32, z: f32) {
    camera.target.x = x
    camera.target.z = z
    update_camera_position(camera)
}

fn center_on_unit(camera: Camera, unit_x: f32, unit_y: f32, unit_z: f32) {
    camera.target.x = unit_x
    camera.target.y = unit_y
    camera.target.z = unit_z
    update_camera_position(camera)
}

fn follow_unit(camera: Camera, unit_id: i32) {
    camera.mode = CameraMode::FOLLOW_UNIT
    camera.follow_target_id = unit_id
}

fn stop_following(camera: Camera) {
    camera.mode = CameraMode::FREE
    camera.follow_target_id = -1
}

// ============================================================================
// CAMERA UPDATE
// ============================================================================

fn update_camera(camera: Camera, delta_time: f32) {
    // Smooth interpolation
    let factor: f32 = camera.smooth_factor * delta_time
    if factor > 1.0 {
        camera.smooth_position = camera.position
        camera.smooth_target = camera.target
    } else {
        camera.smooth_position.x = camera.smooth_position.x + (camera.position.x - camera.smooth_position.x) * factor
        camera.smooth_position.y = camera.smooth_position.y + (camera.position.y - camera.smooth_position.y) * factor
        camera.smooth_position.z = camera.smooth_position.z + (camera.position.z - camera.smooth_position.z) * factor

        camera.smooth_target.x = camera.smooth_target.x + (camera.target.x - camera.smooth_target.x) * factor
        camera.smooth_target.y = camera.smooth_target.y + (camera.target.y - camera.smooth_target.y) * factor
        camera.smooth_target.z = camera.smooth_target.z + (camera.target.z - camera.smooth_target.z) * factor
    }
}

fn get_view_matrix(camera: Camera): Mat4 {
    return look_at(camera.smooth_position, camera.smooth_target, camera.up)
}

fn get_projection_matrix(camera: Camera): Mat4 {
    return perspective(camera.fov, camera.aspect, camera.near, camera.far)
}

// ============================================================================
// SCREEN TO WORLD
// ============================================================================

struct Ray {
    origin: Vec3,
    direction: Vec3,
}

fn screen_to_ray(camera: Camera, screen_x: f32, screen_y: f32, screen_w: f32, screen_h: f32): Ray {
    // Convert screen coords to NDC (-1 to 1)
    let ndc_x: f32 = (2.0 * screen_x / screen_w) - 1.0
    let ndc_y: f32 = 1.0 - (2.0 * screen_y / screen_h)

    // Convert to view space
    let tan_fov: f32 = tan(camera.fov * 0.5 * 0.0174533)
    let ray_x: f32 = ndc_x * tan_fov * camera.aspect
    let ray_y: f32 = ndc_y * tan_fov
    let ray_z: f32 = -1.0

    // Transform to world space (simplified - would need inverse view matrix)
    let yaw_rad: f32 = camera.yaw * 0.0174533
    let pitch_rad: f32 = camera.pitch * 0.0174533

    // Rotate by camera orientation
    let rot_x: f32 = ray_x * cos(yaw_rad) - ray_z * sin(yaw_rad)
    let rot_z: f32 = ray_x * sin(yaw_rad) + ray_z * cos(yaw_rad)
    let rot_y: f32 = ray_y * cos(pitch_rad) - rot_z * sin(pitch_rad)
    let rot_z2: f32 = ray_y * sin(pitch_rad) + rot_z * cos(pitch_rad)

    // Normalize
    let len: f32 = sqrt(rot_x*rot_x + rot_y*rot_y + rot_z2*rot_z2)

    return Ray {
        origin: camera.smooth_position,
        direction: Vec3 {
            x: rot_x / len,
            y: rot_y / len,
            z: rot_z2 / len,
        },
    }
}

fn ray_ground_intersection(ray: Ray, ground_y: f32): Vec3 {
    // Find where ray intersects ground plane (y = ground_y)
    if ray.direction.y == 0.0 {
        // Ray parallel to ground
        return Vec3 { x: 0.0, y: ground_y, z: 0.0 }
    }

    let t: f32 = (ground_y - ray.origin.y) / ray.direction.y

    if t < 0.0 {
        // Intersection behind camera
        return Vec3 { x: 0.0, y: ground_y, z: 0.0 }
    }

    return Vec3 {
        x: ray.origin.x + ray.direction.x * t,
        y: ground_y,
        z: ray.origin.z + ray.direction.z * t,
    }
}

fn screen_to_world(camera: Camera, screen_x: f32, screen_y: f32, screen_w: f32, screen_h: f32, ground_y: f32): Vec3 {
    let ray: Ray = screen_to_ray(camera, screen_x, screen_y, screen_w, screen_h)
    return ray_ground_intersection(ray, ground_y)
}

// ============================================================================
// WORLD TO SCREEN
// ============================================================================

fn world_to_screen(camera: Camera, world_pos: Vec3, screen_w: f32, screen_h: f32): [f32] {
    // Get matrices
    let view: Mat4 = get_view_matrix(camera)
    let proj: Mat4 = get_projection_matrix(camera)

    // Transform to clip space
    let view_pos: Vec4 = mat4_mul_vec4(view, Vec4 { x: world_pos.x, y: world_pos.y, z: world_pos.z, w: 1.0 })
    let clip_pos: Vec4 = mat4_mul_vec4(proj, view_pos)

    // Perspective divide
    if clip_pos.w == 0.0 {
        return [-1.0, -1.0, -1.0]   // Behind camera
    }

    let ndc_x: f32 = clip_pos.x / clip_pos.w
    let ndc_y: f32 = clip_pos.y / clip_pos.w
    let ndc_z: f32 = clip_pos.z / clip_pos.w

    // Convert to screen coords
    let screen_x: f32 = (ndc_x + 1.0) * 0.5 * screen_w
    let screen_y: f32 = (1.0 - ndc_y) * 0.5 * screen_h

    return [screen_x, screen_y, ndc_z]
}

fn is_on_screen(camera: Camera, world_pos: Vec3, screen_w: f32, screen_h: f32): bool {
    let screen_pos: [f32] = world_to_screen(camera, world_pos, screen_w, screen_h)

    if screen_pos[2] < 0.0 || screen_pos[2] > 1.0 {
        return false   // Behind camera or too far
    }

    return screen_pos[0] >= 0.0 && screen_pos[0] < screen_w &&
           screen_pos[1] >= 0.0 && screen_pos[1] < screen_h
}

// ============================================================================
// CAMERA BOUNDS
// ============================================================================

struct CameraBounds {
    min_x: f32,
    max_x: f32,
    min_z: f32,
    max_z: f32,
}

fn set_camera_bounds(camera: Camera, bounds: CameraBounds) {
    // Would store bounds and clamp camera target
}

fn clamp_camera_to_bounds(camera: Camera, bounds: CameraBounds) {
    if camera.target.x < bounds.min_x { camera.target.x = bounds.min_x }
    if camera.target.x > bounds.max_x { camera.target.x = bounds.max_x }
    if camera.target.z < bounds.min_z { camera.target.z = bounds.min_z }
    if camera.target.z > bounds.max_z { camera.target.z = bounds.max_z }

    update_camera_position(camera)
}

// ============================================================================
// CAMERA SHAKE SYSTEM - Authentic Westwood/EA Implementation
// Based on CameraShakeSystem.cpp from the original game
// ============================================================================

// Constants matching original game (converted from degrees to radians)
const MIN_OMEGA: f32 = 78.5398  // 12.5 * 360 * PI/180 = 78.54 rad/s
const MAX_OMEGA: f32 = 94.2478  // 15.0 * 360 * PI/180 = 94.25 rad/s
const END_OMEGA: f32 = 6.28318  // 360 * PI/180 = 2*PI rad/s
const MIN_PHI: f32 = 0.0
const MAX_PHI: f32 = 6.28318   // 360 degrees in radians

// Axis rotation amplitudes (X=pitch, Y=yaw, Z=roll)
// Pitch (Y) has 2x the amplitude of others for more dramatic vertical movement
const AXIS_ROTATION_X: f32 = 0.1309  // 7.5 degrees
const AXIS_ROTATION_Y: f32 = 0.2618  // 15 degrees
const AXIS_ROTATION_Z: f32 = 0.0873  // 5 degrees

// Individual shaker instance - represents one source of camera shake
struct CameraShaker {
    // Position of the shake source in world space
    position: Vec3,
    // Radius of effect - shake fades with distance
    radius: f32,
    // Total duration of shake effect
    duration: f32,
    // Intensity multiplier (power in degrees converted to radians)
    intensity: f32,
    // Elapsed time since shake started
    elapsed_time: f32,
    // Random angular frequencies for X, Y, Z axes
    omega_x: f32,
    omega_y: f32,
    omega_z: f32,
    // Random phase shifts for X, Y, Z axes
    phi_x: f32,
    phi_y: f32,
    phi_z: f32,
    // Is this shaker still active?
    active: bool,
}

// System that manages multiple simultaneous camera shakers
struct CameraShakeSystem {
    // Pool of shakers (max 16 simultaneous shakes)
    shakers: [CameraShaker],
    shaker_count: i32,
    max_shakers: i32,
    // Global random seed for deterministic randomness
    random_seed: i32,
}

// Simple pseudo-random number generator for shake parameters
fn shake_random(seed: i32): f32 {
    // Linear congruential generator
    let new_seed: i32 = (seed * 1103515245 + 12345) % 2147483647
    return (new_seed as f32) / 2147483647.0
}

fn shake_random_range(min_val: f32, max_val: f32, seed: i32): f32 {
    return min_val + shake_random(seed) * (max_val - min_val)
}

fn create_camera_shake_system(): CameraShakeSystem {
    let shakers: [CameraShaker] = []
    for i in 0..16 {
        shakers = shakers + [CameraShaker {
            position: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
            radius: 0.0,
            duration: 0.0,
            intensity: 0.0,
            elapsed_time: 0.0,
            omega_x: 0.0,
            omega_y: 0.0,
            omega_z: 0.0,
            phi_x: 0.0,
            phi_y: 0.0,
            phi_z: 0.0,
            active: false,
        }]
    }
    return CameraShakeSystem {
        shakers: shakers,
        shaker_count: 0,
        max_shakers: 16,
        random_seed: 42,
    }
}

// Add a new camera shake at a world position
// position: world position of shake source
// radius: effective radius (default 50.0)
// duration: shake duration in seconds (default 1.5)
// power: shake intensity in degrees (default 1.0)
fn add_camera_shake(system: CameraShakeSystem, position: Vec3, radius: f32, duration: f32, power: f32) {
    // Find an inactive slot
    let slot: i32 = -1
    for i in 0..system.max_shakers {
        if !system.shakers[i].active {
            slot = i
            break
        }
    }

    if slot < 0 {
        // No free slots - find oldest and replace it
        let oldest_time: f32 = 0.0
        slot = 0
        for i in 0..system.max_shakers {
            if system.shakers[i].elapsed_time > oldest_time {
                oldest_time = system.shakers[i].elapsed_time
                slot = i
            }
        }
    }

    // Convert power from degrees to radians
    let intensity: f32 = power * 0.0174533

    // Initialize shaker with random frequencies and phases
    system.random_seed = system.random_seed + 1
    let seed1: i32 = system.random_seed * 17
    let seed2: i32 = system.random_seed * 31
    let seed3: i32 = system.random_seed * 47

    system.shakers[slot] = CameraShaker {
        position: position,
        radius: radius,
        duration: duration,
        intensity: intensity,
        elapsed_time: 0.0,
        omega_x: shake_random_range(MIN_OMEGA, MAX_OMEGA, seed1),
        omega_y: shake_random_range(MIN_OMEGA, MAX_OMEGA, seed2),
        omega_z: shake_random_range(MIN_OMEGA, MAX_OMEGA, seed3),
        phi_x: shake_random_range(MIN_PHI, MAX_PHI, seed1 + 100),
        phi_y: shake_random_range(MIN_PHI, MAX_PHI, seed2 + 100),
        phi_z: shake_random_range(MIN_PHI, MAX_PHI, seed3 + 100),
        active: true,
    }
}

// Update all active shakers (call once per frame)
fn timestep_camera_shake_system(system: CameraShakeSystem, delta_time: f32) {
    for i in 0..system.max_shakers {
        if system.shakers[i].active {
            system.shakers[i].elapsed_time = system.shakers[i].elapsed_time + delta_time

            // Check if expired
            if system.shakers[i].elapsed_time >= system.shakers[i].duration {
                system.shakers[i].active = false
            }
        }
    }
}

// Compute rotation angles from a single shaker
fn compute_shaker_rotations(shaker: CameraShaker, camera_position: Vec3): Vec3 {
    if !shaker.active {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }

    // Calculate distance squared from camera to shake source
    let dx: f32 = camera_position.x - shaker.position.x
    let dy: f32 = camera_position.y - shaker.position.y
    let dz: f32 = camera_position.z - shaker.position.z
    let len2: f32 = dx*dx + dy*dy + dz*dz

    // Outside radius - no effect
    if len2 > shaker.radius * shaker.radius {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }

    // Calculate intensity based on distance and time remaining
    // intensity(t,pos) = intensity * (1 - distance/radius) * (1 - elapsed/duration)
    let distance: f32 = sqrt(len2)
    let distance_factor: f32 = 1.0 - distance / shaker.radius
    let time_factor: f32 = 1.0 - shaker.elapsed_time / shaker.duration
    let current_intensity: f32 = shaker.intensity * distance_factor * time_factor

    // Calculate angular frequency that decreases over time
    // omega(t) = start_omega + (end_omega - start_omega) * t
    let t: f32 = shaker.elapsed_time
    let omega_x: f32 = shaker.omega_x + (END_OMEGA - shaker.omega_x) * shaker.elapsed_time / shaker.duration
    let omega_y: f32 = shaker.omega_y + (END_OMEGA - shaker.omega_y) * shaker.elapsed_time / shaker.duration
    let omega_z: f32 = shaker.omega_z + (END_OMEGA - shaker.omega_z) * shaker.elapsed_time / shaker.duration

    // Calculate rotation angles using sinusoidal motion
    // f(t) = axis_amplitude * intensity * sin(omega * t + phi)
    let angle_x: f32 = AXIS_ROTATION_X * current_intensity * sin(omega_x * t + shaker.phi_x)
    let angle_y: f32 = AXIS_ROTATION_Y * current_intensity * sin(omega_y * t + shaker.phi_y)
    let angle_z: f32 = AXIS_ROTATION_Z * current_intensity * sin(omega_z * t + shaker.phi_z)

    // Add secondary random fudge (matching original WST 11/14/2002 addition)
    let minor_intensity: f32 = current_intensity * 0.5
    let fudge_x: f32 = (shake_random(shaker.random_seed_x()) - 0.5) * 2.0 * minor_intensity
    let fudge_y: f32 = (shake_random(shaker.random_seed_y()) - 0.5) * 2.0 * minor_intensity
    let fudge_z: f32 = (shake_random(shaker.random_seed_z()) - 0.5) * 2.0 * minor_intensity

    return Vec3 {
        x: angle_x + fudge_x,
        y: angle_y + fudge_y,
        z: angle_z + fudge_z,
    }
}

// Helper to generate random seed from shaker
fn random_seed_x(shaker: CameraShaker): i32 {
    return (shaker.elapsed_time * 12345.0) as i32
}

fn random_seed_y(shaker: CameraShaker): i32 {
    return (shaker.elapsed_time * 23456.0) as i32
}

fn random_seed_z(shaker: CameraShaker): i32 {
    return (shaker.elapsed_time * 34567.0) as i32
}

// Compute combined shake angles from all active shakers
fn update_camera_shaker(system: CameraShakeSystem, camera_position: Vec3): Vec3 {
    let total_angles: Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 }

    // Accumulate effects from all active shakers
    for i in 0..system.max_shakers {
        if system.shakers[i].active {
            let angles: Vec3 = compute_shaker_rotations(system.shakers[i], camera_position)
            total_angles.x = total_angles.x + angles.x
            total_angles.y = total_angles.y + angles.y
            total_angles.z = total_angles.z + angles.z
        }
    }

    // Clamp result to max axis rotation amplitudes
    if total_angles.x > AXIS_ROTATION_X { total_angles.x = AXIS_ROTATION_X }
    if total_angles.x < -AXIS_ROTATION_X { total_angles.x = -AXIS_ROTATION_X }
    if total_angles.y > AXIS_ROTATION_Y { total_angles.y = AXIS_ROTATION_Y }
    if total_angles.y < -AXIS_ROTATION_Y { total_angles.y = -AXIS_ROTATION_Y }
    if total_angles.z > AXIS_ROTATION_Z { total_angles.z = AXIS_ROTATION_Z }
    if total_angles.z < -AXIS_ROTATION_Z { total_angles.z = -AXIS_ROTATION_Z }

    return total_angles
}

// Check if any shakes are currently active
fn is_camera_shaking(system: CameraShakeSystem): bool {
    for i in 0..system.max_shakers {
        if system.shakers[i].active {
            return true
        }
    }
    return false
}

// Apply shake rotations to camera (using rotation rather than translation)
fn apply_shake_to_camera(camera: Camera, shake_angles: Vec3) {
    // Apply as rotation offset (more effective than position offset per original artists)
    // Pitch (X) and Roll (Z) affect the up vector, Yaw (Y) affects the look direction
    let pitch_offset: f32 = shake_angles.x
    let yaw_offset: f32 = shake_angles.y
    let roll_offset: f32 = shake_angles.z

    // Modify the smooth position slightly based on angles (simplified translation fallback)
    // In a full implementation this would rotate the view matrix
    let shake_dist: f32 = camera.distance * 0.02  // Scale shake with camera distance
    camera.smooth_position.x = camera.smooth_position.x + sin(yaw_offset) * shake_dist
    camera.smooth_position.y = camera.smooth_position.y + sin(pitch_offset) * shake_dist
    camera.smooth_position.z = camera.smooth_position.z + sin(roll_offset) * shake_dist * 0.5
}

// Legacy simple shake for backwards compatibility
struct CameraShake {
    intensity: f32,
    duration: f32,
    remaining: f32,
    frequency: f32,
    offset_x: f32,
    offset_y: f32,
    offset_z: f32,
}

fn create_camera_shake(intensity: f32, duration: f32): CameraShake {
    return CameraShake {
        intensity: intensity,
        duration: duration,
        remaining: duration,
        frequency: 10.0,
        offset_x: 0.0,
        offset_y: 0.0,
        offset_z: 0.0,
    }
}

fn update_camera_shake(shake: CameraShake, delta_time: f32, time: f32) {
    if shake.remaining <= 0.0 {
        shake.offset_x = 0.0
        shake.offset_y = 0.0
        shake.offset_z = 0.0
        return
    }

    shake.remaining = shake.remaining - delta_time

    let decay: f32 = shake.remaining / shake.duration
    let current_intensity: f32 = shake.intensity * decay

    shake.offset_x = sin(time * shake.frequency * 17.0) * current_intensity
    shake.offset_y = sin(time * shake.frequency * 23.0) * current_intensity * 0.5
    shake.offset_z = sin(time * shake.frequency * 19.0) * current_intensity
}

fn apply_simple_shake_to_camera(camera: Camera, shake: CameraShake) {
    camera.smooth_position.x = camera.smooth_position.x + shake.offset_x
    camera.smooth_position.y = camera.smooth_position.y + shake.offset_y
    camera.smooth_position.z = camera.smooth_position.z + shake.offset_z
}

// ============================================================================
// CINEMATIC CAMERA
// ============================================================================

struct CameraKeyframe {
    position: Vec3,
    target: Vec3,
    fov: f32,
    time: f32,
    ease_type: i32,      // 0=linear, 1=ease-in, 2=ease-out, 3=ease-in-out
}

struct CinematicCamera {
    keyframes: [CameraKeyframe],
    keyframe_count: i32,
    current_time: f32,
    total_duration: f32,
    is_playing: bool,
    is_looping: bool,
}

fn create_cinematic_camera(): CinematicCamera {
    let kfs: [CameraKeyframe] = []
    for i in 0..32 {
        kfs = kfs + [CameraKeyframe {
            position: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
            target: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
            fov: 45.0,
            time: 0.0,
            ease_type: 0,
        }]
    }
    return CinematicCamera {
        keyframes: kfs,
        keyframe_count: 0,
        current_time: 0.0,
        total_duration: 0.0,
        is_playing: false,
        is_looping: false,
    }
}

fn add_keyframe(cc: CinematicCamera, keyframe: CameraKeyframe) {
    if cc.keyframe_count < 32 {
        cc.keyframes[cc.keyframe_count] = keyframe
        cc.keyframe_count = cc.keyframe_count + 1

        if keyframe.time > cc.total_duration {
            cc.total_duration = keyframe.time
        }
    }
}

fn play_cinematic(cc: CinematicCamera) {
    cc.is_playing = true
    cc.current_time = 0.0
}

fn update_cinematic(cc: CinematicCamera, camera: Camera, delta_time: f32) {
    if !cc.is_playing || cc.keyframe_count < 2 {
        return
    }

    cc.current_time = cc.current_time + delta_time

    if cc.current_time >= cc.total_duration {
        if cc.is_looping {
            cc.current_time = 0.0
        } else {
            cc.is_playing = false
            return
        }
    }

    // Find surrounding keyframes
    let kf1_idx: i32 = 0
    let kf2_idx: i32 = 1

    for i in 0..(cc.keyframe_count - 1) {
        if cc.keyframes[i].time <= cc.current_time && cc.keyframes[i + 1].time > cc.current_time {
            kf1_idx = i
            kf2_idx = i + 1
            break
        }
    }

    let kf1: CameraKeyframe = cc.keyframes[kf1_idx]
    let kf2: CameraKeyframe = cc.keyframes[kf2_idx]

    // Calculate interpolation factor
    let segment_duration: f32 = kf2.time - kf1.time
    let t: f32 = (cc.current_time - kf1.time) / segment_duration

    // Apply easing
    let eased_t: f32 = apply_easing(t, kf2.ease_type)

    // Interpolate
    camera.position.x = kf1.position.x + (kf2.position.x - kf1.position.x) * eased_t
    camera.position.y = kf1.position.y + (kf2.position.y - kf1.position.y) * eased_t
    camera.position.z = kf1.position.z + (kf2.position.z - kf1.position.z) * eased_t

    camera.target.x = kf1.target.x + (kf2.target.x - kf1.target.x) * eased_t
    camera.target.y = kf1.target.y + (kf2.target.y - kf1.target.y) * eased_t
    camera.target.z = kf1.target.z + (kf2.target.z - kf1.target.z) * eased_t

    camera.fov = kf1.fov + (kf2.fov - kf1.fov) * eased_t

    camera.smooth_position = camera.position
    camera.smooth_target = camera.target
}

fn apply_easing(t: f32, ease_type: i32): f32 {
    if ease_type == 0 { return t }                                    // Linear
    if ease_type == 1 { return t * t }                               // Ease-in (quadratic)
    if ease_type == 2 { return t * (2.0 - t) }                       // Ease-out
    if ease_type == 3 { return t * t * (3.0 - 2.0 * t) }            // Ease-in-out (smoothstep)
    return t
}

// ============================================================================
// MATH HELPERS
// ============================================================================

fn sqrt(x: f32): f32 {
    if x <= 0.0 { return 0.0 }
    let guess: f32 = x / 2.0
    for i in 0..10 {
        guess = (guess + x / guess) / 2.0
    }
    return guess
}

fn sin(x: f32): f32 {
    let x_norm: f32 = x
    while x_norm > 3.14159 { x_norm = x_norm - 6.28318 }
    while x_norm < -3.14159 { x_norm = x_norm + 6.28318 }
    let x2: f32 = x_norm * x_norm
    let x3: f32 = x2 * x_norm
    let x5: f32 = x3 * x2
    let x7: f32 = x5 * x2
    return x_norm - x3/6.0 + x5/120.0 - x7/5040.0
}

fn cos(x: f32): f32 {
    return sin(x + 1.5708)
}

fn tan(x: f32): f32 {
    return sin(x) / cos(x)
}

fn look_at(eye: Vec3, target: Vec3, up: Vec3): Mat4 {
    let zx: f32 = eye.x - target.x
    let zy: f32 = eye.y - target.y
    let zz: f32 = eye.z - target.z
    let z_len: f32 = sqrt(zx*zx + zy*zy + zz*zz)
    if z_len > 0.0001 {
        zx = zx / z_len
        zy = zy / z_len
        zz = zz / z_len
    }

    let xx: f32 = up.y * zz - up.z * zy
    let xy: f32 = up.z * zx - up.x * zz
    let xz: f32 = up.x * zy - up.y * zx
    let x_len: f32 = sqrt(xx*xx + xy*xy + xz*xz)
    if x_len > 0.0001 {
        xx = xx / x_len
        xy = xy / x_len
        xz = xz / x_len
    }

    let yx: f32 = zy * xz - zz * xy
    let yy: f32 = zz * xx - zx * xz
    let yz: f32 = zx * xy - zy * xx

    return Mat4 {
        m: [xx, yx, zx, 0.0,
            xy, yy, zy, 0.0,
            xz, yz, zz, 0.0,
            -(xx*eye.x + xy*eye.y + xz*eye.z),
            -(yx*eye.x + yy*eye.y + yz*eye.z),
            -(zx*eye.x + zy*eye.y + zz*eye.z),
            1.0],
    }
}

fn perspective(fov_deg: f32, aspect: f32, near: f32, far: f32): Mat4 {
    let f: f32 = 1.0 / tan(fov_deg * 0.5 * 0.0174533)
    let nf: f32 = 1.0 / (near - far)

    return Mat4 {
        m: [f / aspect, 0.0, 0.0, 0.0,
            0.0, f, 0.0, 0.0,
            0.0, 0.0, (far + near) * nf, -1.0,
            0.0, 0.0, 2.0 * far * near * nf, 0.0],
    }
}

fn mat4_mul_vec4(m: Mat4, v: Vec4): Vec4 {
    return Vec4 {
        x: m.m[0]*v.x + m.m[4]*v.y + m.m[8]*v.z + m.m[12]*v.w,
        y: m.m[1]*v.x + m.m[5]*v.y + m.m[9]*v.z + m.m[13]*v.w,
        z: m.m[2]*v.x + m.m[6]*v.y + m.m[10]*v.z + m.m[14]*v.w,
        w: m.m[3]*v.x + m.m[7]*v.y + m.m[11]*v.z + m.m[15]*v.w,
    }
}

// ============================================================================
// WAYPOINT PATH CAMERA
// Camera movement along a defined path of waypoints
// Used for cinematics, intros, and guided camera movement
// ============================================================================

enum WaypointInterpolation {
    Linear,             // Straight line between points
    CatmullRom,         // Smooth spline through all points
    Bezier,             // Bezier curve using control points
    Hermite,            // Hermite spline with tangents
}

struct CameraWaypoint {
    // Position and orientation
    position: Vec3,
    target: Vec3,
    up: Vec3,
    fov: f32,

    // Timing
    arrive_time: f32,       // When to arrive at this waypoint
    pause_duration: f32,    // How long to pause at this waypoint

    // Interpolation hints
    tension: f32,           // For Catmull-Rom (0 = smooth, 1 = sharp)
    continuity: f32,        // For Hermite tangents
    bias: f32,              // Forward/backward bias

    // Optional control points (for Bezier)
    control_in_x: f32,
    control_in_y: f32,
    control_in_z: f32,
    control_out_x: f32,
    control_out_y: f32,
    control_out_z: f32,
    has_control_points: bool,
}

fn create_camera_waypoint(pos: Vec3, target: Vec3, time: f32): CameraWaypoint {
    return CameraWaypoint {
        position: pos,
        target: target,
        up: Vec3 { x: 0.0, y: 1.0, z: 0.0 },
        fov: 45.0,
        arrive_time: time,
        pause_duration: 0.0,
        tension: 0.5,
        continuity: 0.0,
        bias: 0.0,
        control_in_x: 0.0,
        control_in_y: 0.0,
        control_in_z: 0.0,
        control_out_x: 0.0,
        control_out_y: 0.0,
        control_out_z: 0.0,
        has_control_points: false,
    }
}

struct WaypointPath {
    waypoints: [CameraWaypoint],
    waypoint_count: i32,
    max_waypoints: i32,

    // Playback state
    current_time: f32,
    total_duration: f32,
    is_playing: bool,
    is_paused: bool,
    is_looping: bool,
    is_reversed: bool,
    playback_speed: f32,

    // Current interpolation mode
    interpolation: WaypointInterpolation,

    // Events
    on_waypoint_reached: i32,   // Callback ID (0 = none)
    on_path_complete: i32,
    last_waypoint_index: i32,

    // Smoothing
    smooth_factor: f32,
    current_position: Vec3,
    current_target: Vec3,
    current_fov: f32,
}

fn create_waypoint_path(): WaypointPath {
    let wps: [CameraWaypoint] = []
    for i in 0..64 {
        wps = wps + [create_camera_waypoint(
            Vec3 { x: 0.0, y: 0.0, z: 0.0 },
            Vec3 { x: 0.0, y: 0.0, z: 0.0 },
            0.0
        )]
    }
    return WaypointPath {
        waypoints: wps,
        waypoint_count: 0,
        max_waypoints: 64,
        current_time: 0.0,
        total_duration: 0.0,
        is_playing: false,
        is_paused: false,
        is_looping: false,
        is_reversed: false,
        playback_speed: 1.0,
        interpolation: WaypointInterpolation.CatmullRom,
        on_waypoint_reached: 0,
        on_path_complete: 0,
        last_waypoint_index: -1,
        smooth_factor: 0.1,
        current_position: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        current_target: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        current_fov: 45.0,
    }
}

// Add a waypoint to the path
fn path_add_waypoint(path: WaypointPath, wp: CameraWaypoint): bool {
    if path.waypoint_count >= path.max_waypoints {
        return false
    }

    path.waypoints[path.waypoint_count] = wp
    path.waypoint_count = path.waypoint_count + 1

    // Update total duration
    if wp.arrive_time + wp.pause_duration > path.total_duration {
        path.total_duration = wp.arrive_time + wp.pause_duration
    }

    return true
}

// Clear all waypoints
fn path_clear(path: WaypointPath) {
    path.waypoint_count = 0
    path.total_duration = 0.0
    path.current_time = 0.0
    path.is_playing = false
    path.last_waypoint_index = -1
}

// Start playing the path
fn path_play(path: WaypointPath) {
    if path.waypoint_count < 2 {
        return  // Need at least 2 waypoints
    }
    path.is_playing = true
    path.is_paused = false
    path.current_time = 0.0
    path.last_waypoint_index = -1

    // Initialize current values to first waypoint
    path.current_position = path.waypoints[0].position
    path.current_target = path.waypoints[0].target
    path.current_fov = path.waypoints[0].fov
}

// Pause playback
fn path_pause(path: WaypointPath) {
    path.is_paused = true
}

// Resume playback
fn path_resume(path: WaypointPath) {
    path.is_paused = false
}

// Stop playback
fn path_stop(path: WaypointPath) {
    path.is_playing = false
    path.is_paused = false
}

// Set playback speed
fn path_set_speed(path: WaypointPath, speed: f32) {
    path.playback_speed = speed
}

// Jump to specific time
fn path_seek(path: WaypointPath, time: f32) {
    path.current_time = time
    if path.current_time < 0.0 {
        path.current_time = 0.0
    }
    if path.current_time > path.total_duration {
        path.current_time = path.total_duration
    }
}

// Catmull-Rom spline interpolation
fn catmull_rom_interp(p0: f32, p1: f32, p2: f32, p3: f32, t: f32, tension: f32): f32 {
    let t2: f32 = t * t
    let t3: f32 = t2 * t
    let s: f32 = (1.0 - tension) / 2.0

    let a0: f32 = -s * p0 + (2.0 - s) * p1 + (s - 2.0) * p2 + s * p3
    let a1: f32 = 2.0 * s * p0 + (s - 3.0) * p1 + (3.0 - 2.0 * s) * p2 - s * p3
    let a2: f32 = -s * p0 + s * p2
    let a3: f32 = p1

    return a0 * t3 + a1 * t2 + a2 * t + a3
}

// Interpolate Vec3 using Catmull-Rom
fn catmull_rom_vec3(p0: Vec3, p1: Vec3, p2: Vec3, p3: Vec3, t: f32, tension: f32): Vec3 {
    return Vec3 {
        x: catmull_rom_interp(p0.x, p1.x, p2.x, p3.x, t, tension),
        y: catmull_rom_interp(p0.y, p1.y, p2.y, p3.y, t, tension),
        z: catmull_rom_interp(p0.z, p1.z, p2.z, p3.z, t, tension),
    }
}

// Linear interpolation
fn lerp_f32(a: f32, b: f32, t: f32): f32 {
    return a + (b - a) * t
}

fn lerp_vec3(a: Vec3, b: Vec3, t: f32): Vec3 {
    return Vec3 {
        x: lerp_f32(a.x, b.x, t),
        y: lerp_f32(a.y, b.y, t),
        z: lerp_f32(a.z, b.z, t),
    }
}

// Find current waypoint segment
fn path_find_segment(path: WaypointPath): (i32, i32, f32) {
    // Returns: (start_index, end_index, segment_t)
    if path.waypoint_count < 2 {
        return (0, 0, 0.0)
    }

    let time: f32 = path.current_time
    if path.is_reversed {
        time = path.total_duration - time
    }

    // Find the segment we're in
    for i in 0..(path.waypoint_count - 1) {
        let wp1: CameraWaypoint = path.waypoints[i]
        let wp2: CameraWaypoint = path.waypoints[i + 1]

        let t1: f32 = wp1.arrive_time + wp1.pause_duration
        let t2: f32 = wp2.arrive_time

        if time >= wp1.arrive_time && time < t1 {
            // In pause at waypoint i
            return (i, i, 0.0)
        }

        if time >= t1 && time <= t2 {
            // Moving between waypoint i and i+1
            let segment_duration: f32 = t2 - t1
            let segment_t: f32 = 0.0
            if segment_duration > 0.001 {
                segment_t = (time - t1) / segment_duration
            }
            return (i, i + 1, segment_t)
        }
    }

    // Past the last waypoint
    return (path.waypoint_count - 1, path.waypoint_count - 1, 1.0)
}

// Update path playback
fn path_update(path: WaypointPath, delta_time: f32) {
    if !path.is_playing || path.is_paused {
        return
    }

    if path.waypoint_count < 2 {
        return
    }

    // Advance time
    let dt: f32 = delta_time * path.playback_speed
    if path.is_reversed {
        path.current_time = path.current_time - dt
    } else {
        path.current_time = path.current_time + dt
    }

    // Check bounds
    if path.current_time >= path.total_duration {
        if path.is_looping {
            path.current_time = 0.0
            path.last_waypoint_index = -1
        } else {
            path.current_time = path.total_duration
            path.is_playing = false
            // Trigger completion callback here if needed
        }
    }
    if path.current_time < 0.0 {
        if path.is_looping {
            path.current_time = path.total_duration
            path.last_waypoint_index = -1
        } else {
            path.current_time = 0.0
            path.is_playing = false
        }
    }

    // Find current segment
    let segment: (i32, i32, f32) = path_find_segment(path)
    let i0: i32 = segment.0
    let i1: i32 = segment.1
    let t: f32 = segment.2

    // Check for waypoint reached event
    if i1 != path.last_waypoint_index && i0 == i1 {
        path.last_waypoint_index = i1
        // Trigger waypoint callback here if needed
    }

    // Interpolate camera values
    if i0 == i1 {
        // At a waypoint (possibly paused)
        path.current_position = path.waypoints[i0].position
        path.current_target = path.waypoints[i0].target
        path.current_fov = path.waypoints[i0].fov
    } else {
        // Between waypoints
        let wp1: CameraWaypoint = path.waypoints[i0]
        let wp2: CameraWaypoint = path.waypoints[i1]

        if path.interpolation == WaypointInterpolation.Linear {
            path.current_position = lerp_vec3(wp1.position, wp2.position, t)
            path.current_target = lerp_vec3(wp1.target, wp2.target, t)
            path.current_fov = lerp_f32(wp1.fov, wp2.fov, t)
        } else if path.interpolation == WaypointInterpolation.CatmullRom {
            // Get 4 control points for spline
            let i_prev: i32 = i0 - 1
            let i_next: i32 = i1 + 1
            if i_prev < 0 { i_prev = 0 }
            if i_next >= path.waypoint_count { i_next = path.waypoint_count - 1 }

            let p0: Vec3 = path.waypoints[i_prev].position
            let p1: Vec3 = wp1.position
            let p2: Vec3 = wp2.position
            let p3: Vec3 = path.waypoints[i_next].position

            let tension: f32 = (wp1.tension + wp2.tension) / 2.0
            path.current_position = catmull_rom_vec3(p0, p1, p2, p3, t, tension)

            // Also interpolate target with spline
            let t0: Vec3 = path.waypoints[i_prev].target
            let t1: Vec3 = wp1.target
            let t2: Vec3 = wp2.target
            let t3: Vec3 = path.waypoints[i_next].target
            path.current_target = catmull_rom_vec3(t0, t1, t2, t3, t, tension)

            path.current_fov = lerp_f32(wp1.fov, wp2.fov, t)
        } else {
            // Default to linear
            path.current_position = lerp_vec3(wp1.position, wp2.position, t)
            path.current_target = lerp_vec3(wp1.target, wp2.target, t)
            path.current_fov = lerp_f32(wp1.fov, wp2.fov, t)
        }
    }
}

// Apply path to camera
fn path_apply_to_camera(path: WaypointPath, camera: Camera) {
    camera.position = path.current_position
    camera.target = path.current_target
    camera.fov = path.current_fov

    // Update derived camera values
    camera.smooth_position = camera.position
    camera.smooth_target = camera.target
}

// Get current progress (0.0 - 1.0)
fn path_get_progress(path: WaypointPath): f32 {
    if path.total_duration <= 0.0 {
        return 0.0
    }
    return path.current_time / path.total_duration
}

// Check if path is complete
fn path_is_complete(path: WaypointPath): bool {
    return !path.is_playing && path.current_time >= path.total_duration
}

// Create a circular path around a center point
fn path_create_orbit(path: WaypointPath, center: Vec3, radius: f32, height: f32,
                     num_points: i32, duration: f32) {
    path_clear(path)

    let angle_step: f32 = 6.28318 / (num_points as f32)  // 2*PI
    let time_step: f32 = duration / (num_points as f32)

    for i in 0..num_points {
        let angle: f32 = (i as f32) * angle_step
        let pos: Vec3 = Vec3 {
            x: center.x + cos(angle) * radius,
            y: center.y + height,
            z: center.z + sin(angle) * radius,
        }
        let wp: CameraWaypoint = create_camera_waypoint(pos, center, (i as f32) * time_step)
        path_add_waypoint(path, wp)
    }

    // Add final point to close the loop
    let final_wp: CameraWaypoint = create_camera_waypoint(
        path.waypoints[0].position,
        center,
        duration
    )
    path_add_waypoint(path, final_wp)

    path.is_looping = true
}

// Create a fly-by path between two points
fn path_create_flyby(path: WaypointPath, start: Vec3, end: Vec3, target: Vec3,
                     height_curve: f32, duration: f32) {
    path_clear(path)

    // Start waypoint
    let wp1: CameraWaypoint = create_camera_waypoint(
        Vec3 { x: start.x, y: start.y + height_curve * 0.5, z: start.z },
        target,
        0.0
    )
    path_add_waypoint(path, wp1)

    // Midpoint (higher)
    let mid: Vec3 = Vec3 {
        x: (start.x + end.x) / 2.0,
        y: (start.y + end.y) / 2.0 + height_curve,
        z: (start.z + end.z) / 2.0,
    }
    let wp2: CameraWaypoint = create_camera_waypoint(mid, target, duration / 2.0)
    path_add_waypoint(path, wp2)

    // End waypoint
    let wp3: CameraWaypoint = create_camera_waypoint(
        Vec3 { x: end.x, y: end.y + height_curve * 0.5, z: end.z },
        target,
        duration
    )
    path_add_waypoint(path, wp3)
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

fn test_camera_system() {
    print("Testing Camera System...")

    // Create camera
    let camera: Camera = create_camera()
    set_camera_defaults_generals(camera)
    print("Camera created at: " + str(camera.position.x) + "," + str(camera.position.y) + "," + str(camera.position.z))
    print("Pitch: " + str(camera.pitch) + ", Yaw: " + str(camera.yaw))

    // Test pan
    pan_camera(camera, 1.0, 0.0, 0.016)
    print("After pan right: target=" + str(camera.target.x) + "," + str(camera.target.z))

    // Test zoom
    zoom_camera(camera, 1.0, 0.016)
    print("After zoom in: distance=" + str(camera.distance))

    // Test rotate
    rotate_camera(camera, 1.0, 0.0, 0.016)
    print("After rotate: yaw=" + str(camera.yaw))

    // Test center
    center_on_position(camera, 500.0, 500.0)
    print("Centered on 500,500: target=" + str(camera.target.x) + "," + str(camera.target.z))

    // Test screen to world
    let world_pos: Vec3 = screen_to_world(camera, 400.0, 300.0, 800.0, 600.0, 0.0)
    print("Screen center to world: " + str(world_pos.x) + "," + str(world_pos.z))

    // Test world to screen
    let screen_pos: [f32] = world_to_screen(camera, Vec3 { x: 500.0, y: 0.0, z: 500.0 }, 800.0, 600.0)
    print("World 500,500 to screen: " + str(screen_pos[0]) + "," + str(screen_pos[1]))

    // Test shake
    let shake: CameraShake = create_camera_shake(5.0, 1.0)
    update_camera_shake(shake, 0.1, 0.5)
    print("Shake offset: " + str(shake.offset_x) + "," + str(shake.offset_y))

    // Test cinematic
    let cinematic: CinematicCamera = create_cinematic_camera()
    add_keyframe(cinematic, CameraKeyframe {
        position: Vec3 { x: 0.0, y: 100.0, z: 0.0 },
        target: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        fov: 45.0,
        time: 0.0,
        ease_type: 0,
    })
    add_keyframe(cinematic, CameraKeyframe {
        position: Vec3 { x: 100.0, y: 50.0, z: 100.0 },
        target: Vec3 { x: 50.0, y: 0.0, z: 50.0 },
        fov: 60.0,
        time: 5.0,
        ease_type: 3,
    })
    print("Cinematic keyframes: " + str(cinematic.keyframe_count))
    print("Cinematic duration: " + str(cinematic.total_duration) + "s")

    // Test bounds
    let bounds: CameraBounds = CameraBounds {
        min_x: 0.0,
        max_x: 1000.0,
        min_z: 0.0,
        max_z: 1000.0,
    }
    camera.target.x = -100.0
    clamp_camera_to_bounds(camera, bounds)
    print("After bounds clamp: target.x=" + str(camera.target.x))

    print("Camera System tests complete!")
}
