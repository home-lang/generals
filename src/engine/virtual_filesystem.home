// ============================================================================
// GLOBAL FILE SYSTEM INSTANCE
// ============================================================================
let mut g_virtual_filesystem = VirtualFileSystem.init()

// ============================================================================
// PUBLIC API
// ============================================================================

export fn vfs_initialize(game_data_path: string): bool {
    return g_virtual_filesystem.initialize(game_data_path)
}

export fn vfs_shutdown() {
    g_virtual_filesystem.shutdown()
}

export fn vfs_load_archive(archive_path: string): bool {
    return g_virtual_filesystem.load_archive(archive_path, 0)
}

export fn vfs_open_file(filename: string, access: i32): ?VirtualFile {
    return g_virtual_filesystem.open_file(filename, access, FILE_BUFFERSIZE)
}

export fn vfs_file_exists(filename: string): bool {
    return g_virtual_filesystem.does_file_exist(filename)
}

export fn vfs_get_file_info(filename: string): FileInfo {
    return g_virtual_filesystem.get_file_info(filename)
}

export fn vfs_add_search_path(path: string): bool {
    return g_virtual_filesystem.add_search_path(path)
}

export fn vfs_set_write_directory(path: string) {
    g_virtual_filesystem.set_write_directory(path)
}

export fn vfs_create_mod_instance(name: string, priority: i32): i32 {
    return g_virtual_filesystem.create_instance(name, priority)
}
