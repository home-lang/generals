// Terrain Renderer - Renders heightmap terrain with texturing
// Implements the C&C Generals terrain system with tile-based texturing

// ============================================================================
// Vector Types (local definitions)
// ============================================================================

struct Vec2 {
    x: f32,
    y: f32,
}

impl Vec2 {
    fn init(x: f32, y: f32): Vec2 {
        return Vec2 { x: x, y: y }
    }
}

struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(x: f32, y: f32, z: f32): Vec3 {
        return Vec3 { x: x, y: y, z: z }
    }

    fn normalized(&self): Vec3 {
        let len = sqrt_f32(self.x * self.x + self.y * self.y + self.z * self.z)
        if len > 0.001 {
            return Vec3 { x: self.x / len, y: self.y / len, z: self.z / len }
        }
        return Vec3 { x: 0.0, y: 0.0, z: 1.0 }
    }
}

struct Vec4 {
    x: f32,
    y: f32,
    z: f32,
    w: f32,
}

impl Vec4 {
    fn init(x: f32, y: f32, z: f32, w: f32): Vec4 {
        return Vec4 { x: x, y: y, z: z, w: w }
    }
}

// ============================================================================
// Terrain Types
// ============================================================================

enum TerrainBlendType {
    NONE,
    ALPHA,
    ADDITIVE,
    MULTIPLY,
}

struct TerrainTile {
    texture_name: string,
    normal_map: string,
    blend_type: TerrainBlendType,
    tile_size: f32,
    uv_scale: f32,
    is_passable: bool,
    movement_cost: f32,
}

impl TerrainTile {
    fn init(): TerrainTile {
        return TerrainTile {
            texture_name: "",
            normal_map: "",
            blend_type: TerrainBlendType::ALPHA,
            tile_size: 1.0,
            uv_scale: 1.0,
            is_passable: true,
            movement_cost: 1.0,
        }
    }
}

struct TerrainVertex {
    position: Vec3,
    normal: Vec3,
    uv: Vec2,
    uv2: Vec2,
    blend: Vec4,
    color: Vec4,
}

impl TerrainVertex {
    fn init(): TerrainVertex {
        return TerrainVertex {
            position: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
            normal: Vec3 { x: 0.0, y: 0.0, z: 1.0 },
            uv: Vec2 { x: 0.0, y: 0.0 },
            uv2: Vec2 { x: 0.0, y: 0.0 },
            blend: Vec4 { x: 1.0, y: 0.0, z: 0.0, w: 0.0 },
            color: Vec4 { x: 1.0, y: 1.0, z: 1.0, w: 1.0 },
        }
    }
}

// ============================================================================
// Terrain Chunk
// ============================================================================

let MAX_CHUNK_VERTICES: i32 = 1089  // 33x33
let MAX_CHUNK_INDICES: i32 = 6144   // 32x32x6

struct TerrainChunk {
    vertices: [TerrainVertex],
    vertex_count: i32,
    indices: [i32],
    index_count: i32,
    min_x: f32,
    min_y: f32,
    min_z: f32,
    max_x: f32,
    max_y: f32,
    max_z: f32,
    vertex_buffer: i32,
    index_buffer: i32,
    texture_indices: [i32],
    texture_count: i32,
    lod_level: i32,
    distance_to_camera: f32,
    is_visible: bool,
    needs_rebuild: bool,
    is_uploaded: bool,
}

impl TerrainChunk {
    fn init(): TerrainChunk {
        return TerrainChunk {
            vertices: [],
            vertex_count: 0,
            indices: [],
            index_count: 0,
            min_x: 0.0,
            min_y: 0.0,
            min_z: 0.0,
            max_x: 0.0,
            max_y: 0.0,
            max_z: 0.0,
            vertex_buffer: 0,
            index_buffer: 0,
            texture_indices: [0, 0, 0, 0],
            texture_count: 0,
            lod_level: 0,
            distance_to_camera: 0.0,
            is_visible: false,
            needs_rebuild: true,
            is_uploaded: false,
        }
    }
}

// ============================================================================
// Water Plane
// ============================================================================

struct WaterPlane {
    position: Vec3,
    size_x: f32,
    size_y: f32,
    height: f32,
    flow_direction: Vec2,
    flow_speed: f32,
    wave_amplitude: f32,
    wave_frequency: f32,
    color: Vec4,
    transparency: f32,
    vertex_buffer: i32,
    index_buffer: i32,
    is_valid: bool,
}

impl WaterPlane {
    fn init(): WaterPlane {
        return WaterPlane {
            position: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
            size_x: 0.0,
            size_y: 0.0,
            height: 0.0,
            flow_direction: Vec2 { x: 1.0, y: 0.0 },
            flow_speed: 0.1,
            wave_amplitude: 0.5,
            wave_frequency: 2.0,
            color: Vec4 { x: 0.2, y: 0.4, z: 0.8, w: 0.7 },
            transparency: 0.7,
            vertex_buffer: 0,
            index_buffer: 0,
            is_valid: false,
        }
    }
}

// ============================================================================
// Constants
// ============================================================================

let MAX_CHUNKS: i32 = 256
let CHUNK_SIZE: i32 = 32
let MAX_TEXTURES: i32 = 64
let MAX_WATER_PLANES: i32 = 16
let MAX_LOD_LEVELS: i32 = 4

// ============================================================================
// Terrain Renderer
// ============================================================================

struct TerrainRenderer {
    // Heightmap data
    heightmap: [f32],
    width: i32,
    height: i32,
    cell_size: f32,

    // Texture painting
    texture_map: [i32],
    blend_map: [Vec4],

    // Chunks
    chunks: [TerrainChunk],
    chunk_count: i32,
    chunks_x: i32,
    chunks_y: i32,

    // Textures
    terrain_tiles: [TerrainTile],
    tile_count: i32,
    texture_handles: [i32],

    // Water
    water_planes: [WaterPlane],
    water_count: i32,
    water_time: f32,

    // Rendering state
    device: i32,
    terrain_pipeline: i32,
    water_pipeline: i32,

    // Camera for culling
    camera_position: Vec3,
    camera_frustum: [Vec4],

    // Settings
    enable_shadows: bool,
    enable_detail_texture: bool,
    lod_distances: [f32],

    // Stats
    visible_chunks: i32,
    triangles_rendered: i32,
}

impl TerrainRenderer {
    fn init(width: i32, height: i32, cell_size: f32): TerrainRenderer {
        let map_size = width * height

        // Initialize heightmap
        let heightmap: [f32] = []
        for i in 0..map_size {
            heightmap = heightmap + [0.0]
        }

        // Initialize texture map
        let texture_map: [i32] = []
        for i in 0..map_size {
            texture_map = texture_map + [0]
        }

        // Initialize blend map
        let blend_map: [Vec4] = []
        for i in 0..map_size {
            blend_map = blend_map + [Vec4 { x: 1.0, y: 0.0, z: 0.0, w: 0.0 }]
        }

        // Initialize chunks
        let chunks: [TerrainChunk] = []
        for i in 0..MAX_CHUNKS {
            chunks = chunks + [TerrainChunk::init()]
        }

        // Initialize tiles
        let tiles: [TerrainTile] = []
        for i in 0..MAX_TEXTURES {
            tiles = tiles + [TerrainTile::init()]
        }

        // Initialize texture handles
        let handles: [i32] = []
        for i in 0..MAX_TEXTURES {
            handles = handles + [0]
        }

        // Initialize water planes
        let water: [WaterPlane] = []
        for i in 0..MAX_WATER_PLANES {
            water = water + [WaterPlane::init()]
        }

        // Initialize frustum
        let frustum: [Vec4] = []
        for i in 0..6 {
            frustum = frustum + [Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }]
        }

        // Initialize LOD distances
        let lod_dist: [f32] = [100.0, 200.0, 400.0, 800.0]

        let renderer = TerrainRenderer {
            heightmap: heightmap,
            width: width,
            height: height,
            cell_size: cell_size,
            texture_map: texture_map,
            blend_map: blend_map,
            chunks: chunks,
            chunk_count: 0,
            chunks_x: (width + CHUNK_SIZE - 1) / CHUNK_SIZE,
            chunks_y: (height + CHUNK_SIZE - 1) / CHUNK_SIZE,
            terrain_tiles: tiles,
            tile_count: 0,
            texture_handles: handles,
            water_planes: water,
            water_count: 0,
            water_time: 0.0,
            device: 0,
            terrain_pipeline: 0,
            water_pipeline: 0,
            camera_position: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
            camera_frustum: frustum,
            enable_shadows: true,
            enable_detail_texture: true,
            lod_distances: lod_dist,
            visible_chunks: 0,
            triangles_rendered: 0,
        }

        renderer.build_chunks()
        return renderer
    }

    fn load_heightmap(&self, data: [f32]) {
        let expected_size = self.width * self.height
        let data_len = data.length

        let limit = expected_size
        if data_len < limit {
            limit = data_len
        }

        for i in 0..limit {
            self.heightmap[i] = data[i]
        }

        self.rebuild_all_chunks()
    }

    fn load_texture_map(&self, data: [i32]) {
        let expected_size = self.width * self.height
        let data_len = data.length

        let limit = expected_size
        if data_len < limit {
            limit = data_len
        }

        for i in 0..limit {
            self.texture_map[i] = data[i]
        }

        self.rebuild_all_chunks()
    }

    fn load_blend_map(&self, data: [Vec4]) {
        let expected_size = self.width * self.height
        let data_len = data.length

        let limit = expected_size
        if data_len < limit {
            limit = data_len
        }

        for i in 0..limit {
            self.blend_map[i] = data[i]
        }

        self.rebuild_all_chunks()
    }

    fn add_tile(&self, name: string, texture: string): i32 {
        if self.tile_count >= MAX_TEXTURES {
            return 0
        }

        let idx = self.tile_count
        self.terrain_tiles[idx] = TerrainTile {
            texture_name: texture,
            normal_map: "",
            blend_type: TerrainBlendType::ALPHA,
            tile_size: 1.0,
            uv_scale: 1.0,
            is_passable: true,
            movement_cost: 1.0,
        }

        self.tile_count = self.tile_count + 1
        return self.tile_count - 1
    }

    fn build_chunks(&self) {
        self.chunk_count = 0

        for cy in 0..self.chunks_y {
            for cx in 0..self.chunks_x {
                if self.chunk_count >= MAX_CHUNKS {
                    break
                }

                let chunk_idx = self.chunk_count
                self.chunks[chunk_idx] = TerrainChunk::init()

                let start_x = cx * CHUNK_SIZE
                let start_y = cy * CHUNK_SIZE
                let end_x = (cx + 1) * CHUNK_SIZE
                let end_y = (cy + 1) * CHUNK_SIZE

                if end_x > self.width { end_x = self.width }
                if end_y > self.height { end_y = self.height }

                self.build_chunk_geometry(chunk_idx, start_x, start_y, end_x, end_y)

                self.chunk_count = self.chunk_count + 1
            }
        }
    }

    fn build_chunk_geometry(&self, chunk_idx: i32, start_x: i32, start_y: i32, end_x: i32, end_y: i32) {
        let chunk = self.chunks[chunk_idx]

        chunk.vertices = []
        chunk.vertex_count = 0
        chunk.indices = []
        chunk.index_count = 0

        // Initialize bounds
        chunk.min_x = 999999.0
        chunk.min_y = 999999.0
        chunk.min_z = 999999.0
        chunk.max_x = -999999.0
        chunk.max_y = -999999.0
        chunk.max_z = -999999.0

        // Build vertices
        for y in start_y..(end_y + 1) {
            for x in start_x..(end_x + 1) {
                let height = self.get_height(x, y)
                let normal = self.calculate_normal(x, y)

                let world_x = x * self.cell_size
                let world_y = y * self.cell_size

                let vertex = TerrainVertex {
                    position: Vec3 { x: world_x, y: world_y, z: height },
                    normal: normal,
                    uv: Vec2 { x: x / 8.0, y: y / 8.0 },
                    uv2: Vec2 { x: x / 32.0, y: y / 32.0 },
                    blend: self.get_blend(x, y),
                    color: Vec4 { x: 1.0, y: 1.0, z: 1.0, w: 1.0 },
                }

                // Update bounds
                if world_x < chunk.min_x { chunk.min_x = world_x }
                if world_y < chunk.min_y { chunk.min_y = world_y }
                if height < chunk.min_z { chunk.min_z = height }
                if world_x > chunk.max_x { chunk.max_x = world_x }
                if world_y > chunk.max_y { chunk.max_y = world_y }
                if height > chunk.max_z { chunk.max_z = height }

                chunk.vertices = chunk.vertices + [vertex]
                chunk.vertex_count = chunk.vertex_count + 1
            }
        }

        // Build indices (triangle list)
        let chunk_width = end_x - start_x + 1

        for y in 0..(end_y - start_y) {
            for x in 0..(end_x - start_x) {
                let base = y * chunk_width + x

                // Two triangles per quad
                chunk.indices = chunk.indices + [base]
                chunk.indices = chunk.indices + [base + chunk_width]
                chunk.indices = chunk.indices + [base + 1]

                chunk.indices = chunk.indices + [base + 1]
                chunk.indices = chunk.indices + [base + chunk_width]
                chunk.indices = chunk.indices + [base + chunk_width + 1]

                chunk.index_count = chunk.index_count + 6
            }
        }

        chunk.needs_rebuild = false
        chunk.is_uploaded = false
    }

    fn get_height(&self, x: i32, y: i32): f32 {
        let idx = y * self.width + x
        if idx >= 0 && idx < self.heightmap.length {
            return self.heightmap[idx]
        }
        return 0.0
    }

    fn calculate_normal(&self, x: i32, y: i32): Vec3 {
        let h = self.get_height(x, y)
        let hl = h
        let hr = h
        let hu = h
        let hd = h

        if x > 0 { hl = self.get_height(x - 1, y) }
        if x < self.width - 1 { hr = self.get_height(x + 1, y) }
        if y > 0 { hu = self.get_height(x, y - 1) }
        if y < self.height - 1 { hd = self.get_height(x, y + 1) }

        let dx = (hr - hl) / (2.0 * self.cell_size)
        let dy = (hd - hu) / (2.0 * self.cell_size)

        let normal = Vec3 { x: -dx, y: -dy, z: 1.0 }
        return normal.normalized()
    }

    fn get_blend(&self, x: i32, y: i32): Vec4 {
        let idx = y * self.width + x
        if idx >= 0 && idx < self.blend_map.length {
            return self.blend_map[idx]
        }
        return Vec4 { x: 1.0, y: 0.0, z: 0.0, w: 0.0 }
    }

    fn rebuild_all_chunks(&self) {
        for i in 0..self.chunk_count {
            self.chunks[i].needs_rebuild = true
        }
    }

    fn set_height(&self, x: i32, y: i32, height: f32) {
        let idx = y * self.width + x
        if idx >= 0 && idx < self.heightmap.length {
            self.heightmap[idx] = height

            let chunk_x = x / CHUNK_SIZE
            let chunk_y = y / CHUNK_SIZE
            self.mark_chunk_dirty(chunk_x, chunk_y)

            // Also mark neighbors if on edge
            if x % CHUNK_SIZE == 0 && chunk_x > 0 {
                self.mark_chunk_dirty(chunk_x - 1, chunk_y)
            }
            if x % CHUNK_SIZE == CHUNK_SIZE - 1 && chunk_x < self.chunks_x - 1 {
                self.mark_chunk_dirty(chunk_x + 1, chunk_y)
            }
            if y % CHUNK_SIZE == 0 && chunk_y > 0 {
                self.mark_chunk_dirty(chunk_x, chunk_y - 1)
            }
            if y % CHUNK_SIZE == CHUNK_SIZE - 1 && chunk_y < self.chunks_y - 1 {
                self.mark_chunk_dirty(chunk_x, chunk_y + 1)
            }
        }
    }

    fn mark_chunk_dirty(&self, chunk_x: i32, chunk_y: i32) {
        let chunk_idx = chunk_y * self.chunks_x + chunk_x
        if chunk_idx >= 0 && chunk_idx < self.chunk_count {
            self.chunks[chunk_idx].needs_rebuild = true
        }
    }

    fn add_water_plane(&self, x: f32, y: f32, size_x: f32, size_y: f32, height: f32): i32 {
        if self.water_count >= MAX_WATER_PLANES {
            return 0
        }

        let idx = self.water_count
        self.water_planes[idx] = WaterPlane {
            position: Vec3 { x: x, y: y, z: height },
            size_x: size_x,
            size_y: size_y,
            height: height,
            flow_direction: Vec2 { x: 1.0, y: 0.0 },
            flow_speed: 0.1,
            wave_amplitude: 0.5,
            wave_frequency: 2.0,
            color: Vec4 { x: 0.2, y: 0.4, z: 0.8, w: 0.7 },
            transparency: 0.7,
            vertex_buffer: 0,
            index_buffer: 0,
            is_valid: true,
        }

        self.water_count = self.water_count + 1
        return self.water_count - 1
    }

    fn update(&self, delta_time: f32) {
        self.water_time = self.water_time + delta_time

        // Rebuild dirty chunks
        for i in 0..self.chunk_count {
            if self.chunks[i].needs_rebuild {
                // Would rebuild geometry and re-upload to GPU
            }
        }
    }

    fn cull_chunks(&self) {
        self.visible_chunks = 0

        for i in 0..self.chunk_count {
            let chunk = self.chunks[i]

            // Simple frustum culling
            chunk.is_visible = self.is_box_visible(
                chunk.min_x, chunk.min_y, chunk.min_z,
                chunk.max_x, chunk.max_y, chunk.max_z
            )

            if chunk.is_visible {
                // Calculate distance for LOD
                let center_x = (chunk.min_x + chunk.max_x) / 2.0
                let center_y = (chunk.min_y + chunk.max_y) / 2.0
                let center_z = (chunk.min_z + chunk.max_z) / 2.0

                let dx = center_x - self.camera_position.x
                let dy = center_y - self.camera_position.y
                let dz = center_z - self.camera_position.z

                chunk.distance_to_camera = sqrt_f32(dx * dx + dy * dy + dz * dz)

                // Determine LOD level
                chunk.lod_level = 0
                for lod in 0..MAX_LOD_LEVELS {
                    if chunk.distance_to_camera > self.lod_distances[lod] {
                        chunk.lod_level = lod + 1
                    }
                }

                self.visible_chunks = self.visible_chunks + 1
            }
        }
    }

    fn is_box_visible(&self, min_x: f32, min_y: f32, min_z: f32, max_x: f32, max_y: f32, max_z: f32): bool {
        // Check against each frustum plane
        for plane_idx in 0..6 {
            let plane = self.camera_frustum[plane_idx]

            // Test all 8 corners of the box
            let all_outside = true

            // Corner 0: min_x, min_y, min_z
            let dist = plane.x * min_x + plane.y * min_y + plane.z * min_z + plane.w
            if dist >= 0.0 { all_outside = false }

            if all_outside {
                dist = plane.x * max_x + plane.y * min_y + plane.z * min_z + plane.w
                if dist >= 0.0 { all_outside = false }
            }

            if all_outside {
                dist = plane.x * min_x + plane.y * max_y + plane.z * min_z + plane.w
                if dist >= 0.0 { all_outside = false }
            }

            if all_outside {
                dist = plane.x * max_x + plane.y * max_y + plane.z * min_z + plane.w
                if dist >= 0.0 { all_outside = false }
            }

            if all_outside {
                dist = plane.x * min_x + plane.y * min_y + plane.z * max_z + plane.w
                if dist >= 0.0 { all_outside = false }
            }

            if all_outside {
                dist = plane.x * max_x + plane.y * min_y + plane.z * max_z + plane.w
                if dist >= 0.0 { all_outside = false }
            }

            if all_outside {
                dist = plane.x * min_x + plane.y * max_y + plane.z * max_z + plane.w
                if dist >= 0.0 { all_outside = false }
            }

            if all_outside {
                dist = plane.x * max_x + plane.y * max_y + plane.z * max_z + plane.w
                if dist >= 0.0 { all_outside = false }
            }

            if all_outside {
                return false
            }
        }

        return true
    }

    fn set_camera(&self, position: Vec3, frustum: [Vec4]) {
        self.camera_position = position
        for i in 0..6 {
            if i < frustum.length {
                self.camera_frustum[i] = frustum[i]
            }
        }
    }

    fn render(&self, command_encoder: i32) {
        self.cull_chunks()
        self.triangles_rendered = 0

        // Render terrain chunks
        for i in 0..self.chunk_count {
            let chunk = self.chunks[i]
            if chunk.is_visible {
                // Would issue draw call for this chunk
                self.triangles_rendered = self.triangles_rendered + chunk.index_count / 3
            }
        }

        // Render water
        self.render_water(command_encoder)
    }

    fn render_water(&self, command_encoder: i32) {
        for i in 0..self.water_count {
            let water = self.water_planes[i]
            if water.is_valid {
                // Would render water plane with animated UVs
            }
        }
    }

    fn get_height_at(&self, world_x: f32, world_y: f32): f32 {
        // Convert world to grid coordinates
        let grid_x = world_x / self.cell_size
        let grid_y = world_y / self.cell_size

        // Get integer and fractional parts
        let x0 = floor_f32(grid_x)
        let y0 = floor_f32(grid_y)
        let fx = grid_x - x0
        let fy = grid_y - y0

        // Bilinear interpolation
        let h00 = self.get_height(x0, y0)
        let h10 = self.get_height(x0 + 1, y0)
        let h01 = self.get_height(x0, y0 + 1)
        let h11 = self.get_height(x0 + 1, y0 + 1)

        let h0 = h00 * (1.0 - fx) + h10 * fx
        let h1 = h01 * (1.0 - fx) + h11 * fx

        return h0 * (1.0 - fy) + h1 * fy
    }

    fn get_normal_at(&self, world_x: f32, world_y: f32): Vec3 {
        let grid_x = (world_x / self.cell_size)
        let grid_y = (world_y / self.cell_size)
        return self.calculate_normal(grid_x, grid_y)
    }

    fn raycast(&self, origin: Vec3, direction: Vec3, max_dist: f32): Vec3? {
        let step_size = self.cell_size * 0.5
        let steps = (max_dist / step_size)

        let pos = origin

        for i in 0..steps {
            let terrain_height = self.get_height_at(pos.x, pos.y)

            if pos.z <= terrain_height {
                return pos
            }

            pos.x = pos.x + direction.x * step_size
            pos.y = pos.y + direction.y * step_size
            pos.z = pos.z + direction.z * step_size
        }

        return null
    }

    fn get_visible_chunk_count(&self): i32 {
        return self.visible_chunks
    }

    fn get_triangle_count(&self): i32 {
        return self.triangles_rendered
    }
}

// ============================================================================
// Helper Functions
// ============================================================================

fn sqrt_f32(x: f32): f32 {
    if x <= 0.0 { return 0.0 }
    let guess = x / 2.0
    for i in 0..10 {
        guess = (guess + x / guess) / 2.0
    }
    return guess
}

fn floor_f32(x: f32): i32 {
    let i = x
    if x < 0.0 && x != i {
        return i - 1
    }
    return i
}

// ============================================================================
// GLOBAL INSTANCE
// ============================================================================

let g_terrain_renderer: TerrainRenderer? = null

fn init_terrain_renderer(width: i32, height: i32, cell_size: f32): TerrainRenderer {
    let renderer = TerrainRenderer::init(width, height, cell_size)
    g_terrain_renderer = renderer
    return renderer
}

fn get_terrain_renderer(): TerrainRenderer? {
    return g_terrain_renderer
}

fn shutdown_terrain_renderer() {
    g_terrain_renderer = null
}
