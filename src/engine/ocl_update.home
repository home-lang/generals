// OCL Update - Object Creation List updates
// Handles spawning objects on timers, triggers, and conditions

// ============================================================================
// Configuration
// ============================================================================

struct OCLConfig {
    max_spawns_per_frame: i32,
    default_spawn_delay: f32,
    inherit_veterancy: bool,
    inherit_player: bool,
    scatter_radius: f32,
    spawn_height_offset: f32,
    check_passability: bool,
    max_spawn_attempts: i32,
}

impl OCLConfig {
    fn init(): OCLConfig {
        return OCLConfig {
            max_spawns_per_frame: 5,
            default_spawn_delay: 0.0,
            inherit_veterancy: false,
            inherit_player: true,
            scatter_radius: 0.0,
            spawn_height_offset: 0.0,
            check_passability: true,
            max_spawn_attempts: 10,
        }
    }
}

// ============================================================================
// OCL Entry Types
// ============================================================================

enum OCLTrigger {
    OnCreate,
    OnDeath,
    OnDamage,
    OnTimer,
    OnSpecialPower,
    OnProduction,
    OnUpgrade,
    OnEnterState,
    OnExitState,
    OnCommand,
    Manual,
}

enum SpawnPosition {
    AtOwner,
    AtRallyPoint,
    AtBone,
    AtOffset,
    InFormation,
    Random,
    AtTarget,
}

struct SpawnOffset {
    x: f32,
    y: f32,
    z: f32,
    rotation: f32,
}

impl SpawnOffset {
    fn init(): SpawnOffset {
        return SpawnOffset {
            x: 0.0,
            y: 0.0,
            z: 0.0,
            rotation: 0.0,
        }
    }
}

struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(): Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }
}

// ============================================================================
// OCL Entry Definition
// ============================================================================

enum ConditionType {
    None,
    HealthPercent,
    HasUpgrade,
    PlayerMoney,
    UnitCount,
    TimeOfDay,
    RandomChance,
}

enum ComparisonOp {
    Equal,
    NotEqual,
    LessThan,
    LessOrEqual,
    GreaterThan,
    GreaterOrEqual,
}

struct SpawnCondition {
    condition_type: ConditionType,
    value: f32,
    comparison: ComparisonOp,
}

impl SpawnCondition {
    fn init(): SpawnCondition {
        return SpawnCondition {
            condition_type: ConditionType::None,
            value: 0.0,
            comparison: ComparisonOp::Equal,
        }
    }
}

struct OCLEntry {
    entry_id: i64,
    object_type: string,
    count: i32,
    trigger: OCLTrigger,
    spawn_position: SpawnPosition,
    offset: SpawnOffset,
    bone_name: string,
    delay: f32,
    interval: f32,
    max_spawns: i32,
    conditions: [SpawnCondition],
    condition_count: i32,
    spawn_with_velocity: bool,
    initial_velocity: Vec3,
    spread_formation: bool,
    formation_spacing: f32,
    inherit_facing: bool,
    random_facing: bool,
}

impl OCLEntry {
    fn init(entry_id: i64, object_type: string, trigger: OCLTrigger): OCLEntry {
        let conditions: [SpawnCondition] = []
        for i in 0..4 {
            conditions = conditions + [SpawnCondition::init()]
        }
        return OCLEntry {
            entry_id: entry_id,
            object_type: object_type,
            count: 1,
            trigger: trigger,
            spawn_position: SpawnPosition::AtOwner,
            offset: SpawnOffset::init(),
            bone_name: "",
            delay: 0.0,
            interval: 0.0,
            max_spawns: 0,
            conditions: conditions,
            condition_count: 0,
            spawn_with_velocity: false,
            initial_velocity: Vec3::init(),
            spread_formation: false,
            formation_spacing: 10.0,
            inherit_facing: true,
            random_facing: false,
        }
    }
}

// ============================================================================
// Object Creation List (OCL)
// ============================================================================

struct ObjectCreationList {
    ocl_id: i64,
    name: string,
    entries: [OCLEntry],
    entry_count: i32,
    config: OCLConfig,
}

impl ObjectCreationList {
    fn init(ocl_id: i64, name: string): ObjectCreationList {
        let entries: [OCLEntry] = []
        for i in 0..16 {
            entries = entries + [OCLEntry::init(0, "", OCLTrigger::Manual)]
        }
        return ObjectCreationList {
            ocl_id: ocl_id,
            name: name,
            entries: entries,
            entry_count: 0,
            config: OCLConfig::init(),
        }
    }

    fn add_entry(&self, entry: OCLEntry): bool {
        if self.entry_count >= 16 {
            return false
        }
        self.entries[self.entry_count] = entry
        self.entry_count = self.entry_count + 1
        return true
    }
}

// ============================================================================
// OCL Instance (Active spawn tracker)
// ============================================================================

struct PendingSpawn {
    entry_index: i32,
    spawn_position: Vec3,
    spawn_facing: f32,
    spawn_velocity: Vec3,
    delay_remaining: f32,
    object_type: string,
}

impl PendingSpawn {
    fn init(): PendingSpawn {
        return PendingSpawn {
            entry_index: 0,
            spawn_position: Vec3::init(),
            spawn_facing: 0.0,
            spawn_velocity: Vec3::init(),
            delay_remaining: 0.0,
            object_type: "",
        }
    }
}

struct OCLInstance {
    instance_id: i64,
    ocl_id: i64,
    owner_id: i64,
    owner_player: i32,
    owner_position: Vec3,
    owner_facing: f32,
    owner_health_percent: f32,
    rally_point: Vec3,
    has_rally_point: bool,
    veterancy_level: i32,
    entry_spawn_counts: [i32],
    entry_timers: [f32],
    entry_delays: [f32],
    entry_enabled: [bool],
    pending_spawns: [PendingSpawn],
    pending_count: i32,
    is_active: bool,
}

impl OCLInstance {
    fn init(instance_id: i64, ocl_id: i64, owner_id: i64, owner_player: i32): OCLInstance {
        let spawn_counts: [i32] = []
        let timers: [f32] = []
        let delays: [f32] = []
        let enabled: [bool] = []
        for i in 0..16 {
            spawn_counts = spawn_counts + [0]
            timers = timers + [0.0]
            delays = delays + [0.0]
            enabled = enabled + [true]
        }
        let pending: [PendingSpawn] = []
        for i in 0..32 {
            pending = pending + [PendingSpawn::init()]
        }
        return OCLInstance {
            instance_id: instance_id,
            ocl_id: ocl_id,
            owner_id: owner_id,
            owner_player: owner_player,
            owner_position: Vec3::init(),
            owner_facing: 0.0,
            owner_health_percent: 1.0,
            rally_point: Vec3::init(),
            has_rally_point: false,
            veterancy_level: 0,
            entry_spawn_counts: spawn_counts,
            entry_timers: timers,
            entry_delays: delays,
            entry_enabled: enabled,
            pending_spawns: pending,
            pending_count: 0,
            is_active: true,
        }
    }
}

// ============================================================================
// OCL Update Module
// ============================================================================

struct SpawnedObject {
    object_id: i64,
    object_type: string,
    position: Vec3,
    facing: f32,
    velocity: Vec3,
    owner_player: i32,
    veterancy: i32,
    source_instance_id: i64,
}

impl SpawnedObject {
    fn init(): SpawnedObject {
        return SpawnedObject {
            object_id: 0,
            object_type: "",
            position: Vec3::init(),
            facing: 0.0,
            velocity: Vec3::init(),
            owner_player: 0,
            veterancy: 0,
            source_instance_id: 0,
        }
    }
}

struct OCLUpdateModule {
    ocl_definitions: [ObjectCreationList],
    ocl_definition_count: i32,
    ocl_name_map: [string],
    ocl_id_map: [i64],
    instances: [OCLInstance],
    instance_count: i32,
    next_ocl_id: i64,
    next_instance_id: i64,
    spawned_objects: [SpawnedObject],
    spawned_count: i32,
}

impl OCLUpdateModule {
    fn init(): OCLUpdateModule {
        let definitions: [ObjectCreationList] = []
        for i in 0..256 {
            definitions = definitions + [ObjectCreationList::init(0, "")]
        }
        let names: [string] = []
        let ids: [i64] = []
        for i in 0..256 {
            names = names + [""]
            ids = ids + [0]
        }
        let instances: [OCLInstance] = []
        for i in 0..512 {
            instances = instances + [OCLInstance::init(0, 0, 0, 0)]
        }
        let spawned: [SpawnedObject] = []
        for i in 0..64 {
            spawned = spawned + [SpawnedObject::init()]
        }
        return OCLUpdateModule {
            ocl_definitions: definitions,
            ocl_definition_count: 0,
            ocl_name_map: names,
            ocl_id_map: ids,
            instances: instances,
            instance_count: 0,
            next_ocl_id: 1,
            next_instance_id: 1,
            spawned_objects: spawned,
            spawned_count: 0,
        }
    }

    fn register_ocl(&self, ocl: ObjectCreationList): i64 {
        if self.ocl_definition_count >= 256 {
            return 0
        }
        let id = self.next_ocl_id
        self.next_ocl_id = self.next_ocl_id + 1

        let idx = self.ocl_definition_count
        self.ocl_definitions[idx] = ocl
        self.ocl_definitions[idx].ocl_id = id
        self.ocl_name_map[idx] = ocl.name
        self.ocl_id_map[idx] = id
        self.ocl_definition_count = self.ocl_definition_count + 1

        return id
    }

    fn get_ocl_by_name(&self, name: string): ObjectCreationList? {
        for i in 0..self.ocl_definition_count {
            if self.ocl_name_map[i] == name {
                return self.ocl_definitions[i]
            }
        }
        return null
    }

    fn get_ocl_by_id(&self, ocl_id: i64): ObjectCreationList? {
        for i in 0..self.ocl_definition_count {
            if self.ocl_id_map[i] == ocl_id {
                return self.ocl_definitions[i]
            }
        }
        return null
    }

    fn create_instance(&self, ocl_id: i64, owner_id: i64, owner_player: i32): i64 {
        if self.instance_count >= 512 {
            return 0
        }
        let instance_id = self.next_instance_id
        self.next_instance_id = self.next_instance_id + 1

        let idx = self.instance_count
        self.instances[idx] = OCLInstance::init(instance_id, ocl_id, owner_id, owner_player)
        self.instance_count = self.instance_count + 1

        return instance_id
    }

    fn get_instance(&self, instance_id: i64): OCLInstance? {
        for i in 0..self.instance_count {
            if self.instances[i].instance_id == instance_id {
                return self.instances[i]
            }
        }
        return null
    }

    fn destroy_instance(&self, instance_id: i64) {
        for i in 0..self.instance_count {
            if self.instances[i].instance_id == instance_id {
                // Shift remaining instances
                for j in i..(self.instance_count - 1) {
                    self.instances[j] = self.instances[j + 1]
                }
                self.instance_count = self.instance_count - 1
                return
            }
        }
    }

    fn update_instance_owner(&self, instance_id: i64, position: Vec3, facing: f32, health_percent: f32) {
        let instance = self.get_instance(instance_id)
        if instance != null {
            instance.owner_position = position
            instance.owner_facing = facing
            instance.owner_health_percent = health_percent
        }
    }

    fn set_instance_rally_point(&self, instance_id: i64, rally_point: Vec3) {
        let instance = self.get_instance(instance_id)
        if instance != null {
            instance.rally_point = rally_point
            instance.has_rally_point = true
        }
    }

    fn set_instance_veterancy(&self, instance_id: i64, veterancy: i32) {
        let instance = self.get_instance(instance_id)
        if instance != null {
            instance.veterancy_level = veterancy
        }
    }
}

// ============================================================================
// Trigger Functions
// ============================================================================

let ocl_random_seed: i64 = 54321

fn ocl_pseudo_random(): f32 {
    ocl_random_seed = ocl_random_seed * 1103515245 + 12345
    return ((ocl_random_seed >> 16) & 0x7FFF) as f32 / 32767.0
}

fn sin_approx(x: f32): f32 {
    let x2 = x
    while x2 > 3.14159 { x2 = x2 - 6.28318 }
    while x2 < -3.14159 { x2 = x2 + 6.28318 }
    let x3 = x2 * x2 * x2
    let x5 = x3 * x2 * x2
    return x2 - x3 / 6.0 + x5 / 120.0
}

fn cos_approx(x: f32): f32 {
    return sin_approx(x + 1.5708)
}

fn check_entry_conditions(entry: OCLEntry, instance: OCLInstance): bool {
    for i in 0..entry.condition_count {
        let condition = entry.conditions[i]

        if condition.condition_type == ConditionType::None {
            continue
        }

        let value = 0.0
        if condition.condition_type == ConditionType::HealthPercent {
            value = instance.owner_health_percent * 100.0
        } else if condition.condition_type == ConditionType::RandomChance {
            value = ocl_pseudo_random() * 100.0
        }

        let passed = false
        if condition.comparison == ComparisonOp::Equal {
            passed = value == condition.value
        } else if condition.comparison == ComparisonOp::NotEqual {
            passed = value != condition.value
        } else if condition.comparison == ComparisonOp::LessThan {
            passed = value < condition.value
        } else if condition.comparison == ComparisonOp::LessOrEqual {
            passed = value <= condition.value
        } else if condition.comparison == ComparisonOp::GreaterThan {
            passed = value > condition.value
        } else if condition.comparison == ComparisonOp::GreaterOrEqual {
            passed = value >= condition.value
        }

        if !passed {
            return false
        }
    }

    return true
}

fn calculate_spawn_position(instance: OCLInstance, entry: OCLEntry, spawn_index: i32): Vec3 {
    let pos = Vec3::init()

    if entry.spawn_position == SpawnPosition::AtOwner {
        pos = instance.owner_position
    } else if entry.spawn_position == SpawnPosition::AtRallyPoint {
        if instance.has_rally_point {
            pos = instance.rally_point
        } else {
            pos = instance.owner_position
        }
    } else if entry.spawn_position == SpawnPosition::AtOffset {
        pos.x = instance.owner_position.x + entry.offset.x
        pos.y = instance.owner_position.y + entry.offset.y
        pos.z = instance.owner_position.z + entry.offset.z
    } else if entry.spawn_position == SpawnPosition::Random {
        let angle = ocl_pseudo_random() * 6.28318
        let radius = ocl_pseudo_random() * entry.offset.x
        pos.x = instance.owner_position.x + cos_approx(angle) * radius
        pos.y = instance.owner_position.y + sin_approx(angle) * radius
        pos.z = instance.owner_position.z
    } else if entry.spawn_position == SpawnPosition::InFormation {
        let row = spawn_index / 4
        let col = spawn_index % 4
        pos.x = instance.owner_position.x + col as f32 * entry.formation_spacing
        pos.y = instance.owner_position.y + row as f32 * entry.formation_spacing
        pos.z = instance.owner_position.z
    } else if entry.spawn_position == SpawnPosition::AtTarget {
        pos = instance.rally_point
    } else {
        pos = instance.owner_position
    }

    // Apply offset
    pos.x = pos.x + entry.offset.x
    pos.y = pos.y + entry.offset.y
    pos.z = pos.z + entry.offset.z

    return pos
}

fn queue_spawns(module: OCLUpdateModule, instance: OCLInstance, ocl: ObjectCreationList, entry_index: i32) {
    let entry = ocl.entries[entry_index]

    for spawn_num in 0..entry.count {
        if instance.pending_count >= 32 {
            break
        }

        let spawn_pos = calculate_spawn_position(instance, entry, spawn_num)

        let facing = 0.0
        if entry.random_facing {
            facing = ocl_pseudo_random() * 6.28318
        } else if entry.inherit_facing {
            facing = instance.owner_facing
        }

        let velocity = Vec3::init()
        if entry.spawn_with_velocity {
            velocity = entry.initial_velocity
        }

        instance.pending_spawns[instance.pending_count] = PendingSpawn {
            entry_index: entry_index,
            spawn_position: spawn_pos,
            spawn_facing: facing,
            spawn_velocity: velocity,
            delay_remaining: entry.delay,
            object_type: entry.object_type,
        }
        instance.pending_count = instance.pending_count + 1
    }
}

fn trigger_ocl(module: OCLUpdateModule, instance_id: i64, trigger: OCLTrigger) {
    let instance = module.get_instance(instance_id)
    if instance == null || !instance.is_active {
        return
    }

    let ocl = module.get_ocl_by_id(instance.ocl_id)
    if ocl == null {
        return
    }

    for i in 0..ocl.entry_count {
        let entry = ocl.entries[i]

        if entry.trigger != trigger {
            continue
        }

        if !instance.entry_enabled[i] {
            continue
        }

        if entry.max_spawns > 0 && instance.entry_spawn_counts[i] >= entry.max_spawns {
            continue
        }

        if !check_entry_conditions(entry, instance) {
            continue
        }

        queue_spawns(module, instance, ocl, i)
    }
}

// ============================================================================
// Update Loop
// ============================================================================

fn update_timer_entries(module: OCLUpdateModule, instance: OCLInstance, ocl: ObjectCreationList, delta_time: f32) {
    for i in 0..ocl.entry_count {
        let entry = ocl.entries[i]

        if entry.trigger != OCLTrigger::OnTimer {
            continue
        }

        if !instance.entry_enabled[i] {
            continue
        }

        instance.entry_timers[i] = instance.entry_timers[i] + delta_time

        if instance.entry_timers[i] >= entry.interval {
            instance.entry_timers[i] = instance.entry_timers[i] - entry.interval

            if entry.max_spawns > 0 && instance.entry_spawn_counts[i] >= entry.max_spawns {
                instance.entry_enabled[i] = false
                continue
            }

            if check_entry_conditions(entry, instance) {
                queue_spawns(module, instance, ocl, i)
            }
        }
    }
}

fn process_pending_spawns(module: OCLUpdateModule, instance: OCLInstance, delta_time: f32) {
    let spawns_this_frame = 0
    let ocl = module.get_ocl_by_id(instance.ocl_id)
    let max_per_frame = 5
    if ocl != null {
        max_per_frame = ocl.config.max_spawns_per_frame
    }

    let i = 0
    while i < instance.pending_count {
        let pending = instance.pending_spawns[i]

        pending.delay_remaining = pending.delay_remaining - delta_time

        if pending.delay_remaining <= 0.0 {
            if spawns_this_frame < max_per_frame && module.spawned_count < 64 {
                let spawn_pos = pending.spawn_position

                // Determine veterancy
                let vet = 0
                if ocl != null && ocl.config.inherit_veterancy {
                    vet = instance.veterancy_level
                }

                // Record spawned object
                module.spawned_objects[module.spawned_count] = SpawnedObject {
                    object_id: 0,
                    object_type: pending.object_type,
                    position: spawn_pos,
                    facing: pending.spawn_facing,
                    velocity: pending.spawn_velocity,
                    owner_player: instance.owner_player,
                    veterancy: vet,
                    source_instance_id: instance.instance_id,
                }
                module.spawned_count = module.spawned_count + 1

                instance.entry_spawn_counts[pending.entry_index] = instance.entry_spawn_counts[pending.entry_index] + 1

                spawns_this_frame = spawns_this_frame + 1

                // Remove from pending (shift remaining)
                for j in i..(instance.pending_count - 1) {
                    instance.pending_spawns[j] = instance.pending_spawns[j + 1]
                }
                instance.pending_count = instance.pending_count - 1
                continue
            }
        }

        i = i + 1
    }
}

fn update_ocl_module(module: OCLUpdateModule, delta_time: f32) {
    module.spawned_count = 0

    for idx in 0..module.instance_count {
        let instance = module.instances[idx]

        if !instance.is_active {
            continue
        }

        let ocl = module.get_ocl_by_id(instance.ocl_id)
        if ocl == null {
            continue
        }

        update_timer_entries(module, instance, ocl, delta_time)
        process_pending_spawns(module, instance, delta_time)
    }
}

// ============================================================================
// Pre-built OCL Definitions
// ============================================================================

fn create_infantry_death_ocl(): ObjectCreationList {
    let ocl = ObjectCreationList::init(0, "InfantryDeathOCL")

    let entry = OCLEntry::init(1, "DebrisSmall", OCLTrigger::OnDeath)
    entry.count = 3
    entry.spawn_position = SpawnPosition::AtOwner
    entry.spawn_with_velocity = true
    entry.initial_velocity = Vec3 { x: 0.0, y: 0.0, z: 50.0 }
    ocl.add_entry(entry)

    return ocl
}

fn create_vehicle_wreck_ocl(): ObjectCreationList {
    let ocl = ObjectCreationList::init(0, "VehicleWreckOCL")

    let entry1 = OCLEntry::init(1, "VehicleWreck", OCLTrigger::OnDeath)
    entry1.spawn_position = SpawnPosition::AtOwner
    entry1.inherit_facing = true
    ocl.add_entry(entry1)

    let entry2 = OCLEntry::init(2, "FireEffect", OCLTrigger::OnDeath)
    entry2.spawn_position = SpawnPosition::AtOwner
    entry2.offset.z = 5.0
    ocl.add_entry(entry2)

    return ocl
}

fn create_production_ocl(): ObjectCreationList {
    let ocl = ObjectCreationList::init(0, "ProductionOCL")
    ocl.config.check_passability = true
    ocl.config.inherit_player = true

    let entry = OCLEntry::init(1, "ProducedUnit", OCLTrigger::OnProduction)
    entry.spawn_position = SpawnPosition::AtRallyPoint
    ocl.add_entry(entry)

    return ocl
}

fn create_spawner_ocl(unit_type: string, interval: f32, max_count: i32): ObjectCreationList {
    let ocl = ObjectCreationList::init(0, "SpawnerOCL")

    let entry = OCLEntry::init(1, unit_type, OCLTrigger::OnTimer)
    entry.interval = interval
    entry.max_spawns = max_count
    entry.spawn_position = SpawnPosition::AtOffset
    entry.offset.y = 20.0
    ocl.add_entry(entry)

    return ocl
}

fn create_paradrop_ocl(unit_type: string, count: i32): ObjectCreationList {
    let ocl = ObjectCreationList::init(0, "ParadropOCL")

    let entry = OCLEntry::init(1, unit_type, OCLTrigger::OnSpecialPower)
    entry.count = count
    entry.spawn_position = SpawnPosition::InFormation
    entry.formation_spacing = 15.0
    entry.offset.z = 200.0
    entry.spawn_with_velocity = true
    entry.initial_velocity = Vec3 { x: 0.0, y: 0.0, z: -30.0 }
    ocl.add_entry(entry)

    return ocl
}

// ============================================================================
// Tests
// ============================================================================

fn test_ocl_update() {
    print("Testing OCL Update Module...")

    let module = OCLUpdateModule::init()

    let spawner_ocl = create_spawner_ocl("TestUnit", 5.0, 3)
    let ocl_id = module.register_ocl(spawner_ocl)
    print("  Registered OCL with ID: " + str(ocl_id))

    let instance_id = module.create_instance(ocl_id, 1, 0)
    print("  Created instance with ID: " + str(instance_id))

    module.update_instance_owner(instance_id, Vec3 { x: 100.0, y: 100.0, z: 0.0 }, 0.0, 1.0)

    for i in 0..10 {
        update_ocl_module(module, 1.0)
    }

    print("  Spawned objects this update: " + str(module.spawned_count))

    let death_ocl = create_infantry_death_ocl()
    let death_ocl_id = module.register_ocl(death_ocl)
    let death_instance_id = module.create_instance(death_ocl_id, 2, 0)

    trigger_ocl(module, death_instance_id, OCLTrigger::OnDeath)
    update_ocl_module(module, 0.1)

    print("  After death trigger, spawned: " + str(module.spawned_count))

    print("OCL Update tests complete!")
}
