// WND Window System - Base window types and hierarchy
// Implements the C&C Generals WND (Window) UI system

let MAX_WINDOWS: i32 = 1024
let MAX_CHILDREN: i32 = 64
let MAX_ITEMS: i32 = 64
let MAX_TABS: i32 = 16

// Window status flags
enum WindowStatus {
    Hidden,
    Enabled,
    Destroyed,
    Border,
    Image,
    NoInput,
    SeeThru,
    WrapText,
    NoFocus,
    RightClick,
    CheckLike,
    HotkeyText,
    OneLeftClick,
    OneRightClick,
    Dragable,
    TabStop,
    HotkeyBorder,
}

// Window types
enum WindowType {
    GenericWindow,
    PushButton,
    CheckBox,
    RadioButton,
    ListBox,
    ComboBox,
    HorizontalSlider,
    VerticalSlider,
    ProgressBar,
    StaticText,
    EntryField,
    ScrollListBox,
    TabControl,
    Image,
    CommandButton,
}

// Text alignment
enum TextAlignment {
    Left,
    Center,
    Right,
    Justified,
}

// Rectangle
struct WndRect {
    x: i32,
    y: i32,
    width: i32,
    height: i32,
}

impl WndRect {
    fn init(): WndRect {
        return WndRect {
            x: 0,
            y: 0,
            width: 0,
            height: 0,
        }
    }
}

// Window draw data - appearance configuration
struct WindowDrawData {
    image: string,
    color: i32,
    border_color: i32,
    enabled_color: i32,
    disabled_color: i32,
    hilite_color: i32,
    hilite_border_color: i32,
}

impl WindowDrawData {
    fn init(): WindowDrawData {
        return WindowDrawData {
            image: "",
            color: 0xFFFFFFFF,
            border_color: 0xFF808080,
            enabled_color: 0xFFFFFFFF,
            disabled_color: 0xFF808080,
            hilite_color: 0xFFFFFF00,
            hilite_border_color: 0xFFFFFF00,
        }
    }
}

// List box item
struct ListBoxItem {
    text: string,
    data: i64,
    color: i32,
    is_selected: bool,
    is_enabled: bool,
}

impl ListBoxItem {
    fn init(): ListBoxItem {
        return ListBoxItem {
            text: "",
            data: 0,
            color: 0xFFFFFFFF,
            is_selected: false,
            is_enabled: true,
        }
    }
}

// Combo box specific data
struct ComboBoxData {
    items: [ListBoxItem],
    item_count: i32,
    selected_index: i32,
    is_dropped: bool,
    drop_height: i32,
}

impl ComboBoxData {
    fn init(): ComboBoxData {
        let items: [ListBoxItem] = []
        for i in 0..MAX_ITEMS {
            items = items + [ListBoxItem::init()]
        }
        return ComboBoxData {
            items: items,
            item_count: 0,
            selected_index: -1,
            is_dropped: false,
            drop_height: 100,
        }
    }
}

// Slider specific data
struct SliderData {
    min_value: i32,
    max_value: i32,
    current_value: i32,
    thumb_size: i32,
    num_ticks: i32,
}

impl SliderData {
    fn init(): SliderData {
        return SliderData {
            min_value: 0,
            max_value: 100,
            current_value: 0,
            thumb_size: 20,
            num_ticks: 0,
        }
    }
}

// Entry field specific data
struct EntryFieldData {
    text: string,
    max_length: i32,
    cursor_pos: i32,
    selection_start: i32,
    selection_end: i32,
    is_password: bool,
    is_numeric_only: bool,
}

impl EntryFieldData {
    fn init(): EntryFieldData {
        return EntryFieldData {
            text: "",
            max_length: 256,
            cursor_pos: 0,
            selection_start: 0,
            selection_end: 0,
            is_password: false,
            is_numeric_only: false,
        }
    }
}

// Progress bar specific data
struct ProgressBarData {
    min_value: f32,
    max_value: f32,
    current_value: f32,
    bar_color: i32,
    background_color: i32,
}

impl ProgressBarData {
    fn init(): ProgressBarData {
        return ProgressBarData {
            min_value: 0.0,
            max_value: 100.0,
            current_value: 0.0,
            bar_color: 0xFF00FF00,
            background_color: 0xFF404040,
        }
    }
}

// Tab item
struct TabItem {
    text: string,
    page_window_id: i32,
    is_enabled: bool,
}

impl TabItem {
    fn init(): TabItem {
        return TabItem {
            text: "",
            page_window_id: 0,
            is_enabled: true,
        }
    }
}

// Tab control specific data
struct TabControlData {
    tabs: [TabItem],
    tab_count: i32,
    selected_tab: i32,
}

impl TabControlData {
    fn init(): TabControlData {
        let tabs: [TabItem] = []
        for i in 0..MAX_TABS {
            tabs = tabs + [TabItem::init()]
        }
        return TabControlData {
            tabs: tabs,
            tab_count: 0,
            selected_tab: 0,
        }
    }
}

// Single window element
struct WndWindow {
    // Identification
    name: string,
    window_type: WindowType,
    id: i32,

    // Hierarchy
    parent_id: i32,
    children: [i32],
    child_count: i32,

    // Position/size (screen coordinates)
    screen_rect: WndRect,

    // Relative position (percentage of parent)
    creation_rect: WndRect,

    // Status flags
    status: i32,

    // Style
    style: i32,

    // Text
    text: string,
    text_color: i32,
    font_name: string,
    font_size: i32,
    text_alignment: TextAlignment,

    // Draw data for different states
    enabled_draw: WindowDrawData,
    disabled_draw: WindowDrawData,
    hilite_draw: WindowDrawData,
    selected_draw: WindowDrawData,

    // Input state
    is_mouse_over: bool,
    is_pressed: bool,
    is_selected: bool,
    is_focused: bool,

    // User data
    user_data: i64,
    header_template: string,

    // Callbacks
    system_callback: string,
    input_callback: string,
    tooltip_callback: string,
    draw_callback: string,

    // Tooltip
    tooltip_text: string,
    tooltip_delay: i32,

    is_valid: bool,
}

impl WndWindow {
    fn init(name: string, window_type: WindowType): WndWindow {
        let children: [i32] = []
        for i in 0..MAX_CHILDREN {
            children = children + [0]
        }
        return WndWindow {
            name: name,
            window_type: window_type,
            id: 0,
            parent_id: 0,
            children: children,
            child_count: 0,
            screen_rect: WndRect::init(),
            creation_rect: WndRect::init(),
            status: 0,
            style: 0,
            text: "",
            text_color: 0xFFFFFFFF,
            font_name: "Arial",
            font_size: 12,
            text_alignment: TextAlignment::Left,
            enabled_draw: WindowDrawData::init(),
            disabled_draw: WindowDrawData::init(),
            hilite_draw: WindowDrawData::init(),
            selected_draw: WindowDrawData::init(),
            is_mouse_over: false,
            is_pressed: false,
            is_selected: false,
            is_focused: false,
            user_data: 0,
            header_template: "",
            system_callback: "",
            input_callback: "",
            tooltip_callback: "",
            draw_callback: "",
            tooltip_text: "",
            tooltip_delay: 500,
            is_valid: true,
        }
    }

    fn init_default(): WndWindow {
        return WndWindow::init("", WindowType::GenericWindow)
    }

    fn set_status(&self, status: WindowStatus, value: bool) {
        let flag = 1 << (status as i32)
        if value {
            self.status = self.status | flag
        } else {
            self.status = self.status & (!flag)
        }
    }

    fn get_status(&self, status: WindowStatus): bool {
        let flag = 1 << (status as i32)
        return (self.status & flag) != 0
    }

    fn is_hidden(&self): bool {
        return self.get_status(WindowStatus::Hidden)
    }

    fn is_enabled(&self): bool {
        return self.get_status(WindowStatus::Enabled)
    }

    fn set_hidden(&self, hidden: bool) {
        self.set_status(WindowStatus::Hidden, hidden)
    }

    fn set_enabled(&self, enabled: bool) {
        self.set_status(WindowStatus::Enabled, enabled)
    }

    fn add_child(&self, child_id: i32): bool {
        if self.child_count >= MAX_CHILDREN {
            return false
        }
        self.children[self.child_count] = child_id
        self.child_count = self.child_count + 1
        return true
    }

    fn remove_child(&self, child_id: i32): bool {
        for i in 0..self.child_count {
            if self.children[i] == child_id {
                // Shift remaining children
                for j in i..(self.child_count - 1) {
                    self.children[j] = self.children[j + 1]
                }
                self.child_count = self.child_count - 1
                return true
            }
        }
        return false
    }

    fn contains_point(&self, x: i32, y: i32): bool {
        return x >= self.screen_rect.x &&
               x < self.screen_rect.x + self.screen_rect.width &&
               y >= self.screen_rect.y &&
               y < self.screen_rect.y + self.screen_rect.height
    }

    fn get_local_x(&self, screen_x: i32): i32 {
        return screen_x - self.screen_rect.x
    }

    fn get_local_y(&self, screen_y: i32): i32 {
        return screen_y - self.screen_rect.y
    }

    fn set_text(&self, text: string) {
        self.text = text
    }

    fn get_text(&self): string {
        return self.text
    }

    fn set_rect(&self, x: i32, y: i32, width: i32, height: i32) {
        self.screen_rect.x = x
        self.screen_rect.y = y
        self.screen_rect.width = width
        self.screen_rect.height = height
    }
}

// ============================================================================
// Window Manager
// ============================================================================

struct WndWindowManager {
    windows: [WndWindow],
    window_count: i32,
    next_id: i32,

    // Root windows (no parent)
    root_windows: [i32],
    root_count: i32,

    // Focus state
    focused_window: i32,
    captured_window: i32,

    // Modal stack
    modal_stack: [i32],
    modal_count: i32,

    // Screen size
    screen_width: i32,
    screen_height: i32,
}

impl WndWindowManager {
    fn init(screen_width: i32, screen_height: i32): WndWindowManager {
        let windows: [WndWindow] = []
        for i in 0..MAX_WINDOWS {
            windows = windows + [WndWindow::init_default()]
        }
        let roots: [i32] = []
        let modal: [i32] = []
        for i in 0..64 {
            roots = roots + [0]
            modal = modal + [0]
        }
        return WndWindowManager {
            windows: windows,
            window_count: 0,
            next_id: 1,
            root_windows: roots,
            root_count: 0,
            focused_window: 0,
            captured_window: 0,
            modal_stack: modal,
            modal_count: 0,
            screen_width: screen_width,
            screen_height: screen_height,
        }
    }

    fn create_window(&self, name: string, window_type: WindowType, parent_id: i32): i32 {
        if self.window_count >= MAX_WINDOWS {
            return -1
        }

        let window_id = self.next_id
        self.next_id = self.next_id + 1

        let slot = self.window_count
        self.window_count = self.window_count + 1

        self.windows[slot] = WndWindow::init(name, window_type)
        self.windows[slot].id = window_id
        self.windows[slot].parent_id = parent_id

        if parent_id == 0 {
            // Root window
            self.root_windows[self.root_count] = window_id
            self.root_count = self.root_count + 1
        } else {
            // Add to parent's children
            let parent_slot = self.find_window_slot(parent_id)
            if parent_slot >= 0 {
                self.windows[parent_slot].add_child(window_id)
            }
        }

        return window_id
    }

    fn find_window_slot(&self, window_id: i32): i32 {
        for i in 0..self.window_count {
            if self.windows[i].id == window_id {
                return i
            }
        }
        return -1
    }

    fn get_window(&self, window_id: i32): WndWindow? {
        let slot = self.find_window_slot(window_id)
        if slot >= 0 {
            return self.windows[slot]
        }
        return null
    }

    fn destroy_window(&self, window_id: i32) {
        let slot = self.find_window_slot(window_id)
        if slot < 0 {
            return
        }

        let window = self.windows[slot]

        // Destroy children first
        for i in 0..window.child_count {
            self.destroy_window(window.children[i])
        }

        // Remove from parent
        if window.parent_id != 0 {
            let parent_slot = self.find_window_slot(window.parent_id)
            if parent_slot >= 0 {
                self.windows[parent_slot].remove_child(window_id)
            }
        } else {
            // Remove from root list
            for i in 0..self.root_count {
                if self.root_windows[i] == window_id {
                    for j in i..(self.root_count - 1) {
                        self.root_windows[j] = self.root_windows[j + 1]
                    }
                    self.root_count = self.root_count - 1
                    break
                }
            }
        }

        // Mark as invalid
        self.windows[slot].is_valid = false
    }

    fn set_focus(&self, window_id: i32) {
        if self.focused_window != window_id {
            // Notify old window of focus loss
            if self.focused_window != 0 {
                let old_slot = self.find_window_slot(self.focused_window)
                if old_slot >= 0 {
                    self.windows[old_slot].is_focused = false
                }
            }

            // Set new focus
            self.focused_window = window_id

            if window_id != 0 {
                let new_slot = self.find_window_slot(window_id)
                if new_slot >= 0 {
                    self.windows[new_slot].is_focused = true
                }
            }
        }
    }

    fn capture_mouse(&self, window_id: i32) {
        self.captured_window = window_id
    }

    fn release_mouse(&self) {
        self.captured_window = 0
    }

    fn push_modal(&self, window_id: i32) {
        if self.modal_count < 64 {
            self.modal_stack[self.modal_count] = window_id
            self.modal_count = self.modal_count + 1
        }
    }

    fn pop_modal(&self) {
        if self.modal_count > 0 {
            self.modal_count = self.modal_count - 1
        }
    }

    fn get_modal(&self): i32 {
        if self.modal_count > 0 {
            return self.modal_stack[self.modal_count - 1]
        }
        return 0
    }

    fn hit_test(&self, x: i32, y: i32): i32 {
        // Check modal first
        if self.modal_count > 0 {
            let modal_id = self.modal_stack[self.modal_count - 1]
            return self.hit_test_window(modal_id, x, y)
        }

        // Check root windows in reverse order (top to bottom)
        for i in 0..self.root_count {
            let idx = self.root_count - 1 - i
            let result = self.hit_test_window(self.root_windows[idx], x, y)
            if result != 0 {
                return result
            }
        }

        return 0
    }

    fn hit_test_window(&self, window_id: i32, x: i32, y: i32): i32 {
        let slot = self.find_window_slot(window_id)
        if slot < 0 {
            return 0
        }

        let window = self.windows[slot]
        if !window.is_valid || window.is_hidden() {
            return 0
        }

        if !window.contains_point(x, y) {
            return 0
        }

        // Check children first (in reverse order)
        for i in 0..window.child_count {
            let child_idx = window.child_count - 1 - i
            let result = self.hit_test_window(window.children[child_idx], x, y)
            if result != 0 {
                return result
            }
        }

        // Check if this window accepts input
        if !window.get_status(WindowStatus::NoInput) {
            return window_id
        }

        return 0
    }
}

// ============================================================================
// Tests
// ============================================================================

fn test_wnd_window() {
    print("Testing WND Window System...")

    // Create window manager
    let manager = WndWindowManager::init(1024, 768)
    print("  Created window manager")

    // Create root window
    let root_id = manager.create_window("MainWindow", WindowType::GenericWindow, 0)
    print("  Created root window: " + str(root_id))

    // Create child button
    let button_id = manager.create_window("Button1", WindowType::PushButton, root_id)
    print("  Created button: " + str(button_id))

    // Get windows
    let root = manager.get_window(root_id)
    if root != null {
        print("  Root window name: " + root.name)
        print("  Root child count: " + str(root.child_count))
    }

    let button = manager.get_window(button_id)
    if button != null {
        button.set_rect(10, 10, 100, 30)
        button.set_text("Click Me")
        print("  Button text: " + button.get_text())
    }

    // Test hit testing
    if root != null {
        root.set_rect(0, 0, 800, 600)
    }
    let hit = manager.hit_test(50, 20)
    print("  Hit test at (50, 20): " + str(hit))

    // Test focus
    manager.set_focus(button_id)
    print("  Focused window: " + str(manager.focused_window))

    // Test modal
    manager.push_modal(root_id)
    print("  Modal window: " + str(manager.get_modal()))
    manager.pop_modal()

    print("WND Window System tests complete!")
}
