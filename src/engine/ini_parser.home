// INI file parser for game configuration files
// Handles Generals/Zero Hour INI format

// INI Value types
enum IniValueType {
    STRING,
    INTEGER,
    FLOAT,
    BOOLEAN,
    ARRAY,
}

// A parsed INI value
struct IniValue {
    value_type: IniValueType,
    string_value: string,
    int_value: i64,
    float_value: f64,
    bool_value: bool,
}

// A section in an INI file
struct IniSection {
    name: string,
    values: [string],
}

// INI Parser
struct IniParser {
    content: string,
    position: i64,
    sections: [IniSection],
}

// Create a new INI parser
fn new_ini_parser(content: string): IniParser {
    return IniParser {
        content: content,
        position: 0,
        sections: [],
    }
}

// Parse an INI file and return sections
fn parse_ini(content: string): [IniSection] {
    let parser = new_ini_parser(content)
    return parser.sections
}

// Parse a value from a string
fn parse_value(text: string): IniValue {
    return IniValue {
        value_type: IniValueType::STRING,
        string_value: text,
        int_value: 0,
        float_value: 0.0,
        bool_value: false,
    }
}
