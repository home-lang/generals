// STR Compiler - Multi-Language String File Support
// Parses the generals.str master file format and compiles to CSF
// Used by the C&C Generals patch project for localization
//
// Format:
// - Comments start with //
// - Entries have format: LABEL:\nUS: "text"\nDE: "text"\n...END
// - Language codes: US, DE, FR, ES, IT, KO, ZH, BP, PL, RU, AR, UA, SE

// Supported language codes
let LANG_US: string = "US"  // English (United States)
let LANG_DE: string = "DE"  // German
let LANG_FR: string = "FR"  // French
let LANG_ES: string = "ES"  // Spanish
let LANG_IT: string = "IT"  // Italian
let LANG_KO: string = "KO"  // Korean
let LANG_ZH: string = "ZH"  // Chinese (Traditional)
let LANG_BP: string = "BP"  // Brazilian Portuguese
let LANG_PL: string = "PL"  // Polish
let LANG_RU: string = "RU"  // Russian
let LANG_AR: string = "AR"  // Arabic
let LANG_UA: string = "UA"  // Ukrainian
let LANG_SE: string = "SE"  // Swedish

let ALL_LANGUAGES: [string] = [
    "US", "DE", "FR", "ES", "IT", "KO", "ZH", "BP", "PL", "RU", "AR", "UA", "SE"
]

// Language to folder name mapping
fn language_to_folder(lang_code: string): string {
    if lang_code == "US" { return "English" }
    if lang_code == "DE" { return "German" }
    if lang_code == "FR" { return "French" }
    if lang_code == "ES" { return "Spanish" }
    if lang_code == "IT" { return "Italian" }
    if lang_code == "KO" { return "Korean" }
    if lang_code == "ZH" { return "Chinese" }
    if lang_code == "BP" { return "Brazilian" }
    if lang_code == "PL" { return "Polish" }
    if lang_code == "RU" { return "Russian" }
    if lang_code == "AR" { return "Arabic" }
    if lang_code == "UA" { return "Ukrainian" }
    if lang_code == "SE" { return "Swedish" }
    return "English"
}

// ============================================================================
// Translation Entry
// ============================================================================

struct Translation {
    lang_code: string,
    text: string,
}

impl Translation {
    fn init(lang: string, text: string): Translation {
        return Translation {
            lang_code: lang,
            text: text,
        }
    }
}

// Single localized string entry
struct LocalizedString {
    label: string,
    translations: [Translation],
    translation_count: i32,
    extra_value: string,
}

impl LocalizedString {
    fn init(label: string): LocalizedString {
        return LocalizedString {
            label: label,
            translations: [],
            translation_count: 0,
            extra_value: "",
        }
    }

    fn add_translation(&self, lang: string, text: string) {
        // Check if language already exists
        for i in 0..self.translation_count {
            if self.translations[i].lang_code == lang {
                self.translations[i].text = text
                return
            }
        }

        // Add new translation
        self.translations = self.translations + [Translation::init(lang, text)]
        self.translation_count = self.translation_count + 1
    }

    fn get_translation(&self, lang: string): string {
        for i in 0..self.translation_count {
            if self.translations[i].lang_code == lang {
                return self.translations[i].text
            }
        }
        return ""
    }

    fn has_translation(&self, lang: string): bool {
        for i in 0..self.translation_count {
            if self.translations[i].lang_code == lang {
                return true
            }
        }
        return false
    }
}

// ============================================================================
// String Database
// ============================================================================

struct StringDatabase {
    entries: [LocalizedString],
    entry_count: i32,
    source_file: string,
}

impl StringDatabase {
    fn init(): StringDatabase {
        return StringDatabase {
            entries: [],
            entry_count: 0,
            source_file: "",
        }
    }

    fn add_entry(&self, entry: LocalizedString): i32 {
        self.entries = self.entries + [entry]
        let index = self.entry_count
        self.entry_count = self.entry_count + 1
        return index
    }

    fn find_entry(&self, label: string): i32 {
        for i in 0..self.entry_count {
            if self.entries[i].label == label {
                return i
            }
        }
        return -1
    }

    fn get_entry(&self, index: i32): LocalizedString? {
        if index >= 0 && index < self.entry_count {
            return self.entries[index]
        }
        return null
    }

    fn has_label(&self, label: string): bool {
        return self.find_entry(label) >= 0
    }

    fn get_string(&self, label: string, language: string): string {
        let index = self.find_entry(label)
        if index < 0 {
            return ""
        }

        let entry = self.entries[index]

        // Try requested language
        if entry.has_translation(language) {
            return entry.get_translation(language)
        }

        // Fall back to English
        if entry.has_translation("US") {
            return entry.get_translation("US")
        }

        return ""
    }

    fn get_available_languages(&self, label: string): [string] {
        let result: [string] = []

        let index = self.find_entry(label)
        if index < 0 {
            return result
        }

        let entry = self.entries[index]

        for i in 0..13 {
            let lang = ALL_LANGUAGES[i]
            if entry.has_translation(lang) {
                result = result + [lang]
            }
        }

        return result
    }
}

// ============================================================================
// STR Parser
// ============================================================================

fn is_whitespace(c: i32): bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn char_at(s: string, index: i32): i32 {
    // Platform-specific string character access
    return 0
}

fn string_len(s: string): i32 {
    // Platform-specific string length
    return 0
}

fn substring(s: string, start: i32, end: i32): string {
    // Platform-specific substring
    return ""
}

fn trim(s: string): string {
    let len = string_len(s)
    let start: i32 = 0
    let end = len

    while start < end && is_whitespace(char_at(s, start)) {
        start = start + 1
    }
    while end > start && is_whitespace(char_at(s, end - 1)) {
        end = end - 1
    }

    return substring(s, start, end)
}

fn starts_with(s: string, prefix: string): bool {
    let s_len = string_len(s)
    let p_len = string_len(prefix)

    if p_len > s_len {
        return false
    }

    for i in 0..p_len {
        if char_at(s, i) != char_at(prefix, i) {
            return false
        }
    }
    return true
}

fn ends_with(s: string, suffix: string): bool {
    let s_len = string_len(s)
    let suffix_len = string_len(suffix)

    if suffix_len > s_len {
        return false
    }

    let offset = s_len - suffix_len
    for i in 0..suffix_len {
        if char_at(s, offset + i) != char_at(suffix, i) {
            return false
        }
    }
    return true
}

// Check if line is a comment
fn is_comment_line(line: string): bool {
    let trimmed = trim(line)
    return starts_with(trimmed, "//")
}

// Check if line is empty or whitespace only
fn is_empty_line(line: string): bool {
    return string_len(trim(line)) == 0
}

// Check if line starts a new string entry (LABEL:)
fn is_label_line(line: string): bool {
    let trimmed = trim(line)

    // Label lines end with : and don't start with language codes
    if !ends_with(trimmed, ":") {
        return false
    }

    // Check it's not a language line like "US:"
    for i in 0..13 {
        let lang = ALL_LANGUAGES[i]
        if starts_with(trimmed, lang + ":") {
            return false
        }
    }
    return true
}

// Check if line is a language definition (XX: "text")
fn is_language_line(line: string): bool {
    let trimmed = trim(line)
    for i in 0..13 {
        let lang = ALL_LANGUAGES[i]
        if starts_with(trimmed, lang + ":") {
            return true
        }
    }
    return false
}

// Check if line is END marker
fn is_end_line(line: string): bool {
    return trim(line) == "END"
}

// Extract label from label line
fn extract_label(line: string): string {
    let trimmed = trim(line)
    if ends_with(trimmed, ":") {
        return substring(trimmed, 0, string_len(trimmed) - 1)
    }
    return trimmed
}

// Find closing quote, handling escaped quotes
fn find_closing_quote(s: string, start: i32): i32 {
    let i = start
    let len = string_len(s)

    while i < len {
        let c = char_at(s, i)
        if c == 92 {  // backslash
            i = i + 2  // Skip escaped character
        } else if c == 34 {  // quote
            return i
        } else {
            i = i + 1
        }
    }
    return -1
}

// Unescape special characters in string
fn unescape_string(s: string): string {
    let result = ""
    let i: i32 = 0
    let len = string_len(s)

    while i < len {
        let c = char_at(s, i)

        if c == 92 && i + 1 < len {  // backslash
            let next = char_at(s, i + 1)
            if next == 110 {  // \n
                result = result + "\n"
                i = i + 2
            } else if next == 34 {  // \"
                result = result + "\""
                i = i + 2
            } else if next == 92 {  // \\
                result = result + "\\"
                i = i + 2
            } else if next == 116 {  // \t
                result = result + "\t"
                i = i + 2
            } else {
                result = result + char_to_string(c)
                i = i + 1
            }
        } else {
            result = result + char_to_string(c)
            i = i + 1
        }
    }

    return result
}

fn char_to_string(c: i32): string {
    // Platform-specific char to string conversion
    return ""
}

// Extract language code and text from language line
fn extract_language_text(line: string): Translation {
    let trimmed = trim(line)

    for i in 0..13 {
        let lang = ALL_LANGUAGES[i]
        let prefix = lang + ":"

        if starts_with(trimmed, prefix) {
            let rest = trim(substring(trimmed, string_len(prefix), string_len(trimmed)))

            // Extract quoted text
            if string_len(rest) > 0 && char_at(rest, 0) == 34 {  // starts with "
                let end_quote = find_closing_quote(rest, 1)
                if end_quote > 0 {
                    let text = substring(rest, 1, end_quote)
                    return Translation::init(lang, unescape_string(text))
                }
            }
            return Translation::init(lang, rest)
        }
    }

    return Translation::init("", "")
}

// Split string into lines
fn split_lines(text: string): [string] {
    let lines: [string] = []
    let current = ""
    let len = string_len(text)

    for i in 0..len {
        let c = char_at(text, i)

        if c == 10 {  // \n
            lines = lines + [current]
            current = ""
        } else if c == 13 {  // \r
            // Skip \r, handle \r\n
        } else {
            current = current + char_to_string(c)
        }
    }

    if string_len(current) > 0 {
        lines = lines + [current]
    }

    return lines
}

// Parse STR file content into string database
fn parse_str_file(content: string): StringDatabase {
    let db = StringDatabase::init()
    let lines = split_lines(content)
    let line_count = lines.length

    let current_entry = LocalizedString::init("")
    let in_entry = false

    for i in 0..line_count {
        let line = lines[i]

        // Skip comments and empty lines outside entries
        if is_comment_line(line) {
            continue
        }

        if is_empty_line(line) {
            continue
        }

        if is_label_line(line) {
            // Save previous entry if exists
            if in_entry && string_len(current_entry.label) > 0 {
                db.add_entry(current_entry)
            }

            // Start new entry
            current_entry = LocalizedString::init(extract_label(line))
            in_entry = true

        } else if is_language_line(line) && in_entry {
            let trans = extract_language_text(line)
            if string_len(trans.lang_code) > 0 {
                current_entry.add_translation(trans.lang_code, trans.text)
            }

        } else if is_end_line(line) && in_entry {
            // Save current entry
            if string_len(current_entry.label) > 0 {
                db.add_entry(current_entry)
            }
            current_entry = LocalizedString::init("")
            in_entry = false
        }
    }

    // Save last entry if not ended
    if in_entry && string_len(current_entry.label) > 0 {
        db.add_entry(current_entry)
    }

    return db
}

// ============================================================================
// CSF Compiler
// ============================================================================

// CSF file format constants
let CSF_MAGIC: i32 = 0x43534620        // "CSF " - file signature
let CSF_VERSION: i32 = 3               // CSF version
let CSF_LABEL_MAGIC: i32 = 0x4C424C20  // "LBL " - label header
let CSF_STRING_MAGIC: i32 = 0x53545220 // "STR " - string header
let CSF_WSTRING_MAGIC: i32 = 0x53545257 // "STRW" - wide string header

// Get CSF language ID
fn get_language_id(lang: string): i32 {
    if lang == "US" { return 0 }
    if lang == "DE" { return 2 }
    if lang == "FR" { return 3 }
    if lang == "ES" { return 4 }
    if lang == "IT" { return 5 }
    if lang == "KO" { return 7 }
    if lang == "ZH" { return 8 }
    if lang == "BP" { return 9 }
    if lang == "PL" { return 10 }
    if lang == "RU" { return 11 }
    if lang == "AR" { return 12 }
    if lang == "UA" { return 13 }
    if lang == "SE" { return 14 }
    return 0
}

// CSF output buffer
struct CSFBuffer {
    data: [i32],
    size: i32,
}

impl CSFBuffer {
    fn init(): CSFBuffer {
        return CSFBuffer {
            data: [],
            size: 0,
        }
    }

    fn write_u8(&self, value: i32) {
        self.data = self.data + [value & 0xFF]
        self.size = self.size + 1
    }

    fn write_u32_le(&self, value: i32) {
        self.data = self.data + [value & 0xFF]
        self.data = self.data + [(value >> 8) & 0xFF]
        self.data = self.data + [(value >> 16) & 0xFF]
        self.data = self.data + [(value >> 24) & 0xFF]
        self.size = self.size + 4
    }

    fn write_string(&self, s: string) {
        let len = string_len(s)
        for i in 0..len {
            self.data = self.data + [char_at(s, i) & 0xFF]
            self.size = self.size + 1
        }
    }

    fn write_utf16le_xor(&self, s: string) {
        let len = string_len(s)
        for i in 0..len {
            let c = char_at(s, i)
            // UTF-16LE with XOR encoding
            self.data = self.data + [(c & 0xFF) ^ 0xFF]
            self.data = self.data + [((c >> 8) & 0xFF) ^ 0xFF]
            self.size = self.size + 2
        }
    }
}

// Compile string database to CSF format for specific language
fn compile_to_csf(db: StringDatabase, language: string): CSFBuffer {
    let buffer = CSFBuffer::init()

    // Count strings for this language
    let string_count: i32 = 0
    for i in 0..db.entry_count {
        let entry = db.entries[i]
        if entry.has_translation(language) || entry.has_translation("US") {
            string_count = string_count + 1
        }
    }

    // Write CSF header
    buffer.write_u32_le(CSF_MAGIC)         // Magic
    buffer.write_u32_le(CSF_VERSION)       // Version
    buffer.write_u32_le(string_count)      // Number of labels
    buffer.write_u32_le(string_count)      // Number of strings
    buffer.write_u32_le(0)                 // Unused
    buffer.write_u32_le(get_language_id(language))  // Language ID

    // Write each string entry
    for i in 0..db.entry_count {
        let entry = db.entries[i]

        // Get text for this language, fall back to English
        let text = ""
        if entry.has_translation(language) {
            text = entry.get_translation(language)
        } else if entry.has_translation("US") {
            text = entry.get_translation("US")
        } else {
            continue  // Skip entries with no translation
        }

        // Write label header
        buffer.write_u32_le(CSF_LABEL_MAGIC)
        buffer.write_u32_le(1)  // Number of strings for this label

        // Write label name length and name
        let label_len = string_len(entry.label)
        buffer.write_u32_le(label_len)
        buffer.write_string(entry.label)

        // Write string header
        buffer.write_u32_le(CSF_STRING_MAGIC)

        // Write character count and UTF-16LE XOR-encoded text
        let text_len = string_len(text)
        buffer.write_u32_le(text_len)
        buffer.write_utf16le_xor(text)
    }

    return buffer
}

// ============================================================================
// Utility Functions
// ============================================================================

fn get_entry_count(db: StringDatabase): i32 {
    return db.entry_count
}

fn get_all_labels(db: StringDatabase): [string] {
    let result: [string] = []
    for i in 0..db.entry_count {
        result = result + [db.entries[i].label]
    }
    return result
}

// ============================================================================
// Tests
// ============================================================================

fn test_parse_simple(): bool {
    let content = "OBJECT:TestObject:\nUS: \"Hello World\"\nDE: \"Hallo Welt\"\nEND\n"
    let db = parse_str_file(content)

    if get_entry_count(db) != 1 {
        return false
    }
    if !db.has_label("OBJECT:TestObject") {
        return false
    }
    if db.get_string("OBJECT:TestObject", "US") != "Hello World" {
        return false
    }
    if db.get_string("OBJECT:TestObject", "DE") != "Hallo Welt" {
        return false
    }

    return true
}

fn test_fallback_to_english(): bool {
    let content = "TEST:\nUS: \"English Only\"\nEND\n"
    let db = parse_str_file(content)

    // French should fall back to English
    if db.get_string("TEST", "FR") != "English Only" {
        return false
    }

    return true
}

fn test_language_id(): bool {
    if get_language_id("US") != 0 { return false }
    if get_language_id("DE") != 2 { return false }
    if get_language_id("RU") != 11 { return false }
    return true
}

fn test_language_to_folder(): bool {
    if language_to_folder("US") != "English" { return false }
    if language_to_folder("DE") != "German" { return false }
    if language_to_folder("RU") != "Russian" { return false }
    return true
}

fn run_all_tests(): bool {
    if !test_parse_simple() { return false }
    if !test_fallback_to_english() { return false }
    if !test_language_id() { return false }
    if !test_language_to_folder() { return false }
    return true
}

// ============================================================================
// GLOBAL INSTANCE
// ============================================================================

let g_string_database: StringDatabase? = null

fn init_string_database(): StringDatabase {
    let db = StringDatabase::init()
    g_string_database = db
    return db
}

fn get_string_database(): StringDatabase? {
    return g_string_database
}

fn load_string_file(content: string): StringDatabase {
    let db = parse_str_file(content)
    g_string_database = db
    return db
}

fn get_localized_string(label: string, language: string): string {
    if g_string_database != null {
        return g_string_database.get_string(label, language)
    }
    return ""
}

fn shutdown_string_database() {
    g_string_database = null
}
