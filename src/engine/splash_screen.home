// Splash Screen Loader - BMP image format support
// Used for loading screens, splash images, and static backgrounds
// Reference: Microsoft BMP file format specification
//
// Original: C&C Generals displayed faction-specific loading screens
// This handles BMP parsing for those splash images

// BMP file signatures
let BMP_SIGNATURE: i32 = 0x4D42  // "BM" little-endian

// Compression types
let BI_RGB: i32 = 0           // No compression
let BI_RLE8: i32 = 1          // RLE 8-bit
let BI_RLE4: i32 = 2          // RLE 4-bit
let BI_BITFIELDS: i32 = 3     // Bitfield masks

// ============================================================================
// BMP Headers
// ============================================================================

// BMP file header (14 bytes)
struct BMPFileHeader {
    signature: i32,
    file_size: i32,
    reserved1: i32,
    reserved2: i32,
    data_offset: i32,
}

impl BMPFileHeader {
    fn init(): BMPFileHeader {
        return BMPFileHeader {
            signature: 0,
            file_size: 0,
            reserved1: 0,
            reserved2: 0,
            data_offset: 0,
        }
    }
}

// BMP info header (40 bytes for BITMAPINFOHEADER)
struct BMPInfoHeader {
    header_size: i32,
    width: i32,
    height: i32,
    planes: i32,
    bit_count: i32,
    compression: i32,
    image_size: i32,
    x_pixels_per_m: i32,
    y_pixels_per_m: i32,
    colors_used: i32,
    colors_important: i32,
}

impl BMPInfoHeader {
    fn init(): BMPInfoHeader {
        return BMPInfoHeader {
            header_size: 0,
            width: 0,
            height: 0,
            planes: 0,
            bit_count: 0,
            compression: 0,
            image_size: 0,
            x_pixels_per_m: 0,
            y_pixels_per_m: 0,
            colors_used: 0,
            colors_important: 0,
        }
    }
}

// Color palette entry (4 bytes)
struct BMPColor {
    blue: i32,
    green: i32,
    red: i32,
    alpha: i32,
}

impl BMPColor {
    fn init(): BMPColor {
        return BMPColor {
            blue: 0,
            green: 0,
            red: 0,
            alpha: 255,
        }
    }
}

// ============================================================================
// Splash Screen
// ============================================================================

struct SplashScreen {
    width: i32,
    height: i32,
    bit_depth: i32,
    pixels: [i32],  // RGBA pixel data
    name: string,
    is_top_down: bool,
    is_valid: bool,
}

impl SplashScreen {
    fn init(): SplashScreen {
        return SplashScreen {
            width: 0,
            height: 0,
            bit_depth: 32,
            pixels: [],
            name: "",
            is_top_down: false,
            is_valid: false,
        }
    }
}

// ============================================================================
// Data Reading Helpers
// ============================================================================

fn read_u16_le(data: [i32], offset: i32): i32 {
    if offset + 2 > data.length {
        return 0
    }
    return data[offset] | (data[offset + 1] << 8)
}

fn read_u32_le(data: [i32], offset: i32): i32 {
    if offset + 4 > data.length {
        return 0
    }
    return data[offset] |
           (data[offset + 1] << 8) |
           (data[offset + 2] << 16) |
           (data[offset + 3] << 24)
}

fn read_i32_le(data: [i32], offset: i32): i32 {
    let value = read_u32_le(data, offset)
    // Handle sign extension (negative height = top-down)
    return value
}

// ============================================================================
// BMP Parsing
// ============================================================================

fn parse_bmp_file_header(data: [i32]): BMPFileHeader {
    let header = BMPFileHeader::init()

    if data.length < 14 {
        return header
    }

    header.signature = read_u16_le(data, 0)
    header.file_size = read_u32_le(data, 2)
    header.reserved1 = read_u16_le(data, 6)
    header.reserved2 = read_u16_le(data, 8)
    header.data_offset = read_u32_le(data, 10)

    return header
}

fn parse_bmp_info_header(data: [i32]): BMPInfoHeader {
    let header = BMPInfoHeader::init()

    if data.length < 54 {
        return header
    }

    header.header_size = read_u32_le(data, 14)
    header.width = read_i32_le(data, 18)
    header.height = read_i32_le(data, 22)
    header.planes = read_u16_le(data, 26)
    header.bit_count = read_u16_le(data, 28)
    header.compression = read_u32_le(data, 30)
    header.image_size = read_u32_le(data, 34)
    header.x_pixels_per_m = read_i32_le(data, 38)
    header.y_pixels_per_m = read_i32_le(data, 42)
    header.colors_used = read_u32_le(data, 46)
    header.colors_important = read_u32_le(data, 50)

    return header
}

fn parse_palette(data: [i32], offset: i32, num_colors: i32): [BMPColor] {
    let palette: [BMPColor] = []

    for i in 0..num_colors {
        let entry_offset = offset + i * 4
        if entry_offset + 4 > data.length {
            break
        }

        let color = BMPColor {
            blue: data[entry_offset],
            green: data[entry_offset + 1],
            red: data[entry_offset + 2],
            alpha: 255,
        }
        palette = palette + [color]
    }

    return palette
}

// Calculate row stride (BMP rows are padded to 4-byte boundaries)
fn calculate_stride(width: i32, bit_count: i32): i32 {
    let bits_per_row = width * bit_count
    let bytes_per_row = (bits_per_row + 7) / 8
    // Round up to next 4-byte boundary
    return (bytes_per_row + 3) & ~3
}

// ============================================================================
// Pixel Loading
// ============================================================================

fn load_24bit_pixels(data: [i32], info: BMPInfoHeader, data_offset: i32, is_top_down: bool): [i32] {
    let pixels: [i32] = []
    let width = info.width
    let height = info.height
    if height < 0 { height = -height }
    let stride = calculate_stride(width, 24)

    // Allocate RGBA pixels
    let total_pixels = width * height * 4
    for i in 0..total_pixels {
        pixels = pixels + [0]
    }

    for y in 0..height {
        // BMP stores bottom-up by default, top-down if height is negative
        let src_y = y
        if !is_top_down {
            src_y = height - 1 - y
        }
        let row_offset = data_offset + src_y * stride

        for x in 0..width {
            let src_offset = row_offset + x * 3
            let dst_offset = (y * width + x) * 4

            if src_offset + 3 <= data.length {
                pixels[dst_offset] = data[src_offset + 2]      // R (BMP is BGR)
                pixels[dst_offset + 1] = data[src_offset + 1]  // G
                pixels[dst_offset + 2] = data[src_offset]      // B
                pixels[dst_offset + 3] = 255                    // A
            }
        }
    }

    return pixels
}

fn load_32bit_pixels(data: [i32], info: BMPInfoHeader, data_offset: i32, is_top_down: bool): [i32] {
    let pixels: [i32] = []
    let width = info.width
    let height = info.height
    if height < 0 { height = -height }
    let stride = calculate_stride(width, 32)

    // Allocate RGBA pixels
    let total_pixels = width * height * 4
    for i in 0..total_pixels {
        pixels = pixels + [0]
    }

    for y in 0..height {
        let src_y = y
        if !is_top_down {
            src_y = height - 1 - y
        }
        let row_offset = data_offset + src_y * stride

        for x in 0..width {
            let src_offset = row_offset + x * 4
            let dst_offset = (y * width + x) * 4

            if src_offset + 4 <= data.length {
                pixels[dst_offset] = data[src_offset + 2]      // R (BMP is BGRA)
                pixels[dst_offset + 1] = data[src_offset + 1]  // G
                pixels[dst_offset + 2] = data[src_offset]      // B
                pixels[dst_offset + 3] = data[src_offset + 3]  // A
            }
        }
    }

    return pixels
}

fn load_8bit_pixels(data: [i32], info: BMPInfoHeader, data_offset: i32, palette: [BMPColor], is_top_down: bool): [i32] {
    let pixels: [i32] = []
    let width = info.width
    let height = info.height
    if height < 0 { height = -height }
    let stride = calculate_stride(width, 8)

    // Allocate RGBA pixels
    let total_pixels = width * height * 4
    for i in 0..total_pixels {
        pixels = pixels + [0]
    }

    for y in 0..height {
        let src_y = y
        if !is_top_down {
            src_y = height - 1 - y
        }
        let row_offset = data_offset + src_y * stride

        for x in 0..width {
            let src_offset = row_offset + x
            let dst_offset = (y * width + x) * 4

            if src_offset < data.length {
                let index = data[src_offset]
                if index < palette.length {
                    let color = palette[index]
                    pixels[dst_offset] = color.red
                    pixels[dst_offset + 1] = color.green
                    pixels[dst_offset + 2] = color.blue
                    pixels[dst_offset + 3] = 255
                }
            }
        }
    }

    return pixels
}

// ============================================================================
// Main Loading Function
// ============================================================================

fn is_bmp_file(data: [i32]): bool {
    if data.length < 2 {
        return false
    }
    return read_u16_le(data, 0) == BMP_SIGNATURE
}

fn load_splash_screen(data: [i32]): SplashScreen {
    let splash = SplashScreen::init()

    // Parse file header
    let file_header = parse_bmp_file_header(data)
    if file_header.signature != BMP_SIGNATURE {
        return splash
    }

    // Parse info header
    let info_header = parse_bmp_info_header(data)
    if info_header.width == 0 {
        return splash
    }

    // Only support uncompressed BMPs for now
    if info_header.compression != BI_RGB && info_header.compression != BI_BITFIELDS {
        return splash
    }

    // Determine if top-down
    let is_top_down = info_header.height < 0
    let actual_height = info_header.height
    if actual_height < 0 { actual_height = -actual_height }

    splash.width = info_header.width
    splash.height = actual_height
    splash.bit_depth = info_header.bit_count
    splash.is_top_down = is_top_down

    // Calculate palette offset (right after info header)
    let palette_offset = 14 + info_header.header_size

    // Load pixels based on bit depth
    if info_header.bit_count == 24 {
        splash.pixels = load_24bit_pixels(data, info_header, file_header.data_offset, is_top_down)
        splash.is_valid = true
    } else if info_header.bit_count == 32 {
        splash.pixels = load_32bit_pixels(data, info_header, file_header.data_offset, is_top_down)
        splash.is_valid = true
    } else if info_header.bit_count == 8 {
        let num_colors = info_header.colors_used
        if num_colors == 0 { num_colors = 256 }
        let palette = parse_palette(data, palette_offset, num_colors)
        splash.pixels = load_8bit_pixels(data, info_header, file_header.data_offset, palette, is_top_down)
        splash.is_valid = true
    }

    return splash
}

// Create solid color splash screen (fallback)
fn create_solid_splash(width: i32, height: i32, r: i32, g: i32, b: i32): SplashScreen {
    let splash = SplashScreen {
        width: width,
        height: height,
        bit_depth: 32,
        pixels: [],
        name: "solid",
        is_top_down: false,
        is_valid: true,
    }

    let total_pixels = width * height
    for i in 0..total_pixels {
        splash.pixels = splash.pixels + [r]    // R
        splash.pixels = splash.pixels + [g]    // G
        splash.pixels = splash.pixels + [b]    // B
        splash.pixels = splash.pixels + [255]  // A
    }

    return splash
}

// Get pixel at coordinate
fn get_splash_pixel(splash: SplashScreen, x: i32, y: i32): [i32] {
    if x < 0 || x >= splash.width || y < 0 || y >= splash.height {
        return [0, 0, 0, 0]
    }

    let offset = (y * splash.width + x) * 4
    if offset + 4 > splash.pixels.length {
        return [0, 0, 0, 0]
    }

    return [
        splash.pixels[offset],
        splash.pixels[offset + 1],
        splash.pixels[offset + 2],
        splash.pixels[offset + 3],
    ]
}

// ============================================================================
// Splash Screen Manager
// ============================================================================

enum SplashType {
    LOADING,
    MAIN_MENU,
    CAMPAIGN,
    SKIRMISH,
    MULTIPLAYER,
    TUTORIAL,
    CUSTOM,
}

struct SplashManager {
    screens: [SplashScreen],
    screen_names: [string],
    screen_count: i32,
    current_index: i32,
    fade_alpha: f32,
    fade_speed: f32,
    is_fading_in: bool,
    is_fading_out: bool,
}

impl SplashManager {
    fn init(): SplashManager {
        return SplashManager {
            screens: [],
            screen_names: [],
            screen_count: 0,
            current_index: -1,
            fade_alpha: 1.0,
            fade_speed: 2.0,
            is_fading_in: false,
            is_fading_out: false,
        }
    }

    fn add_screen(&self, name: string, splash: SplashScreen): i32 {
        self.screens = self.screens + [splash]
        self.screen_names = self.screen_names + [name]
        let index = self.screen_count
        self.screen_count = self.screen_count + 1
        return index
    }

    fn find_screen(&self, name: string): i32 {
        for i in 0..self.screen_count {
            if self.screen_names[i] == name {
                return i
            }
        }
        return -1
    }

    fn show_splash(&self, name: string, fade_in: bool) {
        let index = self.find_screen(name)
        if index < 0 {
            return
        }

        self.current_index = index
        if fade_in {
            self.fade_alpha = 0.0
            self.is_fading_in = true
            self.is_fading_out = false
        } else {
            self.fade_alpha = 1.0
            self.is_fading_in = false
        }
    }

    fn hide_splash(&self, fade_out: bool) {
        if fade_out {
            self.is_fading_out = true
            self.is_fading_in = false
        } else {
            self.current_index = -1
            self.fade_alpha = 0.0
        }
    }

    fn update(&self, delta_time: f32) {
        if self.is_fading_in {
            self.fade_alpha = self.fade_alpha + self.fade_speed * delta_time
            if self.fade_alpha >= 1.0 {
                self.fade_alpha = 1.0
                self.is_fading_in = false
            }
        }

        if self.is_fading_out {
            self.fade_alpha = self.fade_alpha - self.fade_speed * delta_time
            if self.fade_alpha <= 0.0 {
                self.fade_alpha = 0.0
                self.is_fading_out = false
                self.current_index = -1
            }
        }
    }

    fn get_current_splash(&self): SplashScreen? {
        if self.current_index >= 0 && self.current_index < self.screen_count {
            return self.screens[self.current_index]
        }
        return null
    }

    fn get_fade_alpha(&self): f32 {
        return self.fade_alpha
    }

    fn is_visible(&self): bool {
        return self.current_index >= 0 && self.fade_alpha > 0.0
    }
}

// ============================================================================
// Standard Loading Screens
// ============================================================================

fn get_loading_screen_name(splash_type: SplashType): string {
    if splash_type == SplashType::LOADING {
        return "LoadingScreen.bmp"
    } else if splash_type == SplashType::CAMPAIGN {
        return "LoadingScreen_Campaign.bmp"
    } else if splash_type == SplashType::SKIRMISH {
        return "LoadingScreen_Skirmish.bmp"
    } else if splash_type == SplashType::MULTIPLAYER {
        return "LoadingScreen_Multiplayer.bmp"
    } else if splash_type == SplashType::TUTORIAL {
        return "LoadingScreen_Tutorial.bmp"
    } else {
        return "LoadingScreen.bmp"
    }
}

fn get_faction_loading_screen(faction: string): string {
    if faction == "USA" {
        return "LoadingScreen_USA.bmp"
    } else if faction == "CHINA" {
        return "LoadingScreen_CHINA.bmp"
    } else if faction == "GLA" {
        return "LoadingScreen_GLA.bmp"
    } else {
        return "LoadingScreen.bmp"
    }
}

// ============================================================================
// GLOBAL INSTANCE
// ============================================================================

let g_splash_manager: SplashManager? = null

fn init_splash_manager(): SplashManager {
    let manager = SplashManager::init()
    g_splash_manager = manager
    return manager
}

fn get_splash_manager(): SplashManager? {
    return g_splash_manager
}

fn shutdown_splash_manager() {
    g_splash_manager = null
}
