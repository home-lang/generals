// C&C Generals Zero Hour - Home Port
// Radius Decal - Ability range indicators and area markers
//
// Original: RadiusDecal from Thyme/SAGE engine
// Handles circle rendering, pulse animation, and range visualization
//
// Used for:
// - Weapon/ability range indicators
// - Area of effect displays
// - Rally points
// - Special power targeting

let MAX_RADIUS_DECALS: i32 = 32
let MAX_VERTICES_PER_DECAL: i32 = 256
let MAX_INDICES_PER_DECAL: i32 = 768

// ============================================================================
// CONFIGURATION
// ============================================================================

struct RadiusDecalConfig {
    default_segments: i32,
    outline_width: f32,
    fill_alpha: f32,
    outline_alpha: f32,
    pulse_speed: f32,
    pulse_intensity: f32,
    expand_speed: f32,
    fade_duration: f32,
}

impl RadiusDecalConfig {
    fn init(): RadiusDecalConfig {
        return RadiusDecalConfig {
            default_segments: 64,
            outline_width: 0.5,
            fill_alpha: 0.15,
            outline_alpha: 0.8,
            pulse_speed: 2.0,
            pulse_intensity: 0.3,
            expand_speed: 50.0,
            fade_duration: 0.5,
        }
    }
}

// ============================================================================
// DECAL TYPES
// ============================================================================

enum DecalType {
    RANGE,        // Weapon/ability range
    AREA,         // Area of effect
    DAMAGE,       // Damage radius
    HEAL,         // Heal radius
    CAPTURE,      // Capture zone
    RALLY,        // Rally point
    WAYPOINT,     // Movement waypoint
    INVALID,      // Invalid placement
    POWER,        // Special power targeting
    RADAR,        // Radar scan range
}

enum DecalState {
    INACTIVE,
    FADING_IN,
    ACTIVE,
    PULSING,
    EXPANDING,
    FADING_OUT,
}

// ============================================================================
// VECTOR TYPES
// ============================================================================

struct Vec2 {
    x: f32,
    y: f32,
}

impl Vec2 {
    fn init(x: f32, y: f32): Vec2 {
        return Vec2 { x: x, y: y }
    }
}

struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(x: f32, y: f32, z: f32): Vec3 {
        return Vec3 { x: x, y: y, z: z }
    }

    fn zero(): Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }
}

struct Vec4 {
    x: f32,
    y: f32,
    z: f32,
    w: f32,
}

impl Vec4 {
    fn init(x: f32, y: f32, z: f32, w: f32): Vec4 {
        return Vec4 { x: x, y: y, z: z, w: w }
    }
}

// ============================================================================
// DECAL COLORS
// ============================================================================

struct DecalColors {
    range: Vec4,
    area: Vec4,
    damage: Vec4,
    heal: Vec4,
    capture: Vec4,
    rally: Vec4,
    waypoint: Vec4,
    invalid: Vec4,
    power: Vec4,
    radar: Vec4,
}

impl DecalColors {
    fn init(): DecalColors {
        return DecalColors {
            range: Vec4::init(0.2, 0.8, 0.2, 1.0),      // Green
            area: Vec4::init(0.9, 0.6, 0.1, 1.0),       // Orange
            damage: Vec4::init(0.9, 0.2, 0.2, 1.0),     // Red
            heal: Vec4::init(0.2, 0.8, 0.9, 1.0),       // Cyan
            capture: Vec4::init(0.8, 0.8, 0.2, 1.0),    // Yellow
            rally: Vec4::init(0.2, 0.5, 0.9, 1.0),      // Blue
            waypoint: Vec4::init(0.5, 0.5, 0.9, 1.0),   // Light blue
            invalid: Vec4::init(0.9, 0.1, 0.1, 1.0),    // Bright red
            power: Vec4::init(0.9, 0.2, 0.9, 1.0),      // Magenta
            radar: Vec4::init(0.2, 0.9, 0.2, 1.0),      // Bright green
        }
    }

    fn get_color(&self, decal_type: DecalType): Vec4 {
        if decal_type == DecalType::RANGE { return self.range }
        if decal_type == DecalType::AREA { return self.area }
        if decal_type == DecalType::DAMAGE { return self.damage }
        if decal_type == DecalType::HEAL { return self.heal }
        if decal_type == DecalType::CAPTURE { return self.capture }
        if decal_type == DecalType::RALLY { return self.rally }
        if decal_type == DecalType::WAYPOINT { return self.waypoint }
        if decal_type == DecalType::INVALID { return self.invalid }
        if decal_type == DecalType::POWER { return self.power }
        if decal_type == DecalType::RADAR { return self.radar }
        return self.range
    }
}

// ============================================================================
// RADIUS DECAL INSTANCE
// ============================================================================

struct RadiusDecal {
    decal_id: i32,
    decal_type: DecalType,
    state: DecalState,
    position: Vec3,
    inner_radius: f32,
    outer_radius: f32,
    target_radius: f32,
    rotation: f32,
    color: Vec4,
    alpha: f32,
    pulse_phase: f32,
    state_time: f32,
    lifetime: f32,          // 0 = infinite
    age: f32,
    show_fill: bool,
    show_outline: bool,
    dashed_outline: bool,
    dash_count: i32,
    dash_speed: f32,
    is_valid: bool,
    segments: i32,
}

impl RadiusDecal {
    fn init(decal_id: i32, decal_type: DecalType, position: Vec3, radius: f32): RadiusDecal {
        return RadiusDecal {
            decal_id: decal_id,
            decal_type: decal_type,
            state: DecalState::FADING_IN,
            position: position,
            inner_radius: 0.0,
            outer_radius: radius,
            target_radius: radius,
            rotation: 0.0,
            color: Vec4::init(1.0, 1.0, 1.0, 1.0),
            alpha: 0.0,
            pulse_phase: 0.0,
            state_time: 0.0,
            lifetime: 0.0,
            age: 0.0,
            show_fill: true,
            show_outline: true,
            dashed_outline: false,
            dash_count: 16,
            dash_speed: 1.0,
            is_valid: true,
            segments: 64,
        }
    }
}

// ============================================================================
// DECAL VERTEX
// ============================================================================

struct DecalVertex {
    position: Vec3,
    uv: Vec2,
    distance: f32,
    angle: f32,
}

impl DecalVertex {
    fn init(): DecalVertex {
        return DecalVertex {
            position: Vec3::zero(),
            uv: Vec2::init(0.0, 0.0),
            distance: 0.0,
            angle: 0.0,
        }
    }
}

// ============================================================================
// DECAL MESH
// ============================================================================

struct DecalMesh {
    vertices: [DecalVertex],
    indices: [i32],
}

impl DecalMesh {
    fn init(): DecalMesh {
        return DecalMesh {
            vertices: [],
            indices: [],
        }
    }
}

// ============================================================================
// DECAL MANAGER
// ============================================================================

struct RadiusDecalManager {
    config: RadiusDecalConfig,
    colors: DecalColors,
    decals: [RadiusDecal],
    next_decal_id: i32,
    current_time: f32,
}

impl RadiusDecalManager {
    fn init(config: RadiusDecalConfig): RadiusDecalManager {
        return RadiusDecalManager {
            config: config,
            colors: DecalColors::init(),
            decals: [],
            next_decal_id: 1,
            current_time: 0.0,
        }
    }

    fn add_decal(&self, decal_type: DecalType, position: Vec3, radius: f32): i32 {
        if self.decals.length >= MAX_RADIUS_DECALS {
            return 0
        }

        let decal_id = self.next_decal_id
        self.next_decal_id = self.next_decal_id + 1

        let decal = RadiusDecal::init(decal_id, decal_type, position, radius)
        decal.color = self.colors.get_color(decal_type)
        decal.segments = self.config.default_segments

        self.decals = self.decals + [decal]

        return decal_id
    }

    fn add_range_decal(&self, position: Vec3, inner_radius: f32, outer_radius: f32): i32 {
        let decal_id = self.add_decal(DecalType::RANGE, position, outer_radius)

        for i in 0..self.decals.length {
            if self.decals[i].decal_id == decal_id {
                self.decals[i].inner_radius = inner_radius
                self.decals[i].show_fill = false
                self.decals[i].dashed_outline = true
                break
            }
        }

        return decal_id
    }

    fn add_area_decal(&self, position: Vec3, radius: f32, lifetime: f32): i32 {
        let decal_id = self.add_decal(DecalType::AREA, position, radius)

        for i in 0..self.decals.length {
            if self.decals[i].decal_id == decal_id {
                self.decals[i].lifetime = lifetime
                self.decals[i].show_fill = true
                break
            }
        }

        return decal_id
    }

    fn add_expanding_decal(&self, position: Vec3, start_radius: f32, end_radius: f32, duration: f32): i32 {
        let decal_id = self.add_decal(DecalType::AREA, position, start_radius)

        for i in 0..self.decals.length {
            if self.decals[i].decal_id == decal_id {
                self.decals[i].target_radius = end_radius
                self.decals[i].state = DecalState::EXPANDING
                self.decals[i].lifetime = duration
                break
            }
        }

        return decal_id
    }

    fn remove_decal(&self, decal_id: i32) {
        for i in 0..self.decals.length {
            if self.decals[i].decal_id == decal_id {
                self.decals[i].state = DecalState::FADING_OUT
                self.decals[i].state_time = 0.0
                break
            }
        }
    }

    fn remove_decal_immediate(&self, decal_id: i32) {
        let new_decals: [RadiusDecal] = []
        for i in 0..self.decals.length {
            if self.decals[i].decal_id != decal_id {
                new_decals = new_decals + [self.decals[i]]
            }
        }
        self.decals = new_decals
    }

    fn update_decal_position(&self, decal_id: i32, position: Vec3) {
        for i in 0..self.decals.length {
            if self.decals[i].decal_id == decal_id {
                self.decals[i].position = position
                break
            }
        }
    }

    fn update_decal_radius(&self, decal_id: i32, radius: f32) {
        for i in 0..self.decals.length {
            if self.decals[i].decal_id == decal_id {
                self.decals[i].outer_radius = radius
                break
            }
        }
    }

    fn set_decal_valid(&self, decal_id: i32, valid: bool) {
        for i in 0..self.decals.length {
            if self.decals[i].decal_id == decal_id {
                self.decals[i].is_valid = valid
                if !valid {
                    self.decals[i].color = self.colors.get_color(DecalType::INVALID)
                } else {
                    self.decals[i].color = self.colors.get_color(self.decals[i].decal_type)
                }
                break
            }
        }
    }

    fn update(&self, delta_time: f32) {
        self.current_time = self.current_time + delta_time

        let to_remove: [i32] = []

        for i in 0..self.decals.length {
            let decal = self.decals[i]

            decal.age = decal.age + delta_time
            decal.state_time = decal.state_time + delta_time
            decal.pulse_phase = decal.pulse_phase + self.config.pulse_speed * delta_time

            if decal.state == DecalState::INACTIVE {
                to_remove = to_remove + [decal.decal_id]
            } else if decal.state == DecalState::FADING_IN {
                decal.alpha = decal.state_time / self.config.fade_duration
                if decal.alpha >= 1.0 {
                    decal.alpha = 1.0
                    decal.state = DecalState::ACTIVE
                    decal.state_time = 0.0
                }
            } else if decal.state == DecalState::ACTIVE {
                if decal.lifetime > 0.0 && decal.age >= decal.lifetime {
                    decal.state = DecalState::FADING_OUT
                    decal.state_time = 0.0
                }
            } else if decal.state == DecalState::PULSING {
                let pulse = sin_approx(decal.pulse_phase)
                decal.alpha = 0.7 + pulse * self.config.pulse_intensity

                if decal.lifetime > 0.0 && decal.age >= decal.lifetime {
                    decal.state = DecalState::FADING_OUT
                    decal.state_time = 0.0
                }
            } else if decal.state == DecalState::EXPANDING {
                let remaining = decal.lifetime - decal.age
                if remaining < 0.1 {
                    remaining = 0.1
                }
                let expand_speed = (decal.target_radius - decal.outer_radius) / remaining
                decal.outer_radius = decal.outer_radius + expand_speed * delta_time

                if decal.outer_radius >= decal.target_radius {
                    decal.outer_radius = decal.target_radius
                    decal.state = DecalState::FADING_OUT
                    decal.state_time = 0.0
                }

                decal.alpha = 1.0 - (decal.outer_radius / decal.target_radius) * 0.5
            } else if decal.state == DecalState::FADING_OUT {
                decal.alpha = 1.0 - decal.state_time / self.config.fade_duration
                if decal.alpha <= 0.0 {
                    decal.alpha = 0.0
                    decal.state = DecalState::INACTIVE
                }
            }

            // Update rotation for dashed decals
            if decal.dashed_outline {
                decal.rotation = decal.rotation + decal.dash_speed * delta_time
            }
        }

        // Remove inactive decals
        for i in 0..to_remove.length {
            self.remove_decal_immediate(to_remove[i])
        }
    }

    fn generate_mesh(&self, decal: RadiusDecal): DecalMesh {
        let mesh = DecalMesh::init()

        let segments = decal.segments
        let inner_ratio = decal.inner_radius / decal.outer_radius
        let pi2 = 6.28318

        // Generate ring vertices
        for i in 0..segments {
            let angle = (i as f32 / segments as f32) * pi2 + decal.rotation
            let cos_a = cos_approx(angle)
            let sin_a = sin_approx(angle)

            // Inner vertex
            let inner_vertex = DecalVertex {
                position: Vec3 {
                    x: decal.position.x + cos_a * decal.inner_radius,
                    y: decal.position.y + sin_a * decal.inner_radius,
                    z: decal.position.z + 0.1,
                },
                uv: Vec2 { x: (cos_a + 1.0) * 0.5, y: (sin_a + 1.0) * 0.5 },
                distance: inner_ratio,
                angle: angle,
            }
            mesh.vertices = mesh.vertices + [inner_vertex]

            // Outer vertex
            let outer_vertex = DecalVertex {
                position: Vec3 {
                    x: decal.position.x + cos_a * decal.outer_radius,
                    y: decal.position.y + sin_a * decal.outer_radius,
                    z: decal.position.z + 0.1,
                },
                uv: Vec2 { x: (cos_a + 1.0) * 0.5, y: (sin_a + 1.0) * 0.5 },
                distance: 1.0,
                angle: angle,
            }
            mesh.vertices = mesh.vertices + [outer_vertex]

            // Generate indices for quad (two triangles)
            if i > 0 {
                let inner_idx = i * 2
                let outer_idx = i * 2 + 1
                let prev_inner = inner_idx - 2
                let prev_outer = outer_idx - 2

                // Triangle 1
                mesh.indices = mesh.indices + [prev_inner]
                mesh.indices = mesh.indices + [prev_outer]
                mesh.indices = mesh.indices + [inner_idx]

                // Triangle 2
                mesh.indices = mesh.indices + [prev_outer]
                mesh.indices = mesh.indices + [outer_idx]
                mesh.indices = mesh.indices + [inner_idx]
            }
        }

        // Close the ring
        if segments > 2 {
            let vertex_count = mesh.vertices.length
            let last_inner = vertex_count - 2
            let last_outer = vertex_count - 1

            mesh.indices = mesh.indices + [last_inner]
            mesh.indices = mesh.indices + [last_outer]
            mesh.indices = mesh.indices + [0]

            mesh.indices = mesh.indices + [last_outer]
            mesh.indices = mesh.indices + [1]
            mesh.indices = mesh.indices + [0]
        }

        return mesh
    }
}

// ============================================================================
// MATH HELPERS
// ============================================================================

fn sin_approx(x: f32): f32 {
    let x2 = x
    while x2 > 3.14159 {
        x2 = x2 - 6.28318
    }
    while x2 < -3.14159 {
        x2 = x2 + 6.28318
    }
    let x3 = x2 * x2 * x2
    let x5 = x3 * x2 * x2
    return x2 - x3 / 6.0 + x5 / 120.0
}

fn cos_approx(x: f32): f32 {
    return sin_approx(x + 1.5708)
}

fn smoothstep(edge0: f32, edge1: f32, x: f32): f32 {
    let t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)
}

fn clamp(x: f32, min_val: f32, max_val: f32): f32 {
    if x < min_val {
        return min_val
    }
    if x > max_val {
        return max_val
    }
    return x
}

fn abs_f32(x: f32): f32 {
    if x < 0.0 {
        return -x
    }
    return x
}

fn min_f32(a: f32, b: f32): f32 {
    if a < b {
        return a
    }
    return b
}

fn max_f32(a: f32, b: f32): f32 {
    if a > b {
        return a
    }
    return b
}

// ============================================================================
// GLOBAL DECAL MANAGER INSTANCE
// ============================================================================

let g_radius_decal_manager: RadiusDecalManager? = null

fn init_radius_decal_manager(): RadiusDecalManager {
    let config = RadiusDecalConfig::init()
    let manager = RadiusDecalManager::init(config)
    g_radius_decal_manager = manager
    return manager
}

fn get_radius_decal_manager(): RadiusDecalManager? {
    return g_radius_decal_manager
}

fn shutdown_radius_decal_manager() {
    g_radius_decal_manager = null
}
