// ============================================================================
// CHALLENGE MODE MANAGER
// ============================================================================

struct ChallengeManager {
    all_generals: [GeneralProfile],
    current_progress: ChallengeProgress,
    current_match: ChallengeMatch,

    // Challenge ladder (order of opponents)
    challenge_order: [ChallengeGeneral],

    // UI state
    showing_general_select: bool,
    showing_opponent_info: bool,
    showing_victory_screen: bool,
    showing_defeat_screen: bool,

    // Audio
    current_taunt_playing: bool,
    taunt_cooldown: f32,
}

impl ChallengeManager {
    fn init(): ChallengeManager {
        let generals: [GeneralProfile] = []
        let order: [ChallengeGeneral] = []

        // Initialize all general profiles
        generals = generals + [create_general_alexis()]
        generals = generals + [create_general_granger()]
        generals = generals + [create_general_townes()]
        generals = generals + [create_general_kwai()]
        generals = generals + [create_general_shin_fai()]
        generals = generals + [create_general_tao()]
        generals = generals + [create_general_thrax()]
        generals = generals + [create_general_juhziz()]
        generals = generals + [create_general_kassad()]
        generals = generals + [create_general_leang()]

        // Initialize challenge order placeholder
        for i in 0..10 {
            order = order + [ChallengeGeneral::USA_BOSS]
        }

        return ChallengeManager {
            all_generals: generals,
            current_progress: ChallengeProgress::init(),
            current_match: ChallengeMatch::init(),
            challenge_order: order,
            showing_general_select: false,
            showing_opponent_info: false,
            showing_victory_screen: false,
            showing_defeat_screen: false,
            current_taunt_playing: false,
            taunt_cooldown: 0.0,
        }
    }

    fn select_player_general(&self, general: ChallengeGeneral) {
        self.current_progress.player_general = general
        self.showing_general_select = false

        // Generate challenge ladder based on player general
        self.generate_challenge_ladder(general)
    }

    fn generate_challenge_ladder(&self, player: ChallengeGeneral) {
        // Exclude player's general from opponents
        // Final opponent is always General Leang
        let ladder_index = 0

        for i in 0..10 {
            let opponent = self.all_generals[i].general
            if opponent != player && opponent != ChallengeGeneral::CHINA_BOSS {
                if ladder_index < 9 {
                    self.challenge_order[ladder_index] = opponent
                    ladder_index = ladder_index + 1
                }
            }
        }

        // Final opponent is always Leang
        self.challenge_order[9] = ChallengeGeneral::CHINA_BOSS
    }

    fn start_challenge_match(&self) {
        let opponent_idx = self.current_progress.current_opponent
        let opponent_general = self.challenge_order[opponent_idx]

        // Find opponent profile
        for i in 0..10 {
            if self.all_generals[i].general == opponent_general {
                self.current_match.opponent = self.all_generals[i]
                break
            }
        }

        // Find player profile
        for i in 0..10 {
            if self.all_generals[i].general == self.current_progress.player_general {
                self.current_match.player = self.all_generals[i]
                break
            }
        }

        self.current_match.map_name = self.current_match.opponent.challenge_map
        self.current_match.state = ChallengeState::IN_PROGRESS
        self.current_match.match_time = 0.0
        self.current_match.units_built = 0
        self.current_match.units_lost = 0
        self.current_match.units_killed = 0
        self.current_match.buildings_built = 0
        self.current_match.buildings_lost = 0
        self.current_match.buildings_destroyed = 0
        self.current_match.resources_gathered = 0

        // Increment attempts
        let general_idx = general_to_index(opponent_general)
        self.current_progress.attempts_per_general[general_idx] =
            self.current_progress.attempts_per_general[general_idx] + 1

        self.showing_opponent_info = false
    }

    fn record_victory(&self) {
        self.current_match.state = ChallengeState::VICTORY
        self.current_progress.total_wins = self.current_progress.total_wins + 1

        let opponent_idx = general_to_index(self.current_match.opponent.general)
        self.current_progress.defeated_generals[opponent_idx] = true

        // Record fastest time
        if self.current_progress.fastest_victory_time[opponent_idx] == 0.0 ||
           self.current_match.match_time < self.current_progress.fastest_victory_time[opponent_idx] {
            self.current_progress.fastest_victory_time[opponent_idx] = self.current_match.match_time
        }

        // Advance to next opponent
        self.current_progress.current_opponent = self.current_progress.current_opponent + 1

        // Check if all generals defeated
        if self.current_progress.current_opponent >= 10 {
            self.current_progress.all_generals_defeated = true
            self.current_progress.medal_earned = true
        }

        self.showing_victory_screen = true
    }

    fn record_defeat(&self) {
        self.current_match.state = ChallengeState::DEFEAT
        self.current_progress.total_losses = self.current_progress.total_losses + 1
        self.showing_defeat_screen = true
    }

    fn update(&self, delta_time: f32) {
        if self.current_match.state == ChallengeState::IN_PROGRESS {
            self.current_match.match_time = self.current_match.match_time + delta_time

            // Update taunt cooldown
            if self.taunt_cooldown > 0.0 {
                self.taunt_cooldown = self.taunt_cooldown - delta_time
            }
        }
    }

    fn play_opponent_taunt(&self, taunt_type: i32) {
        if self.taunt_cooldown <= 0.0 && !self.current_taunt_playing {
            // 0 = intro, 1 = attack, 2 = defend, 3 = superweapon, 4 = victory, 5 = defeat
            self.current_taunt_playing = true
            self.taunt_cooldown = 30.0  // 30 second cooldown between taunts

            // Would play audio and show text
        }
    }
}

// Helper function to convert general enum to index
fn general_to_index(general: ChallengeGeneral): i32 {
    if general == ChallengeGeneral::USA_BOSS { return 0 }
    if general == ChallengeGeneral::USA_AIRFORCE { return 1 }
    if general == ChallengeGeneral::USA_LASER { return 2 }
    if general == ChallengeGeneral::USA_SUPERWEAPON { return 3 }
    if general == ChallengeGeneral::CHINA_BOSS { return 4 }
    if general == ChallengeGeneral::CHINA_TANK { return 5 }
    if general == ChallengeGeneral::CHINA_INFANTRY { return 6 }
    if general == ChallengeGeneral::CHINA_NUKE { return 7 }
    if general == ChallengeGeneral::GLA_BOSS { return 8 }
    if general == ChallengeGeneral::GLA_TOXIN { return 9 }
    if general == ChallengeGeneral::GLA_DEMOLITION { return 10 }
    if general == ChallengeGeneral::GLA_STEALTH { return 11 }
    return 0
}

fn get_difficulty_modifier(difficulty: ChallengeDifficulty): f32 {
    if difficulty == ChallengeDifficulty::EASY { return 0.7 }
    if difficulty == ChallengeDifficulty::NORMAL { return 1.0 }
    if difficulty == ChallengeDifficulty::HARD { return 1.3 }
    if difficulty == ChallengeDifficulty::BRUTAL { return 1.6 }
    return 1.0
}

fn apply_general_bonuses(manager: ChallengeManager, opponent: GeneralProfile) {
    // Apply AI bonuses based on general profile
    let difficulty_mod = get_difficulty_modifier(manager.current_match.difficulty)

    // Starting cash bonus
    let bonus_cash = opponent.starts_with_bonus_cash * difficulty_mod

    // AI gets faster ability cooldowns
    let cooldown_mod = opponent.special_ability_cooldown_modifier *
                       (1.0 - (difficulty_mod - 1.0) * 0.1)

    // Apply other modifiers based on difficulty
}

// ============================================================================
// CHALLENGE UI
// ============================================================================

struct ChallengeUI {
    general_select_buttons: [i32],
    selected_general_highlight: i32,

    opponent_portrait_x: i32,
    opponent_portrait_y: i32,

    progress_bar_x: i32,
    progress_bar_y: i32,
    progress_bar_width: i32,

    taunt_text_x: i32,
    taunt_text_y: i32,
    taunt_text_visible: bool,
    taunt_text_timer: f32,
}

impl ChallengeUI {
    fn init(): ChallengeUI {
        let buttons: [i32] = []
        for i in 0..10 {
            buttons = buttons + [0]
        }
        return ChallengeUI {
            general_select_buttons: buttons,
            selected_general_highlight: -1,
