// ============================================================================
// GLOBAL INSTANCE
// ============================================================================

let g_challenge_manager: ChallengeManager? = null

fn init_challenge_manager(): ChallengeManager {
    let manager = ChallengeManager::init()
    g_challenge_manager = manager
    return manager
}

fn get_challenge_manager(): ChallengeManager? {
    return g_challenge_manager
}

fn shutdown_challenge_manager() {
    g_challenge_manager = null
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

fn test_generals_challenge() {
    print("Testing Generals Challenge Mode...")

    // Create manager
    let manager = ChallengeManager::init()
    print("Challenge manager created")

    // Test general profiles
    print("All generals loaded: " + str(manager.all_generals.length))
    print("General 0: " + manager.all_generals[0].name)
    print("General 9 (Boss): " + manager.all_generals[9].name)

    // Test player selection
    manager.select_player_general(ChallengeGeneral::USA_AIRFORCE)
    print("Player selected: USA Air Force General")

    // Test ladder generation
    print("Challenge ladder generated")
    print("Final opponent: General Leang (Boss)")

    // Test match start
    manager.start_challenge_match()
    print("Match started against: " + manager.current_match.opponent.name)
    print("Map: " + manager.current_match.map_name)

    // Test difficulty modifiers
    let easy_mod = get_difficulty_modifier(ChallengeDifficulty::EASY)
    let brutal_mod = get_difficulty_modifier(ChallengeDifficulty::BRUTAL)
    print("Easy modifier: " + str(easy_mod))
    print("Brutal modifier: " + str(brutal_mod))

    // Test victory recording
    manager.current_match.match_time = 1200.0  // 20 minutes
    manager.record_victory()
    print("Victory recorded")
    print("Total wins: " + str(manager.current_progress.total_wins))
    print("Next opponent index: " + str(manager.current_progress.current_opponent))

    // Test UI
    let ui = ChallengeUI::init()
    print("Challenge UI created")

    print("Generals Challenge Mode tests complete!")
}
