// Weapon Definition Parser - Parses weapon INI files for C&C Generals
// Handles Weapon blocks from Data/INI/Weapon.ini and related files

let MAX_WEAPONS: i32 = 1024
let MAX_DAMAGE_NUGGETS: i32 = 8
let MAX_ERRORS: i32 = 256

// Weapon damage types matching Thyme's DamageType enum
enum DamageType {
    Explosion,
    Crush,
    Armor_Piercing,
    Small_Arms,
    Gattling,
    Radiation,
    Flame,
    Laser,
    Sniper,
    Poison,
    Healing,
    Unresistable,
    Water,
    DeployDeath,
    Surrender,
    Hack,
    Kill_Pilot,
    Penalty,
    Falling,
    Melee,
    Disarm,
    Hazard_Cleanup,
    Particle_Beam,
    Toppling,
    Infantry_Missile,
    Aurora_Bomb,
    Land_Mine,
    JetFuel,
    Stealthjet_Missile,
    Molotov,
    Comanche_Vulcan,
    FlakBullet,
    Status,
    Subdual_Damage,
    Microwave,
}

// Weapon fire types
enum WeaponFireType {
    Primary,
    Secondary,
    Tertiary,
}

// Projectile detonation types
enum DetonationType {
    Contact,
    Proximity,
    Timed,
    AtTarget,
}

// Weapon scatter types
enum ScatterType {
    None,
    Circle,
    Line,
    Ring,
}

// A single damage nugget within a weapon
struct DamageNugget {
    damage: f32,
    radius: f32,
    damage_type: DamageType,
    death_type: string,
    damage_scalar_infantry: f32,
    damage_scalar_vehicle: f32,
    damage_scalar_structure: f32,
    damage_scalar_air: f32,
    damage_arc: f32,
    damage_max_height: f32,
    damage_speed: f32,
    delay_time: i32,
    is_valid: bool,
}

impl DamageNugget {
    fn init(): DamageNugget {
        return DamageNugget {
            damage: 0.0,
            radius: 0.0,
            damage_type: DamageType::Explosion,
            death_type: "",
            damage_scalar_infantry: 1.0,
            damage_scalar_vehicle: 1.0,
            damage_scalar_structure: 1.0,
            damage_scalar_air: 1.0,
            damage_arc: 360.0,
            damage_max_height: 0.0,
            damage_speed: 0.0,
            delay_time: 0,
            is_valid: false,
        }
    }
}

// Weapon projectile definition
struct ProjectileData {
    projectile_name: string,
    projectile_speed: f32,
    projectile_arc: f32,
    projectile_turn_rate: f32,
    projectile_self_homing: bool,
    detonation_type: DetonationType,
    detonation_delay: i32,
    projectile_fx: string,
    exhaust_fx: string,
    is_valid: bool,
}

impl ProjectileData {
    fn init(): ProjectileData {
        return ProjectileData {
            projectile_name: "",
            projectile_speed: 0.0,
            projectile_arc: 0.0,
            projectile_turn_rate: 0.0,
            projectile_self_homing: false,
            detonation_type: DetonationType::Contact,
            detonation_delay: 0,
            projectile_fx: "",
            exhaust_fx: "",
            is_valid: false,
        }
    }
}

// Complete weapon definition
struct WeaponDefinition {
    name: string,

    // Attack parameters
    attack_range: f32,
    minimum_attack_range: f32,
    range_bonus_per_rank: f32,
    request_assist_range: f32,

    // Damage
    primary_damage: f32,
    primary_damage_radius: f32,
    secondary_damage: f32,
    secondary_damage_radius: f32,
    damage_type: DamageType,
    death_type: string,

    // Damage nuggets (modern INI format)
    damage_nuggets: [DamageNugget],
    damage_nugget_count: i32,

    // Firing mechanics
    delay_between_shots: i32,
    pre_attack_delay: i32,
    fire_sound_loop_time: i32,
    clip_size: i32,
    clip_reload_time: i32,
    auto_reload_when_idle: bool,
    continue_attack_range: f32,

    // Targeting
    anti_mask: i32,
    affected_by_mask: i32,
    scatter_radius: f32,
    scatter_radius_vs_infantry: f32,
    scatter_target_scalar: f32,
    scatter_type: ScatterType,

    // Projectile
    projectile: ProjectileData,

    // Bonuses
    damage_bonus_percent: f32,
    rate_of_fire_bonus_percent: f32,

    // Visual/Audio
    fire_fx: string,
    fire_fx_bone: string,
    fire_sound: string,
    weapon_template_id: i32,

    is_valid: bool,
}

impl WeaponDefinition {
    fn init(): WeaponDefinition {
        let nuggets: [DamageNugget] = []
        for i in 0..MAX_DAMAGE_NUGGETS {
            nuggets = nuggets + [DamageNugget::init()]
        }
        return WeaponDefinition {
            name: "",
            attack_range: 0.0,
            minimum_attack_range: 0.0,
            range_bonus_per_rank: 0.0,
            request_assist_range: 0.0,
            primary_damage: 0.0,
            primary_damage_radius: 0.0,
            secondary_damage: 0.0,
            secondary_damage_radius: 0.0,
            damage_type: DamageType::Explosion,
            death_type: "",
            damage_nuggets: nuggets,
            damage_nugget_count: 0,
            delay_between_shots: 0,
            pre_attack_delay: 0,
            fire_sound_loop_time: 0,
            clip_size: 0,
            clip_reload_time: 0,
            auto_reload_when_idle: true,
            continue_attack_range: 0.0,
            anti_mask: 0,
            affected_by_mask: 0,
            scatter_radius: 0.0,
            scatter_radius_vs_infantry: 0.0,
            scatter_target_scalar: 1.0,
            scatter_type: ScatterType::None,
            projectile: ProjectileData::init(),
            damage_bonus_percent: 0.0,
            rate_of_fire_bonus_percent: 0.0,
            fire_fx: "",
            fire_fx_bone: "",
            fire_sound: "",
            weapon_template_id: 0,
            is_valid: false,
        }
    }
}

// Weapon name to index entry
struct WeaponNameEntry {
    name: string,
    index: i32,
}

impl WeaponNameEntry {
    fn init(): WeaponNameEntry {
        return WeaponNameEntry { name: "", index: -1 }
    }
}

struct WeaponDefinitionParser {
    weapons: [WeaponDefinition],
    weapon_count: i32,
    weapon_names: [WeaponNameEntry],
    name_count: i32,

    // Current parse state
    current_weapon: i32,
    current_nugget: i32,
    in_weapon_block: bool,
    in_damage_nugget: bool,
    in_projectile_block: bool,

    // Error tracking
    parse_errors: [string],
    error_count: i32,
}

impl WeaponDefinitionParser {
    fn init(): WeaponDefinitionParser {
        let weapons: [WeaponDefinition] = []
        for i in 0..MAX_WEAPONS {
            weapons = weapons + [WeaponDefinition::init()]
        }
        let names: [WeaponNameEntry] = []
        for i in 0..MAX_WEAPONS {
            names = names + [WeaponNameEntry::init()]
        }
        let errors: [string] = []
        for i in 0..MAX_ERRORS {
            errors = errors + [""]
        }
        return WeaponDefinitionParser {
            weapons: weapons,
            weapon_count: 0,
            weapon_names: names,
            name_count: 0,
            current_weapon: 0,
            current_nugget: 0,
            in_weapon_block: false,
            in_damage_nugget: false,
            in_projectile_block: false,
            parse_errors: errors,
            error_count: 0,
        }
    }

    fn parse_file(&self, content: string): bool {
        if string_length(content) == 0 {
            self.add_error("Empty file content")
            return false
        }

        let lines = split_lines(content)
        let line_num = 0

        for i in 0..lines.length {
            line_num = line_num + 1
            let trimmed = trim_string(lines[i])

            // Skip empty lines and comments
            if string_length(trimmed) == 0 {
                continue
            }
            if starts_with(trimmed, ";") || starts_with(trimmed, "//") {
                continue
            }

            if !self.parse_line(trimmed, line_num) {
                return false
            }
        }

        return true
    }

    fn parse_line(&self, line: string, line_num: i32): bool {
        // Handle block starts
        if starts_with(line, "Weapon ") {
            return self.begin_weapon_block(line)
        }

        if starts_with(line, "DamageNugget") {
            return self.begin_damage_nugget()
        }

        if starts_with(line, "ProjectileNugget") {
            return self.begin_projectile_block()
        }

        // Handle block ends
        if line == "End" {
            return self.end_current_block()
        }

        // Parse properties within blocks
        if self.in_damage_nugget {
            return self.parse_damage_nugget_property(line)
        }

        if self.in_projectile_block {
            return self.parse_projectile_property(line)
        }

        if self.in_weapon_block {
            return self.parse_weapon_property(line)
        }

        return true
    }

    fn begin_weapon_block(&self, line: string): bool {
        if self.weapon_count >= MAX_WEAPONS {
            self.add_error("Maximum weapon count exceeded")
            return false
        }

        // Parse weapon name: "Weapon WeaponName" or "Weapon WeaponName : ParentWeapon"
        let parts = split_by_space(line)
        if parts.length < 2 {
            self.add_error("Invalid weapon declaration: " + line)
            return false
        }

        let weapon_name = parts[1]
        let parent_name = ""

        // Check for inheritance
        if contains(line, ":") {
            let inherit_parts = split_by_char(line, ":")
            if inherit_parts.length >= 2 {
                let name_parts = split_by_space(inherit_parts[0])
                if name_parts.length >= 2 {
                    weapon_name = name_parts[1]
                }
                parent_name = trim_string(inherit_parts[1])
            }
        }

        self.current_weapon = self.weapon_count
        self.weapons[self.current_weapon] = WeaponDefinition::init()
        self.weapons[self.current_weapon].name = weapon_name
        self.weapons[self.current_weapon].is_valid = true

        // Handle inheritance
        if string_length(parent_name) > 0 {
            self.inherit_from(parent_name)
        }

        // Register name
        self.weapon_names[self.name_count].name = weapon_name
        self.weapon_names[self.name_count].index = self.current_weapon
        self.name_count = self.name_count + 1

        self.weapon_count = self.weapon_count + 1
        self.in_weapon_block = true

        return true
    }

    fn inherit_from(&self, parent_name: string) {
        let parent_idx = self.find_weapon_index(parent_name)
        if parent_idx >= 0 {
            let parent = self.weapons[parent_idx]
            let current = self.weapons[self.current_weapon]

            // Copy all values from parent
            current.attack_range = parent.attack_range
            current.minimum_attack_range = parent.minimum_attack_range
            current.primary_damage = parent.primary_damage
            current.primary_damage_radius = parent.primary_damage_radius
            current.secondary_damage = parent.secondary_damage
            current.secondary_damage_radius = parent.secondary_damage_radius
            current.damage_type = parent.damage_type
            current.death_type = parent.death_type
            current.delay_between_shots = parent.delay_between_shots
            current.pre_attack_delay = parent.pre_attack_delay
            current.clip_size = parent.clip_size
            current.clip_reload_time = parent.clip_reload_time
            current.fire_fx = parent.fire_fx
            current.fire_sound = parent.fire_sound
            current.projectile = parent.projectile

            // Copy damage nuggets
            for i in 0..parent.damage_nugget_count {
                current.damage_nuggets[i] = parent.damage_nuggets[i]
            }
            current.damage_nugget_count = parent.damage_nugget_count
        }
    }

    fn find_weapon_index(&self, name: string): i32 {
        for i in 0..self.name_count {
            if self.weapon_names[i].name == name {
                return self.weapon_names[i].index
            }
        }
        return -1
    }

    fn begin_damage_nugget(&self): bool {
        if !self.in_weapon_block {
            self.add_error("DamageNugget outside of Weapon block")
            return false
        }

        let weapon = self.weapons[self.current_weapon]
        if weapon.damage_nugget_count >= MAX_DAMAGE_NUGGETS {
            self.add_error("Maximum damage nuggets exceeded")
            return false
        }

        self.current_nugget = weapon.damage_nugget_count
        weapon.damage_nuggets[self.current_nugget] = DamageNugget::init()
        weapon.damage_nuggets[self.current_nugget].is_valid = true
        weapon.damage_nugget_count = weapon.damage_nugget_count + 1

        self.in_damage_nugget = true
        return true
    }

    fn begin_projectile_block(&self): bool {
        if !self.in_weapon_block {
            self.add_error("ProjectileNugget outside of Weapon block")
            return false
        }

        self.weapons[self.current_weapon].projectile = ProjectileData::init()
        self.weapons[self.current_weapon].projectile.is_valid = true
        self.in_projectile_block = true
        return true
    }

    fn end_current_block(&self): bool {
        if self.in_damage_nugget {
            self.in_damage_nugget = false
        } else if self.in_projectile_block {
            self.in_projectile_block = false
        } else if self.in_weapon_block {
            self.in_weapon_block = false
        }
        return true
    }

    fn parse_weapon_property(&self, line: string): bool {
        let kv = self.split_property(line)
        if string_length(kv.key) == 0 {
            return true
        }

        let key = kv.key
        let value = kv.value
        let weapon = self.weapons[self.current_weapon]

        if key == "AttackRange" {
            weapon.attack_range = parse_f32(value)
        } else if key == "MinimumAttackRange" {
            weapon.minimum_attack_range = parse_f32(value)
        } else if key == "RangeBonusPerRank" {
            weapon.range_bonus_per_rank = parse_f32(value)
        } else if key == "RequestAssistRange" {
            weapon.request_assist_range = parse_f32(value)
        } else if key == "PrimaryDamage" {
            weapon.primary_damage = parse_f32(value)
        } else if key == "PrimaryDamageRadius" {
            weapon.primary_damage_radius = parse_f32(value)
        } else if key == "SecondaryDamage" {
            weapon.secondary_damage = parse_f32(value)
        } else if key == "SecondaryDamageRadius" {
            weapon.secondary_damage_radius = parse_f32(value)
        } else if key == "DamageType" {
            weapon.damage_type = self.parse_damage_type(value)
        } else if key == "DeathType" {
            weapon.death_type = value
        } else if key == "DelayBetweenShots" {
            weapon.delay_between_shots = parse_i32(value)
        } else if key == "PreAttackDelay" {
            weapon.pre_attack_delay = parse_i32(value)
        } else if key == "FireSoundLoopTime" {
            weapon.fire_sound_loop_time = parse_i32(value)
        } else if key == "ClipSize" {
            weapon.clip_size = parse_i32(value)
        } else if key == "ClipReloadTime" {
            weapon.clip_reload_time = parse_i32(value)
        } else if key == "AutoReloadWhenIdle" {
            weapon.auto_reload_when_idle = parse_bool(value)
        } else if key == "ContinueAttackRange" {
            weapon.continue_attack_range = parse_f32(value)
        } else if key == "AntiMask" {
            weapon.anti_mask = self.parse_anti_mask(value)
        } else if key == "ScatterRadius" {
            weapon.scatter_radius = parse_f32(value)
        } else if key == "ScatterRadiusVsInfantry" {
            weapon.scatter_radius_vs_infantry = parse_f32(value)
        } else if key == "ScatterTargetScalar" {
            weapon.scatter_target_scalar = parse_f32(value)
        } else if key == "FireFX" {
            weapon.fire_fx = value
        } else if key == "FireFXBone" {
            weapon.fire_fx_bone = value
        } else if key == "FireSound" {
            weapon.fire_sound = value
        } else if key == "ProjectileObject" || key == "ProjectileStreamName" {
            weapon.projectile.projectile_name = value
        } else if key == "DamageBonusPercent" {
            weapon.damage_bonus_percent = parse_f32(value)
        } else if key == "RateOfFireBonusPercent" {
            weapon.rate_of_fire_bonus_percent = parse_f32(value)
        }
        // Unknown properties are ignored

        return true
    }

    fn parse_damage_nugget_property(&self, line: string): bool {
        let kv = self.split_property(line)
        if string_length(kv.key) == 0 {
            return true
        }

        let key = kv.key
        let value = kv.value
        let nugget = self.weapons[self.current_weapon].damage_nuggets[self.current_nugget]

        if key == "Damage" {
            nugget.damage = parse_f32(value)
        } else if key == "Radius" {
            nugget.radius = parse_f32(value)
        } else if key == "DamageType" {
            nugget.damage_type = self.parse_damage_type(value)
        } else if key == "DeathType" {
            nugget.death_type = value
        } else if key == "DamageScalar" {
            self.parse_damage_scalar(value, nugget)
        } else if key == "DamageArc" {
            nugget.damage_arc = parse_f32(value)
        } else if key == "DamageMaxHeight" {
            nugget.damage_max_height = parse_f32(value)
        } else if key == "DamageSpeed" {
            nugget.damage_speed = parse_f32(value)
        } else if key == "DelayTime" {
            nugget.delay_time = parse_i32(value)
        }

        return true
    }

    fn parse_projectile_property(&self, line: string): bool {
        let kv = self.split_property(line)
        if string_length(kv.key) == 0 {
            return true
        }

        let key = kv.key
        let value = kv.value
        let projectile = self.weapons[self.current_weapon].projectile

        if key == "ProjectileName" {
            projectile.projectile_name = value
        } else if key == "ProjectileSpeed" {
            projectile.projectile_speed = parse_f32(value)
        } else if key == "ProjectileArc" {
            projectile.projectile_arc = parse_f32(value)
        } else if key == "ProjectileTurnRate" {
            projectile.projectile_turn_rate = parse_f32(value)
        } else if key == "ProjectileSelfHoming" {
            projectile.projectile_self_homing = parse_bool(value)
        } else if key == "DetonationType" {
            projectile.detonation_type = self.parse_detonation_type(value)
        } else if key == "DetonationDelay" {
            projectile.detonation_delay = parse_i32(value)
        } else if key == "ProjectileFX" {
            projectile.projectile_fx = value
        } else if key == "ExhaustFX" {
            projectile.exhaust_fx = value
        }

        return true
    }

    fn parse_damage_type(&self, value: string): DamageType {
        let upper = to_uppercase(value)
        if upper == "EXPLOSION" { return DamageType::Explosion }
        if upper == "CRUSH" { return DamageType::Crush }
        if upper == "ARMOR_PIERCING" { return DamageType::Armor_Piercing }
        if upper == "SMALL_ARMS" { return DamageType::Small_Arms }
        if upper == "GATTLING" { return DamageType::Gattling }
        if upper == "RADIATION" { return DamageType::Radiation }
        if upper == "FLAME" { return DamageType::Flame }
        if upper == "LASER" { return DamageType::Laser }
        if upper == "SNIPER" { return DamageType::Sniper }
        if upper == "POISON" { return DamageType::Poison }
        if upper == "HEALING" { return DamageType::Healing }
        if upper == "UNRESISTABLE" { return DamageType::Unresistable }
        if upper == "WATER" { return DamageType::Water }
        if upper == "DEPLOYDEATH" { return DamageType::DeployDeath }
        if upper == "SURRENDER" { return DamageType::Surrender }
        if upper == "HACK" { return DamageType::Hack }
        if upper == "KILL_PILOT" { return DamageType::Kill_Pilot }
        if upper == "PENALTY" { return DamageType::Penalty }
        if upper == "FALLING" { return DamageType::Falling }
        if upper == "MELEE" { return DamageType::Melee }
        if upper == "DISARM" { return DamageType::Disarm }
        if upper == "HAZARD_CLEANUP" { return DamageType::Hazard_Cleanup }
        if upper == "PARTICLE_BEAM" { return DamageType::Particle_Beam }
        if upper == "TOPPLING" { return DamageType::Toppling }
        if upper == "INFANTRY_MISSILE" { return DamageType::Infantry_Missile }
        if upper == "AURORA_BOMB" { return DamageType::Aurora_Bomb }
        if upper == "LAND_MINE" { return DamageType::Land_Mine }
        if upper == "JETFUEL" { return DamageType::JetFuel }
        if upper == "STEALTHJET_MISSILE" { return DamageType::Stealthjet_Missile }
        if upper == "MOLOTOV" { return DamageType::Molotov }
        if upper == "COMANCHE_VULCAN" { return DamageType::Comanche_Vulcan }
        if upper == "FLAKBULLET" { return DamageType::FlakBullet }
        if upper == "STATUS" { return DamageType::Status }
        if upper == "SUBDUAL_DAMAGE" { return DamageType::Subdual_Damage }
        if upper == "MICROWAVE" { return DamageType::Microwave }
        return DamageType::Explosion
    }

    fn parse_detonation_type(&self, value: string): DetonationType {
        let upper = to_uppercase(value)
        if upper == "CONTACT" { return DetonationType::Contact }
        if upper == "PROXIMITY" { return DetonationType::Proximity }
        if upper == "TIMED" { return DetonationType::Timed }
        if upper == "ATTARGET" { return DetonationType::AtTarget }
        return DetonationType::Contact
    }

    fn parse_damage_scalar(&self, value: string, nugget: DamageNugget) {
        // Format: "INFANTRY:200% VEHICLE:50%"
        let parts = split_by_space(value)
        for i in 0..parts.length {
            let part = parts[i]
            if contains(part, ":") {
                let kv_parts = split_by_char(part, ":")
                if kv_parts.length == 2 {
                    let target = to_uppercase(kv_parts[0])
                    let scalar = parse_percent(kv_parts[1])
                    if target == "INFANTRY" {
                        nugget.damage_scalar_infantry = scalar
                    } else if target == "VEHICLE" {
                        nugget.damage_scalar_vehicle = scalar
                    } else if target == "STRUCTURE" {
                        nugget.damage_scalar_structure = scalar
                    } else if target == "AIR" {
                        nugget.damage_scalar_air = scalar
                    }
                }
            }
        }
    }

    fn parse_anti_mask(&self, value: string): i32 {
        let mask = 0
        let parts = split_by_space(value)
        for i in 0..parts.length {
            let part = to_uppercase(parts[i])
            if part == "ANTI_GROUND" { mask = mask | 1 }
            if part == "ANTI_INFANTRY" { mask = mask | 2 }
            if part == "ANTI_VEHICLE" { mask = mask | 4 }
            if part == "ANTI_STRUCTURE" { mask = mask | 8 }
            if part == "ANTI_AIRBORNE_VEHICLE" { mask = mask | 16 }
            if part == "ANTI_AIRBORNE_INFANTRY" { mask = mask | 32 }
            if part == "ANTI_MINE" { mask = mask | 64 }
            if part == "ANTI_PROJECTILE" { mask = mask | 128 }
            if part == "ANTI_SMALL_MISSILE" { mask = mask | 256 }
            if part == "ANTI_PARACHUTE" { mask = mask | 512 }
            if part == "ANTI_BALLISTIC_MISSILE" { mask = mask | 1024 }
        }
        return mask
    }

    fn split_property(&self, line: string): KeyValue {
        // Split "Key = Value" or "Key Value"
        let line_len = string_length(line)
        let eq_pos = find_char(line, "=")
        if eq_pos >= 0 {
            return KeyValue {
                key: trim_string(substring(line, 0, eq_pos)),
                value: trim_string(substring(line, eq_pos + 1, line_len)),
            }
        }

        let space_pos = find_char(line, " ")
        if space_pos >= 0 {
            return KeyValue {
                key: trim_string(substring(line, 0, space_pos)),
                value: trim_string(substring(line, space_pos + 1, line_len)),
            }
        }

        return KeyValue { key: line, value: "" }
    }

    fn add_error(&self, msg: string) {
        if self.error_count < MAX_ERRORS {
            self.parse_errors[self.error_count] = msg
            self.error_count = self.error_count + 1
        }
    }

    // Public API for accessing weapons
    fn get_weapon(&self, name: string): WeaponDefinition? {
        let idx = self.find_weapon_index(name)
        if idx >= 0 {
            return self.weapons[idx]
        }
        return null
    }

    fn get_weapon_by_index(&self, index: i32): WeaponDefinition? {
        if index >= 0 && index < self.weapon_count {
            return self.weapons[index]
        }
        return null
    }

    fn get_weapon_count(&self): i32 {
        return self.weapon_count
    }
}

// Key-Value pair for property parsing
struct KeyValue {
    key: string,
    value: string,
}

// ============================================================================
// String Helper Functions
// ============================================================================

fn string_length(s: string): i32 {
    // Returns string length using built-in intrinsic
    // Placeholder - actual implementation is a compiler built-in
    return 0
}

fn split_lines(content: string): [string] {
    let lines: [string] = []
    let current = ""
    let content_len = string_length(content)
    for i in 0..content_len {
        let c = content.char_at(i)
        if c == "\n" {
            lines = lines + [current]
            current = ""
        } else if c != "\r" {
            current = current + c
        }
    }
    if string_length(current) > 0 {
        lines = lines + [current]
    }
    return lines
}

fn split_by_space(s: string): [string] {
    let parts: [string] = []
    let current = ""
    let s_len = string_length(s)
    for i in 0..s_len {
        let c = s.char_at(i)
        if c == " " || c == "\t" {
            if string_length(current) > 0 {
                parts = parts + [current]
                current = ""
            }
        } else {
            current = current + c
        }
    }
    if string_length(current) > 0 {
        parts = parts + [current]
    }
    return parts
}

fn split_by_char(s: string, delim: string): [string] {
    let parts: [string] = []
    let current = ""
    let s_len = string_length(s)
    for i in 0..s_len {
        let c = s.char_at(i)
        if c == delim {
            parts = parts + [current]
            current = ""
        } else {
            current = current + c
        }
    }
    parts = parts + [current]
    return parts
}

fn trim_string(s: string): string {
    let start = 0
    let s_len = string_length(s)
    let end = s_len

    while start < end {
        let c = s.char_at(start)
        if c != " " && c != "\t" && c != "\r" && c != "\n" {
            break
        }
        start = start + 1
    }

    while end > start {
        let c = s.char_at(end - 1)
        if c != " " && c != "\t" && c != "\r" && c != "\n" {
            break
        }
        end = end - 1
    }

    return substring(s, start, end)
}

fn substring(s: string, start: i32, end: i32): string {
    let result = ""
    let s_len = string_length(s)
    for i in start..end {
        if i < s_len {
            result = result + s.char_at(i)
        }
    }
    return result
}

fn starts_with(s: string, prefix: string): bool {
    let prefix_len = string_length(prefix)
    let s_len = string_length(s)
    if prefix_len > s_len {
        return false
    }
    for i in 0..prefix_len {
        if s.char_at(i) != prefix.char_at(i) {
            return false
        }
    }
    return true
}

fn contains(s: string, substr: string): bool {
    return find_char(s, substr) >= 0
}

fn find_char(s: string, c: string): i32 {
    let s_len = string_length(s)
    for i in 0..s_len {
        if s.char_at(i) == c {
            return i
        }
    }
    return -1
}

fn to_uppercase(s: string): string {
    let result = ""
    let s_len = string_length(s)
    for i in 0..s_len {
        let c = s.char_at(i)
        let code = c as i32
        if code >= 97 && code <= 122 {  // a-z
            result = result + ((code - 32) as string)
        } else {
            result = result + c
        }
    }
    return result
}

fn parse_f32(value: string): f32 {
    let trimmed = trim_string(value)
    // Simplified float parsing
    let result = 0.0
    let decimal_seen = false
    let decimal_place = 1.0
    let negative = false
    let trimmed_len = string_length(trimmed)

    for i in 0..trimmed_len {
        let c = trimmed.char_at(i)
        if c == "-" && i == 0 {
            negative = true
        } else if c == "." {
            decimal_seen = true
        } else if c >= "0" && c <= "9" {
            let digit = (c as i32) - 48
            if decimal_seen {
                decimal_place = decimal_place * 10.0
                result = result + (digit as f32) / decimal_place
            } else {
                result = result * 10.0 + (digit as f32)
            }
        }
    }

    if negative {
        result = -result
    }
    return result
}

fn parse_i32(value: string): i32 {
    let trimmed = trim_string(value)
    let result = 0
    let negative = false
    let trimmed_len = string_length(trimmed)

    for i in 0..trimmed_len {
        let c = trimmed.char_at(i)
        if c == "-" && i == 0 {
            negative = true
        } else if c >= "0" && c <= "9" {
            result = result * 10 + ((c as i32) - 48)
        }
    }

    if negative {
        result = -result
    }
    return result
}

fn parse_bool(value: string): bool {
    let v = to_uppercase(trim_string(value))
    return v == "YES" || v == "TRUE" || v == "1"
}

fn parse_percent(value: string): f32 {
    // Parse "200%" -> 2.0
    let trimmed = trim_string(value)
    let num_str = ""
    let trimmed_len = string_length(trimmed)
    for i in 0..trimmed_len {
        let c = trimmed.char_at(i)
        if c != "%" {
            num_str = num_str + c
        }
    }
    return parse_f32(num_str) / 100.0
}

