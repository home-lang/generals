// Tests
// ============================================================================

fn test_weapon_parser() {
    print("Testing Weapon Definition Parser...")

    let parser = WeaponDefinitionParser::init()
    print("  Created parser")

    // Test sample weapon definition
    let sample = "Weapon TestWeapon\n  AttackRange = 150.0\n  PrimaryDamage = 25.0\n  DamageType = EXPLOSION\n  ClipSize = 30\nEnd\n"

    parser.parse_file(sample)
    print("  Parsed sample weapon")
    print("  Weapon count: " + str(parser.weapon_count))

    if parser.weapon_count > 0 {
        let weapon = parser.weapons[0]
        print("  Weapon name: " + weapon.name)
        print("  Attack range: " + str(weapon.attack_range))
        print("  Primary damage: " + str(weapon.primary_damage))
        print("  Clip size: " + str(weapon.clip_size))
    }

    // Test damage type parsing
    print("  EXPLOSION = " + str(parser.parse_damage_type("EXPLOSION") as i32))
    print("  LASER = " + str(parser.parse_damage_type("LASER") as i32))

    print("Weapon Definition Parser tests complete!")
}
