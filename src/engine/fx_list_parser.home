// ============================================================================
// Tests
// ============================================================================

fn test_fx_nugget_creation() {
    print("Testing FX nugget creation...")

    let nugget = FXNugget::init()
    nugget.nugget_type = FXNuggetType::SOUND
    nugget.sound_name = "ExplosionLarge"
    nugget.sound_volume = 0.8
    nugget.is_valid = true

    print("Created sound nugget: " + nugget.sound_name)
    print("Volume: " + str(nugget.sound_volume))
}

fn test_fx_list_creation() {
    print("Testing FX list creation...")

    let fx_list = FXListDefinition::init()
    fx_list.name = "FX_TestExplosion"
    fx_list.is_valid = true

    // Add sound nugget
    let sound_nugget = FXNugget::init()
    sound_nugget.nugget_type = FXNuggetType::SOUND
    sound_nugget.sound_name = "ExplosionSound"
    sound_nugget.is_valid = true
    fx_list.add_nugget(sound_nugget)

    // Add particle nugget
    let particle_nugget = FXNugget::init()
    particle_nugget.nugget_type = FXNuggetType::PARTICLE_SYSTEM
    particle_nugget.particle_system_name = "ExplosionParticles"
    particle_nugget.is_valid = true
    fx_list.add_nugget(particle_nugget)

    print("Created FX list: " + fx_list.name)
    print("Nugget count: " + str(fx_list.nugget_count))
}

fn test_color_parsing() {
    print("Testing color parsing...")

    let parser = FXListParser::init()

    // Test R:G:B: format
    let color1 = parser.parse_color("R:255 G:128 B:64")
    print("Color1 R: " + str(color1.r))
    print("Color1 G: " + str(color1.g))
    print("Color1 B: " + str(color1.b))
}

fn test_vec3_parsing() {
    print("Testing Vec3 parsing...")

    let parser = FXListParser::init()

    let vec = parser.parse_vec3("X:10.5 Y:20.0 Z:30.5")
    print("Vec X: " + str(vec.x))
    print("Vec Y: " + str(vec.y))
    print("Vec Z: " + str(vec.z))
}

fn test_fx_system() {
    print("Testing FX system...")

    let fx_system = FXSystem::init()

    // Play an effect
    let position = Vec3 { x: 100.0, y: 0.0, z: 100.0 }
    // fx_system.play_fx("FX_SmallExplosion", position)

    print("Active effects: " + str(fx_system.get_active_effect_count()))
}

fn run_all_tests() {
    print("Running FX list parser tests...")
    test_fx_nugget_creation()
    test_fx_list_creation()
    test_color_parsing()
    test_vec3_parsing()
    test_fx_system()
    print("All FX list parser tests complete!")
}
