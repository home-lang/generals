// FX List Parser - Parses FXList INI files for C&C Generals
// Handles FXList blocks from Data/INI/FXList.ini
//
// FX Lists define visual and audio effects for:
// - Unit deaths, explosions
// - Weapon firing effects
// - Building construction
// - Ability activations
// - Environmental effects

let MAX_FX_LISTS: i32 = 2048
let MAX_NUGGETS_PER_LIST: i32 = 16
let MAX_PARSE_ERRORS: i32 = 64

// ============================================================================
// FX Nugget Types
// ============================================================================

enum FXNuggetType {
    SOUND,
    PARTICLE_SYSTEM,
    DYNAMIC_DECAL,
    TERRAIN_SCORCH,
    VIEW_SHAKE,
    TINT_DRAWABLE,
    FX_LIST_AT_BONE,
    TRACER_FX,
    LIGHT_PULSE,
    LASER_FX,
    CAMERA_SHAKER_VOLUME,
    ATTACHED_MODEL,
    ATTACHED_PARTICLE_SYSTEM,
    STREAK,
}

// ============================================================================
// Vector and Color Types
// ============================================================================

struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

impl Vec3 {
    fn init(): Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }
}

struct Color {
    r: f64,
    g: f64,
    b: f64,
    a: f64,
}

impl Color {
    fn init(): Color {
        return Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }
    }

    fn from_rgb(r: i32, g: i32, b: i32): Color {
        return Color {
            r: r as f64 / 255.0,
            g: g as f64 / 255.0,
            b: b as f64 / 255.0,
            a: 1.0,
        }
    }
}

// ============================================================================
// FX Nugget
// ============================================================================

struct FXNugget {
    nugget_type: FXNuggetType,

    // Common properties
    name: string,
    required_flags: i32,
    excluded_flags: i32,

    // Sound nugget
    sound_name: string,
    sound_volume: f64,
    sound_min_volume: f64,
    sound_loop_count: i32,

    // Particle system
    particle_system_name: string,
    bone_name: string,
    orient_to_object: bool,
    offset: Vec3,
    attached_system_lifetime: f64,
    initial_delay: i32,

    // Decal
    decal_texture: string,
    decal_size: f64,
    decal_opacity: f64,
    decal_lifetime: i32,

    // View shake
    shake_intensity: f64,
    shake_duration: i32,
    shake_radius: f64,

    // Tint
    tint_color: Color,
    tint_pre_color_time: i32,
    tint_post_color_time: i32,
    tint_sustained_color_time: i32,

    // Light pulse
    light_color: Color,
    light_radius: f64,
    light_increase_time: i32,
    light_decrease_time: i32,

    // Tracer
    tracer_speed: f64,
    tracer_length: f64,
    tracer_width: f64,
    tracer_color: Color,
    tracer_probability: f64,

    is_valid: bool,
}

impl FXNugget {
    fn init(): FXNugget {
        return FXNugget {
            nugget_type: FXNuggetType::SOUND,
            name: "",
            required_flags: 0,
            excluded_flags: 0,
            sound_name: "",
            sound_volume: 1.0,
            sound_min_volume: 0.0,
            sound_loop_count: 1,
            particle_system_name: "",
            bone_name: "",
            orient_to_object: false,
            offset: Vec3::init(),
            attached_system_lifetime: 0.0,
            initial_delay: 0,
            decal_texture: "",
            decal_size: 1.0,
            decal_opacity: 1.0,
            decal_lifetime: 0,
            shake_intensity: 0.0,
            shake_duration: 0,
            shake_radius: 0.0,
            tint_color: Color::init(),
            tint_pre_color_time: 0,
            tint_post_color_time: 0,
            tint_sustained_color_time: 0,
            light_color: Color::init(),
            light_radius: 0.0,
            light_increase_time: 0,
            light_decrease_time: 0,
            tracer_speed: 0.0,
            tracer_length: 0.0,
            tracer_width: 0.0,
            tracer_color: Color::init(),
            tracer_probability: 1.0,
            is_valid: false,
        }
    }
}

// ============================================================================
// FX List Definition
// ============================================================================

struct FXListDefinition {
    name: string,
    nuggets: [FXNugget],
    nugget_count: i32,
    play_everywhere: bool,
    is_valid: bool,
}

impl FXListDefinition {
    fn init(): FXListDefinition {
        let nuggets: [FXNugget] = []
        for i in 0..MAX_NUGGETS_PER_LIST {
            nuggets = nuggets + [FXNugget::init()]
        }

        return FXListDefinition {
            name: "",
            nuggets: nuggets,
            nugget_count: 0,
            play_everywhere: false,
            is_valid: false,
        }
    }

    fn add_nugget(&self, nugget: FXNugget): bool {
        if self.nugget_count >= MAX_NUGGETS_PER_LIST {
            return false
        }

        self.nuggets[self.nugget_count] = nugget
        self.nugget_count = self.nugget_count + 1
        return true
    }

    fn get_nugget(&self, index: i32): FXNugget? {
        if index < 0 || index >= self.nugget_count {
            return null
        }
        return self.nuggets[index]
    }
}

// ============================================================================
// Name to Index Mapping
// ============================================================================

struct FXNameEntry {
    name: string,
    index: i32,
}

// ============================================================================
// FX List Parser
// ============================================================================

struct FXListParser {
    fx_lists: [FXListDefinition],
    fx_count: i32,
    name_entries: [FXNameEntry],
    name_count: i32,

    // Parse state
    current_fx: i32,
    current_nugget: i32,
    in_fx_block: bool,
    in_nugget_block: bool,
    current_nugget_type: FXNuggetType,

    // Error tracking
    parse_errors: [string],
    error_count: i32,
}

impl FXListParser {
    fn init(): FXListParser {
        let lists: [FXListDefinition] = []
        for i in 0..MAX_FX_LISTS {
            lists = lists + [FXListDefinition::init()]
        }

        let names: [FXNameEntry] = []
        for i in 0..MAX_FX_LISTS {
            names = names + [FXNameEntry { name: "", index: -1 }]
        }

        let errors: [string] = []
        for i in 0..MAX_PARSE_ERRORS {
            errors = errors + [""]
        }

        return FXListParser {
            fx_lists: lists,
            fx_count: 0,
            name_entries: names,
            name_count: 0,
            current_fx: 0,
            current_nugget: 0,
            in_fx_block: false,
            in_nugget_block: false,
            current_nugget_type: FXNuggetType::SOUND,
            parse_errors: errors,
            error_count: 0,
        }
    }

    fn parse_file(&self, file_path: string): bool {
        let content = read_file_to_string(file_path)
        if content.length == 0 {
            self.add_error("Failed to read file: " + file_path)
            return false
        }

        let lines = split_lines(content)
        let line_num = 0

        for line in lines {
            line_num = line_num + 1
            let trimmed = trim(line)

            if trimmed.length == 0 || starts_with(trimmed, ";") || starts_with(trimmed, "//") {
                continue
            }

            if !self.parse_line(trimmed, line_num) {
                return false
            }
        }

        return true
    }

    fn parse_line(&self, line: string, line_num: i32): bool {
        // FXList block start
        if starts_with(line, "FXList ") {
            return self.begin_fx_block(line)
        }

        // Nugget block starts
        if starts_with(line, "Sound") && !contains(line, "=") {
            return self.begin_nugget(FXNuggetType::SOUND)
        }
        if starts_with(line, "ParticleSystem") && !contains(line, "=") {
            return self.begin_nugget(FXNuggetType::PARTICLE_SYSTEM)
        }
        if starts_with(line, "DynamicDecal") {
            return self.begin_nugget(FXNuggetType::DYNAMIC_DECAL)
        }
        if starts_with(line, "TerrainScorch") {
            return self.begin_nugget(FXNuggetType::TERRAIN_SCORCH)
        }
        if starts_with(line, "ViewShake") {
            return self.begin_nugget(FXNuggetType::VIEW_SHAKE)
        }
        if starts_with(line, "TintDrawable") {
            return self.begin_nugget(FXNuggetType::TINT_DRAWABLE)
        }
        if starts_with(line, "FXListAtBonePos") || starts_with(line, "FXListAtBone") {
            return self.begin_nugget(FXNuggetType::FX_LIST_AT_BONE)
        }
        if starts_with(line, "TracerFX") {
            return self.begin_nugget(FXNuggetType::TRACER_FX)
        }
        if starts_with(line, "LightPulse") {
            return self.begin_nugget(FXNuggetType::LIGHT_PULSE)
        }
        if starts_with(line, "LaserFX") {
            return self.begin_nugget(FXNuggetType::LASER_FX)
        }
        if starts_with(line, "CameraShakerVolume") {
            return self.begin_nugget(FXNuggetType::CAMERA_SHAKER_VOLUME)
        }
        if starts_with(line, "AttachedModel") {
            return self.begin_nugget(FXNuggetType::ATTACHED_MODEL)
        }
        if starts_with(line, "AttachedParticleSys") {
            return self.begin_nugget(FXNuggetType::ATTACHED_PARTICLE_SYSTEM)
        }
        if starts_with(line, "Streak") {
            return self.begin_nugget(FXNuggetType::STREAK)
        }

        // Block ends
        if line == "End" {
            return self.end_current_block()
        }

        // Property parsing
        if self.in_nugget_block {
            return self.parse_nugget_property(line)
        }

        if self.in_fx_block {
            return self.parse_fx_property(line)
        }

        return true
    }

    fn begin_fx_block(&self, line: string): bool {
        if self.fx_count >= MAX_FX_LISTS {
            self.add_error("Maximum FXList count exceeded")
            return false
        }

        let parts = split_by_space(line)
        if parts.length < 2 {
            self.add_error("Invalid FXList declaration")
            return false
        }

        let fx_name = trim(parts[1])

        self.current_fx = self.fx_count
        self.fx_lists[self.current_fx] = FXListDefinition::init()
        self.fx_lists[self.current_fx].name = fx_name
        self.fx_lists[self.current_fx].is_valid = true

        // Add to name mapping
        self.name_entries[self.name_count] = FXNameEntry {
            name: fx_name,
            index: self.current_fx,
        }
        self.name_count = self.name_count + 1

        self.fx_count = self.fx_count + 1
        self.in_fx_block = true

        return true
    }

    fn begin_nugget(&self, nugget_type: FXNuggetType): bool {
        if !self.in_fx_block {
            return true  // Ignore nuggets outside FXList
        }

        let fx = self.fx_lists[self.current_fx]
        if fx.nugget_count >= MAX_NUGGETS_PER_LIST {
            return true  // Max nuggets, skip
        }

        self.current_nugget = fx.nugget_count
        fx.nuggets[self.current_nugget] = FXNugget::init()
        fx.nuggets[self.current_nugget].nugget_type = nugget_type
        fx.nuggets[self.current_nugget].is_valid = true
        fx.nugget_count = fx.nugget_count + 1

        self.in_nugget_block = true
        self.current_nugget_type = nugget_type

        return true
    }

    fn end_current_block(&self): bool {
        if self.in_nugget_block {
            self.in_nugget_block = false
        } else if self.in_fx_block {
            self.in_fx_block = false
        }
        return true
    }

    fn parse_fx_property(&self, line: string): bool {
        let parts = self.split_property(line)
        if parts.key.length == 0 {
            return true
        }

        let key = parts.key
        let value = parts.value
        let fx = self.fx_lists[self.current_fx]

        if key == "PlayEverywhere" {
            fx.play_everywhere = self.parse_bool(value)
        }

        return true
    }

    fn parse_nugget_property(&self, line: string): bool {
        let parts = self.split_property(line)
        if parts.key.length == 0 {
            return true
        }

        let key = parts.key
        let value = parts.value
        let nugget = self.fx_lists[self.current_fx].nuggets[self.current_nugget]

        // Common properties
        if key == "Name" {
            nugget.name = value
        } else if key == "RequiredFlags" {
            nugget.required_flags = self.parse_flags(value)
        } else if key == "ExcludedFlags" {
            nugget.excluded_flags = self.parse_flags(value)
        } else if key == "InitialDelay" {
            nugget.initial_delay = self.parse_i32(value)
        } else {
            // Type-specific properties
            if self.current_nugget_type == FXNuggetType::SOUND {
                self.parse_sound_property(key, value, nugget)
            } else if self.current_nugget_type == FXNuggetType::PARTICLE_SYSTEM {
                self.parse_particle_property(key, value, nugget)
            } else if self.current_nugget_type == FXNuggetType::DYNAMIC_DECAL ||
                      self.current_nugget_type == FXNuggetType::TERRAIN_SCORCH {
                self.parse_decal_property(key, value, nugget)
            } else if self.current_nugget_type == FXNuggetType::VIEW_SHAKE ||
                      self.current_nugget_type == FXNuggetType::CAMERA_SHAKER_VOLUME {
                self.parse_shake_property(key, value, nugget)
            } else if self.current_nugget_type == FXNuggetType::TINT_DRAWABLE {
                self.parse_tint_property(key, value, nugget)
            } else if self.current_nugget_type == FXNuggetType::LIGHT_PULSE {
                self.parse_light_property(key, value, nugget)
            } else if self.current_nugget_type == FXNuggetType::TRACER_FX {
                self.parse_tracer_property(key, value, nugget)
            }
        }

        return true
    }

    fn parse_sound_property(&self, key: string, value: string, nugget: FXNugget) {
        if key == "SoundName" || key == "Sound" {
            nugget.sound_name = value
        } else if key == "Volume" || key == "SoundVolume" {
            nugget.sound_volume = self.parse_f64(value)
        } else if key == "MinVolume" {
            nugget.sound_min_volume = self.parse_f64(value)
        } else if key == "LoopCount" {
            nugget.sound_loop_count = self.parse_i32(value)
        }
    }

    fn parse_particle_property(&self, key: string, value: string, nugget: FXNugget) {
        if key == "Name" || key == "ParticleSystemName" {
            nugget.particle_system_name = value
        } else if key == "BoneName" || key == "Bone" {
            nugget.bone_name = value
        } else if key == "OrientToObject" {
            nugget.orient_to_object = self.parse_bool(value)
        } else if key == "Offset" {
            nugget.offset = self.parse_vec3(value)
        } else if key == "SystemLifetime" || key == "AttachedSystemLifetime" {
            nugget.attached_system_lifetime = self.parse_f64(value)
        }
    }

    fn parse_decal_property(&self, key: string, value: string, nugget: FXNugget) {
        if key == "Texture" || key == "DecalName" {
            nugget.decal_texture = value
        } else if key == "Size" || key == "DecalSize" || key == "Radius" {
            nugget.decal_size = self.parse_f64(value)
        } else if key == "Opacity" || key == "DecalOpacity" {
            nugget.decal_opacity = self.parse_f64(value)
        } else if key == "Lifetime" {
            nugget.decal_lifetime = self.parse_i32(value)
        }
    }

    fn parse_shake_property(&self, key: string, value: string, nugget: FXNugget) {
        if key == "Intensity" || key == "ShakeIntensity" {
            nugget.shake_intensity = self.parse_f64(value)
        } else if key == "Duration" || key == "ShakeDuration" {
            nugget.shake_duration = self.parse_i32(value)
        } else if key == "Radius" || key == "ShakeRadius" {
            nugget.shake_radius = self.parse_f64(value)
        }
    }

    fn parse_tint_property(&self, key: string, value: string, nugget: FXNugget) {
        if key == "Color" || key == "TintColor" {
            nugget.tint_color = self.parse_color(value)
        } else if key == "PreColorTime" {
            nugget.tint_pre_color_time = self.parse_i32(value)
        } else if key == "PostColorTime" {
            nugget.tint_post_color_time = self.parse_i32(value)
        } else if key == "SustainedColorTime" {
            nugget.tint_sustained_color_time = self.parse_i32(value)
        }
    }

    fn parse_light_property(&self, key: string, value: string, nugget: FXNugget) {
        if key == "Color" || key == "LightColor" {
            nugget.light_color = self.parse_color(value)
        } else if key == "Radius" || key == "LightRadius" {
            nugget.light_radius = self.parse_f64(value)
        } else if key == "IncreaseTime" || key == "RadiusIncreaseTime" {
            nugget.light_increase_time = self.parse_i32(value)
        } else if key == "DecreaseTime" || key == "RadiusDecreaseTime" {
            nugget.light_decrease_time = self.parse_i32(value)
        }
    }

    fn parse_tracer_property(&self, key: string, value: string, nugget: FXNugget) {
        if key == "Speed" || key == "TracerSpeed" {
            nugget.tracer_speed = self.parse_f64(value)
        } else if key == "Length" || key == "TracerLength" {
            nugget.tracer_length = self.parse_f64(value)
        } else if key == "Width" || key == "TracerWidth" {
            nugget.tracer_width = self.parse_f64(value)
        } else if key == "Color" || key == "TracerColor" {
            nugget.tracer_color = self.parse_color(value)
        } else if key == "Probability" || key == "DecayAt" {
            nugget.tracer_probability = self.parse_f64(value)
        }
    }

    fn parse_flags(&self, value: string): i32 {
        let flags = 0
        let parts = split_by_space(value)

        for part in parts {
            let upper = to_uppercase(part)
            if upper == "NIGHT" {
                flags = flags | 1
            } else if upper == "DAY" {
                flags = flags | 2
            } else if upper == "WATER" {
                flags = flags | 4
            } else if upper == "UNDERWATER" {
                flags = flags | 8
            } else if upper == "HEAVILY_DAMAGED" {
                flags = flags | 16
            } else if upper == "PRISTINE" {
                flags = flags | 32
            }
        }

        return flags
    }

    fn parse_vec3(&self, value: string): Vec3 {
        // Format: "X:1.0 Y:2.0 Z:3.0"
        let result = Vec3::init()
        let parts = split_by_space(value)

        for part in parts {
            if starts_with(part, "X:") {
                result.x = self.parse_f64(substring_from(part, 2))
            } else if starts_with(part, "Y:") {
                result.y = self.parse_f64(substring_from(part, 2))
            } else if starts_with(part, "Z:") {
                result.z = self.parse_f64(substring_from(part, 2))
            }
        }

        return result
    }

    fn parse_color(&self, value: string): Color {
        // Format: "R:255 G:128 B:64" or "255 128 64"
        let color = Color::init()

        if contains(value, ":") {
            let parts = split_by_space(value)
            for part in parts {
                if starts_with(part, "R:") {
                    color.r = self.parse_f64(substring_from(part, 2)) / 255.0
                } else if starts_with(part, "G:") {
                    color.g = self.parse_f64(substring_from(part, 2)) / 255.0
                } else if starts_with(part, "B:") {
                    color.b = self.parse_f64(substring_from(part, 2)) / 255.0
                } else if starts_with(part, "A:") {
                    color.a = self.parse_f64(substring_from(part, 2)) / 255.0
                }
            }
        } else {
            let parts = split_by_space(value)
            if parts.length >= 3 {
                color.r = self.parse_f64(parts[0]) / 255.0
                color.g = self.parse_f64(parts[1]) / 255.0
                color.b = self.parse_f64(parts[2]) / 255.0
            }
        }

        return color
    }

    fn split_property(&self, line: string): PropertyParts {
        let eq_pos = index_of(line, "=")
        if eq_pos >= 0 {
            return PropertyParts {
                key: trim(substring(line, 0, eq_pos)),
                value: trim(substring_from(line, eq_pos + 1)),
            }
        }

        let space_pos = index_of(line, " ")
        if space_pos >= 0 {
            return PropertyParts {
                key: trim(substring(line, 0, space_pos)),
                value: trim(substring_from(line, space_pos + 1)),
            }
        }

        return PropertyParts { key: line, value: "" }
    }

    fn parse_f64(&self, value: string): f64 {
        return parse_float(trim(value))
    }

    fn parse_i32(&self, value: string): i32 {
        return parse_int(trim(value))
    }

    fn parse_bool(&self, value: string): bool {
        let v = to_uppercase(value)
        return v == "YES" || v == "TRUE" || v == "1"
    }

    fn add_error(&self, msg: string) {
        if self.error_count < MAX_PARSE_ERRORS {
            self.parse_errors[self.error_count] = msg
            self.error_count = self.error_count + 1
        }
    }

    // Public API
    fn get_fx_list(&self, name: string): FXListDefinition? {
        for i in 0..self.name_count {
            if self.name_entries[i].name == name {
                let idx = self.name_entries[i].index
                if idx >= 0 && idx < self.fx_count {
                    return self.fx_lists[idx]
                }
            }
        }
        return null
    }

    fn get_fx_list_by_index(&self, index: i32): FXListDefinition? {
        if index < 0 || index >= self.fx_count {
            return null
        }
        return self.fx_lists[index]
    }

    fn get_fx_count(&self): i32 {
        return self.fx_count
    }

    fn get_error_count(&self): i32 {
        return self.error_count
    }

    fn get_error(&self, index: i32): string {
        if index < 0 || index >= self.error_count {
            return ""
        }
        return self.parse_errors[index]
    }
}

// ============================================================================
// Helper Types
// ============================================================================

struct PropertyParts {
    key: string,
    value: string,
}

