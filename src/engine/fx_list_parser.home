// ============================================================================
// FX Effect Application
// ============================================================================

struct FXEffectInstance {
    fx_list: FXListDefinition,
    position: Vec3,
    elapsed_time: f64,
    is_active: bool,
}

impl FXEffectInstance {
    fn init(fx_list: FXListDefinition, position: Vec3): FXEffectInstance {
        return FXEffectInstance {
            fx_list: fx_list,
            position: position,
            elapsed_time: 0.0,
            is_active: true,
        }
    }

    fn update(&self, delta_time: f64) {
        self.elapsed_time = self.elapsed_time + delta_time

        // Process nuggets based on timing
        for i in 0..self.fx_list.nugget_count {
            let nugget = self.fx_list.nuggets[i]

            // Check if this nugget should trigger
            if nugget.initial_delay as f64 <= self.elapsed_time * 1000.0 {
                self.apply_nugget(nugget)
            }
        }
    }

    fn apply_nugget(&self, nugget: FXNugget) {
        if nugget.nugget_type == FXNuggetType::SOUND {
            // Play sound at position
            play_sound_at_position(nugget.sound_name, self.position, nugget.sound_volume)
        } else if nugget.nugget_type == FXNuggetType::PARTICLE_SYSTEM {
            // Spawn particle system
            spawn_particle_system(nugget.particle_system_name, self.position, nugget.orient_to_object)
        } else if nugget.nugget_type == FXNuggetType::DYNAMIC_DECAL ||
                  nugget.nugget_type == FXNuggetType::TERRAIN_SCORCH {
            // Create ground decal
            create_decal(nugget.decal_texture, self.position, nugget.decal_size, nugget.decal_opacity, nugget.decal_lifetime)
        } else if nugget.nugget_type == FXNuggetType::VIEW_SHAKE ||
                  nugget.nugget_type == FXNuggetType::CAMERA_SHAKER_VOLUME {
            // Shake camera
            shake_camera(nugget.shake_intensity, nugget.shake_duration, nugget.shake_radius)
        } else if nugget.nugget_type == FXNuggetType::LIGHT_PULSE {
            // Create light pulse
            create_light_pulse(self.position, nugget.light_color, nugget.light_radius,
                               nugget.light_increase_time, nugget.light_decrease_time)
        } else if nugget.nugget_type == FXNuggetType::TRACER_FX {
            // Create tracer effect
            if random_float() <= nugget.tracer_probability {
                create_tracer(self.position, nugget.tracer_speed, nugget.tracer_length,
                              nugget.tracer_width, nugget.tracer_color)
            }
        }
    }
}

// ============================================================================
// FX System Manager
// ============================================================================

let MAX_ACTIVE_EFFECTS: i32 = 256

struct FXSystem {
    parser: FXListParser,
    active_effects: [FXEffectInstance],
    effect_count: i32,
    is_initialized: bool,
}

impl FXSystem {
    fn init(): FXSystem {
        let effects: [FXEffectInstance] = []
        // Don't pre-allocate, just initialize empty array

        return FXSystem {
            parser: FXListParser::init(),
            active_effects: effects,
            effect_count: 0,
            is_initialized: false,
        }
    }

    fn load_fx_ini(&self, file_path: string): bool {
        let result = self.parser.parse_file(file_path)
        if result {
            self.is_initialized = true
        }
        return result
    }

    fn play_fx(&self, fx_name: string, position: Vec3) {
        let fx_list = self.parser.get_fx_list(fx_name)
        if fx_list == null {
            return
        }

        if self.effect_count >= MAX_ACTIVE_EFFECTS {
            // Remove oldest effect
            self.remove_effect(0)
        }

        let effect = FXEffectInstance::init(fx_list, position)
        self.active_effects = self.active_effects + [effect]
        self.effect_count = self.effect_count + 1
    }

    fn update(&self, delta_time: f64) {
        let i = 0
        while i < self.effect_count {
            self.active_effects[i].update(delta_time)

            // Check if effect is done (simplified - would check all nuggets)
            // For now, effects last 5 seconds
            if self.active_effects[i].elapsed_time > 5.0 {
                self.remove_effect(i)
            } else {
                i = i + 1
            }
        }
    }

    fn remove_effect(&self, index: i32) {
        if index < 0 || index >= self.effect_count {
            return
        }

        // Shift remaining effects
        for j in index..(self.effect_count - 1) {
            self.active_effects[j] = self.active_effects[j + 1]
        }
        self.effect_count = self.effect_count - 1
    }

    fn get_active_effect_count(&self): i32 {
        return self.effect_count
    }
}

