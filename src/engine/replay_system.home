// C&C Generals Zero Hour - Home Port
// Replay System - Record and playback game replays
//
// Original: ReplaySystem from Thyme/SAGE engine
// Implements authentic C&C Generals Zero Hour replay functionality

let REPLAY_VERSION: i32 = 6   // Zero Hour replay version
let MAX_REPLAY_COMMANDS: i32 = 1048576
let MAX_COMPRESSED_SIZE: i32 = 16777216
let MAX_UNITS_PER_COMMAND: i32 = 64

// ============================================================================
// ENUMS
// ============================================================================

enum ReplayCommandType {
    // Unit commands
    MOVE,
    ATTACK,
    ATTACK_MOVE,
    FORCE_ATTACK,
    GUARD,
    STOP,
    SCATTER,
    // Building commands
    BUILD_UNIT,
    BUILD_BUILDING,
    SELL_BUILDING,
    CANCEL_BUILD,
    // Special commands
    USE_ABILITY,
    USE_SUPERWEAPON,
    SET_RALLY_POINT,
    // Control groups
    SELECT_UNITS,
    CREATE_GROUP,
    SELECT_GROUP,
    ADD_TO_GROUP,
    // Game commands
    SET_STANCE,
    UPGRADE,
    EVACUATE,
    ENTER_VEHICLE,
    EXIT_VEHICLE,
    // Meta
    CHAT_MESSAGE,
    PAUSE_GAME,
    SURRENDER,
    GAME_SPEED,
}

enum PlaybackState {
    STOPPED,
    PLAYING,
    PAUSED,
    FAST_FORWARD,
    REWIND,
}

// ============================================================================
// REPLAY HEADER
// ============================================================================

struct ReplayHeader {
    version: i32,
    timestamp: i64,
    game_duration_frames: i32,
    random_seed: i32,
    map_name: string,
    map_crc: i32,
    player_count: i32,
    player_names: [string],
    player_factions: [i32],
    player_colors: [i32],
    player_positions: [i32],
    player_generals: [i32],
    player_teams: [i32],
    player_is_ai: [bool],
    ai_difficulty: [i32],
    starting_cash: i32,
    superweapons_enabled: bool,
    crates_enabled: bool,
    build_time_multiplier: f32,
}

impl ReplayHeader {
    fn init(): ReplayHeader {
        return ReplayHeader {
            version: REPLAY_VERSION,
            timestamp: 0,
            game_duration_frames: 0,
            random_seed: 0,
            map_name: "",
            map_crc: 0,
            player_count: 0,
            player_names: [],
            player_factions: [],
            player_colors: [],
            player_positions: [],
            player_generals: [],
            player_teams: [],
            player_is_ai: [],
            ai_difficulty: [],
            starting_cash: 10000,
            superweapons_enabled: true,
            crates_enabled: true,
            build_time_multiplier: 1.0,
        }
    }
}

// ============================================================================
// REPLAY COMMAND
// ============================================================================

struct ReplayCommand {
    frame: i32,
    player_id: i32,
    command_type: ReplayCommandType,
    target_x: f32,
    target_y: f32,
    target_z: f32,
    target_object_id: i32,
    source_object_ids: [i32],
    source_count: i32,
    ability_id: i32,
    building_type: i32,
    unit_type: i32,
    upgrade_type: i32,
    group_number: i32,
    stance: i32,
    chat_message: string,
}

impl ReplayCommand {
    fn init(): ReplayCommand {
        return ReplayCommand {
            frame: 0,
            player_id: 0,
            command_type: ReplayCommandType::MOVE,
            target_x: 0.0,
            target_y: 0.0,
            target_z: 0.0,
            target_object_id: 0,
            source_object_ids: [],
            source_count: 0,
            ability_id: 0,
            building_type: 0,
            unit_type: 0,
            upgrade_type: 0,
            group_number: 0,
            stance: 0,
            chat_message: "",
        }
    }
}

// ============================================================================
// REPLAY FILE
// ============================================================================

struct ReplayFile {
    header: ReplayHeader,
    commands: [ReplayCommand],
    compressed_data: [i32],
    compressed_size: i32,
}

impl ReplayFile {
    fn init(): ReplayFile {
        return ReplayFile {
            header: ReplayHeader::init(),
            commands: [],
            compressed_data: [],
            compressed_size: 0,
        }
    }
}

// ============================================================================
// REPLAY RECORDER
// ============================================================================

struct ReplayRecorder {
    is_recording: bool,
    current_frame: i32,
    start_time: i64,
    header: ReplayHeader,
    commands: [ReplayCommand],
    pending_commands: [ReplayCommand],
}

impl ReplayRecorder {
    fn init(): ReplayRecorder {
        return ReplayRecorder {
            is_recording: false,
            current_frame: 0,
            start_time: 0,
            header: ReplayHeader::init(),
            commands: [],
            pending_commands: [],
        }
    }

    fn start_recording(&self, map_name: string, seed: i32) {
        self.is_recording = true
        self.current_frame = 0
        self.commands = []
        self.pending_commands = []

        self.header.version = REPLAY_VERSION
        self.header.timestamp = get_current_timestamp()
        self.header.random_seed = seed
        self.header.map_name = map_name

        self.start_time = get_current_timestamp()
    }

    fn stop_recording(&self) {
        self.is_recording = false
        self.header.game_duration_frames = self.current_frame

        // Flush pending commands
        self.flush_pending_commands()
    }

    fn record_command(&self, cmd: ReplayCommand) {
        if !self.is_recording {
            return
        }

        let command = cmd
        command.frame = self.current_frame

        // Add to pending buffer
        if self.pending_commands.length < 256 {
            self.pending_commands = self.pending_commands + [command]
        }

        // Flush if buffer getting full
        if self.pending_commands.length >= 200 {
            self.flush_pending_commands()
        }
    }

    fn flush_pending_commands(&self) {
        for i in 0..self.pending_commands.length {
            if self.commands.length < MAX_REPLAY_COMMANDS {
                self.commands = self.commands + [self.pending_commands[i]]
            }
        }
        self.pending_commands = []
    }

    fn advance_frame(&self) {
        if self.is_recording {
            self.current_frame = self.current_frame + 1
        }
    }

    fn add_player_info(&self, player_id: i32, name: string, faction: i32, color: i32, position: i32, general: i32, team: i32, is_ai: bool, ai_diff: i32) {
        if player_id < 8 {
            self.header.player_names = self.header.player_names + [name]
            self.header.player_factions = self.header.player_factions + [faction]
            self.header.player_colors = self.header.player_colors + [color]
            self.header.player_positions = self.header.player_positions + [position]
            self.header.player_generals = self.header.player_generals + [general]
            self.header.player_teams = self.header.player_teams + [team]
            self.header.player_is_ai = self.header.player_is_ai + [is_ai]
            self.header.ai_difficulty = self.header.ai_difficulty + [ai_diff]
            self.header.player_count = self.header.player_count + 1
        }
    }

    fn record_move_command(&self, player: i32, units: [i32], x: f32, y: f32, z: f32) {
        let cmd = ReplayCommand {
            frame: self.current_frame,
            player_id: player,
            command_type: ReplayCommandType::MOVE,
            target_x: x,
            target_y: y,
            target_z: z,
            target_object_id: 0,
            source_object_ids: units,
            source_count: units.length,
            ability_id: 0,
            building_type: 0,
            unit_type: 0,
            upgrade_type: 0,
            group_number: 0,
            stance: 0,
            chat_message: "",
        }
        self.record_command(cmd)
    }

    fn record_attack_command(&self, player: i32, units: [i32], target: i32) {
        let cmd = ReplayCommand {
            frame: self.current_frame,
            player_id: player,
            command_type: ReplayCommandType::ATTACK,
            target_x: 0.0,
            target_y: 0.0,
            target_z: 0.0,
            target_object_id: target,
            source_object_ids: units,
            source_count: units.length,
            ability_id: 0,
            building_type: 0,
            unit_type: 0,
            upgrade_type: 0,
            group_number: 0,
            stance: 0,
            chat_message: "",
        }
        self.record_command(cmd)
    }

    fn record_build_unit(&self, player: i32, building: i32, unit_type: i32) {
        let cmd = ReplayCommand {
            frame: self.current_frame,
            player_id: player,
            command_type: ReplayCommandType::BUILD_UNIT,
            target_x: 0.0,
            target_y: 0.0,
            target_z: 0.0,
            target_object_id: building,
            source_object_ids: [],
            source_count: 0,
            ability_id: 0,
            building_type: 0,
            unit_type: unit_type,
            upgrade_type: 0,
            group_number: 0,
            stance: 0,
            chat_message: "",
        }
        self.record_command(cmd)
    }

    fn record_ability_use(&self, player: i32, ability: i32, x: f32, y: f32, z: f32) {
        let cmd = ReplayCommand {
            frame: self.current_frame,
            player_id: player,
            command_type: ReplayCommandType::USE_ABILITY,
            target_x: x,
            target_y: y,
            target_z: z,
            target_object_id: 0,
            source_object_ids: [],
            source_count: 0,
            ability_id: ability,
            building_type: 0,
            unit_type: 0,
            upgrade_type: 0,
            group_number: 0,
            stance: 0,
            chat_message: "",
        }
        self.record_command(cmd)
    }

    fn get_command_count(&self): i32 {
        return self.commands.length
    }
}

// ============================================================================
// REPLAY PLAYER
// ============================================================================

struct ReplayPlayer {
    state: PlaybackState,
    current_frame: i32,
    playback_speed: f32,
    replay: ReplayFile,
    command_index: i32,
    target_frame: i32,
    seeking: bool,
    follow_player: i32,   // -1 = free camera
    timeline_position: f32,
    show_all_players: bool,
}

impl ReplayPlayer {
    fn init(): ReplayPlayer {
        return ReplayPlayer {
            state: PlaybackState::STOPPED,
            current_frame: 0,
            playback_speed: 1.0,
            replay: ReplayFile::init(),
            command_index: 0,
            target_frame: 0,
            seeking: false,
            follow_player: -1,
            timeline_position: 0.0,
            show_all_players: true,
        }
    }

    fn load_replay(&self, data: [i32]): bool {
        // Check signature ("GENR" = 0x47, 0x45, 0x4E, 0x52)
        if data.length < 8 {
            return false
        }

        if data[0] != 0x47 || data[1] != 0x45 || data[2] != 0x4E || data[3] != 0x52 {
            return false
        }

        // Parse header
        self.replay.header.version = read_u32_le(data, 4)
        self.replay.header.timestamp = read_u64_le(data, 8)
        self.replay.header.game_duration_frames = read_u32_le(data, 16)
        self.replay.header.random_seed = read_u32_le(data, 20)

        // Read map name would go here

        self.state = PlaybackState::STOPPED
        self.current_frame = 0
        self.command_index = 0

        return true
    }

    fn play(&self) {
        self.state = PlaybackState::PLAYING
    }

    fn pause(&self) {
        self.state = PlaybackState::PAUSED
    }

    fn stop(&self) {
        self.state = PlaybackState::STOPPED
        self.current_frame = 0
        self.command_index = 0
    }

    fn set_playback_speed(&self, speed: f32) {
        if speed >= 0.25 && speed <= 8.0 {
            self.playback_speed = speed

            if speed > 1.0 {
                self.state = PlaybackState::FAST_FORWARD
            } else {
                self.state = PlaybackState::PLAYING
            }
        }
    }

    fn seek_to_frame(&self, frame: i32) {
        if frame <= self.replay.header.game_duration_frames {
            self.seeking = true
            self.target_frame = frame

            // If seeking backwards, need to restart from beginning
            if frame < self.current_frame {
                self.current_frame = 0
                self.command_index = 0
            }
        }
    }

    fn seek_to_percent(&self, percent: f32) {
        let target = (self.replay.header.game_duration_frames as f32 * percent) as i32
        self.seek_to_frame(target)
    }

    fn update(&self, delta_time: f32): [ReplayCommand] {
        let commands_this_frame: [ReplayCommand] = []

        if self.state == PlaybackState::STOPPED || self.state == PlaybackState::PAUSED {
            return commands_this_frame
        }

        // Calculate frames to advance
        let frames_per_second: f32 = 30.0
        let frames_to_advance = delta_time * frames_per_second * self.playback_speed

        let target_frame = self.current_frame + frames_to_advance as i32

        // Handle seeking
        if self.seeking {
            if self.current_frame < self.target_frame {
                // Fast forward without rendering
                while self.current_frame < self.target_frame && self.command_index < self.replay.commands.length {
                    self.current_frame = self.current_frame + 1
                }
            }
            if self.current_frame >= self.target_frame {
                self.seeking = false
            }
        }

        // Get commands for current frame
        while self.command_index < self.replay.commands.length {
            let cmd = self.replay.commands[self.command_index]

            if cmd.frame <= target_frame {
                commands_this_frame = commands_this_frame + [cmd]
                self.command_index = self.command_index + 1
            } else {
                break
            }
        }

        self.current_frame = target_frame

        // Update timeline position
        if self.replay.header.game_duration_frames > 0 {
            self.timeline_position = self.current_frame as f32 / self.replay.header.game_duration_frames as f32
        }

        // Check for end of replay
        if self.current_frame >= self.replay.header.game_duration_frames {
            self.state = PlaybackState::STOPPED
        }

        return commands_this_frame
    }

    fn follow_player_camera(&self, player_id: i32) {
        self.follow_player = player_id
    }

    fn get_time_string(&self): string {
        let total_seconds = self.current_frame / 30
        let minutes = total_seconds / 60
        let seconds = total_seconds % 60
        return format_time(minutes, seconds)
    }

    fn get_duration_string(&self): string {
        let total_seconds = self.replay.header.game_duration_frames / 30
        let minutes = total_seconds / 60
        let seconds = total_seconds % 60
        return format_time(minutes, seconds)
    }
}

// ============================================================================
// REPLAY UI
// ============================================================================

struct ReplayUI {
    // Timeline bar
    timeline_x: i32,
    timeline_y: i32,
    timeline_width: i32,
    timeline_height: i32,
    timeline_handle_x: i32,
    dragging_timeline: bool,
    // Playback controls
    controls_x: i32,
    controls_y: i32,
    // Speed buttons (0.25x, 0.5x, 1x, 2x, 4x, 8x)
    speed_button_count: i32,
    // Player list
    player_list_x: i32,
    player_list_y: i32,
    selected_player: i32,
    // Stats overlay
    show_stats: bool,
    stats_x: i32,
    stats_y: i32,
}

impl ReplayUI {
    fn init(): ReplayUI {
        return ReplayUI {
            timeline_x: 100,
            timeline_y: 550,
            timeline_width: 600,
            timeline_height: 20,
            timeline_handle_x: 100,
            dragging_timeline: false,
            controls_x: 350,
            controls_y: 580,
            speed_button_count: 6,
            player_list_x: 10,
            player_list_y: 100,
            selected_player: -1,
            show_stats: false,
            stats_x: 10,
            stats_y: 300,
        }
    }

    fn handle_timeline_click(&self, player: ReplayPlayer, mouse_x: i32) {
        if mouse_x >= self.timeline_x && mouse_x <= self.timeline_x + self.timeline_width {
            let percent = (mouse_x - self.timeline_x) as f32 / self.timeline_width as f32
            player.seek_to_percent(percent)
            self.timeline_handle_x = mouse_x
        }
    }
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn read_u32_le(data: [i32], offset: i32): i32 {
    if offset + 4 > data.length {
        return 0
    }
    return (data[offset]) |
           (data[offset + 1] << 8) |
           (data[offset + 2] << 16) |
           (data[offset + 3] << 24)
}

fn read_u64_le(data: [i32], offset: i32): i64 {
    let low = read_u32_le(data, offset)
    let high = read_u32_le(data, offset + 4)
    return (high as i64 << 32) | (low as i64)
}

fn format_time(minutes: i32, seconds: i32): string {
    // Would format as "MM:SS"
    return "00:00"
}

extern fn get_current_timestamp(): i64

// ============================================================================
// GLOBAL REPLAY SYSTEM INSTANCES
// ============================================================================

let g_replay_recorder: ReplayRecorder? = null
let g_replay_player: ReplayPlayer? = null

fn init_replay_recorder(): ReplayRecorder {
    let recorder = ReplayRecorder::init()
    g_replay_recorder = recorder
    return recorder
}

fn get_replay_recorder(): ReplayRecorder? {
    return g_replay_recorder
}

fn init_replay_player(): ReplayPlayer {
    let player = ReplayPlayer::init()
    g_replay_player = player
    return player
}

fn get_replay_player(): ReplayPlayer? {
    return g_replay_player
}

fn shutdown_replay_system() {
    g_replay_recorder = null
    g_replay_player = null
}
