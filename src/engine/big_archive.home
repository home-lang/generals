// BIG Archive Reader - Pure Home Implementation
// Reads EA's .big archive format used by C&C Generals Zero Hour
//
// BIG File Format:
// - Magic: "BIGF" or "BIG4" (4 bytes)
// - Archive size: u32 little-endian
// - File count: u32 big-endian
// - Reserved: 4 bytes
// - File entries (at offset 16):
//   - Position: u32 big-endian
//   - Size: u32 big-endian
//   - Name: null-terminated string
//
// Reference: thyme/src/platform/w3dengine/common/win32bigfilesystem.cpp


// BIG archive magic constants
let BIG_MAGIC_BIGF: i32 = 0x46474942  // "BIGF" as little-endian u32
let BIG_MAGIC_BIG4: i32 = 0x34474942  // "BIG4" as little-endian u32
let BIG_PATH_MAX: i32 = 260

// Error types
enum BigError {
    NONE,
    INVALID_MAGIC,
    INVALID_HEADER,
    FILE_NOT_FOUND,
    READ_ERROR,
    OUT_OF_MEMORY,
    PATH_TOO_LONG,
    ARCHIVE_NOT_OPEN,
}

// Information about a file within the archive
struct ArchivedFileInfo {
    name: string,         // Full path within archive (normalized)
    base_name: string,    // Just the filename (after last /)
    position: i32,        // Offset in the BIG file
    size: i32,            // File size in bytes
}

impl ArchivedFileInfo {
    fn init(name: string, position: i32, size: i32): ArchivedFileInfo {
        // Find base name (after last /)
        let base_start = 0
        let name_len = name.len()
        for i in 0..name_len {
            if name.char_at(i) == "/" {
                base_start = i + 1
            }
        }
        let base_name = name.substring(base_start, name_len)

        return ArchivedFileInfo {
            name: name,
            base_name: base_name,
            position: position,
            size: size,
        }
    }
}

// Binary reader for parsing archive data
struct BigReader {
    data: [i32],        // Raw byte array
    position: i32,      // Current read position
}

impl BigReader {
    fn init(data: [i32]): BigReader {
        return BigReader {
            data: data,
            position: 0,
        }
    }

    fn read_u8(&self): i32 {
        if self.position >= self.data.length {
            return 0
        }
        let value = self.data[self.position]
        self.position = self.position + 1
        return value
    }

    // Read u32 little-endian (archive size)
    fn read_u32_le(&self): i32 {
        let b0 = self.read_u8()
        let b1 = self.read_u8()
        let b2 = self.read_u8()
        let b3 = self.read_u8()
        return b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216)
    }

    // Read u32 big-endian (file count, positions, sizes)
    fn read_u32_be(&self): i32 {
        let b0 = self.read_u8()
        let b1 = self.read_u8()
        let b2 = self.read_u8()
        let b3 = self.read_u8()
        return (b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3
    }

    // Read null-terminated string
    fn read_string_null_terminated(&self, max_len: i32): string {
        let result = ""
        let count = 0
        while count < max_len {
            let byte_val = self.read_u8()
            if byte_val == 0 {
                break
            }
            result = result + char_from_code(byte_val)
            count = count + 1
        }
        return result
    }

    // Read fixed-length byte array
    fn read_bytes(&self, count: i32): [i32] {
        let bytes: [i32] = []
        for i in 0..count {
            bytes = bytes + [self.read_u8()]
        }
        return bytes
    }

    fn seek(&self, new_position: i32) {
        self.position = new_position
    }

    fn get_position(&self): i32 {
        return self.position
    }

    fn remaining(&self): i32 {
        return self.data.length - self.position
    }
}

// File entry in the archive index
struct FileEntry {
    path: string,
    info: ArchivedFileInfo,
}

// A single BIG archive file
struct BigArchive {
    file_path: string,
    archive_size: i32,
    file_count: i32,
    files: [FileEntry],      // Array of file entries
    raw_data: [i32],         // Entire archive in memory
    is_open: bool,
    last_error: BigError,
}

impl BigArchive {
    fn init(): BigArchive {
        return BigArchive {
            file_path: "",
            archive_size: 0,
            file_count: 0,
            files: [],
            raw_data: [],
            is_open: false,
            last_error: BigError::NONE,
        }
    }

    // Open and parse a BIG archive file
    fn open(&self, path: string): bool {
        self.file_path = path

        // Read entire file into memory
        // In real implementation: let file_data = File::read_bytes(path)
        let file_data: [i32] = []  // Placeholder

        self.raw_data = file_data

        // Parse the header
        if !self.parse_header() {
            return false
        }

        self.is_open = true
        return true
    }

    // Parse the BIG file header and build file index
    fn parse_header(&self): bool {
        if self.raw_data.length < 16 {
            self.last_error = BigError::INVALID_HEADER
            return false
        }

        let reader = BigReader::init(self.raw_data)

        // Read and verify magic (4 bytes)
        let magic = reader.read_u32_le()
        if magic != BIG_MAGIC_BIGF && magic != BIG_MAGIC_BIG4 {
            self.last_error = BigError::INVALID_MAGIC
            return false
        }

        // Read archive size (little-endian)
        self.archive_size = reader.read_u32_le()

        // Read file count (big-endian)
        self.file_count = reader.read_u32_be()

        // Skip 4 reserved bytes, seek to offset 16 for file entries
        reader.seek(16)

        // Parse file entries
        for i in 0..self.file_count {
            // Read position and size (big-endian)
            let position = reader.read_u32_be()
            let size = reader.read_u32_be()

            // Read null-terminated filename
            let name = reader.read_string_null_terminated(BIG_PATH_MAX)

            if name.len() >= BIG_PATH_MAX {
                self.last_error = BigError::PATH_TOO_LONG
                return false
            }

            // Normalize path: replace backslash with forward slash, lowercase
            let normalized = self.normalize_path(name)

            // Create file info and add to list
            let info = ArchivedFileInfo::init(normalized, position, size)
            let entry = FileEntry {
                path: normalized,
                info: info,
            }
            self.files = self.files + [entry]
        }

        return true
    }

    // Normalize a path: replace \ with /, convert to lowercase
    fn normalize_path(&self, path: string): string {
        let result = ""
        let path_len = path.len()
        for i in 0..path_len {
            let c = path.char_code_at(i)
            if c == 92 {  // backslash
                result = result + "/"
            } else if c >= 65 && c <= 90 {  // A-Z
                // Convert to lowercase
                result = result + char_from_code(c + 32)
            } else {
                result = result + path.char_at(i)
            }
        }
        return result
    }

    // Check if a file exists in the archive
    fn file_exists(&self, path: string): bool {
        let normalized = self.normalize_path(path)
        for i in 0..self.files.length {
            if self.files[i].path == normalized {
                return true
            }
        }
        return false
    }

    // Get file info for a path
    fn get_file_info(&self, path: string): ArchivedFileInfo? {
        let normalized = self.normalize_path(path)
        for i in 0..self.files.length {
            if self.files[i].path == normalized {
                return self.files[i].info
            }
        }
        return null
    }

    // Read a file from the archive into memory
    // Returns empty array [] on failure (check last_error for reason)
    fn read_file(&self, path: string): [i32] {
        let info = self.get_file_info(path)
        if info == null {
            self.last_error = BigError::FILE_NOT_FOUND
            return []
        }
        return self.read_file_by_info(info)
    }

    // Read a file using its info struct
    // Returns empty array [] on failure (check last_error for reason)
    fn read_file_by_info(&self, info: ArchivedFileInfo): [i32] {
        if !self.is_open {
            self.last_error = BigError::ARCHIVE_NOT_OPEN
            return []
        }

        let buffer: [i32] = []
        let start = info.position
        let end = start + info.size

        // Bounds check
        if end > self.raw_data.length {
            self.last_error = BigError::READ_ERROR
            return []
        }

        // Copy file data
        for i in start..end {
            buffer = buffer + [self.raw_data[i]]
        }

        return buffer
    }

    // Read file as string (for text files like INI)
    // Returns null on failure (check last_error for reason)
    fn read_file_as_string(&self, path: string): string? {
        let data = self.read_file(path)
        if data.length == 0 {
            return null
        }

        let result = ""
        for i in 0..data.length {
            result = result + char_from_code(data[i])
        }
        return result
    }

    // Get a list of all files in the archive
    fn list_files(&self): [string] {
        let list: [string] = []
        for i in 0..self.files.length {
            list = list + [self.files[i].path]
        }
        return list
    }

    // Get files matching a pattern (e.g., "*.ini", "data/art/*.tga")
    fn find_files(&self, pattern: string): [string] {
        let list: [string] = []
        for i in 0..self.files.length {
            if match_pattern(self.files[i].path, pattern) {
                list = list + [self.files[i].path]
            }
        }
        return list
    }

    // Get files by extension
    fn find_files_by_extension(&self, ext: string): [string] {
        let pattern = "*." + ext
        return self.find_files(pattern)
    }

    // Get number of files in archive
    fn get_file_count(&self): i32 {
        return self.file_count
    }

    // Get total archive size
    fn get_archive_size(&self): i32 {
        return self.archive_size
    }

    // Close the archive
    fn close(&self) {
        self.raw_data = []
        self.files = []
        self.is_open = false
        self.file_path = ""
        self.archive_size = 0
        self.file_count = 0
    }
}

// Simple wildcard pattern matching (* and ?)
fn match_pattern(str: string, pattern: string): bool {
    let s = 0
    let p = 0
    let star_idx: i32 = -1
    let match_idx = 0
    let str_len = str.len()
    let pattern_len = pattern.len()

    while s < str_len {
        if p < pattern_len {
            let pc = pattern.char_code_at(p)
            let sc = str.char_code_at(s)

            if pc == 63 || to_lower_char(pc) == to_lower_char(sc) {  // '?' = 63
                s = s + 1
                p = p + 1
                continue
            }

            if pc == 42 {  // '*' = 42
                star_idx = p
                match_idx = s
                p = p + 1
                continue
            }
        }

        if star_idx >= 0 {
            p = star_idx + 1
            match_idx = match_idx + 1
            s = match_idx
        } else {
            return false
        }
    }

    // Skip trailing wildcards
    while p < pattern_len && pattern.char_code_at(p) == 42 {
        p = p + 1
    }

    return p == pattern_len
}

fn to_lower_char(c: i32): i32 {
    if c >= 65 && c <= 90 {  // A-Z
        return c + 32
    }
    return c
}

fn char_from_code(code: i32): string {
    // Placeholder - in real implementation would convert code to character string
    return ""
}

// Archive file system - manages multiple BIG archives
struct BigFileSystem {
    archives: [BigArchive],
    search_paths: [string],
}

impl BigFileSystem {
    fn init(): BigFileSystem {
        return BigFileSystem {
            archives: [],
            search_paths: [],
        }
    }

    // Add a search path for finding BIG files
    fn add_search_path(&self, path: string) {
        self.search_paths = self.search_paths + [path]
    }

    // Load a single archive
    fn load_archive(&self, path: string): bool {
        let archive = BigArchive::init()
        if archive.open(path) {
            self.archives = self.archives + [archive]
            return true
        }
        return false
    }

    // Check if a file exists in any loaded archive
    fn file_exists(&self, path: string): bool {
        for i in 0..self.archives.length {
            if self.archives[i].file_exists(path) {
                return true
            }
        }
        return false
    }

    // Read a file from any loaded archive (first match wins)
    // Returns empty array [] if not found
    fn read_file(&self, path: string): [i32] {
        for i in 0..self.archives.length {
            let info = self.archives[i].get_file_info(path)
            if info != null {
                return self.archives[i].read_file_by_info(info)
            }
        }
        return []
    }

    // Read a file as string
    // Returns null if not found
    fn read_file_as_string(&self, path: string): string? {
        for i in 0..self.archives.length {
            let info = self.archives[i].get_file_info(path)
            if info != null {
                let data = self.archives[i].read_file_by_info(info)
                if data.length > 0 {
                    let result = ""
                    for j in 0..data.length {
                        result = result + char_from_code(data[j])
                    }
                    return result
                }
            }
        }
        return null
    }

    // Find files matching pattern across all archives
    fn find_files(&self, pattern: string): [string] {
        let results: [string] = []
        let seen: [string] = []  // Avoid duplicates

        for i in 0..self.archives.length {
            let matches = self.archives[i].find_files(pattern)
            for j in 0..matches.length {
                let file = matches[j]
                let already_seen = false
                for k in 0..seen.length {
                    if seen[k] == file {
                        already_seen = true
                        break
                    }
                }
                if !already_seen {
                    seen = seen + [file]
                    results = results + [file]
                }
            }
        }

        return results
    }

    // Get total number of files across all archives
    fn get_total_file_count(&self): i32 {
        let count = 0
        for i in 0..self.archives.length {
            count = count + self.archives[i].get_file_count()
        }
        return count
    }

    // Get number of loaded archives
    fn get_archive_count(&self): i32 {
        return self.archives.length
    }

    // Close all archives
    fn close_all(&self) {
        for i in 0..self.archives.length {
            self.archives[i].close()
        }
        self.archives = []
    }
}

// ============================================================================
// C&C Generals specific archive loading
// ============================================================================

// Standard BIG files in C&C Generals Zero Hour
fn get_standard_big_files(): [string] {
    return [
        "INIZH.big",      // Zero Hour INI files
        "INI.big",        // Base game INI files
        "Speech.big",     // Voice audio
        "SpeechZH.big",   // Zero Hour voices
        "Audio.big",      // Sound effects
        "AudioZH.big",    // Zero Hour sounds
        "W3D.big",        // 3D models
        "W3DZH.big",      // Zero Hour models
        "Textures.big",   // Textures
        "TexturesZH.big", // Zero Hour textures
        "Maps.big",       // Single player maps
        "MapsZH.big",     // Zero Hour maps
        "Window.big",     // UI definitions
        "WindowZH.big",   // Zero Hour UI
        "Terrain.big",    // Terrain data
        "TerrainZH.big",  // Zero Hour terrain
        "English.big",    // Localized strings
        "EnglishZH.big",  // Zero Hour strings
    ]
}

// Load all standard game archives
fn load_game_archives(game_path: string): BigFileSystem {
    let fs = BigFileSystem::init()

    // Add the game directory as search path
    fs.add_search_path(game_path)

    // Try to load each standard archive
    let big_files = get_standard_big_files()
    for i in 0..big_files.length {
        let full_path = game_path + "/" + big_files[i]
        fs.load_archive(full_path)
    }

    return fs
}

// ============================================================================
// TESTS
// ============================================================================

fn test_pattern_matching(): bool {
    if !match_pattern("test.ini", "*.ini") {
        return false
    }
    if !match_pattern("data/ini/test.ini", "*.ini") {
        return false
    }
    if match_pattern("test.tga", "*.ini") {
        return false
    }
    if !match_pattern("test.ini", "test.???") {
        return false
    }
    if !match_pattern("TEST.INI", "*.ini") {
        return false
    }
    if !match_pattern("a", "*") {
        return false
    }
    if !match_pattern("abc", "a*c") {
        return false
    }
    if !match_pattern("data/ini/gamedata.ini", "data/ini/*.ini") {
        return false
    }
    return true
}

fn test_path_normalization(): bool {
    let archive = BigArchive::init()

    let p1 = archive.normalize_path("Data\\INI\\GameData.ini")
    if p1 != "data/ini/gamedata.ini" {
        return false
    }

    let p2 = archive.normalize_path("already/lowercase/path.txt")
    if p2 != "already/lowercase/path.txt" {
        return false
    }

    return true
}

fn test_archived_file_info(): bool {
    let info = ArchivedFileInfo::init("data/ini/gamedata.ini", 1000, 5000)

    if info.name != "data/ini/gamedata.ini" {
        return false
    }
    if info.position != 1000 {
        return false
    }
    if info.size != 5000 {
        return false
    }

    return true
}

fn test_big_archive_init(): bool {
    let archive = BigArchive::init()

    if archive.file_path != "" {
        return false
    }
    if archive.is_open != false {
        return false
    }
    if archive.file_count != 0 {
        return false
    }

    return true
}

fn test_big_file_system_init(): bool {
    let fs = BigFileSystem::init()

    if fs.get_archive_count() != 0 {
        return false
    }
    if fs.get_total_file_count() != 0 {
        return false
    }

    return true
}

fn test_big_reader(): bool {
    // Build test data array
    let data: [i32] = []
    data = data + [0x12]
    data = data + [0x34]
    data = data + [0x56]
    data = data + [0x78]

    let reader = BigReader::init(data)

    // Test little-endian read
    let le = reader.read_u32_le()
    if le != 0x78563412 {
        return false
    }

    // Reset and test big-endian read
    reader.seek(0)
    let be = reader.read_u32_be()
    if be != 0x12345678 {
        return false
    }

    return true
}

fn test_magic_validation(): bool {
    // Test BIGF magic (0x42 0x49 0x47 0x46 = "BIGF")
    let data: [i32] = []
    data = data + [0x42]
    data = data + [0x49]
    data = data + [0x47]
    data = data + [0x46]

    let reader = BigReader::init(data)
    let magic = reader.read_u32_le()

    if magic != BIG_MAGIC_BIGF {
        return false
    }

    return true
}

fn run_all_tests(): bool {
    if !test_pattern_matching() {
        return false
    }
    if !test_path_normalization() {
        return false
    }
    if !test_archived_file_info() {
        return false
    }
    if !test_big_archive_init() {
        return false
    }
    if !test_big_file_system_init() {
        return false
    }
    if !test_big_reader() {
        return false
    }
    if !test_magic_validation() {
        return false
    }
    return true
}
