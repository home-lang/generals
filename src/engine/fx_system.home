    def.particle_configs = [
        create_explosion_fire_config(1.0),
        create_explosion_smoke_config(1.0),
        create_debris_config(0.5),
        create_shockwave_config(0.8),
    ]
    def.particle_count = 4
    def.sound_name = "ExplosionMedium"
    def.sound_delay = 0.0
    def.duration = 3.0
    def.delay_start = 0.0
    def.scale_min = 0.8
    def.scale_max = 1.2
    def.has_light = true
    def.light_color = Vec3::create(1.0, 0.5, 0.1)
    def.light_radius = 40.0
    def.light_duration = 0.5
    def.shake_intensity = 0.3
    def.shake_duration = 0.4
    return def
}

fn create_large_explosion_def(): FXDefinition {
    let def = FXDefinition::init()
    def.name = "FX_LargeExplosion"
    def.fx_type = FXType::LARGE_EXPLOSION
    def.particle_configs = [
