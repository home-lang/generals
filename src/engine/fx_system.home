fn create_explosion_fire_config(scale: f32): ParticleConfig {
    let config = ParticleConfig::init()
    config.emitter_name = "ExplosionFire"
    config.offset = Vec3::init()
    config.inherit_velocity = false
    config.max_particles = 50
    config.lifetime_min = 0.3 * scale
    config.lifetime_max = 0.6 * scale
    config.size_min = 5.0 * scale
    config.size_max = 10.0 * scale
    config.emit_rate = 0.0
    config.burst_count = (30.0 * scale) as i32
    config.start_color_r = 1.0
    config.start_color_g = 0.8
    config.start_color_b = 0.2
    config.start_color_a = 1.0
    config.end_color_r = 1.0
    config.end_color_g = 0.3
    config.end_color_b = 0.0
    config.end_color_a = 0.0
    config.velocity_min = Vec3::create(-20.0 * scale, 10.0 * scale, -20.0 * scale)
    config.velocity_max = Vec3::create(20.0 * scale, 40.0 * scale, 20.0 * scale)
    config.gravity = Vec3::create(0.0, -5.0, 0.0)
    config.texture_name = "EXFire01"
    config.blend_mode = 1  // Additive
    return config
}

fn create_explosion_smoke_config(scale: f32): ParticleConfig {
    let config = ParticleConfig::init()
    config.emitter_name = "ExplosionSmoke"
    config.offset = Vec3::create(0.0, 2.0 * scale, 0.0)
    config.inherit_velocity = false
    config.max_particles = 100
    config.lifetime_min = 1.0 * scale
    config.lifetime_max = 2.0 * scale
    config.size_min = 8.0 * scale
