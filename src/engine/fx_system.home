// ============================================================================
// GLOBAL FX SYSTEM INSTANCE
// ============================================================================

let g_fx_system: FXSystem? = null

fn init_fx_system(): FXSystem {
    let system = FXSystem::init()
    system.register_default_fx()
    g_fx_system = system
    return system
}

fn get_fx_system(): FXSystem? {
    return g_fx_system
}

fn shutdown_fx_system() {
    g_fx_system = null
}

fn fx_update(delta_time: f32) {
    if g_fx_system != null {
        g_fx_system.update(delta_time)
    }
}

fn fx_spawn(name: string, x: f32, y: f32, z: f32): i32 {
    if g_fx_system != null {
        return g_fx_system.spawn_fx(name, Vec3::create(x, y, z))
    }
    return -1
}

fn fx_stop(instance_index: i32) {
    if g_fx_system != null {
        g_fx_system.stop_fx(instance_index)
    }
}

fn fx_set_quality(quality: i32) {
    if g_fx_system != null {
        g_fx_system.set_quality(quality)
    }
}

// Convenience functions
fn fx_small_explosion(x: f32, y: f32, z: f32) {
    fx_spawn("FX_SmallExplosion", x, y, z)
}

fn fx_medium_explosion(x: f32, y: f32, z: f32) {
    fx_spawn("FX_MediumExplosion", x, y, z)
}

fn fx_large_explosion(x: f32, y: f32, z: f32) {
    fx_spawn("FX_LargeExplosion", x, y, z)
}

fn fx_muzzle_flash(x: f32, y: f32, z: f32) {
    fx_spawn("FX_MuzzleFlash", x, y, z)
}

fn fx_missile_trail(x: f32, y: f32, z: f32): i32 {
    return fx_spawn("FX_MissileTrail", x, y, z)
}

fn fx_dust_trail(x: f32, y: f32, z: f32): i32 {
    return fx_spawn("FX_DustTrail", x, y, z)
}

fn fx_building_fire(x: f32, y: f32, z: f32): i32 {
    return fx_spawn("FX_BuildingFire", x, y, z)
}
