// FX definition factories
fn create_small_explosion_def(): FXDefinition {
    let def = FXDefinition::init()
    def.name = "FX_SmallExplosion"
    def.fx_type = FXType::SMALL_EXPLOSION
    def.particle_configs = [
        create_explosion_fire_config(0.5),
        create_explosion_smoke_config(0.5),
        create_debris_config(0.3),
    ]
    def.particle_count = 3
    def.sound_name = "ExplosionSmall"
    def.sound_delay = 0.0
    def.duration = 2.0
    def.delay_start = 0.0
    def.scale_min = 0.8
    def.scale_max = 1.2
    def.has_light = true
    def.light_color = Vec3::create(1.0, 0.6, 0.2)
    def.light_radius = 20.0
    def.light_duration = 0.3
    def.shake_intensity = 0.1
    def.shake_duration = 0.2
    return def
}

fn create_medium_explosion_def(): FXDefinition {
    let def = FXDefinition::init()
    def.name = "FX_MediumExplosion"
