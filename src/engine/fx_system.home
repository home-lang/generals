// FX System - Visual effects manager connecting FXList definitions to particles/sounds
// Implements the C&C Generals effect system for explosions, impacts, etc.

let MAX_FX_INSTANCES: i32 = 512
let MAX_FX_DEFINITIONS: i32 = 256
let MAX_EMITTERS_PER_FX: i32 = 8
let MAX_PARTICLE_CONFIGS: i32 = 4

// Vec3 for positions
struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(): Vec3 {
        return Vec3 {
            x: 0.0,
            y: 0.0,
            z: 0.0,
        }
    }

    fn create(x: f32, y: f32, z: f32): Vec3 {
        return Vec3 {
            x: x,
            y: y,
            z: z,
        }
    }

    fn add(&self, other: Vec3): Vec3 {
        return Vec3 {
            x: self.x + other.x,
            y: self.y + other.y,
            z: self.z + other.z,
        }
    }
}

// Predefined FX types
enum FXType {
    // Explosions
    SMALL_EXPLOSION,
    MEDIUM_EXPLOSION,
    LARGE_EXPLOSION,
    NUCLEAR_EXPLOSION,

    // Weapon effects
    MUZZLE_FLASH,
    BULLET_IMPACT,
    MISSILE_TRAIL,
    LASER_BEAM,
    TOXIN_SPRAY,
    FLAME_STREAM,

    // Vehicle effects
    DUST_TRAIL,
    TANK_TREADS,
    JET_EXHAUST,
    HELICOPTER_ROTOR,
    CRASH_FIRE,
    WRECK_SMOKE,

    // Building effects
    CONSTRUCTION_DUST,
    BUILDING_FIRE,
    BUILDING_SMOKE,
    POWER_PLANT_GLOW,
    FACTORY_SPARKS,

    // Environmental
    BLOOD_SPLATTER,
    WATER_SPLASH,
    DIRT_KICKUP,
    GLASS_SHATTERING,

    // Special powers
    PARTICLE_BEAM,
    CARPET_BOMBING,
    EMP_WAVE,
    ANTHRAX_CLOUD,
    NEUTRON_SHELL,

    // Misc
    LEVEL_UP,
    PROMOTION,
    HEAL,
    REPAIR,
}

// Particle configuration for an FX
struct ParticleConfig {
    emitter_name: string,
    offset: Vec3,
    inherit_velocity: bool,
    max_particles: i32,

    // Particle properties
    lifetime_min: f32,
    lifetime_max: f32,
    size_min: f32,
    size_max: f32,
    emit_rate: f32,
    burst_count: i32,

    // Color
    start_color_r: f32,
    start_color_g: f32,
    start_color_b: f32,
    start_color_a: f32,
    end_color_r: f32,
    end_color_g: f32,
    end_color_b: f32,
    end_color_a: f32,

    // Velocity
    velocity_min: Vec3,
    velocity_max: Vec3,
    gravity: Vec3,

    // Texture
    texture_name: string,
    blend_mode: i32,  // 0=Alpha, 1=Additive, 2=Multiply
}

impl ParticleConfig {
    fn init(): ParticleConfig {
        return ParticleConfig {
            emitter_name: "",
            offset: Vec3::init(),
            inherit_velocity: false,
            max_particles: 0,
            lifetime_min: 1.0,
            lifetime_max: 1.0,
            size_min: 1.0,
            size_max: 1.0,
            emit_rate: 0.0,
            burst_count: 0,
            start_color_r: 1.0,
            start_color_g: 1.0,
            start_color_b: 1.0,
            start_color_a: 1.0,
            end_color_r: 1.0,
            end_color_g: 1.0,
            end_color_b: 1.0,
            end_color_a: 0.0,
            velocity_min: Vec3::init(),
            velocity_max: Vec3::init(),
            gravity: Vec3::init(),
            texture_name: "",
            blend_mode: 0,
        }
    }
}

// FX definition (from INI)
struct FXDefinition {
    name: string,
    fx_type: FXType,

    // Particle configurations
    particle_configs: [ParticleConfig],
    particle_count: i32,

    // Audio
    sound_name: string,
    sound_delay: f32,

    // Timing
    duration: f32,
    delay_start: f32,

    // Scale modifiers
    scale_min: f32,
    scale_max: f32,

    // Light
    has_light: bool,
    light_color: Vec3,
    light_radius: f32,
    light_duration: f32,

    // Screen shake
    shake_intensity: f32,
    shake_duration: f32,
}

impl FXDefinition {
    fn init(): FXDefinition {
        return FXDefinition {
            name: "",
            fx_type: FXType::SMALL_EXPLOSION,
            particle_configs: [],
            particle_count: 0,
            sound_name: "",
            sound_delay: 0.0,
            duration: 1.0,
            delay_start: 0.0,
            scale_min: 1.0,
            scale_max: 1.0,
            has_light: false,
            light_color: Vec3::init(),
            light_radius: 0.0,
            light_duration: 0.0,
            shake_intensity: 0.0,
            shake_duration: 0.0,
        }
    }
}

// FX instance - a spawned effect
struct FXInstance {
    fx_name: string,
    position: Vec3,
    rotation: f32,
    scale: f32,

    // Component handles
    emitter_ids: [i32],
    emitter_count: i32,
    audio_handle: i32,

    // State
    lifetime: f32,
    elapsed: f32,
    is_active: bool,
    is_attached: bool,
    attached_object_id: i32,
    attached_bone: string,
}

impl FXInstance {
    fn init(): FXInstance {
        return FXInstance {
            fx_name: "",
            position: Vec3::init(),
            rotation: 0.0,
            scale: 1.0,
            emitter_ids: [],
            emitter_count: 0,
            audio_handle: 0,
            lifetime: 5.0,
            elapsed: 0.0,
            is_active: false,
            is_attached: false,
            attached_object_id: 0,
            attached_bone: "",
        }
    }

    fn update(&self, delta_time: f32) {
        if !self.is_active {
            return
        }

        self.elapsed = self.elapsed + delta_time

        // Update attached position if attached to an object
        if self.is_attached {
            // Get object position + bone offset
            // self.position = get_object_bone_position(self.attached_object_id, self.attached_bone)
        }

        // Check if effect should die
        if self.elapsed >= self.lifetime {
            self.stop()
        }
    }

    fn stop(&self) {
        self.is_active = false
        // Stop all emitters (would call particle system)
    }
}

// FX System manager
struct FXSystem {
    // FX definitions
    definitions: [FXDefinition],
    definition_count: i32,

    // Active instances
    instances: [FXInstance],
    instance_count: i32,

    // Performance
    max_active_fx: i32,
    current_active: i32,

    // Quality settings
    fx_quality: i32,  // 0=Low, 1=Medium, 2=High

    is_initialized: bool,
}

impl FXSystem {
    fn init(): FXSystem {
        let system = FXSystem {
            definitions: [],
            definition_count: 0,
            instances: [],
            instance_count: 0,
            max_active_fx: 256,
            current_active: 0,
            fx_quality: 2,
            is_initialized: true,
        }

        return system
    }

    fn register_default_fx(&self) {
        // Small explosion
        self.register_fx(create_small_explosion_def())
        // Medium explosion
        self.register_fx(create_medium_explosion_def())
        // Large explosion
        self.register_fx(create_large_explosion_def())
        // Muzzle flash
        self.register_fx(create_muzzle_flash_def())
        // Missile trail
        self.register_fx(create_missile_trail_def())
        // Dust trail
        self.register_fx(create_dust_trail_def())
        // Building fire
        self.register_fx(create_building_fire_def())
    }

    fn register_fx(&self, definition: FXDefinition) {
        if self.definition_count >= MAX_FX_DEFINITIONS {
            return
        }

        self.definitions = self.definitions + [definition]
        self.definition_count = self.definition_count + 1
    }

    fn find_definition(&self, name: string): i32 {
        for i in 0..self.definition_count {
            if self.definitions[i].name == name {
                return i
            }
        }
        return -1
    }

    fn spawn_fx(&self, name: string, position: Vec3): i32 {
        let def_index = self.find_definition(name)
        if def_index < 0 {
            return -1
        }

        // Check max active
        if self.current_active >= self.max_active_fx {
            return -1
        }

        // Find free instance slot
        let instance_index = self.find_free_instance()
        if instance_index < 0 {
            return -1
        }

        let definition = self.definitions[def_index]

        // Create instance
        let instance = FXInstance::init()
        instance.fx_name = name
        instance.position = position
        instance.lifetime = definition.duration
        instance.elapsed = 0.0
        instance.is_active = true
        instance.emitter_count = 0

        // Create particle emitters for each config
        for i in 0..definition.particle_count {
            let config = definition.particle_configs[i]
            // Would create actual particle emitter here
            instance.emitter_ids = instance.emitter_ids + [i]
            instance.emitter_count = instance.emitter_count + 1
        }

        // Play sound if defined
        if definition.sound_name != "" {
            // audio_play_3d(definition.sound_name, position.x, position.y, position.z)
        }

        // Store instance
        if instance_index < self.instances.length {
            self.instances[instance_index] = instance
        } else {
            self.instances = self.instances + [instance]
        }

        self.current_active = self.current_active + 1
        self.instance_count = self.instance_count + 1

        return instance_index
    }

    fn find_free_instance(&self): i32 {
        for i in 0..self.instances.length {
            if !self.instances[i].is_active {
                return i
            }
        }
        // Return next slot
        return self.instances.length
    }

    fn update(&self, delta_time: f32) {
        for i in 0..self.instances.length {
            if self.instances[i].is_active {
                self.instances[i].update(delta_time)

                if !self.instances[i].is_active {
                    self.current_active = self.current_active - 1
                }
            }
        }
    }

    fn stop_fx(&self, instance_index: i32) {
        if instance_index >= 0 && instance_index < self.instances.length {
            self.instances[instance_index].stop()
        }
    }

    fn set_quality(&self, quality: i32) {
        if quality < 0 {
            self.fx_quality = 0
        } else if quality > 2 {
            self.fx_quality = 2
        } else {
            self.fx_quality = quality
        }

        // Adjust max active based on quality
        if self.fx_quality == 0 {
            self.max_active_fx = 64
        } else if self.fx_quality == 1 {
            self.max_active_fx = 128
        } else {
            self.max_active_fx = 256
        }
    }

    fn get_active_count(&self): i32 {
        return self.current_active
    }
}

