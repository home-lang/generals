        create_shockwave_config(1.5),
    ]
    def.particle_count = 4
    def.sound_name = "ExplosionLarge"
    def.sound_delay = 0.0
    def.duration = 5.0
    def.delay_start = 0.0
    def.scale_min = 0.9
    def.scale_max = 1.1
    def.has_light = true
    def.light_color = Vec3::create(1.0, 0.4, 0.0)
    def.light_radius = 80.0
    def.light_duration = 0.8
    def.shake_intensity = 0.6
    def.shake_duration = 0.6
    return def
}

