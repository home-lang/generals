// Localization System - String file handler for game text
// Based on Thyme: game/client/gametext.cpp, game/client/gametext.h
// Handles CSF (Compiled String File) format used by C&C Generals

// ============================================================================
// LANGUAGE IDS
// ============================================================================

enum LanguageID {
    US,
    UK,
    GERMAN,
    FRENCH,
    SPANISH,
    ITALIAN,
    JAPANESE,
    JABBER,
    KOREAN,
    CHINESE,
    UNK1,
    BRAZILIAN,
    POLISH,
    UNKNOWN,
}

// ============================================================================
// CSF FILE FORMAT STRUCTURES
// ============================================================================

// CSF header format
// Magic: " FSC" (0x43534620)
// Version: 3
struct CSFHeader {
    magic: i32,           // " FSC" magic number
    version: i32,         // File version (3 for Generals)
    num_labels: i32,      // Number of label entries
    num_strings: i32,     // Number of strings
    skip: i32,            // Unknown/reserved
    langid: LanguageID,   // Language identifier
}

impl CSFHeader {
    fn init(): CSFHeader {
        return CSFHeader {
            magic: 0x43534620,  // " FSC"
            version: 3,
            num_labels: 0,
            num_strings: 0,
            skip: 0,
            langid: LanguageID::US,
        }
    }

    fn is_valid(&self): bool {
        return self.magic == 0x43534620 && self.version >= 2 && self.version <= 3
    }
}

// String information entry
struct StringInfo {
    label: string,        // Label identifier (e.g., "GUI:OK")
    text: string,         // Localized text (Unicode)
    speech: string,       // Speech file path (optional)
}

impl StringInfo {
    fn init(label: string, text: string): StringInfo {
        return StringInfo {
            label: label,
            text: text,
            speech: "",
        }
    }
}

// String lookup table entry for fast searching
struct StringLookup {
    label: string,
    info_index: i32,
}

// Missing string tracking
struct NoString {
    text: string,
    next_index: i32,
}

// ============================================================================
// LOCALIZATION MANAGER
// ============================================================================

struct Localization {
    text_count: i32,
    max_label_len: i32,
    string_info: [StringInfo],
    string_lookup: [StringLookup],
    is_initialized: bool,
    no_strings: [NoString],
    use_string_file: bool,
    language: LanguageID,
    failed_string: string,

    // Map-specific strings
    map_string_info: [StringInfo],
    map_string_lookup: [StringLookup],
    map_text_count: i32,
}

impl Localization {
    fn init(): Localization {
        return Localization {
            text_count: 0,
            max_label_len: 0,
            string_info: [],
            string_lookup: [],
            is_initialized: false,
            no_strings: [],
            use_string_file: false,
            language: LanguageID::US,
            failed_string: "MISSING STRING",
            map_string_info: [],
            map_string_lookup: [],
            map_text_count: 0,
        }
    }

    fn initialize(&self) {
        // Load default string file
        self.load_csf_file("Data/English/generals.csf")
        self.is_initialized = true
    }

    fn reset(&self) {
        // Clear map-specific strings
        self.map_string_info = []
        self.map_string_lookup = []
        self.map_text_count = 0
    }

    fn deinit(&self) {
        self.string_info = []
        self.string_lookup = []
        self.map_string_info = []
        self.map_string_lookup = []
        self.is_initialized = false
    }

    // Fetch a localized string by label
    fn fetch(&self, label: string): string {
        // Binary search in sorted lookup table
        let index = self.binary_search_label(label)
        if index >= 0 {
            return self.string_info[index].text
        }

        // Check map strings
        let map_index = self.binary_search_map_label(label)
        if map_index >= 0 {
            return self.map_string_info[map_index].text
        }

        // String not found - track for debugging
        self.add_missing_string(label)
        return self.failed_string
    }

    // Binary search for label
    fn binary_search_label(&self, label: string): i32 {
        let low = 0
        let high = self.text_count - 1

        while low <= high {
            let mid = (low + high) / 2
            let cmp = compare_strings(self.string_lookup[mid].label, label)

            if cmp < 0 {
                low = mid + 1
            } else if cmp > 0 {
                high = mid - 1
            } else {
                return self.string_lookup[mid].info_index
            }
        }

        return -1
    }

    // Binary search in map strings
    fn binary_search_map_label(&self, label: string): i32 {
        let low = 0
        let high = self.map_text_count - 1

        while low <= high {
            let mid = (low + high) / 2
            let cmp = compare_strings(self.map_string_lookup[mid].label, label)

            if cmp < 0 {
                low = mid + 1
            } else if cmp > 0 {
                high = mid - 1
            } else {
                return self.map_string_lookup[mid].info_index
            }
        }

        return -1
    }

    fn add_missing_string(&self, label: string) {
        // Check if already tracked
        for i in 0..self.no_strings.length {
            if self.no_strings[i].text == label {
                return
            }
        }

        // Add to missing list
        let no_string = NoString {
            text: label,
            next_index: -1,
        }
        self.no_strings = self.no_strings + [no_string]
    }

    // Load a CSF (Compiled String File)
    fn load_csf_file(&self, filename: string): bool {
        // In real implementation:
        // 1. Open file
        // 2. Read CSFHeader
        // 3. For each label:
        //    - Read " LBL" marker
        //    - Read string count
        //    - Read label length and label
        //    - Read " RTS" or "WRTS" marker
        //    - Read text length and text (XOR encoded with 0xFFFFFFFF)
        //    - Optionally read extra data (speech file)
        // 4. Sort lookup table for binary search

        return true
    }

    // Load CSF data from memory
    fn load_csf(&self, data: [i32]): bool {
        if data.length < 24 {  // Minimum header size
            return false
        }

        // Read header
        let header = CSFHeader::init()
        header.magic = read_i32_le(data, 0)
        header.version = read_i32_le(data, 4)
        header.num_labels = read_i32_le(data, 8)
        header.num_strings = read_i32_le(data, 12)
        header.skip = read_i32_le(data, 16)
        // header.langid = read_i32_le(data, 20)

        if !header.is_valid() {
            return false
        }

        self.text_count = header.num_labels
        self.language = header.langid

        // Parse string entries
        let offset = 24  // After header
        for i in 0..header.num_labels {
            // In real implementation, parse each entry
            // Format: " LBL" + count + label_length + label + " RTS" + text_length + encoded_text
        }

        // Sort lookup table for binary search
        self.sort_lookup_table()

        return true
    }

    fn sort_lookup_table(&self) {
        // Simple insertion sort for lookup table
        for i in 1..self.string_lookup.length {
            let key = self.string_lookup[i]
            let j = i - 1

            while j >= 0 && compare_strings(self.string_lookup[j].label, key.label) > 0 {
                self.string_lookup[j + 1] = self.string_lookup[j]
                j = j - 1
            }
            self.string_lookup[j + 1] = key
        }
    }

    // Initialize map-specific strings
    fn init_map_strings(&self, filename: string) {
        // Clear existing map strings
        self.map_string_info = []
        self.map_string_lookup = []
        self.map_text_count = 0

        // Load map string file
        // Map files use .str extension with INI-like format
    }

    // Get all strings with a given prefix
    fn get_strings_with_prefix(&self, prefix: string): [string] {
        let results: [string] = []

        for i in 0..self.text_count {
            if starts_with(self.string_info[i].label, prefix) {
                results = results + [self.string_info[i].label]
            }
        }

        return results
    }

    fn get_language(&self): LanguageID {
        return self.language
    }

    fn set_language(&self, lang: LanguageID) {
        self.language = lang
    }
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn read_i32_le(data: [i32], offset: i32): i32 {
    return data[offset] |
           (data[offset + 1] << 8) |
           (data[offset + 2] << 16) |
           (data[offset + 3] << 24)
}

fn compare_strings(a: string, b: string): i32 {
    // String comparison (case-insensitive)
    // Returns -1 if a < b, 0 if a == b, 1 if a > b
    // In real implementation, would do proper string comparison
    if a == b {
        return 0
    }
    return 1  // Placeholder
}

fn starts_with(s: string, prefix: string): bool {
