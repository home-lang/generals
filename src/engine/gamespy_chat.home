// GameSpy Chat - Chat system for online multiplayer
// Handles channels, messages, user presence, and chat moderation

// ============================================================================
// Configuration
// ============================================================================

struct GameSpyChatConfig {
    server_address: string,
    server_port: i32,
    reconnect_delay: f32,
    heartbeat_interval: f32,
    max_channels: i32,
    max_users_per_channel: i32,
    max_message_length: i32,
    message_rate_limit: f32,
    nick_max_length: i32,
    channel_name_max: i32,
    enable_profanity_filter: bool,
    auto_join_lobby: bool,
    lobby_channel: string,
}

impl GameSpyChatConfig {
    fn init(): GameSpyChatConfig {
        return GameSpyChatConfig {
            server_address: "chat.gamespy.com",
            server_port: 6667,
            reconnect_delay: 5.0,
            heartbeat_interval: 30.0,
            max_channels: 10,
            max_users_per_channel: 256,
            max_message_length: 512,
            message_rate_limit: 0.5,
            nick_max_length: 32,
            channel_name_max: 64,
            enable_profanity_filter: true,
            auto_join_lobby: true,
            lobby_channel: "#GPG_Generals",
        }
    }
}

// ============================================================================
// Chat States
// ============================================================================

enum ChatConnectionState {
    DISCONNECTED,
    CONNECTING,
    AUTHENTICATING,
    CONNECTED,
    RECONNECTING,
    ERROR,
}

enum ChannelType {
    LOBBY,
    GAME,
    PRIVATE,
    CLAN,
    TOURNAMENT,
}

enum UserStatus {
    ONLINE,
    AWAY,
    IN_GAME,
    IDLE,
    DO_NOT_DISTURB,
    OFFLINE,
}

// ============================================================================
// Chat User
// ============================================================================

struct ChatUser {
    user_id: i64,
    nickname: string,
    profile_id: i64,
    status: UserStatus,
    status_message: string,
    is_operator: bool,
    is_voice: bool,
    is_muted: bool,
    is_banned: bool,
    is_friend: bool,
    is_ignored: bool,
    join_time: f32,
    last_message_time: f32,
    game_info: string,
}

impl ChatUser {
    fn init(user_id: i64, nickname: string): ChatUser {
        return ChatUser {
            user_id: user_id,
            nickname: nickname,
            profile_id: 0,
            status: UserStatus::ONLINE,
            status_message: "",
            is_operator: false,
            is_voice: false,
            is_muted: false,
            is_banned: false,
            is_friend: false,
            is_ignored: false,
            join_time: 0.0,
            last_message_time: 0.0,
            game_info: "",
        }
    }
}

// ============================================================================
// Chat Channel
// ============================================================================

struct ChatChannel {
    channel_id: i64,
    name: string,
    topic: string,
    channel_type: ChannelType,
    password: string,
    is_password_protected: bool,
    user_limit: i32,
    users: [i64],
    user_count: i32,
    operators: [i64],
    operator_count: i32,
    is_moderated: bool,
    is_invite_only: bool,
    created_time: f32,
    last_activity: f32,
}

impl ChatChannel {
    fn init(channel_id: i64, name: string, channel_type: ChannelType): ChatChannel {
        let usr: [i64] = []
        for i in 0..256 {
            usr = usr + [0]
        }
        let ops: [i64] = []
        for i in 0..16 {
            ops = ops + [0]
        }
        return ChatChannel {
            channel_id: channel_id,
            name: name,
            topic: "",
            channel_type: channel_type,
            password: "",
            is_password_protected: false,
            user_limit: 256,
            users: usr,
            user_count: 0,
            operators: ops,
            operator_count: 0,
            is_moderated: false,
            is_invite_only: false,
            created_time: 0.0,
            last_activity: 0.0,
        }
    }

    fn add_user(&self, user_id: i64): bool {
        if self.user_count >= self.user_limit {
            return false
        }

        // Check if already in channel
        for i in 0..self.user_count {
            if self.users[i] == user_id {
                return false
            }
        }

        self.users[self.user_count] = user_id
        self.user_count = self.user_count + 1
        return true
    }

    fn remove_user(&self, user_id: i64): bool {
        for i in 0..self.user_count {
            if self.users[i] == user_id {
                // Shift remaining users
                for j in i..(self.user_count - 1) {
                    self.users[j] = self.users[j + 1]
                }
                self.user_count = self.user_count - 1
                return true
            }
        }
        return false
    }

    fn has_user(&self, user_id: i64): bool {
        for i in 0..self.user_count {
            if self.users[i] == user_id {
                return true
            }
        }
        return false
    }

    fn is_operator(&self, user_id: i64): bool {
        for i in 0..self.operator_count {
            if self.operators[i] == user_id {
                return true
            }
        }
        return false
    }
}

// ============================================================================
// Chat Message
// ============================================================================

enum MessageType {
    PUBLIC,
    PRIVATE,
    ACTION,
    NOTICE,
    SERVER,
    ERROR,
    JOIN,
    PART,
    KICK,
    BAN,
    TOPIC_CHANGE,
    MODE_CHANGE,
}

struct ChatMessage {
    message_id: i64,
    message_type: MessageType,
    sender_id: i64,
    sender_name: string,
    channel_id: i64,
    channel_name: string,
    content: string,
    timestamp: f32,
    is_highlighted: bool,
    is_filtered: bool,
}

impl ChatMessage {
    fn init(message_id: i64, sender_id: i64, sender_name: string, content: string): ChatMessage {
        return ChatMessage {
            message_id: message_id,
            message_type: MessageType::PUBLIC,
            sender_id: sender_id,
            sender_name: sender_name,
            channel_id: 0,
            channel_name: "",
            content: content,
            timestamp: 0.0,
            is_highlighted: false,
            is_filtered: false,
        }
    }
}

// ============================================================================
// Chat Command
// ============================================================================

enum ChatCommand {
    JOIN,
    PART,
    MSG,
    NICK,
    AWAY,
    BACK,
    KICK,
    BAN,
    UNBAN,
    OP,
    DEOP,
    TOPIC,
    MODE,
    INVITE,
    IGNORE,
    UNIGNORE,
    WHO,
    WHOIS,
    LIST,
    QUIT,
}

struct ParsedCommand {
    command: ChatCommand,
    target: string,
    args: string,
    is_valid: bool,
}

impl ParsedCommand {
    fn init(): ParsedCommand {
        return ParsedCommand {
            command: ChatCommand::MSG,
            target: "",
            args: "",
            is_valid: false,
        }
    }
}

fn parse_chat_command(input: string): ParsedCommand {
    let result = ParsedCommand::init()

    if input.length == 0 {
        return result
    }

    // Check for command prefix
    let first_char = string_char_at(input, 0)
    if first_char != "/" {
        return result
    }

    // Find command end (space or end of string)
    let cmd_end = 1
    while cmd_end < input.length && string_char_at(input, cmd_end) != " " {
        cmd_end = cmd_end + 1
    }

    let cmd_str = string_substring(input, 1, cmd_end)

    // Parse command
    if cmd_str == "join" || cmd_str == "j" {
        result.command = ChatCommand::JOIN
        result.is_valid = true
    } else if cmd_str == "part" || cmd_str == "leave" {
        result.command = ChatCommand::PART
        result.is_valid = true
    } else if cmd_str == "msg" || cmd_str == "pm" || cmd_str == "w" {
        result.command = ChatCommand::MSG
        result.is_valid = true
    } else if cmd_str == "nick" {
        result.command = ChatCommand::NICK
        result.is_valid = true
    } else if cmd_str == "away" {
        result.command = ChatCommand::AWAY
        result.is_valid = true
    } else if cmd_str == "back" {
        result.command = ChatCommand::BACK
        result.is_valid = true
    } else if cmd_str == "kick" {
        result.command = ChatCommand::KICK
        result.is_valid = true
    } else if cmd_str == "ban" {
        result.command = ChatCommand::BAN
        result.is_valid = true
    } else if cmd_str == "unban" {
        result.command = ChatCommand::UNBAN
        result.is_valid = true
    } else if cmd_str == "op" {
        result.command = ChatCommand::OP
        result.is_valid = true
    } else if cmd_str == "deop" {
        result.command = ChatCommand::DEOP
        result.is_valid = true
    } else if cmd_str == "topic" {
        result.command = ChatCommand::TOPIC
        result.is_valid = true
    } else if cmd_str == "invite" {
        result.command = ChatCommand::INVITE
        result.is_valid = true
    } else if cmd_str == "ignore" {
        result.command = ChatCommand::IGNORE
        result.is_valid = true
    } else if cmd_str == "unignore" {
        result.command = ChatCommand::UNIGNORE
        result.is_valid = true
    } else if cmd_str == "who" {
        result.command = ChatCommand::WHO
        result.is_valid = true
    } else if cmd_str == "whois" {
        result.command = ChatCommand::WHOIS
        result.is_valid = true
    } else if cmd_str == "list" {
        result.command = ChatCommand::LIST
        result.is_valid = true
    } else if cmd_str == "quit" || cmd_str == "q" {
        result.command = ChatCommand::QUIT
        result.is_valid = true
    } else if cmd_str == "me" {
        result.command = ChatCommand::MSG  // Action
        result.is_valid = true
    }

    // Parse target and args
    if cmd_end < input.length {
        let remaining = string_substring(input, cmd_end + 1, input.length)
        // First word is target, rest is args
        let target_end = 0
        while target_end < remaining.length && string_char_at(remaining, target_end) != " " {
            target_end = target_end + 1
        }
        result.target = string_substring(remaining, 0, target_end)
        if target_end < remaining.length {
            result.args = string_substring(remaining, target_end + 1, remaining.length)
        }
    }

    return result
}

// Helper string functions
fn string_char_at(s: string, idx: i32): string {
    if idx < 0 || idx >= s.length {
        return ""
    }
    return string_substring(s, idx, idx + 1)
}

fn string_substring(s: string, start: i32, end: i32): string {
    // Placeholder - would need actual implementation
    return s
}

fn string_starts_with(s: string, prefix: string): bool {
    if prefix.length > s.length {
        return false
    }
    for i in 0..prefix.length {
        if string_char_at(s, i) != string_char_at(prefix, i) {
            return false
        }
    }
    return true
}

// ============================================================================
// User Storage (replaces HashMap<u64, ChatUser>)
// ============================================================================

struct UserStorage {
    users: [ChatUser],
    user_ids: [i64],
    count: i32,
}

impl UserStorage {
    fn init(): UserStorage {
        return UserStorage {
            users: [],
            user_ids: [],
            count: 0,
        }
    }

    fn get(&self, user_id: i64): ChatUser? {
        for i in 0..self.count {
            if self.user_ids[i] == user_id {
                return self.users[i]
            }
        }
        return null
    }

    fn insert(&self, user_id: i64, user: ChatUser) {
        // Check if exists
        for i in 0..self.count {
            if self.user_ids[i] == user_id {
                self.users[i] = user
                return
            }
        }
        // Add new
        self.users = self.users + [user]
        self.user_ids = self.user_ids + [user_id]
        self.count = self.count + 1
    }
}

// ============================================================================
// Nick to ID mapping (replaces HashMap<string, u64>)
// ============================================================================

struct NickMap {
    nicks: [string],
    user_ids: [i64],
    count: i32,
}

impl NickMap {
    fn init(): NickMap {
        return NickMap {
            nicks: [],
            user_ids: [],
            count: 0,
        }
    }

    fn get(&self, nick: string): i64 {
        for i in 0..self.count {
            if self.nicks[i] == nick {
                return self.user_ids[i]
            }
        }
        return -1  // Not found
    }

    fn insert(&self, nick: string, user_id: i64) {
        for i in 0..self.count {
            if self.nicks[i] == nick {
                self.user_ids[i] = user_id
                return
            }
        }
        self.nicks = self.nicks + [nick]
        self.user_ids = self.user_ids + [user_id]
        self.count = self.count + 1
    }
}

// ============================================================================
// Channel Storage (replaces HashMap<u64, ChatChannel>)
// ============================================================================

struct ChannelStorage {
    channels: [ChatChannel],
    channel_ids: [i64],
    count: i32,
}

impl ChannelStorage {
    fn init(): ChannelStorage {
        return ChannelStorage {
            channels: [],
            channel_ids: [],
            count: 0,
        }
    }

    fn get(&self, channel_id: i64): ChatChannel? {
        for i in 0..self.count {
            if self.channel_ids[i] == channel_id {
                return self.channels[i]
            }
        }
        return null
    }

    fn insert(&self, channel_id: i64, channel: ChatChannel) {
        for i in 0..self.count {
            if self.channel_ids[i] == channel_id {
                self.channels[i] = channel
                return
            }
        }
        self.channels = self.channels + [channel]
        self.channel_ids = self.channel_ids + [channel_id]
        self.count = self.count + 1
    }
}

// ============================================================================
// Channel name to ID mapping
// ============================================================================

struct ChannelNameMap {
    names: [string],
    channel_ids: [i64],
    count: i32,
}

impl ChannelNameMap {
    fn init(): ChannelNameMap {
        return ChannelNameMap {
            names: [],
            channel_ids: [],
            count: 0,
        }
    }

    fn get(&self, name: string): i64 {
        for i in 0..self.count {
            if self.names[i] == name {
                return self.channel_ids[i]
            }
        }
        return -1
    }

    fn insert(&self, name: string, channel_id: i64) {
        for i in 0..self.count {
            if self.names[i] == name {
                self.channel_ids[i] = channel_id
                return
            }
        }
        self.names = self.names + [name]
        self.channel_ids = self.channel_ids + [channel_id]
        self.count = self.count + 1
    }
}

// ============================================================================
// GameSpy Chat Manager
// ============================================================================

struct GameSpyChatManager {
    config: GameSpyChatConfig,
    state: ChatConnectionState,

    // Local user
    local_user_id: i64,
    local_nickname: string,
    local_profile_id: i64,
    auth_token: string,

    // Users
    users: UserStorage,
    users_by_nick: NickMap,

    // Channels
    channels: ChannelStorage,
    channels_by_name: ChannelNameMap,
    joined_channels: [i64],
    joined_channel_count: i32,
    active_channel_id: i64,

    // Messages
    message_history: [ChatMessage],
    message_count: i32,
    next_message_id: i64,

    // Friends and ignore lists
    friends: [i64],
    friend_count: i32,
    ignored: [i64],
    ignored_count: i32,

    // Rate limiting
    last_message_time: f32,
    current_time: f32,

    // Connection
    next_user_id: i64,
    next_channel_id: i64,
    reconnect_timer: f32,
    heartbeat_timer: f32,
}

impl GameSpyChatManager {
    fn init(config: GameSpyChatConfig): GameSpyChatManager {
        let joined: [i64] = []
        for i in 0..10 {
            joined = joined + [0]
        }
        let msgs: [ChatMessage] = []
        for i in 0..1000 {
            msgs = msgs + [ChatMessage::init(0, 0, "", "")]
        }
        let friends_arr: [i64] = []
        for i in 0..100 {
            friends_arr = friends_arr + [0]
        }
        let ignored_arr: [i64] = []
        for i in 0..100 {
            ignored_arr = ignored_arr + [0]
        }
        return GameSpyChatManager {
            config: config,
            state: ChatConnectionState::DISCONNECTED,
            local_user_id: 0,
            local_nickname: "",
            local_profile_id: 0,
            auth_token: "",
            users: UserStorage::init(),
            users_by_nick: NickMap::init(),
            channels: ChannelStorage::init(),
            channels_by_name: ChannelNameMap::init(),
            joined_channels: joined,
            joined_channel_count: 0,
            active_channel_id: 0,
            message_history: msgs,
            message_count: 0,
            next_message_id: 1,
            friends: friends_arr,
            friend_count: 0,
            ignored: ignored_arr,
            ignored_count: 0,
            last_message_time: 0.0,
            current_time: 0.0,
            next_user_id: 1,
            next_channel_id: 1,
            reconnect_timer: 0.0,
            heartbeat_timer: 0.0,
        }
    }
}

// ============================================================================
// Connection Management
// ============================================================================

fn chat_connect(manager: GameSpyChatManager, nickname: string, profile_id: i64, auth_token: string): bool {
    if manager.state != ChatConnectionState::DISCONNECTED {
        return false
    }

    manager.local_nickname = nickname
    manager.local_profile_id = profile_id
    manager.auth_token = auth_token
    manager.state = ChatConnectionState::CONNECTING

    // Create local user
    manager.local_user_id = manager.next_user_id
    manager.next_user_id = manager.next_user_id + 1

    let local_user = ChatUser::init(manager.local_user_id, nickname)
    manager.users.insert(manager.local_user_id, local_user)
    manager.users_by_nick.insert(nickname, manager.local_user_id)

    // Simulate connection success
    manager.state = ChatConnectionState::CONNECTED

    // Auto-join lobby if configured
    if manager.config.auto_join_lobby {
        chat_join_channel(manager, manager.config.lobby_channel, "")
    }

    return true
}

fn chat_disconnect(manager: GameSpyChatManager, reason: string) {
    if manager.state == ChatConnectionState::DISCONNECTED {
        return
    }

    // Leave all channels
    while manager.joined_channel_count > 0 {
        chat_leave_channel(manager, manager.joined_channels[0])
    }

    manager.state = ChatConnectionState::DISCONNECTED
}

fn chat_reconnect(manager: GameSpyChatManager) {
    if manager.state != ChatConnectionState::DISCONNECTED {
        chat_disconnect(manager, "Reconnecting")
    }

    manager.state = ChatConnectionState::RECONNECTING
    manager.reconnect_timer = manager.config.reconnect_delay
}

// ============================================================================
// Channel Operations
// ============================================================================

fn chat_join_channel(manager: GameSpyChatManager, channel_name: string, password: string): bool {
    if manager.state != ChatConnectionState::CONNECTED {
        return false
    }

    if manager.joined_channel_count >= manager.config.max_channels {
        return false
    }

    // Check if already joined
    let existing_id = manager.channels_by_name.get(channel_name)
    if existing_id >= 0 {
        for i in 0..manager.joined_channel_count {
            if manager.joined_channels[i] == existing_id {
                return false  // Already in channel
            }
        }
    }

    // Create or get channel
    let channel_id = existing_id
    if existing_id < 0 {
        channel_id = manager.next_channel_id
        manager.next_channel_id = manager.next_channel_id + 1

        let channel_type = ChannelType::PRIVATE
        if string_starts_with(channel_name, "#GPG_") {
            channel_type = ChannelType::LOBBY
        } else if string_starts_with(channel_name, "#game_") {
            channel_type = ChannelType::GAME
        }

        let channel = ChatChannel::init(channel_id, channel_name, channel_type)
        channel.created_time = manager.current_time

        manager.channels.insert(channel_id, channel)
        manager.channels_by_name.insert(channel_name, channel_id)
    }

    // Add user to channel
    let channel = manager.channels.get(channel_id)
    if channel != null {
        if channel.is_password_protected && channel.password != password {
            return false
        }

        channel.add_user(manager.local_user_id)
        channel.last_activity = manager.current_time
    }

    // Track joined channel
    manager.joined_channels[manager.joined_channel_count] = channel_id
    manager.joined_channel_count = manager.joined_channel_count + 1

    // Set as active if first channel
    if manager.joined_channel_count == 1 {
        manager.active_channel_id = channel_id
    }

    // Add system message
    chat_add_system_message(manager, channel_id, MessageType::JOIN, manager.local_nickname + " has joined the channel")

    return true
}

fn chat_leave_channel(manager: GameSpyChatManager, channel_id: i64): bool {
    // Find and remove from joined list
    let found_idx = -1
    for i in 0..manager.joined_channel_count {
        if manager.joined_channels[i] == channel_id {
            found_idx = i
            break
        }
    }

    if found_idx < 0 {
        return false
    }

    // Remove user from channel
    let channel = manager.channels.get(channel_id)
    if channel != null {
        channel.remove_user(manager.local_user_id)
        chat_add_system_message(manager, channel_id, MessageType::PART, manager.local_nickname + " has left the channel")
    }

    // Remove from joined list
    for i in found_idx..(manager.joined_channel_count - 1) {
        manager.joined_channels[i] = manager.joined_channels[i + 1]
    }
    manager.joined_channel_count = manager.joined_channel_count - 1

    // Update active channel
    if manager.active_channel_id == channel_id {
        if manager.joined_channel_count > 0 {
            manager.active_channel_id = manager.joined_channels[0]
        } else {
            manager.active_channel_id = 0
        }
    }

    return true
}

fn chat_set_active_channel(manager: GameSpyChatManager, channel_id: i64) {
    for i in 0..manager.joined_channel_count {
        if manager.joined_channels[i] == channel_id {
            manager.active_channel_id = channel_id
            return
        }
    }
}

fn chat_set_channel_topic(manager: GameSpyChatManager, channel_id: i64, topic: string): bool {
    let channel = manager.channels.get(channel_id)
    if channel == null {
        return false
    }

    // Check if user is operator
    if !channel.is_operator(manager.local_user_id) {
        return false
    }

    channel.topic = topic
    chat_add_system_message(manager, channel_id, MessageType::TOPIC_CHANGE, "Topic changed to: " + topic)

    return true
}

// ============================================================================
// Message Operations
// ============================================================================

fn chat_send_message(manager: GameSpyChatManager, content: string): bool {
    return chat_send_channel_message(manager, manager.active_channel_id, content)
}

fn chat_send_channel_message(manager: GameSpyChatManager, channel_id: i64, content: string): bool {
    if manager.state != ChatConnectionState::CONNECTED {
        return false
    }

    // Rate limiting
    if manager.current_time - manager.last_message_time < manager.config.message_rate_limit {
        return false
    }

    // Check message length
    if content.length > manager.config.max_message_length {
        return false
    }

    // Check if in channel
    let in_channel = false
    for i in 0..manager.joined_channel_count {
        if manager.joined_channels[i] == channel_id {
            in_channel = true
            break
        }
    }

    if !in_channel {
        return false
    }

    // Check if muted
    let channel = manager.channels.get(channel_id)
    if channel != null && channel.is_moderated {
        let user = manager.users.get(manager.local_user_id)
        if user != null && !user.is_voice && !channel.is_operator(manager.local_user_id) {
            return false
        }
    }

    // Apply profanity filter
    let filtered_content = content
    if manager.config.enable_profanity_filter {
        filtered_content = filter_profanity(content)
    }

    // Create message
    let message = ChatMessage::init(manager.next_message_id, manager.local_user_id, manager.local_nickname, filtered_content)
    message.message_type = MessageType::PUBLIC
    message.channel_id = channel_id
    if channel != null {
        message.channel_name = channel.name
    }
    message.timestamp = manager.current_time
    message.is_filtered = filtered_content != content

    manager.next_message_id = manager.next_message_id + 1
    manager.last_message_time = manager.current_time

    // Add to history
    chat_add_message_to_history(manager, message)

    // Update channel activity
    if channel != null {
        channel.last_activity = manager.current_time
    }

    return true
}

fn chat_send_private_message(manager: GameSpyChatManager, target_nickname: string, content: string): bool {
    if manager.state != ChatConnectionState::CONNECTED {
        return false
    }

    let target_id = manager.users_by_nick.get(target_nickname)
    if target_id < 0 {
        return false
    }

    // Check if ignored
    for i in 0..manager.ignored_count {
        if manager.ignored[i] == target_id {
            return false
        }
    }

    let filtered_content = content
    if manager.config.enable_profanity_filter {
        filtered_content = filter_profanity(content)
    }

    let message = ChatMessage::init(manager.next_message_id, manager.local_user_id, manager.local_nickname, filtered_content)
    message.message_type = MessageType::PRIVATE
    message.channel_name = target_nickname
    message.timestamp = manager.current_time

    manager.next_message_id = manager.next_message_id + 1
    manager.last_message_time = manager.current_time

    chat_add_message_to_history(manager, message)

    return true
}

fn chat_add_system_message(manager: GameSpyChatManager, channel_id: i64, msg_type: MessageType, content: string) {
    let message = ChatMessage::init(manager.next_message_id, 0, "System", content)
    message.message_type = msg_type
    message.channel_id = channel_id
    message.timestamp = manager.current_time

    manager.next_message_id = manager.next_message_id + 1
    chat_add_message_to_history(manager, message)
}

fn chat_add_message_to_history(manager: GameSpyChatManager, message: ChatMessage) {
    if manager.message_count >= 1000 {
        // Shift messages
        for i in 0..999 {
            manager.message_history[i] = manager.message_history[i + 1]
        }
        manager.message_count = 999
    }

    manager.message_history[manager.message_count] = message
    manager.message_count = manager.message_count + 1
}

// ============================================================================
// User Operations
// ============================================================================

fn chat_set_status(manager: GameSpyChatManager, status: UserStatus, message: string) {
    let user = manager.users.get(manager.local_user_id)
    if user != null {
        user.status = status
        user.status_message = message
    }
}

fn chat_add_friend(manager: GameSpyChatManager, user_id: i64): bool {
    if manager.friend_count >= 100 {
        return false
    }

    // Check if already friend
    for i in 0..manager.friend_count {
        if manager.friends[i] == user_id {
            return false
        }
    }

    manager.friends[manager.friend_count] = user_id
    manager.friend_count = manager.friend_count + 1

    let user = manager.users.get(user_id)
    if user != null {
        user.is_friend = true
    }

    return true
}

fn chat_remove_friend(manager: GameSpyChatManager, user_id: i64): bool {
    for i in 0..manager.friend_count {
        if manager.friends[i] == user_id {
            for j in i..(manager.friend_count - 1) {
                manager.friends[j] = manager.friends[j + 1]
            }
            manager.friend_count = manager.friend_count - 1

            let user = manager.users.get(user_id)
            if user != null {
                user.is_friend = false
            }

            return true
        }
    }
    return false
}

fn chat_ignore_user(manager: GameSpyChatManager, user_id: i64): bool {
    if manager.ignored_count >= 100 {
        return false
    }

    for i in 0..manager.ignored_count {
        if manager.ignored[i] == user_id {
            return false
        }
    }

    manager.ignored[manager.ignored_count] = user_id
    manager.ignored_count = manager.ignored_count + 1

    let user = manager.users.get(user_id)
    if user != null {
        user.is_ignored = true
    }

    return true
}

fn chat_unignore_user(manager: GameSpyChatManager, user_id: i64): bool {
    for i in 0..manager.ignored_count {
        if manager.ignored[i] == user_id {
            for j in i..(manager.ignored_count - 1) {
                manager.ignored[j] = manager.ignored[j + 1]
            }
            manager.ignored_count = manager.ignored_count - 1

            let user = manager.users.get(user_id)
            if user != null {
                user.is_ignored = false
            }

            return true
        }
    }
    return false
}

// ============================================================================
// Moderation
// ============================================================================

fn chat_kick_user(manager: GameSpyChatManager, channel_id: i64, user_id: i64, reason: string): bool {
    let channel = manager.channels.get(channel_id)
    if channel == null {
        return false
    }

    if !channel.is_operator(manager.local_user_id) {
        return false
    }

    let user = manager.users.get(user_id)
    let user_name = "Unknown"
    if user != null {
        user_name = user.nickname
    }

    channel.remove_user(user_id)
    chat_add_system_message(manager, channel_id, MessageType::KICK, user_name + " was kicked: " + reason)

    return true
}

fn chat_ban_user(manager: GameSpyChatManager, channel_id: i64, user_id: i64): bool {
    let channel = manager.channels.get(channel_id)
    if channel == null {
        return false
    }

    if !channel.is_operator(manager.local_user_id) {
        return false
    }

    let user = manager.users.get(user_id)
    if user != null {
        user.is_banned = true
    }

    channel.remove_user(user_id)

    let user_name = "Unknown"
    if user != null {
        user_name = user.nickname
    }
    chat_add_system_message(manager, channel_id, MessageType::BAN, user_name + " was banned")

    return true
}

fn chat_grant_operator(manager: GameSpyChatManager, channel_id: i64, user_id: i64): bool {
    let channel = manager.channels.get(channel_id)
    if channel == null {
        return false
    }

    if !channel.is_operator(manager.local_user_id) {
        return false
    }

    if channel.operator_count >= 16 {
        return false
    }

    channel.operators[channel.operator_count] = user_id
    channel.operator_count = channel.operator_count + 1

    let user = manager.users.get(user_id)
    if user != null {
        user.is_operator = true
    }

    return true
}

// ============================================================================
// Profanity Filter
// ============================================================================

fn filter_profanity(content: string): string {
    // Simple profanity filter - replace bad words with asterisks
    // In real implementation, would have a proper word list
    // For now just return the content as-is
    return content
}

// ============================================================================
// Update Loop
// ============================================================================

fn update_chat(manager: GameSpyChatManager, delta_time: f32) {
    manager.current_time = manager.current_time + delta_time

    if manager.state == ChatConnectionState::RECONNECTING {
        manager.reconnect_timer = manager.reconnect_timer - delta_time
        if manager.reconnect_timer <= 0.0 {
            // Attempt reconnect
            manager.state = ChatConnectionState::DISCONNECTED
            chat_connect(manager, manager.local_nickname, manager.local_profile_id, manager.auth_token)
        }
    } else if manager.state == ChatConnectionState::CONNECTED {
        // Heartbeat
        manager.heartbeat_timer = manager.heartbeat_timer + delta_time
        if manager.heartbeat_timer >= manager.config.heartbeat_interval {
            manager.heartbeat_timer = 0.0
            // Send heartbeat packet
        }

        // Update user idle times
        for i in 0..manager.users.count {
            let user = manager.users.users[i]
            if user.user_id == manager.local_user_id {
                continue
            }

            // Auto-set idle status
            let idle_time = manager.current_time - user.last_message_time
            if idle_time > 300.0 && user.status == UserStatus::ONLINE {
                user.status = UserStatus::IDLE
            }
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

fn test_gamespy_chat() {
    print("Testing GameSpy Chat...")

    // Create manager
    let config = GameSpyChatConfig::init()
    let manager = GameSpyChatManager::init(config)
    print("  Created chat manager")

    // Connect
    chat_connect(manager, "TestPlayer", 12345, "auth_token_123")
    print("  Connected as TestPlayer")

    // Join channel
    chat_join_channel(manager, "#GPG_Generals", "")
    print("  Joined lobby channel")

    // Send message
    chat_send_message(manager, "Hello, world!")
    print("  Sent message")

    // Check message history
    print("  Message count: " + str(manager.message_count))

    // Parse command
    let cmd = parse_chat_command("/join #test")
    print("  Parsed command: valid=" + str(cmd.is_valid) + " target=" + cmd.target)

    // Set status
    chat_set_status(manager, UserStatus::AWAY, "BRB")
    print("  Set status to Away")

    // Update
    update_chat(manager, 0.016)

    // Disconnect
    chat_disconnect(manager, "Test complete")
    print("  Disconnected")

    print("GameSpy Chat tests complete!")
}
