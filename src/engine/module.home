// Module factory registration for all 192 types
fn register_all_module_types(factory: ModuleFactory) {
    // Body Modules
    factory.register_module("ActiveBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("HighlanderBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("ImmortalBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("InactiveBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("StructureBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("HijackerBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("UndeadableBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("DetachOnDeathBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("FreeLifeBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("ParaBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("GarrisonBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("MonsterBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("TechBuildingBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("HeroBody", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("TunnelBody", ModuleType::Behavior, MODULEINTERFACE_BODY)

    // Update Modules
    factory.register_module("AIUpdate", ModuleType::Behavior, MODULEINTERFACE_UPDATE)
    factory.register_module("AutoHealBehavior", ModuleType::Behavior, MODULEINTERFACE_UPDATE)
    factory.register_module("AutoFindHealBehavior", ModuleType::Behavior, MODULEINTERFACE_UPDATE)
