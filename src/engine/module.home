// ============================================================================
// MODULE INFO - Tracks modules attached to a template
// ============================================================================
struct ModuleInfoNugget {
    name: string,
    module_tag: string,
    data: ?ModuleData,
    interface_mask: i32,
    copied_from_default: bool,
    inheritable: bool,

    fn init(name: string, tag: string, data: ?ModuleData, mask: i32, inheritable: bool): ModuleInfoNugget {
        return ModuleInfoNugget {
            name: name,
            module_tag: tag,
            data: data,
            interface_mask: mask,
            copied_from_default: false,
            inheritable: inheritable,
        }
    }
}

struct ModuleInfo {
    nuggets: [ModuleInfoNugget; 64],  // Max 64 modules per template
    count: i32,

    fn init(): ModuleInfo {
        return ModuleInfo {
            nuggets: [ModuleInfoNugget::init("", "", null, 0, false); 64],
            count: 0,
        }
    }

    fn add(&self, name: string, tag: string, data: ?ModuleData, interface_mask: i32, inheritable: bool) {
        if self.count < 64 {
            self.nuggets[self.count] = ModuleInfoNugget::init(name, tag, data, interface_mask, inheritable)
            self.count = self.count + 1
        }
    }

    fn get_count(&self): i32 {
        return self.count
    }

    fn get_nth_name(&self, index: i32): string {
        if index >= 0 and index < self.count {
            return self.nuggets[index].name
        }
        return ""
    }

    fn get_nth_tag(&self, index: i32): string {
        if index >= 0 and index < self.count {
            return self.nuggets[index].module_tag
        }
        return ""
    }

    fn get_nth_data(&self, index: i32): ?ModuleData {
        if index >= 0 and index < self.count {
            return self.nuggets[index].data
        }
        return null
    }

    fn find_by_tag(&self, tag: string): ?ModuleInfoNugget {
        for i in 0..self.count {
            if self.nuggets[i].module_tag == tag {
                return self.nuggets[i]
            }
        }
        return null
    }

    fn clear(&self) {
        self.count = 0
    }

    fn set_copied_from_default(&self, value: bool) {
        for i in 0..self.count {
            self.nuggets[i].copied_from_default = value
        }
    }

    fn clear_module_with_tag(&self, tag: string): bool {
        for i in 0..self.count {
            if self.nuggets[i].module_tag == tag {
                // Shift remaining entries
                for j in i..(self.count - 1) {
                    self.nuggets[j] = self.nuggets[j + 1]
                }
                self.count = self.count - 1
                return true
            }
        }
        return false
    }
}

// ============================================================================
// MODULE TEMPLATE - Registration info for a module type
// ============================================================================
struct ModuleTemplate {
    name: string,
    module_type: ModuleType,
    interface_mask: i32,

    fn init(name: string, module_type: ModuleType, interface_mask: i32): ModuleTemplate {
        return ModuleTemplate {
            name: name,
            module_type: module_type,
            interface_mask: interface_mask,
        }
    }
}

// ============================================================================
// MODULE FACTORY - Creates module instances
// ============================================================================
struct ModuleFactory {
    templates: [ModuleTemplate; 256],  // Max 256 registered module types
    template_count: i32,

    fn init(): ModuleFactory {
        return ModuleFactory {
            templates: [ModuleTemplate::init("", ModuleType::Behavior, 0); 256],
            template_count: 0,
        }
    }

    fn register_module(&self, name: string, module_type: ModuleType, interface_mask: i32) {
        if self.template_count < 256 {
            self.templates[self.template_count] = ModuleTemplate::init(name, module_type, interface_mask)
            self.template_count = self.template_count + 1
        }
    }

    fn find_template(&self, name: string, module_type: ModuleType): ?ModuleTemplate {
        for i in 0..self.template_count {
            if self.templates[i].name == name and self.templates[i].module_type == module_type {
                return self.templates[i]
            }
        }
        return null
    }

    fn find_interface_mask(&self, name: string, module_type: ModuleType): i32 {
        let tmpl = self.find_template(name, module_type)
        if tmpl {
            return tmpl.interface_mask
        }
        return 0
    }
}

// Global factory instance
let TheModuleFactory = ModuleFactory::init()

// ============================================================================
// TESTS
// ============================================================================
test "Module: basic creation" {
    let data = ModuleData::init()
    data.set_module_tag_name_key(123)

    let mod = Module::init(data)
    assert mod.get_module_tag_name_key() == 123
}

test "BodyModule: health management" {
    let data = BodyModuleData::init()
    data.max_health = 100.0
    data.initial_health = 100.0

    let body = BodyModule::init(1, data)

    assert body.get_health() == 100.0
    assert body.get_max_health() == 100.0
    assert body.get_health_percent() == 1.0
    assert body.get_damage_state() == BodyDamageState::Pristine

    body.apply_damage(40.0)
    assert body.get_health() == 60.0
    assert body.get_damage_state() == BodyDamageState::Damaged

    body.apply_damage(30.0)
    assert body.get_health() == 30.0
    assert body.get_damage_state() == BodyDamageState::ReallyDamaged

    body.apply_healing(20.0)
    assert body.get_health() == 50.0
}

test "ContainModule: passenger management" {
    let data = ContainModuleData::init()
    data.max_passengers = 3

    let contain = ContainModule::init(1, data)

    assert contain.get_max_passengers() == 3
    assert contain.get_passenger_count() == 0
    assert !contain.is_full()

    assert contain.add_passenger(10)
    assert contain.add_passenger(20)
    assert contain.get_passenger_count() == 2

    assert contain.add_passenger(30)
    assert contain.is_full()
    assert !contain.add_passenger(40)  // Should fail - full

    assert contain.remove_passenger(20)
    assert contain.get_passenger_count() == 2
    assert !contain.is_full()
}

