enum DeathType {
    Normal = 0
    Fire = 1
    Toxin = 2
    Crushed = 3
    Exploded = 4
    Splatted = 5
    Lasered = 6
    Suicided = 7
    Toppled = 8
    Detonated = 9
    Drowned = 10
    Extra1 = 11
    Extra2 = 12
    Extra3 = 13
    Extra4 = 14
    Extra5 = 15
    Extra6 = 16
    Extra7 = 17
    Extra8 = 18
    Count = 19
}

struct DieModuleData {
    base: ModuleData,
    death_types: i32,  // Bitmask of DeathType flags
    exempt_status: i32,
    required_status: i32,
    damage_amount_required: f64,

    fn init(): DieModuleData {
        return DieModuleData {
            base: ModuleData::init(),
            death_types: 0xFFFFFFFF,  // All death types by default
            exempt_status: 0,
            required_status: 0,
            damage_amount_required: 0.0,
        }
    }
}

struct DieModule {
    base: ObjectModule,

    fn init(object_id: i32, data: ?DieModuleData): DieModule {
        let mod_data: ?ModuleData = null
        if data {
            mod_data = data.base
        }
        return DieModule {
            base: ObjectModule::init(object_id, mod_data),
        }
    }

    // Called when object dies
    fn on_die(&self, death_type: DeathType, source_id: i32): bool {
        // Return true if handled
        return false
    }

    fn get_interface_mask(): i32 {
        return MODULEINTERFACE_DIE
    }
}

