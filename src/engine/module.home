// ============================================================================
struct SpecialPowerModuleData {
    base: ModuleData,
    special_power_template: string,

    fn init(): SpecialPowerModuleData {
        return SpecialPowerModuleData {
            base: ModuleData::init(),
            special_power_template: "",
        }
    }
}

struct SpecialPowerModule {
    base: ObjectModule,
    ready_frame: i32,

    fn init(object_id: i32, data: ?SpecialPowerModuleData): SpecialPowerModule {
        let mod_data: ?ModuleData = null
        if data {
            mod_data = data.base
        }
        return SpecialPowerModule {
            base: ObjectModule::init(object_id, mod_data),
            ready_frame: 0,
        }
    }

    // Check if power is ready
    fn is_ready(&self, current_frame: i32): bool {
        return current_frame >= self.ready_frame
    }

    // Called to activate power
    fn activate(&self, target_x: f64, target_y: f64, target_z: f64): bool {
        return false
    }

    fn get_interface_mask(): i32 {
        return MODULEINTERFACE_SPECIAL_POWER
    }
}

