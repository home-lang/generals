// ============================================================================
// UPGRADE MODULE INTERFACE
// All 20+ Upgrade module types from original C&C Generals
// ============================================================================

enum UpgradeModuleType {
    // Attribute upgrades
    ARMOR_UPGRADE              // Increase armor (ArmorUpgrade)
    DAMAGE_UPGRADE             // Increase damage (DamageUpgrade)
    RANGE_UPGRADE              // Increase range (RangeUpgrade)
    SPEED_UPGRADE              // Increase speed (SpeedUpgrade)
    RATE_OF_FIRE_UPGRADE       // Increase ROF (RateOfFireUpgrade)

    // Weapon upgrades
    WEAPON_SET_UPGRADE         // Change weapon set (WeaponSetUpgrade)
    WEAPON_BONUS_UPGRADE       // Weapon bonus damage (WeaponBonusUpgrade)
    LASER_UPGRADE              // Add laser designation
    FLASHBANG_UPGRADE          // Add flashbang capability

    // Model upgrades
    MODEL_CONDITION_UPGRADE    // Change model condition (ModelConditionUpgrade)
    GEOMETRY_UPGRADE           // Change geometry/model

    // Ability upgrades
    STEALTH_UPGRADE            // Add stealth capability (StealthUpgrade)
    POWER_PLANT_UPGRADE        // Power plant overdrive
    COMMAND_SET_UPGRADE        // Change command set

    // Economic upgrades
    PRODUCTION_SPEED_UPGRADE   // Faster production
    CASH_BONUS_UPGRADE         // Cash bounty bonus

    // Building upgrades
    RADAR_UPGRADE              // Enable radar
    FORTIFICATION_UPGRADE      // Add fortification
    COUNTERMEASURE_UPGRADE     // Add countermeasures

    // Status upgrades
    STATUS_BITS_UPGRADE        // Change status bits
    EXPERIENCE_UPGRADE         // Experience multiplier
    VETERANCY_UPGRADE          // Grant veterancy level
}

struct UpgradeModuleData {
    base: ModuleData,
    module_type: UpgradeModuleType,
    triggered_by: [string; 8],
    triggered_by_count: i32,
    conflicts_with: [string; 8],
    conflicts_with_count: i32,
    grant_on_create: bool,
    requires_all_triggers: bool,

    fn init(): UpgradeModuleData {
        return UpgradeModuleData {
            base: ModuleData::init(),
            module_type: UpgradeModuleType.ARMOR_UPGRADE,
            triggered_by: [""; 8],
            triggered_by_count: 0,
            conflicts_with: [""; 8],
            conflicts_with_count: 0,
            grant_on_create: false,
            requires_all_triggers: false,
        }
    }
}

struct UpgradeModule {
    base: ObjectModule,
    data: UpgradeModuleData,
    is_active: bool,

    fn init(object_id: i32, data: ?UpgradeModuleData): UpgradeModule {
        let mod_data: ?ModuleData = null
        let up_data = if data { data.? } else { UpgradeModuleData::init() }
        if data {
            mod_data = data.base
        }
        return UpgradeModule {
            base: ObjectModule::init(object_id, mod_data),
            data: up_data,
            is_active: false,
        }
    }

    // Called when upgrade is acquired
    fn on_upgrade(&self, upgrade_name: string): bool {
        // Check if this upgrade triggers our module
        for i in 0..self.data.triggered_by_count {
            if self.data.triggered_by[i] == upgrade_name {
                return self.apply_upgrade()
            }
        }
        return false
    }

    fn apply_upgrade(&self): bool {
        match self.data.module_type {
            UpgradeModuleType.ARMOR_UPGRADE => {
                return self.apply_armor_upgrade()
            }
            UpgradeModuleType.DAMAGE_UPGRADE => {
                return self.apply_damage_upgrade()
            }
            UpgradeModuleType.RANGE_UPGRADE => {
                return self.apply_range_upgrade()
            }
            UpgradeModuleType.SPEED_UPGRADE => {
                return self.apply_speed_upgrade()
            }
            UpgradeModuleType.WEAPON_SET_UPGRADE => {
                return self.apply_weapon_set_upgrade()
            }
            UpgradeModuleType.MODEL_CONDITION_UPGRADE => {
                return self.apply_model_condition_upgrade()
            }
            UpgradeModuleType.STEALTH_UPGRADE => {
                return self.apply_stealth_upgrade()
            }
            _ => {
                return false
            }
        }
    }

    fn apply_armor_upgrade(&self): bool {
        // Increase armor value
        self.is_active = true
        return true
    }

    fn apply_damage_upgrade(&self): bool {
        // Increase damage multiplier
        self.is_active = true
        return true
    }

    fn apply_range_upgrade(&self): bool {
        // Increase attack range
        self.is_active = true
        return true
    }

    fn apply_speed_upgrade(&self): bool {
        // Increase movement speed
        self.is_active = true
        return true
    }

    fn apply_weapon_set_upgrade(&self): bool {
        // Switch to upgraded weapon set
        self.is_active = true
        return true
    }

    fn apply_model_condition_upgrade(&self): bool {
        // Set model condition flags
        self.is_active = true
        return true
    }

    fn apply_stealth_upgrade(&self): bool {
        // Enable stealth capability
        self.is_active = true
        return true
    }

    fn activate(&self) {
        self.is_active = true
    }

    fn deactivate(&self) {
        self.is_active = false
    }

    fn get_interface_mask(): i32 {
        return MODULEINTERFACE_UPGRADE
    }
}

// Specific upgrade module implementations
