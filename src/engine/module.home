// C&C Generals Zero Hour - Home Port
// Module System
//
// Modules are the building blocks of behavior for Objects and Drawables.
// They handle specific aspects like updates, damage, death, creation, etc.
//
// Key concepts:
// - Module: The instance attached to a Thing (Object or Drawable)
// - ModuleData: Static configuration data parsed from INI files
// - ModuleFactory: Creates modules from registered templates
//
// Module types:
// - Behavior modules (attached to Objects): Update, Die, Damage, Create, Collide, Body, Contain, Upgrade, SpecialPower, Destroy
// - Drawable modules: Draw, ClientUpdate
//
// Based on original Module.h, ModuleFactory.h

// ============================================================================
// MODULE TYPE
// ============================================================================
enum ModuleType {
    Behavior = 0      // Object modules
    Draw = 1          // Drawable draw modules
    ClientUpdate = 2  // Drawable update modules
}

const NUM_MODULE_TYPES: i32 = 3
const FIRST_DRAWABLE_MODULE_TYPE: ModuleType = ModuleType::Draw
const LAST_DRAWABLE_MODULE_TYPE: ModuleType = ModuleType::ClientUpdate
const NUM_DRAWABLE_MODULE_TYPES: i32 = 2

// ============================================================================
// MODULE INTERFACE TYPE (bitmask)
// ============================================================================
const MODULEINTERFACE_UPDATE: i32 = 0x00000001
const MODULEINTERFACE_DIE: i32 = 0x00000002
const MODULEINTERFACE_DAMAGE: i32 = 0x00000004
const MODULEINTERFACE_CREATE: i32 = 0x00000008
const MODULEINTERFACE_COLLIDE: i32 = 0x00000010
const MODULEINTERFACE_BODY: i32 = 0x00000020
const MODULEINTERFACE_CONTAIN: i32 = 0x00000040
const MODULEINTERFACE_UPGRADE: i32 = 0x00000080
const MODULEINTERFACE_SPECIAL_POWER: i32 = 0x00000100
const MODULEINTERFACE_DESTROY: i32 = 0x00000200
const MODULEINTERFACE_DRAW: i32 = 0x00000400
const MODULEINTERFACE_CLIENT_UPDATE: i32 = 0x00000800

// ============================================================================
// MODULE DATA - Static configuration parsed from INI
// ============================================================================
struct ModuleData {
    module_tag_name_key: i32,  // Unique tag among all modules for an object instance

    fn init(): ModuleData {
        return ModuleData {
            module_tag_name_key: 0,
        }
    }

    fn set_module_tag_name_key(&self, key: i32) {
        self.module_tag_name_key = key
    }

    fn get_module_tag_name_key(&self): i32 {
        return self.module_tag_name_key
    }

    // Virtual method - override in subclasses
    fn is_ai_module_data(&self): bool {
        return false
    }

    // For save/load (Snapshot interface)
    fn crc(&self) {
        // Override in subclasses
    }

    fn xfer(&self) {
        // Override in subclasses
    }

    fn load_post_process(&self) {
        // Override in subclasses
    }
}

// ============================================================================
// MODULE - Base class for all modules
// ============================================================================
struct Module {
    module_data: ?ModuleData,

    fn init(data: ?ModuleData): Module {
        return Module {
            module_data: data,
        }
    }

    fn get_module_data(&self): ?ModuleData {
        return self.module_data
    }

    fn get_module_tag_name_key(&self): i32 {
        if self.module_data {
            return self.module_data.get_module_tag_name_key()
        }
        return 0
    }

    // Virtual method - should be overridden to return module name key
    fn get_module_name_key(&self): i32 {
        return 0
    }

    // Called after all modules for a Thing are created
    // Allows modules to resolve inter-module dependencies
    fn on_object_created(&self) {
        // Override in subclasses
    }

    // Called whenever a drawable is bound to the object
    fn on_drawable_bound_to_object(&self) {
        // Override in subclasses
    }

    // Preload assets for time of day
    fn preload_assets(&self, time_of_day: i32) {
        // Override in subclasses
    }

    // Called before deletion
    fn on_delete(&self) {
        // Override in subclasses
    }

    // For save/load (Snapshot interface)
    fn crc(&self) {
        // Override in subclasses
    }

    fn xfer(&self) {
        // Override in subclasses
    }

    fn load_post_process(&self) {
        // Override in subclasses
    }
}

// ============================================================================
// OBJECT MODULE - Module specifically for Objects (game logic)
// ============================================================================
struct ObjectModule {
    base: Module,
    object_id: i32,  // ID of the owning Object

    fn init(object_id: i32, data: ?ModuleData): ObjectModule {
        return ObjectModule {
            base: Module::init(data),
            object_id: object_id,
        }
    }

    fn get_object_id(&self): i32 {
        return self.object_id
    }

    // Called when object is captured by another player
    fn on_capture(&self, old_owner_id: i32, new_owner_id: i32) {
        // Override in subclasses
    }
}

// ============================================================================
// DRAWABLE MODULE - Module specifically for Drawables (rendering)
// ============================================================================
struct DrawableModule {
    base: Module,
    drawable_id: i32,  // ID of the owning Drawable

    fn init(drawable_id: i32, data: ?ModuleData): DrawableModule {
        return DrawableModule {
            base: Module::init(data),
            drawable_id: drawable_id,
        }
    }

    fn get_drawable_id(&self): i32 {
        return self.drawable_id
    }
}

// ============================================================================
// UPDATE MODULE INTERFACE
// ============================================================================
struct UpdateModuleData {
    base: ModuleData,

    fn init(): UpdateModuleData {
        return UpdateModuleData {
            base: ModuleData::init(),
        }
    }
}

struct UpdateModule {
    base: ObjectModule,

    fn init(object_id: i32, data: ?UpdateModuleData): UpdateModule {
        let mod_data: ?ModuleData = null
        if data {
            mod_data = data.base
        }
        return UpdateModule {
            base: ObjectModule::init(object_id, mod_data),
        }
    }

    // Called every frame
    fn update(&self): i32 {
        // Return 0 to continue, positive for sleep frames, negative for done
        return 0
    }

    fn get_interface_mask(): i32 {
        return MODULEINTERFACE_UPDATE
    }
}

