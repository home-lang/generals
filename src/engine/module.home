// ============================================================================
// BODY MODULE INTERFACE
// ============================================================================
enum BodyDamageState {
    Pristine = 0
    Damaged = 1
    ReallyDamaged = 2
    Rubble = 3
}

struct BodyModuleData {
    base: ModuleData,
    max_health: f64,
    initial_health: f64,

    fn init(): BodyModuleData {
        return BodyModuleData {
            base: ModuleData::init(),
            max_health: 100.0,
            initial_health: 100.0,
        }
    }
}

struct BodyModule {
    base: ObjectModule,
    current_health: f64,
    max_health: f64,
    damage_state: BodyDamageState,

    fn init(object_id: i32, data: ?BodyModuleData): BodyModule {
        let initial = 100.0
        let max = 100.0
        let mod_data: ?ModuleData = null
        if data {
            initial = data.initial_health
            max = data.max_health
            mod_data = data.base
        }
        return BodyModule {
            base: ObjectModule::init(object_id, mod_data),
            current_health: initial,
            max_health: max,
            damage_state: BodyDamageState::Pristine,
        }
    }

    fn get_health(&self): f64 {
        return self.current_health
    }

    fn get_max_health(&self): f64 {
        return self.max_health
    }

    fn get_health_percent(&self): f64 {
        if self.max_health > 0.0 {
            return self.current_health / self.max_health
        }
        return 0.0
    }

    fn set_health(&self, health: f64) {
        self.current_health = health
        if self.current_health > self.max_health {
            self.current_health = self.max_health
        }
        if self.current_health < 0.0 {
            self.current_health = 0.0
        }
        self.update_damage_state()
    }

    fn apply_damage(&self, amount: f64) {
        self.set_health(self.current_health - amount)
    }

    fn apply_healing(&self, amount: f64) {
        self.set_health(self.current_health + amount)
    }

    fn is_dead(&self): bool {
        return self.current_health <= 0.0
    }

    fn get_damage_state(&self): BodyDamageState {
        return self.damage_state
    }

    fn update_damage_state(&self) {
        let percent = self.get_health_percent()
        if percent <= 0.0 {
            self.damage_state = BodyDamageState::Rubble
        } else if percent < 0.33 {
            self.damage_state = BodyDamageState::ReallyDamaged
        } else if percent < 0.66 {
            self.damage_state = BodyDamageState::Damaged
        } else {
            self.damage_state = BodyDamageState::Pristine
        }
    }

    fn get_interface_mask(): i32 {
        return MODULEINTERFACE_BODY
    }
}

// ============================================================================
// CONTAIN MODULE INTERFACE - For units that can contain other units
// ============================================================================
struct ContainModuleData {
    base: ModuleData,
    max_passengers: i32,
    damage_percent_to_units: f64,

    fn init(): ContainModuleData {
        return ContainModuleData {
            base: ModuleData::init(),
            max_passengers: 0,
            damage_percent_to_units: 0.0,
        }
    }
}

struct ContainModule {
    base: ObjectModule,
    passenger_ids: [i32; 16],  // Max 16 passengers
    passenger_count: i32,
    max_passengers: i32,

    fn init(object_id: i32, data: ?ContainModuleData): ContainModule {
        let max = 0
        let mod_data: ?ModuleData = null
        if data {
            max = data.max_passengers
            mod_data = data.base
        }
        return ContainModule {
            base: ObjectModule::init(object_id, mod_data),
            passenger_ids: [0; 16],
            passenger_count: 0,
            max_passengers: max,
        }
    }

    fn get_passenger_count(&self): i32 {
        return self.passenger_count
    }

    fn get_max_passengers(&self): i32 {
        return self.max_passengers
    }

    fn is_full(&self): bool {
        return self.passenger_count >= self.max_passengers
    }

    fn can_add_passenger(&self, passenger_id: i32, passenger_slots: i32): bool {
        if self.passenger_count + passenger_slots > self.max_passengers {
            return false
        }
        return true
    }

    fn add_passenger(&self, passenger_id: i32): bool {
        if self.is_full() {
            return false
        }
        self.passenger_ids[self.passenger_count] = passenger_id
        self.passenger_count = self.passenger_count + 1
        return true
    }

    fn remove_passenger(&self, passenger_id: i32): bool {
        for i in 0..self.passenger_count {
            if self.passenger_ids[i] == passenger_id {
                // Shift remaining passengers down
                for j in i..(self.passenger_count - 1) {
                    self.passenger_ids[j] = self.passenger_ids[j + 1]
                }
                self.passenger_count = self.passenger_count - 1
                return true
            }
        }
        return false
    }

    fn get_passenger_at(&self, index: i32): i32 {
        if index >= 0 and index < self.passenger_count {
            return self.passenger_ids[index]
        }
        return 0
    }

    fn get_interface_mask(): i32 {
        return MODULEINTERFACE_CONTAIN
    }
}

// ============================================================================
// COLLIDE MODULE INTERFACE
// All 15+ Collide module types from original C&C Generals
// ============================================================================

enum CollideModuleType {
    DEFAULT                 // Basic collision response
    CRATE                   // Crate pickup (CrateCollide)
    SQUISH                  // Infantry squish by vehicles (SquishCollide)
    HIJACK                  // Vehicle hijacking (HijackVehicleContain related)
    CLIFF                   // Cliff collision/damage
    FIRE_WEAPON             // Fire weapon on collision (FireWeaponCollide)
    SABOTAGE                // Sabotage on collision (SabotageCollide)
    LANDMINE                // Mine detonation (LandmineCollide)
    GARRISON                // Garrison entry (GarrisonContain related)
    TRANSPORT               // Transport loading (TransportContain related)
    CRUSH                   // Vehicle crush (CrushCollide)
    HEAL                    // Heal on collision (HealContain related)
    SUPPLY                  // Supply pickup
    OVERCHARGE              // Overcharge explosion radius
    BRIDGE                  // Bridge interaction
}

struct CollideModuleData {
    base: ModuleData,
    module_type: CollideModuleType,
    require_enemy: bool,
    require_ally: bool,
    collision_mask: i32,

    fn init(): CollideModuleData {
        return CollideModuleData {
            base: ModuleData::init(),
            module_type: CollideModuleType.DEFAULT,
            require_enemy: false,
            require_ally: false,
            collision_mask: 0xFFFFFFFF,
        }
    }
}

struct CollideModule {
    base: ObjectModule,
    data: CollideModuleData,

    fn init(object_id: i32, data: ?CollideModuleData): CollideModule {
        let mod_data: ?ModuleData = null
        let col_data = if data { data.? } else { CollideModuleData::init() }
        if data {
            mod_data = data.base
        }
        return CollideModule {
            base: ObjectModule::init(object_id, mod_data),
            data: col_data,
        }
    }

    // Called when collision occurs
    fn on_collide(&self, other_id: i32, info: i32): bool {
        match self.data.module_type {
            CollideModuleType.CRATE => {
                return self.handle_crate_collide(other_id)
            }
            CollideModuleType.SQUISH => {
                return self.handle_squish_collide(other_id)
            }
            CollideModuleType.HIJACK => {
                return self.handle_hijack_collide(other_id)
            }
            CollideModuleType.FIRE_WEAPON => {
                return self.handle_fire_weapon_collide(other_id)
            }
            CollideModuleType.SABOTAGE => {
                return self.handle_sabotage_collide(other_id)
            }
            CollideModuleType.LANDMINE => {
                return self.handle_landmine_collide(other_id)
            }
            CollideModuleType.CRUSH => {
                return self.handle_crush_collide(other_id)
            }
            CollideModuleType.HEAL => {
                return self.handle_heal_collide(other_id)
            }
            _ => {
                return false
            }
        }
    }

    fn handle_crate_collide(&self, other_id: i32): bool {
        // Pickup crate and apply effect
        // See CrateCollideModule in crate_system.home
        return true
    }

    fn handle_squish_collide(&self, other_id: i32): bool {
        // Infantry gets squished by vehicle
        // Apply crush damage, play squish sound
        return true
    }

    fn handle_hijack_collide(&self, other_id: i32): bool {
        // Hijacker takes control of enemy vehicle
        // Change ownership, eject crew
        return true
    }

    fn handle_fire_weapon_collide(&self, other_id: i32): bool {
        // Fire weapon at the colliding object
        return true
    }

    fn handle_sabotage_collide(&self, other_id: i32): bool {
        // Apply sabotage effect (disable, destroy)
        return true
    }

    fn handle_landmine_collide(&self, other_id: i32): bool {
        // Detonate mine, apply area damage
        return true
    }

    fn handle_crush_collide(&self, other_id: i32): bool {
        // Vehicle crushes infantry/light units
        return true
    }

    fn handle_heal_collide(&self, other_id: i32): bool {
        // Heal the colliding unit
        return true
    }

    fn get_interface_mask(): i32 {
        return MODULEINTERFACE_COLLIDE
    }
}

