// Get total module type count
fn get_total_module_type_count(): i32 {
    // BehaviorModuleType::COUNT + DrawModuleType::COUNT
    // 192 total module types from C&C Generals
    return 192
}

test "ModuleInfo: module tracking" {
    let info = ModuleInfo::init()

    let data1 = ModuleData::init()
    let data2 = ModuleData::init()

    info.add("BodyModule", "ModuleTag_Body", data1, MODULEINTERFACE_BODY, false)
    info.add("UpdateModule", "ModuleTag_Update", data2, MODULEINTERFACE_UPDATE, true)

    assert info.get_count() == 2
    assert info.get_nth_name(0) == "BodyModule"
    assert info.get_nth_tag(1) == "ModuleTag_Update"

    let found = info.find_by_tag("ModuleTag_Body")
    assert found != null
    assert found.interface_mask == MODULEINTERFACE_BODY
}

test "ModuleFactory: registration" {
    let factory = ModuleFactory::init()

    factory.register_module("ActiveBodyModule", ModuleType::Behavior, MODULEINTERFACE_BODY)
    factory.register_module("W3DModelDraw", ModuleType::Draw, MODULEINTERFACE_DRAW)

    let tmpl1 = factory.find_template("ActiveBodyModule", ModuleType::Behavior)
    assert tmpl1 != null
    assert tmpl1.interface_mask == MODULEINTERFACE_BODY

    let tmpl2 = factory.find_template("W3DModelDraw", ModuleType::Draw)
    assert tmpl2 != null
    assert tmpl2.interface_mask == MODULEINTERFACE_DRAW

    // Wrong type should not find
    let tmpl3 = factory.find_template("ActiveBodyModule", ModuleType::Draw)
    assert tmpl3 == null
}
