// Save/Load System - Game state persistence
// Implements authentic C&C Generals Zero Hour save game functionality

// ============================================================================
// SAVE FILE FORMAT
// ============================================================================

let SAVE_SIGNATURE: [i32] = [0x47, 0x53, 0x41, 0x56]  // "GSAV"
let SAVE_VERSION: i32 = 7  // Zero Hour save version

enum SaveType {
    QUICK_SAVE,
    MANUAL_SAVE,
    AUTO_SAVE,
    CAMPAIGN_SAVE,
    SKIRMISH_SAVE,
    MULTIPLAYER_SAVE,
}

struct SaveHeader {
    signature: [i32],
    version: i32,
    timestamp: i64,
    save_type: SaveType,

    // Save metadata
    save_name: string,
    map_name: string,
    mission_name: string,  // For campaign saves

    // Screenshot thumbnail (compressed)
    thumbnail_width: i32,
    thumbnail_height: i32,
    thumbnail_data: [i32],

    // Game time
    game_time_frames: i32,
    real_time_seconds: i32,

    // Difficulty
    difficulty: i32,

    // Checksum for integrity
    data_checksum: i32,
    data_size: i32,
}

impl SaveHeader {
    fn init(): SaveHeader {
        return SaveHeader {
            signature: SAVE_SIGNATURE,
            version: SAVE_VERSION,
            timestamp: 0,
            save_type: SaveType::MANUAL_SAVE,
            save_name: "",
            map_name: "",
            mission_name: "",
            thumbnail_width: 0,
            thumbnail_height: 0,
            thumbnail_data: [],
            game_time_frames: 0,
            real_time_seconds: 0,
            difficulty: 0,
            data_checksum: 0,
            data_size: 0,
        }
    }
}

struct PlayerSaveData {
    player_id: i32,
    name: string,
    faction: i32,
    color: i32,
    general: i32,
    team: i32,
    is_ai: bool,
    ai_difficulty: i32,

    // Resources
    money: i32,
    power_produced: i32,
    power_consumed: i32,

    // Stats
    units_built: i32,
    units_lost: i32,
    units_killed: i32,
    buildings_built: i32,
    buildings_lost: i32,
    buildings_destroyed: i32,

    // General powers
    general_points: i32,
    unlocked_powers: [bool],
    power_cooldowns: [f32],

    // Superweapons
    superweapon_progress: [f32],

    // Tech/Upgrades
    completed_upgrades: [bool],
    research_progress: [f32],

    // Rank/Experience
    rank: i32,
    experience: i32,
}

impl PlayerSaveData {
    fn init(): PlayerSaveData {
        return PlayerSaveData {
            player_id: 0,
            name: "",
            faction: 0,
            color: 0,
            general: 0,
            team: 0,
            is_ai: false,
            ai_difficulty: 0,
            money: 0,
            power_produced: 0,
            power_consumed: 0,
            units_built: 0,
            units_lost: 0,
            units_killed: 0,
            buildings_built: 0,
            buildings_lost: 0,
            buildings_destroyed: 0,
            general_points: 0,
            unlocked_powers: [],
            power_cooldowns: [],
            superweapon_progress: [],
            completed_upgrades: [],
            research_progress: [],
            rank: 0,
            experience: 0,
        }
    }
}

struct UnitSaveData {
    object_id: i32,
    owner_id: i32,
    unit_type: i32,

    // Position/Rotation
    position_x: f32,
    position_y: f32,
    position_z: f32,
    rotation: f32,

    // State
    health: f32,
    max_health: f32,
    experience: i32,
    veterancy: i32,

    // Behavior
    current_order: i32,
    target_x: f32,
    target_y: f32,
    target_object_id: i32,
    stance: i32,

    // Modifiers
    buffs: [i32],
    debuffs: [i32],

    // Passengers (for transports)
    passenger_count: i32,
    passenger_ids: [i32],

    // Ammunition
    ammo_count: i32,

    // Control group
    control_group: i32,
}

impl UnitSaveData {
    fn init(): UnitSaveData {
        return UnitSaveData {
            object_id: 0,
            owner_id: 0,
            unit_type: 0,
            position_x: 0.0,
            position_y: 0.0,
            position_z: 0.0,
            rotation: 0.0,
            health: 100.0,
            max_health: 100.0,
            experience: 0,
            veterancy: 0,
            current_order: 0,
            target_x: 0.0,
            target_y: 0.0,
            target_object_id: 0,
            stance: 0,
            buffs: [],
            debuffs: [],
            passenger_count: 0,
            passenger_ids: [],
            ammo_count: 0,
            control_group: -1,
        }
    }
}

