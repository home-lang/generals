// ============================================================================
// COMPRESSION
// ============================================================================

fn compress_save_data(input: [i32], size: i32): [i32] {
    // Would use zlib compression (authentic to original)
    // For now, just copy
    let output: [i32] = []
    for i in 0..size {
        output = output + [input[i]]
    }
    return output
}

fn decompress_save_data(input: [i32], size: i32): [i32] {
    // Would decompress zlib data
    let output: [i32] = []
    for i in 0..size {
        if i < input.length {
            output = output + [input[i]]
        }
    }
    return output
}

// ============================================================================
// FILE I/O HELPERS
// ============================================================================

fn write_save_file(filename: string, header: SaveHeader, data: [i32], size: i32): bool {
    // Would write to disk
    return true
}

fn read_save_file(filename: string): [i32] {
    // Would read from disk
    return []
}

fn parse_save_header(data: [i32]): SaveHeader {
    let header = SaveHeader::init()

    if data.length >= 4 {
        header.signature = [data[0], data[1], data[2], data[3]]
    }
    if data.length >= 8 {
        header.version = read_i32_le(data, 4)
    }
    if data.length >= 16 {
        header.timestamp = read_i64_le(data, 8)
    }

    return header
}

fn calculate_save_checksum(data: GameSaveData): i32 {
    // Would calculate CRC32 or similar
    return 0
}

// ============================================================================
// BINARY HELPERS
// ============================================================================

fn write_i32_bytes(value: i32): [i32] {
    return [
        value & 0xFF,
        (value >> 8) & 0xFF,
        (value >> 16) & 0xFF,
        (value >> 24) & 0xFF,
    ]
}

fn write_i64_bytes(value: i64): [i32] {
    let low = cast(i32, value & 0xFFFFFFFF)
    let high = cast(i32, (value >> 32) & 0xFFFFFFFF)
    return write_i32_bytes(low) + write_i32_bytes(high)
}

fn write_f32_bytes(value: f32): [i32] {
    // Would reinterpret float bits as i32
    return [0, 0, 0, 0]
}

fn read_i32_le(data: [i32], offset: i32): i32 {
    if offset + 3 >= data.length {
        return 0
    }
    return data[offset] |
           (data[offset + 1] << 8) |
           (data[offset + 2] << 16) |
           (data[offset + 3] << 24)
}

fn read_i64_le(data: [i32], offset: i32): i64 {
    let low = cast(i64, read_i32_le(data, offset))
    let high = cast(i64, read_i32_le(data, offset + 4))
    return low | (high << 32)
}

