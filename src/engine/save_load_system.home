struct TerrainModification {
    position_x: f32,
    position_y: f32,
    radius: f32,
    modification_type: i32,  // Crater, scorch, etc.
    intensity: f32,
}

impl TerrainModification {
    fn init(): TerrainModification {
        return TerrainModification {
            position_x: 0.0,
            position_y: 0.0,
            radius: 0.0,
            modification_type: 0,
            intensity: 0.0,
        }
    }
}

struct GameSaveData {
    header: SaveHeader,

    // Players
    player_count: i32,
    players: [PlayerSaveData],

    // Units (variable count)
    unit_count: i32,
    units: [UnitSaveData],

    // Buildings (variable count)
    building_count: i32,
    buildings: [BuildingSaveData],

    // Projectiles (variable count)
    projectile_count: i32,
    projectiles: [ProjectileSaveData],

    // Terrain modifications
    terrain_mod_count: i32,
    terrain_mods: [TerrainModification],

    // Random seed state for determinism
    random_state: i64,

    // Camera position
    camera_x: f32,
    camera_y: f32,
    camera_z: f32,
    camera_pitch: f32,
    camera_yaw: f32,
    camera_zoom: f32,

    // Fog of war state (per player, each is map data)
    fog_data: [[i32]],

    // Script triggers state (for campaign)
    triggered_events: [bool],
    script_variables: [i32],
}

impl GameSaveData {
    fn init(): GameSaveData {
        return GameSaveData {
            header: SaveHeader::init(),
            player_count: 0,
            players: [],
            unit_count: 0,
            units: [],
            building_count: 0,
            buildings: [],
            projectile_count: 0,
            projectiles: [],
            terrain_mod_count: 0,
            terrain_mods: [],
            random_state: 0,
            camera_x: 0.0,
            camera_y: 0.0,
            camera_z: 0.0,
            camera_pitch: 0.0,
            camera_yaw: 0.0,
            camera_zoom: 0.0,
            fog_data: [],
            triggered_events: [],
            script_variables: [],
        }
    }
}

// ============================================================================
// SAVE SYSTEM MANAGER
// ============================================================================

struct SaveManager {
    current_save_slot: i32,
    quick_save_slot: i32,
    auto_save_enabled: bool,
    auto_save_interval: f32,
    auto_save_timer: f32,
    max_auto_saves: i32,

    // Save slots
    save_slots: [SaveHeader],
    save_slot_count: i32,

    // Save directory
    save_directory: string,

    // Operation state
    is_saving: bool,
    is_loading: bool,
    save_progress: f32,
    load_progress: f32,
    last_error: string,
}

impl SaveManager {
    fn init(): SaveManager {
        return SaveManager {
            current_save_slot: -1,
            quick_save_slot: 0,
            auto_save_enabled: true,
            auto_save_interval: 300.0,  // 5 minutes
            auto_save_timer: 0.0,
            max_auto_saves: 3,
            save_slots: [],
            save_slot_count: 0,
            save_directory: "Saves/",
            is_saving: false,
            is_loading: false,
            save_progress: 0.0,
            load_progress: 0.0,
            last_error: "",
        }
    }

    fn initialize(&self) {
        // Create save directory if needed
        // Scan for existing saves
        self.scan_save_files()
    }

    fn scan_save_files(&self) {
        // Would scan save directory for .sav files
        // Parse headers to populate save_slots
        self.save_slot_count = 0
        self.save_slots = []
    }

    fn quick_save(&self, game_state: GameSaveData): bool {
        let save_data = game_state
        save_data.header.save_type = SaveType::QUICK_SAVE
        save_data.header.save_name = "QuickSave"

        let filename = self.get_quicksave_filename(self.quick_save_slot)
        let success = self.save_game(save_data, filename)

        if success {
            self.quick_save_slot = (self.quick_save_slot + 1) % 3
        }

        return success
    }

    fn quick_load(&self): GameSaveData {
        let slot = (self.quick_save_slot + 2) % 3  // Most recent quick save
        let filename = self.get_quicksave_filename(slot)
        return self.load_game(filename)
    }

    fn auto_save(&self, game_state: GameSaveData): bool {
        if !self.auto_save_enabled {
            return false
        }

        let save_data = game_state
        save_data.header.save_type = SaveType::AUTO_SAVE
        save_data.header.save_name = "AutoSave"

        // Rotate auto saves
        let auto_slot = cast(i32, save_data.header.timestamp % cast(i64, self.max_auto_saves))
        let filename = self.get_autosave_filename(auto_slot)

        return self.save_game(save_data, filename)
    }

    fn manual_save(&self, game_state: GameSaveData, save_name: string): bool {
        let save_data = game_state
        save_data.header.save_type = SaveType::MANUAL_SAVE
        save_data.header.save_name = save_name

        let filename = self.generate_save_filename(save_name)
        return self.save_game(save_data, filename)
    }

    fn update_auto_save(&self, game_state: GameSaveData, delta_time: f32) {
        if !self.auto_save_enabled {
            return
        }

        self.auto_save_timer = self.auto_save_timer + delta_time

        if self.auto_save_timer >= self.auto_save_interval {
            self.auto_save_timer = 0.0
            self.auto_save(game_state)
        }
    }

    fn save_game(&self, data: GameSaveData, filename: string): bool {
        self.is_saving = true
        self.save_progress = 0.0

        // Calculate checksum
        let checksum = calculate_save_checksum(data)

        // Serialize game state
        let serialized = serialize_game_data(data)
        let size = serialized.length

        self.save_progress = 0.5

        // Compress data
        let compressed = compress_save_data(serialized, size)

        self.save_progress = 0.8

        // Write header + compressed data to file
        let success = write_save_file(filename, data.header, compressed, compressed.length)

        self.save_progress = 1.0
        self.is_saving = false

        if success {
            // Refresh save list
            self.scan_save_files()
        } else {
            self.last_error = "Failed to write save file"
        }

        return success
    }

    fn load_game(&self, filename: string): GameSaveData {
        self.is_loading = true
        self.load_progress = 0.0

        let data = GameSaveData::init()

        // Read file
        let file_data = read_save_file(filename)

        if file_data.length == 0 {
            self.last_error = "Failed to read save file"
            self.is_loading = false
            return data
        }

        self.load_progress = 0.3

        // Parse header
        data.header = parse_save_header(file_data)

        // Verify signature
        if data.header.signature.length < 4 or
           data.header.signature[0] != SAVE_SIGNATURE[0] or
           data.header.signature[1] != SAVE_SIGNATURE[1] or
           data.header.signature[2] != SAVE_SIGNATURE[2] or
           data.header.signature[3] != SAVE_SIGNATURE[3] {
            self.last_error = "Invalid save file signature"
            self.is_loading = false
            return data
        }

        // Check version compatibility
        if data.header.version > SAVE_VERSION {
            self.last_error = "Save file version too new"
            self.is_loading = false
            return data
        }

        self.load_progress = 0.5

        // Decompress data
        let decompressed = decompress_save_data(file_data, data.header.data_size)

        self.load_progress = 0.7

        // Deserialize game state
        deserialize_game_data(decompressed, data)

        self.load_progress = 0.9

        // Verify checksum
        let calculated_checksum = calculate_save_checksum(data)
        if calculated_checksum != data.header.data_checksum {
            self.last_error = "Save file corrupted"
            // Continue anyway for now
        }

        self.load_progress = 1.0
        self.is_loading = false

        return data
    }

    fn delete_save(&self, filename: string): bool {
        // Would delete file from disk
        // Refresh save list
        self.scan_save_files()
        return true
    }

    fn get_quicksave_filename(&self, slot: i32): string {
        return "QuickSave" + str(slot) + ".sav"
    }

    fn get_autosave_filename(&self, slot: i32): string {
        return "AutoSave" + str(slot) + ".sav"
    }

    fn generate_save_filename(&self, name: string): string {
        // Sanitize name and add extension
        return name + ".sav"
    }
}

// ============================================================================
// SERIALIZATION
// ============================================================================

fn serialize_game_data(data: GameSaveData): [i32] {
    let output: [i32] = []

    // Serialize header
    output = output + serialize_header(data.header)

    // Serialize players
    output = output + [data.player_count]

    for i in 0..data.player_count {
        output = output + serialize_player(data.players[i])
    }

    // Serialize units
    output = output + write_i32_bytes(data.unit_count)

    for i in 0..data.unit_count {
        output = output + serialize_unit(data.units[i])
    }

    // Serialize buildings
    output = output + write_i32_bytes(data.building_count)

    for i in 0..data.building_count {
        output = output + serialize_building(data.buildings[i])
    }

    // Serialize projectiles
    output = output + write_i32_bytes(data.projectile_count)

    for i in 0..data.projectile_count {
        output = output + serialize_projectile(data.projectiles[i])
    }

    // Serialize terrain modifications
    output = output + write_i32_bytes(data.terrain_mod_count)

    for i in 0..data.terrain_mod_count {
        output = output + serialize_terrain_mod(data.terrain_mods[i])
    }

    // Serialize misc state
    output = output + write_i64_bytes(data.random_state)
    output = output + write_f32_bytes(data.camera_x)
    output = output + write_f32_bytes(data.camera_y)
    output = output + write_f32_bytes(data.camera_z)
    output = output + write_f32_bytes(data.camera_pitch)
    output = output + write_f32_bytes(data.camera_yaw)
    output = output + write_f32_bytes(data.camera_zoom)

    return output
}

fn serialize_header(header: SaveHeader): [i32] {
    let output: [i32] = []

    // Signature
    for i in 0..4 {
        output = output + [header.signature[i]]
    }

    output = output + write_i32_bytes(header.version)
    output = output + write_i64_bytes(header.timestamp)

    // Save type
    output = output + [cast(i32, header.save_type)]

    // Save name - write length + bytes
    output = output + serialize_string(header.save_name)
    output = output + serialize_string(header.map_name)

    return output
}

fn serialize_player(player: PlayerSaveData): [i32] {
    let output: [i32] = []

    output = output + [player.player_id]
    output = output + serialize_string(player.name)

    output = output + [player.faction]
    output = output + [player.color]
    output = output + [player.general]
    output = output + [player.team]
    output = output + [cast(i32, player.is_ai)]
    output = output + [player.ai_difficulty]

    output = output + write_i32_bytes(player.money)
    output = output + write_i32_bytes(player.power_produced)
    output = output + write_i32_bytes(player.power_consumed)

    // Stats
    output = output + write_i32_bytes(player.units_built)
    output = output + write_i32_bytes(player.units_lost)
    output = output + write_i32_bytes(player.units_killed)
    output = output + write_i32_bytes(player.buildings_built)
    output = output + write_i32_bytes(player.buildings_lost)
    output = output + write_i32_bytes(player.buildings_destroyed)

    output = output + write_i32_bytes(player.general_points)

    return output
}

fn serialize_unit(unit: UnitSaveData): [i32] {
    let output: [i32] = []

    output = output + write_i32_bytes(unit.object_id)
    output = output + [unit.owner_id]
    output = output + write_i32_bytes(unit.unit_type)

    output = output + write_f32_bytes(unit.position_x)
    output = output + write_f32_bytes(unit.position_y)
    output = output + write_f32_bytes(unit.position_z)
    output = output + write_f32_bytes(unit.rotation)

    output = output + write_f32_bytes(unit.health)
    output = output + write_f32_bytes(unit.max_health)

    output = output + write_i32_bytes(unit.experience)
    output = output + [unit.veterancy]

    return output
}

fn serialize_building(building: BuildingSaveData): [i32] {
    let output: [i32] = []

    output = output + write_i32_bytes(building.object_id)
    output = output + [building.owner_id]
    output = output + write_i32_bytes(building.building_type)

    output = output + write_f32_bytes(building.position_x)
    output = output + write_f32_bytes(building.position_y)
    output = output + write_f32_bytes(building.position_z)

    output = output + write_f32_bytes(building.health)

    output = output + [cast(i32, building.is_powered)]
    output = output + [cast(i32, building.is_under_construction)]

    output = output + write_f32_bytes(building.construction_progress)

    return output
}

fn serialize_projectile(proj: ProjectileSaveData): [i32] {
    let output: [i32] = []

    output = output + write_i32_bytes(proj.projectile_id)

    output = output + write_f32_bytes(proj.position_x)
    output = output + write_f32_bytes(proj.position_y)
    output = output + write_f32_bytes(proj.position_z)

    output = output + write_f32_bytes(proj.velocity_x)
    output = output + write_f32_bytes(proj.velocity_y)
    output = output + write_f32_bytes(proj.velocity_z)

    return output
}

fn serialize_terrain_mod(mod_data: TerrainModification): [i32] {
    let output: [i32] = []

    output = output + write_f32_bytes(mod_data.position_x)
    output = output + write_f32_bytes(mod_data.position_y)
    output = output + write_f32_bytes(mod_data.radius)

    output = output + [mod_data.modification_type]

    output = output + write_f32_bytes(mod_data.intensity)

    return output
}

fn serialize_string(s: string): [i32] {
    let output: [i32] = []
    let len = s.length
    output = output + write_i32_bytes(len)
    // Would encode string bytes
    return output
}

fn deserialize_game_data(input: [i32], data: GameSaveData) {
