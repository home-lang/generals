// ============================================================================
// GLOBAL SAVE SYSTEM INSTANCE
// ============================================================================

let g_save_manager: SaveManager? = null
let g_save_ui: SaveLoadUI? = null

fn init_save_system(): SaveManager {
    let manager = SaveManager::init()
    manager.initialize()
    g_save_manager = manager
    g_save_ui = SaveLoadUI::init()
    return manager
}

fn get_save_manager(): SaveManager? {
    return g_save_manager
}

fn get_save_ui(): SaveLoadUI? {
    return g_save_ui
}

fn shutdown_save_system() {
    g_save_manager = null
    g_save_ui = null
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

fn test_save_load_system() {
    print("Testing Save/Load System...")

    // Create save manager
    let manager = SaveManager::init()
    print("Save manager created")

    // Create test game state
    let game_data = GameSaveData::init()
    game_data.header.map_name = "Tournament City"
    game_data.header.timestamp = 1700000000
    game_data.player_count = 2

    // Add test player data
    let player1 = PlayerSaveData::init()
    player1.player_id = 0
    player1.name = "Player1"
    player1.faction = 0
    player1.color = 1
    player1.money = 15000
    player1.power_produced = 10
    player1.power_consumed = 5
    player1.units_built = 25
    player1.units_lost = 5
    player1.units_killed = 12
    player1.buildings_built = 8
    player1.buildings_lost = 1
    player1.buildings_destroyed = 3
    player1.general_points = 3
    player1.rank = 1
    player1.experience = 500

    game_data.players = game_data.players + [player1]
    print("Test player data created")

    // Test quick save
    manager.quick_save(game_data)
    print("Quick save created")

    // Test manual save
    manager.manual_save(game_data, "TestSave")
    print("Manual save created")

    // Test auto save
    manager.auto_save_enabled = true
    manager.auto_save(game_data)
    print("Auto save created")

    // Test serialization size
    let serialized = serialize_game_data(game_data)
    print("Serialized size: " + str(serialized.length) + " bytes")

    // Test UI
    let ui = SaveLoadUI::init()
    print("Save/Load UI created")

    print("Save/Load System tests complete!")
}
