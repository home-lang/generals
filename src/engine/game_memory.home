// Game Memory - Game memory interface
// Global allocator, debug tracking, and memory subsystem management

// ============================================================================
// Configuration
// ============================================================================

struct PoolSizeConfig {
    small_pool_size: i32,
    medium_pool_size: i32,
    large_pool_size: i32,
    entity_pool_size: i32,
    particle_pool_size: i32,
    audio_pool_size: i32,
    texture_pool_size: i32,
}

impl PoolSizeConfig {
    fn init(): PoolSizeConfig {
        return PoolSizeConfig {
            small_pool_size: 1024 * 1024,           // 1 MB
            medium_pool_size: 4 * 1024 * 1024,      // 4 MB
            large_pool_size: 16 * 1024 * 1024,      // 16 MB
            entity_pool_size: 8 * 1024 * 1024,      // 8 MB
            particle_pool_size: 4 * 1024 * 1024,    // 4 MB
            audio_pool_size: 2 * 1024 * 1024,       // 2 MB
            texture_pool_size: 32 * 1024 * 1024,    // 32 MB
        }
    }
}

struct GameMemoryConfig {
    initial_heap_size: i64,
    max_heap_size: i64,
    pool_sizes: PoolSizeConfig,
    enable_tracking: bool,
    enable_leak_detection: bool,
    enable_bounds_checking: bool,
    enable_statistics: bool,
    log_allocations: bool,
    allocation_log_threshold: i32,
}

impl GameMemoryConfig {
    fn init(): GameMemoryConfig {
        return GameMemoryConfig {
            initial_heap_size: 64 * 1024 * 1024,
            max_heap_size: 512 * 1024 * 1024,
            pool_sizes: PoolSizeConfig::init(),
            enable_tracking: true,
            enable_leak_detection: true,
            enable_bounds_checking: true,
            enable_statistics: true,
            log_allocations: false,
            allocation_log_threshold: 1024 * 1024,
        }
    }
}

// ============================================================================
// Memory Categories
// ============================================================================

enum MemoryCategory {
    GENERAL,
    ENTITY,
    PARTICLE,
    AUDIO,
    TEXTURE,
    MESH,
    ANIMATION,
    PHYSICS,
    AI,
    NETWORK,
    UI,
    SCRIPT,
    TEMPORARY,
    DEBUG,
}

fn category_to_index(cat: MemoryCategory): i32 {
    if cat == MemoryCategory::GENERAL { return 0 }
    if cat == MemoryCategory::ENTITY { return 1 }
    if cat == MemoryCategory::PARTICLE { return 2 }
    if cat == MemoryCategory::AUDIO { return 3 }
    if cat == MemoryCategory::TEXTURE { return 4 }
    if cat == MemoryCategory::MESH { return 5 }
    if cat == MemoryCategory::ANIMATION { return 6 }
    if cat == MemoryCategory::PHYSICS { return 7 }
    if cat == MemoryCategory::AI { return 8 }
    if cat == MemoryCategory::NETWORK { return 9 }
    if cat == MemoryCategory::UI { return 10 }
    if cat == MemoryCategory::SCRIPT { return 11 }
    if cat == MemoryCategory::TEMPORARY { return 12 }
    if cat == MemoryCategory::DEBUG { return 13 }
    return 0
}

struct CategoryStats {
    allocated: i64,
    freed: i64,
    current: i64,
    peak: i64,
    allocation_count: i64,
    free_count: i64,
}

impl CategoryStats {
    fn init(): CategoryStats {
        return CategoryStats {
            allocated: 0,
            freed: 0,
            current: 0,
            peak: 0,
            allocation_count: 0,
            free_count: 0,
        }
    }
}

// ============================================================================
// Allocation Tracking
// ============================================================================

struct AllocationRecord {
    alloc_id: i64,
    address: i64,
    size: i32,
    category: MemoryCategory,
    timestamp: f32,
    source_file: string,
    source_line: i32,
    is_active: bool,
}

impl AllocationRecord {
    fn init(alloc_id: i64, address: i64, size: i32, category: MemoryCategory): AllocationRecord {
        return AllocationRecord {
            alloc_id: alloc_id,
            address: address,
            size: size,
            category: category,
            timestamp: 0.0,
            source_file: "",
            source_line: 0,
            is_active: true,
        }
    }
}

struct AllocationTracker {
    records: [AllocationRecord],
    record_count: i32,
    next_alloc_id: i64,
    enabled: bool,
}

impl AllocationTracker {
    fn init(): AllocationTracker {
        let recs: [AllocationRecord] = []
        for i in 0..4096 {
            recs = recs + [AllocationRecord::init(0, 0, 0, MemoryCategory::GENERAL)]
        }
        return AllocationTracker {
            records: recs,
            record_count: 0,
            next_alloc_id: 1,
            enabled: true,
        }
    }

    fn track(&self, address: i64, size: i32, category: MemoryCategory, time: f32): i64 {
        if !self.enabled || self.record_count >= 4096 {
            return 0
        }

        let alloc_id = self.next_alloc_id
        self.next_alloc_id = self.next_alloc_id + 1

        self.records[self.record_count] = AllocationRecord {
            alloc_id: alloc_id,
            address: address,
            size: size,
            category: category,
            timestamp: time,
            source_file: "",
            source_line: 0,
            is_active: true,
        }
        self.record_count = self.record_count + 1

        return alloc_id
    }

    fn track_free(&self, alloc_id: i64): bool {
        for i in 0..self.record_count {
            if self.records[i].alloc_id == alloc_id && self.records[i].is_active {
                self.records[i].is_active = false
                return true
            }
        }
        return false
    }
}

struct LeakInfo {
    alloc_id: i64,
    address: i64,
    size: i32,
    category: MemoryCategory,
    age: f32,
}

struct LeakReport {
    leak_count: i32,
    total_leaked_bytes: i64,
    leaks: [LeakInfo],
}

fn find_leaks(tracker: AllocationTracker): LeakReport {
    let leaks: [LeakInfo] = []
    let total: i64 = 0

    for i in 0..tracker.record_count {
        let record = tracker.records[i]
        if record.is_active {
            if leaks.length < 256 {
                leaks = leaks + [LeakInfo {
                    alloc_id: record.alloc_id,
                    address: record.address,
                    size: record.size,
                    category: record.category,
                    age: record.timestamp,
                }]
                total = total + record.size
            }
        }
    }

    return LeakReport {
        leak_count: leaks.length,
        total_leaked_bytes: total,
        leaks: leaks,
    }
}

// ============================================================================
// Memory Heap
// ============================================================================

struct HeapBlock {
    offset: i64,
    size: i64,
    is_free: bool,
    next_free: i32,
    alloc_id: i64,
}

impl HeapBlock {
    fn init(): HeapBlock {
        return HeapBlock {
            offset: 0,
            size: 0,
            is_free: true,
            next_free: -1,
            alloc_id: 0,
        }
    }
}

struct MemoryHeap {
    heap_id: i64,
    name: string,
    base_address: i64,
    total_size: i64,
    used_size: i64,
    peak_size: i64,
    allocation_count: i64,
    free_count: i64,

    // Simple block list
    blocks: [HeapBlock],
    block_count: i32,
    free_list_head: i32,
}

impl MemoryHeap {
    fn init(heap_id: i64, name: string, base_address: i64, size: i64): MemoryHeap {
        let blks: [HeapBlock] = []
        for i in 0..1024 {
            blks = blks + [HeapBlock::init()]
        }

        // Initialize with single free block
        blks[0] = HeapBlock {
            offset: 0,
            size: size,
            is_free: true,
            next_free: -1,
            alloc_id: 0,
        }

        return MemoryHeap {
            heap_id: heap_id,
            name: name,
            base_address: base_address,
            total_size: size,
            used_size: 0,
            peak_size: 0,
            allocation_count: 0,
            free_count: 0,
            blocks: blks,
            block_count: 1,
            free_list_head: 0,
        }
    }
}

struct HeapAllocation {
    success: bool,
    address: i64,
    actual_size: i64,
    block_index: i32,
}

fn heap_allocate(heap: MemoryHeap, size: i64, alignment: i64): HeapAllocation {
    let result = HeapAllocation {
        success: false,
        address: 0,
        actual_size: 0,
        block_index: -1,
    }

    // Align size
    let aligned_size = (size + alignment - 1) & ~(alignment - 1)

    // First-fit allocation
    let current = heap.free_list_head
    let prev: i32 = -1

    while current >= 0 {
        let block = heap.blocks[current]
        if block.is_free && block.size >= aligned_size {
            // Found suitable block
            let remaining = block.size - aligned_size

            if remaining > 64 && heap.block_count < 1024 {
                // Split block
                let new_block_idx = heap.block_count
                heap.blocks[new_block_idx] = HeapBlock {
                    offset: block.offset + aligned_size,
                    size: remaining,
                    is_free: true,
                    next_free: heap.blocks[current].next_free,
                    alloc_id: 0,
                }
                heap.block_count = heap.block_count + 1

                // Update free list
                if prev >= 0 {
                    heap.blocks[prev].next_free = new_block_idx
                } else {
                    heap.free_list_head = new_block_idx
                }

                heap.blocks[current].size = aligned_size
            } else {
                // Use entire block
                if prev >= 0 {
                    heap.blocks[prev].next_free = heap.blocks[current].next_free
                } else {
                    heap.free_list_head = heap.blocks[current].next_free
                }
            }

            heap.blocks[current].is_free = false
            heap.blocks[current].next_free = -1

            heap.used_size = heap.used_size + heap.blocks[current].size
            heap.allocation_count = heap.allocation_count + 1
            if heap.used_size > heap.peak_size {
                heap.peak_size = heap.used_size
            }

            result.success = true
            result.address = heap.base_address + heap.blocks[current].offset
            result.actual_size = heap.blocks[current].size
            result.block_index = current

            return result
        }

        prev = current
        current = heap.blocks[current].next_free
    }

    return result
}

fn heap_free(heap: MemoryHeap, block_index: i32): bool {
    if block_index < 0 || block_index >= heap.block_count {
        return false
    }

    let block = heap.blocks[block_index]
    if block.is_free {
        return false  // Double free
    }

    let block_size = block.size
    heap.blocks[block_index].is_free = true
    heap.blocks[block_index].alloc_id = 0

    // Add to free list
    heap.blocks[block_index].next_free = heap.free_list_head
    heap.free_list_head = block_index

    heap.used_size = heap.used_size - block_size
    heap.free_count = heap.free_count + 1

    return true
}

// ============================================================================
// Game Memory Manager (Global Interface)
// ============================================================================

struct GameMemoryManager {
    config: GameMemoryConfig,
    main_heap: MemoryHeap,
    category_stats: [CategoryStats],
    tracker: AllocationTracker,
    current_time: f32,
    is_initialized: bool,

    // Frame allocator for temporary allocations
    frame_allocator_offset: i64,
    frame_allocator_size: i64,
    frame_number: i64,
}

impl GameMemoryManager {
    fn init(config: GameMemoryConfig): GameMemoryManager {
        let stats: [CategoryStats] = []
        for i in 0..14 {
            stats = stats + [CategoryStats::init()]
        }

        let manager = GameMemoryManager {
            config: config,
            main_heap: MemoryHeap::init(1, "MainHeap", 0x10000000, config.initial_heap_size),
            category_stats: stats,
            tracker: AllocationTracker::init(),
            current_time: 0.0,
            is_initialized: false,
            frame_allocator_offset: 0,
            frame_allocator_size: 4 * 1024 * 1024,  // 4 MB frame allocator
            frame_number: 0,
        }

        manager.tracker.enabled = config.enable_tracking
        manager.is_initialized = true

        return manager
    }
}

// ============================================================================
// Global Allocation Interface
// ============================================================================

fn game_alloc(manager: GameMemoryManager, size: i64, category: MemoryCategory): i64 {
    return game_alloc_aligned(manager, size, 16, category)
}

fn game_alloc_aligned(manager: GameMemoryManager, size: i64, alignment: i64, category: MemoryCategory): i64 {
    if !manager.is_initialized {
        return 0
    }

    let result = heap_allocate(manager.main_heap, size, alignment)
    if !result.success {
        return 0
    }

    // Track allocation
    let cat_idx = category_to_index(category)
    manager.category_stats[cat_idx].allocated = manager.category_stats[cat_idx].allocated + result.actual_size
    manager.category_stats[cat_idx].current = manager.category_stats[cat_idx].current + result.actual_size
    manager.category_stats[cat_idx].allocation_count = manager.category_stats[cat_idx].allocation_count + 1
    if manager.category_stats[cat_idx].current > manager.category_stats[cat_idx].peak {
        manager.category_stats[cat_idx].peak = manager.category_stats[cat_idx].current
    }

    if manager.config.enable_tracking {
        let alloc_id = manager.tracker.track(result.address, result.actual_size, category, manager.current_time)
        manager.main_heap.blocks[result.block_index].alloc_id = alloc_id
    }

    // Log large allocations
    if manager.config.log_allocations && result.actual_size >= manager.config.allocation_log_threshold {
        print("[Memory] Large allocation: " + str(result.actual_size) + " bytes, category: " + str(cat_idx))
    }

    return result.address
}

fn game_free(manager: GameMemoryManager, address: i64): bool {
    if !manager.is_initialized || address == 0 {
        return false
    }

    // Find block by address
    for i in 0..manager.main_heap.block_count {
        let block = manager.main_heap.blocks[i]
        if !block.is_free && manager.main_heap.base_address + block.offset == address {
            let block_size = block.size
            let alloc_id = block.alloc_id

            // Free the block
            if !heap_free(manager.main_heap, i) {
                return false
            }

            // Track free
            if manager.config.enable_tracking && alloc_id != 0 {
                manager.tracker.track_free(alloc_id)
            }

            // Update stats (find category from tracker)
            for j in 0..manager.tracker.record_count {
                if manager.tracker.records[j].alloc_id == alloc_id {
                    let cat_idx = category_to_index(manager.tracker.records[j].category)
                    manager.category_stats[cat_idx].freed = manager.category_stats[cat_idx].freed + block_size
                    manager.category_stats[cat_idx].current = manager.category_stats[cat_idx].current - block_size
                    manager.category_stats[cat_idx].free_count = manager.category_stats[cat_idx].free_count + 1
                    break
                }
            }

            return true
        }
    }

    return false
}

fn game_realloc(manager: GameMemoryManager, address: i64, new_size: i64, category: MemoryCategory): i64 {
    if address == 0 {
        return game_alloc(manager, new_size, category)
    }

    if new_size == 0 {
        game_free(manager, address)
        return 0
    }

    // Simple realloc: allocate new, copy, free old
    let new_address = game_alloc(manager, new_size, category)
    if new_address == 0 {
        return 0
    }

    // Find old block size
    let old_size: i64 = 0
    for i in 0..manager.main_heap.block_count {
        let block = manager.main_heap.blocks[i]
        if !block.is_free && manager.main_heap.base_address + block.offset == address {
            old_size = block.size
            break
        }
    }

    // Copy would happen here in real implementation
    // memcpy(new_address, address, min(old_size, new_size))

    game_free(manager, address)

    return new_address
}

// ============================================================================
// Frame Allocator
// ============================================================================

fn frame_alloc(manager: GameMemoryManager, size: i64): i64 {
    let aligned_size = (size + 15) & ~15

    if manager.frame_allocator_offset + aligned_size > manager.frame_allocator_size {
        return 0  // Out of frame memory
    }

    let address = manager.main_heap.base_address + manager.main_heap.total_size - manager.frame_allocator_size + manager.frame_allocator_offset
    manager.frame_allocator_offset = manager.frame_allocator_offset + aligned_size

    return address
}

fn frame_reset(manager: GameMemoryManager) {
    manager.frame_allocator_offset = 0
    manager.frame_number = manager.frame_number + 1
}

// ============================================================================
// Statistics and Debugging
// ============================================================================

struct GameMemoryStats {
    total_allocated: i64,
    total_freed: i64,
    current_usage: i64,
    peak_usage: i64,
    heap_size: i64,
    heap_used: i64,
    allocation_count: i64,
    free_count: i64,
    frame_allocator_usage: i64,
}

fn get_memory_stats(manager: GameMemoryManager): GameMemoryStats {
    let total_allocated: i64 = 0
    let total_freed: i64 = 0
    let total_current: i64 = 0
    let total_peak: i64 = 0
    let total_alloc_count: i64 = 0
    let total_free_count: i64 = 0

    for i in 0..14 {
        total_allocated = total_allocated + manager.category_stats[i].allocated
        total_freed = total_freed + manager.category_stats[i].freed
        total_current = total_current + manager.category_stats[i].current
        total_peak = total_peak + manager.category_stats[i].peak
        total_alloc_count = total_alloc_count + manager.category_stats[i].allocation_count
        total_free_count = total_free_count + manager.category_stats[i].free_count
    }

    return GameMemoryStats {
        total_allocated: total_allocated,
        total_freed: total_freed,
        current_usage: total_current,
        peak_usage: total_peak,
        heap_size: manager.main_heap.total_size,
        heap_used: manager.main_heap.used_size,
        allocation_count: total_alloc_count,
        free_count: total_free_count,
        frame_allocator_usage: manager.frame_allocator_offset,
    }
}

fn get_category_stats(manager: GameMemoryManager, category: MemoryCategory): CategoryStats {
    return manager.category_stats[category_to_index(category)]
}

fn check_for_leaks(manager: GameMemoryManager): LeakReport {
    return find_leaks(manager.tracker)
}

fn dump_memory_report(manager: GameMemoryManager) {
    print("=== Game Memory Report ===")

    let stats = get_memory_stats(manager)
    print("Total Allocated: " + str(stats.total_allocated) + " bytes")
    print("Total Freed: " + str(stats.total_freed) + " bytes")
    print("Current Usage: " + str(stats.current_usage) + " bytes")
    print("Peak Usage: " + str(stats.peak_usage) + " bytes")
    print("Heap Size: " + str(stats.heap_size) + " bytes")
    print("Heap Used: " + str(stats.heap_used) + " bytes")
    print("Allocations: " + str(stats.allocation_count))
    print("Frees: " + str(stats.free_count))

    print("\n--- Category Breakdown ---")
    let categories = ["General", "Entity", "Particle", "Audio", "Texture", "Mesh", "Animation", "Physics", "AI", "Network", "UI", "Script", "Temporary", "Debug"]

    for i in 0..14 {
        let cat_stats = manager.category_stats[i]
        if cat_stats.current > 0 || cat_stats.allocation_count > 0 {
            print(categories[i] + ": " + str(cat_stats.current) + " bytes (" + str(cat_stats.allocation_count) + " allocs)")
        }
    }

    if manager.config.enable_leak_detection {
        let leaks = check_for_leaks(manager)
        if leaks.leak_count > 0 {
            print("\n!!! MEMORY LEAKS DETECTED !!!")
            print("Leak count: " + str(leaks.leak_count))
            print("Total leaked: " + str(leaks.total_leaked_bytes) + " bytes")
        } else {
            print("\nNo memory leaks detected.")
        }
    }

    print("=== End Memory Report ===")
}

// ============================================================================
// Shutdown
// ============================================================================

fn shutdown_game_memory(manager: GameMemoryManager) {
    if manager.config.enable_leak_detection {
        let leaks = check_for_leaks(manager)
        if leaks.leak_count > 0 {
            print("WARNING: " + str(leaks.leak_count) + " memory leaks detected at shutdown!")
            dump_memory_report(manager)
        }
    }

    manager.is_initialized = false
}

// ============================================================================
// Global Instance
// ============================================================================

let g_memory_manager: GameMemoryManager? = null

fn init_game_memory(config: GameMemoryConfig): GameMemoryManager {
    let manager = GameMemoryManager::init(config)
    g_memory_manager = manager
    return manager
}

fn get_memory_manager(): GameMemoryManager? {
    return g_memory_manager
}

fn shutdown_memory_manager() {
    if g_memory_manager != null {
        shutdown_game_memory(g_memory_manager)
        g_memory_manager = null
    }
}

// ============================================================================
// Tests
// ============================================================================

fn test_game_memory() {
    print("Testing Game Memory...")

    // Create manager
    let config = GameMemoryConfig::init()
    let manager = GameMemoryManager::init(config)
    print("  Created game memory manager")

    // Allocate various categories
    let addr1 = game_alloc(manager, 1024, MemoryCategory::ENTITY)
    print("  Allocated Entity: " + str(addr1))

    let addr2 = game_alloc(manager, 2048, MemoryCategory::TEXTURE)
    print("  Allocated Texture: " + str(addr2))

    let addr3 = game_alloc(manager, 512, MemoryCategory::PARTICLE)
    print("  Allocated Particle: " + str(addr3))

    // Get stats
    let stats = get_memory_stats(manager)
    print("  Current usage: " + str(stats.current_usage))

    // Test frame allocator
    let frame_addr = frame_alloc(manager, 256)
    print("  Frame alloc: " + str(frame_addr))

    frame_reset(manager)
    print("  Frame reset")

    // Free some
    game_free(manager, addr2)
    print("  Freed Texture allocation")

    // Check category stats
    let entity_stats = get_category_stats(manager, MemoryCategory::ENTITY)
    print("  Entity current: " + str(entity_stats.current))

    // Dump report
    dump_memory_report(manager)

    // Free remaining
    game_free(manager, addr1)
    game_free(manager, addr3)

    // Shutdown
    shutdown_game_memory(manager)
    print("  Shutdown complete")

    print("Game Memory tests complete!")
}
