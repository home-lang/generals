        self.database.add_string("OBJECT:GLACommandCenter", "Command Center", StringCategory::BUILDING)
        self.database.add_string("OBJECT:GLABarracks", "Barracks", StringCategory::BUILDING)
        self.database.add_string("OBJECT:GLAArmsDealer", "Arms Dealer", StringCategory::BUILDING)
        self.database.add_string("OBJECT:GLASupplyStash", "Supply Stash", StringCategory::BUILDING)
