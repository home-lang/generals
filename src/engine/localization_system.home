// Localization System - Multi-language support
// Implements authentic C&C Generals Zero Hour localization (STR/CSF files)
// Based on Thyme: game/client/gametext.cpp

// ============================================================================
// SUPPORTED LANGUAGES
// ============================================================================

enum Language {
    ENGLISH,
    FRENCH,
    GERMAN,
    SPANISH,
    ITALIAN,
    KOREAN,
    CHINESE_SIMPLIFIED,
    CHINESE_TRADITIONAL,
    JAPANESE,
    POLISH,
    RUSSIAN,
}

// Language codes
fn get_language_code(language: Language): string {
    if language == Language::ENGLISH {
        return "en"
    } else if language == Language::FRENCH {
        return "fr"
    } else if language == Language::GERMAN {
        return "de"
    } else if language == Language::SPANISH {
        return "es"
    } else if language == Language::ITALIAN {
        return "it"
    } else if language == Language::KOREAN {
        return "ko"
    } else if language == Language::CHINESE_SIMPLIFIED {
        return "zh-CN"
    } else if language == Language::CHINESE_TRADITIONAL {
        return "zh-TW"
    } else if language == Language::JAPANESE {
        return "ja"
    } else if language == Language::POLISH {
        return "pl"
    } else if language == Language::RUSSIAN {
        return "ru"
    }
    return "en"
}

fn get_language_name(language: Language): string {
    if language == Language::ENGLISH {
        return "English"
    } else if language == Language::FRENCH {
        return "Français"
    } else if language == Language::GERMAN {
        return "Deutsch"
    } else if language == Language::SPANISH {
        return "Español"
    } else if language == Language::ITALIAN {
        return "Italiano"
    } else if language == Language::KOREAN {
        return "한국어"
    } else if language == Language::CHINESE_SIMPLIFIED {
        return "简体中文"
    } else if language == Language::CHINESE_TRADITIONAL {
        return "繁體中文"
    } else if language == Language::JAPANESE {
        return "日本語"
    } else if language == Language::POLISH {
        return "Polski"
    } else if language == Language::RUSSIAN {
        return "Русский"
    }
    return "English"
}

// ============================================================================
// STRING DATABASE
// ============================================================================

enum StringCategory {
    GUI,           // Menu and UI text
    UNIT,          // Unit names and descriptions
    BUILDING,      // Building names and descriptions
    ABILITY,       // Ability and power names
    UPGRADE,       // Upgrade names
    EVA,           // EVA announcer text
    TOOLTIP,       // Tooltips and help text
    OBJECTIVE,     // Mission objectives
    DIALOGUE,      // Campaign dialogue
    GENERAL,       // General text
    ERROR,         // Error messages
}

struct LocalizedString {
    label: string,
    value: string,
    category: StringCategory,
}

impl LocalizedString {
    fn init(label: string, value: string, category: StringCategory): LocalizedString {
        return LocalizedString {
            label: label,
            value: value,
            category: category,
        }
    }
}

struct StringDatabase {
    strings: [LocalizedString],
    string_count: i32,
    current_language: Language,
}

impl StringDatabase {
    fn init(): StringDatabase {
        return StringDatabase {
            strings: [],
            string_count: 0,
            current_language: Language::ENGLISH,
        }
    }

    fn add_string(&self, label: string, value: string, category: StringCategory) {
        let entry = LocalizedString::init(label, value, category)
        self.strings = self.strings + [entry]
        self.string_count = self.string_count + 1
    }

    fn get_string(&self, label: string): string {
        for i in 0..self.string_count {
            if self.strings[i].label == label {
                return self.strings[i].value
            }
        }
        return label  // Return label if not found
    }

    fn string_exists(&self, label: string): bool {
        for i in 0..self.string_count {
            if self.strings[i].label == label {
                return true
            }
        }
        return false
    }

    fn clear(&self) {
        self.strings = []
        self.string_count = 0
    }
}

// ============================================================================
// LOCALIZATION MANAGER
// ============================================================================

struct Localization {
    database: StringDatabase,
    current_language: Language,
    loaded_files: [string],
    loaded_count: i32,
    requires_cjk_font: bool,
    requires_cyrillic_font: bool,
    is_initialized: bool,
}

impl Localization {
    fn init(): Localization {
        return Localization {
            database: StringDatabase::init(),
            current_language: Language::ENGLISH,
            loaded_files: [],
            loaded_count: 0,
            requires_cjk_font: false,
            requires_cyrillic_font: false,
            is_initialized: false,
        }
    }

    fn initialize(&self, language: Language) {
        self.current_language = language
        self.database.current_language = language

        // Determine font requirements
        if language == Language::KOREAN || language == Language::CHINESE_SIMPLIFIED ||
           language == Language::CHINESE_TRADITIONAL || language == Language::JAPANESE {
            self.requires_cjk_font = true
        } else {
            self.requires_cjk_font = false
        }

        if language == Language::RUSSIAN {
            self.requires_cyrillic_font = true
        } else {
            self.requires_cyrillic_font = false
        }

        // Load essential strings
        self.add_essential_strings()
        self.is_initialized = true
    }

    fn set_language(&self, language: Language) {
        if language != self.current_language {
            self.current_language = language
            self.database.clear()
            self.initialize(language)
        }
    }

    fn get_string(&self, label: string): string {
        return self.database.get_string(label)
    }

    fn fetch(&self, label: string): string {
        return self.database.get_string(label)
    }

    fn get_language_path(&self): string {
        if self.current_language == Language::ENGLISH {
            return "Data/English/generals.csf"
        } else if self.current_language == Language::FRENCH {
            return "Data/French/generals.csf"
        } else if self.current_language == Language::GERMAN {
            return "Data/German/generals.csf"
        } else if self.current_language == Language::SPANISH {
            return "Data/Spanish/generals.csf"
        } else if self.current_language == Language::ITALIAN {
            return "Data/Italian/generals.csf"
        } else if self.current_language == Language::KOREAN {
            return "Data/Korean/generals.csf"
        } else if self.current_language == Language::CHINESE_SIMPLIFIED {
            return "Data/Chinese/generals.csf"
        } else if self.current_language == Language::CHINESE_TRADITIONAL {
            return "Data/ChineseTrad/generals.csf"
        } else if self.current_language == Language::JAPANESE {
            return "Data/Japanese/generals.csf"
        } else if self.current_language == Language::POLISH {
            return "Data/Polish/generals.csf"
        } else if self.current_language == Language::RUSSIAN {
            return "Data/Russian/generals.csf"
        }
        return "Data/English/generals.csf"
    }

    fn add_essential_strings(&self) {
        // Main Menu
        self.database.add_string("GUI:MainMenuSinglePlayer", "SOLO PLAY", StringCategory::GUI)
        self.database.add_string("GUI:MainMenuMultiplayer", "MULTIPLAYER", StringCategory::GUI)
        self.database.add_string("GUI:MainMenuOptions", "OPTIONS", StringCategory::GUI)
        self.database.add_string("GUI:MainMenuLoad", "LOAD", StringCategory::GUI)
        self.database.add_string("GUI:MainMenuCredits", "CREDITS", StringCategory::GUI)
        self.database.add_string("GUI:MainMenuExit", "EXIT", StringCategory::GUI)

        // Solo Play submenu
        self.database.add_string("GUI:Campaign", "CAMPAIGN", StringCategory::GUI)
        self.database.add_string("GUI:Skirmish", "SKIRMISH", StringCategory::GUI)
        self.database.add_string("GUI:Challenge", "GENERALS CHALLENGE", StringCategory::GUI)

        // Options
        self.database.add_string("GUI:OptionsGraphics", "GRAPHICS", StringCategory::GUI)
        self.database.add_string("GUI:OptionsAudio", "AUDIO", StringCategory::GUI)
        self.database.add_string("GUI:OptionsControls", "CONTROLS", StringCategory::GUI)
        self.database.add_string("GUI:OptionsNetwork", "NETWORK", StringCategory::GUI)

        // Factions
        self.database.add_string("FACTION:USA", "USA", StringCategory::GENERAL)
        self.database.add_string("FACTION:USADesc", "United States of America", StringCategory::GENERAL)
        self.database.add_string("FACTION:China", "CHINA", StringCategory::GENERAL)
        self.database.add_string("FACTION:ChinaDesc", "People's Republic of China", StringCategory::GENERAL)
        self.database.add_string("FACTION:GLA", "GLA", StringCategory::GENERAL)
        self.database.add_string("FACTION:GLADesc", "Global Liberation Army", StringCategory::GENERAL)

        // USA Units
        self.database.add_string("OBJECT:AmericaInfantryRanger", "Ranger", StringCategory::UNIT)
        self.database.add_string("OBJECT:AmericaInfantryMissileDefender", "Missile Defender", StringCategory::UNIT)
        self.database.add_string("OBJECT:AmericaVehicleHumvee", "Humvee", StringCategory::UNIT)
        self.database.add_string("OBJECT:AmericaVehicleTank", "Crusader Tank", StringCategory::UNIT)
        self.database.add_string("OBJECT:AmericaVehiclePaladin", "Paladin Tank", StringCategory::UNIT)
        self.database.add_string("OBJECT:AmericaJetRaptor", "Raptor", StringCategory::UNIT)
        self.database.add_string("OBJECT:AmericaJetAurora", "Aurora Bomber", StringCategory::UNIT)
        self.database.add_string("OBJECT:AmericaVehicleChinook", "Chinook", StringCategory::UNIT)
        self.database.add_string("OBJECT:AmericaJetComanche", "Comanche", StringCategory::UNIT)

        // China Units
        self.database.add_string("OBJECT:ChinaInfantryRedGuard", "Red Guard", StringCategory::UNIT)
        self.database.add_string("OBJECT:ChinaInfantryTankHunter", "Tank Hunter", StringCategory::UNIT)
        self.database.add_string("OBJECT:ChinaVehicleBattlemaster", "Battlemaster", StringCategory::UNIT)
        self.database.add_string("OBJECT:ChinaVehicleOverlord", "Overlord", StringCategory::UNIT)
        self.database.add_string("OBJECT:ChinaVehicleGatlingTank", "Gatling Tank", StringCategory::UNIT)
        self.database.add_string("OBJECT:ChinaJetMIG", "MiG", StringCategory::UNIT)
        self.database.add_string("OBJECT:ChinaVehicleSupplyTruck", "Supply Truck", StringCategory::UNIT)

        // GLA Units
        self.database.add_string("OBJECT:GLAInfantryRebel", "Rebel", StringCategory::UNIT)
        self.database.add_string("OBJECT:GLAInfantryRPGTrooper", "RPG Trooper", StringCategory::UNIT)
        self.database.add_string("OBJECT:GLAVehicleTechnical", "Technical", StringCategory::UNIT)
        self.database.add_string("OBJECT:GLAVehicleScorpion", "Scorpion Tank", StringCategory::UNIT)
        self.database.add_string("OBJECT:GLAVehicleMarauder", "Marauder", StringCategory::UNIT)
        self.database.add_string("OBJECT:GLAVehicleBombTruck", "Bomb Truck", StringCategory::UNIT)
        self.database.add_string("OBJECT:GLAVehicleQuadCannon", "Quad Cannon", StringCategory::UNIT)
        self.database.add_string("OBJECT:GLAWorker", "Worker", StringCategory::UNIT)

        // Buildings
        self.database.add_string("OBJECT:AmericaCommandCenter", "Command Center", StringCategory::BUILDING)
        self.database.add_string("OBJECT:AmericaBarracks", "Barracks", StringCategory::BUILDING)
        self.database.add_string("OBJECT:AmericaWarFactory", "War Factory", StringCategory::BUILDING)
        self.database.add_string("OBJECT:AmericaAirfield", "Airfield", StringCategory::BUILDING)
        self.database.add_string("OBJECT:AmericaSupplyCenter", "Supply Center", StringCategory::BUILDING)
        self.database.add_string("OBJECT:AmericaPowerPlant", "Power Plant", StringCategory::BUILDING)
        self.database.add_string("OBJECT:AmericaStrategyCenter", "Strategy Center", StringCategory::BUILDING)
        self.database.add_string("OBJECT:AmericaParticleUplink", "Particle Cannon", StringCategory::BUILDING)

        self.database.add_string("OBJECT:ChinaCommandCenter", "Command Center", StringCategory::BUILDING)
        self.database.add_string("OBJECT:ChinaBarracks", "Barracks", StringCategory::BUILDING)
        self.database.add_string("OBJECT:ChinaWarFactory", "War Factory", StringCategory::BUILDING)
        self.database.add_string("OBJECT:ChinaAirfield", "Airfield", StringCategory::BUILDING)
        self.database.add_string("OBJECT:ChinaSupplyCenter", "Supply Center", StringCategory::BUILDING)
        self.database.add_string("OBJECT:ChinaPowerPlant", "Nuclear Reactor", StringCategory::BUILDING)
