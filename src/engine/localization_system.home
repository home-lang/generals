}

// ============================================================================
// GLOBAL INSTANCE
// ============================================================================

let g_localization: Localization? = null

fn init_localization(): Localization {
    let loc = Localization::init()
    loc.initialize(Language::ENGLISH)
    g_localization = loc
    return loc
}

fn get_localization(): Localization? {
    return g_localization
}

fn fetch_string(label: string): string {
    if g_localization != null {
        return g_localization.fetch(label)
    }
    return label
}

fn shutdown_localization() {
    if g_localization != null {
        g_localization.database.clear()
        g_localization = null
    }
}
