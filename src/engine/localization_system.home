        self.database.add_string("OBJECT:GLASCUDStorm", "SCUD Storm", StringCategory::BUILDING)

        // EVA Messages
        self.database.add_string("EVA:BuildingComplete", "Construction complete", StringCategory::EVA)
        self.database.add_string("EVA:UnitReady", "Unit ready", StringCategory::EVA)
        self.database.add_string("EVA:UnitLost", "Unit lost", StringCategory::EVA)
        self.database.add_string("EVA:BaseUnderAttack", "Our base is under attack", StringCategory::EVA)
        self.database.add_string("EVA:AllyUnderAttack", "Our ally is under attack", StringCategory::EVA)
        self.database.add_string("EVA:InsufficientFunds", "Insufficient funds", StringCategory::EVA)
        self.database.add_string("EVA:LowPower", "Low power", StringCategory::EVA)
        self.database.add_string("EVA:UpgradeComplete", "Upgrade complete", StringCategory::EVA)
        self.database.add_string("EVA:GeneralPromotion", "General promotion!", StringCategory::EVA)
        self.database.add_string("EVA:SuperweaponReady", "Superweapon ready", StringCategory::EVA)
