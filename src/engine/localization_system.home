        self.database.add_string("EVA:SuperweaponLaunched", "Superweapon launched", StringCategory::EVA)

        // Tooltips
        self.database.add_string("TOOLTIP:BuildDozer", "Build a Dozer to construct buildings", StringCategory::TOOLTIP)
        self.database.add_string("TOOLTIP:BuildBarracks", "Train infantry units", StringCategory::TOOLTIP)
