// C&C Generals Zero Hour - Home Port
// Window Manager - Manages WND window hierarchy and input
//
// Original: GameWindow and WindowManager from Thyme/SAGE engine
// Handles creating, destroying, and dispatching input to windows
//
// The WND system is Generals' UI framework:
// - Hierarchical window tree
// - Input event dispatch
// - Focus management
// - Modal dialogs
// - Screen transitions

let MAX_WINDOWS: i32 = 1024
let MAX_ROOT_WINDOWS: i32 = 64
let MAX_MODAL_STACK: i32 = 16
let MAX_CHILDREN: i32 = 64

// ============================================================================
// WINDOW MESSAGE TYPES
// ============================================================================

enum WindowMessage {
    NONE,
    CREATED,
    DESTROYED,
    MOUSE_ENTER,
    MOUSE_LEAVE,
    MOUSE_MOVE,
    LEFT_DOWN,
    LEFT_UP,
    LEFT_CLICK,
    LEFT_DOUBLE_CLICK,
    RIGHT_DOWN,
    RIGHT_UP,
    RIGHT_CLICK,
    MIDDLE_DOWN,
    MIDDLE_UP,
    WHEEL_UP,
    WHEEL_DOWN,
    KEY_DOWN,
    KEY_UP,
    CHAR_TYPED,
    GAIN_FOCUS,
    LOSE_FOCUS,
    STATE_CHANGE,
    LIST_SELECT,
    SLIDER_CHANGE,
    TEXT_CHANGE,
    TAB_CHANGE,
    SYSTEM_UPDATE,
    DRAW,
}

// ============================================================================
// MESSAGE DATA
// ============================================================================

struct WindowMessageData {
    message: WindowMessage,
    window_id: i32,
    mouse_x: i32,
    mouse_y: i32,
    key_code: i32,
    char_value: i32,
    data: i32,
}

impl WindowMessageData {
    fn init(): WindowMessageData {
        return WindowMessageData {
            message: WindowMessage::NONE,
            window_id: 0,
            mouse_x: 0,
            mouse_y: 0,
            key_code: 0,
            char_value: 0,
            data: 0,
        }
    }
}

// ============================================================================
// TRANSITION TYPES
// ============================================================================

enum TransitionType {
    NONE,
    FADE,
    SLIDE,
    WIPE,
    IRIS,
}

// ============================================================================
// MODAL ENTRY
// ============================================================================

struct ModalEntry {
    window_id: i32,
    previous_focus: i32,
}

impl ModalEntry {
    fn init(): ModalEntry {
        return ModalEntry {
            window_id: 0,
            previous_focus: 0,
        }
    }
}

// ============================================================================
// WINDOW TYPE
// ============================================================================

enum WindowType {
    GENERIC,
    PUSH_BUTTON,
    CHECK_BOX,
    RADIO_BUTTON,
    LIST_BOX,
    COMBO_BOX,
    HORIZONTAL_SLIDER,
    VERTICAL_SLIDER,
    PROGRESS_BAR,
    STATIC_TEXT,
    ENTRY_FIELD,
    SCROLL_LIST_BOX,
    TAB_CONTROL,
    IMAGE,
    COMMAND_BUTTON,
}

// ============================================================================
// WINDOW RECT
// ============================================================================

struct WndRect {
    x: i32,
    y: i32,
    width: i32,
    height: i32,
}

impl WndRect {
    fn init(): WndRect {
        return WndRect { x: 0, y: 0, width: 0, height: 0 }
    }

    fn contains(&self, px: i32, py: i32): bool {
        return px >= self.x && px < self.x + self.width &&
               py >= self.y && py < self.y + self.height
    }
}

// ============================================================================
// WINDOW DRAW DATA
// ============================================================================

struct WindowDrawData {
    image: string,
    color: i32,
    border_color: i32,
}

impl WindowDrawData {
    fn init(): WindowDrawData {
        return WindowDrawData {
            image: "",
            color: 0xFFFFFFFF,
            border_color: 0xFF000000,
        }
    }
}

// ============================================================================
// WINDOW
// ============================================================================

struct WndWindow {
    id: i32,
    name: string,
    window_type: WindowType,
    is_valid: bool,

    // Hierarchy
    parent_id: i32,
    children: [i32],

    // Geometry
    screen_rect: WndRect,
    creation_rect: WndRect,

    // State flags
    status: i32,
    style: i32,
    is_hidden: bool,
    is_enabled: bool,
    is_focused: bool,
    is_mouse_over: bool,
    is_pressed: bool,

    // Text
    text: string,
    font_name: string,
    font_size: i32,
    text_color: i32,

    // Draw data
    enabled_draw: WindowDrawData,
    disabled_draw: WindowDrawData,
    hilite_draw: WindowDrawData,
    selected_draw: WindowDrawData,

    // Callbacks
    system_callback: string,
    input_callback: string,
    tooltip_callback: string,
    draw_callback: string,

    // Tooltip
    tooltip_text: string,
    tooltip_delay: i32,

    // Template
    header_template: string,
}

impl WndWindow {
    fn init(name: string, window_type: WindowType): WndWindow {
        return WndWindow {
            id: 0,
            name: name,
            window_type: window_type,
            is_valid: true,
            parent_id: 0,
            children: [],
            screen_rect: WndRect::init(),
            creation_rect: WndRect::init(),
            status: 1,  // Enabled by default
            style: 0,
            is_hidden: false,
            is_enabled: true,
            is_focused: false,
            is_mouse_over: false,
            is_pressed: false,
            text: "",
            font_name: "Arial",
            font_size: 12,
            text_color: 0xFFFFFFFF,
            enabled_draw: WindowDrawData::init(),
            disabled_draw: WindowDrawData::init(),
            hilite_draw: WindowDrawData::init(),
            selected_draw: WindowDrawData::init(),
            system_callback: "",
            input_callback: "",
            tooltip_callback: "",
            draw_callback: "",
            tooltip_text: "",
            tooltip_delay: 500,
            header_template: "",
        }
    }

    fn add_child(&self, child_id: i32): bool {
        if self.children.length >= MAX_CHILDREN {
            return false
        }
        self.children = self.children + [child_id]
        return true
    }

    fn remove_child(&self, child_id: i32) {
        let new_children: [i32] = []
        for i in 0..self.children.length {
            if self.children[i] != child_id {
                new_children = new_children + [self.children[i]]
            }
        }
        self.children = new_children
    }

    fn set_hidden(&self, hidden: bool) {
        self.is_hidden = hidden
    }

    fn set_enabled(&self, enabled: bool) {
        self.is_enabled = enabled
    }

    fn set_text(&self, text: string) {
        self.text = text
    }

    fn set_rect(&self, x: i32, y: i32, width: i32, height: i32) {
        self.screen_rect.x = x
        self.screen_rect.y = y
        self.screen_rect.width = width
        self.screen_rect.height = height
    }

    fn contains_point(&self, x: i32, y: i32): bool {
        return self.screen_rect.contains(x, y)
    }

    fn get_status_flag(&self, flag: i32): bool {
        return (self.status & (1 << flag)) != 0
    }

    fn set_status_flag(&self, flag: i32, value: bool) {
        if value {
            self.status = self.status | (1 << flag)
        } else {
            self.status = self.status & ~(1 << flag)
        }
    }
}

// ============================================================================
// NAME REGISTRY
// ============================================================================

struct NameEntry {
    name: string,
    id: i32,
}

struct NameRegistry {
    entries: [NameEntry],
}

impl NameRegistry {
    fn init(): NameRegistry {
        return NameRegistry { entries: [] }
    }

    fn insert(&self, name: string, id: i32) {
        // Update if exists
        for i in 0..self.entries.length {
            if self.entries[i].name == name {
                self.entries[i].id = id
                return
            }
        }
        // Add new
        self.entries = self.entries + [NameEntry { name: name, id: id }]
    }

    fn get(&self, name: string): i32? {
        for i in 0..self.entries.length {
            if self.entries[i].name == name {
                return self.entries[i].id
            }
        }
        return null
    }

    fn remove(&self, name: string) {
        let new_entries: [NameEntry] = []
        for i in 0..self.entries.length {
            if self.entries[i].name != name {
                new_entries = new_entries + [self.entries[i]]
            }
        }
        self.entries = new_entries
    }
}

// ============================================================================
// WINDOW MANAGER
// ============================================================================

struct WindowManager {
    // Window storage
    windows: [WndWindow],
    window_name_to_id: NameRegistry,
    next_window_id: i32,

    // Root windows (top-level screens)
    root_windows: [i32],
    active_root: i32,

    // Focus
    focused_window: i32,
    mouse_capture_window: i32,
    hover_window: i32,

    // Modal stack
    modal_stack: [ModalEntry],

    // Screen dimensions
    screen_width: i32,
    screen_height: i32,

    // Transition state
    transition_type: TransitionType,
    transition_progress: f32,
    transition_from_root: i32,
    transition_to_root: i32,

    // Tooltip
    tooltip_window: i32,
    tooltip_delay_timer: f32,
    tooltip_target: i32,

    // Input state
    last_mouse_x: i32,
    last_mouse_y: i32,
    left_button_down: bool,
    right_button_down: bool,
    middle_button_down: bool,

    // Debug
    debug_draw_bounds: bool,
}

impl WindowManager {
    fn init(screen_width: i32, screen_height: i32): WindowManager {
        let manager = WindowManager {
            windows: [],
            window_name_to_id: NameRegistry::init(),
            next_window_id: 1,
            root_windows: [],
            active_root: 0,
            focused_window: 0,
            mouse_capture_window: 0,
            hover_window: 0,
            modal_stack: [],
            screen_width: screen_width,
            screen_height: screen_height,
            transition_type: TransitionType::NONE,
            transition_progress: 0.0,
            transition_from_root: 0,
            transition_to_root: 0,
            tooltip_window: 0,
            tooltip_delay_timer: 0.0,
            tooltip_target: 0,
            last_mouse_x: 0,
            last_mouse_y: 0,
            left_button_down: false,
            right_button_down: false,
            middle_button_down: false,
            debug_draw_bounds: false,
        }

        // Create tooltip window
        manager.tooltip_window = manager.create_window("Tooltip", WindowType::STATIC_TEXT)
        let tooltip = manager.get_window(manager.tooltip_window)
        if tooltip != null {
            tooltip.set_hidden(true)
        }

        return manager
    }

    // ========================================================================
    // Window Creation/Destruction
    // ========================================================================

    fn create_window(&self, name: string, window_type: WindowType): i32 {
        if self.windows.length >= MAX_WINDOWS {
            return 0
        }

        let id = self.next_window_id
        self.next_window_id = self.next_window_id + 1

        let window = WndWindow::init(name, window_type)
        window.id = id

        self.windows = self.windows + [window]
        self.window_name_to_id.insert(name, id)

        // Send created message
        self.send_message(id, WindowMessage::CREATED, 0, 0, 0)

        return id
    }

    fn destroy_window(&self, window_id: i32): bool {
        let window = self.get_window(window_id)
        if window == null {
            return false
        }

        // Destroy children first
        let children_copy = window.children
        for i in 0..children_copy.length {
            self.destroy_window(children_copy[i])
        }

        // Remove from parent
        if window.parent_id != 0 {
            let parent = self.get_window(window.parent_id)
            if parent != null {
                parent.remove_child(window_id)
            }
        }

        // Remove from name map
        self.window_name_to_id.remove(window.name)

        // Send destroyed message
        self.send_message(window_id, WindowMessage::DESTROYED, 0, 0, 0)

        // Clear focus if this was focused
        if self.focused_window == window_id {
            self.focused_window = 0
        }
        if self.hover_window == window_id {
            self.hover_window = 0
        }

        // Invalidate
        window.is_valid = false

        return true
    }

    // ========================================================================
    // Window Hierarchy
    // ========================================================================

    fn set_parent(&self, window_id: i32, parent_id: i32): bool {
        let window = self.get_window(window_id)
        if window == null {
            return false
        }

        // Remove from old parent
        let old_parent_id = window.parent_id
        if old_parent_id != 0 {
            let old_parent = self.get_window(old_parent_id)
            if old_parent != null {
                old_parent.remove_child(window_id)
            }
        }

        window.parent_id = parent_id

        // Add to new parent
        if parent_id != 0 {
            let parent = self.get_window(parent_id)
            if parent != null {
                return parent.add_child(window_id)
            }
        }

        return true
    }

    fn add_root_window(&self, window_id: i32): bool {
        if self.root_windows.length >= MAX_ROOT_WINDOWS {
            return false
        }

        self.root_windows = self.root_windows + [window_id]

        if self.active_root == 0 {
            self.active_root = window_id
        }

        return true
    }

    // ========================================================================
    // Window Access
    // ========================================================================

    fn get_window(&self, window_id: i32): WndWindow? {
        for i in 0..self.windows.length {
            if self.windows[i].is_valid && self.windows[i].id == window_id {
                return self.windows[i]
            }
        }
        return null
    }

    fn get_window_by_name(&self, name: string): WndWindow? {
        let id = self.window_name_to_id.get(name)
        if id == null {
            return null
        }
        return self.get_window(id)
    }

    // ========================================================================
    // Screen Management
    // ========================================================================

    fn switch_to_screen(&self, window_id: i32, transition: TransitionType) {
        if window_id == self.active_root {
            return
        }

        self.transition_type = transition
        self.transition_from_root = self.active_root
        self.transition_to_root = window_id

        if transition == TransitionType::NONE {
            // Immediate switch
            self.hide_window(self.active_root)
            self.show_window(window_id)
            self.active_root = window_id
        } else {
            // Start transition
            self.transition_progress = 0.0
            self.show_window(window_id)
        }
    }

    fn update_transition(&self, delta_time: f32) {
        if self.transition_type == TransitionType::NONE {
            return
        }

        self.transition_progress = self.transition_progress + delta_time * 2.0  // 0.5 second transitions

        if self.transition_progress >= 1.0 {
            // Transition complete
            self.hide_window(self.transition_from_root)
            self.active_root = self.transition_to_root
            self.transition_type = TransitionType::NONE
        }
    }

    fn show_window(&self, window_id: i32) {
        let window = self.get_window(window_id)
        if window != null {
            window.set_hidden(false)
        }
    }

    fn hide_window(&self, window_id: i32) {
        let window = self.get_window(window_id)
        if window != null {
            window.set_hidden(true)
        }
    }

    // ========================================================================
    // Modal Windows
    // ========================================================================

    fn push_modal(&self, window_id: i32): bool {
        if self.modal_stack.length >= MAX_MODAL_STACK {
            return false
        }

        self.modal_stack = self.modal_stack + [ModalEntry {
            window_id: window_id,
            previous_focus: self.focused_window,
        }]

        self.set_focus(window_id)
        self.show_window(window_id)

        return true
    }

    fn pop_modal(&self): i32 {
        if self.modal_stack.length == 0 {
            return 0
        }

        let entry = self.modal_stack[self.modal_stack.length - 1]
        let window_id = entry.window_id
        let prev_focus = entry.previous_focus

        // Remove from stack
        let new_stack: [ModalEntry] = []
        for i in 0..(self.modal_stack.length - 1) {
            new_stack = new_stack + [self.modal_stack[i]]
        }
        self.modal_stack = new_stack

        self.hide_window(window_id)
        self.set_focus(prev_focus)

        return window_id
    }

    fn is_modal_active(&self): bool {
        return self.modal_stack.length > 0
    }

    fn get_active_modal(&self): i32 {
        if self.modal_stack.length > 0 {
            return self.modal_stack[self.modal_stack.length - 1].window_id
        }
        return 0
    }

    // ========================================================================
    // Focus Management
    // ========================================================================

    fn set_focus(&self, window_id: i32) {
        if self.focused_window == window_id {
            return
        }

        // Lose focus on old window
        if self.focused_window != 0 {
            self.send_message(self.focused_window, WindowMessage::LOSE_FOCUS, 0, 0, 0)
            let old_window = self.get_window(self.focused_window)
            if old_window != null {
                old_window.is_focused = false
            }
        }

        self.focused_window = window_id

        // Gain focus on new window
        if window_id != 0 {
            self.send_message(window_id, WindowMessage::GAIN_FOCUS, 0, 0, 0)
            let new_window = self.get_window(window_id)
            if new_window != null {
                new_window.is_focused = true
            }
        }
    }

    fn capture_mouse(&self, window_id: i32) {
        self.mouse_capture_window = window_id
    }

    fn release_mouse(&self) {
        self.mouse_capture_window = 0
    }

    // ========================================================================
    // Input Handling
    // ========================================================================

    fn handle_mouse_move(&self, x: i32, y: i32): bool {
        self.last_mouse_x = x
        self.last_mouse_y = y

        // Handle captured mouse
        if self.mouse_capture_window != 0 {
            self.send_message(self.mouse_capture_window, WindowMessage::MOUSE_MOVE, x, y, 0)
            return true
        }

        // Find window under cursor
        let window_id = self.window_at_point(x, y)

        // Handle hover changes
        if window_id != self.hover_window {
            if self.hover_window != 0 {
                self.send_message(self.hover_window, WindowMessage::MOUSE_LEAVE, x, y, 0)
                let old_hover = self.get_window(self.hover_window)
                if old_hover != null {
                    old_hover.is_mouse_over = false
                }
            }

            self.hover_window = window_id

            if window_id != 0 {
                self.send_message(window_id, WindowMessage::MOUSE_ENTER, x, y, 0)
                let new_hover = self.get_window(window_id)
                if new_hover != null {
                    new_hover.is_mouse_over = true
                }
            }

            // Reset tooltip timer
            self.tooltip_delay_timer = 0.0
            self.tooltip_target = window_id
        }

        if window_id != 0 {
            self.send_message(window_id, WindowMessage::MOUSE_MOVE, x, y, 0)
            return true
        }

        return false
    }

    fn handle_left_down(&self, x: i32, y: i32): bool {
        self.left_button_down = true

        let window_id = self.mouse_capture_window
        if window_id == 0 {
            window_id = self.window_at_point(x, y)
        }

        if window_id != 0 {
            self.set_focus(window_id)

            let window = self.get_window(window_id)
            if window != null {
                window.is_pressed = true
            }

            self.send_message(window_id, WindowMessage::LEFT_DOWN, x, y, 0)
            return true
        }

        return false
    }

    fn handle_left_up(&self, x: i32, y: i32): bool {
        self.left_button_down = false

        let window_id = self.mouse_capture_window
        if window_id == 0 {
            window_id = self.window_at_point(x, y)
        }

        if window_id != 0 {
            let window = self.get_window(window_id)
            let was_pressed = false
            if window != null {
                was_pressed = window.is_pressed
                window.is_pressed = false
            }

            self.send_message(window_id, WindowMessage::LEFT_UP, x, y, 0)

            // Generate click if button was pressed
            if was_pressed {
                self.send_message(window_id, WindowMessage::LEFT_CLICK, x, y, 0)
            }

            return true
        }

        return false
    }

    fn handle_right_down(&self, x: i32, y: i32): bool {
        self.right_button_down = true

        let window_id = self.mouse_capture_window
        if window_id == 0 {
            window_id = self.window_at_point(x, y)
        }

        if window_id != 0 {
            self.send_message(window_id, WindowMessage::RIGHT_DOWN, x, y, 0)
            return true
        }

        return false
    }

    fn handle_right_up(&self, x: i32, y: i32): bool {
        self.right_button_down = false

        let window_id = self.mouse_capture_window
        if window_id == 0 {
            window_id = self.window_at_point(x, y)
        }

        if window_id != 0 {
            self.send_message(window_id, WindowMessage::RIGHT_UP, x, y, 0)
            self.send_message(window_id, WindowMessage::RIGHT_CLICK, x, y, 0)
            return true
        }

        return false
    }

    fn handle_mouse_wheel(&self, x: i32, y: i32, delta: i32): bool {
        let window_id = self.window_at_point(x, y)

        if window_id != 0 {
            let message = WindowMessage::WHEEL_DOWN
            if delta > 0 {
                message = WindowMessage::WHEEL_UP
            }
            let abs_delta = delta
            if abs_delta < 0 {
                abs_delta = -abs_delta
            }
            self.send_message(window_id, message, x, y, abs_delta)
            return true
        }

        return false
    }

    fn handle_key_down(&self, key_code: i32): bool {
        if self.focused_window != 0 {
            self.send_message_key(self.focused_window, WindowMessage::KEY_DOWN, key_code)
            return true
        }
        return false
    }

    fn handle_key_up(&self, key_code: i32): bool {
        if self.focused_window != 0 {
            self.send_message_key(self.focused_window, WindowMessage::KEY_UP, key_code)
            return true
        }
        return false
    }

    fn handle_char(&self, c: i32): bool {
        if self.focused_window != 0 {
            self.send_message_char(self.focused_window, WindowMessage::CHAR_TYPED, c)
            return true
        }
        return false
    }

    // ========================================================================
    // Hit Testing
    // ========================================================================

    fn window_at_point(&self, x: i32, y: i32): i32 {
        // Check modal first
        if self.modal_stack.length > 0 {
            let modal_id = self.modal_stack[self.modal_stack.length - 1].window_id
            return self.hit_test_recursive(modal_id, x, y)
        }

        // Check active root
        if self.active_root != 0 {
            return self.hit_test_recursive(self.active_root, x, y)
        }

        return 0
    }

    fn hit_test_recursive(&self, window_id: i32, x: i32, y: i32): i32 {
        let window = self.get_window(window_id)
        if window == null {
            return 0
        }

        if window.is_hidden || !window.is_enabled {
            return 0
        }

        if !window.contains_point(x, y) {
            return 0
        }

        // Check children (reverse order for z-order)
        let child_count = window.children.length
        for i in 0..child_count {
            let child_idx = child_count - 1 - i
            let child_id = window.children[child_idx]
            let result = self.hit_test_recursive(child_id, x, y)
            if result != 0 {
                return result
            }
        }

        // Check if this window accepts input (NoInput flag = bit 4)
        if !window.get_status_flag(4) {
            return window_id
        }

        return 0
    }

    // ========================================================================
    // Message Sending
    // ========================================================================

    fn send_message(&self, window_id: i32, message: WindowMessage, x: i32, y: i32, data: i32): bool {
        // In a full implementation, this would dispatch to callbacks
        return true
    }

    fn send_message_key(&self, window_id: i32, message: WindowMessage, key_code: i32): bool {
        // In a full implementation, this would dispatch to callbacks
        return true
    }

    fn send_message_char(&self, window_id: i32, message: WindowMessage, c: i32): bool {
        // In a full implementation, this would dispatch to callbacks
        return true
    }

    // ========================================================================
    // Update
    // ========================================================================

    fn update(&self, delta_time: f32) {
        // Update transitions
        self.update_transition(delta_time)

        // Update tooltip
        if self.tooltip_target != 0 {
            self.tooltip_delay_timer = self.tooltip_delay_timer + delta_time * 1000.0  // Convert to ms

            if self.tooltip_delay_timer >= 500.0 {
                // Show tooltip
                let target = self.get_window(self.tooltip_target)
                if target != null && target.tooltip_text != "" {
                    self.show_tooltip(target.tooltip_text, self.last_mouse_x + 15, self.last_mouse_y + 15)
                }
            }
        }

        // Send update message to all visible windows
        for i in 0..self.windows.length {
            if self.windows[i].is_valid && !self.windows[i].is_hidden {
                self.send_message(self.windows[i].id, WindowMessage::SYSTEM_UPDATE, 0, 0, 0)
            }
        }
    }

    fn show_tooltip(&self, text: string, x: i32, y: i32) {
        let tooltip = self.get_window(self.tooltip_window)
        if tooltip != null {
            tooltip.set_text(text)
            tooltip.set_rect(x, y, 200, 30)
            tooltip.set_hidden(false)
        }
    }

    fn hide_tooltip(&self) {
        let tooltip = self.get_window(self.tooltip_window)
        if tooltip != null {
            tooltip.set_hidden(true)
        }
    }

    // ========================================================================
    // Rendering Helpers
    // ========================================================================

    fn get_visible_windows(&self): [i32] {
        let result: [i32] = []

        // Add active root and its children
        if self.active_root != 0 {
            self.collect_visible_recursive(self.active_root, result)
        }

        // Add modals
        for i in 0..self.modal_stack.length {
            self.collect_visible_recursive(self.modal_stack[i].window_id, result)
        }

        // Add tooltip
        let tooltip = self.get_window(self.tooltip_window)
        if tooltip != null && !tooltip.is_hidden {
            result = result + [self.tooltip_window]
        }

        return result
    }

    fn collect_visible_recursive(&self, window_id: i32, result: [i32]) {
        let window = self.get_window(window_id)
        if window == null || window.is_hidden {
            return
        }

        result = result + [window_id]

        for i in 0..window.children.length {
            self.collect_visible_recursive(window.children[i], result)
        }
    }

    fn set_screen_size(&self, width: i32, height: i32) {
        self.screen_width = width
        self.screen_height = height
    }

    fn get_focused_window(&self): i32 {
        return self.focused_window
    }

    fn get_active_root(&self): i32 {
        return self.active_root
    }
}

// ============================================================================
// GLOBAL WINDOW MANAGER INSTANCE
// ============================================================================

let g_window_manager: WindowManager? = null

fn init_window_manager(width: i32, height: i32): WindowManager {
    let manager = WindowManager::init(width, height)
    g_window_manager = manager
    return manager
}

fn get_window_manager(): WindowManager? {
    return g_window_manager
}

fn shutdown_window_manager() {
    g_window_manager = null
}
