// GameSpy Peer - Peer-to-peer connections for multiplayer
// Handles NAT traversal, peer state, and direct connections

// ============================================================================
// Configuration
// ============================================================================

struct GameSpyPeerConfig {
    stun_server: string,
    stun_port: i32,
    relay_server: string,
    relay_port: i32,
    connection_timeout: f32,
    keepalive_interval: f32,
    nat_punch_attempts: i32,
    nat_punch_interval: f32,
    max_peers: i32,
    enable_upnp: bool,
    enable_nat_pmp: bool,
    enable_relay_fallback: bool,
    direct_connect_timeout: f32,
}

impl GameSpyPeerConfig {
    fn init(): GameSpyPeerConfig {
        return GameSpyPeerConfig {
            stun_server: "stun.gamespy.com",
            stun_port: 3478,
            relay_server: "relay.gamespy.com",
            relay_port: 6500,
            connection_timeout: 30.0,
            keepalive_interval: 10.0,
            nat_punch_attempts: 10,
            nat_punch_interval: 0.5,
            max_peers: 8,
            enable_upnp: true,
            enable_nat_pmp: true,
            enable_relay_fallback: true,
            direct_connect_timeout: 5.0,
        }
    }
}

// ============================================================================
// NAT Types
// ============================================================================

enum NATType {
    UNKNOWN,
    OPEN,                   // No NAT
    FULL_CONE,              // Easy to traverse
    RESTRICTED_CONE,        // Moderate difficulty
    PORT_RESTRICTED_CONE,   // Harder
    SYMMETRIC,              // Hardest, may need relay
}

enum ConnectionMethod {
    DIRECT,       // Direct P2P connection
    NAT_PUNCH,    // NAT hole punching
    UPNP,         // UPnP port mapping
    NAT_PMP,      // NAT-PMP port mapping
    RELAY,        // Relay server fallback
}

// ============================================================================
// Peer State
// ============================================================================

enum PeerState {
    DISCONNECTED,
    DISCOVERING,    // Discovering NAT type
    CONNECTING,     // Attempting connection
    NAT_TRAVERSAL,  // NAT punch in progress
    CONNECTED,
    RELAYED,        // Connected via relay
    FAILED,
}

struct PeerEndpoint {
    public_ip: string,
    public_port: i32,
    private_ip: string,
    private_port: i32,
    is_valid: bool,
}

impl PeerEndpoint {
    fn init(): PeerEndpoint {
        return PeerEndpoint {
            public_ip: "",
            public_port: 0,
            private_ip: "",
            private_port: 0,
            is_valid: false,
        }
    }
}

struct Peer {
    peer_id: i64,
    profile_id: i64,
    nickname: string,
    state: PeerState,
    nat_type: NATType,
    endpoint: PeerEndpoint,
    connection_method: ConnectionMethod,

    // Connection timing
    connect_start_time: f32,
    last_activity_time: f32,
    round_trip_time: f32,
    rtt_samples: [f32],
    rtt_sample_count: i32,

    // NAT traversal
    punch_attempts: i32,
    punch_timer: f32,

    // Relay
    relay_session_id: i64,
    is_relay_host: bool,

    // Statistics
    packets_sent: i64,
    packets_received: i64,
    bytes_sent: i64,
    bytes_received: i64,
    packet_loss: f32,
}

impl Peer {
    fn init(peer_id: i64, profile_id: i64, nickname: string): Peer {
        let samples: [f32] = []
        for i in 0..10 {
            samples = samples + [0.0]
        }
        return Peer {
            peer_id: peer_id,
            profile_id: profile_id,
            nickname: nickname,
            state: PeerState::DISCONNECTED,
            nat_type: NATType::UNKNOWN,
            endpoint: PeerEndpoint::init(),
            connection_method: ConnectionMethod::DIRECT,
            connect_start_time: 0.0,
            last_activity_time: 0.0,
            round_trip_time: 0.0,
            rtt_samples: samples,
            rtt_sample_count: 0,
            punch_attempts: 0,
            punch_timer: 0.0,
            relay_session_id: 0,
            is_relay_host: false,
            packets_sent: 0,
            packets_received: 0,
            bytes_sent: 0,
            bytes_received: 0,
            packet_loss: 0.0,
        }
    }
}

// ============================================================================
// STUN Protocol
// ============================================================================

enum STUNRequestType {
    BINDING_REQUEST,
    BINDING_RESPONSE,
    BINDING_ERROR,
}

struct STUNRequest {
    request_id: i64,
    transaction_id: [i32],  // 12 bytes
    request_type: STUNRequestType,
    send_time: f32,
    response_received: bool,
}

impl STUNRequest {
    fn init(request_id: i64): STUNRequest {
        let txn_id: [i32] = []
        // Generate random transaction ID
        for i in 0..12 {
            let val = ((request_id * 1103515245 + i * 12345) & 0xFF)
            txn_id = txn_id + [val]
        }
        return STUNRequest {
            request_id: request_id,
            transaction_id: txn_id,
            request_type: STUNRequestType::BINDING_REQUEST,
            send_time: 0.0,
            response_received: false,
        }
    }
}

struct STUNResponse {
    transaction_id: [i32],  // 12 bytes
    mapped_address: PeerEndpoint,
    changed_address: PeerEndpoint,
    source_address: PeerEndpoint,
    is_valid: bool,
}

impl STUNResponse {
    fn init(): STUNResponse {
        let txn_id: [i32] = []
        for i in 0..12 {
            txn_id = txn_id + [0]
        }
        return STUNResponse {
            transaction_id: txn_id,
            mapped_address: PeerEndpoint::init(),
            changed_address: PeerEndpoint::init(),
            source_address: PeerEndpoint::init(),
            is_valid: false,
        }
    }
}

fn serialize_stun_request(request: STUNRequest): [i32] {
    let buffer: [i32] = []

    // STUN header
    // Message type: Binding Request (0x0001)
    buffer = buffer + [0x00]
    buffer = buffer + [0x01]

    // Message length: 0 (no attributes for basic request)
    buffer = buffer + [0x00]
    buffer = buffer + [0x00]

    // Magic cookie: 0x2112A442
    buffer = buffer + [0x21]
    buffer = buffer + [0x12]
    buffer = buffer + [0xA4]
    buffer = buffer + [0x42]

    // Transaction ID (12 bytes)
    for i in 0..12 {
        buffer = buffer + [request.transaction_id[i]]
    }

    return buffer
}

fn parse_stun_response(data: [i32], size: i32): STUNResponse {
    let response = STUNResponse::init()

    if size < 20 {
        return response
    }

    // Check message type (Binding Response: 0x0101)
    if data[0] != 0x01 || data[1] != 0x01 {
        return response
    }

    // Check magic cookie
    if data[4] != 0x21 || data[5] != 0x12 || data[6] != 0xA4 || data[7] != 0x42 {
        return response
    }

    // Copy transaction ID
    for i in 0..12 {
        response.transaction_id[i] = data[8 + i]
    }

    // Parse attributes
    let offset = 20
    let msg_length = (data[2] << 8) | data[3]

    while offset < 20 + msg_length && offset + 4 <= size {
        let attr_type = (data[offset] << 8) | data[offset + 1]
        let attr_length = (data[offset + 2] << 8) | data[offset + 3]
        offset = offset + 4

        if attr_type == 0x0001 || attr_type == 0x0020 {
            // MAPPED-ADDRESS or XOR-MAPPED-ADDRESS
            if attr_length >= 8 && offset + 8 <= size {
                let family = data[offset + 1]
                if family == 0x01 {  // IPv4
                    let port = (data[offset + 2] << 8) | data[offset + 3]
                    let ip_a = data[offset + 4]
                    let ip_b = data[offset + 5]
                    let ip_c = data[offset + 6]
                    let ip_d = data[offset + 7]

                    // XOR with magic cookie if XOR-MAPPED-ADDRESS
                    let final_port = port
                    let final_a = ip_a
                    let final_b = ip_b
                    let final_c = ip_c
                    let final_d = ip_d

                    if attr_type == 0x0020 {
                        final_port = port ^ 0x2112
                        final_a = ip_a ^ 0x21
                        final_b = ip_b ^ 0x12
                        final_c = ip_c ^ 0xA4
                        final_d = ip_d ^ 0x42
                    }

                    response.mapped_address.public_ip = str(final_a) + "." +
                                                        str(final_b) + "." +
                                                        str(final_c) + "." +
                                                        str(final_d)
                    response.mapped_address.public_port = final_port
                    response.mapped_address.is_valid = true
                }
            }
        }

        // Move to next attribute (with padding)
        offset = offset + ((attr_length + 3) & ~3)
    }

    response.is_valid = response.mapped_address.is_valid
    return response
}

// ============================================================================
// NAT Detection
// ============================================================================

enum NATDetectionState {
    IDLE,
    DETECTING,
    COMPLETE,
    FAILED,
}

struct NATDetector {
    state: NATDetectionState,
    detected_type: NATType,
    public_endpoint: PeerEndpoint,
    local_endpoint: PeerEndpoint,

    // STUN requests
    pending_requests: [STUNRequest],
    pending_count: i32,
    next_request_id: i64,

    // Detection phases
    phase: i32,
    phase_timer: f32,
    responses: [STUNResponse],
    response_count: i32,
}

impl NATDetector {
    fn init(): NATDetector {
        let requests: [STUNRequest] = []
        let resps: [STUNResponse] = []
        for i in 0..4 {
            requests = requests + [STUNRequest::init(0)]
            resps = resps + [STUNResponse::init()]
        }
        return NATDetector {
            state: NATDetectionState::IDLE,
            detected_type: NATType::UNKNOWN,
            public_endpoint: PeerEndpoint::init(),
            local_endpoint: PeerEndpoint::init(),
            pending_requests: requests,
            pending_count: 0,
            next_request_id: 1,
            phase: 0,
            phase_timer: 0.0,
            responses: resps,
            response_count: 0,
        }
    }

    fn start(&self) {
        self.state = NATDetectionState::DETECTING
        self.phase = 1
        self.phase_timer = 0.0
        self.response_count = 0
        self.pending_count = 0
    }

    fn update(&self, delta_time: f32) {
        if self.state != NATDetectionState::DETECTING {
            return
        }

        self.phase_timer = self.phase_timer + delta_time

        // Phase timeout
        if self.phase_timer > 3.0 {
            self.advance_phase()
        }
    }

    fn advance_phase(&self) {
        if self.phase == 1 {
            // Phase 1: Basic STUN request
            if self.response_count >= 1 {
                self.public_endpoint = self.responses[0].mapped_address
                self.phase = 2
                self.phase_timer = 0.0
            } else {
                // No response - might be behind strict firewall
                self.detected_type = NATType::SYMMETRIC
                self.state = NATDetectionState::COMPLETE
            }
        } else if self.phase == 2 {
            // Phase 2: Request from different server
            if self.response_count >= 2 {
                // Compare mapped addresses
                if self.responses[0].mapped_address.public_port ==
                   self.responses[1].mapped_address.public_port {
                    // Same external port - likely cone NAT
                    self.phase = 3
                    self.phase_timer = 0.0
                } else {
                    // Different ports - symmetric NAT
                    self.detected_type = NATType::SYMMETRIC
                    self.state = NATDetectionState::COMPLETE
                }
            } else {
                self.detected_type = NATType::PORT_RESTRICTED_CONE
                self.state = NATDetectionState::COMPLETE
            }
        } else if self.phase == 3 {
            // Phase 3: Determine cone type
            if self.response_count >= 3 {
                self.detected_type = NATType::FULL_CONE
            } else {
                self.detected_type = NATType::RESTRICTED_CONE
            }
            self.state = NATDetectionState::COMPLETE
        } else {
            self.state = NATDetectionState::COMPLETE
        }
    }

    fn process_response(&self, response: STUNResponse) {
        if !response.is_valid || self.response_count >= 4 {
            return
        }

        // Verify transaction ID matches a pending request
        for i in 0..self.pending_count {
            let matches = true
            for j in 0..12 {
                if self.pending_requests[i].transaction_id[j] != response.transaction_id[j] {
                    matches = false
                    break
                }
            }

            if matches {
                self.pending_requests[i].response_received = true
                self.responses[self.response_count] = response
                self.response_count = self.response_count + 1
                break
            }
        }
    }
}

// ============================================================================
// NAT Punch
// ============================================================================

enum NATPunchState {
    IDLE,
    EXCHANGING,     // Exchanging endpoints via server
    PUNCHING,       // Sending punch packets
    CONFIRMING,     // Confirming connection
    SUCCESS,
    FAILED,
}

struct NATPunchSession {
    session_id: i64,
    local_peer_id: i64,
    remote_peer_id: i64,
    state: NATPunchState,

    // Endpoints
    local_endpoint: PeerEndpoint,
    remote_endpoint: PeerEndpoint,

    // Timing
    start_time: f32,
    last_punch_time: f32,
    punch_count: i32,
    max_punches: i32,
    punch_interval: f32,

    // Results
    success: bool,
    established_endpoint: PeerEndpoint,
}

impl NATPunchSession {
    fn init(session_id: i64, local_peer_id: i64, remote_peer_id: i64): NATPunchSession {
        return NATPunchSession {
            session_id: session_id,
            local_peer_id: local_peer_id,
            remote_peer_id: remote_peer_id,
            state: NATPunchState::IDLE,
            local_endpoint: PeerEndpoint::init(),
            remote_endpoint: PeerEndpoint::init(),
            start_time: 0.0,
            last_punch_time: 0.0,
            punch_count: 0,
            max_punches: 10,
            punch_interval: 0.5,
            success: false,
            established_endpoint: PeerEndpoint::init(),
        }
    }

    fn start(&self, local_ep: PeerEndpoint, remote_ep: PeerEndpoint, current_time: f32) {
        self.local_endpoint = local_ep
        self.remote_endpoint = remote_ep
        self.state = NATPunchState::PUNCHING
        self.start_time = current_time
        self.punch_count = 0
    }

    fn update(&self, current_time: f32): bool {
        if self.state != NATPunchState::PUNCHING {
            return false
        }

        let elapsed = current_time - self.last_punch_time
        if elapsed >= self.punch_interval {
            self.last_punch_time = current_time
            self.punch_count = self.punch_count + 1

            if self.punch_count >= self.max_punches {
                self.state = NATPunchState::FAILED
                return false
            }

            // Would send punch packet here
            return true  // Send punch
        }

        return false
    }

    fn receive_response(&self) {
        if self.state == NATPunchState::PUNCHING {
            self.state = NATPunchState::CONFIRMING
        } else if self.state == NATPunchState::CONFIRMING {
            self.state = NATPunchState::SUCCESS
            self.success = true
            self.established_endpoint = self.remote_endpoint
        }
    }
}

// ============================================================================
// UPnP Port Mapping
// ============================================================================

struct UPnPMapping {
    internal_port: i32,
    external_port: i32,
    protocol: string,
    description: string,
    lease_duration: i32,
    is_active: bool,
}

impl UPnPMapping {
    fn init(): UPnPMapping {
        return UPnPMapping {
            internal_port: 0,
            external_port: 0,
            protocol: "",
            description: "",
            lease_duration: 0,
            is_active: false,
        }
    }
}

struct UPnPManager {
    gateway_ip: string,
    control_url: string,
    is_available: bool,
    mappings: [UPnPMapping],
    mapping_count: i32,
}

impl UPnPManager {
    fn init(): UPnPManager {
        let maps: [UPnPMapping] = []
        for i in 0..8 {
            maps = maps + [UPnPMapping::init()]
        }
        return UPnPManager {
            gateway_ip: "",
            control_url: "",
            is_available: false,
            mappings: maps,
            mapping_count: 0,
        }
    }

    fn discover_gateway(&self): bool {
        // Would send SSDP discovery here
        // M-SEARCH * HTTP/1.1
        // HOST: 239.255.255.250:1900
        // MAN: "ssdp:discover"
        // MX: 3
        // ST: urn:schemas-upnp-org:device:InternetGatewayDevice:1

        // Simulate discovery
        self.is_available = true
        self.gateway_ip = "192.168.1.1"
        self.control_url = "/ctl/IPConn"

        return self.is_available
    }

    fn add_port_mapping(&self, internal_port: i32, external_port: i32, protocol: string, description: string): bool {
        if !self.is_available || self.mapping_count >= 8 {
            return false
        }

        // Would send AddPortMapping SOAP request here

        self.mappings[self.mapping_count] = UPnPMapping {
            internal_port: internal_port,
            external_port: external_port,
            protocol: protocol,
            description: description,
            lease_duration: 3600,
            is_active: true,
        }
        self.mapping_count = self.mapping_count + 1

        return true
    }

    fn remove_port_mapping(&self, external_port: i32, protocol: string): bool {
        for i in 0..self.mapping_count {
            if self.mappings[i].external_port == external_port && self.mappings[i].protocol == protocol {
                self.mappings[i].is_active = false

                // Would send DeletePortMapping SOAP request here

                // Compact array
                for j in i..(self.mapping_count - 1) {
                    self.mappings[j] = self.mappings[j + 1]
                }
                self.mapping_count = self.mapping_count - 1

                return true
            }
        }

        return false
    }
}

// ============================================================================
// Relay Connection
// ============================================================================

struct RelaySession {
    session_id: i64,
    relay_server: string,
    relay_port: i32,
    is_connected: bool,
    is_host: bool,
    client_ids: [i64],
    client_count: i32,
    bandwidth_limit: i32,
    bytes_relayed: i64,
}

impl RelaySession {
    fn init(session_id: i64, server: string, port: i32): RelaySession {
        let ids: [i64] = []
        for i in 0..8 {
            ids = ids + [0]
        }
        return RelaySession {
            session_id: session_id,
            relay_server: server,
            relay_port: port,
            is_connected: false,
            is_host: false,
            client_ids: ids,
            client_count: 0,
            bandwidth_limit: 65536,  // 64 KB/s default
            bytes_relayed: 0,
        }
    }
}

// ============================================================================
// Peer Storage (replaces HashMap)
// ============================================================================

struct PeerStorage {
    peers: [Peer?],
    peer_ids: [i64],
    count: i32,
    capacity: i32,
}

impl PeerStorage {
    fn init(): PeerStorage {
        return PeerStorage {
            peers: [],
            peer_ids: [],
            count: 0,
            capacity: 16,
        }
    }

    fn get(&self, peer_id: i64): Peer? {
        for i in 0..self.count {
            if self.peer_ids[i] == peer_id {
                return self.peers[i]
            }
        }
        return null
    }

    fn insert(&self, peer_id: i64, peer: Peer) {
        // Check if exists
        for i in 0..self.count {
            if self.peer_ids[i] == peer_id {
                self.peers[i] = peer
                return
            }
        }

        // Add new
        if self.count < self.capacity {
            self.peers = self.peers + [peer]
            self.peer_ids = self.peer_ids + [peer_id]
            self.count = self.count + 1
        }
    }

    fn remove(&self, peer_id: i64) {
        for i in 0..self.count {
            if self.peer_ids[i] == peer_id {
                // Shift remaining
                for j in i..(self.count - 1) {
                    self.peers[j] = self.peers[j + 1]
                    self.peer_ids[j] = self.peer_ids[j + 1]
                }
                self.count = self.count - 1
                return
            }
        }
    }
}

// ============================================================================
// GameSpy Peer Manager
// ============================================================================

struct GameSpyPeerManager {
    config: GameSpyPeerConfig,
    local_peer_id: i64,
    local_profile_id: i64,

    // NAT detection
    nat_detector: NATDetector,
    local_nat_type: NATType,
    local_endpoint: PeerEndpoint,

    // UPnP
    upnp: UPnPManager,

    // Peers
    peers: PeerStorage,
    peer_count: i32,

    // NAT punch sessions
    punch_sessions: [NATPunchSession],
    punch_session_count: i32,
    next_punch_session_id: i64,

    // Relay
    relay_session: RelaySession,

    // Timing
    current_time: f32,
    keepalive_timer: f32,
}

impl GameSpyPeerManager {
    fn init(config: GameSpyPeerConfig): GameSpyPeerManager {
        let sessions: [NATPunchSession] = []
        for i in 0..16 {
            sessions = sessions + [NATPunchSession::init(0, 0, 0)]
        }
        return GameSpyPeerManager {
            config: config,
            local_peer_id: 0,
            local_profile_id: 0,
            nat_detector: NATDetector::init(),
            local_nat_type: NATType::UNKNOWN,
            local_endpoint: PeerEndpoint::init(),
            upnp: UPnPManager::init(),
            peers: PeerStorage::init(),
            peer_count: 0,
            punch_sessions: sessions,
            punch_session_count: 0,
            next_punch_session_id: 1,
            relay_session: RelaySession::init(0, "", 0),
            current_time: 0.0,
            keepalive_timer: 0.0,
        }
    }

    fn initialize(&self, local_peer_id: i64, profile_id: i64) {
        self.local_peer_id = local_peer_id
        self.local_profile_id = profile_id

        // Start NAT detection
        self.nat_detector.start()

        // Discover UPnP gateway
        if self.config.enable_upnp {
            self.upnp.discover_gateway()
        }
    }

    fn shutdown(&self) {
        // Disconnect all peers
        let peer_ids: [i64] = []
        for i in 0..self.peers.count {
            peer_ids = peer_ids + [self.peers.peer_ids[i]]
        }

        for i in 0..peer_ids.length {
            self.disconnect_peer(peer_ids[i], "Shutdown")
        }

        // Remove UPnP mappings
        while self.upnp.mapping_count > 0 {
            let mapping = self.upnp.mappings[0]
            self.upnp.remove_port_mapping(mapping.external_port, mapping.protocol)
        }
    }

    fn connect_to_peer(&self, remote_peer_id: i64, remote_profile_id: i64, nickname: string, remote_endpoint: PeerEndpoint): bool {
        if self.peer_count >= self.config.max_peers {
            return false
        }

        // Create peer
        let peer = Peer::init(remote_peer_id, remote_profile_id, nickname)
        peer.endpoint = remote_endpoint
        peer.state = PeerState::CONNECTING
        peer.connect_start_time = self.current_time

        self.peers.insert(remote_peer_id, peer)
        self.peer_count = self.peer_count + 1

        // Determine connection method
        let method = self.determine_connection_method(remote_endpoint)

        if method == ConnectionMethod::DIRECT {
            self.attempt_direct_connection(remote_peer_id)
        } else if method == ConnectionMethod::NAT_PUNCH {
            self.start_nat_punch_to_peer(remote_peer_id, remote_endpoint)
        } else if method == ConnectionMethod::UPNP {
            // UPnP mapping should already be set up
            self.attempt_direct_connection(remote_peer_id)
        } else if method == ConnectionMethod::RELAY {
            self.connect_via_relay(remote_peer_id)
        } else {
            self.attempt_direct_connection(remote_peer_id)
        }

        return true
    }

    fn disconnect_peer(&self, peer_id: i64, reason: string) {
        let peer = self.peers.get(peer_id)
        if peer == null {
            return
        }

        // Cancel any active punch sessions
        for i in 0..self.punch_session_count {
            if self.punch_sessions[i].remote_peer_id == peer_id {
                self.punch_sessions[i].state = NATPunchState::FAILED
            }
        }

        self.peers.remove(peer_id)
        self.peer_count = self.peer_count - 1
    }

    fn determine_connection_method(&self, remote_endpoint: PeerEndpoint): ConnectionMethod {
        // If we have open NAT or UPnP, try direct
        if self.local_nat_type == NATType::OPEN {
            return ConnectionMethod::DIRECT
        }

        if self.upnp.is_available && self.upnp.mapping_count > 0 {
            return ConnectionMethod::UPNP
        }

        // If both sides have cone NAT, try punch
        if self.local_nat_type != NATType::SYMMETRIC {
            return ConnectionMethod::NAT_PUNCH
        }

        // Fallback to relay
        if self.config.enable_relay_fallback {
            return ConnectionMethod::RELAY
        }

        return ConnectionMethod::NAT_PUNCH
    }

    fn attempt_direct_connection(&self, peer_id: i64) {
        let peer = self.peers.get(peer_id)
        if peer == null {
            return
        }

        peer.state = PeerState::CONNECTING
        peer.connection_method = ConnectionMethod::DIRECT

        // Would send connection request packet here
    }

    fn start_nat_punch_to_peer(&self, peer_id: i64, remote_endpoint: PeerEndpoint) {
        if self.punch_session_count >= 16 {
            return
        }

        let session_id = self.next_punch_session_id
        self.next_punch_session_id = self.next_punch_session_id + 1

        let session = NATPunchSession::init(session_id, self.local_peer_id, peer_id)
        session.start(self.local_endpoint, remote_endpoint, self.current_time)

        self.punch_sessions[self.punch_session_count] = session
        self.punch_session_count = self.punch_session_count + 1

        let peer = self.peers.get(peer_id)
        if peer != null {
            peer.state = PeerState::NAT_TRAVERSAL
            peer.connection_method = ConnectionMethod::NAT_PUNCH
        }
    }

    fn connect_via_relay(&self, peer_id: i64) {
        let peer = self.peers.get(peer_id)
        if peer == null {
            return
        }

        peer.state = PeerState::CONNECTING
        peer.connection_method = ConnectionMethod::RELAY

        // Connect to relay server if not already
        if !self.relay_session.is_connected {
            self.relay_session = RelaySession::init(
                self.next_punch_session_id,
                self.config.relay_server,
                self.config.relay_port
            )
            self.next_punch_session_id = self.next_punch_session_id + 1
            self.relay_session.is_connected = true
        }
    }

    fn update(&self, delta_time: f32) {
        self.current_time = self.current_time + delta_time

        // Update NAT detection
        self.nat_detector.update(delta_time)
        if self.nat_detector.state == NATDetectionState::COMPLETE {
            if self.local_nat_type != self.nat_detector.detected_type {
                self.local_nat_type = self.nat_detector.detected_type
                self.local_endpoint = self.nat_detector.public_endpoint
            }
        }

        // Update NAT punch sessions
        self.update_punch_sessions()

        // Update peer connections
        self.update_peer_connections(delta_time)

        // Keepalive
        self.keepalive_timer = self.keepalive_timer + delta_time
        if self.keepalive_timer >= self.config.keepalive_interval {
            self.keepalive_timer = 0.0
            self.send_keepalives()
        }
    }

    fn update_punch_sessions(&self) {
        let i = 0
        while i < self.punch_session_count {
            let session = self.punch_sessions[i]

            let should_punch = session.update(self.current_time)

            if should_punch {
                // Would send punch packet here
                let _punch_placeholder = 0
            }

            if session.state == NATPunchState::SUCCESS {
                // Connection established via punch
                let peer = self.peers.get(session.remote_peer_id)
                if peer != null {
                    peer.state = PeerState::CONNECTED
                    peer.endpoint = session.established_endpoint
                }

                // Remove session
                for j in i..(self.punch_session_count - 1) {
                    self.punch_sessions[j] = self.punch_sessions[j + 1]
                }
                self.punch_session_count = self.punch_session_count - 1
                continue
            }

            if session.state == NATPunchState::FAILED {
                // Try relay fallback
                if self.config.enable_relay_fallback {
                    self.connect_via_relay(session.remote_peer_id)
                }

                // Remove session
                for j in i..(self.punch_session_count - 1) {
                    self.punch_sessions[j] = self.punch_sessions[j + 1]
                }
                self.punch_session_count = self.punch_session_count - 1
                continue
            }

            i = i + 1
        }
    }

    fn update_peer_connections(&self, delta_time: f32) {
        for i in 0..self.peers.count {
            let peer = self.peers.peers[i]
            if peer == null {
                continue
            }

            if peer.state == PeerState::CONNECTING {
                let elapsed = self.current_time - peer.connect_start_time
                if elapsed > self.config.connection_timeout {
                    peer.state = PeerState::FAILED
                }
            } else if peer.state == PeerState::CONNECTED {
                // Check for timeout
                let idle_time = self.current_time - peer.last_activity_time
                if idle_time > self.config.connection_timeout {
                    peer.state = PeerState::DISCONNECTED
                }
            }
        }
    }

    fn send_keepalives(&self) {
        for i in 0..self.peers.count {
            let peer = self.peers.peers[i]
            if peer == null {
                continue
            }
            if peer.state == PeerState::CONNECTED || peer.state == PeerState::RELAYED {
                // Would send keepalive packet here
                peer.packets_sent = peer.packets_sent + 1
            }
        }
    }

    fn update_peer_rtt(&self, peer_id: i64, rtt: f32) {
        let peer = self.peers.get(peer_id)
        if peer == null {
            return
        }

        // Add to samples
        if peer.rtt_sample_count < 10 {
            peer.rtt_samples[peer.rtt_sample_count] = rtt
            peer.rtt_sample_count = peer.rtt_sample_count + 1
        } else {
            // Shift samples
            for i in 0..9 {
                peer.rtt_samples[i] = peer.rtt_samples[i + 1]
            }
            peer.rtt_samples[9] = rtt
        }

        // Calculate average
        let sum: f32 = 0.0
        for i in 0..peer.rtt_sample_count {
            sum = sum + peer.rtt_samples[i]
        }
        peer.round_trip_time = sum / peer.rtt_sample_count
    }
}

// ============================================================================
// Statistics
// ============================================================================

struct PeerStats {
    peer_id: i64,
    state: PeerState,
    connection_method: ConnectionMethod,
    round_trip_time: f32,
    packet_loss: f32,
    bytes_sent: i64,
    bytes_received: i64,
}

fn get_peer_stats(manager: GameSpyPeerManager, peer_id: i64): PeerStats {
    let peer = manager.peers.get(peer_id)
    if peer == null {
        return PeerStats {
            peer_id: peer_id,
            state: PeerState::DISCONNECTED,
            connection_method: ConnectionMethod::DIRECT,
            round_trip_time: 0.0,
            packet_loss: 0.0,
            bytes_sent: 0,
            bytes_received: 0,
        }
    }

    return PeerStats {
        peer_id: peer.peer_id,
        state: peer.state,
        connection_method: peer.connection_method,
        round_trip_time: peer.round_trip_time,
        packet_loss: peer.packet_loss,
        bytes_sent: peer.bytes_sent,
        bytes_received: peer.bytes_received,
    }
}

// ============================================================================
// Global Instance
// ============================================================================

let g_peer_manager: GameSpyPeerManager? = null

fn init_peer_manager(config: GameSpyPeerConfig): GameSpyPeerManager {
    let manager = GameSpyPeerManager::init(config)
    g_peer_manager = manager
    return manager
}

fn get_peer_manager(): GameSpyPeerManager? {
    return g_peer_manager
}

fn shutdown_peer_manager() {
    if g_peer_manager != null {
        g_peer_manager.shutdown()
        g_peer_manager = null
    }
}

// ============================================================================
// Tests
// ============================================================================

fn test_gamespy_peer() {
    print("Testing GameSpy Peer...")

    // Create manager
    let config = GameSpyPeerConfig::init()
    let manager = GameSpyPeerManager::init(config)
    print("  Created peer manager")

    // Initialize
    manager.initialize(1001, 12345)
    print("  Initialized with peer ID 1001")

    // Update to complete NAT detection
    for i in 0..10 {
        manager.update(0.5)
    }
    print("  NAT detection complete")

    // Test STUN request
    let stun_req = STUNRequest::init(1)
    let stun_data = serialize_stun_request(stun_req)
    print("  Created STUN request, size: " + str(stun_data.length) + " bytes")

    // Test UPnP
    if manager.upnp.is_available {
        manager.upnp.add_port_mapping(6112, 6112, "UDP", "Generals")
        print("  Added UPnP mapping")
    }

    // Test peer connection
    let remote_ep = PeerEndpoint {
        public_ip: "192.168.1.100",
        public_port: 6112,
        private_ip: "192.168.1.100",
        private_port: 6112,
        is_valid: true,
    }

    manager.connect_to_peer(2001, 67890, "RemotePlayer", remote_ep)
    print("  Started connection to peer 2001")

    // Update
    for i in 0..5 {
        manager.update(0.1)
    }

    // Get stats
    let stats = get_peer_stats(manager, 2001)
    print("  Got peer stats")

    // Shutdown
    manager.shutdown()
    print("  Shutdown complete")

    print("GameSpy Peer tests complete!")
}
