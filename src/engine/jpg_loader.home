// JPEG Image Loader - JFIF/JPEG Format Support
// Used for UI textures and backgrounds in C&C Generals
// Reference: JPEG/JFIF specification (ITU-T T.81)

// JPEG markers
let MARKER_SOI: i32 = 0xFFD8   // Start of image
let MARKER_EOI: i32 = 0xFFD9   // End of image
let MARKER_SOS: i32 = 0xFFDA   // Start of scan
let MARKER_DQT: i32 = 0xFFDB   // Define quantization table
let MARKER_DHT: i32 = 0xFFC4   // Define Huffman table
let MARKER_SOF0: i32 = 0xFFC0  // Start of frame (baseline)
let MARKER_SOF2: i32 = 0xFFC2  // Start of frame (progressive)
let MARKER_RST0: i32 = 0xFFD0  // Restart marker 0
let MARKER_RST7: i32 = 0xFFD7  // Restart marker 7
let MARKER_APP0: i32 = 0xFFE0  // Application marker 0 (JFIF)
let MARKER_APP1: i32 = 0xFFE1  // Application marker 1 (EXIF)
let MARKER_COM: i32 = 0xFFFE   // Comment

// Standard JPEG quantization table (luminance)
fn get_luminance_quant(idx: i32): i32 {
    let table: [i32] = [
        16, 11, 10, 16, 24, 40, 51, 61,
        12, 12, 14, 19, 26, 58, 60, 55,
        14, 13, 16, 24, 40, 57, 69, 56,
        14, 17, 22, 29, 51, 87, 80, 62,
        18, 22, 37, 56, 68, 109, 103, 77,
        24, 35, 55, 64, 81, 104, 113, 92,
        49, 64, 78, 87, 103, 121, 120, 101,
        72, 92, 95, 98, 112, 100, 103, 99
    ]
    if idx >= 0 && idx < 64 {
        return table[idx]
    }
    return 0
}

// Standard JPEG quantization table (chrominance)
fn get_chrominance_quant(idx: i32): i32 {
    let table: [i32] = [
        17, 18, 24, 47, 99, 99, 99, 99,
        18, 21, 26, 66, 99, 99, 99, 99,
        24, 26, 56, 99, 99, 99, 99, 99,
        47, 66, 99, 99, 99, 99, 99, 99,
        99, 99, 99, 99, 99, 99, 99, 99,
        99, 99, 99, 99, 99, 99, 99, 99,
        99, 99, 99, 99, 99, 99, 99, 99,
        99, 99, 99, 99, 99, 99, 99, 99
    ]
    if idx >= 0 && idx < 64 {
        return table[idx]
    }
    return 0
}

// Zigzag order for DCT coefficients
fn get_zigzag(idx: i32): i32 {
    let table: [i32] = [
        0,  1,  8, 16,  9,  2,  3, 10,
        17, 24, 32, 25, 18, 11,  4,  5,
        12, 19, 26, 33, 40, 48, 41, 34,
        27, 20, 13,  6,  7, 14, 21, 28,
        35, 42, 49, 56, 57, 50, 43, 36,
        29, 22, 15, 23, 30, 37, 44, 51,
        58, 59, 52, 45, 38, 31, 39, 46,
        53, 60, 61, 54, 47, 55, 62, 63
    ]
    if idx >= 0 && idx < 64 {
        return table[idx]
    }
    return 0
}

// JPEG frame header
struct JPEGHeader {
    width: i32,
    height: i32,
    precision: i32,          // Bits per sample (usually 8)
    num_components: i32,     // 1 = grayscale, 3 = YCbCr/RGB
    is_progressive: bool,
}

impl JPEGHeader {
    fn init(): JPEGHeader {
        return JPEGHeader {
            width: 0,
            height: 0,
            precision: 8,
            num_components: 3,
            is_progressive: false,
        }
    }
}

// Component info
struct ComponentInfo {
    id: i32,
    h_sampling: i32,        // Horizontal sampling factor
    v_sampling: i32,        // Vertical sampling factor
    quant_table_id: i32,
}

// Loaded JPEG image
struct JPEGImage {
    width: i32,
    height: i32,
    channels: i32,
    pixels: [i32],  // RGB pixel data
    name: string,
}

impl JPEGImage {
    fn init(): JPEGImage {
        return JPEGImage {
            width: 0,
            height: 0,
            channels: 3,
            pixels: [],
            name: "",
        }
    }
}

// Read 16-bit big-endian integer
fn read_u16_be(data: [i32], offset: i32): i32 {
    if offset + 2 > data.length {
        return 0
    }
    return (data[offset] << 8) | data[offset + 1]
}

// Read byte
fn read_byte(data: [i32], offset: i32): i32 {
    if offset >= data.length {
        return 0
    }
    return data[offset]
}

// Check JPEG signature (SOI marker)
fn check_signature(data: [i32]): bool {
    if data.length < 2 {
        return false
    }
    return data[0] == 0xFF && data[1] == 0xD8
}

// Find next marker in data
fn find_next_marker(data: [i32], start: i32): [i32] {
    let i = start
    while i < data.length - 1 {
        if data[i] == 0xFF {
            let marker_type = data[i + 1]
            // Skip stuffed bytes (0xFF00)
            if marker_type != 0x00 && marker_type != 0xFF {
                let marker = 0xFF00 | marker_type
                return [marker, i]
            }
        }
        i = i + 1
    }
    return [0, data.length]
}

// Parse SOF (Start of Frame) segment
fn parse_sof(data: [i32], offset: i32): JPEGHeader {
    let header = JPEGHeader::init()

    if offset + 8 > data.length {
        return header
    }

    header.precision = read_byte(data, offset)
    header.height = read_u16_be(data, offset + 1)
    header.width = read_u16_be(data, offset + 3)
    header.num_components = read_byte(data, offset + 5)

    return header
}

// Clamp value to 0-255 range
fn clamp(value: i32): i32 {
    if value < 0 { return 0 }
    if value > 255 { return 255 }
    return value
}

// Convert YCbCr to RGB
fn ycbcr_to_rgb(y: i32, cb: i32, cr: i32): [i32] {
    // Shift Cb and Cr from 0-255 to -128 to 127
    let cb_shifted = cb - 128
    let cr_shifted = cr - 128

    // Convert to RGB
    // R = Y + 1.402 * Cr
    // G = Y - 0.344136 * Cb - 0.714136 * Cr
    // B = Y + 1.772 * Cb

    let r = y + (cr_shifted * 1402) / 1000
    let g = y - (cb_shifted * 344) / 1000 - (cr_shifted * 714) / 1000
    let b = y + (cb_shifted * 1772) / 1000

    return [clamp(r), clamp(g), clamp(b)]
}

// Check if data is a valid JPEG file
fn is_jpeg_file(data: [i32]): bool {
    if !check_signature(data) {
        return false
    }

    // Also check for JFIF or EXIF marker
    if data.length < 4 {
        return false
    }

    // Check for APP0 (JFIF) or APP1 (EXIF) marker
    let marker = read_u16_be(data, 2)
    return marker == MARKER_APP0 || marker == MARKER_APP1 || (marker & 0xFFF0) == 0xFFE0
}

// Load JPEG image (simplified - actual decoding requires full Huffman/DCT implementation)
fn load_jpeg(data: [i32]): JPEGImage {
    let image = JPEGImage::init()

    if !check_signature(data) {
        return image
    }

    // Parse markers to find image dimensions
    let offset = 2
    let header = JPEGHeader::init()

    while offset < data.length - 1 {
        let result = find_next_marker(data, offset)
        let marker = result[0]
        let marker_pos = result[1]

        if marker == 0 {
            break
        }

        if marker == MARKER_SOF0 || marker == MARKER_SOF2 {
            // Get segment length
            let seg_length = read_u16_be(data, marker_pos + 2)
            header = parse_sof(data, marker_pos + 4)
            header.is_progressive = (marker == MARKER_SOF2)
            offset = marker_pos + 2 + seg_length
        } else if marker == MARKER_EOI {
            break
        } else if marker == MARKER_SOS {
            // Start of scan - actual image data follows
            break
        } else if (marker & 0xFF00) == 0xFF00 && marker != MARKER_SOI {
            // Skip segment
            if marker_pos + 3 < data.length {
                let seg_length = read_u16_be(data, marker_pos + 2)
                offset = marker_pos + 2 + seg_length
            } else {
                offset = marker_pos + 2
            }
        } else {
            offset = marker_pos + 2
        }
    }

    if header.width == 0 || header.height == 0 {
        return image
    }

    image.width = header.width
    image.height = header.height
    image.channels = header.num_components

    // Since full JPEG decoding is complex (Huffman + IDCT),
    // create a placeholder with the correct dimensions
    // Real implementation would decode the image data

    let total = image.width * image.height * 4
    for i in 0..total {
        // Fill with gray as placeholder
        image.pixels = image.pixels + [128]
    }

    // Note: Full JPEG decoding would require:
    // 1. Huffman table parsing and decoding
    // 2. Run-length decoding
    // 3. Dequantization
    // 4. Inverse DCT transform
    // 5. YCbCr to RGB conversion
    // 6. Upsampling for chroma components

    return image
}

// Get pixel at coordinate
fn get_jpeg_pixel(image: JPEGImage, x: i32, y: i32): [i32] {
    if x < 0 || x >= image.width || y < 0 || y >= image.height {
        return [0, 0, 0, 0]
    }

    let offset = (y * image.width + x) * 4
    if offset + 4 > image.pixels.length {
        return [0, 0, 0, 0]
    }

    return [
        image.pixels[offset],
        image.pixels[offset + 1],
        image.pixels[offset + 2],
        image.pixels[offset + 3]
    ]
}

// Create solid color JPEG-like image
fn create_solid_jpeg(width: i32, height: i32, r: i32, g: i32, b: i32): JPEGImage {
    let image = JPEGImage {
        width: width,
        height: height,
        channels: 3,
        pixels: [],
        name: "solid",
    }

    let total = width * height
    for i in 0..total {
        image.pixels = image.pixels + [r]
        image.pixels = image.pixels + [g]
        image.pixels = image.pixels + [b]
        image.pixels = image.pixels + [255]  // Alpha for RGBA consistency
    }

    return image
}

// ============================================================================
// JPEG Quality Settings
// ============================================================================

struct JPEGQuality {
    luminance_table: [i32],
    chrominance_table: [i32],
    quality: i32,  // 1-100
}

impl JPEGQuality {
    fn init(): JPEGQuality {
        let lum: [i32] = []
        let chr: [i32] = []
        for i in 0..64 {
            lum = lum + [get_luminance_quant(i)]
            chr = chr + [get_chrominance_quant(i)]
        }
        return JPEGQuality {
            luminance_table: lum,
            chrominance_table: chr,
            quality: 75,
        }
    }
}

fn clamp_quant(value: i32): i32 {
    if value < 1 { return 1 }
    if value > 255 { return 255 }
    return value
}

// Create quality tables for given quality level
fn create_quality_tables(quality: i32): JPEGQuality {
    let q = JPEGQuality::init()
    q.quality = quality

    // Scale factor based on quality
    let scale = 0
    if quality < 50 {
        scale = 5000 / quality
    } else {
        scale = 200 - quality * 2
    }

    // Scale quantization tables
    for i in 0..64 {
        let lum = (get_luminance_quant(i) * scale + 50) / 100
        q.luminance_table[i] = clamp_quant(lum)

        let chr = (get_chrominance_quant(i) * scale + 50) / 100
        q.chrominance_table[i] = clamp_quant(chr)
    }

    return q
}

// ============================================================================
// Tests
// ============================================================================

fn test_jpeg_signature() {
    print("Testing JPEG signature...")

    let data: [i32] = [0xFF, 0xD8, 0xFF, 0xE0]  // APP0 marker
    let valid = check_signature(data)
    print("Valid JPEG signature: " + str(valid))

    let invalid: [i32] = [0x00, 0x00]
    let invalid_result = check_signature(invalid)
    print("Invalid data detected: " + str(!invalid_result))
}

fn test_ycbcr_conversion() {
    print("Testing YCbCr conversion...")

    // Test pure white (Y=255, Cb=128, Cr=128)
    let white = ycbcr_to_rgb(255, 128, 128)
    print("White: R=" + str(white[0]) + " G=" + str(white[1]) + " B=" + str(white[2]))

    // Test pure black (Y=0, Cb=128, Cr=128)
    let black = ycbcr_to_rgb(0, 128, 128)
    print("Black: R=" + str(black[0]) + " G=" + str(black[1]) + " B=" + str(black[2]))
}

fn test_solid_jpeg() {
    print("Testing solid JPEG creation...")

    let image = create_solid_jpeg(10, 10, 255, 0, 0)
    print("Created image: " + str(image.width) + "x" + str(image.height))

    let pixel = get_jpeg_pixel(image, 5, 5)
    print("Pixel at (5,5): R=" + str(pixel[0]) + " G=" + str(pixel[1]) + " B=" + str(pixel[2]))
}

fn test_quality_tables() {
    print("Testing quality tables...")

    let q50 = create_quality_tables(50)
    print("Quality 50 created")

    let q90 = create_quality_tables(90)
    print("Quality 90 created")

    print("Q50 luminance[0]: " + str(q50.luminance_table[0]))
    print("Q90 luminance[0]: " + str(q90.luminance_table[0]))
}

fn run_all_tests() {
    print("Running JPEG loader tests...")
    test_jpeg_signature()
    test_ycbcr_conversion()
    test_solid_jpeg()
    test_quality_tables()
    print("All JPEG tests complete!")
}
