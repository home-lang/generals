// UDP Transport - UDP socket implementation
// Platform-specific UDP socket management with non-blocking I/O

// ============================================================================
// Configuration
// ============================================================================

struct UDPConfig {
    bind_port: i32,                       // 0 = any available port
    bind_address: string,                 // Bind to all interfaces
    recv_buffer_size: i32,
    send_buffer_size: i32,
    non_blocking: bool,
    reuse_address: bool,
    broadcast: bool,
    multicast_ttl: i32,
}

impl UDPConfig {
    fn init(): UDPConfig {
        return UDPConfig {
            bind_port: 0,
            bind_address: "0.0.0.0",
            recv_buffer_size: 65536,
            send_buffer_size: 65536,
            non_blocking: true,
            reuse_address: true,
            broadcast: false,
            multicast_ttl: 1,
        }
    }
}

// ============================================================================
// Socket State
// ============================================================================

enum SocketState {
    Closed,
    Binding,
    Bound,
    Error,
}

struct SocketError {
    code: i32,
    message: string,
}

impl SocketError {
    fn init(): SocketError {
        return SocketError { code: 0, message: "" }
    }
}

// ============================================================================
// Address Types
// ============================================================================

struct SocketAddress {
    ip_a: i32,
    ip_b: i32,
    ip_c: i32,
    ip_d: i32,
    port: i32,
}

impl SocketAddress {
    fn init(): SocketAddress {
        return SocketAddress {
            ip_a: 0,
            ip_b: 0,
            ip_c: 0,
            ip_d: 0,
            port: 0,
        }
    }
}

fn create_socket_address(a: i32, b: i32, c: i32, d: i32, port: i32): SocketAddress {
    return SocketAddress {
        ip_a: a,
        ip_b: b,
        ip_c: c,
        ip_d: d,
        port: port,
    }
}

fn address_to_string(addr: SocketAddress): string {
    return str(addr.ip_a) + "." + str(addr.ip_b) + "." + str(addr.ip_c) + "." + str(addr.ip_d)
}

fn parse_address(ip_string: string): SocketAddress {
    // Simple IP parser (assumes valid format: "a.b.c.d")
    let addr = SocketAddress::init()

    let current_value = 0
    let component = 0

    for i in 0..ip_string.length {
        let c = ip_string.char_at(i)
        if c == "." {
            if component == 0 {
                addr.ip_a = current_value
            } else if component == 1 {
                addr.ip_b = current_value
            } else if component == 2 {
                addr.ip_c = current_value
            }
            current_value = 0
            component = component + 1
        } else if c >= "0" && c <= "9" {
            current_value = current_value * 10 + (c as i32 - 48)  // '0' = 48
        }
    }

    // Last component
    addr.ip_d = current_value

    return addr
}

fn addresses_equal(a: SocketAddress, b: SocketAddress): bool {
    return a.ip_a == b.ip_a &&
           a.ip_b == b.ip_b &&
           a.ip_c == b.ip_c &&
           a.ip_d == b.ip_d &&
           a.port == b.port
}

// ============================================================================
// Packet Queue
// ============================================================================

let MAX_PACKET_SIZE: i32 = 1500
let MAX_QUEUE_SIZE: i32 = 256

struct UDPPacket {
    address: SocketAddress,
    data: [i32],
    size: i32,
    timestamp: f32,
    is_valid: bool,
}

impl UDPPacket {
    fn init(): UDPPacket {
        let data: [i32] = []
        for i in 0..MAX_PACKET_SIZE {
            data = data + [0]
        }
        return UDPPacket {
            address: SocketAddress::init(),
            data: data,
            size: 0,
            timestamp: 0.0,
            is_valid: false,
        }
    }
}

// ============================================================================
// UDP Socket
// ============================================================================

struct UDPSocket {
    socket_handle: i64,                   // Platform socket handle
    config: UDPConfig,
    state: SocketState,
    last_error: SocketError,
    local_address: SocketAddress,

    // Receive queue
    recv_queue: [UDPPacket],
    recv_queue_head: i32,
    recv_queue_tail: i32,
    recv_queue_count: i32,

    // Send queue
    send_queue: [UDPPacket],
    send_queue_head: i32,
    send_queue_tail: i32,
    send_queue_count: i32,

    // Statistics
    packets_sent: i64,
    packets_received: i64,
    bytes_sent: i64,
    bytes_received: i64,
    send_errors: i64,
    recv_errors: i64,
}

impl UDPSocket {
    fn init(config: UDPConfig): UDPSocket {
        let recv_q: [UDPPacket] = []
        let send_q: [UDPPacket] = []
        for i in 0..MAX_QUEUE_SIZE {
            recv_q = recv_q + [UDPPacket::init()]
            send_q = send_q + [UDPPacket::init()]
        }
        return UDPSocket {
            socket_handle: -1,
            config: config,
            state: SocketState::Closed,
            last_error: SocketError::init(),
            local_address: SocketAddress::init(),
            recv_queue: recv_q,
            recv_queue_head: 0,
            recv_queue_tail: 0,
            recv_queue_count: 0,
            send_queue: send_q,
            send_queue_head: 0,
            send_queue_tail: 0,
            send_queue_count: 0,
            packets_sent: 0,
            packets_received: 0,
            bytes_sent: 0,
            bytes_received: 0,
            send_errors: 0,
            recv_errors: 0,
        }
    }

    // ========================================================================
    // Socket Operations
    // ========================================================================

    fn open(&self): bool {
        if self.state != SocketState::Closed {
            return false
        }

        // Platform-specific socket creation would go here
        // For now, simulate success
        self.socket_handle = next_socket_handle()
        self.state = SocketState::Binding

        return true
    }

    fn bind(&self): bool {
        if self.state != SocketState::Binding {
            return false
        }

        let addr = parse_address(self.config.bind_address)
        self.local_address = addr
        if self.config.bind_port == 0 {
            self.local_address.port = allocate_ephemeral_port()
        } else {
            self.local_address.port = self.config.bind_port
        }

        // Platform-specific bind would go here
        self.state = SocketState::Bound

        return true
    }

    fn close(&self) {
        if self.state == SocketState::Closed {
            return
        }

        // Platform-specific close would go here
        self.socket_handle = -1
        self.state = SocketState::Closed

        // Clear queues
        self.recv_queue_count = 0
        self.send_queue_count = 0
    }

    fn set_non_blocking(&self, non_blocking: bool): bool {
        if self.state == SocketState::Closed {
            return false
        }

        self.config.non_blocking = non_blocking
        // Platform-specific ioctl/fcntl would go here
        return true
    }

    fn set_broadcast(&self, broadcast: bool): bool {
        if self.state == SocketState::Closed {
            return false
        }

        self.config.broadcast = broadcast
        // Platform-specific setsockopt would go here
        return true
    }

    // ========================================================================
    // Send/Receive
    // ========================================================================

    fn send_to(&self, address: SocketAddress, data: [i32], size: i32): i32 {
        if self.state != SocketState::Bound {
            return -1
        }

        // Queue the packet for sending
        if self.send_queue_count >= MAX_QUEUE_SIZE {
            self.send_errors = self.send_errors + 1
            return -1  // Queue full
        }

        let idx = self.send_queue_tail
        self.send_queue[idx].address = address
        for i in 0..size {
            if i < MAX_PACKET_SIZE {
                self.send_queue[idx].data[i] = data[i]
            }
        }
        self.send_queue[idx].size = size
        self.send_queue[idx].is_valid = true

        self.send_queue_tail = (self.send_queue_tail + 1) % MAX_QUEUE_SIZE
        self.send_queue_count = self.send_queue_count + 1

        return size
    }

    fn recv_from(&self, out_address: SocketAddress, out_data: [i32]): i32 {
        if self.state != SocketState::Bound {
            return -1
        }

        if self.recv_queue_count == 0 {
            return 0  // No data available (non-blocking)
        }

        let idx = self.recv_queue_head
        let packet = self.recv_queue[idx]

        if !packet.is_valid {
            return 0
        }

        out_address.ip_a = packet.address.ip_a
        out_address.ip_b = packet.address.ip_b
        out_address.ip_c = packet.address.ip_c
        out_address.ip_d = packet.address.ip_d
        out_address.port = packet.address.port

        for i in 0..packet.size {
            out_data[i] = packet.data[i]
        }
        let size = packet.size

        self.recv_queue[idx].is_valid = false
        self.recv_queue_head = (self.recv_queue_head + 1) % MAX_QUEUE_SIZE
        self.recv_queue_count = self.recv_queue_count - 1

        return size
    }

    fn poll(&self, timeout_ms: i32): i32 {
        if self.state != SocketState::Bound {
            return -1
        }

        // Platform-specific poll/select would go here
        // Returns: -1 on error, 0 on timeout, >0 if data available

        // Simulate: return number of packets in receive queue
        return self.recv_queue_count
    }

    // ========================================================================
    // Internal Queue Simulation (for testing without actual sockets)
    // ========================================================================

    fn inject_packet(&self, address: SocketAddress, data: [i32], size: i32) {
        // For testing: inject a packet into the receive queue
        if self.recv_queue_count >= MAX_QUEUE_SIZE {
            return
        }

        let idx = self.recv_queue_tail
        self.recv_queue[idx].address = address
        for i in 0..size {
            if i < MAX_PACKET_SIZE {
                self.recv_queue[idx].data[i] = data[i]
            }
        }
        self.recv_queue[idx].size = size
        self.recv_queue[idx].is_valid = true

        self.recv_queue_tail = (self.recv_queue_tail + 1) % MAX_QUEUE_SIZE
        self.recv_queue_count = self.recv_queue_count + 1
        self.packets_received = self.packets_received + 1
        self.bytes_received = self.bytes_received + (size as i64)
    }

    fn flush_send_queue(&self): i32 {
        // Process all queued sends (in real implementation, this would do actual sendto)
        let count = self.send_queue_count

        while self.send_queue_count > 0 {
            let idx = self.send_queue_head
            let packet = self.send_queue[idx]

            if packet.is_valid {
                self.packets_sent = self.packets_sent + 1
                self.bytes_sent = self.bytes_sent + (packet.size as i64)
            }

            self.send_queue[idx].is_valid = false
            self.send_queue_head = (self.send_queue_head + 1) % MAX_QUEUE_SIZE
            self.send_queue_count = self.send_queue_count - 1
        }

        return count
    }

    // ========================================================================
    // Broadcast Support
    // ========================================================================

    fn send_broadcast(&self, port: i32, data: [i32], size: i32): i32 {
        if self.state != SocketState::Bound || !self.config.broadcast {
            return -1
        }

        let broadcast_addr = create_socket_address(255, 255, 255, 255, port)
        return self.send_to(broadcast_addr, data, size)
    }
}

// ============================================================================
// UDP Transport Manager
// ============================================================================

struct SocketEntry {
    socket_id: i64,
    socket: UDPSocket,
    is_active: bool,
}

impl SocketEntry {
    fn init(): SocketEntry {
        return SocketEntry {
            socket_id: 0,
            socket: UDPSocket::init(UDPConfig::init()),
            is_active: false,
        }
    }
}

let MAX_SOCKETS: i32 = 64

struct UDPTransportManager {
    sockets: [SocketEntry],
    next_socket_id: i64,
    current_time: f32,
}

impl UDPTransportManager {
    fn init(): UDPTransportManager {
        let socks: [SocketEntry] = []
        for i in 0..MAX_SOCKETS {
            socks = socks + [SocketEntry::init()]
        }
        return UDPTransportManager {
            sockets: socks,
            next_socket_id: 1,
            current_time: 0.0,
        }
    }

    fn create_socket(&self, config: UDPConfig): i64 {
        // Find free slot
        for i in 0..MAX_SOCKETS {
            if !self.sockets[i].is_active {
                let socket_id = self.next_socket_id
                self.next_socket_id = self.next_socket_id + 1

                self.sockets[i].socket_id = socket_id
                self.sockets[i].socket = UDPSocket::init(config)
                self.sockets[i].is_active = true

                return socket_id
            }
        }
        return -1  // No free slots
    }

    fn find_socket(&self, socket_id: i64): i32 {
        for i in 0..MAX_SOCKETS {
            if self.sockets[i].is_active && self.sockets[i].socket_id == socket_id {
                return i
            }
        }
        return -1
    }

    fn bind_socket(&self, socket_id: i64): bool {
        let idx = self.find_socket(socket_id)
        if idx < 0 {
            return false
        }

        let socket = self.sockets[idx].socket
        if !socket.open() {
            return false
        }

        if !socket.bind() {
            return false
        }

        return true
    }

    fn close_socket(&self, socket_id: i64) {
        let idx = self.find_socket(socket_id)
        if idx >= 0 {
            self.sockets[idx].socket.close()
            self.sockets[idx].is_active = false
        }
    }

    fn send(&self, socket_id: i64, address: SocketAddress, data: [i32], size: i32): bool {
        let idx = self.find_socket(socket_id)
        if idx < 0 {
            return false
        }

        let result = self.sockets[idx].socket.send_to(address, data, size)
        return result >= 0
    }

    fn update(&self, delta_time: f32) {
        self.current_time = self.current_time + delta_time

        for i in 0..MAX_SOCKETS {
            if !self.sockets[i].is_active {
                continue
            }

            let socket = self.sockets[i].socket

            if socket.state != SocketState::Bound {
                continue
            }

            // Flush send queue
            socket.flush_send_queue()
        }
    }
}

// ============================================================================
// Address Classification
// ============================================================================

fn is_broadcast_address(addr: SocketAddress): bool {
    return addr.ip_a == 255 && addr.ip_b == 255 && addr.ip_c == 255 && addr.ip_d == 255
}

fn is_multicast_address(addr: SocketAddress): bool {
    return addr.ip_a >= 224 && addr.ip_a <= 239
}

fn is_local_address(addr: SocketAddress): bool {
    return addr.ip_a == 127
}

fn is_private_address(addr: SocketAddress): bool {
    // 10.x.x.x
    if addr.ip_a == 10 {
        return true
    }
    // 172.16.x.x - 172.31.x.x
    if addr.ip_a == 172 && addr.ip_b >= 16 && addr.ip_b <= 31 {
        return true
    }
    // 192.168.x.x
    if addr.ip_a == 192 && addr.ip_b == 168 {
        return true
    }
    return false
}

// ============================================================================
// Helper Functions
// ============================================================================

let global_socket_handle: i64 = 1000
let global_ephemeral_port: i32 = 49152

fn next_socket_handle(): i64 {
    let handle = global_socket_handle
    global_socket_handle = global_socket_handle + 1
    return handle
}

fn allocate_ephemeral_port(): i32 {
    let port = global_ephemeral_port
    global_ephemeral_port = global_ephemeral_port + 1
    if global_ephemeral_port > 65535 {
        global_ephemeral_port = 49152
    }
    return port
}

// ============================================================================
// Socket Statistics
// ============================================================================

struct UDPStats {
    packets_sent: i64,
    packets_received: i64,
    bytes_sent: i64,
    bytes_received: i64,
    send_errors: i64,
    recv_errors: i64,
    queue_full_drops: i64,
}

impl UDPStats {
    fn init(): UDPStats {
        return UDPStats {
            packets_sent: 0,
            packets_received: 0,
            bytes_sent: 0,
            bytes_received: 0,
            send_errors: 0,
            recv_errors: 0,
            queue_full_drops: 0,
        }
    }
}

fn get_socket_stats(socket: UDPSocket): UDPStats {
    return UDPStats {
        packets_sent: socket.packets_sent,
        packets_received: socket.packets_received,
        bytes_sent: socket.bytes_sent,
        bytes_received: socket.bytes_received,
        send_errors: socket.send_errors,
        recv_errors: socket.recv_errors,
        queue_full_drops: 0,
    }
}

// ============================================================================
// Pre-built Configurations
// ============================================================================

fn create_default_udp_config(): UDPConfig {
    return UDPConfig::init()
}

fn create_server_udp_config(port: i32): UDPConfig {
    return UDPConfig {
        bind_port: port,
        bind_address: "0.0.0.0",
        recv_buffer_size: 131072,
        send_buffer_size: 131072,
        non_blocking: true,
        reuse_address: true,
        broadcast: false,
        multicast_ttl: 1,
    }
}

fn create_client_udp_config(): UDPConfig {
    return UDPConfig {
        bind_port: 0,                         // Any port
        bind_address: "0.0.0.0",
        recv_buffer_size: 65536,
        send_buffer_size: 65536,
        non_blocking: true,
        reuse_address: false,
        broadcast: false,
        multicast_ttl: 1,
    }
}

fn create_lan_discovery_config(): UDPConfig {
    return UDPConfig {
        bind_port: 0,
        bind_address: "0.0.0.0",
        recv_buffer_size: 8192,
        send_buffer_size: 8192,
        non_blocking: true,
        reuse_address: true,
        broadcast: true,
        multicast_ttl: 1,
    }
}

// ============================================================================
// Tests
// ============================================================================

fn test_udp_transport() {
    print("Testing UDP Transport...")

    // Test address parsing
    let addr = parse_address("192.168.1.100")
    print("  Parsed address: " + address_to_string(addr))

    // Test socket creation
    let config = create_default_udp_config()
    let socket = UDPSocket::init(config)
    print("  Created socket")

    // Open and bind
    socket.open()
    socket.bind()
    print("  Bound socket to port: " + str(socket.local_address.port))

    // Test send
    let dest_addr = create_socket_address(192, 168, 1, 1, 8080)
    let test_data: [i32] = [1, 2, 3, 4, 5]
    let sent = socket.send_to(dest_addr, test_data, 5)
    print("  Queued " + str(sent) + " bytes")

    // Flush send queue
    let flushed = socket.flush_send_queue()
    print("  Flushed " + str(flushed) + " packets")

    // Test receive (inject test packet)
    let src_addr = create_socket_address(10, 0, 0, 1, 12345)
    let recv_data: [i32] = [10, 20, 30, 40, 50, 60, 70, 80]
    socket.inject_packet(src_addr, recv_data, 8)

    let out_addr = SocketAddress::init()
    let out_data: [i32] = []
    for i in 0..MAX_PACKET_SIZE {
        out_data = out_data + [0]
    }
    let received = socket.recv_from(out_addr, out_data)
    print("  Received " + str(received) + " bytes from " + address_to_string(out_addr))

    // Test manager
    let manager = UDPTransportManager::init()
    let socket_id = manager.create_socket(create_server_udp_config(9999))
    manager.bind_socket(socket_id)
    print("  Manager created socket: " + str(socket_id))

    // Test address classification
    let private_addr = create_socket_address(192, 168, 0, 1, 80)
    let local_addr = create_socket_address(127, 0, 0, 1, 80)
    let broadcast = create_socket_address(255, 255, 255, 255, 80)

    print("  192.168.0.1 is private: " + str(is_private_address(private_addr)))
    print("  127.0.0.1 is local: " + str(is_local_address(local_addr)))
    print("  255.255.255.255 is broadcast: " + str(is_broadcast_address(broadcast)))

    // Close
    socket.close()
    print("  Socket closed")

    print("UDP Transport tests complete!")
}
