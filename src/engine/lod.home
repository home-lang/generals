// C&C Generals Zero Hour - Home Port
// Level of Detail (LOD) System
//
// Original: GameLOD.cpp/.h (EA Games)
// Ported to Home with EA's static and dynamic LOD architecture
//
// EA's LOD system:
// - Static LOD: User-configured quality settings (Low/Medium/High/Very High/Custom)
// - Dynamic LOD: Auto-adjusts based on current FPS to maintain target framerate
// - Settings affect: particles, shadows, textures, audio, visual effects
//
// LOD adjusts:
// - Max particle count
// - Shadow quality (volumetric vs decals)
// - Texture resolution
// - Audio channels
// - Visual effects (tree sway, cloud maps, water effects)
// - Tank track length
// - Building scaffolds

// Static LOD levels (user-configurable presets)
enum StaticLODLevel {
    LOW,         // Minimum quality for low-end systems
    MEDIUM,      // Balanced quality/performance
    HIGH,        // High quality for modern systems
    VERY_HIGH,   // Maximum quality
    CUSTOM,      // User-defined custom settings
}

// Dynamic LOD levels (runtime FPS-based adjustment)
enum DynamicLODLevel {
    LOW,         // < 20 FPS - aggressive culling
    MEDIUM,      // 20-40 FPS - moderate quality
    HIGH,        // 40-50 FPS - good quality
    VERY_HIGH,   // 50+ FPS - maximum quality
}

// Particle priority (determines which particles get culled first)
enum ParticlePriority {
    VERY_LOW,    // Dust, minor debris
    LOW,         // Small explosions, muzzle flashes
    MEDIUM,      // Unit effects, smoke
    HIGH,        // Important explosions, special effects
    CRITICAL,    // Never cull (nuclear explosion, superweapon)
}

// Static LOD configuration
struct StaticLODConfig {
    // Performance targets
    min_fps: i32,                        // Minimum FPS for this level
    min_processor_fps: i32,              // Minimum CPU time

    // Audio
    audio_samples_2d: i32,               // UI sound channels
    audio_samples_3d: i32,               // World sound channels
    audio_stream_count: i32,             // Music/voice streams

    // Particles
    max_particle_count: i32,             // Maximum active particles

    // Shadows
    use_shadow_volumes: bool,            // 3D volumetric shadows
    use_shadow_decals: bool,             // 2D decal shadows

    // Visual effects
    use_cloud_map: bool,                 // Cloud shadows on terrain
    use_light_map: bool,                 // Terrain detail lighting
    show_soft_water_edge: bool,          // Water edge feathering
    use_tree_sway: bool,                 // Wind effect on trees
    use_emissive_night_materials: bool,  // Night building lighting
    use_buildup_scaffolds: bool,         // Construction scaffolding

    // Tank tracks
    max_tank_track_edges: i32,           // Track segments
    max_tank_track_opaque_edges: i32,    // Fully visible segments
    max_tank_track_fade_delay: i32,      // Fade time (frames)

    // Textures
    texture_reduction: i32,              // Mip level reduction (0-3)

    // Performance
    use_fps_limit: bool,                 // Cap FPS to target
    enable_dynamic_lod: bool,            // Enable dynamic adjustments
    use_trees: bool,                     // Render trees
}

impl StaticLODConfig {
    fn init(level: StaticLODLevel): StaticLODConfig {
        if level == StaticLODLevel::LOW {
            return StaticLODConfig {
                min_fps: 30,
                min_processor_fps: 15,
                audio_samples_2d: 8,
                audio_samples_3d: 8,
                audio_stream_count: 1,
                max_particle_count: 1000,
                use_shadow_volumes: false,
                use_shadow_decals: true,
                use_cloud_map: false,
                use_light_map: false,
                show_soft_water_edge: false,
                use_tree_sway: false,
                use_emissive_night_materials: false,
                use_buildup_scaffolds: false,
                max_tank_track_edges: 50,
                max_tank_track_opaque_edges: 25,
                max_tank_track_fade_delay: 180,
                texture_reduction: 2,
                use_fps_limit: true,
                enable_dynamic_lod: true,
                use_trees: true,
            }
        } else if level == StaticLODLevel::MEDIUM {
            return StaticLODConfig {
                min_fps: 40,
                min_processor_fps: 20,
                audio_samples_2d: 16,
                audio_samples_3d: 16,
                audio_stream_count: 2,
                max_particle_count: 2500,
                use_shadow_volumes: false,
                use_shadow_decals: true,
                use_cloud_map: true,
                use_light_map: true,
                show_soft_water_edge: false,
                use_tree_sway: true,
                use_emissive_night_materials: true,
                use_buildup_scaffolds: true,
                max_tank_track_edges: 100,
                max_tank_track_opaque_edges: 50,
                max_tank_track_fade_delay: 300,
                texture_reduction: 1,
                use_fps_limit: false,
                enable_dynamic_lod: true,
                use_trees: true,
            }
        } else if level == StaticLODLevel::HIGH {
            return StaticLODConfig {
                min_fps: 50,
                min_processor_fps: 25,
                audio_samples_2d: 24,
                audio_samples_3d: 24,
                audio_stream_count: 3,
                max_particle_count: 5000,
                use_shadow_volumes: true,
                use_shadow_decals: false,
                use_cloud_map: true,
                use_light_map: true,
                show_soft_water_edge: true,
                use_tree_sway: true,
                use_emissive_night_materials: true,
                use_buildup_scaffolds: true,
                max_tank_track_edges: 200,
                max_tank_track_opaque_edges: 100,
                max_tank_track_fade_delay: 450,
                texture_reduction: 0,
                use_fps_limit: false,
                enable_dynamic_lod: false,
                use_trees: true,
            }
        } else if level == StaticLODLevel::VERY_HIGH {
            return StaticLODConfig {
                min_fps: 60,
                min_processor_fps: 30,
                audio_samples_2d: 32,
                audio_samples_3d: 32,
                audio_stream_count: 4,
                max_particle_count: 8000,
                use_shadow_volumes: true,
                use_shadow_decals: false,
                use_cloud_map: true,
                use_light_map: true,
                show_soft_water_edge: true,
                use_tree_sway: true,
                use_emissive_night_materials: true,
                use_buildup_scaffolds: true,
                max_tank_track_edges: 300,
                max_tank_track_opaque_edges: 150,
                max_tank_track_fade_delay: 600,
                texture_reduction: 0,
                use_fps_limit: false,
                enable_dynamic_lod: false,
                use_trees: true,
            }
        }
        // Default to medium
        return StaticLODConfig::init(StaticLODLevel::MEDIUM)
    }
}

// Dynamic LOD configuration (FPS-based)
struct DynamicLODConfig {
    min_fps: i32,                            // FPS threshold for this level
    particle_skip_mask: i32,                 // Render every Nth particle (mask)
    debris_skip_mask: i32,                   // Render every Nth debris
    slow_death_scale: f32,                   // Death animation speed (< 1.0 = faster)
    min_particle_priority: ParticlePriority, // Cull particles below this priority
    min_particle_skip_priority: ParticlePriority, // Never skip above this priority
}

impl DynamicLODConfig {
    fn init(level: DynamicLODLevel): DynamicLODConfig {
        if level == DynamicLODLevel::LOW {
            return DynamicLODConfig {
                min_fps: 20,
                particle_skip_mask: 0x3,        // Render 1/4 particles
                debris_skip_mask: 0x7,          // Render 1/8 debris
                slow_death_scale: 0.5,          // 2x faster deaths
                min_particle_priority: ParticlePriority::HIGH,
                min_particle_skip_priority: ParticlePriority::CRITICAL,
            }
        } else if level == DynamicLODLevel::MEDIUM {
            return DynamicLODConfig {
                min_fps: 40,
                particle_skip_mask: 0x1,        // Render 1/2 particles
                debris_skip_mask: 0x3,          // Render 1/4 debris
                slow_death_scale: 0.75,
                min_particle_priority: ParticlePriority::MEDIUM,
                min_particle_skip_priority: ParticlePriority::HIGH,
            }
        } else if level == DynamicLODLevel::HIGH {
            return DynamicLODConfig {
                min_fps: 50,
                particle_skip_mask: 0x0,        // Render all particles
                debris_skip_mask: 0x1,          // Render 1/2 debris
                slow_death_scale: 1.0,
                min_particle_priority: ParticlePriority::LOW,
                min_particle_skip_priority: ParticlePriority::MEDIUM,
            }
        }
        // Default: VERY_HIGH
        return DynamicLODConfig {
            min_fps: 60,
            particle_skip_mask: 0x0,        // Render all
            debris_skip_mask: 0x0,          // Render all
            slow_death_scale: 1.0,
            min_particle_priority: ParticlePriority::VERY_LOW,
            min_particle_skip_priority: ParticlePriority::LOW,
        }
    }
}

// LOD Manager (singleton)
struct LODManager {
    // Current LOD levels
    static_level: StaticLODLevel,
    dynamic_level: DynamicLODLevel,

    // Current configurations
    static_config: StaticLODConfig,
    dynamic_config: DynamicLODConfig,

    // Performance tracking
    average_fps: f32,
    fps_history: [f32],            // Last 60 frames
    fps_history_index: i32,

    // Dynamic adjustment counters
    particle_generation_count: i32,  // For skip mask
    debris_generation_count: i32,    // For skip mask

    // System specs (for auto-detection)
    cpu_mhz: i32,
    ram_mb: i32,
    gpu_name: string,
}

impl LODManager {
    fn init(): LODManager {
        let fps_history: [f32] = []
        for i in 0..60 {
            fps_history = fps_history + [0.0]
        }

        return LODManager {
            static_level: StaticLODLevel::MEDIUM,
            dynamic_level: DynamicLODLevel::HIGH,
            static_config: StaticLODConfig::init(StaticLODLevel::MEDIUM),
            dynamic_config: DynamicLODConfig::init(DynamicLODLevel::HIGH),
            average_fps: 60.0,
            fps_history: fps_history,
            fps_history_index: 0,
            particle_generation_count: 0,
            debris_generation_count: 0,
            cpu_mhz: 0,
            ram_mb: 0,
            gpu_name: "",
        }
    }

    fn set_static_level(&self, level: StaticLODLevel) {
        self.static_level = level
        self.static_config = StaticLODConfig::init(level)

        print("Static LOD set to: " + self.get_static_level_name())
        self.print_static_settings()
    }

    fn set_dynamic_level(&self, level: DynamicLODLevel) {
        self.dynamic_level = level
        self.dynamic_config = DynamicLODConfig::init(level)

        print("Dynamic LOD set to: " + self.get_dynamic_level_name())
    }

    fn update_fps(&self, current_fps: f32) {
        // Add to history
        self.fps_history[self.fps_history_index] = current_fps
        self.fps_history_index = (self.fps_history_index + 1) % 60

        // Calculate average FPS
        let total: f32 = 0.0
        for i in 0..60 {
            total = total + self.fps_history[i]
        }
        self.average_fps = total / 60.0

        // Auto-adjust dynamic LOD if enabled
        if self.static_config.enable_dynamic_lod {
            self.auto_adjust_dynamic_lod()
        }
    }

    fn auto_adjust_dynamic_lod(&self) {
        let target_level: DynamicLODLevel
        if self.average_fps < 20.0 {
            target_level = DynamicLODLevel::LOW
        } else if self.average_fps < 40.0 {
            target_level = DynamicLODLevel::MEDIUM
        } else if self.average_fps < 50.0 {
            target_level = DynamicLODLevel::HIGH
        } else {
            target_level = DynamicLODLevel::VERY_HIGH
        }

        if target_level != self.dynamic_level {
            print("Auto-adjusting dynamic LOD: " + str(self.average_fps) + " FPS")
            self.set_dynamic_level(target_level)
        }
    }

    fn priority_to_int(&self, priority: ParticlePriority): i32 {
        if priority == ParticlePriority::VERY_LOW {
            return 0
        } else if priority == ParticlePriority::LOW {
            return 1
        } else if priority == ParticlePriority::MEDIUM {
            return 2
        } else if priority == ParticlePriority::HIGH {
            return 3
        } else if priority == ParticlePriority::CRITICAL {
            return 4
        }
        return 0
    }

    fn should_skip_particle(&self, priority: ParticlePriority): bool {
        // Never skip critical priority
        if self.priority_to_int(priority) >= self.priority_to_int(self.dynamic_config.min_particle_skip_priority) {
            return false
        }

        // Skip if below minimum priority
        if self.priority_to_int(priority) < self.priority_to_int(self.dynamic_config.min_particle_priority) {
            return true
        }

        // Use skip mask for random culling
        self.particle_generation_count = self.particle_generation_count + 1
        return (self.particle_generation_count & self.dynamic_config.particle_skip_mask) != self.dynamic_config.particle_skip_mask
    }

    fn should_skip_debris(&self): bool {
        self.debris_generation_count = self.debris_generation_count + 1
        return (self.debris_generation_count & self.dynamic_config.debris_skip_mask) != self.dynamic_config.debris_skip_mask
    }

    fn get_death_animation_speed(&self): f32 {
        return self.dynamic_config.slow_death_scale
    }

    fn get_texture_reduction(&self): i32 {
        return self.static_config.texture_reduction
    }

    fn get_max_particle_count(&self): i32 {
        return self.static_config.max_particle_count
    }

    fn get_static_level_name(&self): string {
        if self.static_level == StaticLODLevel::LOW {
            return "Low"
        } else if self.static_level == StaticLODLevel::MEDIUM {
            return "Medium"
        } else if self.static_level == StaticLODLevel::HIGH {
            return "High"
        } else if self.static_level == StaticLODLevel::VERY_HIGH {
            return "Very High"
        } else if self.static_level == StaticLODLevel::CUSTOM {
            return "Custom"
        }
        return "Unknown"
    }

    fn get_dynamic_level_name(&self): string {
        if self.dynamic_level == DynamicLODLevel::LOW {
            return "Low"
        } else if self.dynamic_level == DynamicLODLevel::MEDIUM {
            return "Medium"
        } else if self.dynamic_level == DynamicLODLevel::HIGH {
            return "High"
        } else if self.dynamic_level == DynamicLODLevel::VERY_HIGH {
            return "Very High"
        }
        return "Unknown"
    }

    fn print_static_settings(&self) {
        print("\n=== Static LOD Settings ===")
        print("Max Particles: " + str(self.static_config.max_particle_count))
        print("Shadow Volumes: " + str(self.static_config.use_shadow_volumes))
        print("Shadow Decals: " + str(self.static_config.use_shadow_decals))
        print("Cloud Map: " + str(self.static_config.use_cloud_map))
        print("Light Map: " + str(self.static_config.use_light_map))
        print("Soft Water Edge: " + str(self.static_config.show_soft_water_edge))
        print("Tree Sway: " + str(self.static_config.use_tree_sway))
        print("Texture Reduction: " + str(self.static_config.texture_reduction))
        print("Audio 2D: " + str(self.static_config.audio_samples_2d) + " channels")
        print("Audio 3D: " + str(self.static_config.audio_samples_3d) + " channels")
        print("Dynamic LOD: " + str(self.static_config.enable_dynamic_lod))
    }

    fn print_performance_stats(&self) {
        print("\n=== Performance Stats ===")
        print("Average FPS: " + str(self.average_fps))
        print("Static LOD: " + self.get_static_level_name())
        print("Dynamic LOD: " + self.get_dynamic_level_name())
        print("Particles Generated: " + str(self.particle_generation_count))
        print("Debris Generated: " + str(self.debris_generation_count))
    }

    fn detect_system_specs(&self) {
        // TODO: Implement system detection
        // For now, use placeholder values
        self.cpu_mhz = 3000  // 3.0 GHz
        self.ram_mb = 8192   // 8 GB
        self.gpu_name = "Unknown GPU"

        print("Detected System Specs:")
        print("  CPU: " + str(self.cpu_mhz) + " MHz")
        print("  RAM: " + str(self.ram_mb) + " MB")
        print("  GPU: " + self.gpu_name)
    }

    fn recommend_static_lod(&self): StaticLODLevel {
        // Auto-detect best LOD level based on system specs
        if self.cpu_mhz < 2000 || self.ram_mb < 2048 {
            return StaticLODLevel::LOW
        } else if self.cpu_mhz < 2500 || self.ram_mb < 4096 {
            return StaticLODLevel::MEDIUM
        } else if self.cpu_mhz < 3000 || self.ram_mb < 6144 {
            return StaticLODLevel::HIGH
        }
        return StaticLODLevel::VERY_HIGH
    }
}

// ============================================================================
// GLOBAL LOD MANAGER
// ============================================================================

let g_lod_manager: LODManager? = null

fn init_lod_manager() {
    let manager = LODManager::init()

    // Detect system and set recommended LOD
    manager.detect_system_specs()

    let recommended = manager.recommend_static_lod()
    print("Recommended LOD level: " + manager.get_static_level_name())

    manager.set_static_level(recommended)
    g_lod_manager = manager
}

fn get_lod_manager(): LODManager? {
    return g_lod_manager
}

fn set_static_lod_level(level: StaticLODLevel) {
    if g_lod_manager == null {
        return
    }
    g_lod_manager.set_static_level(level)
}

fn update_lod_fps(current_fps: f32) {
    if g_lod_manager == null {
        return
    }
    g_lod_manager.update_fps(current_fps)
}

fn should_skip_particle(priority: ParticlePriority): bool {
    if g_lod_manager == null {
        return false
    }
    return g_lod_manager.should_skip_particle(priority)
}

fn should_skip_debris(): bool {
    if g_lod_manager == null {
        return false
    }
    return g_lod_manager.should_skip_debris()
}

fn get_lod_texture_reduction(): i32 {
    if g_lod_manager == null {
        return 0
    }
    return g_lod_manager.get_texture_reduction()
}

fn shutdown_lod_manager() {
    if g_lod_manager != null {
        g_lod_manager.print_performance_stats()
        g_lod_manager = null
    }
}

// ============================================================================
// MODEL LOD SYSTEM
// Distance-based and screen-size based LOD for 3D models
// Based on W3D HLOD system from original Westwood code
// ============================================================================

// Maximum LOD levels per model
let MAX_MODEL_LOD_LEVELS: i32 = 5

// Model LOD level descriptor
struct ModelLODLevel {
    level_index: i32,
    distance_min: f32,           // Minimum distance for this level
    distance_max: f32,           // Maximum distance for this level
    screen_size_min: f32,        // Minimum screen size (pixels) for this level
    screen_size_max: f32,        // Maximum screen size (pixels)
    model_name: string,          // Model asset name for this level
    is_active: bool,
}

impl ModelLODLevel {
    fn init(index: i32): ModelLODLevel {
        return ModelLODLevel {
            level_index: index,
            distance_min: 0.0,
            distance_max: 10000.0,
            screen_size_min: 0.0,
            screen_size_max: 10000.0,
            model_name: "",
            is_active: false,
        }
    }

    fn set_distance_range(&self, min: f32, max: f32) {
        self.distance_min = min
        self.distance_max = max
    }

    fn set_screen_size_range(&self, min: f32, max: f32) {
        self.screen_size_min = min
        self.screen_size_max = max
    }
}

// LOD selector mode
enum LODSelectorMode {
    DistanceBased,     // Select LOD based on camera distance
    ScreenSizeBased,   // Select LOD based on projected screen size
    Combined,          // Use both distance and screen size
}

// Model LOD configuration
struct ModelLODConfig {
    levels: [ModelLODLevel],
    level_count: i32,
    selector_mode: LODSelectorMode,

    // Transition settings
    use_smooth_transitions: bool,
    transition_duration: f32,    // Seconds for crossfade

    // Distance thresholds (for distance-based)
    lod0_max_distance: f32,      // Highest detail
    lod1_max_distance: f32,
    lod2_max_distance: f32,
    lod3_max_distance: f32,
    lod4_max_distance: f32,      // Lowest detail

    // Screen size thresholds (for screen-size based)
    lod0_min_screen_size: f32,   // Highest detail needs largest screen size
    lod1_min_screen_size: f32,
    lod2_min_screen_size: f32,
    lod3_min_screen_size: f32,
    lod4_min_screen_size: f32,   // Lowest detail
}

impl ModelLODConfig {
    fn init(): ModelLODConfig {
        let levels: [ModelLODLevel] = []
        for i in 0..MAX_MODEL_LOD_LEVELS {
            levels = levels + [ModelLODLevel::init(i)]
        }

        return ModelLODConfig {
            levels: levels,
            level_count: 0,
            selector_mode: LODSelectorMode::Combined,
            use_smooth_transitions: true,
            transition_duration: 0.25,

            // Default distance thresholds
            lod0_max_distance: 100.0,
            lod1_max_distance: 200.0,
            lod2_max_distance: 400.0,
            lod3_max_distance: 800.0,
            lod4_max_distance: 10000.0,

            // Default screen size thresholds (in pixels)
            lod0_min_screen_size: 100.0,
            lod1_min_screen_size: 50.0,
            lod2_min_screen_size: 25.0,
            lod3_min_screen_size: 10.0,
            lod4_min_screen_size: 0.0,
        }
    }

    fn add_level(&self, model_name: string): ModelLODLevel? {
        if self.level_count >= MAX_MODEL_LOD_LEVELS {
            return null
        }

        let level = self.levels[self.level_count]
        level.model_name = model_name
        level.is_active = true

        // Set default distance based on index
        if self.level_count == 0 {
            level.distance_min = 0.0
            level.distance_max = self.lod0_max_distance
            level.screen_size_min = self.lod0_min_screen_size
            level.screen_size_max = 10000.0
        } else if self.level_count == 1 {
            level.distance_min = self.lod0_max_distance
            level.distance_max = self.lod1_max_distance
            level.screen_size_min = self.lod1_min_screen_size
            level.screen_size_max = self.lod0_min_screen_size
        } else if self.level_count == 2 {
            level.distance_min = self.lod1_max_distance
            level.distance_max = self.lod2_max_distance
            level.screen_size_min = self.lod2_min_screen_size
            level.screen_size_max = self.lod1_min_screen_size
        } else if self.level_count == 3 {
            level.distance_min = self.lod2_max_distance
            level.distance_max = self.lod3_max_distance
            level.screen_size_min = self.lod3_min_screen_size
            level.screen_size_max = self.lod2_min_screen_size
        } else {
            level.distance_min = self.lod3_max_distance
            level.distance_max = self.lod4_max_distance
            level.screen_size_min = self.lod4_min_screen_size
            level.screen_size_max = self.lod3_min_screen_size
        }

        self.level_count = self.level_count + 1
        return level
    }
}

// Model LOD selector - determines which LOD to use
struct ModelLODSelector {
    config: ModelLODConfig,
    current_level: i32,
    target_level: i32,
    transition_progress: f32,    // 0.0 = current, 1.0 = target
    is_transitioning: bool,
}

impl ModelLODSelector {
    fn init(config: ModelLODConfig): ModelLODSelector {
        return ModelLODSelector {
            config: config,
            current_level: 0,
            target_level: 0,
            transition_progress: 0.0,
            is_transitioning: false,
        }
    }

    /// Calculate screen size based on world size and distance
    fn calculate_screen_size(&self, world_radius: f32, distance: f32, fov: f32, screen_height: f32): f32 {
        if distance < 0.001 {
            return screen_height  // Maximum size when very close
        }

        // Project world size to screen pixels
        // screen_size = (world_radius / distance) * screen_height / tan(fov/2)
        let half_fov = fov * 0.5
        let tan_half_fov = tan_approx(half_fov)
        if tan_half_fov < 0.001 {
            tan_half_fov = 0.001
        }

        return (world_radius / distance) * screen_height / tan_half_fov
    }

    /// Select LOD based on distance only
    fn select_by_distance(&self, distance: f32): i32 {
        for i in 0..self.config.level_count {
            let level = self.config.levels[i]
            if level.is_active && distance >= level.distance_min && distance < level.distance_max {
                return i
            }
        }
        // Default to lowest detail if nothing matches
        return self.config.level_count - 1
    }

    /// Select LOD based on screen size only
    fn select_by_screen_size(&self, screen_size: f32): i32 {
        for i in 0..self.config.level_count {
            let level = self.config.levels[i]
            if level.is_active && screen_size >= level.screen_size_min && screen_size < level.screen_size_max {
                return i
            }
        }
        // Default to lowest detail if nothing matches
        return self.config.level_count - 1
    }

    /// Select LOD using combined criteria
    fn select_combined(&self, distance: f32, screen_size: f32): i32 {
        let distance_lod = self.select_by_distance(distance)
        let screen_lod = self.select_by_screen_size(screen_size)

        // Use the higher (lower quality) LOD level
        if distance_lod > screen_lod {
            return distance_lod
        }
        return screen_lod
    }

    /// Update LOD selection
    fn update(&self, distance: f32, world_radius: f32, fov: f32, screen_height: f32, delta_time: f32) {
        // Calculate screen size
        let screen_size = self.calculate_screen_size(world_radius, distance, fov, screen_height)

        // Select target LOD based on mode
        if self.config.selector_mode == LODSelectorMode::DistanceBased {
            self.target_level = self.select_by_distance(distance)
        } else if self.config.selector_mode == LODSelectorMode::ScreenSizeBased {
            self.target_level = self.select_by_screen_size(screen_size)
        } else {
            self.target_level = self.select_combined(distance, screen_size)
        }

        // Handle transitions
        if self.target_level != self.current_level {
            if self.config.use_smooth_transitions {
                self.is_transitioning = true
                self.transition_progress = self.transition_progress + delta_time / self.config.transition_duration

                if self.transition_progress >= 1.0 {
                    self.current_level = self.target_level
                    self.transition_progress = 0.0
                    self.is_transitioning = false
                }
            } else {
                // Instant switch
                self.current_level = self.target_level
                self.transition_progress = 0.0
                self.is_transitioning = false
            }
        }
    }

    /// Get current LOD level index
    fn get_current_level(&self): i32 {
        return self.current_level
    }

    /// Get target LOD level index (for crossfade)
    fn get_target_level(&self): i32 {
        return self.target_level
    }

    /// Get transition blend factor (0.0 = full current, 1.0 = full target)
    fn get_transition_blend(&self): f32 {
        if !self.is_transitioning {
            return 0.0
        }
        return self.transition_progress
    }

    /// Get current LOD model name
    fn get_current_model_name(&self): string {
        if self.current_level >= 0 && self.current_level < self.config.level_count {
            return self.config.levels[self.current_level].model_name
        }
        return ""
    }
}

// LOD transition data for smooth crossfade
struct LODTransitionData {
    from_level: i32,
    to_level: i32,
    blend_factor: f32,      // 0.0 = from, 1.0 = to
    from_alpha: f32,        // Fade out
    to_alpha: f32,          // Fade in
}

impl LODTransitionData {
    fn init(): LODTransitionData {
        return LODTransitionData {
            from_level: 0,
            to_level: 0,
            blend_factor: 0.0,
            from_alpha: 1.0,
            to_alpha: 0.0,
        }
    }

    fn update(&self, from: i32, to: i32, blend: f32) {
        self.from_level = from
        self.to_level = to
        self.blend_factor = blend

        // Calculate alpha values for crossfade
        self.from_alpha = 1.0 - blend
        self.to_alpha = blend
    }
}

// Helper function for tangent approximation
fn tan_approx(x: f32): f32 {
    let PI: f32 = 3.14159265358979
    // Normalize to -PI/2 to PI/2
    while x > PI / 2.0 {
        x = x - PI
    }
    while x < -PI / 2.0 {
        x = x + PI
    }
    // Taylor series approximation
    let x2 = x * x
    return x * (1.0 + x2 / 3.0 + x2 * x2 * 2.0 / 15.0)
}

// ============================================================================
// GLOBAL MODEL LOD FUNCTIONS
// ============================================================================

/// Calculate recommended LOD level for a model
fn calculate_model_lod(distance: f32, world_radius: f32, fov: f32, screen_height: f32): i32 {
    // Quick distance-based calculation
    if distance < 100.0 {
        return 0  // LOD0 - highest detail
    } else if distance < 200.0 {
        return 1
    } else if distance < 400.0 {
        return 2
    } else if distance < 800.0 {
        return 3
    }
    return 4  // LOD4 - lowest detail
}

/// Check if a LOD transition should use dithering
fn should_use_dither_transition(from_level: i32, to_level: i32): bool {
    // Use dithering for larger LOD jumps
    let diff = from_level - to_level
    if diff < 0 {
        diff = -diff
    }
    return diff > 1
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

fn test_lod_system() {
    print("Testing LOD System...")

    init_lod_manager()

    // Test static LOD
    set_static_lod_level(StaticLODLevel::HIGH)

    // Test FPS updates
    for i in 0..100 {
        update_lod_fps(55.0)
    }

    // Test particle skipping
    let skipped = 0
    for i in 0..100 {
        if should_skip_particle(ParticlePriority::MEDIUM) {
            skipped = skipped + 1
        }
    }
    print("Particles skipped: " + str(skipped) + " / 100")

    // Test debris skipping
    let debris_skipped = 0
    for i in 0..100 {
        if should_skip_debris() {
            debris_skipped = debris_skipped + 1
        }
    }
    print("Debris skipped: " + str(debris_skipped) + " / 100")

    shutdown_lod_manager()
    print("LOD System tests complete!")
}
