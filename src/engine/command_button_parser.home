// ============================================================================
// GLOBAL INSTANCE
// ============================================================================

let g_command_button_parser: CommandButtonParser? = null

fn init_command_button_parser(): CommandButtonParser {
    let parser = CommandButtonParser::init()
    g_command_button_parser = parser
    return parser
}

fn get_command_button_parser(): CommandButtonParser? {
    return g_command_button_parser
}

fn shutdown_command_button_parser() {
    g_command_button_parser = null
}
