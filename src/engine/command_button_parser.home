// Command Button Parser - Parses CommandButton definitions from INI
// Handles CommandButton and CommandSet blocks from Data/INI/CommandButton.ini
// Based on Thyme: game/client/gui/controlbar/controlbar.h

// Command button types matching Thyme's GUICommand enum
enum CommandButtonType {
    NONE,
    DOZER_CONSTRUCT,
    DOZER_CONSTRUCT_CANCEL,
    UNIT_BUILD,
    UNIT_BUILD_CANCEL,
    PLAYER_UPGRADE,
    OBJECT_UPGRADE,
    UPGRADE_CANCEL,
    ATTACK_MOVE,
    GUARD,
    GUARD_WITHOUT_PURSUIT,
    GUARD_FLYOVER,
    STOP,
    WAYPOINTS,
    EXIT_CONTAINER,
    EVACUATE,
    EVACUATE_CONTAINER,
    EXECUTE_RAILED_TRANSPORT,
    COMBAT_DROP,
    BEACON_DELETE,
    SET_RALLY_POINT,
    SELL,
    FIRE_WEAPON,
    SPECIAL_POWER,
    SPECIAL_POWER_FROM_SELF,
    SPECIAL_POWER_FROM_COMMAND_CENTER,
    PURCHASE_SCIENCE,
    HACK_INTERNET,
    TOGGLE_OVERCHARGE,
    TOGGLE_POWER,
    TOGGLE_WEAPON,
    SWITCH_WEAPON,
    HIJACK,
    CONVERT_TO_CAR_BOMB,
    CONVERT_TO_MOB_SPEAKER,
    SABOTAGE,
    SNEAK_ATTACK,
    TOGGLE_STEALTH_MODE,
    CHEER_ATTACK,
    DEFECT,
    CAPTURE_BUILDING,
    DISARM_MINE_DEFECT,
    BOOBY_TRAP,
    REMOVE_BOOBY_TRAP,
    DOCK,
    SELECT_ALL,
    FORMATION_MOVE,
    SPECIAL_MOVE,
    EMPTY_ALL_CONTAINERS_AT_ONCE,
    FORCE_ATTACK,
    CANCEL_CONSTRUCTION,
    SCATTER,
}

// Command button border types
enum CommandButtonBorderType {
    NONE,
    BUILD,
    UPGRADE,
    ACTION,
    SYSTEM,
}

// Command button options flags (matching Thyme's CommandButtonOptions)
let OPTION_NEED_TARGET_ENEMY_OBJECT: i32 = 1
let OPTION_NEED_TARGET_NEUTRAL_OBJECT: i32 = 2
let OPTION_NEED_TARGET_ALLY_OBJECT: i32 = 4
let OPTION_RESERVED: i32 = 8
let OPTION_ALLOW_SHRUBBERY_TARGET: i32 = 16
let OPTION_NEED_TARGET_POS: i32 = 32
let OPTION_NEED_UPGRADE: i32 = 64
let OPTION_NEED_SPECIAL_POWER_SCIENCE: i32 = 128
let OPTION_OK_FOR_MULTI_SELECT: i32 = 256
let OPTION_CONTEXTMODE_COMMAND: i32 = 512
let OPTION_CHECK_LIKE: i32 = 1024
let OPTION_ALLOW_MINE_TARGET: i32 = 2048
let OPTION_ATTACK_OBJECTS_POSITION: i32 = 4096
let OPTION_OPTION_ONE: i32 = 8192
let OPTION_OPTION_TWO: i32 = 16384
let OPTION_OPTION_THREE: i32 = 32768
let OPTION_NOT_QUEUEABLE: i32 = 65536
let OPTION_SINGLE_USE_COMMAND: i32 = 131072
let OPTION_DO_NOT_USE: i32 = 262144
let OPTION_SCRIPT_ONLY: i32 = 524288
let OPTION_IGNORES_UNDERPOWERED: i32 = 1048576
let OPTION_USES_MINE_CLEARING_WEAPONSET: i32 = 2097152
let OPTION_CAN_USE_WAYPOINTS: i32 = 4194304
let OPTION_MUST_BE_STOPPED: i32 = 8388608

let MAX_COMMAND_BUTTONS: i32 = 18  // Per command set (6x3 grid)

// Parsed command button definition
struct CommandButtonDefinition {
    name: string,
    command: CommandButtonType,

    // Display
    button_image: string,
    button_border: CommandButtonBorderType,
    text_label: string,
    descript_label: string,
    purchased_label: string,
    conflicting_label: string,

    // Cursor
    cursor_name: string,
    invalid_cursor_name: string,
    radius_cursor_type: string,

    // Associated object/power
    object_name: string,
    upgrade_name: string,
    special_power_name: string,
    sciences: [string],

    // Weapon
    weapon_slot: i32,
    max_shots_to_fire: i32,

    // Options
    options: i32,

    // Audio
    unit_specific_sound: string,

    // Flash
    cameo_flash_time: i32,

    is_valid: bool,
}

impl CommandButtonDefinition {
    fn init(): CommandButtonDefinition {
        return CommandButtonDefinition {
            name: "",
            command: CommandButtonType::NONE,
            button_image: "",
            button_border: CommandButtonBorderType::NONE,
            text_label: "",
            descript_label: "",
            purchased_label: "",
            conflicting_label: "",
            cursor_name: "",
            invalid_cursor_name: "",
            radius_cursor_type: "",
            object_name: "",
            upgrade_name: "",
            special_power_name: "",
            sciences: [],
            weapon_slot: 0,
            max_shots_to_fire: 0,
            options: 0,
            unit_specific_sound: "",
            cameo_flash_time: 0,
            is_valid: false,
        }
    }

    fn has_option(&self, option: i32): bool {
        return (self.options & option) != 0
    }

    fn is_valid_for_multi_select(&self): bool {
        return self.has_option(OPTION_OK_FOR_MULTI_SELECT)
    }

    fn is_context_command(&self): bool {
        return self.has_option(OPTION_CONTEXTMODE_COMMAND)
    }

    fn needs_target_object(&self): bool {
        let target_flags = OPTION_NEED_TARGET_ENEMY_OBJECT |
                           OPTION_NEED_TARGET_NEUTRAL_OBJECT |
                           OPTION_NEED_TARGET_ALLY_OBJECT
        return (self.options & target_flags) != 0
    }

    fn needs_target_position(&self): bool {
        return self.has_option(OPTION_NEED_TARGET_POS)
    }
}

// Command set slot
struct CommandSetSlot {
    slot_number: i32,
    command_button_name: string,
    is_valid: bool,
}

impl CommandSetSlot {
    fn init(): CommandSetSlot {
        return CommandSetSlot {
            slot_number: 0,
            command_button_name: "",
            is_valid: false,
        }
    }
}

// Command set - defines which buttons appear for a unit type
struct CommandSetDefinition {
    name: string,
    slots: [CommandSetSlot],
    is_valid: bool,
}

impl CommandSetDefinition {
    fn init(): CommandSetDefinition {
        return CommandSetDefinition {
            name: "",
            slots: [],
            is_valid: false,
        }
    }

    fn get_slot(&self, slot_num: i32): CommandSetSlot? {
        for i in 0..self.slots.length {
            if self.slots[i].slot_number == slot_num {
                return self.slots[i]
            }
        }
        return null
    }

    fn add_slot(&self, slot_num: i32, button_name: string) {
        let slot = CommandSetSlot::init()
        slot.slot_number = slot_num
        slot.command_button_name = button_name
        slot.is_valid = true
        self.slots = self.slots + [slot]
    }
}

// Command button parser
struct CommandButtonParser {
    buttons: [CommandButtonDefinition],
    command_sets: [CommandSetDefinition],

    // Parse state
    current_button: CommandButtonDefinition?,
    current_set: CommandSetDefinition?,
    in_button_block: bool,
    in_set_block: bool,

    // Errors
    parse_errors: [string],
}

impl CommandButtonParser {
    fn init(): CommandButtonParser {
        return CommandButtonParser {
            buttons: [],
            command_sets: [],
            current_button: null,
            current_set: null,
            in_button_block: false,
            in_set_block: false,
            parse_errors: [],
        }
    }

    fn parse_file(&self, content: string): bool {
        if content.len() == 0 {
            self.add_error("Empty file content")
            return false
        }

        // Split into lines and process
        let lines = self.split_lines(content)
        for i in 0..lines.length {
            let line = lines[i]
            let trimmed = self.trim_line(line)

            // Skip empty lines and comments
            if trimmed.len() == 0 {
                continue
            }
            if self.starts_with(trimmed, ";") || self.starts_with(trimmed, "//") {
                continue
            }

            if !self.parse_line(trimmed) {
                return false
            }
        }

        return true
    }

    fn parse_line(&self, line: string): bool {
        // Block starts
        if self.starts_with(line, "CommandButton ") {
            return self.begin_button_block(line)
        }

        if self.starts_with(line, "CommandSet ") {
            return self.begin_set_block(line)
        }

        // Block end
        if line == "End" || line == "END" {
            return self.end_current_block()
        }

        // Property parsing
        if self.in_button_block && self.current_button != null {
            return self.parse_button_property(line)
        }

        if self.in_set_block && self.current_set != null {
            return self.parse_set_property(line)
        }

        return true
    }

    fn begin_button_block(&self, line: string): bool {
        // Extract name after "CommandButton "
        let name = self.extract_block_name(line, "CommandButton ")

        let button = CommandButtonDefinition::init()
        button.name = name
        button.is_valid = true

        self.current_button = button
        self.in_button_block = true

        return true
    }

    fn begin_set_block(&self, line: string): bool {
        let name = self.extract_block_name(line, "CommandSet ")

        let set = CommandSetDefinition::init()
        set.name = name
        set.is_valid = true

        self.current_set = set
        self.in_set_block = true

        return true
    }

    fn end_current_block(&self): bool {
        if self.in_button_block && self.current_button != null {
            self.buttons = self.buttons + [self.current_button]
            self.current_button = null
            self.in_button_block = false
        } else if self.in_set_block && self.current_set != null {
            self.command_sets = self.command_sets + [self.current_set]
            self.current_set = null
            self.in_set_block = false
        }
        return true
    }

    fn parse_button_property(&self, line: string): bool {
        let parts = self.split_property(line)
        let key = parts.key
        let value = parts.value

        if key == "Command" {
            self.current_button.command = self.parse_command_type(value)
        } else if key == "ButtonImage" {
            self.current_button.button_image = value
        } else if key == "ButtonBorderType" {
            self.current_button.button_border = self.parse_border_type(value)
        } else if key == "TextLabel" {
            self.current_button.text_label = value
        } else if key == "DescriptLabel" {
            self.current_button.descript_label = value
        } else if key == "PurchasedLabel" {
            self.current_button.purchased_label = value
        } else if key == "ConflictingLabel" {
            self.current_button.conflicting_label = value
        } else if key == "CursorName" {
            self.current_button.cursor_name = value
        } else if key == "InvalidCursorName" {
            self.current_button.invalid_cursor_name = value
        } else if key == "RadiusCursorType" {
            self.current_button.radius_cursor_type = value
        } else if key == "Object" {
            self.current_button.object_name = value
        } else if key == "Upgrade" {
            self.current_button.upgrade_name = value
        } else if key == "SpecialPower" {
            self.current_button.special_power_name = value
        } else if key == "Science" {
            self.current_button.sciences = self.current_button.sciences + [value]
        } else if key == "WeaponSlot" {
            self.current_button.weapon_slot = self.parse_weapon_slot(value)
        } else if key == "MaxShotsToFire" {
            self.current_button.max_shots_to_fire = self.parse_int(value)
        } else if key == "Options" {
            self.current_button.options = self.current_button.options | self.parse_options(value)
        } else if key == "UnitSpecificSound" {
            self.current_button.unit_specific_sound = value
        } else if key == "CameoFlashTime" {
            self.current_button.cameo_flash_time = self.parse_int(value)
        }

        return true
    }

    fn parse_set_property(&self, line: string): bool {
        // Format: "1 = Command_DozerConstruct"
        let eq_pos = self.find_char(line, '=')
        if eq_pos < 0 {
            return true
        }

        let slot_str = self.substring(line, 0, eq_pos)
        let slot_str_trimmed = self.trim_line(slot_str)
        let command_name = self.substring(line, eq_pos + 1, line.len())
        let command_name_trimmed = self.trim_line(command_name)

        let slot_num = self.parse_int(slot_str_trimmed)
        if slot_num > 0 && slot_num <= MAX_COMMAND_BUTTONS {
            self.current_set.add_slot(slot_num, command_name_trimmed)
        }

        return true
    }

    fn parse_command_type(&self, value: string): CommandButtonType {
        let upper = self.to_upper(value)

        if upper == "DOZER_CONSTRUCT" { return CommandButtonType::DOZER_CONSTRUCT }
        if upper == "DOZER_CONSTRUCT_CANCEL" { return CommandButtonType::DOZER_CONSTRUCT_CANCEL }
        if upper == "UNIT_BUILD" { return CommandButtonType::UNIT_BUILD }
        if upper == "CANCEL_UNIT_BUILD" { return CommandButtonType::UNIT_BUILD_CANCEL }
        if upper == "UPGRADE" || upper == "OBJECT_UPGRADE" { return CommandButtonType::OBJECT_UPGRADE }
        if upper == "PLAYER_UPGRADE" { return CommandButtonType::PLAYER_UPGRADE }
        if upper == "CANCEL_UPGRADE" { return CommandButtonType::UPGRADE_CANCEL }
        if upper == "SPECIAL_POWER" { return CommandButtonType::SPECIAL_POWER }
        if upper == "SPECIAL_POWER_FROM_SELF" { return CommandButtonType::SPECIAL_POWER_FROM_SELF }
        if upper == "SPECIAL_POWER_FROM_COMMAND_CENTER" { return CommandButtonType::SPECIAL_POWER_FROM_COMMAND_CENTER }
        if upper == "EXIT_CONTAINER" { return CommandButtonType::EXIT_CONTAINER }
        if upper == "EVACUATE" { return CommandButtonType::EVACUATE }
        if upper == "EVACUATE_CONTAINER" { return CommandButtonType::EVACUATE_CONTAINER }
        if upper == "EXECUTE_RAILED_TRANSPORT" { return CommandButtonType::EXECUTE_RAILED_TRANSPORT }
        if upper == "COMBAT_DROP" { return CommandButtonType::COMBAT_DROP }
        if upper == "GUARD" { return CommandButtonType::GUARD }
        if upper == "GUARD_WITHOUT_PURSUIT" { return CommandButtonType::GUARD_WITHOUT_PURSUIT }
        if upper == "GUARD_FLYOVER" { return CommandButtonType::GUARD_FLYOVER }
        if upper == "ATTACK_MOVE" { return CommandButtonType::ATTACK_MOVE }
        if upper == "STOP" { return CommandButtonType::STOP }
        if upper == "SCATTER" { return CommandButtonType::SCATTER }
        if upper == "SET_RALLY_POINT" { return CommandButtonType::SET_RALLY_POINT }
        if upper == "SELL" { return CommandButtonType::SELL }
        if upper == "CANCEL_CONSTRUCTION" { return CommandButtonType::CANCEL_CONSTRUCTION }
        if upper == "TOGGLE_POWER" { return CommandButtonType::TOGGLE_POWER }
        if upper == "TOGGLE_WEAPON" { return CommandButtonType::TOGGLE_WEAPON }
        if upper == "CONVERT_TO_CAR_BOMB" { return CommandButtonType::CONVERT_TO_CAR_BOMB }
        if upper == "CONVERT_TO_MOB_SPEAKER" { return CommandButtonType::CONVERT_TO_MOB_SPEAKER }
        if upper == "HIJACK_VEHICLE" { return CommandButtonType::HIJACK }
        if upper == "HACK_INTERNET" { return CommandButtonType::HACK_INTERNET }
        if upper == "SABOTAGE" { return CommandButtonType::SABOTAGE }
        if upper == "SNEAK_ATTACK" { return CommandButtonType::SNEAK_ATTACK }
        if upper == "TOGGLE_STEALTH" { return CommandButtonType::TOGGLE_STEALTH_MODE }
        if upper == "CHEER" { return CommandButtonType::CHEER_ATTACK }
        if upper == "DEFECTOR" { return CommandButtonType::DEFECT }
        if upper == "CAPTURE_BUILDING" { return CommandButtonType::CAPTURE_BUILDING }
        if upper == "DISARM_MINE_DEFECT" { return CommandButtonType::DISARM_MINE_DEFECT }
        if upper == "BOOBY_TRAP" { return CommandButtonType::BOOBY_TRAP }
        if upper == "REMOVE_BOOBY_TRAP" { return CommandButtonType::REMOVE_BOOBY_TRAP }
        if upper == "FIRE_WEAPON" { return CommandButtonType::FIRE_WEAPON }
        if upper == "SWITCH_WEAPON" { return CommandButtonType::SWITCH_WEAPON }
        if upper == "DOCK" { return CommandButtonType::DOCK }
        if upper == "SELECT_ALL" || upper == "SELECT_ALL_UNITS_OF_TYPE" { return CommandButtonType::SELECT_ALL }
        if upper == "FORMATION_MOVE" { return CommandButtonType::FORMATION_MOVE }
        if upper == "SPECIAL_MOVE" { return CommandButtonType::SPECIAL_MOVE }
        if upper == "EMPTY_ALL_CONTAINERS_AT_ONCE" { return CommandButtonType::EMPTY_ALL_CONTAINERS_AT_ONCE }
        if upper == "FORCE_ATTACK" { return CommandButtonType::FORCE_ATTACK }

        return CommandButtonType::NONE
    }

    fn parse_border_type(&self, value: string): CommandButtonBorderType {
        let upper = self.to_upper(value)
        if upper == "BUILD" { return CommandButtonBorderType::BUILD }
        if upper == "UPGRADE" { return CommandButtonBorderType::UPGRADE }
        if upper == "ACTION" { return CommandButtonBorderType::ACTION }
        if upper == "SYSTEM" { return CommandButtonBorderType::SYSTEM }
        return CommandButtonBorderType::NONE
    }

    fn parse_options(&self, value: string): i32 {
        let options: i32 = 0
        let upper = self.to_upper(value)

        // Check each option
        if self.contains(upper, "OK_FOR_MULTI_SELECT") { options = options | OPTION_OK_FOR_MULTI_SELECT }
        if self.contains(upper, "CHECK_LIKE") { options = options | OPTION_CHECK_LIKE }
        if self.contains(upper, "NEED_TARGET_ENEMY_OBJECT") { options = options | OPTION_NEED_TARGET_ENEMY_OBJECT }
        if self.contains(upper, "NEED_TARGET_NEUTRAL_OBJECT") { options = options | OPTION_NEED_TARGET_NEUTRAL_OBJECT }
        if self.contains(upper, "NEED_TARGET_ALLY_OBJECT") { options = options | OPTION_NEED_TARGET_ALLY_OBJECT }
        if self.contains(upper, "CONTEXTMODE_COMMAND") { options = options | OPTION_CONTEXTMODE_COMMAND }
        if self.contains(upper, "OPTION_ONE") { options = options | OPTION_OPTION_ONE }
        if self.contains(upper, "OPTION_TWO") { options = options | OPTION_OPTION_TWO }
        if self.contains(upper, "OPTION_THREE") { options = options | OPTION_OPTION_THREE }
        if self.contains(upper, "NEED_UPGRADE") { options = options | OPTION_NEED_UPGRADE }
        if self.contains(upper, "NOT_QUEUEABLE") { options = options | OPTION_NOT_QUEUEABLE }
        if self.contains(upper, "IGNORES_UNDERPOWERED") { options = options | OPTION_IGNORES_UNDERPOWERED }
        if self.contains(upper, "NEED_SPECIAL_POWER_SCIENCE") { options = options | OPTION_NEED_SPECIAL_POWER_SCIENCE }
        if self.contains(upper, "SCRIPT_ONLY") { options = options | OPTION_SCRIPT_ONLY }
        if self.contains(upper, "USES_MINE_CLEARING") { options = options | OPTION_USES_MINE_CLEARING_WEAPONSET }
        if self.contains(upper, "SINGLE_USE_COMMAND") { options = options | OPTION_SINGLE_USE_COMMAND }
        if self.contains(upper, "NEED_TARGET_POS") { options = options | OPTION_NEED_TARGET_POS }
        if self.contains(upper, "CAN_USE_WAYPOINTS") { options = options | OPTION_CAN_USE_WAYPOINTS }
        if self.contains(upper, "MUST_BE_STOPPED") { options = options | OPTION_MUST_BE_STOPPED }

        return options
    }

    fn parse_weapon_slot(&self, value: string): i32 {
        let upper = self.to_upper(value)
        if upper == "PRIMARY" { return 0 }
        if upper == "SECONDARY" { return 1 }
        if upper == "TERTIARY" { return 2 }
        return self.parse_int(value)
    }

    // Helper functions
    fn add_error(&self, msg: string) {
        self.parse_errors = self.parse_errors + [msg]
    }

    fn extract_block_name(&self, line: string, prefix: string): string {
        let start = prefix.len()
        if start >= line.len() {
            return ""
        }
        let name = self.substring(line, start, line.len())
        return self.trim_line(name)
    }

    fn split_property(&self, line: string): PropertyPair {
        // Try "=" first
        let eq_pos = self.find_char(line, '=')
        if eq_pos > 0 {
            let key = self.substring(line, 0, eq_pos)
            let value = self.substring(line, eq_pos + 1, line.len())
            return PropertyPair {
                key: self.trim_line(key),
                value: self.trim_line(value),
            }
        }

        // Try space
        let space_pos = self.find_char(line, ' ')
        if space_pos > 0 {
            let key = self.substring(line, 0, space_pos)
            let value = self.substring(line, space_pos + 1, line.len())
            return PropertyPair {
                key: self.trim_line(key),
                value: self.trim_line(value),
            }
        }

        return PropertyPair { key: line, value: "" }
    }

    fn split_lines(&self, content: string): [string] {
        let lines: [string] = []
        let current = ""

        for i in 0..content.len() {
            let c = content.char_at(i)
            if c == '\n' {
                lines = lines + [current]
                current = ""
            } else if c != '\r' {
                current = current + c
            }
        }

        if current.len() > 0 {
            lines = lines + [current]
        }

        return lines
    }

    fn trim_line(&self, s: string): string {
        let start = 0
        let end = s.len()

        while start < end {
            let c = s.char_at(start)
            if c != ' ' && c != '\t' {
                break
            }
            start = start + 1
        }

        while end > start {
            let c = s.char_at(end - 1)
            if c != ' ' && c != '\t' {
                break
            }
            end = end - 1
        }

        return self.substring(s, start, end)
    }

    fn starts_with(&self, s: string, prefix: string): bool {
        if prefix.len() > s.len() {
            return false
        }
        for i in 0..prefix.len() {
            if s.char_at(i) != prefix.char_at(i) {
                return false
            }
        }
        return true
    }

    fn contains(&self, s: string, sub: string): bool {
        if sub.len() > s.len() {
            return false
        }
        for i in 0..(s.len() - sub.len() + 1) {
            let found = true
            for j in 0..sub.len() {
                if s.char_at(i + j) != sub.char_at(j) {
                    found = false
                    break
                }
            }
            if found {
                return true
            }
        }
        return false
    }

    fn find_char(&self, s: string, c: char): i32 {
        for i in 0..s.len() {
            if s.char_at(i) == c {
                return i
            }
        }
        return -1
    }

    fn substring(&self, s: string, start: i32, end: i32): string {
        let result = ""
        for i in start..end {
            if i >= 0 && i < s.len() {
                result = result + s.char_at(i)
            }
        }
        return result
    }

    fn to_upper(&self, s: string): string {
        let result = ""
        for i in 0..s.len() {
            let c = s.char_at(i)
            let code = s.char_code_at(i)
            if code >= 97 && code <= 122 {  // a-z
                result = result + char_from_code(code - 32)
            } else {
                result = result + c
            }
        }
        return result
    }

    fn parse_int(&self, s: string): i32 {
        let result: i32 = 0
        let negative = false
        let start = 0

        if s.len() > 0 && s.char_at(0) == '-' {
            negative = true
            start = 1
        }

        for i in start..s.len() {
            let code = s.char_code_at(i)
            if code >= 48 && code <= 57 {  // 0-9
                result = result * 10 + (code - 48)
            }
        }

        if negative {
            return -result
        }
        return result
    }

    // Public API
    fn get_button(&self, name: string): CommandButtonDefinition? {
        for i in 0..self.buttons.length {
            if self.buttons[i].name == name {
                return self.buttons[i]
            }
        }
        return null
    }

    fn get_command_set(&self, name: string): CommandSetDefinition? {
        for i in 0..self.command_sets.length {
            if self.command_sets[i].name == name {
                return self.command_sets[i]
            }
        }
        return null
    }

    fn get_button_count(&self): i32 {
        return self.buttons.length
    }

    fn get_set_count(&self): i32 {
        return self.command_sets.length
    }
}

// Helper struct for property parsing
struct PropertyPair {
    key: string,
    value: string,
}

