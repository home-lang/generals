// ============================================================================
// Tests
// ============================================================================

fn test_game_data_defaults() {
    print("Testing game data defaults...")

    let game_data = GlobalGameData::init()
    print("Starting cash: " + str(game_data.starting_cash))
    print("Logic FPS: " + str(game_data.logic_frames_per_second))
    print("Camera pitch: " + str(game_data.camera_pitch))
}

fn test_player_template() {
    print("Testing player template...")

    let template = get_default_usa_template()
    print("Name: " + template.name)
    print("Side: " + template.side)
    print("Display: " + template.display_name)
    print("Starting building: " + template.starting_building)
}

fn test_faction_data() {
    print("Testing faction data...")

    let factions = FactionData::init()

    // Add USA
    factions.templates[0] = get_default_usa_template()
    factions.template_count = 1

    // Add China
    factions.templates[1] = get_default_china_template()
    factions.template_count = 2

    // Add GLA
    factions.templates[2] = get_default_gla_template()
    factions.template_count = 3

    print("Total factions: " + str(factions.template_count))
}

fn test_map_cache() {
    print("Testing map cache...")

    let loader = GameDataLoader::init("/path/to/game")
    loader.load_map_cache()

    print("Total maps: " + str(loader.map_count))

    let mp_maps = loader.get_multiplayer_maps()
    print("Multiplayer maps: " + str(mp_maps.length))
}

fn run_all_tests() {
    print("Running game data loader tests...")
    test_game_data_defaults()
    test_player_template()
    test_faction_data()
    test_map_cache()
    print("All game data loader tests complete!")
}
