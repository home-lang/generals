// Game Data Loader - Master coordinator for loading all INI game data
// Orchestrates loading of all Data/INI files for C&C Generals
//
// Loads:
// - GameData.ini - Global game settings
// - Object/*.ini - Unit and building definitions
// - Weapon.ini - Weapon definitions
// - Upgrade.ini - Upgrade definitions
// - Science.ini - General powers/sciences
// - FXList.ini - Visual effects
// - PlayerTemplate.ini - Faction definitions

let MAX_MAPS: i32 = 512
let MAX_PLAYER_TEMPLATES: i32 = 32
let MAX_LOAD_ERRORS: i32 = 128

// ============================================================================
// Global Game Data (from GameData.ini)
// ============================================================================

struct GlobalGameData {
    // Time and speed
    default_game_speed: f64,
    logic_frames_per_second: i32,
    max_unit_speed: f64,

    // Economy
    starting_cash: i32,
    supply_box_initial_value: i32,
    value_per_supply_box: i32,
    builder_speed: f64,

    // Combat
    veterancy_pip_gap: f64,
    armor_damage_scalar: f64,
    standard_rally_point_offset: f64,

    // Camera
    max_camera_height: f64,
    min_camera_height: f64,
    camera_pitch: f64,
    camera_yaw: f64,
    draw_entire_terrain: bool,

    // Network
    network_frames_ahead: i32,
    network_run_ahead_metrics_time: i32,
    network_run_ahead_slack: i32,

    // Audio
    audio_footstep_volume: f64,
    audio_ambient_volume: f64,
    audio_speech_volume: f64,
    audio_music_volume: f64,

    // Visual
    particle_cap: i32,
    max_shells: i32,
    max_emitters: i32,

    // Difficulty
    easy_money_bonus: f64,
    medium_money_bonus: f64,
    hard_money_bonus: f64,
    easy_build_time_bonus: f64,
    medium_build_time_bonus: f64,
    hard_build_time_bonus: f64,

    // Radar
    shroud_color: i32,
    fog_color: i32,
    terrain_shroud_ratio: f64,

    // @tweak L3-M 27/11/2025 (#1914) - Money per minute display settings
    show_money_per_minute: bool,              // Toggle the money per minute display
    allow_money_per_minute_for_player: bool,  // Allow MPM display for players (not just observers)

    // Camera shake intensities
    shake_subtle_intensity: f32,
    shake_normal_intensity: f32,
    shake_strong_intensity: f32,
    shake_severe_intensity: f32,
    shake_cine_extreme_intensity: f32,
    shake_cine_insane_intensity: f32,

    is_loaded: bool,
}

impl GlobalGameData {
    fn init(): GlobalGameData {
        return GlobalGameData {
            default_game_speed: 1.0,
            logic_frames_per_second: 30,
            max_unit_speed: 100.0,
            starting_cash: 10000,
            supply_box_initial_value: 1500,
            value_per_supply_box: 100,
            builder_speed: 60.0,
            veterancy_pip_gap: 2.0,
            armor_damage_scalar: 1.0,
            standard_rally_point_offset: 100.0,
            max_camera_height: 600.0,
            min_camera_height: 200.0,
            camera_pitch: 37.5,
            camera_yaw: 0.0,
            draw_entire_terrain: false,
            network_frames_ahead: 6,
            network_run_ahead_metrics_time: 2500,
            network_run_ahead_slack: 2,
            audio_footstep_volume: 0.5,
            audio_ambient_volume: 0.5,
            audio_speech_volume: 0.7,
            audio_music_volume: 0.4,
            particle_cap: 5000,
            max_shells: 100,
            max_emitters: 512,
            easy_money_bonus: 1.25,
            medium_money_bonus: 1.0,
            hard_money_bonus: 0.85,
            easy_build_time_bonus: 0.75,
            medium_build_time_bonus: 1.0,
            hard_build_time_bonus: 1.25,
            shroud_color: 0x000000,
            fog_color: 0x404040,
            terrain_shroud_ratio: 0.5,
            // @tweak (#1914) - Money per minute defaults (disabled for retail behavior compatibility)
            show_money_per_minute: false,
            allow_money_per_minute_for_player: false,
            // Camera shake defaults
            shake_subtle_intensity: 0.3,
            shake_normal_intensity: 0.6,
            shake_strong_intensity: 1.0,
            shake_severe_intensity: 1.5,
            shake_cine_extreme_intensity: 2.0,
            shake_cine_insane_intensity: 3.0,
            is_loaded: false,
        }
    }

    // @tweak (#1914) - Check if money per minute should be shown for current player
    fn should_show_money_per_minute(self, is_observing: bool): bool {
        if !self.show_money_per_minute {
            return false
        }

        // Always show for observers (replay/spectator mode)
        if is_observing {
            return true
        }

        // Only show for players if explicitly allowed in config
        return self.allow_money_per_minute_for_player
    }
}

// ============================================================================
// Player Template Definition
// ============================================================================

struct PlayerTemplateDefinition {
    name: string,
    side: string,
    display_name: string,
    starting_building: string,
    starting_unit_0: string,
    starting_unit_1: string,
    production_cost_modifier: f64,
    production_time_modifier: f64,
    preferred_generals: [string],
    preferred_general_count: i32,
    beacon_template: string,
    play_style: string,
    is_valid: bool,
}

impl PlayerTemplateDefinition {
    fn init(): PlayerTemplateDefinition {
        let generals: [string] = []
        for i in 0..4 {
            generals = generals + [""]
        }

        return PlayerTemplateDefinition {
            name: "",
            side: "",
            display_name: "",
            starting_building: "",
            starting_unit_0: "",
            starting_unit_1: "",
            production_cost_modifier: 1.0,
            production_time_modifier: 1.0,
            preferred_generals: generals,
            preferred_general_count: 0,
            beacon_template: "",
            play_style: "",
            is_valid: false,
        }
    }
}

// ============================================================================
// Faction Data
// ============================================================================

struct FactionData {
    templates: [PlayerTemplateDefinition],
    template_count: i32,
}

impl FactionData {
    fn init(): FactionData {
        let templates: [PlayerTemplateDefinition] = []
        for i in 0..MAX_PLAYER_TEMPLATES {
            templates = templates + [PlayerTemplateDefinition::init()]
        }

        return FactionData {
            templates: templates,
            template_count: 0,
        }
    }
}

// ============================================================================
// Map Cache Entry
// ============================================================================

struct MapCacheEntry {
    name: string,
    display_name: string,
    file_path: string,
    num_players: i32,
    is_multiplayer: bool,
    is_official: bool,
    initial_camera_pos_x: f64,
    initial_camera_pos_y: f64,
    extent_min_x: f64,
    extent_min_y: f64,
    extent_max_x: f64,
    extent_max_y: f64,
    is_valid: bool,
}

impl MapCacheEntry {
    fn init(): MapCacheEntry {
        return MapCacheEntry {
            name: "",
            display_name: "",
            file_path: "",
            num_players: 0,
            is_multiplayer: false,
            is_official: false,
            initial_camera_pos_x: 0.0,
            initial_camera_pos_y: 0.0,
            extent_min_x: 0.0,
            extent_min_y: 0.0,
            extent_max_x: 0.0,
            extent_max_y: 0.0,
            is_valid: false,
        }
    }
}

// ============================================================================
// Game Data Loader
// ============================================================================

struct GameDataLoader {
    // Global settings
    game_data: GlobalGameData,

    // Factions
    factions: FactionData,

    // Map cache
    maps: [MapCacheEntry],
    map_count: i32,

    // Paths
    data_path: string,
    language: string,

    // Loading state
    is_initialized: bool,
    load_errors: [string],
    error_count: i32,

    // Progress tracking
    current_progress: f64,
    current_status: string,
}

impl GameDataLoader {
    fn init(data_path: string): GameDataLoader {
        let maps: [MapCacheEntry] = []
        for i in 0..MAX_MAPS {
            maps = maps + [MapCacheEntry::init()]
        }

        let errors: [string] = []
        for i in 0..MAX_LOAD_ERRORS {
            errors = errors + [""]
        }

        return GameDataLoader {
            game_data: GlobalGameData::init(),
            factions: FactionData::init(),
            maps: maps,
            map_count: 0,
            data_path: data_path,
            language: "english",
            is_initialized: false,
            load_errors: errors,
            error_count: 0,
            current_progress: 0.0,
            current_status: "",
        }
    }

    // Load all game data
    fn load_all(&self): bool {
        let total_steps = 8.0
        let step = 0.0

        // Step 1: Load GameData.ini
        self.report_progress(step / total_steps, "Loading global game data...")
        if !self.load_game_data_ini() {
            self.add_error("Failed to load GameData.ini")
        }
        step = step + 1.0

        // Step 2: Load weapons
        self.report_progress(step / total_steps, "Loading weapon definitions...")
        if !self.load_weapons() {
            self.add_error("Failed to load weapons")
        }
        step = step + 1.0

        // Step 3: Load upgrades
        self.report_progress(step / total_steps, "Loading upgrade definitions...")
        if !self.load_upgrades() {
            self.add_error("Failed to load upgrades")
        }
        step = step + 1.0

        // Step 4: Load sciences
        self.report_progress(step / total_steps, "Loading science definitions...")
        if !self.load_sciences() {
            self.add_error("Failed to load sciences")
        }
        step = step + 1.0

        // Step 5: Load FX lists
        self.report_progress(step / total_steps, "Loading FX definitions...")
        if !self.load_fx_lists() {
            self.add_error("Failed to load FX lists")
        }
        step = step + 1.0

        // Step 6: Load object definitions
        self.report_progress(step / total_steps, "Loading object definitions...")
        if !self.load_objects() {
            self.add_error("Failed to load object definitions")
        }
        step = step + 1.0

        // Step 7: Load player templates
        self.report_progress(step / total_steps, "Loading player templates...")
        if !self.load_player_templates() {
            self.add_error("Failed to load player templates")
        }
        step = step + 1.0

        // Step 8: Load map cache
        self.report_progress(step / total_steps, "Building map cache...")
        if !self.load_map_cache() {
            self.add_error("Failed to load map cache")
        }

        self.report_progress(1.0, "Game data loaded")
        self.is_initialized = true

        return self.error_count == 0
    }

    fn report_progress(&self, progress: f64, message: string) {
        self.current_progress = progress
        self.current_status = message
        // Callback would go here
    }

    // Load GameData.ini
    fn load_game_data_ini(&self): bool {
        let path = self.data_path + "/Data/INI/GameData.ini"
        let content = read_file_to_string(path)
        if content.length == 0 {
            return false
        }

        let lines = split_lines(content)
        let in_game_data = false

        for line in lines {
            let trimmed = trim(line)

            if trimmed.length == 0 || starts_with(trimmed, ";") || starts_with(trimmed, "//") {
                continue
            }

            if starts_with(trimmed, "GameData") && !contains(trimmed, "=") {
                in_game_data = true
                continue
            }

            if trimmed == "End" && in_game_data {
                in_game_data = false
                continue
            }

            if in_game_data {
                self.parse_game_data_property(trimmed)
            }
        }

        self.game_data.is_loaded = true
        return true
    }

    fn parse_game_data_property(&self, line: string) {
        let parts = self.split_property(line)
        let key = parts.key
        let value = parts.value

        if key == "DefaultGameSpeed" {
            self.game_data.default_game_speed = self.parse_f64(value)
        } else if key == "LogicFramesPerSecond" {
            self.game_data.logic_frames_per_second = self.parse_i32(value)
        } else if key == "MaxUnitSpeed" {
            self.game_data.max_unit_speed = self.parse_f64(value)
        } else if key == "StartingCash" {
            self.game_data.starting_cash = self.parse_i32(value)
        } else if key == "SupplyBoxInitialValue" {
            self.game_data.supply_box_initial_value = self.parse_i32(value)
        } else if key == "ValuePerSupplyBox" {
            self.game_data.value_per_supply_box = self.parse_i32(value)
        } else if key == "BuilderSpeed" {
            self.game_data.builder_speed = self.parse_f64(value)
        } else if key == "MaxCameraHeight" {
            self.game_data.max_camera_height = self.parse_f64(value)
        } else if key == "MinCameraHeight" {
            self.game_data.min_camera_height = self.parse_f64(value)
        } else if key == "CameraPitch" {
            self.game_data.camera_pitch = self.parse_f64(value)
        } else if key == "CameraYaw" {
            self.game_data.camera_yaw = self.parse_f64(value)
        } else if key == "NetworkFramesAhead" {
            self.game_data.network_frames_ahead = self.parse_i32(value)
        } else if key == "NetworkRunAheadMetricsTime" {
            self.game_data.network_run_ahead_metrics_time = self.parse_i32(value)
        } else if key == "NetworkRunAheadSlack" {
            self.game_data.network_run_ahead_slack = self.parse_i32(value)
        } else if key == "AudioFootstepVolume" {
            self.game_data.audio_footstep_volume = self.parse_f64(value)
        } else if key == "AudioAmbientVolume" {
            self.game_data.audio_ambient_volume = self.parse_f64(value)
        } else if key == "AudioSpeechVolume" {
            self.game_data.audio_speech_volume = self.parse_f64(value)
        } else if key == "AudioMusicVolume" {
            self.game_data.audio_music_volume = self.parse_f64(value)
        } else if key == "ParticleCap" {
            self.game_data.particle_cap = self.parse_i32(value)
        } else if key == "MaxShells" {
            self.game_data.max_shells = self.parse_i32(value)
        } else if key == "MaxEmitters" {
            self.game_data.max_emitters = self.parse_i32(value)
        } else if key == "EasyMoneyBonus" {
            self.game_data.easy_money_bonus = self.parse_percent(value)
        } else if key == "MediumMoneyBonus" {
            self.game_data.medium_money_bonus = self.parse_percent(value)
        } else if key == "HardMoneyBonus" {
            self.game_data.hard_money_bonus = self.parse_percent(value)
        } else if key == "EasyBuildTimeBonus" {
            self.game_data.easy_build_time_bonus = self.parse_percent(value)
        } else if key == "MediumBuildTimeBonus" {
            self.game_data.medium_build_time_bonus = self.parse_percent(value)
        } else if key == "HardBuildTimeBonus" {
            self.game_data.hard_build_time_bonus = self.parse_percent(value)
        }
    }

    // Load weapon definitions
    fn load_weapons(&self): bool {
        let path = self.data_path + "/Data/INI/Weapon.ini"
        // Would call weapon_parser.parse_file(path)
        return file_exists(path)
    }

    // Load upgrade definitions
    fn load_upgrades(&self): bool {
        let path = self.data_path + "/Data/INI/Upgrade.ini"
        // Would call upgrade_parser.parse_file(path)
        return file_exists(path)
    }

    // Load science definitions
    fn load_sciences(&self): bool {
        let path = self.data_path + "/Data/INI/Science.ini"
        // Would call science_parser.parse_file(path)
        return file_exists(path)
    }

    // Load FX list definitions
    fn load_fx_lists(&self): bool {
        let path = self.data_path + "/Data/INI/FXList.ini"
        // Would call fx_parser.parse_file(path)
        return file_exists(path)
    }

    // Load object definitions
    fn load_objects(&self): bool {
        // Load main object files
        let paths = [
            "/Data/INI/Object/Infantry.ini",
            "/Data/INI/Object/Vehicle.ini",
            "/Data/INI/Object/Aircraft.ini",
            "/Data/INI/Object/Building.ini",
            "/Data/INI/Object/Civilian.ini",
            "/Data/INI/Object/System.ini",
            "/Data/INI/Object/USA.ini",
            "/Data/INI/Object/China.ini",
            "/Data/INI/Object/GLA.ini",
            "/Data/INI/Object/Neutral.ini",
        ]

        for path in paths {
            let full_path = self.data_path + path
            if file_exists(full_path) {
                // Would call object_parser.parse_file(full_path)
            }
        }

        return true
    }

    // Load player templates
    fn load_player_templates(&self): bool {
        let path = self.data_path + "/Data/INI/PlayerTemplate.ini"
        let content = read_file_to_string(path)
        if content.length == 0 {
            return false
        }

        let lines = split_lines(content)
        let in_template = false
        let current_idx = 0

        for line in lines {
            let trimmed = trim(line)

            if trimmed.length == 0 || starts_with(trimmed, ";") || starts_with(trimmed, "//") {
                continue
            }

            if starts_with(trimmed, "PlayerTemplate ") {
                if self.factions.template_count >= MAX_PLAYER_TEMPLATES {
                    continue
                }
                let parts = split_by_space(trimmed)
                if parts.length >= 2 {
                    current_idx = self.factions.template_count
                    self.factions.templates[current_idx] = PlayerTemplateDefinition::init()
                    self.factions.templates[current_idx].name = trim(parts[1])
                    self.factions.templates[current_idx].is_valid = true
                    self.factions.template_count = self.factions.template_count + 1
                    in_template = true
                }
                continue
            }

            if trimmed == "End" && in_template {
                in_template = false
                continue
            }

            if in_template {
                self.parse_player_template_property(current_idx, trimmed)
            }
        }

        return true
    }

    fn parse_player_template_property(&self, idx: i32, line: string) {
        let parts = self.split_property(line)
        let key = parts.key
        let value = parts.value
        let template = self.factions.templates[idx]

        if key == "Side" {
            template.side = value
        } else if key == "DisplayName" {
            template.display_name = value
        } else if key == "StartingBuilding" {
            template.starting_building = value
        } else if key == "StartingUnit0" {
            template.starting_unit_0 = value
        } else if key == "StartingUnit1" {
            template.starting_unit_1 = value
        } else if key == "ProductionCostModifier" || key == "ProductionCostChange" {
            template.production_cost_modifier = self.parse_percent(value)
        } else if key == "ProductionTimeModifier" || key == "ProductionTimeChange" {
            template.production_time_modifier = self.parse_percent(value)
        } else if key == "PreferredGeneral" {
            if template.preferred_general_count < 4 {
                template.preferred_generals[template.preferred_general_count] = value
                template.preferred_general_count = template.preferred_general_count + 1
            }
        } else if key == "BeaconTemplate" {
            template.beacon_template = value
        } else if key == "PlayStyle" {
            template.play_style = value
        }
    }

    // Load map cache
    fn load_map_cache(&self): bool {
        // Scan maps directory
        let maps_path = self.data_path + "/Maps"

        // Known official maps from C&C Generals
        let known_maps = [
            MapInfo { name: "Alpine Assault", display_name: "Alpine Assault", players: 4, is_mp: true },
            MapInfo { name: "Bare Knuckle", display_name: "Bare Knuckle", players: 2, is_mp: true },
            MapInfo { name: "Battle for Survival", display_name: "Battle for Survival", players: 4, is_mp: true },
            MapInfo { name: "Death Valley", display_name: "Death Valley", players: 4, is_mp: true },
            MapInfo { name: "Desert Combat", display_name: "Desert Combat", players: 2, is_mp: true },
            MapInfo { name: "Destruction Station", display_name: "Destruction Station", players: 4, is_mp: true },
            MapInfo { name: "El Scorcho", display_name: "El Scorcho", players: 4, is_mp: true },
            MapInfo { name: "Fallen Empire", display_name: "Fallen Empire", players: 4, is_mp: true },
            MapInfo { name: "Flash Fire", display_name: "Flash Fire", players: 2, is_mp: true },
            MapInfo { name: "Fortress", display_name: "Fortress", players: 2, is_mp: true },
            MapInfo { name: "Homeland Alliance", display_name: "Homeland Alliance", players: 8, is_mp: true },
            MapInfo { name: "Lone Eagle", display_name: "Lone Eagle", players: 2, is_mp: true },
            MapInfo { name: "Mountain Guns", display_name: "Mountain Guns", players: 6, is_mp: true },
            MapInfo { name: "Rogue Agent", display_name: "Rogue Agent", players: 6, is_mp: true },
            MapInfo { name: "Rocky Rampage", display_name: "Rocky Rampage", players: 4, is_mp: true },
            MapInfo { name: "Scorched Earth", display_name: "Scorched Earth", players: 4, is_mp: true },
            MapInfo { name: "Stormy Weather", display_name: "Stormy Weather", players: 4, is_mp: true },
            MapInfo { name: "Tournament A", display_name: "Tournament A", players: 2, is_mp: true },
            MapInfo { name: "Tournament City", display_name: "Tournament City", players: 4, is_mp: true },
            MapInfo { name: "Tournament Desert", display_name: "Tournament Desert", players: 2, is_mp: true },
            MapInfo { name: "Tournament Island", display_name: "Tournament Island", players: 4, is_mp: true },
            MapInfo { name: "Twilight Flame", display_name: "Twilight Flame", players: 4, is_mp: true },
            MapInfo { name: "Winter Wolf", display_name: "Winter Wolf", players: 4, is_mp: true },
        ]

        for map_info in known_maps {
            if self.map_count >= MAX_MAPS {
                break
            }

            let idx = self.map_count
            self.maps[idx].name = map_info.name
            self.maps[idx].display_name = map_info.display_name
            self.maps[idx].file_path = maps_path + "/" + map_info.name + "/" + map_info.name + ".map"
            self.maps[idx].num_players = map_info.players
            self.maps[idx].is_multiplayer = map_info.is_mp
            self.maps[idx].is_official = true
            self.maps[idx].is_valid = true
            self.map_count = self.map_count + 1
        }

        return true
    }

    // Public API
    fn get_player_template(&self, name: string): PlayerTemplateDefinition? {
        for i in 0..self.factions.template_count {
            if self.factions.templates[i].name == name {
                return self.factions.templates[i]
            }
        }
        return null
    }

    fn get_player_template_by_side(&self, side: string): PlayerTemplateDefinition? {
        for i in 0..self.factions.template_count {
            if self.factions.templates[i].side == side {
                return self.factions.templates[i]
            }
        }
        return null
    }

    fn get_map(&self, name: string): MapCacheEntry? {
        for i in 0..self.map_count {
            if self.maps[i].name == name {
                return self.maps[i]
            }
        }
        return null
    }

    fn get_multiplayer_maps(&self): [MapCacheEntry] {
        let result: [MapCacheEntry] = []
        for i in 0..self.map_count {
            if self.maps[i].is_multiplayer {
                result = result + [self.maps[i]]
            }
        }
        return result
    }

    fn get_maps_for_player_count(&self, player_count: i32): [MapCacheEntry] {
        let result: [MapCacheEntry] = []
        for i in 0..self.map_count {
            if self.maps[i].num_players >= player_count {
                result = result + [self.maps[i]]
            }
        }
        return result
    }

    fn get_game_data(&self): GlobalGameData {
        return self.game_data
    }

    fn is_loaded(&self): bool {
        return self.is_initialized
    }

    fn get_error_count(&self): i32 {
        return self.error_count
    }

    fn get_error(&self, index: i32): string {
        if index < 0 || index >= self.error_count {
            return ""
        }
        return self.load_errors[index]
    }

    // Helper functions
    fn split_property(&self, line: string): PropertyParts {
        let eq_pos = index_of(line, "=")
        if eq_pos >= 0 {
            return PropertyParts {
                key: trim(substring(line, 0, eq_pos)),
                value: trim(substring_from(line, eq_pos + 1)),
            }
        }

        let space_pos = index_of(line, " ")
        if space_pos >= 0 {
            return PropertyParts {
                key: trim(substring(line, 0, space_pos)),
                value: trim(substring_from(line, space_pos + 1)),
            }
        }

        return PropertyParts { key: line, value: "" }
    }

    fn parse_f64(&self, value: string): f64 {
        return parse_float(trim(value))
    }

    fn parse_i32(&self, value: string): i32 {
        return parse_int(trim(value))
    }

    fn parse_percent(&self, value: string): f64 {
        let trimmed = replace(trim(value), "%", "")
        let val = parse_float(trimmed)
        if val == 0.0 {
            return 1.0
        }
        return val / 100.0
    }

    fn add_error(&self, msg: string) {
        if self.error_count < MAX_LOAD_ERRORS {
            self.load_errors[self.error_count] = msg
            self.error_count = self.error_count + 1
        }
    }
}

