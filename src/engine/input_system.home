// Input System - Mouse, keyboard, hotkeys, control groups
// Implements C&C Generals Zero Hour input handling

// ============================================================================
// KEY CODES
// ============================================================================

enum KeyCode {
    NONE = 0,

    // Letters
    A = 65, B = 66, C = 67, D = 68, E = 69, F = 70, G = 71, H = 72,
    I = 73, J = 74, K = 75, L = 76, M = 77, N = 78, O = 79, P = 80,
    Q = 81, R = 82, S = 83, T = 84, U = 85, V = 86, W = 87, X = 88,
    Y = 89, Z = 90,

    // Numbers
    NUM_0 = 48, NUM_1 = 49, NUM_2 = 50, NUM_3 = 51, NUM_4 = 52,
    NUM_5 = 53, NUM_6 = 54, NUM_7 = 55, NUM_8 = 56, NUM_9 = 57,

    // Function keys
    F1 = 112, F2 = 113, F3 = 114, F4 = 115, F5 = 116, F6 = 117,
    F7 = 118, F8 = 119, F9 = 120, F10 = 121, F11 = 122, F12 = 123,

    // Modifiers
    SHIFT = 16, CTRL = 17, ALT = 18,
    LEFT_SHIFT = 160, RIGHT_SHIFT = 161,
    LEFT_CTRL = 162, RIGHT_CTRL = 163,
    LEFT_ALT = 164, RIGHT_ALT = 165,

    // Special
    ESCAPE = 27, ENTER = 13, SPACE = 32, BACKSPACE = 8, TAB = 9,
    DELETE = 46, INSERT = 45, HOME = 36, END = 35,
    PAGE_UP = 33, PAGE_DOWN = 34,

    // Arrows
    LEFT = 37, UP = 38, RIGHT = 39, DOWN = 40,

    // Numpad
    NUMPAD_0 = 96, NUMPAD_1 = 97, NUMPAD_2 = 98, NUMPAD_3 = 99,
    NUMPAD_4 = 100, NUMPAD_5 = 101, NUMPAD_6 = 102, NUMPAD_7 = 103,
    NUMPAD_8 = 104, NUMPAD_9 = 105,
    NUMPAD_MULTIPLY = 106, NUMPAD_ADD = 107, NUMPAD_SUBTRACT = 109,
    NUMPAD_DECIMAL = 110, NUMPAD_DIVIDE = 111,
}

enum MouseButton {
    NONE = 0,
    LEFT = 1,
    RIGHT = 2,
    MIDDLE = 3,
    BUTTON_4 = 4,
    BUTTON_5 = 5,
}

// ============================================================================
// INPUT STATE
// ============================================================================

struct KeyState {
    is_down: bool,
    was_down: bool,
    press_time: f64,
    release_time: f64,
}

impl KeyState {
    fn init(): KeyState {
        return KeyState {
            is_down: false,
            was_down: false,
            press_time: 0.0,
            release_time: 0.0,
        }
    }
}

struct MouseState {
    x: i32,
    y: i32,
    prev_x: i32,
    prev_y: i32,
    delta_x: i32,
    delta_y: i32,
    scroll_delta: f64,

    buttons: [KeyState],

    // Drag state
    is_dragging: bool,
    drag_start_x: i32,
    drag_start_y: i32,
    drag_button: MouseButton,
}

impl MouseState {
    fn init(): MouseState {
        // Initialize 6 button states
        let buttons: [KeyState] = []
        for i in 0..6 {
            buttons = buttons + [KeyState::init()]
        }

        return MouseState {
            x: 0,
            y: 0,
            prev_x: 0,
            prev_y: 0,
            delta_x: 0,
            delta_y: 0,
            scroll_delta: 0.0,
            buttons: buttons,
            is_dragging: false,
            drag_start_x: 0,
            drag_start_y: 0,
            drag_button: MouseButton::NONE,
        }
    }
}

struct InputState {
    keys: [KeyState],
    mouse: MouseState,

    // Modifiers
    shift_held: bool,
    ctrl_held: bool,
    alt_held: bool,

    // Text input
    text_input_buffer: string,
    text_input_active: bool,

    // Time
    current_time: f64,
}

impl InputState {
    fn init(): InputState {
        // Initialize 256 key states
        let keys: [KeyState] = []
        for i in 0..256 {
            keys = keys + [KeyState::init()]
        }

        return InputState {
            keys: keys,
            mouse: MouseState::init(),
            shift_held: false,
            ctrl_held: false,
            alt_held: false,
            text_input_buffer: "",
            text_input_active: false,
            current_time: 0.0,
        }
    }

    fn update(&self, delta_time: f64) {
        self.current_time = self.current_time + delta_time

        // Update previous states
        for i in 0..256 {
            self.keys[i].was_down = self.keys[i].is_down
        }

        for i in 0..6 {
            self.mouse.buttons[i].was_down = self.mouse.buttons[i].is_down
        }

        // Update mouse delta
        self.mouse.delta_x = self.mouse.x - self.mouse.prev_x
        self.mouse.delta_y = self.mouse.y - self.mouse.prev_y
        self.mouse.prev_x = self.mouse.x
        self.mouse.prev_y = self.mouse.y

        // Update modifiers
        let shift_idx = 16  // KeyCode::SHIFT
        let left_shift_idx = 160
        let right_shift_idx = 161
        self.shift_held = self.keys[shift_idx].is_down ||
                          self.keys[left_shift_idx].is_down ||
                          self.keys[right_shift_idx].is_down

        let ctrl_idx = 17  // KeyCode::CTRL
        let left_ctrl_idx = 162
        let right_ctrl_idx = 163
        self.ctrl_held = self.keys[ctrl_idx].is_down ||
                         self.keys[left_ctrl_idx].is_down ||
                         self.keys[right_ctrl_idx].is_down

        let alt_idx = 18  // KeyCode::ALT
        let left_alt_idx = 164
        let right_alt_idx = 165
        self.alt_held = self.keys[alt_idx].is_down ||
                        self.keys[left_alt_idx].is_down ||
                        self.keys[right_alt_idx].is_down

        // Reset scroll
        self.mouse.scroll_delta = 0.0
    }

    fn on_key_down(&self, key: i32) {
        if key >= 0 && key < 256 {
            if !self.keys[key].is_down {
                self.keys[key].press_time = self.current_time
            }
            self.keys[key].is_down = true
        }
    }

    fn on_key_up(&self, key: i32) {
        if key >= 0 && key < 256 {
            self.keys[key].is_down = false
            self.keys[key].release_time = self.current_time
        }
    }

    fn on_mouse_move(&self, x: i32, y: i32) {
        self.mouse.x = x
        self.mouse.y = y
    }

    fn on_mouse_down(&self, button: i32) {
        if button >= 0 && button < 6 {
            if !self.mouse.buttons[button].is_down {
                self.mouse.buttons[button].press_time = self.current_time
            }
            self.mouse.buttons[button].is_down = true

            // Start drag
            if !self.mouse.is_dragging {
                self.mouse.is_dragging = true
                self.mouse.drag_start_x = self.mouse.x
                self.mouse.drag_start_y = self.mouse.y
                // Store button as drag button
                if button == 0 {
                    self.mouse.drag_button = MouseButton::NONE
                } else if button == 1 {
                    self.mouse.drag_button = MouseButton::LEFT
                } else if button == 2 {
                    self.mouse.drag_button = MouseButton::RIGHT
                } else if button == 3 {
                    self.mouse.drag_button = MouseButton::MIDDLE
                } else if button == 4 {
                    self.mouse.drag_button = MouseButton::BUTTON_4
                } else if button == 5 {
                    self.mouse.drag_button = MouseButton::BUTTON_5
                }
            }
        }
    }

    fn on_mouse_up(&self, button: i32) {
        if button >= 0 && button < 6 {
            self.mouse.buttons[button].is_down = false
            self.mouse.buttons[button].release_time = self.current_time

            // End drag if same button
            if self.mouse.is_dragging {
                let drag_btn_idx = 0
                if self.mouse.drag_button == MouseButton::LEFT {
                    drag_btn_idx = 1
                } else if self.mouse.drag_button == MouseButton::RIGHT {
                    drag_btn_idx = 2
                } else if self.mouse.drag_button == MouseButton::MIDDLE {
                    drag_btn_idx = 3
                } else if self.mouse.drag_button == MouseButton::BUTTON_4 {
                    drag_btn_idx = 4
                } else if self.mouse.drag_button == MouseButton::BUTTON_5 {
                    drag_btn_idx = 5
                }

                if drag_btn_idx == button {
                    self.mouse.is_dragging = false
                }
            }
        }
    }

    fn on_mouse_scroll(&self, delta: f64) {
        self.mouse.scroll_delta = self.mouse.scroll_delta + delta
    }

    fn on_text_input(&self, char_code: i32) {
        if self.text_input_active && self.text_input_buffer.len() < 255 {
            // Would append character to buffer
        }
    }
}

// ============================================================================
// INPUT QUERIES
// ============================================================================

fn is_key_down(state: InputState, key: KeyCode): bool {
    let key_idx = key_code_to_int(key)
    if key_idx >= 0 && key_idx < 256 {
        return state.keys[key_idx].is_down
    }
    return false
}

fn is_key_pressed(state: InputState, key: KeyCode): bool {
    let k = key_code_to_int(key)
    if k >= 0 && k < 256 {
        return state.keys[k].is_down && !state.keys[k].was_down
    }
    return false
}

fn is_key_released(state: InputState, key: KeyCode): bool {
    let k = key_code_to_int(key)
    if k >= 0 && k < 256 {
        return !state.keys[k].is_down && state.keys[k].was_down
    }
    return false
}

fn is_mouse_down(state: InputState, button: MouseButton): bool {
    let b = mouse_button_to_int(button)
    if b >= 0 && b < 6 {
        return state.mouse.buttons[b].is_down
    }
    return false
}

fn is_mouse_pressed(state: InputState, button: MouseButton): bool {
    let b = mouse_button_to_int(button)
    if b >= 0 && b < 6 {
        return state.mouse.buttons[b].is_down && !state.mouse.buttons[b].was_down
    }
    return false
}

fn is_mouse_released(state: InputState, button: MouseButton): bool {
    let b = mouse_button_to_int(button)
    if b >= 0 && b < 6 {
        return !state.mouse.buttons[b].is_down && state.mouse.buttons[b].was_down
    }
    return false
}

fn is_double_click(state: InputState, button: MouseButton, threshold: f64): bool {
    let b = mouse_button_to_int(button)
    if !is_mouse_pressed(state, button) {
        return false
    }

    if b >= 0 && b < 6 {
        let time_since_last = state.current_time - state.mouse.buttons[b].release_time
        return time_since_last < threshold
    }
    return false
}

fn get_mouse_position(state: InputState): [i32] {
    let pos: [i32] = []
    pos = pos + [state.mouse.x]
    pos = pos + [state.mouse.y]
    return pos
}

fn get_mouse_delta(state: InputState): [i32] {
    let delta: [i32] = []
    delta = delta + [state.mouse.delta_x]
    delta = delta + [state.mouse.delta_y]
    return delta
}

fn get_drag_rect(state: InputState): [i32] {
    if !state.mouse.is_dragging {
        let empty: [i32] = []
        empty = empty + [0]
        empty = empty + [0]
        empty = empty + [0]
        empty = empty + [0]
        return empty
    }

    let x1 = min_i32(state.mouse.drag_start_x, state.mouse.x)
    let y1 = min_i32(state.mouse.drag_start_y, state.mouse.y)
    let x2 = max_i32(state.mouse.drag_start_x, state.mouse.x)
    let y2 = max_i32(state.mouse.drag_start_y, state.mouse.y)

    let rect: [i32] = []
    rect = rect + [x1]
    rect = rect + [y1]
    rect = rect + [x2 - x1]
    rect = rect + [y2 - y1]
    return rect
}

fn min_i32(a: i32, b: i32): i32 {
    if a < b {
        return a
    }
    return b
}

fn max_i32(a: i32, b: i32): i32 {
    if a > b {
        return a
    }
    return b
}

// Helper functions for enum conversion
fn key_code_to_int(key: KeyCode): i32 {
    if key == KeyCode::NONE { return 0 }
    if key == KeyCode::A { return 65 }
    if key == KeyCode::B { return 66 }
    if key == KeyCode::C { return 67 }
    if key == KeyCode::D { return 68 }
    if key == KeyCode::E { return 69 }
    if key == KeyCode::F { return 70 }
    if key == KeyCode::G { return 71 }
    if key == KeyCode::H { return 72 }
    if key == KeyCode::I { return 73 }
    if key == KeyCode::J { return 74 }
    if key == KeyCode::K { return 75 }
    if key == KeyCode::L { return 76 }
    if key == KeyCode::M { return 77 }
    if key == KeyCode::N { return 78 }
    if key == KeyCode::O { return 79 }
    if key == KeyCode::P { return 80 }
    if key == KeyCode::Q { return 81 }
    if key == KeyCode::R { return 82 }
    if key == KeyCode::S { return 83 }
    if key == KeyCode::T { return 84 }
    if key == KeyCode::U { return 85 }
    if key == KeyCode::V { return 86 }
    if key == KeyCode::W { return 87 }
    if key == KeyCode::X { return 88 }
    if key == KeyCode::Y { return 89 }
    if key == KeyCode::Z { return 90 }
    if key == KeyCode::NUM_0 { return 48 }
    if key == KeyCode::NUM_1 { return 49 }
    if key == KeyCode::NUM_2 { return 50 }
    if key == KeyCode::NUM_3 { return 51 }
    if key == KeyCode::NUM_4 { return 52 }
    if key == KeyCode::NUM_5 { return 53 }
    if key == KeyCode::NUM_6 { return 54 }
    if key == KeyCode::NUM_7 { return 55 }
    if key == KeyCode::NUM_8 { return 56 }
    if key == KeyCode::NUM_9 { return 57 }
    if key == KeyCode::F1 { return 112 }
    if key == KeyCode::F2 { return 113 }
    if key == KeyCode::F3 { return 114 }
    if key == KeyCode::F4 { return 115 }
    if key == KeyCode::F5 { return 116 }
    if key == KeyCode::F6 { return 117 }
    if key == KeyCode::F7 { return 118 }
    if key == KeyCode::F8 { return 119 }
    if key == KeyCode::F9 { return 120 }
    if key == KeyCode::F10 { return 121 }
    if key == KeyCode::F11 { return 122 }
    if key == KeyCode::F12 { return 123 }
    if key == KeyCode::SHIFT { return 16 }
    if key == KeyCode::CTRL { return 17 }
    if key == KeyCode::ALT { return 18 }
    if key == KeyCode::LEFT_SHIFT { return 160 }
    if key == KeyCode::RIGHT_SHIFT { return 161 }
    if key == KeyCode::LEFT_CTRL { return 162 }
    if key == KeyCode::RIGHT_CTRL { return 163 }
    if key == KeyCode::LEFT_ALT { return 164 }
    if key == KeyCode::RIGHT_ALT { return 165 }
    if key == KeyCode::ESCAPE { return 27 }
    if key == KeyCode::ENTER { return 13 }
    if key == KeyCode::SPACE { return 32 }
    if key == KeyCode::BACKSPACE { return 8 }
    if key == KeyCode::TAB { return 9 }
    if key == KeyCode::DELETE { return 46 }
    if key == KeyCode::INSERT { return 45 }
    if key == KeyCode::HOME { return 36 }
    if key == KeyCode::END { return 35 }
    if key == KeyCode::PAGE_UP { return 33 }
    if key == KeyCode::PAGE_DOWN { return 34 }
    if key == KeyCode::LEFT { return 37 }
    if key == KeyCode::UP { return 38 }
    if key == KeyCode::RIGHT { return 39 }
    if key == KeyCode::DOWN { return 40 }
    if key == KeyCode::NUMPAD_0 { return 96 }
    if key == KeyCode::NUMPAD_1 { return 97 }
    if key == KeyCode::NUMPAD_2 { return 98 }
    if key == KeyCode::NUMPAD_3 { return 99 }
    if key == KeyCode::NUMPAD_4 { return 100 }
    if key == KeyCode::NUMPAD_5 { return 101 }
    if key == KeyCode::NUMPAD_6 { return 102 }
    if key == KeyCode::NUMPAD_7 { return 103 }
    if key == KeyCode::NUMPAD_8 { return 104 }
    if key == KeyCode::NUMPAD_9 { return 105 }
    if key == KeyCode::NUMPAD_MULTIPLY { return 106 }
    if key == KeyCode::NUMPAD_ADD { return 107 }
    if key == KeyCode::NUMPAD_SUBTRACT { return 109 }
    if key == KeyCode::NUMPAD_DECIMAL { return 110 }
    if key == KeyCode::NUMPAD_DIVIDE { return 111 }
    return 0
}

fn mouse_button_to_int(button: MouseButton): i32 {
    if button == MouseButton::NONE { return 0 }
    if button == MouseButton::LEFT { return 1 }
    if button == MouseButton::RIGHT { return 2 }
    if button == MouseButton::MIDDLE { return 3 }
    if button == MouseButton::BUTTON_4 { return 4 }
    if button == MouseButton::BUTTON_5 { return 5 }
    return 0
}

// ============================================================================
// HOTKEY SYSTEM
// ============================================================================

enum GameAction {
    // Selection
    SELECT_ALL,
    SELECT_ALL_SCREEN,
    DESELECT,

    // Movement
    MOVE,
    ATTACK_MOVE,
    FORCE_MOVE,
    STOP,
    GUARD,
    SCATTER,
    PATROL,

    // Combat
    FORCE_ATTACK,
    DEPLOY,
    SELL,
    REPAIR,

    // Camera
    CAMERA_PAN_LEFT,
    CAMERA_PAN_RIGHT,
    CAMERA_PAN_UP,
    CAMERA_PAN_DOWN,
    CAMERA_ZOOM_IN,
    CAMERA_ZOOM_OUT,
    CAMERA_ROTATE_LEFT,
    CAMERA_ROTATE_RIGHT,
    CENTER_ON_SELECTION,
    GO_TO_BASE,

    // Control groups
    GROUP_0, GROUP_1, GROUP_2, GROUP_3, GROUP_4,
    GROUP_5, GROUP_6, GROUP_7, GROUP_8, GROUP_9,

    // Misc
    TOGGLE_MINIMAP,
    TOGGLE_SIDEBAR,
    PAUSE_GAME,
    QUICK_SAVE,
    QUICK_LOAD,
    SCREENSHOT,
    CHAT,
    DIPLOMACY,
}

struct Hotkey {
    action: GameAction,
    primary_key: KeyCode,
    modifier: i32,           // Bitmask: 1=Shift, 2=Ctrl, 4=Alt
    is_enabled: bool,
}

impl Hotkey {
    fn init(action: GameAction, key: KeyCode, modifier: i32): Hotkey {
        return Hotkey {
            action: action,
            primary_key: key,
            modifier: modifier,
            is_enabled: true,
        }
    }
}

struct HotkeyManager {
    hotkeys: [Hotkey],
    triggered_actions: [GameAction],
}

impl HotkeyManager {
    fn init(): HotkeyManager {
        let hm = HotkeyManager {
            hotkeys: [],
            triggered_actions: [],
        }

        // Register default hotkeys
        hm.register(GameAction::SELECT_ALL, KeyCode::A, 2)        // Ctrl+A
        hm.register(GameAction::ATTACK_MOVE, KeyCode::A, 0)       // A
        hm.register(GameAction::STOP, KeyCode::S, 0)              // S
        hm.register(GameAction::GUARD, KeyCode::G, 0)             // G
        hm.register(GameAction::SCATTER, KeyCode::X, 0)           // X
        hm.register(GameAction::FORCE_ATTACK, KeyCode::F, 2)      // Ctrl+F
        hm.register(GameAction::DEPLOY, KeyCode::D, 0)            // D
        hm.register(GameAction::SELL, KeyCode::Z, 0)              // Z
        hm.register(GameAction::REPAIR, KeyCode::R, 0)            // R
        hm.register(GameAction::CENTER_ON_SELECTION, KeyCode::SPACE, 0)
        hm.register(GameAction::GO_TO_BASE, KeyCode::H, 0)        // H

        // Control groups
        hm.register(GameAction::GROUP_0, KeyCode::NUM_0, 0)
        hm.register(GameAction::GROUP_1, KeyCode::NUM_1, 0)
        hm.register(GameAction::GROUP_2, KeyCode::NUM_2, 0)
        hm.register(GameAction::GROUP_3, KeyCode::NUM_3, 0)
        hm.register(GameAction::GROUP_4, KeyCode::NUM_4, 0)
        hm.register(GameAction::GROUP_5, KeyCode::NUM_5, 0)
        hm.register(GameAction::GROUP_6, KeyCode::NUM_6, 0)
        hm.register(GameAction::GROUP_7, KeyCode::NUM_7, 0)
        hm.register(GameAction::GROUP_8, KeyCode::NUM_8, 0)
        hm.register(GameAction::GROUP_9, KeyCode::NUM_9, 0)

        // Camera
        hm.register(GameAction::CAMERA_PAN_LEFT, KeyCode::LEFT, 0)
        hm.register(GameAction::CAMERA_PAN_RIGHT, KeyCode::RIGHT, 0)
        hm.register(GameAction::CAMERA_PAN_UP, KeyCode::UP, 0)
        hm.register(GameAction::CAMERA_PAN_DOWN, KeyCode::DOWN, 0)

        // Misc
        hm.register(GameAction::PAUSE_GAME, KeyCode::ESCAPE, 0)
        hm.register(GameAction::QUICK_SAVE, KeyCode::F5, 0)
        hm.register(GameAction::QUICK_LOAD, KeyCode::F9, 0)
        hm.register(GameAction::SCREENSHOT, KeyCode::F12, 0)
        hm.register(GameAction::CHAT, KeyCode::ENTER, 0)

        return hm
    }

    fn register(&self, action: GameAction, key: KeyCode, modifier: i32) {
        self.hotkeys = self.hotkeys + [Hotkey::init(action, key, modifier)]
    }

    fn rebind(&self, action: GameAction, new_key: KeyCode, new_modifier: i32) {
        for i in 0..self.hotkeys.length {
            if self.hotkeys[i].action == action {
                self.hotkeys[i].primary_key = new_key
                self.hotkeys[i].modifier = new_modifier
                break
            }
        }
    }

    fn update(&self, input: InputState) {
        self.triggered_actions = []

        for i in 0..self.hotkeys.length {
            let hotkey = self.hotkeys[i]

            if !hotkey.is_enabled {
                continue
            }

            // Check key pressed
            if !is_key_pressed(input, hotkey.primary_key) {
                continue
            }

            // Check modifiers
            let need_shift = (hotkey.modifier & 1) != 0
            let need_ctrl = (hotkey.modifier & 2) != 0
            let need_alt = (hotkey.modifier & 4) != 0

            if need_shift != input.shift_held { continue }
            if need_ctrl != input.ctrl_held { continue }
            if need_alt != input.alt_held { continue }

            // Trigger action
            self.triggered_actions = self.triggered_actions + [hotkey.action]
        }
    }

    fn was_triggered(&self, action: GameAction): bool {
        for i in 0..self.triggered_actions.length {
            if self.triggered_actions[i] == action {
                return true
            }
        }
        return false
    }
}

// ============================================================================
// CONTROL GROUPS
// ============================================================================

struct ControlGroup {
    unit_ids: [i32],
    center_x: f64,
    center_y: f64,
}

impl ControlGroup {
    fn init(): ControlGroup {
        return ControlGroup {
            unit_ids: [],
            center_x: 0.0,
            center_y: 0.0,
        }
    }
}

struct ControlGroupManager {
    groups: [ControlGroup],
    last_selected_group: i32,
}

impl ControlGroupManager {
    fn init(): ControlGroupManager {
        let groups: [ControlGroup] = []
        for i in 0..10 {
            groups = groups + [ControlGroup::init()]
        }

        return ControlGroupManager {
            groups: groups,
            last_selected_group: -1,
        }
    }

    fn assign(&self, group_num: i32, unit_ids: [i32]) {
        if group_num < 0 || group_num >= 10 {
            return
        }

        // Copy unit IDs
        self.groups[group_num].unit_ids = []
        for i in 0..unit_ids.length {
            self.groups[group_num].unit_ids = self.groups[group_num].unit_ids + [unit_ids[i]]
        }
    }

    fn add_to(&self, group_num: i32, unit_ids: [i32]) {
        if group_num < 0 || group_num >= 10 {
            return
        }

        for i in 0..unit_ids.length {
            // Check if already in group
            let found = false
            for j in 0..self.groups[group_num].unit_ids.length {
                if self.groups[group_num].unit_ids[j] == unit_ids[i] {
                    found = true
                    break
                }
            }

            // Add if not found
            if !found {
                self.groups[group_num].unit_ids = self.groups[group_num].unit_ids + [unit_ids[i]]
            }
        }
    }

    fn get_units(&self, group_num: i32): [i32] {
        if group_num < 0 || group_num >= 10 {
            return []
        }
        return self.groups[group_num].unit_ids
    }

    fn get_count(&self, group_num: i32): i32 {
        if group_num < 0 || group_num >= 10 {
            return 0
        }
        return self.groups[group_num].unit_ids.length
    }

    fn select(&self, group_num: i32, double_tap: bool): [i32] {
        if group_num < 0 || group_num >= 10 {
            return []
        }

        // Double tap same group = center camera on group
        if double_tap && self.last_selected_group == group_num {
            // Would signal camera to center
        }

        self.last_selected_group = group_num
        return self.groups[group_num].unit_ids
    }

    fn remove_unit(&self, unit_id: i32) {
        for g in 0..10 {
            let new_ids: [i32] = []
            for i in 0..self.groups[g].unit_ids.length {
                if self.groups[g].unit_ids[i] != unit_id {
                    new_ids = new_ids + [self.groups[g].unit_ids[i]]
                }
            }
            self.groups[g].unit_ids = new_ids
        }
    }
}

// ============================================================================
// EDGE SCROLL
// ============================================================================

struct EdgeScrollConfig {
    enabled: bool,
    margin: i32,           // Pixels from edge
    speed: f64,            // Scroll speed
    acceleration: f64,
    current_speed_x: f64,
    current_speed_y: f64,
}

impl EdgeScrollConfig {
    fn init(): EdgeScrollConfig {
        return EdgeScrollConfig {
            enabled: true,
            margin: 10,
            speed: 500.0,
            acceleration: 2.0,
            current_speed_x: 0.0,
            current_speed_y: 0.0,
        }
    }

    fn update(&self, mouse_x: i32, mouse_y: i32, screen_w: i32, screen_h: i32, delta_time: f64): [f64] {
        if !self.enabled {
            let result: [f64] = []
            result = result + [0.0]
            result = result + [0.0]
            return result
        }

        let target_x: f64 = 0.0
        let target_y: f64 = 0.0

        // Left edge
        if mouse_x < self.margin {
            target_x = -self.speed
        } else if mouse_x > screen_w - self.margin {
            // Right edge
            target_x = self.speed
        }

        // Top edge
        if mouse_y < self.margin {
            target_y = -self.speed
        } else if mouse_y > screen_h - self.margin {
            // Bottom edge
            target_y = self.speed
        }

        // Smooth acceleration
        self.current_speed_x = self.current_speed_x + (target_x - self.current_speed_x) * self.acceleration * delta_time
        self.current_speed_y = self.current_speed_y + (target_y - self.current_speed_y) * self.acceleration * delta_time

        let result: [f64] = []
        result = result + [self.current_speed_x * delta_time]
        result = result + [self.current_speed_y * delta_time]
        return result
    }
}

// ============================================================================
// CURSOR SYSTEM
// ============================================================================

enum CursorType {
    NORMAL,
    SELECT,
    MOVE,
    ATTACK,
    ATTACK_MOVE,
    GUARD,
    REPAIR,
    SELL,
    BUILD_OK,
    BUILD_BLOCKED,
    GARRISON,
    CAPTURE,
    SCROLL_N, SCROLL_NE, SCROLL_E, SCROLL_SE,
    SCROLL_S, SCROLL_SW, SCROLL_W, SCROLL_NW,
    BUSY,
    INVALID,
}

struct CursorManager {
    current_cursor: CursorType,
    cursor_textures: [i32],
    hotspot_x: [i32],
    hotspot_y: [i32],
    is_animated: [bool],
    animation_frame: i32,
    animation_timer: f64,
}

impl CursorManager {
    fn init(): CursorManager {
        // Initialize arrays for 32 cursor types
        let textures: [i32] = []
        let hx: [i32] = []
        let hy: [i32] = []
        let animated: [bool] = []

        for i in 0..32 {
            textures = textures + [-1]
            hx = hx + [0]
            hy = hy + [0]
            animated = animated + [false]
        }

        return CursorManager {
            current_cursor: CursorType::NORMAL,
            cursor_textures: textures,
            hotspot_x: hx,
            hotspot_y: hy,
            is_animated: animated,
            animation_frame: 0,
            animation_timer: 0.0,
        }
    }

    fn set(&self, cursor: CursorType) {
        self.current_cursor = cursor
        self.animation_frame = 0
        self.animation_timer = 0.0
    }

    fn update(&self, delta_time: f64) {
        let cursor_idx = cursor_type_to_int(self.current_cursor)
        if cursor_idx >= 0 && cursor_idx < 32 {
            if self.is_animated[cursor_idx] {
                self.animation_timer = self.animation_timer + delta_time
                if self.animation_timer >= 0.1 {
                    self.animation_timer = 0.0
                    self.animation_frame = self.animation_frame + 1
                }
            }
        }
    }
}

fn cursor_type_to_int(cursor: CursorType): i32 {
    if cursor == CursorType::NORMAL { return 0 }
    if cursor == CursorType::SELECT { return 1 }
    if cursor == CursorType::MOVE { return 2 }
    if cursor == CursorType::ATTACK { return 3 }
    if cursor == CursorType::ATTACK_MOVE { return 4 }
    if cursor == CursorType::GUARD { return 5 }
    if cursor == CursorType::REPAIR { return 6 }
    if cursor == CursorType::SELL { return 7 }
    if cursor == CursorType::BUILD_OK { return 8 }
    if cursor == CursorType::BUILD_BLOCKED { return 9 }
    if cursor == CursorType::GARRISON { return 10 }
    if cursor == CursorType::CAPTURE { return 11 }
    if cursor == CursorType::SCROLL_N { return 12 }
    if cursor == CursorType::SCROLL_NE { return 13 }
    if cursor == CursorType::SCROLL_E { return 14 }
    if cursor == CursorType::SCROLL_SE { return 15 }
    if cursor == CursorType::SCROLL_S { return 16 }
    if cursor == CursorType::SCROLL_SW { return 17 }
    if cursor == CursorType::SCROLL_W { return 18 }
    if cursor == CursorType::SCROLL_NW { return 19 }
    if cursor == CursorType::BUSY { return 20 }
    if cursor == CursorType::INVALID { return 21 }
    return 0
}

fn get_cursor_for_target(target_type: i32, is_enemy: bool, is_friendly: bool, can_attack: bool): CursorType {
    if target_type == 0 {
        // Ground
        return CursorType::MOVE
    } else if target_type == 1 {
        // Unit
        if is_enemy && can_attack {
            return CursorType::ATTACK
        } else if is_friendly {
            return CursorType::SELECT
        }
    } else if target_type == 2 {
        // Building
        if is_enemy && can_attack {
            return CursorType::ATTACK
        } else if is_friendly {
            return CursorType::SELECT
        }
    }

    return CursorType::NORMAL
}

// ============================================================================
// GLOBAL INPUT SYSTEM
// ============================================================================

let g_input_state: InputState? = null
let g_hotkey_manager: HotkeyManager? = null
let g_control_groups: ControlGroupManager? = null
let g_edge_scroll: EdgeScrollConfig? = null
let g_cursor_manager: CursorManager? = null

fn init_input_system() {
    g_input_state = InputState::init()
    g_hotkey_manager = HotkeyManager::init()
    g_control_groups = ControlGroupManager::init()
    g_edge_scroll = EdgeScrollConfig::init()
    g_cursor_manager = CursorManager::init()
}

fn get_input_state(): InputState? {
    return g_input_state
}

fn get_hotkey_manager(): HotkeyManager? {
    return g_hotkey_manager
}

fn get_control_groups(): ControlGroupManager? {
    return g_control_groups
}

fn shutdown_input_system() {
    g_input_state = null
    g_hotkey_manager = null
    g_control_groups = null
    g_edge_scroll = null
    g_cursor_manager = null
}
