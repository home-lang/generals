// staging_room.home - Pre-game lobby and staging room system
// Full implementation of multiplayer game setup lobby

let MAX_SLOTS: i32 = 8
let MAX_OBSERVERS: i32 = 4
let MAX_CHAT_MESSAGES: i32 = 100
let READY_COUNTDOWN_MS: i32 = 5000
let MAP_PREVIEW_SIZE: i32 = 256

// ============================================================================
// Slot Configuration
// ============================================================================

enum SlotState {
    EMPTY,
    OPEN,
    CLOSED,
    HUMAN,
    AI,
    OBSERVER,
}

enum SlotColor {
    RANDOM,
    GOLD,
    RED,
    BLUE,
    GREEN,
    ORANGE,
    CYAN,
    PURPLE,
    PINK,
}

enum AIPersonality {
    EASY,
    MEDIUM,
    HARD,
    BRUTAL,
    CUSTOM,
}

enum TeamId {
    NO_TEAM,
    TEAM1,
    TEAM2,
    TEAM3,
    TEAM4,
}

enum Faction {
    RANDOM,
    USA,
    USA_AIR_FORCE,
    USA_LASER,
    USA_SUPER_WEAPON,
    CHINA,
    CHINA_TANK,
    CHINA_INFANTRY,
    CHINA_NUKE,
    GLA,
    GLA_TOXIN,
    GLA_STEALTH,
    GLA_DEMO,
}

struct SlotSettings {
    state: SlotState,
    color: SlotColor,
    team: TeamId,
    faction: Faction,
    handicap: i32,
    start_position: i32,
    ai_personality: AIPersonality,
    ai_difficulty_override: f32,
}

impl SlotSettings {
    fn init(): SlotSettings {
        return SlotSettings {
            state: SlotState::OPEN,
            color: SlotColor::RANDOM,
            team: TeamId::NO_TEAM,
            faction: Faction::RANDOM,
            handicap: 100,
            start_position: -1,
            ai_personality: AIPersonality::MEDIUM,
            ai_difficulty_override: 0.5,
        }
    }
}

struct PlayerSlot {
    slot_id: i32,
    settings: SlotSettings,
    player_id: i32,
    player_name: string,
    ping_ms: i32,
    is_ready: bool,
    is_host: bool,
    is_loading: bool,
    load_progress: f32,
}

impl PlayerSlot {
    fn init(id: i32): PlayerSlot {
        return PlayerSlot {
            slot_id: id,
            settings: SlotSettings::init(),
            player_id: 0,
            player_name: "",
            ping_ms: 0,
            is_ready: false,
            is_host: false,
            is_loading: false,
            load_progress: 0.0,
        }
    }
}

// ============================================================================
// Game Settings
// ============================================================================

enum GameSpeed {
    SLOWEST,
    SLOWER,
    NORMAL,
    FASTER,
    FASTEST,
}

enum StartingCash {
    LOW,
    MEDIUM,
    HIGH,
    MEGA,
}

enum SuperweaponSetting {
    DISABLED,
    ENABLED,
}

struct GameSettings {
    map_name: string,
    map_path: string,
    map_crc: i32,
    map_size: i32,
    game_speed: GameSpeed,
    starting_cash: StartingCash,
    superweapons: SuperweaponSetting,
    limit_superweapons: bool,
    allow_observers: bool,
    lock_teams: bool,
    lock_colors: bool,
    lock_factions: bool,
    fog_of_war: bool,
    shroud: bool,
    crates: bool,
    random_crates: bool,
    build_time: f32,
    income_multiplier: f32,
    tech_level: i32,
    replay_enabled: bool,
    ranked_match: bool,
    tournament_mode: bool,
}

impl GameSettings {
    fn init(): GameSettings {
        return GameSettings {
            map_name: "Tournament Desert",
            map_path: "maps/official/tournament_desert.map",
            map_crc: 0,
            map_size: 4,
            game_speed: GameSpeed::NORMAL,
            starting_cash: StartingCash::MEDIUM,
            superweapons: SuperweaponSetting::ENABLED,
            limit_superweapons: false,
            allow_observers: true,
            lock_teams: false,
            lock_colors: false,
            lock_factions: false,
            fog_of_war: true,
            shroud: true,
            crates: false,
            random_crates: false,
            build_time: 1.0,
            income_multiplier: 1.0,
            tech_level: 3,
            replay_enabled: true,
            ranked_match: false,
            tournament_mode: false,
        }
    }
}

// ============================================================================
// Map Information
// ============================================================================

struct MapStartPosition {
    x: f32,
    y: f32,
    angle: f32,
    is_valid: bool,
}

impl MapStartPosition {
    fn init(): MapStartPosition {
        return MapStartPosition {
            x: 0.0,
            y: 0.0,
            angle: 0.0,
            is_valid: false,
        }
    }
}

struct MapInfo {
    name: string,
    path: string,
    description: string,
    author: string,
    num_players: i32,
    file_size: i32,
    crc: i32,
    is_official: bool,
    is_multiplayer: bool,
    supports_teams: bool,
    terrain_type: string,
    start_positions: [MapStartPosition],
    preview_width: i32,
    preview_height: i32,
    preview_data: [i32],
}

impl MapInfo {
    fn init(): MapInfo {
        let positions: [MapStartPosition] = []
        for i in 0..8 {
            positions = positions + [MapStartPosition::init()]
        }

        return MapInfo {
            name: "",
            path: "",
            description: "",
            author: "",
            num_players: 0,
            file_size: 0,
            crc: 0,
            is_official: false,
            is_multiplayer: false,
            supports_teams: false,
            terrain_type: "",
            start_positions: positions,
            preview_width: 0,
            preview_height: 0,
            preview_data: [],
        }
    }
}

struct MapBrowser {
    available_maps: [MapInfo],
    map_count: i32,
    filter_text: string,
    filter_players: i32,
    filter_official_only: bool,
    selected_index: i32,
}

impl MapBrowser {
    fn init(): MapBrowser {
        return MapBrowser {
            available_maps: [],
            map_count: 0,
            filter_text: "",
            filter_players: 0,
            filter_official_only: false,
            selected_index: 0,
        }
    }

    fn scan_maps(&self, base_path: string) {
        self.map_count = 0
        // Scan directory for .map files
        // Parse map headers for info
        // Build preview thumbnails
    }

    fn filter_maps(&self): [MapInfo] {
        let results: [MapInfo] = []

        for i in 0..self.map_count {
            let map = self.available_maps[i]

            // Apply filters
            if self.filter_players > 0 && map.num_players != self.filter_players {
                continue
            }

            if self.filter_official_only && !map.is_official {
                continue
            }

            if string_length(self.filter_text) > 0 {
                if !string_contains_ignore_case(map.name, self.filter_text) {
                    continue
                }
            }

            results = results + [map]
        }

        return results
    }

    fn get_selected_map(&self): MapInfo? {
        if self.selected_index >= 0 && self.selected_index < self.map_count {
            return self.available_maps[self.selected_index]
        }
        return null
    }
}

// ============================================================================
// Chat System
// ============================================================================

struct LobbyChatMessage {
    sender_id: i32,
    sender_name: string,
    message: string,
    timestamp: i32,
    is_system: bool,
    is_team_only: bool,
}

impl LobbyChatMessage {
    fn init(): LobbyChatMessage {
        return LobbyChatMessage {
            sender_id: 0,
            sender_name: "",
            message: "",
            timestamp: 0,
            is_system: false,
            is_team_only: false,
        }
    }
}

struct LobbyChat {
    messages: [LobbyChatMessage],
    message_count: i32,
    unread_count: i32,
}

impl LobbyChat {
    fn init(): LobbyChat {
        return LobbyChat {
            messages: [],
            message_count: 0,
            unread_count: 0,
        }
    }

    fn add_message(&self, sender_id: i32, sender_name: string, message: string, is_team: bool) {
        let msg = LobbyChatMessage {
            sender_id: sender_id,
            sender_name: sender_name,
            message: message,
            timestamp: get_current_time_ms(),
            is_system: false,
            is_team_only: is_team,
        }

        self.messages = self.messages + [msg]
        self.message_count = self.message_count + 1
        self.unread_count = self.unread_count + 1
    }

    fn add_system_message(&self, message: string) {
        let msg = LobbyChatMessage {
            sender_id: 0,
            sender_name: "System",
            message: message,
            timestamp: get_current_time_ms(),
            is_system: true,
            is_team_only: false,
        }

        self.messages = self.messages + [msg]
        self.message_count = self.message_count + 1
        self.unread_count = self.unread_count + 1
    }

    fn mark_read(&self) {
        self.unread_count = 0
    }
}

// ============================================================================
// Staging Room State
// ============================================================================

enum StagingRoomState {
    INITIALIZING,
    WAITING_FOR_PLAYERS,
    COUNTING_DOWN,
    LOADING,
    LAUNCHING,
    CANCELLED,
    ERROR,
}

enum ReadyCheckResult {
    ALL_READY,
    NOT_ALL_READY,
    MISSING_PLAYERS,
    INVALID_SETTINGS,
    MAP_MISMATCH,
}

struct StagingRoomConfig {
    max_players: i32,
    max_observers: i32,
    countdown_time_ms: i32,
    auto_start: bool,
    allow_late_join: bool,
    min_players: i32,
    host_only_settings: bool,
}

impl StagingRoomConfig {
    fn init(): StagingRoomConfig {
        return StagingRoomConfig {
            max_players: 8,
            max_observers: 4,
            countdown_time_ms: 5000,
            auto_start: false,
            allow_late_join: false,
            min_players: 2,
            host_only_settings: true,
        }
    }
}

// ============================================================================
// Staging Room Manager
// ============================================================================

struct StagingRoom {
    config: StagingRoomConfig,
    state: StagingRoomState,
    room_id: i32,
    room_name: string,
    room_password: string,
    is_private: bool,
    host_id: i32,
    slots: [PlayerSlot],
    observer_slots: [PlayerSlot],
    game_settings: GameSettings,
    map_browser: MapBrowser,
    chat: LobbyChat,
    countdown_start_time: i32,
    countdown_remaining_ms: i32,
    last_sync_frame: i32,
    pending_changes: bool,
}

impl StagingRoom {
    fn init(config: StagingRoomConfig): StagingRoom {
        let slots: [PlayerSlot] = []
        for i in 0..MAX_SLOTS {
            let slot = PlayerSlot::init(i)
            if i < 2 {
                slot.settings.state = SlotState::OPEN
            } else {
                slot.settings.state = SlotState::CLOSED
            }
            slots = slots + [slot]
        }

        let observer_slots: [PlayerSlot] = []
        for i in 0..MAX_OBSERVERS {
            let slot = PlayerSlot::init(i + MAX_SLOTS)
            slot.settings.state = SlotState::EMPTY
            observer_slots = observer_slots + [slot]
        }

        return StagingRoom {
            config: config,
            state: StagingRoomState::INITIALIZING,
            room_id: 0,
            room_name: "New Game",
            room_password: "",
            is_private: false,
            host_id: 0,
            slots: slots,
            observer_slots: observer_slots,
            game_settings: GameSettings::init(),
            map_browser: MapBrowser::init(),
            chat: LobbyChat::init(),
            countdown_start_time: 0,
            countdown_remaining_ms: 0,
            last_sync_frame: 0,
            pending_changes: false,
        }
    }

    // ========================================================================
    // Room Setup
    // ========================================================================

    fn create_room(&self, name: string, host_player_id: i32, host_name: string) {
        self.room_id = generate_room_id()
        self.room_name = name
        self.host_id = host_player_id

        // Add host to first slot
        self.slots[0].settings.state = SlotState::HUMAN
        self.slots[0].player_id = host_player_id
        self.slots[0].player_name = host_name
        self.slots[0].is_host = true
        self.slots[0].is_ready = true  // Host is always ready

        self.state = StagingRoomState::WAITING_FOR_PLAYERS
        self.chat.add_system_message("Game room created")
    }

    fn set_password(&self, password: string) {
        self.room_password = password
        self.is_private = string_length(password) > 0
    }

    // ========================================================================
    // Player Management
    // ========================================================================

    fn find_open_slot(&self): i32 {
        for i in 0..MAX_SLOTS {
            if self.slots[i].settings.state == SlotState::OPEN {
                return i
            }
        }
        return -1
    }

    fn find_observer_slot(&self): i32 {
        if !self.game_settings.allow_observers {
            return -1
        }

        for i in 0..MAX_OBSERVERS {
            if self.observer_slots[i].settings.state == SlotState::EMPTY {
                return i
            }
        }
        return -1
    }

    fn add_player(&self, player_id: i32, player_name: string, as_observer: bool): bool {
        if as_observer {
            let slot_idx = self.find_observer_slot()
            if slot_idx < 0 {
                return false
            }

            self.observer_slots[slot_idx].settings.state = SlotState::OBSERVER
            self.observer_slots[slot_idx].player_id = player_id
            self.observer_slots[slot_idx].player_name = player_name
            self.observer_slots[slot_idx].is_ready = false

            self.chat.add_system_message(player_name + " joined as observer")
        } else {
            let slot_idx = self.find_open_slot()
            if slot_idx < 0 {
                return false
            }

            self.slots[slot_idx].settings.state = SlotState::HUMAN
            self.slots[slot_idx].player_id = player_id
            self.slots[slot_idx].player_name = player_name
            self.slots[slot_idx].is_ready = false

            self.chat.add_system_message(player_name + " joined the game")
        }

        // Cancel countdown if in progress
        if self.state == StagingRoomState::COUNTING_DOWN {
            self.cancel_countdown()
        }

        self.pending_changes = true
        return true
    }

    fn remove_player(&self, player_id: i32) {
        let player_name = ""
        let was_host = false

        // Check player slots
        for i in 0..MAX_SLOTS {
            if self.slots[i].player_id == player_id {
                player_name = self.slots[i].player_name
                was_host = self.slots[i].is_host

                // Clear slot
                self.slots[i].settings.state = SlotState::OPEN
                self.slots[i].player_id = 0
                self.slots[i].player_name = ""
                self.slots[i].is_ready = false
                self.slots[i].is_host = false
                break
            }
        }

        // Check observer slots
        for i in 0..MAX_OBSERVERS {
            if self.observer_slots[i].player_id == player_id {
                player_name = self.observer_slots[i].player_name

                self.observer_slots[i].settings.state = SlotState::EMPTY
                self.observer_slots[i].player_id = 0
                self.observer_slots[i].player_name = ""
                self.observer_slots[i].is_ready = false
                break
            }
        }

        if string_length(player_name) > 0 {
            self.chat.add_system_message(player_name + " left the game")
        }

        // Handle host migration
        if was_host {
            self.migrate_host()
        }

        // Cancel countdown if in progress
        if self.state == StagingRoomState::COUNTING_DOWN {
            self.cancel_countdown()
        }

        self.pending_changes = true
    }

    fn kick_player(&self, player_id: i32, reason: string) {
        self.chat.add_system_message("Player kicked: " + reason)
        self.remove_player(player_id)
    }

    fn migrate_host(&self) {
        // Find first human player to become new host
        for i in 0..MAX_SLOTS {
            if self.slots[i].settings.state == SlotState::HUMAN && self.slots[i].player_id != 0 {
                self.slots[i].is_host = true
                self.host_id = self.slots[i].player_id
                self.chat.add_system_message(self.slots[i].player_name + " is now the host")
                return
            }
        }

        // No players left, room is empty
        self.state = StagingRoomState::CANCELLED
    }

    // ========================================================================
    // Slot Management
    // ========================================================================

    fn set_slot_state(&self, slot_id: i32, state: SlotState) {
        if slot_id < 0 || slot_id >= MAX_SLOTS {
            return
        }

        // Can't change occupied human slots
        if self.slots[slot_id].settings.state == SlotState::HUMAN &&
           self.slots[slot_id].player_id != 0 {
            return
        }

        self.slots[slot_id].settings.state = state

        // If adding AI, set default name
        if state == SlotState::AI {
            self.slots[slot_id].player_name = "AI " + int_to_string(slot_id + 1)
            self.slots[slot_id].is_ready = true  // AI is always ready
        }

        self.pending_changes = true
    }

    fn set_slot_color(&self, slot_id: i32, color: SlotColor) {
        if slot_id < 0 || slot_id >= MAX_SLOTS {
            return
        }

        if self.game_settings.lock_colors && !self.is_host_slot(slot_id) {
            return
        }

        // Check if color is taken
        if color != SlotColor::RANDOM {
            for i in 0..MAX_SLOTS {
                if i != slot_id && self.slots[i].settings.color == color {
                    return  // Color already taken
                }
            }
        }

        self.slots[slot_id].settings.color = color
        self.pending_changes = true
    }

    fn set_slot_team(&self, slot_id: i32, team: TeamId) {
        if slot_id < 0 || slot_id >= MAX_SLOTS {
            return
        }

        if self.game_settings.lock_teams && !self.is_host_slot(slot_id) {
            return
        }

        self.slots[slot_id].settings.team = team
        self.pending_changes = true
    }

    fn set_slot_faction(&self, slot_id: i32, faction: Faction) {
        if slot_id < 0 || slot_id >= MAX_SLOTS {
            return
        }

        if self.game_settings.lock_factions && !self.is_host_slot(slot_id) {
            return
        }

        self.slots[slot_id].settings.faction = faction
        self.pending_changes = true
    }

    fn set_slot_handicap(&self, slot_id: i32, handicap: i32) {
        if slot_id < 0 || slot_id >= MAX_SLOTS {
            return
        }

        self.slots[slot_id].settings.handicap = clamp_i32(handicap, 50, 100)
        self.pending_changes = true
    }

    fn set_slot_start_position(&self, slot_id: i32, position: i32) {
        if slot_id < 0 || slot_id >= MAX_SLOTS {
            return
        }

        // Check if position is taken
        if position >= 0 {
            for i in 0..MAX_SLOTS {
                if i != slot_id && self.slots[i].settings.start_position == position {
                    return  // Position already taken
                }
            }
        }

        self.slots[slot_id].settings.start_position = position
        self.pending_changes = true
    }

    fn swap_slots(&self, slot_a: i32, slot_b: i32) {
        if slot_a < 0 || slot_a >= MAX_SLOTS || slot_b < 0 || slot_b >= MAX_SLOTS {
            return
        }

        // Swap all slot data
        let temp = self.slots[slot_a]
        self.slots[slot_a] = self.slots[slot_b]
        self.slots[slot_b] = temp

        // Update slot IDs
        self.slots[slot_a].slot_id = slot_a
        self.slots[slot_b].slot_id = slot_b

        self.pending_changes = true
    }

    fn move_to_observer(&self, player_id: i32): bool {
        let obs_slot = self.find_observer_slot()
        if obs_slot < 0 {
            return false
        }

        // Find player's current slot
        for i in 0..MAX_SLOTS {
            if self.slots[i].player_id == player_id {
                // Copy to observer
                self.observer_slots[obs_slot].settings.state = SlotState::OBSERVER
                self.observer_slots[obs_slot].player_id = player_id
                self.observer_slots[obs_slot].player_name = self.slots[i].player_name
                self.observer_slots[obs_slot].is_ready = false

                // Clear player slot
                self.slots[i].settings.state = SlotState::OPEN
                self.slots[i].player_id = 0
                self.slots[i].player_name = ""
                self.slots[i].is_ready = false

                self.pending_changes = true
                return true
            }
        }

        return false
    }

    fn is_host_slot(&self, slot_id: i32): bool {
        if slot_id < 0 || slot_id >= MAX_SLOTS {
            return false
        }
        return self.slots[slot_id].is_host
    }

    // ========================================================================
    // Game Settings
    // ========================================================================

    fn set_map(&self, map_info: MapInfo) {
        self.game_settings.map_name = map_info.name
        self.game_settings.map_path = map_info.path
        self.game_settings.map_crc = map_info.crc
        self.game_settings.map_size = map_info.num_players

        // Adjust open slots based on map size
        for i in 0..MAX_SLOTS {
            if self.slots[i].settings.state == SlotState::OPEN ||
               self.slots[i].settings.state == SlotState::CLOSED {
                if i < map_info.num_players {
                    self.slots[i].settings.state = SlotState::OPEN
                } else {
                    self.slots[i].settings.state = SlotState::CLOSED
                }
            }
        }

        // Reset start positions
        for i in 0..MAX_SLOTS {
            self.slots[i].settings.start_position = -1
        }

        self.chat.add_system_message("Map changed to: " + map_info.name)
        self.pending_changes = true
    }

    fn set_game_speed(&self, speed: GameSpeed) {
        self.game_settings.game_speed = speed
        self.pending_changes = true
    }

    fn set_starting_cash(&self, cash: StartingCash) {
        self.game_settings.starting_cash = cash
        self.pending_changes = true
    }

    fn set_superweapons(&self, enabled: bool, limit: bool) {
        if enabled {
            self.game_settings.superweapons = SuperweaponSetting::ENABLED
        } else {
            self.game_settings.superweapons = SuperweaponSetting::DISABLED
        }
        self.game_settings.limit_superweapons = limit
        self.pending_changes = true
    }

    // ========================================================================
    // Ready System
    // ========================================================================

    fn set_ready(&self, player_id: i32, ready: bool) {
        // Find player's slot
        for i in 0..MAX_SLOTS {
            if self.slots[i].player_id == player_id {
                self.slots[i].is_ready = ready

                let status = "not ready"
                if ready { status = "ready" }
                self.chat.add_system_message(self.slots[i].player_name + " is " + status)
                break
            }
        }

        // Check for observers
        for i in 0..MAX_OBSERVERS {
            if self.observer_slots[i].player_id == player_id {
                self.observer_slots[i].is_ready = ready
                break
            }
        }

        // Auto-start countdown if all ready
        if self.config.auto_start && self.check_all_ready() == ReadyCheckResult::ALL_READY {
            self.start_countdown()
        }

        self.pending_changes = true
    }

    fn check_all_ready(&self): ReadyCheckResult {
        let human_count: i32 = 0
        let ready_count: i32 = 0

        for i in 0..MAX_SLOTS {
            if self.slots[i].settings.state == SlotState::HUMAN {
                human_count = human_count + 1
                if self.slots[i].is_ready {
                    ready_count = ready_count + 1
                }
            }
        }

        // Check observers
        for i in 0..MAX_OBSERVERS {
            if self.observer_slots[i].settings.state == SlotState::OBSERVER {
                if !self.observer_slots[i].is_ready {
                    return ReadyCheckResult::NOT_ALL_READY
                }
            }
        }

        if human_count < self.config.min_players {
            return ReadyCheckResult::MISSING_PLAYERS
        }

        if ready_count != human_count {
            return ReadyCheckResult::NOT_ALL_READY
        }

        return ReadyCheckResult::ALL_READY
    }

    fn get_player_count(&self): i32 {
        let count: i32 = 0
        for i in 0..MAX_SLOTS {
            if self.slots[i].settings.state == SlotState::HUMAN ||
               self.slots[i].settings.state == SlotState::AI {
                count = count + 1
            }
        }
        return count
    }

    fn get_human_count(&self): i32 {
        let count: i32 = 0
        for i in 0..MAX_SLOTS {
            if self.slots[i].settings.state == SlotState::HUMAN {
                count = count + 1
            }
        }
        return count
    }

    // ========================================================================
    // Countdown & Launch
    // ========================================================================

    fn start_countdown(&self) {
        let ready_check = self.check_all_ready()

        if ready_check != ReadyCheckResult::ALL_READY {
            return
        }

        self.state = StagingRoomState::COUNTING_DOWN
        self.countdown_start_time = get_current_time_ms()
        self.countdown_remaining_ms = self.config.countdown_time_ms

        let seconds = self.config.countdown_time_ms / 1000
        self.chat.add_system_message("Game starting in " + int_to_string(seconds) + " seconds...")
    }

    fn cancel_countdown(&self) {
        if self.state == StagingRoomState::COUNTING_DOWN {
            self.state = StagingRoomState::WAITING_FOR_PLAYERS
            self.countdown_remaining_ms = 0
            self.chat.add_system_message("Countdown cancelled")
        }
    }

    fn update_countdown(&self, delta_ms: i32) {
        if self.state != StagingRoomState::COUNTING_DOWN {
            return
        }

        let elapsed = get_current_time_ms() - self.countdown_start_time

        if elapsed >= self.config.countdown_time_ms {
            self.countdown_remaining_ms = 0
            self.launch_game()
        } else {
            let remaining = self.config.countdown_time_ms - elapsed
            self.countdown_remaining_ms = remaining
        }
    }

    fn launch_game(&self) {
        // Final ready check
        let ready_check = self.check_all_ready()
        if ready_check != ReadyCheckResult::ALL_READY {
            self.cancel_countdown()
            return
        }

        self.state = StagingRoomState::LOADING
        self.chat.add_system_message("Loading game...")

        // Set all players to loading state
        for i in 0..MAX_SLOTS {
            if self.slots[i].settings.state == SlotState::HUMAN {
                self.slots[i].is_loading = true
                self.slots[i].load_progress = 0.0
            }
        }
    }

    fn update_load_progress(&self, player_id: i32, progress: f32) {
        for i in 0..MAX_SLOTS {
            if self.slots[i].player_id == player_id {
                self.slots[i].load_progress = progress
                break
            }
        }

        // Check if all loaded
        if self.is_all_loaded() {
            self.finalize_launch()
        }
    }

    fn is_all_loaded(&self): bool {
        for i in 0..MAX_SLOTS {
            if self.slots[i].settings.state == SlotState::HUMAN {
                if self.slots[i].load_progress < 1.0 {
                    return false
                }
            }
        }
        return true
    }

    fn finalize_launch(&self) {
        self.state = StagingRoomState::LAUNCHING
        // Transition to game state happens externally
    }

    // ========================================================================
    // Chat
    // ========================================================================

    fn send_chat(&self, player_id: i32, message: string, team_only: bool) {
        let sender_name = ""

        // Find sender name
        for i in 0..MAX_SLOTS {
            if self.slots[i].player_id == player_id {
                sender_name = self.slots[i].player_name
                break
            }
        }

        for i in 0..MAX_OBSERVERS {
            if self.observer_slots[i].player_id == player_id {
                sender_name = self.observer_slots[i].player_name
                break
            }
        }

        if string_length(sender_name) == 0 {
            return
        }

        self.chat.add_message(player_id, sender_name, message, team_only)
    }

    // ========================================================================
    // Validation
    // ========================================================================

    fn validate_settings(&self): bool {
        // Check map is valid
        if string_length(self.game_settings.map_path) == 0 {
            return false
        }

        // Check we have enough players
        if self.get_player_count() < self.config.min_players {
            return false
        }

        // Check for duplicate colors (excluding Random)
        let used_colors: [bool] = [false, false, false, false, false, false, false, false, false]
        for i in 0..MAX_SLOTS {
            let color = self.slots[i].settings.color
            if color != SlotColor::RANDOM {
                let idx = color_to_index(color)
                if used_colors[idx] {
                    return false
                }
                used_colors[idx] = true
            }
        }

        // Check for duplicate start positions (excluding Random)
        let used_positions: [bool] = [false, false, false, false, false, false, false, false]
        for i in 0..MAX_SLOTS {
            let pos = self.slots[i].settings.start_position
            if pos >= 0 && pos < 8 {
                if used_positions[pos] {
                    return false
                }
                used_positions[pos] = true
            }
        }

        return true
    }

    // ========================================================================
    // Update Loop
    // ========================================================================

    fn update(&self, delta_ms: i32) {
        if self.state == StagingRoomState::COUNTING_DOWN {
            self.update_countdown(delta_ms)
        } else if self.state == StagingRoomState::LOADING {
            // Check for timeout
        }
    }
}

// ============================================================================
// Game Launch Info
// ============================================================================

struct GameLaunchInfo {
    map_path: string,
    map_crc: i32,
    random_seed: i32,
    players: [GameLaunchPlayer],
    player_count: i32,
    settings: GameSettings,
    is_multiplayer: bool,
    is_replay: bool,
    replay_path: string,
}

struct GameLaunchPlayer {
    slot_id: i32,
    player_id: i32,
    player_name: string,
    color: SlotColor,
    team: TeamId,
    faction: Faction,
    start_position: i32,
    handicap: i32,
    is_human: bool,
    is_local: bool,
    ai_personality: AIPersonality,
}

impl GameLaunchPlayer {
    fn init(): GameLaunchPlayer {
        return GameLaunchPlayer {
            slot_id: 0,
            player_id: 0,
            player_name: "",
            color: SlotColor::RANDOM,
            team: TeamId::NO_TEAM,
            faction: Faction::RANDOM,
            start_position: 0,
            handicap: 100,
            is_human: true,
            is_local: false,
            ai_personality: AIPersonality::MEDIUM,
        }
    }
}

fn create_launch_info(room: StagingRoom, local_player_id: i32): GameLaunchInfo {
    let players: [GameLaunchPlayer] = []
    let player_count: i32 = 0

    let available_colors: [SlotColor] = [
        SlotColor::GOLD, SlotColor::RED, SlotColor::BLUE, SlotColor::GREEN,
        SlotColor::ORANGE, SlotColor::CYAN, SlotColor::PURPLE, SlotColor::PINK,
    ]
    let available_positions: [i32] = [0, 1, 2, 3, 4, 5, 6, 7]

    shuffle_colors(available_colors)
    shuffle_positions(available_positions)

    let color_idx: i32 = 0
    let pos_idx: i32 = 0

    for i in 0..MAX_SLOTS {
        let slot = room.slots[i]

        if slot.settings.state != SlotState::HUMAN && slot.settings.state != SlotState::AI {
            continue
        }

        let player = GameLaunchPlayer {
            slot_id: i,
            player_id: slot.player_id,
            player_name: slot.player_name,
            color: slot.settings.color,
            team: slot.settings.team,
            faction: slot.settings.faction,
            start_position: 0,
            handicap: slot.settings.handicap,
            is_human: slot.settings.state == SlotState::HUMAN,
            is_local: slot.player_id == local_player_id,
            ai_personality: slot.settings.ai_personality,
        }

        // Assign random color if needed
        if player.color == SlotColor::RANDOM {
            player.color = available_colors[color_idx]
            color_idx = color_idx + 1
        }

        // Assign random position if needed
        if slot.settings.start_position < 0 {
            player.start_position = available_positions[pos_idx]
            pos_idx = pos_idx + 1
        } else {
            player.start_position = slot.settings.start_position
        }

        // Assign random faction if needed
        if player.faction == Faction::RANDOM {
            player.faction = get_random_faction()
        }

        players = players + [player]
        player_count = player_count + 1
    }

    return GameLaunchInfo {
        map_path: room.game_settings.map_path,
        map_crc: room.game_settings.map_crc,
        random_seed: generate_random_seed(),
        players: players,
        player_count: player_count,
        settings: room.game_settings,
        is_multiplayer: true,
        is_replay: false,
        replay_path: "",
    }
}

// ============================================================================
// Helper Functions
// ============================================================================

let staging_random_seed: i32 = 12345

fn generate_room_id(): i32 {
    staging_random_seed = staging_random_seed * 1103515245 + 12345
    return staging_random_seed
}

fn generate_random_seed(): i32 {
    staging_random_seed = staging_random_seed * 1103515245 + 12345
    return staging_random_seed
}

fn get_current_time_ms(): i32 {
    // Platform-specific, returns 0 for now
    return 0
}

fn get_random_faction(): Faction {
    let factions: [Faction] = [
        Faction::USA, Faction::USA_AIR_FORCE, Faction::USA_LASER, Faction::USA_SUPER_WEAPON,
        Faction::CHINA, Faction::CHINA_TANK, Faction::CHINA_INFANTRY, Faction::CHINA_NUKE,
        Faction::GLA, Faction::GLA_TOXIN, Faction::GLA_STEALTH, Faction::GLA_DEMO,
    ]

    staging_random_seed = staging_random_seed * 1103515245 + 12345
    let idx = (staging_random_seed % 12)
    if idx < 0 { idx = -idx }
    return factions[idx]
}

fn shuffle_colors(arr: [SlotColor]) {
    for i in 0..8 {
        staging_random_seed = staging_random_seed * 1103515245 + 12345
        let j = (staging_random_seed % 8)
        if j < 0 { j = -j }
        let temp = arr[i]
        arr[i] = arr[j]
        arr[j] = temp
    }
}

fn shuffle_positions(arr: [i32]) {
    for i in 0..8 {
        staging_random_seed = staging_random_seed * 1103515245 + 12345
        let j = (staging_random_seed % 8)
        if j < 0 { j = -j }
        let temp = arr[i]
        arr[i] = arr[j]
        arr[j] = temp
    }
}

fn clamp_i32(value: i32, min_val: i32, max_val: i32): i32 {
    if value < min_val { return min_val }
    if value > max_val { return max_val }
    return value
}

fn string_length(s: string): i32 {
    // Placeholder - returns 0
    return 0
}

fn string_contains_ignore_case(s: string, substring: string): bool {
    // Placeholder
    return false
}

fn int_to_string(value: i32): string {
    // Placeholder
    return ""
}

fn color_to_index(color: SlotColor): i32 {
    if color == SlotColor::RANDOM { return 0 }
    if color == SlotColor::GOLD { return 1 }
    if color == SlotColor::RED { return 2 }
    if color == SlotColor::BLUE { return 3 }
    if color == SlotColor::GREEN { return 4 }
    if color == SlotColor::ORANGE { return 5 }
    if color == SlotColor::CYAN { return 6 }
    if color == SlotColor::PURPLE { return 7 }
    if color == SlotColor::PINK { return 8 }
    return 0
}

// ============================================================================
// GLOBAL INSTANCE
// ============================================================================

let g_staging_room: StagingRoom? = null

fn init_staging_room(config: StagingRoomConfig): StagingRoom {
    let room = StagingRoom::init(config)
    g_staging_room = room
    return room
}

fn get_staging_room(): StagingRoom? {
    return g_staging_room
}

fn shutdown_staging_room() {
    g_staging_room = null
}
