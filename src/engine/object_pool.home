// C&C Generals Zero Hour - Home Port
// Object Pooling System
//
// Original: EA used custom memory pools (see memory.home)
// Enhanced with typed object pooling for frequently allocated objects
//
// EA's memory strategy:
// - 3-tier memory pooling (fixed-size blocks)
// - Reduces allocation overhead
// - Improves cache locality
// - Prevents memory fragmentation
//
// This system adds object-level pooling for:
// - Particles (thousands created/destroyed per frame)
// - Projectiles (bullets, missiles, shells)
// - Temporary effects (explosions, smoke, debris)
// - Path nodes (for A* pathfinding)
// - UI elements (tooltips, floating text)
//
// Benefits:
// - Zero allocation cost after warmup
// - Predictable memory usage
// - Eliminates GC pressure
// - Cache-friendly (objects in contiguous array)

import basics/allocator

let MAX_POOL_SIZE: i32 = 16384  // Max objects per pool

// Object handle for safer access
struct ObjectHandle {
    index: i32      // Index into pool
    generation: i32 // Generation counter (detect stale handles)

    fn invalid(): ObjectHandle {
        return ObjectHandle {
            index: -1
            generation: 0
        }
    }

    fn is_valid(&self): bool {
        return self.index >= 0
    }
}

// Vec3 for particles
struct Vec3 {
    x: f32
    y: f32
    z: f32

    fn zero(): Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }
}

// Vec4 for colors
struct Vec4 {
    x: f32
    y: f32
    z: f32
    w: f32

    fn new(x: f32, y: f32, z: f32, w: f32): Vec4 {
        return Vec4 { x: x, y: y, z: z, w: w }
    }
}

// Particle struct
struct Particle {
    position: Vec3
    velocity: Vec3
    color: Vec4
    size: f32
    lifetime: f32
    age: f32

    fn default(): Particle {
        return Particle {
            position: Vec3.zero()
            velocity: Vec3.zero()
            color: Vec4.new(1.0, 1.0, 1.0, 1.0)
            size: 1.0
            lifetime: 1.0
            age: 0.0
        }
    }
}

// Particle slot with generation tracking
struct ParticleSlot {
    particle: Particle
    generation: i32
    is_active: bool

    fn init(): ParticleSlot {
        return ParticleSlot {
            particle: Particle.default()
            generation: 0
            is_active: false
        }
    }
}

// Particle Object Pool (concrete implementation instead of generic)
struct ParticlePool {
    slots: [ParticleSlot]
    free_list: [i32]
    free_count: i32

    active_count: i32
    peak_count: i32
    capacity: i32

    allocator: Allocator

    fn init(allocator: Allocator, capacity: i32): ParticlePool {
        let size = capacity
        if size > MAX_POOL_SIZE {
            size = MAX_POOL_SIZE
        }

        let slots = [ParticleSlot]{}
        let free_list = [i32]{}

        for i in 0..size {
            slots = slots + [ParticleSlot.init()]
            free_list = free_list + [i]
        }

        return ParticlePool {
            slots: slots
            free_list: free_list
            free_count: size
            active_count: 0
            peak_count: 0
            capacity: size
            allocator: allocator
        }
    }

    fn acquire(self): ObjectHandle {
        if self.free_count == 0 {
            println("ParticlePool: No free objects available!")
            return ObjectHandle.invalid()
        }

        // Pop from free list
        self.free_count -= 1
        let index = self.free_list[self.free_count]

        self.slots[index].is_active = true
        self.slots[index].generation += 1

        self.active_count += 1

        if self.active_count > self.peak_count {
            self.peak_count = self.active_count
        }

        return ObjectHandle {
            index: index
            generation: self.slots[index].generation
        }
    }

    fn release(self, handle: ObjectHandle) {
        if handle.index < 0 || handle.index >= self.capacity {
            println("ParticlePool: Invalid handle released!")
            return
        }

        if handle.generation != self.slots[handle.index].generation {
            println("ParticlePool: Stale handle released!")
            return
        }

        if self.slots[handle.index].is_active == false {
            println("ParticlePool: Already released!")
            return
        }

        self.slots[handle.index].is_active = false

        self.free_list[self.free_count] = handle.index
        self.free_count += 1
        self.active_count -= 1
    }

    fn get(self, handle: ObjectHandle): Particle? {
        if handle.index < 0 || handle.index >= self.capacity {
            return null
        }

        if handle.generation != self.slots[handle.index].generation {
            return null
        }

        if self.slots[handle.index].is_active == false {
            return null
        }

        return self.slots[handle.index].particle
    }

    fn set(self, handle: ObjectHandle, particle: Particle): bool {
        if handle.index < 0 || handle.index >= self.capacity {
            return false
        }

        if handle.generation != self.slots[handle.index].generation {
            return false
        }

        if self.slots[handle.index].is_active == false {
            return false
        }

        self.slots[handle.index].particle = particle
        return true
    }

    fn is_valid(&self, handle: ObjectHandle): bool {
        if handle.index < 0 || handle.index >= self.capacity {
            return false
        }

        if handle.generation != self.slots[handle.index].generation {
            return false  // Stale handle
        }

        if self.slots[handle.index].is_active == false {
            return false
        }

        return true
    }

    fn clear(self) {
        for i in 0..self.capacity {
            self.slots[i].is_active = false
            self.free_list[i] = i
        }

        self.free_count = self.capacity
        self.active_count = 0
    }

    fn get_capacity(&self): i32 {
        return self.capacity
    }

    fn get_active_count(&self): i32 {
        return self.active_count
    }

    fn get_free_count(&self): i32 {
        return self.free_count
    }

    fn get_peak_count(&self): i32 {
        return self.peak_count
    }

    fn get_usage_percentage(&self): f32 {
        if self.capacity == 0 {
            return 0.0
        }

        return (self.active_count as f32) / (self.capacity as f32) * 100.0
    }

    fn print_stats(&self, pool_name: string) {
        println("")
        println("=== " + pool_name + " Pool Stats ===")
        println("Capacity: {self.capacity}")
        println("Active: {self.active_count}")
        println("Free: {self.free_count}")
        println("Peak: {self.peak_count}")
    }
}

// Projectile struct for projectile pool
struct Projectile {
    position: Vec3
    velocity: Vec3
    damage: f32
    owner_id: i32
    target_id: i32
    lifetime: f32
    age: f32

    fn default(): Projectile {
        return Projectile {
            position: Vec3.zero()
            velocity: Vec3.zero()
            damage: 0.0
            owner_id: -1
            target_id: -1
            lifetime: 5.0
            age: 0.0
        }
    }
}

// Projectile slot
struct ProjectileSlot {
    projectile: Projectile
    generation: i32
    is_active: bool

    fn init(): ProjectileSlot {
        return ProjectileSlot {
            projectile: Projectile.default()
            generation: 0
            is_active: false
        }
    }
}

// Projectile Object Pool
struct ProjectilePool {
    slots: [ProjectileSlot]
    free_list: [i32]
    free_count: i32

    active_count: i32
    peak_count: i32
    capacity: i32

    allocator: Allocator

    fn init(allocator: Allocator, capacity: i32): ProjectilePool {
        let size = capacity
        if size > MAX_POOL_SIZE {
            size = MAX_POOL_SIZE
        }

        let slots = [ProjectileSlot]{}
        let free_list = [i32]{}

        for i in 0..size {
            slots = slots + [ProjectileSlot.init()]
            free_list = free_list + [i]
        }

        return ProjectilePool {
            slots: slots
            free_list: free_list
            free_count: size
            active_count: 0
            peak_count: 0
            capacity: size
            allocator: allocator
        }
    }

    fn acquire(self): ObjectHandle {
        if self.free_count == 0 {
            println("ProjectilePool: No free objects available!")
            return ObjectHandle.invalid()
        }

        self.free_count -= 1
        let index = self.free_list[self.free_count]

        self.slots[index].is_active = true
        self.slots[index].generation += 1

        self.active_count += 1

        if self.active_count > self.peak_count {
            self.peak_count = self.active_count
        }

        return ObjectHandle {
            index: index
            generation: self.slots[index].generation
        }
    }

    fn release(self, handle: ObjectHandle) {
        if handle.index < 0 || handle.index >= self.capacity {
            println("ProjectilePool: Invalid handle released!")
            return
        }

        if handle.generation != self.slots[handle.index].generation {
            println("ProjectilePool: Stale handle released!")
            return
        }

        if self.slots[handle.index].is_active == false {
            return
        }

        self.slots[handle.index].is_active = false

        self.free_list[self.free_count] = handle.index
        self.free_count += 1
        self.active_count -= 1
    }

    fn get(self, handle: ObjectHandle): Projectile? {
        if handle.index < 0 || handle.index >= self.capacity {
            return null
        }

        if handle.generation != self.slots[handle.index].generation {
            return null
        }

        if self.slots[handle.index].is_active == false {
            return null
        }

        return self.slots[handle.index].projectile
    }

    fn set(self, handle: ObjectHandle, projectile: Projectile): bool {
        if handle.index < 0 || handle.index >= self.capacity {
            return false
        }

        if handle.generation != self.slots[handle.index].generation {
            return false
        }

        if self.slots[handle.index].is_active == false {
            return false
        }

        self.slots[handle.index].projectile = projectile
        return true
    }

    fn is_valid(&self, handle: ObjectHandle): bool {
        if handle.index < 0 || handle.index >= self.capacity {
            return false
        }

        if handle.generation != self.slots[handle.index].generation {
            return false
        }

        return self.slots[handle.index].is_active
    }

    fn clear(self) {
        for i in 0..self.capacity {
            self.slots[i].is_active = false
            self.free_list[i] = i
        }

        self.free_count = self.capacity
        self.active_count = 0
    }
}

// Global pool manager
struct PoolManager {
    total_pools: i32
    total_capacity: i32
    total_active: i32
    total_peak: i32

    fn init(): PoolManager {
        return PoolManager {
            total_pools: 0
            total_capacity: 0
            total_active: 0
            total_peak: 0
        }
    }

    fn register_pool(self, capacity: i32) {
        self.total_pools += 1
        self.total_capacity += capacity
    }

    fn update_stats(self, active: i32, peak: i32) {
        self.total_active += active
        if peak > self.total_peak {
            self.total_peak = peak
        }
    }

    fn print_global_stats(&self) {
        println("")
        println("=== Pool Manager Global Stats ===")
        println("Total Pools: {self.total_pools}")
        println("Total Capacity: {self.total_capacity}")
        println("Total Active: {self.total_active}")
        println("Total Peak: {self.total_peak}")
    }
}

var g_pool_manager: PoolManager? = null

export fn init_pool_manager() {
    g_pool_manager = PoolManager.init()
    println("PoolManager: Initialized")
}

export fn shutdown_pool_manager() {
    if g_pool_manager == null {
        return
    }

    g_pool_manager.?.print_global_stats()
    g_pool_manager = null

    println("PoolManager: Shutdown")
}
