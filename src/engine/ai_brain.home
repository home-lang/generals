// AI Brain - Core AI decision-making system for computer players
// Implements the C&C Generals AI system with personality-based behavior

let MAX_AI_TEAMS: i32 = 8
let MAX_OWNED_UNITS: i32 = 512
let MAX_OWNED_BUILDINGS: i32 = 128
let MAX_BUILD_LIST: i32 = 64
let MAX_ATTACK_GROUPS: i32 = 8
let MAX_UNITS_PER_GROUP: i32 = 64
let MAX_KNOWN_ENEMIES: i32 = 64
let MAX_TARGET_PRIORITIES: i32 = 32

// AI difficulty levels
enum AIDifficulty {
    EASY,
    MEDIUM,
    HARD,
    BRUTAL,
}

// AI personality types (matching Thyme)
enum AIPersonality {
    BALANCED,       // Standard mixed strategy
    AGGRESSIVE,     // Early rushes, constant attacks
    DEFENSIVE,      // Turtles, builds defenses first
    TANK,           // Prefers heavy armor
    INFANTRY,       // Prefers infantry swarms
    AIR,            // Air superiority focused
    TECH,           // Rush to high-tech units
    SUPERWEAPON,    // Focus on superweapons
    BUILD_ORDER,    // Follows strict build orders
    ADAPTIVE,       // Responds to player strategy
}

// AI state machine states
enum AIState {
    INITIAL,
    BUILDING,
    DEFENDING,
    SCOUTING,
    ATTACKING,
    RETREATING,
    REGROUPING,
    EXPANDING,
    END_GAME,
}

// Attack group states
enum AttackGroupState {
    FORMING,
    MOVING,
    ATTACKING,
    RETREATING,
    DISBANDED,
}

// Attack group types
enum AttackGroupType {
    MAIN,
    FLANKING,
    HARASSMENT,
    DEFENSE,
    SCOUT,
}

// Position
struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(): Vec3 {
        return Vec3 {
            x: 0.0,
            y: 0.0,
            z: 0.0,
        }
    }

    fn create(x: f32, y: f32, z: f32): Vec3 {
        return Vec3 {
            x: x,
            y: y,
            z: z,
        }
    }

    fn copy(&self): Vec3 {
        return Vec3 {
            x: self.x,
            y: self.y,
            z: self.z,
        }
    }
}

// Target priorities
struct TargetPriority {
    target_type: string,
    priority: f32,
    can_attack: bool,
}

impl TargetPriority {
    fn init(): TargetPriority {
        return TargetPriority {
            target_type: "",
            priority: 0.0,
            can_attack: true,
        }
    }
}

// Build list entry
struct BuildEntry {
    object_name: string,
    quantity: i32,
    priority: f32,
    is_upgrade: bool,
    prerequisite_met: bool,
}

impl BuildEntry {
    fn init(): BuildEntry {
        return BuildEntry {
            object_name: "",
            quantity: 0,
            priority: 0.0,
            is_upgrade: false,
            prerequisite_met: false,
        }
    }
}

// Attack group
struct AttackGroup {
    unit_ids: [i32],
    unit_count: i32,
    target_position: Vec3,
    attack_state: AttackGroupState,
    group_type: AttackGroupType,
    creation_time: f32,
}

impl AttackGroup {
    fn init(): AttackGroup {
        return AttackGroup {
            unit_ids: [],
            unit_count: 0,
            target_position: Vec3::init(),
            attack_state: AttackGroupState::DISBANDED,
            group_type: AttackGroupType::MAIN,
            creation_time: 0.0,
        }
    }
}

// Build template entry
struct BuildTemplate {
    name: string,
    buildings: [string],
}

impl BuildTemplate {
    fn init(): BuildTemplate {
        return BuildTemplate {
            name: "",
            buildings: [],
        }
    }
}

// AI team representing a computer player
struct AITeam {
    player_id: i32,
    team_id: i32,
    faction: string,
    difficulty: AIDifficulty,
    personality: AIPersonality,

    // Current state
    state: AIState,
    state_timer: f32,

    // Resources
    money: i32,
    power_surplus: i32,

    // Base location
    base_center: Vec3,
    base_radius: f32,

    // Unit tracking
    owned_units: [i32],
    owned_unit_count: i32,
    owned_buildings: [i32],
    owned_building_count: i32,

    // Attack groups
    attack_groups: [AttackGroup],
    attack_group_count: i32,

    // Build queue
    build_list: [BuildEntry],
    build_list_count: i32,

    // Enemy tracking
    known_enemy_positions: [Vec3],
    known_enemy_count: i32,
    last_scout_time: f32,

    // Target priorities
    target_priorities: [TargetPriority],
    target_priority_count: i32,

    // Timing
    next_think_time: f32,
    think_interval: f32,

    // Personality modifiers
    aggression: f32,       // 0.0-1.0
    economy_focus: f32,    // 0.0-1.0
    defense_focus: f32,    // 0.0-1.0
    tech_focus: f32,       // 0.0-1.0
    attack_threshold: f32, // Army size needed to attack

    is_active: bool,
}

impl AITeam {
    fn init(player_id: i32, team_id: i32, faction: string, difficulty: AIDifficulty, personality: AIPersonality): AITeam {
        let team = AITeam {
            player_id: player_id,
            team_id: team_id,
            faction: faction,
            difficulty: difficulty,
            personality: personality,
            state: AIState::INITIAL,
            state_timer: 0.0,
            money: 0,
            power_surplus: 0,
            base_center: Vec3::init(),
            base_radius: 200.0,
            owned_units: [],
            owned_unit_count: 0,
            owned_buildings: [],
            owned_building_count: 0,
            attack_groups: [],
            attack_group_count: 0,
            build_list: [],
            build_list_count: 0,
            known_enemy_positions: [],
            known_enemy_count: 0,
            last_scout_time: 0.0,
            target_priorities: [],
            target_priority_count: 0,
            next_think_time: 0.0,
            think_interval: 1.0,
            aggression: 0.5,
            economy_focus: 0.5,
            defense_focus: 0.5,
            tech_focus: 0.5,
            attack_threshold: 10.0,
            is_active: true,
        }

        // Apply personality modifiers
        if personality == AIPersonality::AGGRESSIVE {
            team.aggression = 0.8
            team.economy_focus = 0.3
            team.attack_threshold = 6.0
        } else if personality == AIPersonality::DEFENSIVE {
            team.aggression = 0.2
            team.defense_focus = 0.9
            team.attack_threshold = 15.0
        } else if personality == AIPersonality::TANK {
            team.economy_focus = 0.6
        } else if personality == AIPersonality::TECH {
            team.tech_focus = 0.9
            team.attack_threshold = 12.0
        }

        return team
    }

    fn create_default(): AITeam {
        return AITeam::init(0, 0, "USA", AIDifficulty::MEDIUM, AIPersonality::BALANCED)
    }
}

// AI Brain manager
struct AIBrain {
    teams: [AITeam],
    team_count: i32,

    // Global AI settings
    base_think_interval: f32,
    difficulty_multipliers: [f32],

    // Build order templates
    build_templates: [BuildTemplate],
    template_count: i32,

    // Current game time
    game_time: f32,

    is_initialized: bool,
}

impl AIBrain {
    fn init(): AIBrain {
        let brain = AIBrain {
            teams: [],
            team_count: 0,
            base_think_interval: 1.0,
            difficulty_multipliers: [0.5, 1.0, 1.5, 2.0],
            build_templates: [],
            template_count: 0,
            game_time: 0.0,
            is_initialized: true,
        }

        brain.setup_build_templates()

        return brain
    }

    fn setup_build_templates(&self) {
        // USA standard build order
        let usa_template = BuildTemplate::init()
        usa_template.name = "USA_Standard"
        usa_template.buildings = [
            "AmericaCommandCenter",
            "AmericaPowerPlant",
            "AmericaBarracks",
            "AmericaPowerPlant",
            "AmericaSupplyCenter",
            "AmericaWarFactory",
            "AmericaSupplyCenter",
            "AmericaAirfield",
            "AmericaStrategyCenter",
        ]
        self.build_templates = self.build_templates + [usa_template]
        self.template_count = self.template_count + 1

        // China standard build order
        let china_template = BuildTemplate::init()
        china_template.name = "China_Standard"
        china_template.buildings = [
            "ChinaCommandCenter",
            "ChinaPowerPlant",
            "ChinaBarracks",
            "ChinaSupplyCenter",
            "ChinaPowerPlant",
            "ChinaWarFactory",
            "ChinaSupplyCenter",
            "ChinaAirfield",
            "ChinaPropagandaCenter",
        ]
        self.build_templates = self.build_templates + [china_template]
        self.template_count = self.template_count + 1

        // GLA standard build order
        let gla_template = BuildTemplate::init()
        gla_template.name = "GLA_Standard"
        gla_template.buildings = [
            "GLACommandCenter",
            "GLABarracks",
            "GLASupplyStash",
            "GLAArmsDealer",
            "GLASupplyStash",
            "GLABlackMarket",
            "GLAPalace",
        ]
        self.build_templates = self.build_templates + [gla_template]
        self.template_count = self.template_count + 1
    }

    fn get_build_template(&self, template_name: string): BuildTemplate? {
        for i in 0..self.template_count {
            if self.build_templates[i].name == template_name {
                return self.build_templates[i]
            }
        }
        return null
    }

    // Add a new AI team
    fn add_team(&self, player_id: i32, faction: string, difficulty: AIDifficulty, personality: AIPersonality): i32 {
        if self.team_count >= MAX_AI_TEAMS {
            return -1
        }

        let team_id = self.team_count
        let team = AITeam::init(player_id, team_id, faction, difficulty, personality)

        self.teams = self.teams + [team]
        self.team_count = self.team_count + 1

        return team_id
    }

    fn remove_team(&self, team_id: i32) {
        if team_id >= 0 && team_id < self.team_count {
            self.teams[team_id].is_active = false
        }
    }

    // Main update loop
    fn update(&self, delta_time: f32) {
        self.game_time = self.game_time + delta_time

        for i in 0..self.team_count {
            if self.teams[i].is_active {
                self.update_team(i, delta_time)
            }
        }
    }

    fn update_team(&self, team_id: i32, delta_time: f32) {
        let team = self.teams[team_id]

        // Check if it's time to think
        if self.game_time < team.next_think_time {
            return
        }

        team.next_think_time = self.game_time + team.think_interval

        // Update unit tracking
        self.update_unit_tracking(team_id)

        // Run state machine
        let current_state = team.state

        if current_state == AIState::INITIAL {
            self.state_initial(team_id)
        } else if current_state == AIState::BUILDING {
            self.state_building(team_id)
        } else if current_state == AIState::DEFENDING {
            self.state_defending(team_id)
        } else if current_state == AIState::SCOUTING {
            self.state_scouting(team_id)
        } else if current_state == AIState::ATTACKING {
            self.state_attacking(team_id)
        } else if current_state == AIState::RETREATING {
            self.state_retreating(team_id)
        } else if current_state == AIState::REGROUPING {
            self.state_regrouping(team_id)
        } else if current_state == AIState::EXPANDING {
            self.state_expanding(team_id)
        } else if current_state == AIState::END_GAME {
            self.state_endgame(team_id)
        }

        // Always update build queue
        self.process_build_queue(team_id)

        // Update attack groups
        self.update_attack_groups(team_id)
    }

    fn update_unit_tracking(&self, team_id: i32) {
        let team = self.teams[team_id]

        team.owned_unit_count = 0
        team.owned_building_count = 0

        // Query all things owned by this player
        // In a real implementation, this would iterate over the ThingFactory
    }

    // State handlers
    fn state_initial(&self, team_id: i32) {
        let team = self.teams[team_id]

        // Find our starting position
        if team.owned_building_count > 0 {
            // Use first building as base center
            // team.base_center = get_building_position(team.owned_buildings[0])
        }

        // Setup initial build list
        self.setup_initial_build_list(team_id)

        // Transition to building
        team.state = AIState::BUILDING
    }

    fn state_building(&self, team_id: i32) {
        let team = self.teams[team_id]

        // Check if we have enough army to attack
        let army_strength = self.calculate_army_strength(team_id)

        if army_strength >= team.attack_threshold {
            // Form attack group and transition to attacking
            self.form_attack_group(team_id, AttackGroupType::MAIN)
            team.state = AIState::ATTACKING
        }

        // Check if we need to defend
        if self.detect_threat_at_base(team_id) {
            team.state = AIState::DEFENDING
        }

        // Check if we should scout
        if self.game_time - team.last_scout_time > 60.0 {
            self.send_scout(team_id)
            team.last_scout_time = self.game_time
        }

        // Update state timer
        team.state_timer = team.state_timer + 1.0
    }

    fn state_defending(&self, team_id: i32) {
        let team = self.teams[team_id]

        // Rally all available units to base
        self.rally_units_to_base(team_id)

        // Check if threat is eliminated
        if !self.detect_threat_at_base(team_id) {
            team.state = AIState::BUILDING
        }
    }

    fn state_scouting(&self, team_id: i32) {
        let team = self.teams[team_id]
        team.state = AIState::BUILDING
    }

    fn state_attacking(&self, team_id: i32) {
        let team = self.teams[team_id]

        // Check attack group status
        let main_group_alive = self.is_attack_group_alive(team_id, 0)

        if !main_group_alive {
            // Attack failed, retreat and rebuild
            team.state = AIState::RETREATING
        }

        // Check if we need to defend base
        if self.detect_threat_at_base(team_id) {
            // Split force or retreat
            if team.defense_focus > 0.5 {
                team.state = AIState::RETREATING
            }
        }
    }

    fn state_retreating(&self, team_id: i32) {
        let team = self.teams[team_id]

        // Move all attack groups back to base
        for i in 0..team.attack_group_count {
            team.attack_groups[i].target_position = team.base_center.copy()
            team.attack_groups[i].attack_state = AttackGroupState::RETREATING
        }

        team.state = AIState::REGROUPING
    }

    fn state_regrouping(&self, team_id: i32) {
        let team = self.teams[team_id]

        // Wait for units to return, then go back to building
        let all_near_base = true // Check if units are near base

        if all_near_base {
            // Disband attack groups
            team.attack_group_count = 0
            team.state = AIState::BUILDING
        }
    }

    fn state_expanding(&self, team_id: i32) {
        let team = self.teams[team_id]

        // Try to build expansion base
        // This is GLA-specific or for maps with supply docks

        team.state = AIState::BUILDING
    }

    fn state_endgame(&self, team_id: i32) {
        let team = self.teams[team_id]

        // Late game - focus on superweapons and final push
        team.tech_focus = 1.0
        team.attack_threshold = 20.0
    }

    // Build queue management
    fn setup_initial_build_list(&self, team_id: i32) {
        let team = self.teams[team_id]

        // Get build template for faction
        let template_key = team.faction + "_Standard"

        let template = self.get_build_template(template_key)
        if template != null {
            team.build_list_count = 0

            for i in 0..template.buildings.length {
                if team.build_list_count >= MAX_BUILD_LIST {
                    break
                }

                let entry = BuildEntry::init()
                entry.object_name = template.buildings[i]
                entry.quantity = 1
                entry.priority = 1.0
                entry.is_upgrade = false
                entry.prerequisite_met = true

                team.build_list = team.build_list + [entry]
                team.build_list_count = team.build_list_count + 1
            }
        }

        // Add unit builds based on personality
        self.add_unit_builds_for_personality(team_id)
    }

    fn add_unit_builds_for_personality(&self, team_id: i32) {
        let team = self.teams[team_id]

        // Define units to add based on personality
        let units_to_add: [string] = []
        let quantities: [i32] = []

        if team.personality == AIPersonality::AGGRESSIVE {
            units_to_add = ["AmericaRanger", "AmericaHumvee"]
            quantities = [10, 5]
        } else if team.personality == AIPersonality::DEFENSIVE {
            units_to_add = ["AmericaPatriotMissile", "AmericaMissileDefender"]
            quantities = [4, 6]
        } else if team.personality == AIPersonality::TANK {
            units_to_add = ["AmericaCrusaderTank", "AmericaPaladinTank"]
            quantities = [8, 4]
        } else if team.personality == AIPersonality::INFANTRY {
            units_to_add = ["AmericaRanger", "AmericaMissileDefender", "AmericaPathfinder"]
            quantities = [15, 8, 4]
        } else if team.personality == AIPersonality::AIR {
            units_to_add = ["AmericaComanche", "AmericaRaptor"]
            quantities = [6, 4]
        } else {
            // Default balanced
            units_to_add = ["AmericaRanger", "AmericaCrusaderTank", "AmericaComanche"]
            quantities = [8, 4, 2]
        }

        for i in 0..units_to_add.length {
            if team.build_list_count >= MAX_BUILD_LIST {
                break
            }

            let entry = BuildEntry::init()
            entry.object_name = units_to_add[i]
            if i < quantities.length {
                entry.quantity = quantities[i]
            } else {
                entry.quantity = 1
            }
            entry.priority = 0.8
            entry.is_upgrade = false

            team.build_list = team.build_list + [entry]
            team.build_list_count = team.build_list_count + 1
        }
    }

    fn process_build_queue(&self, team_id: i32) {
        let team = self.teams[team_id]

        // Find highest priority item we can build
        let best_idx: i32 = -1
        let best_priority: f32 = 0.0

        for i in 0..team.build_list_count {
            let entry = team.build_list[i]

            if entry.quantity == 0 {
                continue
            }

            if !entry.prerequisite_met {
                continue
            }

            if entry.priority > best_priority {
                best_priority = entry.priority
                best_idx = i
            }
        }

        if best_idx >= 0 {
            // Issue build command
            team.build_list[best_idx].quantity = team.build_list[best_idx].quantity - 1
        }
    }

    // Attack group management
    fn form_attack_group(&self, team_id: i32, group_type: AttackGroupType) {
        let team = self.teams[team_id]

        if team.attack_group_count >= MAX_ATTACK_GROUPS {
            return
        }

        let group = AttackGroup::init()
        group.group_type = group_type
        group.attack_state = AttackGroupState::FORMING
        group.creation_time = self.game_time
        group.unit_count = 0

        // Add available combat units to group
        for i in 0..team.owned_unit_count {
            if group.unit_count >= MAX_UNITS_PER_GROUP {
                break
            }

            let unit_id = team.owned_units[i]
            group.unit_ids = group.unit_ids + [unit_id]
            group.unit_count = group.unit_count + 1
        }

        // Find target
        if team.known_enemy_count > 0 {
            group.target_position = team.known_enemy_positions[0].copy()
        }

        team.attack_groups = team.attack_groups + [group]
        team.attack_group_count = team.attack_group_count + 1
    }

    fn update_attack_groups(&self, team_id: i32) {
        let team = self.teams[team_id]

        for i in 0..team.attack_group_count {
            let group = team.attack_groups[i]

            if group.attack_state == AttackGroupState::FORMING {
                // Wait for minimum units
                if group.unit_count >= 5 {
                    group.attack_state = AttackGroupState::MOVING
                }
            } else if group.attack_state == AttackGroupState::MOVING {
                // Check if we've reached target
                // If enemies nearby, switch to attacking
            } else if group.attack_state == AttackGroupState::ATTACKING {
                // Check if we've won or need to retreat
            } else if group.attack_state == AttackGroupState::RETREATING {
                // Move back to base
                group.target_position = team.base_center.copy()
            }
        }
    }

    fn is_attack_group_alive(&self, team_id: i32, group_idx: i32): bool {
        let team = self.teams[team_id]

        if group_idx < 0 || group_idx >= team.attack_group_count {
            return false
        }

        return team.attack_groups[group_idx].unit_count >= 3
    }

    // Helper functions
    fn calculate_army_strength(&self, team_id: i32): f32 {
        let team = self.teams[team_id]
        // Simple strength calculation based on unit count
        return team.owned_unit_count as f32
    }

    fn detect_threat_at_base(&self, team_id: i32): bool {
        // Check for enemy units near base
        return false
    }

    fn send_scout(&self, team_id: i32) {
        // Find a fast unit and send it to explore
    }

    fn rally_units_to_base(&self, team_id: i32) {
        let team = self.teams[team_id]
        // Issue move command to all owned units to return to base
    }

    // Public interface
    fn get_team(&self, team_id: i32): AITeam? {
        if team_id >= 0 && team_id < self.team_count && self.teams[team_id].is_active {
            return self.teams[team_id]
        }
        return null
    }

    fn set_team_difficulty(&self, team_id: i32, difficulty: AIDifficulty) {
        if team_id >= 0 && team_id < self.team_count {
            self.teams[team_id].difficulty = difficulty
            self.apply_difficulty_modifiers(team_id)
        }
    }

    fn apply_difficulty_modifiers(&self, team_id: i32) {
        let team = self.teams[team_id]

        if team.difficulty == AIDifficulty::EASY {
            team.think_interval = 2.0
            team.attack_threshold = 15.0
            team.aggression = 0.3
        } else if team.difficulty == AIDifficulty::MEDIUM {
            team.think_interval = 1.0
            team.attack_threshold = 10.0
            team.aggression = 0.5
        } else if team.difficulty == AIDifficulty::HARD {
            team.think_interval = 0.5
            team.attack_threshold = 8.0
            team.aggression = 0.7
        } else if team.difficulty == AIDifficulty::BRUTAL {
            team.think_interval = 0.25
            team.attack_threshold = 5.0
            team.aggression = 0.9
        }
    }

    fn report_enemy_spotted(&self, team_id: i32, position: Vec3) {
        let team = self.teams[team_id]

        if team.known_enemy_count < MAX_KNOWN_ENEMIES {
            team.known_enemy_positions = team.known_enemy_positions + [position]
            team.known_enemy_count = team.known_enemy_count + 1
        }
    }
}

// ============================================================================
// GLOBAL AI BRAIN INSTANCE
// ============================================================================

let g_ai_brain: AIBrain? = null

fn init_ai_brain(): AIBrain {
    let brain = AIBrain::init()
    g_ai_brain = brain
    return brain
}

fn get_ai_brain(): AIBrain? {
    return g_ai_brain
}

fn shutdown_ai_brain() {
    g_ai_brain = null
}

fn ai_update(delta_time: f32) {
    if g_ai_brain != null {
        g_ai_brain.update(delta_time)
    }
}

fn ai_add_team(player_id: i32, faction: string, difficulty: AIDifficulty, personality: AIPersonality): i32 {
    if g_ai_brain != null {
        return g_ai_brain.add_team(player_id, faction, difficulty, personality)
    }
    return -1
}

fn ai_remove_team(team_id: i32) {
    if g_ai_brain != null {
        g_ai_brain.remove_team(team_id)
    }
}

fn ai_set_difficulty(team_id: i32, difficulty: AIDifficulty) {
    if g_ai_brain != null {
        g_ai_brain.set_team_difficulty(team_id, difficulty)
    }
}

fn ai_report_enemy(team_id: i32, x: f32, y: f32, z: f32) {
    if g_ai_brain != null {
        g_ai_brain.report_enemy_spotted(team_id, Vec3::create(x, y, z))
    }
}
