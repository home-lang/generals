// Weapon System - Handles weapon firing, projectiles, and damage
// Implements the C&C Generals combat system

let MAX_PROJECTILES: i32 = 1024
let MAX_DAMAGE_EVENTS: i32 = 256
let MAX_WEAPONS_PER_UNIT: i32 = 3

// Weapon slot indices
enum WeaponSlot {
    PRIMARY,
    SECONDARY,
    TERTIARY,
}

// Weapon state
enum WeaponState {
    IDLE,
    PRE_ATTACK,
    FIRING,
    RELOADING,
    BETWEEN_SHOTS,
    OUT_OF_RANGE,
    NO_AMMO,
}

// Projectile state
enum ProjectileState {
    ACTIVE,
    DETONATED,
    EXPIRED,
}

// Damage types
enum DamageType {
    EXPLOSION,
    CRUSH,
    ARMOR_PIERCING,
    SMALL_ARMS,
    SNIPER,
    FLAME,
    LASER,
    POISON,
    RADIATION,
    WATER,
    UNRESISTABLE,
    HEALING,
}

// 3D vector
struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(): Vec3 {
        return Vec3 {
            x: 0.0,
            y: 0.0,
            z: 0.0,
        }
    }

    fn create(x: f32, y: f32, z: f32): Vec3 {
        return Vec3 {
            x: x,
            y: y,
            z: z,
        }
    }

    fn copy(&self): Vec3 {
        return Vec3 {
            x: self.x,
            y: self.y,
            z: self.z,
        }
    }

    fn length(&self): f32 {
        return sqrt(self.x * self.x + self.y * self.y + self.z * self.z)
    }

    fn normalized(&self): Vec3 {
        let len = self.length()
        if len > 0.001 {
            return Vec3 {
                x: self.x / len,
                y: self.y / len,
                z: self.z / len,
            }
        }
        return Vec3::init()
    }

    fn distance(a: Vec3, b: Vec3): f32 {
        let dx = b.x - a.x
        let dy = b.y - a.y
        let dz = b.z - a.z
        return sqrt(dx * dx + dy * dy + dz * dz)
    }

    fn direction(from: Vec3, to: Vec3): Vec3 {
        let dx = to.x - from.x
        let dy = to.y - from.y
        let dz = to.z - from.z
        let len = sqrt(dx * dx + dy * dy + dz * dz)

        if len > 0.001 {
            return Vec3 {
                x: dx / len,
                y: dy / len,
                z: dz / len,
            }
        }
        return Vec3::init()
    }
}

// Projectile definition (from weapon)
struct ProjectileDefinition {
    projectile_name: string,
    projectile_speed: f32,
    projectile_arc: f32,
    projectile_self_homing: bool,
    projectile_turn_rate: f32,
    exhaust_fx: string,
    is_valid: bool,
}

impl ProjectileDefinition {
    fn init(): ProjectileDefinition {
        return ProjectileDefinition {
            projectile_name: "",
            projectile_speed: 100.0,
            projectile_arc: 0.0,
            projectile_self_homing: false,
            projectile_turn_rate: 0.0,
            exhaust_fx: "",
            is_valid: false,
        }
    }
}

// Damage nugget
struct DamageNugget {
    damage_type: DamageType,
    damage: f32,
    radius: f32,
    death_type: string,
    is_valid: bool,
}

impl DamageNugget {
    fn init(): DamageNugget {
        return DamageNugget {
            damage_type: DamageType::EXPLOSION,
            damage: 0.0,
            radius: 0.0,
            death_type: "",
            is_valid: false,
        }
    }
}

// Weapon definition
struct WeaponDefinition {
    name: string,
    attack_range: f32,
    minimum_attack_range: f32,
    pre_attack_delay: i32,
    delay_between_shots: i32,
    clip_size: i32,
    clip_reload_time: i32,
    primary_damage: f32,
    primary_damage_radius: f32,
    secondary_damage: f32,
    secondary_damage_radius: f32,
    damage_type: DamageType,
    death_type: string,
    projectile: ProjectileDefinition,
    damage_nuggets: [DamageNugget],
    damage_nugget_count: i32,
    is_valid: bool,
}

impl WeaponDefinition {
    fn init(): WeaponDefinition {
        return WeaponDefinition {
            name: "",
            attack_range: 100.0,
            minimum_attack_range: 0.0,
            pre_attack_delay: 0,
            delay_between_shots: 1000,
            clip_size: 1,
            clip_reload_time: 0,
            primary_damage: 10.0,
            primary_damage_radius: 0.0,
            secondary_damage: 0.0,
            secondary_damage_radius: 0.0,
            damage_type: DamageType::EXPLOSION,
            death_type: "NORMAL",
            projectile: ProjectileDefinition::init(),
            damage_nuggets: [],
            damage_nugget_count: 0,
            is_valid: false,
        }
    }
}

// Active weapon instance on a unit
struct WeaponInstance {
    definition: WeaponDefinition,
    slot: WeaponSlot,
    state: WeaponState,

    // Target
    target_id: i32,
    target_position: Vec3,
    has_target: bool,

    // Firing state
    current_clip: i32,
    pre_attack_timer: f32,
    fire_timer: f32,
    reload_timer: f32,

    // Bonuses
    damage_bonus: f32,
    range_bonus: f32,
    rate_of_fire_bonus: f32,

    // Status
    is_active: bool,
    can_fire: bool,
    in_range: bool,
}

impl WeaponInstance {
    fn init(definition: WeaponDefinition, slot: WeaponSlot): WeaponInstance {
        return WeaponInstance {
            definition: definition,
            slot: slot,
            state: WeaponState::IDLE,
            target_id: 0,
            target_position: Vec3::init(),
            has_target: false,
            current_clip: definition.clip_size,
            pre_attack_timer: 0.0,
            fire_timer: 0.0,
            reload_timer: 0.0,
            damage_bonus: 0.0,
            range_bonus: 0.0,
            rate_of_fire_bonus: 0.0,
            is_active: true,
            can_fire: true,
            in_range: false,
        }
    }

    fn update(&self, delta_time: f32, dist_to_target: f32) {
        let def = self.definition

        // Check range
        let effective_range = def.attack_range + self.range_bonus
        self.in_range = dist_to_target <= effective_range && dist_to_target >= def.minimum_attack_range

        if self.state == WeaponState::IDLE {
            if self.has_target && self.in_range {
                self.state = WeaponState::PRE_ATTACK
                self.pre_attack_timer = def.pre_attack_delay as f32 / 1000.0
            }
        } else if self.state == WeaponState::PRE_ATTACK {
            self.pre_attack_timer = self.pre_attack_timer - delta_time
            if self.pre_attack_timer <= 0.0 {
                self.state = WeaponState::FIRING
                self.can_fire = true
            }
        } else if self.state == WeaponState::BETWEEN_SHOTS {
            self.fire_timer = self.fire_timer - delta_time
            if self.fire_timer <= 0.0 {
                if self.current_clip > 0 {
                    self.state = WeaponState::FIRING
                    self.can_fire = true
                } else {
                    self.state = WeaponState::RELOADING
                    self.reload_timer = def.clip_reload_time as f32 / 1000.0
                }
            }
        } else if self.state == WeaponState::RELOADING {
            self.reload_timer = self.reload_timer - delta_time
            if self.reload_timer <= 0.0 {
                self.current_clip = def.clip_size
                self.state = WeaponState::IDLE
            }
        } else if self.state == WeaponState::OUT_OF_RANGE {
            if self.in_range {
                self.state = WeaponState::IDLE
            }
        }
    }

    fn on_fired(&self) {
        let def = self.definition

        self.can_fire = false
        self.current_clip = self.current_clip - 1

        // Calculate delay with rate of fire bonus
        let base_delay = def.delay_between_shots as f32 / 1000.0
        let bonus_mult = 1.0 - (self.rate_of_fire_bonus / 100.0)
        if bonus_mult < 0.1 {
            bonus_mult = 0.1
        }
        self.fire_timer = base_delay * bonus_mult

        self.state = WeaponState::BETWEEN_SHOTS
    }

    fn set_target(&self, target_id: i32, position: Vec3) {
        self.target_id = target_id
        self.target_position = position
        self.has_target = true
    }

    fn clear_target(&self) {
        self.target_id = 0
        self.has_target = false
        self.state = WeaponState::IDLE
    }

    fn get_effective_damage(&self): f32 {
        let base_damage = self.definition.primary_damage
        return base_damage * (1.0 + self.damage_bonus / 100.0)
    }

    fn get_effective_range(&self): f32 {
        return self.definition.attack_range + self.range_bonus
    }
}

// Active projectile in flight
struct Projectile {
    id: i32,

    // Source
    owner_id: i32,
    weapon_name: string,
    primary_damage: f32,
    damage_type: DamageType,
    damage_radius: f32,
    death_type: string,

    // Position and movement
    position: Vec3,
    velocity: Vec3,
    target_position: Vec3,
    target_id: i32,

    // Tracking
    is_homing: bool,
    turn_rate: f32,

    // State
    state: ProjectileState,
    lifetime: f32,
    max_lifetime: f32,

    // Visual
    model_name: string,
    trail_fx: string,

    // Damage
    damage_dealt: bool,
}

impl Projectile {
    fn init(): Projectile {
        return Projectile {
            id: 0,
            owner_id: 0,
            weapon_name: "",
            primary_damage: 0.0,
            damage_type: DamageType::EXPLOSION,
            damage_radius: 0.0,
            death_type: "",
            position: Vec3::init(),
            velocity: Vec3::init(),
            target_position: Vec3::init(),
            target_id: 0,
            is_homing: false,
            turn_rate: 0.0,
            state: ProjectileState::EXPIRED,
            lifetime: 0.0,
            max_lifetime: 0.0,
            model_name: "",
            trail_fx: "",
            damage_dealt: false,
        }
    }
}

// Damage event for things to process
struct DamageEvent {
    source_id: i32,
    target_id: i32,
    damage_type: DamageType,
    damage_amount: f32,
    death_type: string,
    position: Vec3,
    radius: f32,
    is_area_damage: bool,
}

impl DamageEvent {
    fn init(): DamageEvent {
        return DamageEvent {
            source_id: 0,
            target_id: 0,
            damage_type: DamageType::EXPLOSION,
            damage_amount: 0.0,
            death_type: "",
            position: Vec3::init(),
            radius: 0.0,
            is_area_damage: false,
        }
    }
}

// Weapon System
struct WeaponSystem {
    // Active projectiles
    projectiles: [Projectile],
    projectile_count: i32,
    next_projectile_id: i32,

    // Pending damage events
    damage_events: [DamageEvent],
    damage_event_count: i32,

    // Settings
    gravity: f32,

    is_initialized: bool,
}

impl WeaponSystem {
    fn init(): WeaponSystem {
        let system = WeaponSystem {
            projectiles: [],
            projectile_count: 0,
            next_projectile_id: 1,
            damage_events: [],
            damage_event_count: 0,
            gravity: 9.81,
            is_initialized: true,
        }

        // Pre-allocate projectile and damage event slots
        for i in 0..MAX_PROJECTILES {
            system.projectiles = system.projectiles + [Projectile::init()]
        }
        for i in 0..MAX_DAMAGE_EVENTS {
            system.damage_events = system.damage_events + [DamageEvent::init()]
        }

        return system
    }

    // Main update loop
    fn update(&self, delta_time: f32) {
        // Update all active projectiles
        self.update_projectiles(delta_time)

        // Process damage events
        self.process_damage_events()
    }

    // Fire a weapon at a target
    fn fire_weapon(&self, weapon: WeaponInstance, shooter_id: i32,
                   muzzle_position: Vec3, target_position: Vec3, target_id: i32) {
        if !weapon.is_active || !weapon.can_fire {
            return
        }

        let def = weapon.definition

        // Check if weapon has projectile
        if def.projectile.is_valid {
            // Create projectile
            self.create_projectile(def, shooter_id, muzzle_position, target_position, target_id)
        } else {
            // Instant hit weapon (hitscan)
            self.apply_instant_damage(def, shooter_id, muzzle_position, target_position, target_id)
        }
    }

    fn create_projectile(&self, weapon: WeaponDefinition, owner_id: i32,
                         start_pos: Vec3, target_pos: Vec3, target_id: i32) {
        if self.projectile_count >= MAX_PROJECTILES {
            // Find and remove oldest projectile
            self.remove_oldest_projectile()
        }

        let idx = self.find_free_projectile_slot()
        if idx >= MAX_PROJECTILES {
            return
        }

        let projectile = self.projectiles[idx]
        projectile.id = self.next_projectile_id
        self.next_projectile_id = self.next_projectile_id + 1

        projectile.owner_id = owner_id
        projectile.weapon_name = weapon.name
        projectile.primary_damage = weapon.primary_damage
        projectile.damage_type = weapon.damage_type
        projectile.damage_radius = weapon.primary_damage_radius
        projectile.death_type = weapon.death_type
        projectile.position = start_pos.copy()
        projectile.target_position = target_pos.copy()
        projectile.target_id = target_id
        projectile.state = ProjectileState::ACTIVE

        // Calculate initial velocity
        let direction = Vec3::direction(start_pos, target_pos)
        let speed = weapon.projectile.projectile_speed

        if weapon.projectile.projectile_arc > 0.0 {
            // Ballistic projectile - calculate arc trajectory
            projectile.velocity = self.calculate_ballistic_velocity(
                start_pos, target_pos, speed, weapon.projectile.projectile_arc
            )
        } else {
            // Direct fire
            projectile.velocity = Vec3 {
                x: direction.x * speed,
                y: direction.y * speed,
                z: direction.z * speed,
            }
        }

        projectile.is_homing = weapon.projectile.projectile_self_homing
        projectile.turn_rate = weapon.projectile.projectile_turn_rate

        // Calculate lifetime based on distance and speed
        let dist = Vec3::distance(start_pos, target_pos)
        projectile.max_lifetime = (dist / speed) * 2.0 // Double for safety
        projectile.lifetime = 0.0

        projectile.model_name = weapon.projectile.projectile_name
        projectile.trail_fx = weapon.projectile.exhaust_fx
        projectile.damage_dealt = false

        self.projectile_count = self.projectile_count + 1
    }

    fn calculate_ballistic_velocity(&self, start: Vec3, target: Vec3,
                                    speed: f32, arc: f32): Vec3 {
        let dx = target.x - start.x
        let dy = target.y - start.y
        let dz = target.z - start.z

        // Calculate launch angle for desired arc
        let angle = arc * 0.0174533 // to radians
        let vz = speed * sin(angle)
        let vh = speed * cos(angle)

        // Horizontal direction
        let h_len = sqrt(dx * dx + dy * dy)
        let nx: f32 = 0.0
        let ny: f32 = 0.0
        if h_len > 0.001 {
            nx = dx / h_len
            ny = dy / h_len
        }

        return Vec3 {
            x: nx * vh,
            y: ny * vh,
            z: vz,
        }
    }

    fn update_projectiles(&self, delta_time: f32) {
        for i in 0..self.projectiles.length {
            let projectile = self.projectiles[i]

            if projectile.state == ProjectileState::ACTIVE {
                self.update_single_projectile(i, delta_time)
            }
        }
    }

    fn update_single_projectile(&self, idx: i32, delta_time: f32) {
        let projectile = self.projectiles[idx]

        // Update lifetime
        projectile.lifetime = projectile.lifetime + delta_time
        if projectile.lifetime >= projectile.max_lifetime {
            projectile.state = ProjectileState::EXPIRED
            self.projectile_count = self.projectile_count - 1
            return
        }

        // Homing behavior
        if projectile.is_homing && projectile.target_id != 0 {
            // In real implementation, query target position from ThingFactory
            // For now, just track towards stored target position

            // Adjust velocity towards target
            let to_target = Vec3::direction(projectile.position, projectile.target_position)
            let turn_amount = projectile.turn_rate * delta_time

            projectile.velocity = self.turn_velocity(
                projectile.velocity,
                to_target,
                turn_amount
            )
        }

        // Apply gravity to ballistic projectiles
        // (check if arc > 0 would need to be stored in projectile)
        // projectile.velocity.z = projectile.velocity.z - self.gravity * delta_time

        // Update position
        projectile.position.x = projectile.position.x + projectile.velocity.x * delta_time
        projectile.position.y = projectile.position.y + projectile.velocity.y * delta_time
        projectile.position.z = projectile.position.z + projectile.velocity.z * delta_time

        // Check for collision/impact
        if self.check_projectile_impact(idx) {
            self.detonate_projectile(idx)
        }
    }

    fn turn_velocity(&self, current: Vec3, target_dir: Vec3, max_turn: f32): Vec3 {
        let speed = current.length()
        let current_dir = current.normalized()

        // Interpolate direction
        let new_dir_x = current_dir.x + (target_dir.x - current_dir.x) * max_turn
        let new_dir_y = current_dir.y + (target_dir.y - current_dir.y) * max_turn
        let new_dir_z = current_dir.z + (target_dir.z - current_dir.z) * max_turn

        let new_dir = Vec3::create(new_dir_x, new_dir_y, new_dir_z).normalized()

        return Vec3 {
            x: new_dir.x * speed,
            y: new_dir.y * speed,
            z: new_dir.z * speed,
        }
    }

    fn check_projectile_impact(&self, idx: i32): bool {
        let projectile = self.projectiles[idx]

        // Check if close enough to target
        let dist_to_target = Vec3::distance(projectile.position, projectile.target_position)

        // Impact radius based on projectile speed
        let impact_radius = 5.0 // minimum impact radius

        if dist_to_target <= impact_radius {
            return true
        }

        // Check if hit ground (z <= terrain height)
        if projectile.position.z <= 0.0 {
            return true
        }

        return false
    }

    fn detonate_projectile(&self, idx: i32) {
        let projectile = self.projectiles[idx]

        if projectile.damage_dealt {
            return
        }

        projectile.state = ProjectileState::DETONATED
        projectile.damage_dealt = true

        let impact_pos = projectile.position.copy()

        // Create damage event
        self.create_damage_event(
            projectile.owner_id,
            projectile.target_id,
            projectile.damage_type,
            projectile.primary_damage,
            projectile.death_type,
            impact_pos,
            projectile.damage_radius,
            projectile.damage_radius > 0.0
        )

        self.projectile_count = self.projectile_count - 1
    }

    fn apply_instant_damage(&self, weapon: WeaponDefinition, shooter_id: i32,
                           muzzle_pos: Vec3, target_pos: Vec3, target_id: i32) {
        // Direct hit weapon (laser, bullet, etc.)
        self.create_damage_event(
            shooter_id,
            target_id,
            weapon.damage_type,
            weapon.primary_damage,
            weapon.death_type,
            target_pos,
            weapon.primary_damage_radius,
            weapon.primary_damage_radius > 0.0
        )
    }

    fn create_damage_event(&self, source_id: i32, target_id: i32,
                          damage_type: DamageType, damage: f32,
                          death_type: string, position: Vec3,
                          radius: f32, is_area: bool) {
        if self.damage_event_count >= MAX_DAMAGE_EVENTS {
            return
        }

        let idx = self.damage_event_count
        self.damage_events[idx].source_id = source_id
        self.damage_events[idx].target_id = target_id
        self.damage_events[idx].damage_type = damage_type
        self.damage_events[idx].damage_amount = damage
        self.damage_events[idx].death_type = death_type
        self.damage_events[idx].position = position.copy()
        self.damage_events[idx].radius = radius
        self.damage_events[idx].is_area_damage = is_area

        self.damage_event_count = self.damage_event_count + 1
    }

    fn process_damage_events(&self) {
        for i in 0..self.damage_event_count {
            let event = self.damage_events[i]

            if event.is_area_damage {
                self.apply_area_damage(event)
            } else {
                self.apply_direct_damage(event)
            }
        }

        // Clear events
        self.damage_event_count = 0
    }

    fn apply_direct_damage(&self, event: DamageEvent) {
        if event.target_id == 0 {
            return
        }

        // In real implementation:
        // let target = thing_factory.get_thing(event.target_id)
        // target.take_damage(event.damage_amount, event.damage_type, event.source_id)
    }

    fn apply_area_damage(&self, event: DamageEvent) {
        // Query spatial hash for all things within radius
        // For each thing, calculate damage falloff based on distance
        // Apply damage

        // Damage falloff: full damage at center, linear falloff to edge
        // let damage = event.damage_amount * (1.0 - dist / event.radius)
    }

    fn find_free_projectile_slot(&self): i32 {
        for i in 0..self.projectiles.length {
            if self.projectiles[i].state == ProjectileState::EXPIRED || self.projectiles[i].id == 0 {
                return i
            }
        }
        return MAX_PROJECTILES
    }

    fn remove_oldest_projectile(&self) {
        let oldest_idx: i32 = 0
        let oldest_time: f32 = 0.0

        for i in 0..self.projectiles.length {
            if self.projectiles[i].state == ProjectileState::ACTIVE {
                if self.projectiles[i].lifetime > oldest_time {
                    oldest_time = self.projectiles[i].lifetime
                    oldest_idx = i
                }
            }
        }

        self.projectiles[oldest_idx].state = ProjectileState::EXPIRED
        self.projectile_count = self.projectile_count - 1
    }

    fn get_projectile_count(&self): i32 {
        return self.projectile_count
    }
}

