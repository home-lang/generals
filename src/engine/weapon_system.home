// ============================================================================
// GLOBAL WEAPON SYSTEM INSTANCE
// ============================================================================

let g_weapon_system: WeaponSystem? = null

fn init_weapon_system(): WeaponSystem {
    let system = WeaponSystem::init()
    g_weapon_system = system
    return system
}

fn get_weapon_system(): WeaponSystem? {
    return g_weapon_system
}

fn shutdown_weapon_system() {
    g_weapon_system = null
}

fn weapon_system_update(delta_time: f32) {
    if g_weapon_system != null {
        g_weapon_system.update(delta_time)
    }
}

fn weapon_fire(weapon: WeaponInstance, shooter_id: i32, muzzle_x: f32, muzzle_y: f32, muzzle_z: f32,
               target_x: f32, target_y: f32, target_z: f32, target_id: i32) {
    if g_weapon_system != null {
        let muzzle = Vec3::create(muzzle_x, muzzle_y, muzzle_z)
        let target = Vec3::create(target_x, target_y, target_z)
        g_weapon_system.fire_weapon(weapon, shooter_id, muzzle, target, target_id)
    }
}
