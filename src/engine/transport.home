// Transport - Network transport layer abstraction
// Handles packet serialization, reliability, and connection management

// ============================================================================
// Configuration
// ============================================================================

struct TransportConfig {
    max_packet_size: i32,
    max_pending_packets: i32,
    reliable_timeout: f32,
    max_retries: i32,
    keepalive_interval: f32,
    connection_timeout: f32,
    enable_compression: bool,
    compression_threshold: i32,
    enable_encryption: bool,
    fragment_threshold: i32,
}

impl TransportConfig {
    fn init(): TransportConfig {
        return TransportConfig {
            max_packet_size: 1400,
            max_pending_packets: 256,
            reliable_timeout: 0.5,
            max_retries: 5,
            keepalive_interval: 5.0,
            connection_timeout: 30.0,
            enable_compression: true,
            compression_threshold: 100,
            enable_encryption: false,
            fragment_threshold: 1200,
        }
    }
}

// ============================================================================
// Packet Types
// ============================================================================

enum PacketType {
    Unreliable,
    Reliable,
    ReliableOrdered,
    ReliableSequenced,
    Fragment,
    Ack,
    Keepalive,
    Connect,
    Disconnect,
    ConnectAccept,
    ConnectReject,
}

enum PacketFlags {
    None,
    Compressed,
    Encrypted,
    Fragmented,
    Priority,
}

struct PacketHeader {
    packet_type: PacketType,
    flags: i32,
    sequence_number: i32,
    ack_number: i32,
    ack_bits: i32,
    channel: i32,
    fragment_id: i32,
    fragment_index: i32,
    fragment_count: i32,
    payload_size: i32,
}

impl PacketHeader {
    fn init(packet_type: PacketType, sequence: i32): PacketHeader {
        return PacketHeader {
            packet_type: packet_type,
            flags: 0,
            sequence_number: sequence,
            ack_number: 0,
            ack_bits: 0,
            channel: 0,
            fragment_id: 0,
            fragment_index: 0,
            fragment_count: 1,
            payload_size: 0,
        }
    }
}

// ============================================================================
// Packet Buffer
// ============================================================================

struct PacketBuffer {
    data: [i32],
    size: i32,
    read_pos: i32,
    write_pos: i32,
}

impl PacketBuffer {
    fn init(): PacketBuffer {
        let data: [i32] = []
        for i in 0..1500 {
            data = data + [0]
        }
        return PacketBuffer {
            data: data,
            size: 0,
            read_pos: 0,
            write_pos: 0,
        }
    }
}

fn buffer_write_u8(buffer: PacketBuffer, value: i32) {
    if buffer.write_pos < 1500 {
        buffer.data[buffer.write_pos] = value & 0xFF
        buffer.write_pos = buffer.write_pos + 1
        buffer.size = buffer.write_pos
    }
}

fn buffer_write_u16(buffer: PacketBuffer, value: i32) {
    buffer_write_u8(buffer, value & 0xFF)
    buffer_write_u8(buffer, (value >> 8) & 0xFF)
}

fn buffer_write_u32(buffer: PacketBuffer, value: i32) {
    buffer_write_u8(buffer, value & 0xFF)
    buffer_write_u8(buffer, (value >> 8) & 0xFF)
    buffer_write_u8(buffer, (value >> 16) & 0xFF)
    buffer_write_u8(buffer, (value >> 24) & 0xFF)
}

fn buffer_write_f32(buffer: PacketBuffer, value: f32) {
    let bits = float_to_bits(value)
    buffer_write_u32(buffer, bits)
}

fn buffer_write_bytes(buffer: PacketBuffer, data: [i32], len: i32) {
    for i in 0..len {
        if buffer.write_pos < 1500 {
            buffer.data[buffer.write_pos] = data[i]
            buffer.write_pos = buffer.write_pos + 1
        }
    }
    buffer.size = buffer.write_pos
}

fn buffer_read_u8(buffer: PacketBuffer): i32 {
    if buffer.read_pos < buffer.size {
        let value = buffer.data[buffer.read_pos]
        buffer.read_pos = buffer.read_pos + 1
        return value
    }
    return 0
}

fn buffer_read_u16(buffer: PacketBuffer): i32 {
    let low = buffer_read_u8(buffer)
    let high = buffer_read_u8(buffer)
    return low | (high << 8)
}

fn buffer_read_u32(buffer: PacketBuffer): i32 {
    let b0 = buffer_read_u8(buffer)
    let b1 = buffer_read_u8(buffer)
    let b2 = buffer_read_u8(buffer)
    let b3 = buffer_read_u8(buffer)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn buffer_read_f32(buffer: PacketBuffer): f32 {
    let bits = buffer_read_u32(buffer)
    return bits_to_float(bits)
}

fn buffer_reset(buffer: PacketBuffer) {
    buffer.read_pos = 0
    buffer.write_pos = 0
    buffer.size = 0
}

// ============================================================================
// Pending Packet (for reliable delivery)
// ============================================================================

struct PendingPacket {
    sequence: i32,
    packet_type: PacketType,
    channel: i32,
    data: [i32],
    size: i32,
    send_time: f32,
    retry_count: i32,
    is_acked: bool,
    is_active: bool,
}

impl PendingPacket {
    fn init(sequence: i32, packet_type: PacketType): PendingPacket {
        let data: [i32] = []
        for i in 0..1500 {
            data = data + [0]
        }
        return PendingPacket {
            sequence: sequence,
            packet_type: packet_type,
            channel: 0,
            data: data,
            size: 0,
            send_time: 0.0,
            retry_count: 0,
            is_acked: false,
            is_active: false,
        }
    }
}

// ============================================================================
// Fragment Assembly
// ============================================================================

struct FragmentAssembly {
    fragment_id: i32,
    total_fragments: i32,
    received_mask: i32,
    fragments: [[i32]],
    fragment_sizes: [i32],
    start_time: f32,
    is_complete: bool,
}

impl FragmentAssembly {
    fn init(fragment_id: i32, total: i32): FragmentAssembly {
        let frags: [[i32]] = []
        let sizes: [i32] = []
        for i in 0..16 {
            let frag: [i32] = []
            for j in 0..1400 {
                frag = frag + [0]
            }
            frags = frags + [frag]
            sizes = sizes + [0]
        }
        return FragmentAssembly {
            fragment_id: fragment_id,
            total_fragments: total,
            received_mask: 0,
            fragments: frags,
            fragment_sizes: sizes,
            start_time: 0.0,
            is_complete: false,
        }
    }
}

fn add_fragment(assembly: FragmentAssembly, index: i32, data: [i32], size: i32): bool {
    if index >= assembly.total_fragments || index >= 16 {
        return false
    }

    // Copy fragment data
    for i in 0..size {
        if i < 1400 {
            assembly.fragments[index][i] = data[i]
        }
    }
    assembly.fragment_sizes[index] = size

    // Mark as received
    assembly.received_mask = assembly.received_mask | (1 << index)

    // Check if complete
    let expected_mask = (1 << assembly.total_fragments) - 1
    assembly.is_complete = assembly.received_mask == expected_mask

    return assembly.is_complete
}

fn assemble_fragments(assembly: FragmentAssembly, out_buffer: PacketBuffer) {
    buffer_reset(out_buffer)

    for i in 0..assembly.total_fragments {
        let size = assembly.fragment_sizes[i]
        for j in 0..size {
            if out_buffer.write_pos < 1500 {
                out_buffer.data[out_buffer.write_pos] = assembly.fragments[i][j]
                out_buffer.write_pos = out_buffer.write_pos + 1
            }
        }
    }
    out_buffer.size = out_buffer.write_pos
}

// ============================================================================
// Connection State
// ============================================================================

enum ConnectionState {
    Disconnected,
    Connecting,
    Connected,
    Disconnecting,
}

struct Connection {
    connection_id: i64,
    remote_address: string,
    remote_port: i32,
    state: ConnectionState,

    // Sequence numbers
    local_sequence: i32,
    remote_sequence: i32,
    ack_bits: i32,

    // Timing
    last_send_time: f32,
    last_receive_time: f32,
    round_trip_time: f32,
    rtt_variance: f32,

    // Pending packets
    pending_reliable: [PendingPacket],
    pending_count: i32,

    // Fragment assembly
    fragment_assemblies: [FragmentAssembly],
    assembly_count: i32,

    // Statistics
    packets_sent: i64,
    packets_received: i64,
    packets_lost: i64,
    bytes_sent: i64,
    bytes_received: i64,
}

impl Connection {
    fn init(connection_id: i64, address: string, port: i32): Connection {
        let pending: [PendingPacket] = []
        for i in 0..64 {
            pending = pending + [PendingPacket::init(0, PacketType::Reliable)]
        }
        let assemblies: [FragmentAssembly] = []
        for i in 0..8 {
            assemblies = assemblies + [FragmentAssembly::init(0, 0)]
        }
        return Connection {
            connection_id: connection_id,
            remote_address: address,
            remote_port: port,
            state: ConnectionState::Disconnected,
            local_sequence: 0,
            remote_sequence: 0,
            ack_bits: 0,
            last_send_time: 0.0,
            last_receive_time: 0.0,
            round_trip_time: 0.1,
            rtt_variance: 0.01,
            pending_reliable: pending,
            pending_count: 0,
            fragment_assemblies: assemblies,
            assembly_count: 0,
            packets_sent: 0,
            packets_received: 0,
            packets_lost: 0,
            bytes_sent: 0,
            bytes_received: 0,
        }
    }
}

// ============================================================================
// Transport Layer
// ============================================================================

struct OutgoingPacket {
    connection_id: i64,
    packet_type: PacketType,
    channel: i32,
    buffer: PacketBuffer,
    is_active: bool,
}

impl OutgoingPacket {
    fn init(): OutgoingPacket {
        return OutgoingPacket {
            connection_id: 0,
            packet_type: PacketType::Unreliable,
            channel: 0,
            buffer: PacketBuffer::init(),
            is_active: false,
        }
    }
}

struct IncomingPacket {
    connection_id: i64,
    buffer: PacketBuffer,
    receive_time: f32,
    is_active: bool,
}

impl IncomingPacket {
    fn init(): IncomingPacket {
        return IncomingPacket {
            connection_id: 0,
            buffer: PacketBuffer::init(),
            receive_time: 0.0,
            is_active: false,
        }
    }
}

struct Transport {
    config: TransportConfig,
    connections: [Connection],
    connection_count: i32,
    next_connection_id: i64,
    current_time: f32,

    // Outgoing packet queue
    outgoing_queue: [OutgoingPacket],
    outgoing_count: i32,

    // Incoming packet queue
    incoming_queue: [IncomingPacket],
    incoming_count: i32,
}

impl Transport {
    fn init(config: TransportConfig): Transport {
        let conns: [Connection] = []
        for i in 0..32 {
            conns = conns + [Connection::init(0, "", 0)]
        }
        let outgoing: [OutgoingPacket] = []
        for i in 0..256 {
            outgoing = outgoing + [OutgoingPacket::init()]
        }
        let incoming: [IncomingPacket] = []
        for i in 0..256 {
            incoming = incoming + [IncomingPacket::init()]
        }
        return Transport {
            config: config,
            connections: conns,
            connection_count: 0,
            next_connection_id: 1,
            current_time: 0.0,
            outgoing_queue: outgoing,
            outgoing_count: 0,
            incoming_queue: incoming,
            incoming_count: 0,
        }
    }
}

// ============================================================================
// Connection Management
// ============================================================================

fn transport_connect(transport: Transport, address: string, port: i32): i64 {
    if transport.connection_count >= 32 {
        return 0
    }

    let connection_id = transport.next_connection_id
    transport.next_connection_id = transport.next_connection_id + 1

    let idx = transport.connection_count
    transport.connections[idx] = Connection::init(connection_id, address, port)
    transport.connections[idx].state = ConnectionState::Connecting
    transport.connection_count = transport.connection_count + 1

    // Send connect packet
    send_connect_packet(transport, connection_id)

    return connection_id
}

fn transport_disconnect(transport: Transport, connection_id: i64) {
    for i in 0..transport.connection_count {
        if transport.connections[i].connection_id == connection_id {
            transport.connections[i].state = ConnectionState::Disconnecting
            send_disconnect_packet(transport, connection_id)
            return
        }
    }
}

fn get_connection(transport: Transport, connection_id: i64): Connection? {
    for i in 0..transport.connection_count {
        if transport.connections[i].connection_id == connection_id {
            return transport.connections[i]
        }
    }
    return null
}

fn close_connection(transport: Transport, connection_id: i64) {
    for i in 0..transport.connection_count {
        if transport.connections[i].connection_id == connection_id {
            // Shift remaining connections
            for j in i..(transport.connection_count - 1) {
                transport.connections[j] = transport.connections[j + 1]
            }
            transport.connection_count = transport.connection_count - 1
            return
        }
    }
}

// ============================================================================
// Send Functions
// ============================================================================

fn send_unreliable(transport: Transport, connection_id: i64, data: [i32], size: i32) {
    queue_packet(transport, connection_id, PacketType::Unreliable, 0, data, size)
}

fn send_reliable(transport: Transport, connection_id: i64, data: [i32], size: i32) {
    queue_packet(transport, connection_id, PacketType::Reliable, 0, data, size)
}

fn send_reliable_ordered(transport: Transport, connection_id: i64, channel: i32, data: [i32], size: i32) {
    queue_packet(transport, connection_id, PacketType::ReliableOrdered, channel, data, size)
}

fn queue_packet(transport: Transport, connection_id: i64, packet_type: PacketType, channel: i32, data: [i32], size: i32) {
    if transport.outgoing_count >= 256 {
        return
    }

    // Check if fragmentation needed
    if size > transport.config.fragment_threshold {
        queue_fragmented_packet(transport, connection_id, packet_type, channel, data, size)
        return
    }

    let idx = transport.outgoing_count
    transport.outgoing_queue[idx].connection_id = connection_id
    transport.outgoing_queue[idx].packet_type = packet_type
    transport.outgoing_queue[idx].channel = channel
    buffer_reset(transport.outgoing_queue[idx].buffer)
    buffer_write_bytes(transport.outgoing_queue[idx].buffer, data, size)
    transport.outgoing_queue[idx].is_active = true

    transport.outgoing_count = transport.outgoing_count + 1
}

fn queue_fragmented_packet(transport: Transport, connection_id: i64, packet_type: PacketType, channel: i32, data: [i32], size: i32) {
    let fragment_size = transport.config.fragment_threshold
    let num_fragments = (size + fragment_size - 1) / fragment_size
    let fragment_id = (transport.current_time * 1000.0) as i32

    for i in 0..num_fragments {
        if transport.outgoing_count >= 256 {
            break
        }

        let offset = i * fragment_size
        let frag_len = min_i32(fragment_size, size - offset)

        let idx = transport.outgoing_count
        transport.outgoing_queue[idx].connection_id = connection_id
        transport.outgoing_queue[idx].packet_type = PacketType::Fragment
        transport.outgoing_queue[idx].channel = channel
        buffer_reset(transport.outgoing_queue[idx].buffer)

        // Write fragment header
        buffer_write_u16(transport.outgoing_queue[idx].buffer, fragment_id)
        buffer_write_u8(transport.outgoing_queue[idx].buffer, i)
        buffer_write_u8(transport.outgoing_queue[idx].buffer, num_fragments)

        // Write fragment data
        for j in 0..frag_len {
            buffer_write_u8(transport.outgoing_queue[idx].buffer, data[offset + j])
        }

        transport.outgoing_queue[idx].is_active = true
        transport.outgoing_count = transport.outgoing_count + 1
    }
}

fn send_connect_packet(transport: Transport, connection_id: i64) {
    let connect_data: [i32] = [0x43, 0x4E, 0x43, 0x54]  // "CNCT"
    queue_packet(transport, connection_id, PacketType::Connect, 0, connect_data, 4)
}

fn send_disconnect_packet(transport: Transport, connection_id: i64) {
    let disconnect_data: [i32] = [0x44, 0x43, 0x4E, 0x54]  // "DCNT"
    queue_packet(transport, connection_id, PacketType::Disconnect, 0, disconnect_data, 4)
}

fn send_keepalive(transport: Transport, connection_id: i64) {
    let keepalive_data: [i32] = [0]
    queue_packet(transport, connection_id, PacketType::Keepalive, 0, keepalive_data, 1)
}

// ============================================================================
// Receive Functions
// ============================================================================

fn receive_packet(transport: Transport, connection_id: i64, data: [i32], size: i32) {
    let connection = get_connection(transport, connection_id)
    if connection == null {
        return
    }

    connection.last_receive_time = transport.current_time
    connection.packets_received = connection.packets_received + 1
    connection.bytes_received = connection.bytes_received + size as i64

    // Parse header
    let buffer = PacketBuffer::init()
    buffer_write_bytes(buffer, data, size)
    buffer.read_pos = 0

    let packet_type_raw = buffer_read_u8(buffer)
    let packet_type = PacketType::Unreliable

    if packet_type_raw == 0 { packet_type = PacketType::Unreliable }
    else if packet_type_raw == 1 { packet_type = PacketType::Reliable }
    else if packet_type_raw == 2 { packet_type = PacketType::ReliableOrdered }
    else if packet_type_raw == 3 { packet_type = PacketType::ReliableSequenced }
    else if packet_type_raw == 4 { packet_type = PacketType::Fragment }
    else if packet_type_raw == 5 { packet_type = PacketType::Ack }
    else if packet_type_raw == 6 { packet_type = PacketType::Keepalive }
    else if packet_type_raw == 7 { packet_type = PacketType::Connect }
    else if packet_type_raw == 8 { packet_type = PacketType::Disconnect }
    else if packet_type_raw == 9 { packet_type = PacketType::ConnectAccept }
    else if packet_type_raw == 10 { packet_type = PacketType::ConnectReject }

    let flags = buffer_read_u8(buffer)
    let sequence = buffer_read_u32(buffer)
    let ack_num = buffer_read_u32(buffer)
    let ack_bits = buffer_read_u32(buffer)

    // Process acks
    process_acks(transport, connection_id, ack_num, ack_bits)

    // Update remote sequence
    if sequence > connection.remote_sequence {
        let diff = sequence - connection.remote_sequence
        if diff < 32 {
            connection.ack_bits = (connection.ack_bits << diff) | 1
        } else {
            connection.ack_bits = 1
        }
        connection.remote_sequence = sequence
    } else {
        let diff = connection.remote_sequence - sequence
        if diff < 32 {
            connection.ack_bits = connection.ack_bits | (1 << diff)
        }
    }

    // Handle packet type
    if packet_type == PacketType::Ack {
        // Already processed above
    } else if packet_type == PacketType::Keepalive {
        // Just updates last_receive_time
    } else if packet_type == PacketType::Connect {
        handle_connect(transport, connection_id)
    } else if packet_type == PacketType::ConnectAccept {
        handle_connect_accept(transport, connection_id)
    } else if packet_type == PacketType::ConnectReject {
        handle_connect_reject(transport, connection_id)
    } else if packet_type == PacketType::Disconnect {
        handle_disconnect(transport, connection_id)
    } else if packet_type == PacketType::Fragment {
        handle_fragment(transport, connection_id, buffer)
    } else {
        // Queue for application
        queue_incoming(transport, connection_id, buffer)
    }
}

fn handle_connect(transport: Transport, connection_id: i64) {
    let connection = get_connection(transport, connection_id)
    if connection != null {
        connection.state = ConnectionState::Connected
        let accept_data: [i32] = [0x41, 0x43, 0x50, 0x54]  // "ACPT"
        queue_packet(transport, connection_id, PacketType::ConnectAccept, 0, accept_data, 4)
    }
}

fn handle_connect_accept(transport: Transport, connection_id: i64) {
    let connection = get_connection(transport, connection_id)
    if connection != null {
        connection.state = ConnectionState::Connected
    }
}

fn handle_connect_reject(transport: Transport, connection_id: i64) {
    close_connection(transport, connection_id)
}

fn handle_disconnect(transport: Transport, connection_id: i64) {
    close_connection(transport, connection_id)
}

fn handle_fragment(transport: Transport, connection_id: i64, buffer: PacketBuffer) {
    let connection = get_connection(transport, connection_id)
    if connection == null {
        return
    }

    let fragment_id = buffer_read_u16(buffer)
    let fragment_index = buffer_read_u8(buffer)
    let fragment_count = buffer_read_u8(buffer)

    // Find or create assembly
    let assembly_idx = -1
    for i in 0..connection.assembly_count {
        if connection.fragment_assemblies[i].fragment_id == fragment_id {
            assembly_idx = i
            break
        }
    }

    if assembly_idx < 0 && connection.assembly_count < 8 {
        assembly_idx = connection.assembly_count
        connection.fragment_assemblies[assembly_idx] = FragmentAssembly::init(fragment_id, fragment_count)
        connection.fragment_assemblies[assembly_idx].start_time = transport.current_time
        connection.assembly_count = connection.assembly_count + 1
    }

    if assembly_idx >= 0 {
        let assembly = connection.fragment_assemblies[assembly_idx]
        let remaining_size = buffer.size - buffer.read_pos

        // Copy remaining data to fragment
        let frag_data: [i32] = []
        for i in 0..remaining_size {
            frag_data = frag_data + [buffer.data[buffer.read_pos + i]]
        }

        if add_fragment(assembly, fragment_index, frag_data, remaining_size) {
            // Assembly complete, deliver packet
            let assembled_buffer = PacketBuffer::init()
            assemble_fragments(assembly, assembled_buffer)
            queue_incoming(transport, connection_id, assembled_buffer)

            // Remove assembly (shift remaining)
            for i in assembly_idx..(connection.assembly_count - 1) {
                connection.fragment_assemblies[i] = connection.fragment_assemblies[i + 1]
            }
            connection.assembly_count = connection.assembly_count - 1
        }
    }
}

fn queue_incoming(transport: Transport, connection_id: i64, buffer: PacketBuffer) {
    if transport.incoming_count >= 256 {
        return
    }

    let idx = transport.incoming_count
    transport.incoming_queue[idx].connection_id = connection_id
    transport.incoming_queue[idx].buffer = buffer
    transport.incoming_queue[idx].receive_time = transport.current_time
    transport.incoming_queue[idx].is_active = true

    transport.incoming_count = transport.incoming_count + 1
}

fn process_acks(transport: Transport, connection_id: i64, ack_num: i32, ack_bits: i32) {
    let connection = get_connection(transport, connection_id)
    if connection == null {
        return
    }

    for i in 0..connection.pending_count {
        let pending = connection.pending_reliable[i]
        if !pending.is_active || pending.is_acked {
            continue
        }

        // Check if this packet is acked
        if pending.sequence == ack_num {
            pending.is_acked = true
            let rtt = transport.current_time - pending.send_time
            connection.round_trip_time = connection.round_trip_time * 0.875 + rtt * 0.125
        } else if ack_num > pending.sequence {
            let diff = ack_num - pending.sequence
            if diff < 32 && (ack_bits & (1 << diff)) != 0 {
                pending.is_acked = true
            }
        }
    }
}

// ============================================================================
// Update Loop
// ============================================================================

fn update_transport(transport: Transport, delta_time: f32) {
    transport.current_time = transport.current_time + delta_time

    // Process each connection
    for i in 0..transport.connection_count {
        let connection = transport.connections[i]

        // Check connection timeout
        let time_since_receive = transport.current_time - connection.last_receive_time
        if time_since_receive > transport.config.connection_timeout {
            connection.state = ConnectionState::Disconnected
            continue
        }

        // Send keepalive if needed
        let time_since_send = transport.current_time - connection.last_send_time
        if time_since_send > transport.config.keepalive_interval {
            send_keepalive(transport, connection.connection_id)
        }

        // Retry pending reliable packets
        retry_pending_packets(transport, connection)

        // Clean up old fragment assemblies
        cleanup_fragment_assemblies(transport, connection)
    }

    // Flush outgoing queue
    flush_outgoing(transport)

    // Deliver incoming packets
    deliver_incoming(transport)
}

fn retry_pending_packets(transport: Transport, connection: Connection) {
    let timeout = transport.config.reliable_timeout + connection.round_trip_time * 2.0

    for i in 0..connection.pending_count {
        let pending = connection.pending_reliable[i]
        if !pending.is_active || pending.is_acked {
            continue
        }

        let time_since_send = transport.current_time - pending.send_time
        if time_since_send > timeout {
            if pending.retry_count < transport.config.max_retries {
                // Resend packet
                pending.send_time = transport.current_time
                pending.retry_count = pending.retry_count + 1
                // Would call send_raw here
            } else {
                // Give up, mark as lost
                pending.is_active = false
                connection.packets_lost = connection.packets_lost + 1
            }
        }
    }

    // Compact pending array
    compact_pending_packets(connection)
}

fn compact_pending_packets(connection: Connection) {
    let write_idx = 0
    for read_idx in 0..connection.pending_count {
        if connection.pending_reliable[read_idx].is_active && !connection.pending_reliable[read_idx].is_acked {
            if write_idx != read_idx {
                connection.pending_reliable[write_idx] = connection.pending_reliable[read_idx]
            }
            write_idx = write_idx + 1
        }
    }
    connection.pending_count = write_idx
}

fn cleanup_fragment_assemblies(transport: Transport, connection: Connection) {
    let i = 0
    while i < connection.assembly_count {
        let age = transport.current_time - connection.fragment_assemblies[i].start_time
        if age > 10.0 {  // 10 second timeout
            for j in i..(connection.assembly_count - 1) {
                connection.fragment_assemblies[j] = connection.fragment_assemblies[j + 1]
            }
            connection.assembly_count = connection.assembly_count - 1
        } else {
            i = i + 1
        }
    }
}

fn flush_outgoing(transport: Transport) {
    for i in 0..transport.outgoing_count {
        let packet = transport.outgoing_queue[i]
        if !packet.is_active {
            continue
        }

        let connection = get_connection(transport, packet.connection_id)
        if connection == null {
            packet.is_active = false
            continue
        }

        connection.local_sequence = connection.local_sequence + 1
        connection.last_send_time = transport.current_time
        connection.packets_sent = connection.packets_sent + 1
        connection.bytes_sent = connection.bytes_sent + packet.buffer.size as i64

        // If reliable, add to pending
        if packet.packet_type == PacketType::Reliable || packet.packet_type == PacketType::ReliableOrdered {
            if connection.pending_count < 64 {
                let pending = connection.pending_reliable[connection.pending_count]
                pending.sequence = connection.local_sequence - 1
                pending.packet_type = packet.packet_type
                pending.channel = packet.channel
                for j in 0..packet.buffer.size {
                    pending.data[j] = packet.buffer.data[j]
                }
                pending.size = packet.buffer.size
                pending.send_time = transport.current_time
                pending.retry_count = 0
                pending.is_acked = false
                pending.is_active = true
                connection.pending_count = connection.pending_count + 1
            }
        }

        packet.is_active = false
    }

    transport.outgoing_count = 0
}

fn deliver_incoming(transport: Transport) {
    for i in 0..transport.incoming_count {
        let packet = transport.incoming_queue[i]
        if !packet.is_active {
            continue
        }
        // Would call on_receive callback here
        packet.is_active = false
    }

    transport.incoming_count = 0
}

// ============================================================================
// Utility Functions
// ============================================================================

fn min_i32(a: i32, b: i32): i32 {
    if a < b { return a }
    return b
}

fn float_to_bits(f: f32): i32 {
    return (f * 1000000.0) as i32
}

fn bits_to_float(bits: i32): f32 {
    return bits as f32 / 1000000.0
}

// ============================================================================
// Statistics
// ============================================================================

struct ConnectionStats {
    packets_sent: i64,
    packets_received: i64,
    packets_lost: i64,
    bytes_sent: i64,
    bytes_received: i64,
    round_trip_time: f32,
    packet_loss_percent: f32,
}

impl ConnectionStats {
    fn init(): ConnectionStats {
        return ConnectionStats {
            packets_sent: 0,
            packets_received: 0,
            packets_lost: 0,
            bytes_sent: 0,
            bytes_received: 0,
            round_trip_time: 0.0,
            packet_loss_percent: 0.0,
        }
    }
}

fn get_connection_stats(transport: Transport, connection_id: i64): ConnectionStats {
    let connection = get_connection(transport, connection_id)
    if connection == null {
        return ConnectionStats::init()
    }

    let total_packets = connection.packets_sent + connection.packets_lost
    let loss_percent = 0.0
    if total_packets > 0 {
        loss_percent = (connection.packets_lost as f32 / total_packets as f32) * 100.0
    }

    return ConnectionStats {
        packets_sent: connection.packets_sent,
        packets_received: connection.packets_received,
        packets_lost: connection.packets_lost,
        bytes_sent: connection.bytes_sent,
        bytes_received: connection.bytes_received,
        round_trip_time: connection.round_trip_time,
        packet_loss_percent: loss_percent,
    }
}

// ============================================================================
// Tests
// ============================================================================

fn test_transport() {
    print("Testing Transport Layer...")

    // Create transport
    let config = TransportConfig::init()
    let transport = Transport::init(config)
    print("  Transport created")

    // Test connection creation
    let conn_id = transport_connect(transport, "192.168.1.100", 8080)
    print("  Created connection: " + str(conn_id))

    // Test packet buffer
    let buffer = PacketBuffer::init()
    buffer_write_u8(buffer, 42)
    buffer_write_u16(buffer, 1234)
    buffer_write_u32(buffer, 0xDEADBEEF)

    buffer.read_pos = 0
    let v1 = buffer_read_u8(buffer)
    let v2 = buffer_read_u16(buffer)
    let v3 = buffer_read_u32(buffer)

    print("  Buffer read: " + str(v1) + ", " + str(v2) + ", " + str(v3))

    // Test send
    let test_data: [i32] = [1, 2, 3, 4, 5, 6, 7, 8]
    send_reliable(transport, conn_id, test_data, 8)
    print("  Queued reliable packet")

    // Update
    update_transport(transport, 0.016)
    print("  Transport updated")

    print("Transport tests complete!")
}
