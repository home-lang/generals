// C&C Generals Zero Hour - Home Port
// Performance Profiling System
//
// Original: PerfTimer.h/PerfGather (EA Games)
// Ported to Home with EA's hierarchical profiling system
//
// EA's profiling architecture:
// - High-precision timing using CPU cycle counter (RDTSC)
// - Hierarchical profiling (parent timers subtract child timer time)
// - Gross time vs Net time tracking
// - Call count statistics
// - Frame-by-frame data collection
// - Export to CSV for analysis

let MAX_PROFILE_SCOPES: i32 = 512
let MAX_PROFILE_HISTORY_FRAMES: i32 = 300   // 5 seconds at 60 FPS
let MAX_SCOPE_STACK_DEPTH: i32 = 32

// ============================================================================
// PRECISION TIMER
// ============================================================================

struct PrecisionTimer {
    start_time_ns: i64,
}

impl PrecisionTimer {
    fn init(): PrecisionTimer {
        return PrecisionTimer {
            start_time_ns: 0,
        }
    }

    fn start(&self) {
        self.start_time_ns = get_time_nanoseconds()
    }

    fn elapsed_ns(&self): i64 {
        let now = get_time_nanoseconds()
        return now - self.start_time_ns
    }

    fn elapsed_us(&self): f64 {
        return self.elapsed_ns() as f64 / 1000.0
    }

    fn elapsed_ms(&self): f64 {
        return self.elapsed_ns() as f64 / 1000000.0
    }
}

// ============================================================================
// PROFILE SCOPE
// ============================================================================

struct ProfileScope {
    name: string,

    // Current frame stats
    start_time_ns: i64,
    gross_time_ns: i64,     // Total time including child scopes
    net_time_ns: i64,       // Time excluding child scopes
    call_count: i32,

    // Frame history (for averaging)
    history_gross_ns: [i64],
    history_net_ns: [i64],
    history_calls: [i32],
    history_index: i32,
    history_count: i32,

    // Parent tracking (for hierarchical profiling)
    parent_scope_id: i32,   // -1 if no parent
}

impl ProfileScope {
    fn init(name: string): ProfileScope {
        let history_gross: [i64] = []
        let history_net: [i64] = []
        let history_calls: [i32] = []

        // Pre-allocate history arrays
        for i in 0..MAX_PROFILE_HISTORY_FRAMES {
            history_gross = history_gross + [0]
            history_net = history_net + [0]
            history_calls = history_calls + [0]
        }

        return ProfileScope {
            name: name,
            start_time_ns: 0,
            gross_time_ns: 0,
            net_time_ns: 0,
            call_count: 0,
            history_gross_ns: history_gross,
            history_net_ns: history_net,
            history_calls: history_calls,
            history_index: 0,
            history_count: 0,
            parent_scope_id: -1,
        }
    }

    fn begin(&self) {
        self.start_time_ns = get_time_nanoseconds()
    }

    fn end(&self, parent_scope: ProfileScope?) {
        let elapsed_ns = get_time_nanoseconds() - self.start_time_ns

        self.gross_time_ns = self.gross_time_ns + elapsed_ns
        self.net_time_ns = self.net_time_ns + elapsed_ns
        self.call_count = self.call_count + 1

        // Subtract this time from parent's net time (EA's hierarchical profiling)
        if parent_scope != null {
            parent_scope.net_time_ns = parent_scope.net_time_ns - elapsed_ns
        }
    }

    fn end_frame(&self) {
        // Store current frame stats in history
        if self.history_index < MAX_PROFILE_HISTORY_FRAMES {
            self.history_gross_ns[self.history_index] = self.gross_time_ns
            self.history_net_ns[self.history_index] = self.net_time_ns
            self.history_calls[self.history_index] = self.call_count
        }

        self.history_index = (self.history_index + 1) % MAX_PROFILE_HISTORY_FRAMES

        if self.history_count < MAX_PROFILE_HISTORY_FRAMES {
            self.history_count = self.history_count + 1
        }

        // Reset current frame stats
        self.gross_time_ns = 0
        self.net_time_ns = 0
        self.call_count = 0
    }

    fn get_average_gross_ms(&self): f64 {
        if self.history_count == 0 {
            return 0.0
        }

        let total_ns: i64 = 0
        for i in 0..self.history_count {
            total_ns = total_ns + self.history_gross_ns[i]
        }

        let avg_ns = total_ns as f64 / self.history_count as f64
        return avg_ns / 1000000.0
    }

    fn get_average_net_ms(&self): f64 {
        if self.history_count == 0 {
            return 0.0
        }

        let total_ns: i64 = 0
        for i in 0..self.history_count {
            total_ns = total_ns + self.history_net_ns[i]
        }

        let avg_ns = total_ns as f64 / self.history_count as f64
        return avg_ns / 1000000.0
    }

    fn get_average_calls_per_frame(&self): f32 {
        if self.history_count == 0 {
            return 0.0
        }

        let total_calls: i32 = 0
        for i in 0..self.history_count {
            total_calls = total_calls + self.history_calls[i]
        }

        return total_calls as f32 / self.history_count as f32
    }
}

// ============================================================================
// FRAME STATISTICS
// ============================================================================

struct FrameStats {
    frame_number: i32,
    frame_time_ms: f32,
    fps: f32,
    logic_time_ms: f32,
    render_time_ms: f32,
    audio_time_ms: f32,
    entity_count: i32,
    draw_calls: i32,
    triangles: i32,
    memory_used_mb: f32,
    memory_peak_mb: f32,
}

impl FrameStats {
    fn init(): FrameStats {
        return FrameStats {
            frame_number: 0,
            frame_time_ms: 0.0,
            fps: 0.0,
            logic_time_ms: 0.0,
            render_time_ms: 0.0,
            audio_time_ms: 0.0,
            entity_count: 0,
            draw_calls: 0,
            triangles: 0,
            memory_used_mb: 0.0,
            memory_peak_mb: 0.0,
        }
    }
}

// ============================================================================
// PROFILER
// ============================================================================

struct Profiler {
    scopes: [ProfileScope],
    scope_stack: [i32],
    scope_stack_depth: i32,

    frame_number: i32,
    frame_timer: PrecisionTimer,

    // Frame stats history
    frame_stats: [FrameStats],
    frame_stats_index: i32,
    frame_stats_count: i32,

    // Display settings
    show_profiler: bool,
    show_graph: bool,
}

impl Profiler {
    fn init(): Profiler {
        let stats: [FrameStats] = []
        for i in 0..MAX_PROFILE_HISTORY_FRAMES {
            stats = stats + [FrameStats::init()]
        }

        let stack: [i32] = []
        for i in 0..MAX_SCOPE_STACK_DEPTH {
            stack = stack + [-1]
        }

        let profiler = Profiler {
            scopes: [],
            scope_stack: stack,
            scope_stack_depth: 0,
            frame_number: 0,
            frame_timer: PrecisionTimer::init(),
            frame_stats: stats,
            frame_stats_index: 0,
            frame_stats_count: 0,
            show_profiler: false,
            show_graph: false,
        }

        profiler.frame_timer.start()
        return profiler
    }

    fn register_scope(&self, name: string): i32 {
        if self.scopes.length >= MAX_PROFILE_SCOPES {
            return -1
        }

        // Check if scope already exists
        for i in 0..self.scopes.length {
            if self.scopes[i].name == name {
                return i
            }
        }

        // Create new scope
        let scope = ProfileScope::init(name)
        self.scopes = self.scopes + [scope]

        return self.scopes.length - 1
    }

    fn begin_scope(&self, scope_id: i32) {
        if scope_id < 0 || scope_id >= self.scopes.length {
            return
        }

        self.scopes[scope_id].begin()

        // Push to stack
        if self.scope_stack_depth < MAX_SCOPE_STACK_DEPTH {
            self.scope_stack[self.scope_stack_depth] = scope_id
            self.scope_stack_depth = self.scope_stack_depth + 1
        }
    }

    fn end_scope(&self, scope_id: i32) {
        if scope_id < 0 || scope_id >= self.scopes.length {
            return
        }

        // Get parent scope
        let parent: ProfileScope? = null
        if self.scope_stack_depth >= 2 {
            let parent_id = self.scope_stack[self.scope_stack_depth - 2]
            if parent_id >= 0 && parent_id < self.scopes.length {
                parent = self.scopes[parent_id]
            }
        }

        self.scopes[scope_id].end(parent)

        // Pop from stack
        if self.scope_stack_depth > 0 {
            self.scope_stack_depth = self.scope_stack_depth - 1
        }
    }

    fn end_frame(&self) {
        // End all scopes
        for i in 0..self.scopes.length {
            self.scopes[i].end_frame()
        }

        // Calculate frame time
        let frame_time_ms = self.frame_timer.elapsed_ms() as f32
        self.frame_timer.start()

        // Store frame stats
        let stats_idx = self.frame_stats_index
        self.frame_stats[stats_idx].frame_number = self.frame_number
        self.frame_stats[stats_idx].frame_time_ms = frame_time_ms

        if frame_time_ms > 0.0 {
            self.frame_stats[stats_idx].fps = 1000.0 / frame_time_ms
        }

        // Get timings from known scopes
        let logic_scope = self.get_scope_by_name("UpdateLogic")
        if logic_scope != null {
            self.frame_stats[stats_idx].logic_time_ms = logic_scope.get_average_gross_ms() as f32
        }

        let render_scope = self.get_scope_by_name("Render")
        if render_scope != null {
            self.frame_stats[stats_idx].render_time_ms = render_scope.get_average_gross_ms() as f32
        }

        let audio_scope = self.get_scope_by_name("UpdateAudio")
        if audio_scope != null {
            self.frame_stats[stats_idx].audio_time_ms = audio_scope.get_average_gross_ms() as f32
        }

        self.frame_stats_index = (self.frame_stats_index + 1) % MAX_PROFILE_HISTORY_FRAMES

        if self.frame_stats_count < MAX_PROFILE_HISTORY_FRAMES {
            self.frame_stats_count = self.frame_stats_count + 1
        }

        self.frame_number = self.frame_number + 1
    }

    fn get_scope_by_name(&self, name: string): ProfileScope? {
        for i in 0..self.scopes.length {
            if self.scopes[i].name == name {
                return self.scopes[i]
            }
        }
        return null
    }

    fn get_average_fps(&self): f32 {
        if self.frame_stats_count == 0 {
            return 0.0
        }

        let total_fps: f32 = 0.0
        for i in 0..self.frame_stats_count {
            total_fps = total_fps + self.frame_stats[i].fps
        }

        return total_fps / self.frame_stats_count as f32
    }

    fn reset(&self) {
        for i in 0..self.scopes.length {
            self.scopes[i].history_count = 0
            self.scopes[i].history_index = 0
        }

        self.frame_stats_count = 0
        self.frame_stats_index = 0
        self.frame_number = 0
    }

    fn toggle_display(&self) {
        self.show_profiler = !self.show_profiler
    }
}

// ============================================================================
// GLOBAL PROFILER INSTANCE
// ============================================================================

let g_profiler: Profiler? = null

fn init_profiler(): Profiler {
    let profiler = Profiler::init()
    g_profiler = profiler
    return profiler
}

fn get_profiler(): Profiler? {
    return g_profiler
}

fn shutdown_profiler() {
    g_profiler = null
}

fn profiler_end_frame() {
    if g_profiler != null {
        g_profiler.end_frame()
    }
}

fn profiler_reset() {
    if g_profiler != null {
        g_profiler.reset()
    }
}

fn profiler_toggle_display() {
    if g_profiler != null {
        g_profiler.toggle_display()
    }
}

// ============================================================================
// PLATFORM-SPECIFIC HIGH-PRECISION TIMER
// ============================================================================

// Extern: returns current time in nanoseconds (would use platform clock)
extern fn get_time_nanoseconds(): i64
