// Unified Asset Manager
// Central system for loading and managing all game assets
// Coordinates between various loaders (BIG, W3D, DDS, TGA, INI, etc.)

// ============================================================================
// Asset Types
// ============================================================================

enum AssetType {
    Unknown,
    Archive,      // .big files
    Model,        // .w3d files
    TextureTGA,   // .tga files
    TextureDDS,   // .dds files
    Config,       // .ini files
    Localization, // .csf files
    UI,           // .wnd files
    Cursor,       // .ani/.cur files
    Video,        // .bik files
    Splash,       // .bmp files
    Strings,      // .str files
    Audio,        // .wav files
    Map,          // map files
}

enum Language {
    English,
    German,
    French,
    Spanish,
    Italian,
    Korean,
    Chinese,
    Polish,
    Brazilian,
    Russian,
    Ukrainian,
    Arabic,
    Swedish,
}

// Get language name as string
fn get_language_name(lang: Language): string {
    if lang == Language::English { return "English" }
    if lang == Language::German { return "German" }
    if lang == Language::French { return "French" }
    if lang == Language::Spanish { return "Spanish" }
    if lang == Language::Italian { return "Italian" }
    if lang == Language::Korean { return "Korean" }
    if lang == Language::Chinese { return "Chinese" }
    if lang == Language::Polish { return "Polish" }
    if lang == Language::Brazilian { return "Brazilian" }
    if lang == Language::Russian { return "Russian" }
    if lang == Language::Ukrainian { return "Ukrainian" }
    if lang == Language::Arabic { return "Arabic" }
    if lang == Language::Swedish { return "Swedish" }
    return "English"
}

