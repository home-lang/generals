// ============================================================================
// Asset Manager
// ============================================================================

struct AssetManager {
    config: AssetConfig

    // Caches for various asset types
    model_cache: ModelCache
    texture_cache: TextureCache
    config_cache: ConfigCache

    // Statistics
    models_loaded: i32
    textures_loaded: i32
    configs_loaded: i32

    // Current language
    current_language: string

    fn init(): AssetManager {
        return AssetManager {
            config: AssetConfig.init()
            model_cache: ModelCache.init(1000)
            texture_cache: TextureCache.init(2000)
            config_cache: ConfigCache.init(500)
            models_loaded: 0
            textures_loaded: 0
            configs_loaded: 0
            current_language: "English"
        }
    }

    // ========================================================================
    // Model Loading
    // ========================================================================

    fn load_model(self, name: string, data: [i32]): bool {
        if self.model_cache.has(name) {
            return true
        }

        let entry = ModelCacheEntry {
            name: name
            data: data
            loaded: true
        }

        self.model_cache.set(name, entry)
        self.models_loaded = self.models_loaded + 1

        return true
    }

    fn get_model(&self, name: string): ModelCacheEntry {
        return self.model_cache.get(name)
    }

    fn has_model(&self, name: string): bool {
        return self.model_cache.has(name)
    }

    // ========================================================================
    // Texture Loading
    // ========================================================================

    fn load_texture(self, name: string, width: i32, height: i32, data: [i32]): bool {
        if self.texture_cache.has(name) {
            return true
        }

        let entry = TextureCacheEntry {
            name: name
            width: width
            height: height
            data: data
            loaded: true
        }

        self.texture_cache.set(name, entry)
        self.textures_loaded = self.textures_loaded + 1

        return true
    }

    fn get_texture(&self, name: string): TextureCacheEntry {
        return self.texture_cache.get(name)
    }

    fn has_texture(&self, name: string): bool {
        return self.texture_cache.has(name)
    }

    // ========================================================================
    // Config Loading
    // ========================================================================

    fn load_config(self, name: string, content: string): bool {
        if self.config_cache.has(name) {
            return true
        }

        let entry = ConfigCacheEntry {
            name: name
            content: content
            loaded: true
        }

        self.config_cache.set(name, entry)
        self.configs_loaded = self.configs_loaded + 1

        return true
    }

    fn get_config(&self, name: string): ConfigCacheEntry {
        return self.config_cache.get(name)
    }

    fn has_config(&self, name: string): bool {
        return self.config_cache.has(name)
    }

    // ========================================================================
    // Update and Maintenance
    // ========================================================================

    fn update(self, delta_time: f64) {
        // Update any animated assets
        let _placeholder = delta_time
    }

    fn clear_caches(self) {
        self.model_cache.clear()
        self.texture_cache.clear()
        self.config_cache.clear()
    }

    fn get_model_count(&self): i32 {
        return self.models_loaded
    }

    fn get_texture_count(&self): i32 {
        return self.textures_loaded
    }

    fn get_config_count(&self): i32 {
        return self.configs_loaded
    }

    fn set_language(self, lang: Language) {
        self.config.set_language(lang)
        self.current_language = get_language_name(lang)
    }
}

// ============================================================================
// Global Asset Manager
// ============================================================================

var g_asset_manager: AssetManager? = null

export fn init_asset_manager() {
    g_asset_manager = AssetManager.init()
    println("AssetManager: Initialized")
}

export fn shutdown_asset_manager() {
    if g_asset_manager != null {
        g_asset_manager.?.clear_caches()
    }
    g_asset_manager = null
    println("AssetManager: Shutdown")
}

export fn get_asset_manager(): AssetManager? {
    return g_asset_manager
}

// ============================================================================
// Tests
// ============================================================================

fn test_asset_manager_init(): bool {
    let manager = AssetManager.init()
    if manager.models_loaded != 0 {
        println("Should start with 0 models")
        return false
    }
    if manager.textures_loaded != 0 {
        println("Should start with 0 textures")
        return false
    }
    return true
}

fn test_language_name(): bool {
    if get_language_name(Language::English) != "English" {
        println("English name mismatch")
        return false
    }
    if get_language_name(Language::German) != "German" {
        println("German name mismatch")
        return false
    }
    return true
}

fn run_all_tests(): bool {
    if test_asset_manager_init() == false {
        println("Asset manager init test failed")
        return false
    }
    if test_language_name() == false {
        println("Language name test failed")
        return false
    }
    return true
}
