// ============================================================================
// Asset Cache Entry
// ============================================================================

// Cache entry for models
struct ModelCacheEntry {
    name: string
    data: [i32]
    loaded: bool

    fn empty(): ModelCacheEntry {
        return ModelCacheEntry {
            name: ""
            data: []
            loaded: false
        }
    }
}

// Cache entry for textures
struct TextureCacheEntry {
    name: string
    width: i32
    height: i32
    data: [i32]
    loaded: bool

    fn empty(): TextureCacheEntry {
        return TextureCacheEntry {
            name: ""
            width: 0
            height: 0
            data: []
            loaded: false
        }
    }
}

// Cache entry for config files
struct ConfigCacheEntry {
    name: string
    content: string
    loaded: bool

    fn empty(): ConfigCacheEntry {
        return ConfigCacheEntry {
            name: ""
            content: ""
            loaded: false
        }
    }
}

// ============================================================================
// Asset Paths Configuration
// ============================================================================

struct AssetPaths {
    root: string
    data: string
    ini: string
    video: string
    cursors: string
    maps: string
    audio: string

    fn default(): AssetPaths {
        return AssetPaths {
            root: "."
            data: "./Data"
            ini: "./Data/INI"
            video: "./Data/Movies"
            cursors: "./Data/Cursors"
            maps: "./Data/Maps"
            audio: "./Data/Audio"
        }
    }
}

struct AssetConfig {
    paths: AssetPaths
    language: Language

    fn init(): AssetConfig {
        return AssetConfig {
            paths: AssetPaths.default()
            language: Language::English
        }
    }

    fn set_language(self, lang: Language) {
        self.language = lang
    }

    fn get_csf_path(&self): string {
        // Return path based on language
        return self.paths.data + "/English/generals.csf"
    }
}

// ============================================================================
// Simple Cache (without generics)
// ============================================================================

struct ModelCache {
    entries: [ModelCacheEntry]
    names: [string]
    count: i32
    max_size: i32

    fn init(max_size: i32): ModelCache {
        let entries: [ModelCacheEntry] = []
        let names: [string] = []
        for i in 0..max_size {
            entries = entries + [ModelCacheEntry.empty()]
            names = names + [""]
        }

        return ModelCache {
            entries: entries
            names: names
            count: 0
            max_size: max_size
        }
    }

    fn has(&self, name: string): bool {
        for i in 0..self.count {
            if self.names[i] == name {
                return true
            }
        }
        return false
    }

    fn get(&self, name: string): ModelCacheEntry {
        for i in 0..self.count {
            if self.names[i] == name {
                return self.entries[i]
            }
        }
        return ModelCacheEntry.empty()
    }

    fn set(self, name: string, entry: ModelCacheEntry) {
        // Check if already exists
        for i in 0..self.count {
            if self.names[i] == name {
                self.entries[i] = entry
                return
            }
        }

        // Add new if space available
        if self.count < self.max_size {
            self.names[self.count] = name
            self.entries[self.count] = entry
            self.count = self.count + 1
        }
    }

    fn clear(self) {
        for i in 0..self.count {
            self.names[i] = ""
            self.entries[i] = ModelCacheEntry.empty()
        }
        self.count = 0
    }
}

