// ============================================================================
// CONTROL REBINDING
// ============================================================================

struct KeyBinding {
    action: string,
    primary_key: i32,
    secondary_key: i32,
    modifiers: i32,            // Shift, Ctrl, Alt flags
}

impl KeyBinding {
    fn init(): KeyBinding {
        return KeyBinding {
            action: "",
            primary_key: 0,
            secondary_key: 0,
            modifiers: 0,
        }
    }
}

fn get_key_name(key_code: i32): string {
    if key_code == 27 {
        return "Escape"
    } else if key_code == 32 {
        return "Space"
    } else if key_code == 13 {
        return "Enter"
    } else if key_code == 8 {
        return "Backspace"
    } else if key_code == 9 {
        return "Tab"
    } else if key_code >= 48 and key_code <= 57 {
        return "0-9"
    } else if key_code >= 65 and key_code <= 90 {
        return "A-Z"
    } else if key_code >= 112 and key_code <= 123 {
        return "F1-F12"
    }
    return "Unknown"
}

// ============================================================================
// WIDESCREEN SUPPORT
// ============================================================================

struct AspectRatio {
    width: i32,
    height: i32,
    ratio: f32,
    name: string,
}

impl AspectRatio {
    fn init(): AspectRatio {
        return AspectRatio {
            width: 16,
            height: 9,
            ratio: 1.778,
            name: "16:9",
        }
    }
}

fn get_common_aspects(): [AspectRatio] {
    return [
        AspectRatio { width: 4, height: 3, ratio: 1.333, name: "4:3" },
        AspectRatio { width: 16, height: 9, ratio: 1.778, name: "16:9" },
        AspectRatio { width: 16, height: 10, ratio: 1.6, name: "16:10" },
        AspectRatio { width: 21, height: 9, ratio: 2.333, name: "21:9" },
        AspectRatio { width: 32, height: 9, ratio: 3.556, name: "32:9" },
        AspectRatio { width: 5, height: 4, ratio: 1.25, name: "5:4" },
    ]
}

fn calculate_fov_for_aspect(base_fov: f32, base_aspect: f32, target_aspect: f32): f32 {
    // Hor+ FOV scaling
    if target_aspect > base_aspect {
        let scale = target_aspect / base_aspect
        return atan(tan(base_fov * 0.5 * 0.0174533) * scale) * 2.0 * 57.2958
    }
    return base_fov
}

fn get_ui_safe_area(screen_width: i32, screen_height: i32, aspect: f32): [i32] {
    // For ultrawide, keep UI in center 16:9 portion
    if aspect > 2.0 {
        let safe_width = cast(i32, cast(f32, screen_height) * 1.778)
        let margin = (screen_width - safe_width) / 2
        return [margin, 0, safe_width, screen_height]
    }
    return [0, 0, screen_width, screen_height]
}

// ============================================================================
// HIDPI SUPPORT
// ============================================================================

struct DisplayInfo {
    width: i32,
    height: i32,
    scale_factor: f32,       // 1.0 for standard, 2.0 for Retina
    refresh_rate: i32,
    is_primary: bool,
}

impl DisplayInfo {
    fn init(): DisplayInfo {
        return DisplayInfo {
            width: 1920,
            height: 1080,
            scale_factor: 1.0,
            refresh_rate: 60,
            is_primary: true,
        }
    }
}

fn get_scaled_resolution(width: i32, height: i32, scale: f32): [i32] {
    return [cast(i32, cast(f32, width) * scale), cast(i32, cast(f32, height) * scale)]
}

fn scale_ui_element(base_size: i32, scale_factor: f32): i32 {
    return cast(i32, cast(f32, base_size) * scale_factor)
}

// ============================================================================
// MATH HELPERS
// ============================================================================

fn look_at(eye: Vec3, target: Vec3, up: Vec3): Mat4 {
    let zx = eye.x - target.x
    let zy = eye.y - target.y
    let zz = eye.z - target.z
    let z_len = sqrt(zx*zx + zy*zy + zz*zz)
    zx = zx / z_len
    zy = zy / z_len
    zz = zz / z_len

    let xx = up.y * zz - up.z * zy
    let xy = up.z * zx - up.x * zz
    let xz = up.x * zy - up.y * zx
    let x_len = sqrt(xx*xx + xy*xy + xz*xz)
    xx = xx / x_len
    xy = xy / x_len
    xz = xz / x_len

    let yx = zy * xz - zz * xy
    let yy = zz * xx - zx * xz
    let yz = zx * xy - zy * xx

    return Mat4 {
        m: [xx, yx, zx, 0.0,
            xy, yy, zy, 0.0,
            xz, yz, zz, 0.0,
            -(xx*eye.x + xy*eye.y + xz*eye.z),
            -(yx*eye.x + yy*eye.y + yz*eye.z),
            -(zx*eye.x + zy*eye.y + zz*eye.z),
            1.0],
    }
}

fn perspective(fov_deg: f32, aspect: f32, near: f32, far: f32): Mat4 {
    let f = 1.0 / tan(fov_deg * 0.5 * 0.0174533)
    let nf = 1.0 / (near - far)

    return Mat4 {
        m: [f / aspect, 0.0, 0.0, 0.0,
            0.0, f, 0.0, 0.0,
            0.0, 0.0, (far + near) * nf, -1.0,
            0.0, 0.0, 2.0 * far * near * nf, 0.0],
    }
}

fn sqrt(x: f32): f32 {
    if x <= 0.0 {
        return 0.0
    }
    let guess = x / 2.0
    for i in 0..10 {
        guess = (guess + x / guess) / 2.0
    }
    return guess
}

fn tan(x: f32): f32 {
    return sin(x) / cos(x)
}

fn atan(x: f32): f32 {
    // Approximation
    return x - x*x*x/3.0 + x*x*x*x*x/5.0
}

fn sin(x: f32): f32 {
    let x_norm = x
    while x_norm > 3.14159 {
        x_norm = x_norm - 6.28318
    }
    while x_norm < -3.14159 {
        x_norm = x_norm + 6.28318
    }
    let x2 = x_norm * x_norm
    let x3 = x2 * x_norm
    let x5 = x3 * x2
    let x7 = x5 * x2
    return x_norm - x3/6.0 + x5/120.0 - x7/5040.0
}

fn cos(x: f32): f32 {
    return sin(x + 1.5708)
}

// ============================================================================
// GLOBAL RENDERING SYSTEM INSTANCE
// ============================================================================

let g_texture_manager: TextureManager? = null
let g_renderer: W3DRenderer? = null
let g_game_settings: GameSettings? = null

fn init_rendering_system(max_cache_mb: i32): bool {
    g_texture_manager = TextureManager::init(max_cache_mb)
    g_renderer = W3DRenderer::init()
    g_game_settings = GameSettings::init()
    return true
}

fn get_texture_manager(): TextureManager? {
    return g_texture_manager
}

fn get_renderer(): W3DRenderer? {
    return g_renderer
}

fn get_game_settings(): GameSettings? {
    return g_game_settings
}

fn shutdown_rendering_system() {
    g_texture_manager = null
    g_renderer = null
    g_game_settings = null
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

fn test_rendering_system() {
    print("Testing Rendering System...")

    // Test texture manager
    let tm = TextureManager::init(256)
    print("Texture manager created, max cache: " + str(tm.max_cache_size / 1024 / 1024) + " MB")

    // Test mipmap generation
    let mip_count = get_mipmap_count(512, 512)
    print("Mipmaps for 512x512: " + str(mip_count))

    // Test texture atlas
    let atlas = TextureAtlas::init(2048, 2048)
    let rect1 = atlas.pack("button1", 1, 128, 64)
    let rect2 = atlas.pack("button2", 2, 128, 64)
    let rect3 = atlas.pack("icon1", 3, 64, 64)
    print("Atlas packed " + str(atlas.rect_count) + " textures")

    let uv = atlas.get_uv(rect1)
    print("UV for rect1: " + str(uv[0]) + "," + str(uv[1]) + " to " + str(uv[2]) + "," + str(uv[3]))

    // Test W3D renderer
    let renderer = W3DRenderer::init()
    renderer.begin_frame()

    renderer.set_camera(
        Vec3 { x: 100.0, y: 50.0, z: 100.0 },
        Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        Vec3 { x: 0.0, y: 1.0, z: 0.0 },
        60.0, 1.778, 0.1, 1000.0)

    // Queue some meshes
    renderer.queue_mesh(1, 1, Mat4::identity(), Vec4 { x: 1.0, y: 1.0, z: 1.0, w: 1.0 })
    renderer.queue_mesh(1, 1, Mat4::identity(), Vec4 { x: 1.0, y: 1.0, z: 1.0, w: 1.0 })
    renderer.queue_mesh(2, 2, Mat4::identity(), Vec4 { x: 1.0, y: 1.0, z: 1.0, w: 0.5 })

    print("Batches: " + str(renderer.batch_count) + ", Instances: " + str(renderer.instance_count))

    renderer.end_frame()
    print("Draw calls: " + str(renderer.draw_calls))

    // Test frustum culling
    let vp = Mat4::identity()
    let frustum = extract_frustum(vp)

    let sphere1 = BoundingSphere { center: Vec3 { x: 0.0, y: 0.0, z: 0.0 }, radius: 10.0 }
    let in_frustum = sphere_in_frustum(frustum, sphere1)
    print("Sphere in frustum: " + str(in_frustum))

    // Test LOD
    let lod_group = LODGroup::init()
    lod_group.add_level(1, 100.0, 5000)
    lod_group.add_level(2, 200.0, 1000)
    lod_group.add_level(3, 500.0, 200)
    print("LOD levels: " + str(lod_group.level_count))

    let selected_lod = lod_group.select(
        Vec3 { x: 0.0, y: 50.0, z: 150.0 },
        Vec3 { x: 0.0, y: 0.0, z: 0.0 })
    print("Selected LOD at 150m: mesh " + str(selected_lod))

    // Test settings
    let settings = GameSettings::init()
    print("Default resolution: " + str(settings.graphics.resolution_width) + "x" + str(settings.graphics.resolution_height))
    print("Default master volume: " + str(settings.audio.master_volume))

    // Test aspect ratios
    let aspects = get_common_aspects()
    print("Supported aspect ratios: " + str(aspects.length))

    let ultrawide_fov = calculate_fov_for_aspect(90.0, 1.778, 2.333)
    print("21:9 adjusted FOV: " + str(ultrawide_fov))

    let safe_area = get_ui_safe_area(3440, 1440, 2.389)
    print("UI safe area for 3440x1440: " + str(safe_area[0]) + "," + str(safe_area[1]) + " " + str(safe_area[2]) + "x" + str(safe_area[3]))

    // Test HiDPI
    let scaled = get_scaled_resolution(1920, 1080, 2.0)
    print("Retina resolution: " + str(scaled[0]) + "x" + str(scaled[1]))

    let ui_size = scale_ui_element(32, 2.0)
    print("Scaled UI element: " + str(ui_size) + "px")

    print("Rendering System tests complete!")
}
