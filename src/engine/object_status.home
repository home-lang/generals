// C&C Generals Zero Hour - Home Port
// Object Status Types
//
// Original: ObjectStatusTypes.h / ObjectStatusTypes.cpp (EA)
// Stackable status flags for game objects using bitset system.
//
// @unify xezon 23/11/2025 (#1894) - Merge ObjectStatusTypes code

// ============================================================================
// Object Status Types
// These are saved. Do not insert or remove any!
// ============================================================================

enum ObjectStatus {
    None = 0                    // No status bit
    Destroyed                   // Has been destroyed, pending delete
    CanAttack                   // Used by garrisoned buildings, OR'ed with KINDOF_CAN_ATTACK
    UnderConstruction           // Object is being constructed
    Unselectable                // Negative condition - presence forces condition
    NoCollisions                // Ignored for object-object collisions (not ground)
    NoAttack                    // Absolute override to being able to attack
    AirborneTarget              // InTheAir for AntiAir weapons only
    Parachuting                 // Object is on a parachute
    Repulsor                    // Object repulses CAN_BE_REPULSED objects
    Hijacked                    // Unit is possessed by enemy (car thief, etc.)
    Aflame                      // Object is on fire
    Burned                      // Object has already burned as much as it can
    Wet                         // Object has been soaked with water
    IsFiringWeapon              // Object is firing a weapon now
    Braking                     // Object is braking, subverts physics
    Stealthed                   // Object is currently stealthed
    Detected                    // In range of stealth-detector (meaningless without STEALTHED)
    CanStealth                  // Object has ability to stealth
    Sold                        // Object is being sold
    UndergoingRepair            // Object awaiting/undergoing repair
    Reconstructing              // Reconstructing
    Masked                      // Not selectable/targetable by players or AI
    IsAttacking                 // In general Attack state (incl. aim, approach)
    IsUsingAbility              // Preparing or firing special ability
    IsAimingWeapon              // Aiming a weapon now
    NoAttackFromAI              // May not be attacked from CMD_FROM_AI
    IgnoringStealth             // Temporarily ignoring all stealth bits
    IsCarbomb                   // Object is now a carbomb

    // Zero Hour additions
    DeckHeightOffset            // Factors deck height on top of ground altitude
    Rider1                      // Rider status flags (for transport passengers)
    Rider2
    Rider3
    Rider4
    Rider5
    Rider6
    Rider7
    Rider8
    FaerieFire                  // Anyone shooting at you shoots faster
    MissileKillingSelf          // Missile/bomb busting through bunker
    ReassignParking             // Jet trying to get better parking assignment
    BoobyTrapped                // Has a booby trap to detonate
    Immobile                    // Do not move!
    Disguised                   // Object is disguised (type of stealth)
    Deployed                    // Object is deployed

    Count                       // Total number of status types
}

// ============================================================================
// Object Status Mask - Bitset for multiple status flags
// ============================================================================

const STATUS_MASK_SIZE: i32 = 64  // Enough bits for all status types

struct ObjectStatusMask {
    bits: u64
}

impl ObjectStatusMask {
    fn init(): ObjectStatusMask {
        return ObjectStatusMask { bits: 0 }
    }

    fn from_status(status: ObjectStatus): ObjectStatusMask {
        let mask = ObjectStatusMask { bits: 0 }
        mask.bits = 1 << (status as u64)
        return mask
    }

    // Set a single status
    fn set(mut self, status: ObjectStatus) {
        self.bits = self.bits | (1 << (status as u64))
    }

    // Clear a single status
    fn clear_status(mut self, status: ObjectStatus) {
        self.bits = self.bits & ~(1 << (status as u64))
    }

    // Test if a single status is set
    fn test(self, status: ObjectStatus): bool {
        return (self.bits & (1 << (status as u64))) != 0
    }

    // Clear all bits
    fn clear(mut self) {
        self.bits = 0
    }

    // Flip all bits
    fn flip(mut self) {
        self.bits = ~self.bits
    }

    // Check if any bits are set
    fn any(self): bool {
        return self.bits != 0
    }

    // Check if no bits are set
    fn none(self): bool {
        return self.bits == 0
    }

    // Test if any bit in mask is set
    fn any_intersection_with(self, other: ObjectStatusMask): bool {
        return (self.bits & other.bits) != 0
    }

    // Test if all specified bits are set and cleared
    fn test_set_and_clear(self, must_be_set: ObjectStatusMask, must_be_clear: ObjectStatusMask): bool {
        // All must_be_set bits must be set
        if (self.bits & must_be_set.bits) != must_be_set.bits {
            return false
        }
        // All must_be_clear bits must be clear
        if (self.bits & must_be_clear.bits) != 0 {
            return false
        }
        return true
    }

    // Combine with another mask (OR)
    fn combine(self, other: ObjectStatusMask): ObjectStatusMask {
        return ObjectStatusMask { bits: self.bits | other.bits }
    }

    // Intersect with another mask (AND)
    fn intersect(self, other: ObjectStatusMask): ObjectStatusMask {
        return ObjectStatusMask { bits: self.bits & other.bits }
    }
}

// ============================================================================
// Global Constants
// ============================================================================

let OBJECT_STATUS_MASK_NONE: ObjectStatusMask = ObjectStatusMask { bits: 0 }

// ============================================================================
// Helper Functions (match original macros)
// ============================================================================

fn make_object_status_mask(status: ObjectStatus): ObjectStatusMask {
    return ObjectStatusMask.from_status(status)
}

fn make_object_status_mask2(s1: ObjectStatus, s2: ObjectStatus): ObjectStatusMask {
    var mask = ObjectStatusMask.init()
    mask.set(s1)
    mask.set(s2)
    return mask
}

fn make_object_status_mask3(s1: ObjectStatus, s2: ObjectStatus, s3: ObjectStatus): ObjectStatusMask {
    var mask = ObjectStatusMask.init()
    mask.set(s1)
    mask.set(s2)
    mask.set(s3)
    return mask
}

fn make_object_status_mask4(s1: ObjectStatus, s2: ObjectStatus, s3: ObjectStatus, s4: ObjectStatus): ObjectStatusMask {
    var mask = ObjectStatusMask.init()
    mask.set(s1)
    mask.set(s2)
    mask.set(s3)
    mask.set(s4)
    return mask
}

fn make_object_status_mask5(s1: ObjectStatus, s2: ObjectStatus, s3: ObjectStatus, s4: ObjectStatus, s5: ObjectStatus): ObjectStatusMask {
    var mask = ObjectStatusMask.init()
    mask.set(s1)
    mask.set(s2)
    mask.set(s3)
    mask.set(s4)
    mask.set(s5)
    return mask
}

fn test_object_status_mask(mask: ObjectStatusMask, status: ObjectStatus): bool {
    return mask.test(status)
}

fn test_object_status_mask_any(mask: ObjectStatusMask, test_mask: ObjectStatusMask): bool {
    return mask.any_intersection_with(test_mask)
}

fn test_object_status_mask_multi(mask: ObjectStatusMask, must_be_set: ObjectStatusMask, must_be_clear: ObjectStatusMask): bool {
    return mask.test_set_and_clear(must_be_set, must_be_clear)
}

fn object_status_mask_any_set(mask: ObjectStatusMask): bool {
    return mask.any()
}

fn clear_object_status_mask(mask: &mut ObjectStatusMask) {
    mask.clear()
}

fn set_all_object_status_mask_bits(mask: &mut ObjectStatusMask) {
    mask.clear()
    mask.flip()
}

fn flip_object_status_mask(mask: &mut ObjectStatusMask) {
    mask.flip()
}

// ============================================================================
// Status Name Lookup (for debugging/serialization)
// ============================================================================

fn get_object_status_name(status: ObjectStatus): string {
    match status {
        ObjectStatus.None => "NONE"
        ObjectStatus.Destroyed => "DESTROYED"
        ObjectStatus.CanAttack => "CAN_ATTACK"
        ObjectStatus.UnderConstruction => "UNDER_CONSTRUCTION"
        ObjectStatus.Unselectable => "UNSELECTABLE"
        ObjectStatus.NoCollisions => "NO_COLLISIONS"
        ObjectStatus.NoAttack => "NO_ATTACK"
        ObjectStatus.AirborneTarget => "AIRBORNE_TARGET"
        ObjectStatus.Parachuting => "PARACHUTING"
        ObjectStatus.Repulsor => "REPULSOR"
        ObjectStatus.Hijacked => "HIJACKED"
        ObjectStatus.Aflame => "AFLAME"
        ObjectStatus.Burned => "BURNED"
        ObjectStatus.Wet => "WET"
        ObjectStatus.IsFiringWeapon => "IS_FIRING_WEAPON"
        ObjectStatus.Braking => "BRAKING"
        ObjectStatus.Stealthed => "STEALTHED"
        ObjectStatus.Detected => "DETECTED"
        ObjectStatus.CanStealth => "CAN_STEALTH"
        ObjectStatus.Sold => "SOLD"
        ObjectStatus.UndergoingRepair => "UNDERGOING_REPAIR"
        ObjectStatus.Reconstructing => "RECONSTRUCTING"
        ObjectStatus.Masked => "MASKED"
        ObjectStatus.IsAttacking => "IS_ATTACKING"
        ObjectStatus.IsUsingAbility => "IS_USING_ABILITY"
        ObjectStatus.IsAimingWeapon => "IS_AIMING_WEAPON"
        ObjectStatus.NoAttackFromAI => "NO_ATTACK_FROM_AI"
        ObjectStatus.IgnoringStealth => "IGNORING_STEALTH"
        ObjectStatus.IsCarbomb => "IS_CARBOMB"
        ObjectStatus.DeckHeightOffset => "DECK_HEIGHT_OFFSET"
        ObjectStatus.Rider1 => "RIDER1"
        ObjectStatus.Rider2 => "RIDER2"
        ObjectStatus.Rider3 => "RIDER3"
        ObjectStatus.Rider4 => "RIDER4"
        ObjectStatus.Rider5 => "RIDER5"
        ObjectStatus.Rider6 => "RIDER6"
        ObjectStatus.Rider7 => "RIDER7"
        ObjectStatus.Rider8 => "RIDER8"
        ObjectStatus.FaerieFire => "FAERIE_FIRE"
        ObjectStatus.MissileKillingSelf => "MISSILE_KILLING_SELF"
        ObjectStatus.ReassignParking => "REASSIGN_PARKING"
        ObjectStatus.BoobyTrapped => "BOOBY_TRAPPED"
        ObjectStatus.Immobile => "IMMOBILE"
        ObjectStatus.Disguised => "DISGUISED"
        ObjectStatus.Deployed => "DEPLOYED"
        _ => "UNKNOWN"
    }
}

// ============================================================================
// Common Masks
// ============================================================================

// Objects that cannot be attacked
fn get_no_attack_mask(): ObjectStatusMask {
    return make_object_status_mask3(
        ObjectStatus.Destroyed,
        ObjectStatus.Masked,
        ObjectStatus.UnderConstruction
    )
}

// Objects that are invisible (stealthed and not detected)
fn get_invisible_mask(): ObjectStatusMask {
    return make_object_status_mask(ObjectStatus.Stealthed)
}

// Objects that are targetable
fn is_targetable(mask: ObjectStatusMask): bool {
    if mask.test(ObjectStatus.Destroyed) { return false }
    if mask.test(ObjectStatus.Masked) { return false }
    if mask.test(ObjectStatus.Unselectable) { return false }
    return true
}

// Objects that can be selected by player
fn is_selectable(mask: ObjectStatusMask): bool {
    if mask.test(ObjectStatus.Destroyed) { return false }
    if mask.test(ObjectStatus.Masked) { return false }
    if mask.test(ObjectStatus.Unselectable) { return false }
    if mask.test(ObjectStatus.UnderConstruction) { return false }
    return true
}

// Check if object is effectively invisible to enemy
fn is_invisible_to_enemy(mask: ObjectStatusMask): bool {
    if mask.test(ObjectStatus.Stealthed) && !mask.test(ObjectStatus.Detected) {
        return true
    }
    if mask.test(ObjectStatus.Disguised) {
        return true
    }
    return false
}
