// Map System - Complete parsing, terrain, water, props, fog of war, and minimap
// Implements C&C Generals Zero Hour map handling

// ============================================================================
// VECTOR TYPES
// ============================================================================

struct Vec2 {
    x: f32,
    y: f32,
}

impl Vec2 {
    fn init(): Vec2 {
        return Vec2 { x: 0.0, y: 0.0 }
    }

    fn new(x: f32, y: f32): Vec2 {
        return Vec2 { x: x, y: y }
    }
}

struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(): Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }

    fn new(x: f32, y: f32, z: f32): Vec3 {
        return Vec3 { x: x, y: y, z: z }
    }
}

struct Color {
    r: i32,
    g: i32,
    b: i32,
    a: i32,
}

impl Color {
    fn init(): Color {
        return Color { r: 255, g: 255, b: 255, a: 255 }
    }

    fn rgba(r: i32, g: i32, b: i32, a: i32): Color {
        return Color { r: r, g: g, b: b, a: a }
    }
}

// ============================================================================
// MAP FILE FORMAT
// ============================================================================

struct MapHeader {
    magic: i32,
    version: i32,
    width: i32,
    height: i32,
    border_size: i32,
    num_players: i32,
    starting_camera_x: f32,
    starting_camera_y: f32,
    starting_camera_z: f32,
}

let MAP_MAGIC: i32 = 0x204D4150   // "MAP "
let MAP_VERSION: i32 = 5

// ============================================================================
// TERRAIN SYSTEM
// ============================================================================

enum TerrainType {
    GRASS,
    DIRT,
    SAND,
    ROCK,
    SNOW,
    WATER,
    CONCRETE,
    ASPHALT,
    MUD,
    CLIFF,
    IMPASSABLE,
}

struct TerrainCell {
    terrain_type: TerrainType,
    height: f32,
    texture_index: i32,
    blend_texture: i32,
    blend_amount: f32,
    passability: i32,
    is_buildable: bool,
    is_visible: bool,
    is_explored: bool,
}

impl TerrainCell {
    fn init(): TerrainCell {
        return TerrainCell {
            terrain_type: TerrainType::GRASS,
            height: 0.0,
            texture_index: 0,
            blend_texture: 0,
            blend_amount: 0.0,
            passability: 0xFF,
            is_buildable: true,
            is_visible: false,
            is_explored: false,
        }
    }
}

let MAX_HEIGHTMAP_SIZE: i32 = 65536  // 256x256

struct HeightMap {
    width: i32,
    height: i32,
    cell_size: f32,
    heights: [f32],
    min_height: f32,
    max_height: f32,
}

impl HeightMap {
    fn init(width: i32, height: i32, cell_size: f32): HeightMap {
        let heights: [f32] = []
        let total = width * height
        if total > MAX_HEIGHTMAP_SIZE {
            total = MAX_HEIGHTMAP_SIZE
        }
        for i in 0..total {
            heights = heights + [0.0]
        }

        return HeightMap {
            width: width,
            height: height,
            cell_size: cell_size,
            heights: heights,
            min_height: 0.0,
            max_height: 0.0,
        }
    }

    fn get_height_at(&self, x: f32, z: f32): f32 {
        let cx = cast(i32, x / self.cell_size)
        let cz = cast(i32, z / self.cell_size)

        if cx < 0 || cx >= self.width || cz < 0 || cz >= self.height {
            return 0.0
        }

        let idx = cz * self.width + cx
        if idx >= self.heights.length {
            return 0.0
        }

        // Bilinear interpolation
        let fx = (x / self.cell_size) - cast(f32, cx)
        let fz = (z / self.cell_size) - cast(f32, cz)

        let h00 = self.heights[idx]
        let h10 = h00
        if cx + 1 < self.width {
            h10 = self.heights[idx + 1]
        }
        let h01 = h00
        if cz + 1 < self.height {
            h01 = self.heights[idx + self.width]
        }
        let h11 = h00
        if cx + 1 < self.width && cz + 1 < self.height {
            h11 = self.heights[idx + self.width + 1]
        }

        let h0 = h00 * (1.0 - fx) + h10 * fx
        let h1 = h01 * (1.0 - fx) + h11 * fx

        return h0 * (1.0 - fz) + h1 * fz
    }

    fn get_normal_at(&self, x: f32, z: f32): Vec3 {
        let delta = self.cell_size * 0.5

        let hL = self.get_height_at(x - delta, z)
        let hR = self.get_height_at(x + delta, z)
        let hD = self.get_height_at(x, z - delta)
        let hU = self.get_height_at(x, z + delta)

        let nx = hL - hR
        let ny = 2.0 * delta
        let nz = hD - hU

        // Normalize
        let len = sqrt(nx*nx + ny*ny + nz*nz)
        if len > 0.001 {
            return Vec3::new(nx/len, ny/len, nz/len)
        }
        return Vec3::new(0.0, 1.0, 0.0)
    }
}

// ============================================================================
// WATER SYSTEM
// ============================================================================

enum WaterType {
    NONE,
    SHALLOW,
    DEEP,
    RIVER,
    OCEAN,
}

struct WaterPlane {
    id: i32,
    water_type: WaterType,
    min_x: f32,
    min_z: f32,
    max_x: f32,
    max_z: f32,
    height: f32,
    color: Color,
    opacity: f32,
    wave_amplitude: f32,
    wave_frequency: f32,
    flow_direction: Vec2,
    flow_speed: f32,
}

impl WaterPlane {
    fn init(): WaterPlane {
        return WaterPlane {
            id: 0,
            water_type: WaterType::NONE,
            min_x: 0.0,
            min_z: 0.0,
            max_x: 0.0,
            max_z: 0.0,
            height: 0.0,
            color: Color::init(),
            opacity: 1.0,
            wave_amplitude: 0.5,
            wave_frequency: 0.1,
            flow_direction: Vec2::init(),
            flow_speed: 0.0,
        }
    }
}

let MAX_WATER_PLANES: i32 = 16

struct WaterSystem {
    planes: [WaterPlane],
    plane_count: i32,
    global_time: f32,
    reflection_enabled: bool,
    refraction_enabled: bool,
}

impl WaterSystem {
    fn init(): WaterSystem {
        return WaterSystem {
            planes: [],
            plane_count: 0,
            global_time: 0.0,
            reflection_enabled: true,
            refraction_enabled: true,
        }
    }

    fn add_plane(&self, plane: WaterPlane): i32 {
        if self.plane_count < MAX_WATER_PLANES {
            let new_plane = plane
            new_plane.id = self.plane_count
            self.planes = self.planes + [new_plane]
            self.plane_count = self.plane_count + 1
            return new_plane.id
        }
        return -1
    }

    fn get_height_at(&self, x: f32, z: f32, time: f32): f32 {
        for i in 0..self.plane_count {
            let plane = self.planes[i]
            if x >= plane.min_x && x <= plane.max_x && z >= plane.min_z && z <= plane.max_z {
                let wave = sin(x * plane.wave_frequency + time) * cos(z * plane.wave_frequency * 0.7 + time * 1.3) * plane.wave_amplitude
                return plane.height + wave
            }
        }
        return -9999.0
    }

    fn is_in_water(&self, x: f32, z: f32, ground_height: f32): WaterType {
        for i in 0..self.plane_count {
            let plane = self.planes[i]
            if x >= plane.min_x && x <= plane.max_x && z >= plane.min_z && z <= plane.max_z {
                if ground_height < plane.height {
                    return plane.water_type
                }
            }
        }
        return WaterType::NONE
    }

    fn update(&self, delta_time: f32) {
        self.global_time = self.global_time + delta_time
    }
}

// ============================================================================
// PROP/OBJECT SYSTEM
// ============================================================================

enum PropType {
    TREE,
    ROCK,
    BUILDING_PROP,
    FENCE,
    SIGN,
    VEHICLE_PROP,
    RUBBLE,
    MISC,
}

struct MapProp {
    id: i32,
    prop_type: PropType,
    model_name: string,
    position: Vec3,
    rotation: Vec3,
    scale: Vec3,
    is_destructible: bool,
    health: i32,
    provides_cover: bool,
    blocks_movement: bool,
    collision_radius: f32,
}

impl MapProp {
    fn init(): MapProp {
        return MapProp {
            id: 0,
            prop_type: PropType::MISC,
            model_name: "",
            position: Vec3::init(),
            rotation: Vec3::init(),
            scale: Vec3::new(1.0, 1.0, 1.0),
            is_destructible: false,
            health: 100,
            provides_cover: false,
            blocks_movement: false,
            collision_radius: 1.0,
        }
    }

    fn tree(position: Vec3, model: string): MapProp {
        return MapProp {
            id: 0,
            prop_type: PropType::TREE,
            model_name: model,
            position: position,
            rotation: Vec3::new(0.0, random_float() * 360.0, 0.0),
            scale: Vec3::new(1.0, 1.0, 1.0),
            is_destructible: true,
            health: 100,
            provides_cover: true,
            blocks_movement: false,
            collision_radius: 2.0,
        }
    }

    fn rock(position: Vec3, model: string, size: f32): MapProp {
        return MapProp {
            id: 0,
            prop_type: PropType::ROCK,
            model_name: model,
            position: position,
            rotation: Vec3::new(0.0, random_float() * 360.0, 0.0),
            scale: Vec3::new(size, size, size),
            is_destructible: false,
            health: 9999,
            provides_cover: true,
            blocks_movement: true,
            collision_radius: 3.0 * size,
        }
    }
}

let MAX_PROPS: i32 = 1024

struct PropManager {
    props: [MapProp],
    prop_count: i32,
    next_id: i32,
}

impl PropManager {
    fn init(): PropManager {
        return PropManager {
            props: [],
            prop_count: 0,
            next_id: 1,
        }
    }

    fn add(&self, prop: MapProp): i32 {
        if self.prop_count < MAX_PROPS {
            let new_prop = prop
            new_prop.id = self.next_id
            self.props = self.props + [new_prop]
            self.prop_count = self.prop_count + 1
            self.next_id = self.next_id + 1
            return new_prop.id
        }
        return -1
    }

    fn damage(&self, prop_id: i32, damage: i32): bool {
        for i in 0..self.prop_count {
            if self.props[i].id == prop_id {
                if self.props[i].is_destructible {
                    self.props[i].health = self.props[i].health - damage
                    if self.props[i].health <= 0 {
                        // Remove prop (swap with last)
                        self.props[i] = self.props[self.prop_count - 1]
                        self.prop_count = self.prop_count - 1
                        return true
                    }
                }
                break
            }
        }
        return false
    }
}

// ============================================================================
// FOG OF WAR
// ============================================================================

enum FogState {
    UNEXPLORED,
    EXPLORED,
    VISIBLE,
}

let MAX_FOG_SIZE: i32 = 65536
let MAX_PLAYERS: i32 = 8

struct FogOfWar {
    width: i32,
    height: i32,
    cell_size: f32,
    fog_states: [[FogState]],
    num_players: i32,
    update_interval: f32,
    update_timer: f32,
}

impl FogOfWar {
    fn init(width: i32, height: i32, cell_size: f32, num_players: i32): FogOfWar {
        let total_cells = width * height
        if total_cells > MAX_FOG_SIZE {
            total_cells = MAX_FOG_SIZE
        }

        // Initialize fog states for each player
        let fog_states: [[FogState]] = []
        for p in 0..num_players {
            let player_fog: [FogState] = []
            for i in 0..total_cells {
                player_fog = player_fog + [FogState::UNEXPLORED]
            }
            fog_states = fog_states + [player_fog]
        }

        return FogOfWar {
            width: width,
            height: height,
            cell_size: cell_size,
            fog_states: fog_states,
            num_players: num_players,
            update_interval: 0.1,
            update_timer: 0.0,
        }
    }

    fn world_to_cell(&self, x: f32, z: f32): [i32] {
        let cx = cast(i32, x / self.cell_size)
        let cz = cast(i32, z / self.cell_size)
        return [cx, cz]
    }

    fn reveal_area(&self, player_id: i32, center_x: f32, center_z: f32, radius: f32) {
        if player_id >= self.num_players {
            return
        }

        let cell_radius = cast(i32, radius / self.cell_size) + 1
        let center_cell = self.world_to_cell(center_x, center_z)

        for dx in -cell_radius..(cell_radius + 1) {
            for dz in -cell_radius..(cell_radius + 1) {
                let cx = center_cell[0] + dx
                let cz = center_cell[1] + dz

                if cx < 0 || cx >= self.width || cz < 0 || cz >= self.height {
                    continue
                }

                // Check if within radius
                let dist_sq = cast(f32, dx*dx + dz*dz) * self.cell_size * self.cell_size
                if dist_sq <= radius * radius {
                    let idx = cz * self.width + cx
                    if idx < self.fog_states[player_id].length {
                        self.fog_states[player_id][idx] = FogState::VISIBLE
                    }
                }
            }
        }
    }

    fn update_visibility(&self, player_id: i32) {
        if player_id >= self.num_players {
            return
        }

        let total_cells = self.width * self.height
        for i in 0..total_cells {
            if i < self.fog_states[player_id].length {
                if self.fog_states[player_id][i] == FogState::VISIBLE {
                    self.fog_states[player_id][i] = FogState::EXPLORED
                }
            }
        }
    }

    fn get_state(&self, player_id: i32, x: f32, z: f32): FogState {
        if player_id >= self.num_players {
            return FogState::UNEXPLORED
        }

        let cell = self.world_to_cell(x, z)
        if cell[0] < 0 || cell[0] >= self.width || cell[1] < 0 || cell[1] >= self.height {
            return FogState::UNEXPLORED
        }

        let idx = cell[1] * self.width + cell[0]
        if idx < self.fog_states[player_id].length {
            return self.fog_states[player_id][idx]
        }
        return FogState::UNEXPLORED
    }

    fn is_visible(&self, player_id: i32, x: f32, z: f32): bool {
        return self.get_state(player_id, x, z) == FogState::VISIBLE
    }

    fn reveal_all(&self, player_id: i32) {
        if player_id >= self.num_players {
            return
        }

        let total_cells = self.width * self.height
        for i in 0..total_cells {
            if i < self.fog_states[player_id].length {
                self.fog_states[player_id][i] = FogState::VISIBLE
            }
        }
    }
}

// ============================================================================
// MINIMAP
// ============================================================================

struct MinimapConfig {
    width: i32,
    height: i32,
    position_x: i32,
    position_y: i32,
    zoom_level: f32,
    show_units: bool,
    show_buildings: bool,
    show_resources: bool,
    show_fog: bool,
    ping_duration: f32,
}

struct MinimapPing {
    position: Vec2,
    color: Color,
    remaining_time: f32,
    owner_id: i32,
}

struct MinimapDot {
    position: Vec2,
    color: Color,
    size: f32,
    is_selected: bool,
}

struct Minimap {
    config: MinimapConfig,
    terrain_texture_id: i32,
    overlay_texture_id: i32,
    unit_dots: [MinimapDot],
    unit_dot_count: i32,
    building_dots: [MinimapDot],
    building_dot_count: i32,
    pings: [MinimapPing],
    ping_count: i32,
    camera_rect: [Vec2],
}

impl Minimap {
    fn init(width: i32, height: i32, pos_x: i32, pos_y: i32): Minimap {
        return Minimap {
            config: MinimapConfig {
                width: width,
                height: height,
                position_x: pos_x,
                position_y: pos_y,
                zoom_level: 1.0,
                show_units: true,
                show_buildings: true,
                show_resources: true,
                show_fog: true,
                ping_duration: 5.0,
            },
            terrain_texture_id: -1,
            overlay_texture_id: -1,
            unit_dots: [],
            unit_dot_count: 0,
            building_dots: [],
            building_dot_count: 0,
            pings: [],
            ping_count: 0,
            camera_rect: [],
        }
    }

    fn world_to_minimap(&self, map_width: f32, map_height: f32, world_x: f32, world_z: f32): Vec2 {
        let norm_x = world_x / map_width
        let norm_z = world_z / map_height

        return Vec2::new(
            cast(f32, self.config.position_x) + norm_x * cast(f32, self.config.width),
            cast(f32, self.config.position_y) + norm_z * cast(f32, self.config.height)
        )
    }

    fn minimap_to_world(&self, map_width: f32, map_height: f32, screen_x: f32, screen_y: f32): Vec2 {
        let local_x = screen_x - cast(f32, self.config.position_x)
        let local_y = screen_y - cast(f32, self.config.position_y)

        let norm_x = local_x / cast(f32, self.config.width)
        let norm_y = local_y / cast(f32, self.config.height)

        return Vec2::new(norm_x * map_width, norm_y * map_height)
    }

    fn is_point_on_minimap(&self, screen_x: i32, screen_y: i32): bool {
        return screen_x >= self.config.position_x &&
               screen_x < self.config.position_x + self.config.width &&
               screen_y >= self.config.position_y &&
               screen_y < self.config.position_y + self.config.height
    }

    fn add_ping(&self, position: Vec2, color: Color, owner: i32) {
        if self.ping_count < 16 {
            self.pings = self.pings + [MinimapPing {
                position: position,
                color: color,
                remaining_time: self.config.ping_duration,
                owner_id: owner,
            }]
            self.ping_count = self.ping_count + 1
        }
    }

    fn update(&self, delta_time: f32) {
        let i = 0
        while i < self.ping_count {
            self.pings[i].remaining_time = self.pings[i].remaining_time - delta_time
            if self.pings[i].remaining_time <= 0.0 {
                // Remove ping (swap with last)
                self.pings[i] = self.pings[self.ping_count - 1]
                self.ping_count = self.ping_count - 1
            } else {
                i = i + 1
            }
        }
    }
}

fn get_player_color(player_id: i32): Color {
    if player_id == 0 {
        return Color::rgba(255, 0, 0, 255)      // Red
    } else if player_id == 1 {
        return Color::rgba(0, 0, 255, 255)      // Blue
    } else if player_id == 2 {
        return Color::rgba(0, 255, 0, 255)      // Green
    } else if player_id == 3 {
        return Color::rgba(255, 255, 0, 255)    // Yellow
    } else if player_id == 4 {
        return Color::rgba(255, 128, 0, 255)    // Orange
    } else if player_id == 5 {
        return Color::rgba(0, 255, 255, 255)    // Cyan
    } else if player_id == 6 {
        return Color::rgba(255, 0, 255, 255)    // Magenta
    } else if player_id == 7 {
        return Color::rgba(255, 255, 255, 255)  // White
    }
    return Color::rgba(128, 128, 128, 255)      // Gray
}

// ============================================================================
// STARTING POSITIONS
// ============================================================================

struct StartingPosition {
    player_slot: i32,
    position: Vec3,
    initial_camera: Vec3,
    faction: i32,
    team: i32,
}

struct MapMetadata {
    name: string,
    description: string,
    map_size: string,
    max_players: i32,
    starting_positions: [StartingPosition],
    position_count: i32,
    preview_image: string,
    is_official: bool,
    tech_level: i32,
}

impl MapMetadata {
    fn init(): MapMetadata {
        return MapMetadata {
            name: "",
            description: "",
            map_size: "Medium",
            max_players: 2,
            starting_positions: [],
            position_count: 0,
            preview_image: "",
            is_official: false,
            tech_level: 1,
        }
    }
}

// ============================================================================
// PATHFINDING GRID
// ============================================================================

enum PathCellType {
    PASSABLE,
    BLOCKED,
    WATER_ONLY,
    AIR_ONLY,
}

struct PathfindingGrid {
    width: i32,
    height: i32,
    cell_size: f32,
    cells: [PathCellType],
    chunk_size: i32,
    num_chunks_x: i32,
    num_chunks_y: i32,
}

impl PathfindingGrid {
    fn init(width: i32, height: i32, cell_size: f32): PathfindingGrid {
        let total = width * height
        let cells: [PathCellType] = []
        for i in 0..total {
            cells = cells + [PathCellType::PASSABLE]
        }

        return PathfindingGrid {
            width: width,
            height: height,
            cell_size: cell_size,
            cells: cells,
            chunk_size: 16,
            num_chunks_x: (width + 15) / 16,
            num_chunks_y: (height + 15) / 16,
        }
    }

    fn set_blocked(&self, x: i32, z: i32) {
        if x >= 0 && x < self.width && z >= 0 && z < self.height {
            let idx = z * self.width + x
            if idx < self.cells.length {
                self.cells[idx] = PathCellType::BLOCKED
            }
        }
    }

    fn is_passable(&self, x: i32, z: i32, is_air: bool, is_naval: bool): bool {
        if x < 0 || x >= self.width || z < 0 || z >= self.height {
            return false
        }

        let idx = z * self.width + x
        if idx >= self.cells.length {
            return false
        }

        let cell = self.cells[idx]

        if is_air {
            return true
        }

        if is_naval {
            return cell == PathCellType::WATER_ONLY || cell == PathCellType::PASSABLE
        }

        return cell == PathCellType::PASSABLE
    }

    fn world_to_cell(&self, world_x: f32, world_z: f32): [i32] {
        let cx = cast(i32, world_x / self.cell_size)
        let cz = cast(i32, world_z / self.cell_size)
        return [cx, cz]
    }
}

// ============================================================================
// MAP MANAGER
// ============================================================================

struct MapManager {
    metadata: MapMetadata,
    heightmap: HeightMap,
    terrain_cells: [TerrainCell],
    terrain_width: i32,
    terrain_height: i32,
    water: WaterSystem,
    props: PropManager,
    fog: FogOfWar,
    minimap: Minimap,
    pathfinding: PathfindingGrid,
    world_min_x: f32,
    world_min_z: f32,
    world_max_x: f32,
    world_max_z: f32,
    is_loaded: bool,
}

impl MapManager {
    fn init(): MapManager {
        return MapManager {
            metadata: MapMetadata::init(),
            heightmap: HeightMap::init(0, 0, 1.0),
            terrain_cells: [],
            terrain_width: 0,
            terrain_height: 0,
            water: WaterSystem::init(),
            props: PropManager::init(),
            fog: FogOfWar::init(0, 0, 1.0, 0),
            minimap: Minimap::init(200, 200, 10, 10),
            pathfinding: PathfindingGrid::init(0, 0, 1.0),
            world_min_x: 0.0,
            world_min_z: 0.0,
            world_max_x: 0.0,
            world_max_z: 0.0,
            is_loaded: false,
        }
    }

    fn load(&self, map_name: string, num_players: i32): bool {
        let map_size = 128
        let cell_size = 10.0

        // Initialize heightmap
        self.heightmap = HeightMap::init(map_size, map_size, cell_size)

        // Generate procedural terrain
        for z in 0..map_size {
            for x in 0..map_size {
                let idx = z * map_size + x
                if idx < self.heightmap.heights.length {
                    let fx = cast(f32, x) / cast(f32, map_size)
                    let fz = cast(f32, z) / cast(f32, map_size)
                    let height = sin(fx * 3.14159 * 2.0) * cos(fz * 3.14159 * 2.0) * 10.0 + 5.0
                    self.heightmap.heights[idx] = height
                }
            }
        }

        // Initialize terrain cells
        self.terrain_width = map_size
        self.terrain_height = map_size
        self.terrain_cells = []

        for i in 0..(map_size * map_size) {
            let cell = TerrainCell::init()
            if i < self.heightmap.heights.length {
                cell.height = self.heightmap.heights[i]
            }
            self.terrain_cells = self.terrain_cells + [cell]
        }

        // Set world bounds
        self.world_min_x = 0.0
        self.world_min_z = 0.0
        self.world_max_x = cast(f32, map_size) * cell_size
        self.world_max_z = cast(f32, map_size) * cell_size

        // Initialize fog of war
        self.fog = FogOfWar::init(map_size, map_size, cell_size, num_players)

        // Initialize pathfinding
        self.pathfinding = PathfindingGrid::init(map_size, map_size, cell_size)

        // Add some water
        let water_plane = WaterPlane::init()
        water_plane.water_type = WaterType::SHALLOW
        water_plane.min_x = 400.0
        water_plane.min_z = 400.0
        water_plane.max_x = 800.0
        water_plane.max_z = 800.0
        water_plane.height = 0.0
        water_plane.color = Color::rgba(64, 128, 255, 200)
        water_plane.opacity = 0.7
        self.water.add_plane(water_plane)

        // Add some props
        for i in 0..50 {
            let tree_x = random_float() * self.world_max_x
            let tree_z = random_float() * self.world_max_z
            let tree_y = self.heightmap.get_height_at(tree_x, tree_z)
            self.props.add(MapProp::tree(Vec3::new(tree_x, tree_y, tree_z), "Tree01"))
        }

        for i in 0..20 {
            let rock_x = random_float() * self.world_max_x
            let rock_z = random_float() * self.world_max_z
            let rock_y = self.heightmap.get_height_at(rock_x, rock_z)
            self.props.add(MapProp::rock(Vec3::new(rock_x, rock_y, rock_z), "Rock01", 0.5 + random_float() * 1.5))
        }

        // Set metadata
        self.metadata.name = map_name
        self.metadata.max_players = num_players
        self.metadata.map_size = "Medium"

        // Create starting positions
        self.metadata.position_count = num_players
        for i in 0..num_players {
            let angle = cast(f32, i) / cast(f32, num_players) * 3.14159 * 2.0
            let radius = self.world_max_x * 0.35
            let center_x = self.world_max_x * 0.5
            let center_z = self.world_max_z * 0.5

            let pos_x = center_x + cos(angle) * radius
            let pos_z = center_z + sin(angle) * radius
            let pos_y = self.heightmap.get_height_at(pos_x, pos_z)

            self.metadata.starting_positions = self.metadata.starting_positions + [StartingPosition {
                player_slot: i,
                position: Vec3::new(pos_x, pos_y, pos_z),
                initial_camera: Vec3::new(pos_x, pos_y + 100.0, pos_z - 100.0),
                faction: -1,
                team: i,
            }]
        }

        self.is_loaded = true
        return true
    }

    fn update(&self, delta_time: f32) {
        self.water.update(delta_time)
        self.minimap.update(delta_time)
    }

    fn get_terrain_height(&self, x: f32, z: f32): f32 {
        return self.heightmap.get_height_at(x, z)
    }

    fn get_terrain_type(&self, x: f32, z: f32): TerrainType {
        let cx = cast(i32, x / self.heightmap.cell_size)
        let cz = cast(i32, z / self.heightmap.cell_size)

        if cx < 0 || cx >= self.terrain_width || cz < 0 || cz >= self.terrain_height {
            return TerrainType::IMPASSABLE
        }

        let idx = cz * self.terrain_width + cx
        if idx >= self.terrain_cells.length {
            return TerrainType::IMPASSABLE
        }

        return self.terrain_cells[idx].terrain_type
    }

    fn is_buildable(&self, x: f32, z: f32): bool {
        let cx = cast(i32, x / self.heightmap.cell_size)
        let cz = cast(i32, z / self.heightmap.cell_size)

        if cx < 0 || cx >= self.terrain_width || cz < 0 || cz >= self.terrain_height {
            return false
        }

        let idx = cz * self.terrain_width + cx
        if idx >= self.terrain_cells.length {
            return false
        }

        return self.terrain_cells[idx].is_buildable
    }

    fn is_in_bounds(&self, x: f32, z: f32): bool {
        return x >= self.world_min_x && x <= self.world_max_x &&
               z >= self.world_min_z && z <= self.world_max_z
    }
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn sqrt(x: f32): f32 {
    if x <= 0.0 {
        return 0.0
    }
    let guess = x / 2.0
    for i in 0..10 {
        guess = (guess + x / guess) / 2.0
    }
    return guess
}

fn sin(x: f32): f32 {
    let x_norm = x
    while x_norm > 3.14159 {
        x_norm = x_norm - 6.28318
    }
    while x_norm < -3.14159 {
        x_norm = x_norm + 6.28318
    }

    let x2 = x_norm * x_norm
    let x3 = x2 * x_norm
    let x5 = x3 * x2
    let x7 = x5 * x2

    return x_norm - x3/6.0 + x5/120.0 - x7/5040.0
}

fn cos(x: f32): f32 {
    return sin(x + 1.5708)
}

let g_random_seed: i32 = 12345

fn random_float(): f32 {
    g_random_seed = g_random_seed * 1103515245 + 12345
    let val = g_random_seed
    if val < 0 {
        val = -val
    }
    return cast(f32, val % 10000) / 10000.0
}

// ============================================================================
// GLOBAL MAP MANAGER
// ============================================================================

let g_map_manager: MapManager? = null

fn init_map_manager(): MapManager {
    let mm = MapManager::init()
    g_map_manager = mm
    return mm
}

fn get_map_manager(): MapManager? {
    return g_map_manager
}

fn shutdown_map_manager() {
    g_map_manager = null
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

fn test_map_system() {
    print("Testing Map System...")

    let mm = init_map_manager()
    let loaded = mm.load("TestMap", 4)
    print("Map loaded: " + str(loaded))
    print("Map size: " + str(mm.terrain_width) + "x" + str(mm.terrain_height))
    print("World bounds: " + str(mm.world_min_x) + "," + str(mm.world_min_z) + " to " + str(mm.world_max_x) + "," + str(mm.world_max_z))

    // Test heightmap
    let h1 = mm.get_terrain_height(100.0, 100.0)
    let h2 = mm.get_terrain_height(500.0, 500.0)
    print("Height at (100,100): " + str(h1))
    print("Height at (500,500): " + str(h2))

    // Test terrain normal
    let normal = mm.heightmap.get_normal_at(100.0, 100.0)
    print("Normal at (100,100): " + str(normal.x) + "," + str(normal.y) + "," + str(normal.z))

    // Test water
    let water_height = mm.water.get_height_at(500.0, 500.0, 0.0)
    print("Water height at (500,500): " + str(water_height))

    // Test props
    print("Prop count: " + str(mm.props.prop_count))

    // Test fog of war
    mm.fog.reveal_area(0, 640.0, 640.0, 200.0)
    let vis1 = mm.fog.is_visible(0, 640.0, 640.0)
    let vis2 = mm.fog.is_visible(0, 100.0, 100.0)
    print("Visibility at (640,640) for player 0: " + str(vis1))
    print("Visibility at (100,100) for player 0: " + str(vis2))

    // Test minimap
    let mm_pos = mm.minimap.world_to_minimap(mm.world_max_x, mm.world_max_z, 640.0, 640.0)
    print("Minimap position for (640,640): " + str(mm_pos.x) + "," + str(mm_pos.y))

    // Test pathfinding
    let path_cell = mm.pathfinding.world_to_cell(500.0, 500.0)
    let passable = mm.pathfinding.is_passable(path_cell[0], path_cell[1], false, false)
    print("Cell at (500,500): " + str(path_cell[0]) + "," + str(path_cell[1]) + " passable: " + str(passable))

    // Test starting positions
    print("Starting positions: " + str(mm.metadata.position_count))

    // Test map bounds
    let in_bounds1 = mm.is_in_bounds(500.0, 500.0)
    let in_bounds2 = mm.is_in_bounds(2000.0, 2000.0)
    print("(500,500) in bounds: " + str(in_bounds1))
    print("(2000,2000) in bounds: " + str(in_bounds2))

    // Test buildable
    let buildable = mm.is_buildable(300.0, 300.0)
    print("Position (300,300) buildable: " + str(buildable))

    shutdown_map_manager()
    print("Map System tests complete!")
}
