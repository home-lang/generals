// Mob Member Slaved Update - Angry mob AI and swarm behavior
// Handles mob recruitment, target selection, and coordinated swarm attacks

// ============================================================================
// Configuration
// ============================================================================

struct MobConfig {
    max_mob_size: i32,
    min_mob_size: i32,
    recruitment_range: f32,
    cohesion_range: f32,
    separation_distance: f32,
    swarm_speed_bonus: f32,
    mob_damage_bonus: f32,
    max_damage_bonus: f32,
    flee_health_threshold: f32,
    rally_range: f32,
    target_switch_delay: f32,
    leader_influence_range: f32,
    anger_decay_rate: f32,
    anger_gain_rate: f32,
}

impl MobConfig {
    fn init(): MobConfig {
        return MobConfig {
            max_mob_size: 10,
            min_mob_size: 3,
            recruitment_range: 100.0,
            cohesion_range: 50.0,
            separation_distance: 10.0,
            swarm_speed_bonus: 1.2,
            mob_damage_bonus: 1.1,
            max_damage_bonus: 2.0,
            flee_health_threshold: 0.2,
            rally_range: 30.0,
            target_switch_delay: 2.0,
            leader_influence_range: 75.0,
            anger_decay_rate: 0.05,
            anger_gain_rate: 0.3,
        }
    }
}

// ============================================================================
// Mob States
// ============================================================================

enum MobState {
    IDLE,
    ROAMING,
    RALLYING,
    ATTACKING,
    FLEEING,
    DISBANDED,
}

enum MemberState {
    FOLLOWING,
    ATTACKING,
    FLEEING,
    RECRUITING,
    DEAD,
}

enum MobTargetType {
    NONE,
    ENEMY,
    BUILDING,
    VEHICLE,
    HIGH_VALUE,
}

// ============================================================================
// Vec3 helper
// ============================================================================

struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn zero(): Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }
}

// ============================================================================
// Mob Member
// ============================================================================

struct MobMember {
    unit_id: i64,
    position: Vec3,
    velocity: Vec3,
    health: f32,
    max_health: f32,
    state: MemberState,
    anger_level: f32,
    time_in_mob: f32,
    target_id: i64,
    is_leader: bool,
    weapon_damage: f32,
    weapon_range: f32,
    move_speed: f32,
    last_attack_time: f32,
}

impl MobMember {
    fn init(unit_id: i64, position: Vec3, health: f32): MobMember {
        return MobMember {
            unit_id: unit_id,
            position: position,
            velocity: Vec3::zero(),
            health: health,
            max_health: health,
            state: MemberState::FOLLOWING,
            anger_level: 0.5,
            time_in_mob: 0.0,
            target_id: 0,
            is_leader: false,
            weapon_damage: 10.0,
            weapon_range: 15.0,
            move_speed: 30.0,
            last_attack_time: 0.0,
        }
    }
}

// ============================================================================
// Mob Group
// ============================================================================

struct MobGroup {
    mob_id: i64,
    members: [i64],
    member_count: i32,
    leader_id: i64,
    state: MobState,
    center_position: Vec3,
    target_id: i64,
    target_type: MobTargetType,
    target_position: Vec3,
    average_anger: f32,
    total_damage_bonus: f32,
    formation_spread: f32,
    time_since_target_change: f32,
    rally_point: Vec3,
    owner_player: i32,
}

impl MobGroup {
    fn init(mob_id: i64): MobGroup {
        let mems: [i64] = []
        for i in 0..16 {
            mems = mems + [0]
        }
        return MobGroup {
            mob_id: mob_id,
            members: mems,
            member_count: 0,
            leader_id: 0,
            state: MobState::IDLE,
            center_position: Vec3::zero(),
            target_id: 0,
            target_type: MobTargetType::NONE,
            target_position: Vec3::zero(),
            average_anger: 0.5,
            total_damage_bonus: 1.0,
            formation_spread: 1.0,
            time_since_target_change: 0.0,
            rally_point: Vec3::zero(),
            owner_player: 0,
        }
    }
}

// ============================================================================
// Potential Target
// ============================================================================

struct PotentialTarget {
    target_id: i64,
    position: Vec3,
    target_type: MobTargetType,
    threat_value: f32,
    is_valid: bool,
}

impl PotentialTarget {
    fn init(): PotentialTarget {
        return PotentialTarget {
            target_id: 0,
            position: Vec3::zero(),
            target_type: MobTargetType::NONE,
            threat_value: 0.0,
            is_valid: false,
        }
    }
}

// ============================================================================
// Member Storage (replaces HashMap<u64, MobMember>)
// ============================================================================

struct MemberStorage {
    members: [MobMember],
    member_ids: [i64],
    count: i32,
}

impl MemberStorage {
    fn init(): MemberStorage {
        return MemberStorage {
            members: [],
            member_ids: [],
            count: 0,
        }
    }

    fn get(&self, unit_id: i64): MobMember? {
        for i in 0..self.count {
            if self.member_ids[i] == unit_id {
                return self.members[i]
            }
        }
        return null
    }

    fn insert(&self, unit_id: i64, member: MobMember) {
        for i in 0..self.count {
            if self.member_ids[i] == unit_id {
                self.members[i] = member
                return
            }
        }
        self.members = self.members + [member]
        self.member_ids = self.member_ids + [unit_id]
        self.count = self.count + 1
    }

    fn contains(&self, unit_id: i64): bool {
        for i in 0..self.count {
            if self.member_ids[i] == unit_id {
                return true
            }
        }
        return false
    }
}

// ============================================================================
// Mob Storage (replaces HashMap<u64, MobGroup>)
// ============================================================================

struct MobStorage {
    mobs: [MobGroup],
    mob_ids: [i64],
    count: i32,
}

impl MobStorage {
    fn init(): MobStorage {
        return MobStorage {
            mobs: [],
            mob_ids: [],
            count: 0,
        }
    }

    fn get(&self, mob_id: i64): MobGroup? {
        for i in 0..self.count {
            if self.mob_ids[i] == mob_id {
                return self.mobs[i]
            }
        }
        return null
    }

    fn insert(&self, mob_id: i64, mob: MobGroup) {
        for i in 0..self.count {
            if self.mob_ids[i] == mob_id {
                self.mobs[i] = mob
                return
            }
        }
        self.mobs = self.mobs + [mob]
        self.mob_ids = self.mob_ids + [mob_id]
        self.count = self.count + 1
    }

    fn remove(&self, mob_id: i64) {
        for i in 0..self.count {
            if self.mob_ids[i] == mob_id {
                // Shift remaining
                for j in i..(self.count - 1) {
                    self.mobs[j] = self.mobs[j + 1]
                    self.mob_ids[j] = self.mob_ids[j + 1]
                }
                self.count = self.count - 1
                return
            }
        }
    }
}

// ============================================================================
// Mob Member Slaved Update Module
// ============================================================================

struct MobMemberSlavedUpdateModule {
    config: MobConfig,
    members: MemberStorage,
    mobs: MobStorage,
    next_mob_id: i64,

    // Potential targets for all mobs
    potential_targets: [PotentialTarget],
    target_count: i32,
}

impl MobMemberSlavedUpdateModule {
    fn init(config: MobConfig): MobMemberSlavedUpdateModule {
        let targets: [PotentialTarget] = []
        for i in 0..32 {
            targets = targets + [PotentialTarget::init()]
        }
        return MobMemberSlavedUpdateModule {
            config: config,
            members: MemberStorage::init(),
            mobs: MobStorage::init(),
            next_mob_id: 1,
            potential_targets: targets,
            target_count: 0,
        }
    }
}

// ============================================================================
// Mob Management
// ============================================================================

fn form_mob(module: MobMemberSlavedUpdateModule, initial_member_ids: [i64], count: i32, owner: i32): i64 {
    if count < module.config.min_mob_size {
        return 0
    }

    let mob_id = module.next_mob_id
    module.next_mob_id = module.next_mob_id + 1

    let mob = MobGroup::init(mob_id)
    mob.owner_player = owner

    // Add initial members
    for i in 0..count {
        if i < 16 {
            let unit_id = initial_member_ids[i]
            mob.members[i] = unit_id
            mob.member_count = mob.member_count + 1

            // Create member entry if not exists
            if !module.members.contains(unit_id) {
                let member = MobMember::init(unit_id, Vec3::zero(), 100.0)
                module.members.insert(unit_id, member)
            }
        }
    }

    // Elect leader (highest health)
    elect_leader(module, mob)

    // Calculate initial center
    update_mob_center(module, mob)

    mob.state = MobState::IDLE
    mob.rally_point = mob.center_position

    module.mobs.insert(mob_id, mob)

    return mob_id
}

fn disband_mob(module: MobMemberSlavedUpdateModule, mob_id: i64) {
    let mob = module.mobs.get(mob_id)
    if mob != null {
        mob.state = MobState::DISBANDED

        // Clear member associations
        for i in 0..mob.member_count {
            let member = module.members.get(mob.members[i])
            if member != null {
                member.state = MemberState::FOLLOWING
                member.is_leader = false
            }
        }
    }

    module.mobs.remove(mob_id)
}

fn recruit_member(module: MobMemberSlavedUpdateModule, mob_id: i64, unit_id: i64): bool {
    let mob = module.mobs.get(mob_id)
    if mob == null || mob.member_count >= module.config.max_mob_size {
        return false
    }

    // Check if already in a mob
    for i in 0..module.mobs.count {
        let other_mob = module.mobs.mobs[i]
        for j in 0..other_mob.member_count {
            if other_mob.members[j] == unit_id {
                return false  // Already in a mob
            }
        }
    }

    // Add to mob
    mob.members[mob.member_count] = unit_id
    mob.member_count = mob.member_count + 1

    // Create or update member
    if !module.members.contains(unit_id) {
        let member = MobMember::init(unit_id, mob.center_position, 100.0)
        module.members.insert(unit_id, member)
    }

    let member = module.members.get(unit_id)
    if member != null {
        member.state = MemberState::FOLLOWING
        member.anger_level = mob.average_anger  // Match mob's anger
    }

    // Update damage bonus
    update_damage_bonus(module, mob)

    return true
}

fn remove_member(module: MobMemberSlavedUpdateModule, mob_id: i64, unit_id: i64) {
    let mob = module.mobs.get(mob_id)
    if mob == null {
        return
    }

    // Find and remove member
    for i in 0..mob.member_count {
        if mob.members[i] == unit_id {
            // Shift remaining members
            for j in i..(mob.member_count - 1) {
                mob.members[j] = mob.members[j + 1]
            }
            mob.member_count = mob.member_count - 1
            break
        }
    }

    // If leader left, elect new one
    if mob.leader_id == unit_id {
        elect_leader(module, mob)
    }

    // Update damage bonus
    update_damage_bonus(module, mob)

    // Check if mob should disband
    if mob.member_count < module.config.min_mob_size {
        disband_mob(module, mob_id)
    }
}

// ============================================================================
// Leader Election
// ============================================================================

fn elect_leader(module: MobMemberSlavedUpdateModule, mob: MobGroup) {
    let best_leader_id: i64 = 0
    let best_health: f32 = 0.0

    for i in 0..mob.member_count {
        let member = module.members.get(mob.members[i])
        if member != null && member.health > best_health && member.state != MemberState::DEAD {
            best_health = member.health
            best_leader_id = member.unit_id
        }
    }

    // Clear old leader
    if mob.leader_id != 0 {
        let old_leader = module.members.get(mob.leader_id)
        if old_leader != null {
            old_leader.is_leader = false
        }
    }

    // Set new leader
    mob.leader_id = best_leader_id
    let new_leader = module.members.get(best_leader_id)
    if new_leader != null {
        new_leader.is_leader = true
    }
}

// ============================================================================
// Target Management
// ============================================================================

fn add_potential_target(module: MobMemberSlavedUpdateModule, target_id: i64, position: Vec3, target_type: MobTargetType, threat: f32) {
    if module.target_count >= 32 {
        return
    }

    module.potential_targets[module.target_count] = PotentialTarget {
        target_id: target_id,
        position: position,
        target_type: target_type,
        threat_value: threat,
        is_valid: true,
    }
    module.target_count = module.target_count + 1
}

fn select_target_for_mob(module: MobMemberSlavedUpdateModule, mob_id: i64): i64 {
    let mob = module.mobs.get(mob_id)
    if mob == null {
        return 0
    }

    let best_target_id: i64 = 0
    let best_score: f32 = 0.0

    for i in 0..module.target_count {
        let target = module.potential_targets[i]
        if !target.is_valid {
            continue
        }

        // Calculate distance
        let dx = target.position.x - mob.center_position.x
        let dy = target.position.y - mob.center_position.y
        let distance = sqrt(dx * dx + dy * dy)

        // Score based on distance and threat
        let distance_factor = 1.0 / (1.0 + distance / 100.0)
        let anger_factor = mob.average_anger

        // Prefer buildings when angry
        let type_bonus = target_type_bonus(target.target_type, anger_factor)

        let score = target.threat_value * distance_factor * type_bonus

        if score > best_score {
            best_score = score
            best_target_id = target.target_id
        }
    }

    return best_target_id
}

fn target_type_bonus(target_type: MobTargetType, anger_factor: f32): f32 {
    if target_type == MobTargetType::BUILDING {
        return 1.5 * anger_factor
    } else if target_type == MobTargetType::HIGH_VALUE {
        return 2.0
    } else if target_type == MobTargetType::VEHICLE {
        return 1.2
    } else if target_type == MobTargetType::ENEMY {
        return 1.0
    }
    return 0.5
}

fn set_mob_target(module: MobMemberSlavedUpdateModule, mob_id: i64, target_id: i64) {
    let mob = module.mobs.get(mob_id)
    if mob == null {
        return
    }

    mob.target_id = target_id
    mob.time_since_target_change = 0.0

    // Find target info
    for i in 0..module.target_count {
        if module.potential_targets[i].target_id == target_id {
            mob.target_position = module.potential_targets[i].position
            mob.target_type = module.potential_targets[i].target_type
            break
        }
    }

    // Set all members to attack
    for i in 0..mob.member_count {
        let member = module.members.get(mob.members[i])
        if member != null && member.state != MemberState::DEAD {
            member.state = MemberState::ATTACKING
            member.target_id = target_id
        }
    }

    mob.state = MobState::ATTACKING
}

// ============================================================================
// Update Functions
// ============================================================================

fn update_mob_module(module: MobMemberSlavedUpdateModule, delta_time: f32) {
    for i in 0..module.mobs.count {
        let mob = module.mobs.mobs[i]

        if mob.state == MobState::DISBANDED {
            continue
        }

        // Update mob center position
        update_mob_center(module, mob)

        // Update average anger
        update_mob_anger(module, mob, delta_time)

        // Update target timing
        mob.time_since_target_change = mob.time_since_target_change + delta_time

        // State-specific update
        if mob.state == MobState::IDLE {
            update_idle_mob(module, mob, delta_time)
        } else if mob.state == MobState::ROAMING {
            update_roaming_mob(module, mob, delta_time)
        } else if mob.state == MobState::RALLYING {
            update_rallying_mob(module, mob, delta_time)
        } else if mob.state == MobState::ATTACKING {
            update_attacking_mob(module, mob, delta_time)
        } else if mob.state == MobState::FLEEING {
            update_fleeing_mob(module, mob, delta_time)
        }

        // Update individual members
        update_mob_members(module, mob, delta_time)
    }
}

fn update_mob_center(module: MobMemberSlavedUpdateModule, mob: MobGroup) {
    if mob.member_count == 0 {
        return
    }

    let total_x: f32 = 0.0
    let total_y: f32 = 0.0
    let total_z: f32 = 0.0
    let alive_count: i32 = 0

    for i in 0..mob.member_count {
        let member = module.members.get(mob.members[i])
        if member != null && member.state != MemberState::DEAD {
            total_x = total_x + member.position.x
            total_y = total_y + member.position.y
            total_z = total_z + member.position.z
            alive_count = alive_count + 1
        }
    }

    if alive_count > 0 {
        mob.center_position = Vec3 {
            x: total_x / (alive_count as f32),
            y: total_y / (alive_count as f32),
            z: total_z / (alive_count as f32),
        }
    }
}

fn update_mob_anger(module: MobMemberSlavedUpdateModule, mob: MobGroup, delta_time: f32) {
    let total_anger: f32 = 0.0
    let count: i32 = 0

    for i in 0..mob.member_count {
        let member = module.members.get(mob.members[i])
        if member != null && member.state != MemberState::DEAD {
            total_anger = total_anger + member.anger_level
            count = count + 1
        }
    }

    if count > 0 {
        mob.average_anger = total_anger / (count as f32)
    }

    // Anger decays slowly over time when not attacking
    if mob.state != MobState::ATTACKING {
        mob.average_anger = mob.average_anger - module.config.anger_decay_rate * delta_time
        if mob.average_anger < 0.0 {
            mob.average_anger = 0.0
        }
    }
}

fn update_damage_bonus(module: MobMemberSlavedUpdateModule, mob: MobGroup) {
    // Damage bonus scales with mob size
    let size_bonus = 1.0 + ((mob.member_count - 1) as f32) * (module.config.mob_damage_bonus - 1.0)
    mob.total_damage_bonus = min_f32(size_bonus, module.config.max_damage_bonus)
}

fn update_idle_mob(module: MobMemberSlavedUpdateModule, mob: MobGroup, delta_time: f32) {
    // Look for nearby targets
    let target_id = select_target_for_mob(module, mob.mob_id)

    if target_id != 0 && mob.average_anger > 0.3 {
        set_mob_target(module, mob.mob_id, target_id)
    } else {
        // Start roaming if no target
        mob.state = MobState::ROAMING
    }
}

fn update_roaming_mob(module: MobMemberSlavedUpdateModule, mob: MobGroup, delta_time: f32) {
    // Look for targets while roaming
    let target_id = select_target_for_mob(module, mob.mob_id)

    if target_id != 0 {
        set_mob_target(module, mob.mob_id, target_id)
        return
    }

    // Move towards rally point slowly
    let dx = mob.rally_point.x - mob.center_position.x
    let dy = mob.rally_point.y - mob.center_position.y
    let distance = sqrt(dx * dx + dy * dy)

    if distance < 20.0 {
        // Pick new random rally point
        mob.rally_point.x = mob.center_position.x + (pseudo_random() - 0.5) * 200.0
        mob.rally_point.y = mob.center_position.y + (pseudo_random() - 0.5) * 200.0
    }
}

fn update_rallying_mob(module: MobMemberSlavedUpdateModule, mob: MobGroup, delta_time: f32) {
    // Check if all members are gathered
    let all_gathered = true

    for i in 0..mob.member_count {
        let member = module.members.get(mob.members[i])
        if member != null && member.state != MemberState::DEAD {
            let dx = member.position.x - mob.rally_point.x
            let dy = member.position.y - mob.rally_point.y
            let distance = sqrt(dx * dx + dy * dy)

            if distance > module.config.rally_range {
                all_gathered = false
                break
            }
        }
    }

    if all_gathered {
        mob.state = MobState::IDLE
    }
}

fn update_attacking_mob(module: MobMemberSlavedUpdateModule, mob: MobGroup, delta_time: f32) {
    // Check if target still valid
    let target_valid = false
    for i in 0..module.target_count {
        if module.potential_targets[i].target_id == mob.target_id && module.potential_targets[i].is_valid {
            target_valid = true
            mob.target_position = module.potential_targets[i].position
            break
        }
    }

    if !target_valid {
        // Target eliminated, find new target
        mob.target_id = 0
        mob.state = MobState::IDLE
        return
    }

    // Increase anger during combat
    for i in 0..mob.member_count {
        let member = module.members.get(mob.members[i])
        if member != null {
            member.anger_level = member.anger_level + module.config.anger_gain_rate * delta_time * 0.1
            if member.anger_level > 1.0 {
                member.anger_level = 1.0
            }
        }
    }

    // Check for flee condition
    let low_health_count: i32 = 0
    for i in 0..mob.member_count {
        let member = module.members.get(mob.members[i])
        if member != null && member.health / member.max_health < module.config.flee_health_threshold {
            low_health_count = low_health_count + 1
        }
    }

    if low_health_count > mob.member_count / 2 {
        mob.state = MobState::FLEEING
    }
}

fn update_fleeing_mob(module: MobMemberSlavedUpdateModule, mob: MobGroup, delta_time: f32) {
    // Clear target
    mob.target_id = 0

    // All members flee
    for i in 0..mob.member_count {
        let member = module.members.get(mob.members[i])
        if member != null {
            member.state = MemberState::FLEEING
            member.anger_level = member.anger_level * 0.9  // Anger decays faster when fleeing
        }
    }

    // Check if safe (no nearby enemies)
    let has_nearby_enemy = false
    for i in 0..module.target_count {
        let target = module.potential_targets[i]
        if target.is_valid {
            let dx = target.position.x - mob.center_position.x
            let dy = target.position.y - mob.center_position.y
            let distance = sqrt(dx * dx + dy * dy)

            if distance < 150.0 {
                has_nearby_enemy = true
                break
            }
        }
    }

    if !has_nearby_enemy {
        mob.state = MobState::RALLYING
        mob.rally_point = mob.center_position

        for i in 0..mob.member_count {
            let member = module.members.get(mob.members[i])
            if member != null {
                member.state = MemberState::FOLLOWING
            }
        }
    }
}

fn update_mob_members(module: MobMemberSlavedUpdateModule, mob: MobGroup, delta_time: f32) {
    let leader = module.members.get(mob.leader_id)
    let leader_pos = mob.center_position
    if leader != null {
        leader_pos = leader.position
    }

    for i in 0..mob.member_count {
        let member = module.members.get(mob.members[i])
        if member == null || member.state == MemberState::DEAD {
            continue
        }

        member.time_in_mob = member.time_in_mob + delta_time
        member.last_attack_time = member.last_attack_time + delta_time

        // Calculate swarm forces
        let force_x: f32 = 0.0
        let force_y: f32 = 0.0

        // 1. Cohesion - move towards center
        let to_center_x = mob.center_position.x - member.position.x
        let to_center_y = mob.center_position.y - member.position.y
        let center_dist = sqrt(to_center_x * to_center_x + to_center_y * to_center_y)

        if center_dist > module.config.cohesion_range {
            force_x = force_x + to_center_x / center_dist * 0.5
            force_y = force_y + to_center_y / center_dist * 0.5
        }

        // 2. Follow leader
        if !member.is_leader {
            let to_leader_x = leader_pos.x - member.position.x
            let to_leader_y = leader_pos.y - member.position.y
            let leader_dist = sqrt(to_leader_x * to_leader_x + to_leader_y * to_leader_y)

            if leader_dist > module.config.leader_influence_range {
                force_x = force_x + to_leader_x / leader_dist * 0.3
                force_y = force_y + to_leader_y / leader_dist * 0.3
            }
        }

        // 3. Separation - avoid crowding
        for j in 0..mob.member_count {
            if i == j { continue }

            let other = module.members.get(mob.members[j])
            if other == null { continue }

            let sep_x = member.position.x - other.position.x
            let sep_y = member.position.y - other.position.y
            let sep_dist = sqrt(sep_x * sep_x + sep_y * sep_y)

            if sep_dist < module.config.separation_distance && sep_dist > 0.1 {
                force_x = force_x + sep_x / sep_dist * 0.8
                force_y = force_y + sep_y / sep_dist * 0.8
            }
        }

        // 4. Move towards target if attacking
        if member.state == MemberState::ATTACKING && mob.target_id != 0 {
            let to_target_x = mob.target_position.x - member.position.x
            let to_target_y = mob.target_position.y - member.position.y
            let target_dist = sqrt(to_target_x * to_target_x + to_target_y * to_target_y)

            if target_dist > member.weapon_range {
                force_x = force_x + to_target_x / target_dist * 1.0
                force_y = force_y + to_target_y / target_dist * 1.0
            }
        }

        // 5. Flee away from enemies if fleeing
        if member.state == MemberState::FLEEING && mob.target_id != 0 {
            let away_x = member.position.x - mob.target_position.x
            let away_y = member.position.y - mob.target_position.y
            let away_dist = sqrt(away_x * away_x + away_y * away_y)

            if away_dist > 0.1 {
                force_x = force_x + away_x / away_dist * 1.5
                force_y = force_y + away_y / away_dist * 1.5
            }
        }

        // Apply forces to velocity
        let speed = member.move_speed * module.config.swarm_speed_bonus
        let force_mag = sqrt(force_x * force_x + force_y * force_y)

        if force_mag > 0.1 {
            member.velocity.x = force_x / force_mag * speed
            member.velocity.y = force_y / force_mag * speed
        }

        // Update position
        member.position.x = member.position.x + member.velocity.x * delta_time
        member.position.y = member.position.y + member.velocity.y * delta_time
    }
}

// ============================================================================
// Combat Functions
// ============================================================================

fn member_take_damage(module: MobMemberSlavedUpdateModule, unit_id: i64, damage: f32) {
    let member = module.members.get(unit_id)
    if member == null {
        return
    }

    member.health = member.health - damage
    member.anger_level = member.anger_level + module.config.anger_gain_rate
    if member.anger_level > 1.0 {
        member.anger_level = 1.0
    }

    if member.health <= 0.0 {
        member.health = 0.0
        member.state = MemberState::DEAD

        // Remove from mob
        for i in 0..module.mobs.count {
            remove_member(module, module.mobs.mob_ids[i], unit_id)
        }
    }
}

fn get_member_damage(module: MobMemberSlavedUpdateModule, unit_id: i64): f32 {
    let member = module.members.get(unit_id)
    if member == null {
        return 0.0
    }

    // Find mob for damage bonus
    let damage_bonus: f32 = 1.0
    for i in 0..module.mobs.count {
        let mob = module.mobs.mobs[i]
        for j in 0..mob.member_count {
            if mob.members[j] == unit_id {
                damage_bonus = mob.total_damage_bonus
                break
            }
        }
    }

    return member.weapon_damage * damage_bonus * (1.0 + member.anger_level * 0.5)
}

// ============================================================================
// Helper Functions
// ============================================================================

fn sqrt(x: f32): f32 {
    if x <= 0.0 { return 0.0 }
    let guess = x / 2.0
    for i in 0..10 {
        guess = (guess + x / guess) / 2.0
    }
    return guess
}

fn min_f32(a: f32, b: f32): f32 {
    if a < b { return a }
    return b
}

let random_seed: i64 = 12345

fn pseudo_random(): f32 {
    random_seed = random_seed * 1103515245 + 12345
    return (((random_seed >> 16) & 0x7FFF) as f32) / 32767.0
}

// ============================================================================
// Pre-built Configurations
// ============================================================================

fn create_default_mob_config(): MobConfig {
    return MobConfig::init()
}

fn create_angry_mob_config(): MobConfig {
    return MobConfig {
        max_mob_size: 15,
        min_mob_size: 5,
        recruitment_range: 150.0,
        cohesion_range: 40.0,
        separation_distance: 8.0,
        swarm_speed_bonus: 1.3,
        mob_damage_bonus: 1.15,
        max_damage_bonus: 2.5,
        flee_health_threshold: 0.15,
        rally_range: 30.0,
        target_switch_delay: 1.5,
        leader_influence_range: 75.0,
        anger_decay_rate: 0.02,
        anger_gain_rate: 0.5,
    }
}

fn create_terrorist_mob_config(): MobConfig {
    return MobConfig {
        max_mob_size: 8,
        min_mob_size: 2,
        recruitment_range: 80.0,
        cohesion_range: 30.0,
        separation_distance: 12.0,
        swarm_speed_bonus: 1.1,
        mob_damage_bonus: 1.2,
        max_damage_bonus: 2.0,
        flee_health_threshold: 0.1,
        rally_range: 30.0,
        target_switch_delay: 3.0,
        leader_influence_range: 75.0,
        anger_decay_rate: 0.01,
        anger_gain_rate: 0.8,
    }
}

// ============================================================================
// Tests
// ============================================================================

fn test_mob_member_slaved() {
    print("Testing Mob Member Slaved Update...")

    // Create module
    let config = create_default_mob_config()
    let module = MobMemberSlavedUpdateModule::init(config)

    // Create initial members
    let unit_ids: [i64] = [1, 2, 3, 4, 5]

    // Form mob
    let mob_id = form_mob(module, unit_ids, 5, 0)
    print("  Formed mob with ID: " + str(mob_id))

    // Set member positions
    for i in 0..5 {
        let member = module.members.get(unit_ids[i])
        if member != null {
            member.position = Vec3 {
                x: (i as f32) * 10.0,
                y: 0.0,
                z: 0.0,
            }
        }
    }

    // Add potential target
    add_potential_target(module, 100, Vec3 { x: 50.0, y: 50.0, z: 0.0 }, MobTargetType::BUILDING, 2.0)
    print("  Added potential target")

    // Update mob
    update_mob_module(module, 0.016)

    let mob = module.mobs.get(mob_id)
    if mob != null {
        print("  Mob center: (" + str(mob.center_position.x) + ", " + str(mob.center_position.y) + ")")
        print("  Member count: " + str(mob.member_count))
    }

    // Test damage
    member_take_damage(module, 1, 50.0)
    let damage = get_member_damage(module, 2)
    print("  Member 2 damage output: " + str(damage))

    // Recruit new member
    recruit_member(module, mob_id, 6)
    let mob2 = module.mobs.get(mob_id)
    if mob2 != null {
        print("  After recruitment, member count: " + str(mob2.member_count))
    }

    print("Mob Member Slaved Update tests complete!")
}
