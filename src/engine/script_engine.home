// ============================================================================
// TEST FUNCTIONS
// ============================================================================

fn test_script_engine() {
    print("Testing Script Engine...")

    // Create engine
    let engine = ScriptEngine::init()
    print("Script engine created")

    // Add a test waypoint
    let wp = Waypoint::init("StartPoint")
    wp.position_x = 100.0
    wp.position_y = 200.0
    wp.position_z = 0.0
    wp.waypoint_type = 1
    add_waypoint(engine, wp)
    print("Waypoint added")

    // Create a test script
    let script = Script::init("TestScript")
    script.is_enabled = true
    script.is_one_shot = true
    script.evaluation_interval = 0.5

    // Add condition: time elapsed 5 seconds
    script.conditions[0] = ScriptCondition::init(ConditionType::TimeElapsed)
    script.conditions[0].param_float1 = 5.0
    script.condition_count = 1

    // Add actions
    script.actions[0] = ScriptAction::init(ActionType::SetFlag)
    script.actions[0].param_int1 = 0

    script.actions[1] = ScriptAction::init(ActionType::ShowMessage)
    script.actions[1].param_string = "Script triggered!"
    script.actions[1].duration = 3.0
    script.action_count = 2

    add_script(engine, script)
    print("Script added")

    // Test flag operations
    engine.flags[0] = false
    print("Flag 0 initial: " + str(engine.flags[0]))

    // Simulate time passing
    for i in 0..100 {
        update_script_engine(engine, 0.1)  // 100ms per frame
    }

    print("After 10 seconds simulation:")
    print("Flag 0: " + str(engine.flags[0]))
    print("Script has_fired: " + str(engine.scripts[0].has_fired))

    // Test counters
    engine.counters[0] = 5
    print("Counter 0: " + str(engine.counters[0]))

    // Test timer
    engine.timer_active[0] = true
    update_script_engine(engine, 1.0)
    print("Timer 0 after 1 second: " + str(engine.timers[0]))

    print("Script Engine tests complete!")
}
