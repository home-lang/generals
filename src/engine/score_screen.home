fn render_awards_tab(ui: ScoreScreenUI, game: GameStats) {
    // Determine awards
    let highest_kills = 0
    let highest_kills_player = -1
    let highest_economy = 0
    let highest_economy_player = -1
    let highest_apm = 0.0
    let highest_apm_player = -1

    for i in 0..game.player_count {
        let stats = game.player_stats[i]

        if stats.units_killed > highest_kills {
            highest_kills = stats.units_killed
            highest_kills_player = i
        }

        if stats.supplies_collected > highest_economy {
            highest_economy = stats.supplies_collected
            highest_economy_player = i
        }

        if stats.average_apm > highest_apm {
            highest_apm = stats.average_apm
            highest_apm_player = i
        }
    }

    // Display awards:
    // - "Destroyer" - Most units killed
    // - "Economist" - Most resources collected
    // - "Commander" - Highest APM
}

fn render_stat_comparison_bar(game: GameStats, label: string, category: ScoreCategory) {
    let max_value = 1

    // Find max value
    for i in 0..game.player_count {
        let value = get_stat_value(game.player_stats[i], category)
        if value > max_value {
            max_value = value
        }
    }

    // Draw bars
    for i in 0..game.player_count {
        let value = get_stat_value(game.player_stats[i], category)
        let bar_width = value as f32 / max_value as f32 * 200.0
        // Draw bar with player color
    }
}

fn get_stat_value(stats: PlayerStats, category: ScoreCategory): i32 {
    if category == ScoreCategory::TotalScore {
        return stats.total_score
    } else if category == ScoreCategory::UnitsBuilt {
        return stats.units_built
    } else if category == ScoreCategory::UnitsLost {
        return stats.units_lost
    } else if category == ScoreCategory::UnitsKilled {
        return stats.units_killed
    } else if category == ScoreCategory::BuildingsBuilt {
        return stats.buildings_built
    } else if category == ScoreCategory::BuildingsLost {
        return stats.buildings_lost
    } else if category == ScoreCategory::BuildingsDestroyed {
        return stats.buildings_destroyed
    } else if category == ScoreCategory::SuppliesCollected {
        return stats.supplies_collected
    } else if category == ScoreCategory::SuppliesSpent {
        return stats.supplies_spent
    } else if category == ScoreCategory::GeneralsPointsEarned {
        return stats.general_points_earned
    } else if category == ScoreCategory::AbilitiesUsed {
        return stats.general_abilities_used
    } else if category == ScoreCategory::SuperweaponsLaunched {
        return stats.superweapons_launched
    }
    return 0
}

