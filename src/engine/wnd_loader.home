// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn is_digit(c: string): bool {
    return c >= "0" && c <= "9"
}

fn is_alpha(c: string): bool {
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z")
}

fn is_alphanumeric(c: string): bool {
    return is_digit(c) || is_alpha(c)
}

fn char_at(s: string, index: i32): string {
    // Would return character at index
    return ""
}

fn string_length(s: string): i32 {
    // Would return string length
    return 0
}

fn to_uppercase(s: string): string {
    // Would convert to uppercase
    return s
}

fn parse_int(s: string): i32 {
    // Would parse string to int
    return 0
}

// ============================================================================
// GLOBAL WND LOADER INSTANCE
// ============================================================================

let g_wnd_loader: WndLoader? = null

fn init_wnd_loader(): WndLoader {
    let loader = WndLoader::init()
    g_wnd_loader = loader
    return loader
}

fn get_wnd_loader(): WndLoader? {
    return g_wnd_loader
}

fn shutdown_wnd_loader() {
    g_wnd_loader = null
}

fn load_wnd_file(file_path: string): i32 {
    if g_wnd_loader != null {
        return g_wnd_loader.load_file(file_path)
    }
    return 0
}
