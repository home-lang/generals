// C&C Generals Zero Hour - Home Port
// WND Loader - Parses .wnd files to create window layouts
//
// Original: WndDraw and WndLoader from Thyme/SAGE engine
// Handles loading Window/Data/INI/*.wnd files for UI layouts
//
// WND files define the UI layout for Generals:
// - Main menu screens
// - In-game HUD
// - Dialog boxes
// - Options screens

let MAX_TOKENS: i32 = 8192
let MAX_PARENT_DEPTH: i32 = 32
let MAX_PARSE_ERRORS: i32 = 64
let MAX_LOADED_FILES: i32 = 256

// ============================================================================
// TOKEN TYPES
// ============================================================================

enum WndTokenType {
    NONE,
    IDENTIFIER,
    STRING,
    NUMBER,
    EQUALS,
    SEMICOLON,
    OPEN_BRACE,
    CLOSE_BRACE,
    COMMA,
    COLON,
}

struct WndToken {
    token_type: WndTokenType,
    value: string,
    line: i32,
}

impl WndToken {
    fn init(): WndToken {
        return WndToken {
            token_type: WndTokenType::NONE,
            value: "",
            line: 0,
        }
    }
}

// ============================================================================
// PARSER CONTEXT
// ============================================================================

struct WndParserContext {
    tokens: [WndToken],
    position: i32,
    current_window: i32,
    parent_stack: [i32],
    parent_depth: i32,
}

impl WndParserContext {
    fn init(): WndParserContext {
        return WndParserContext {
            tokens: [],
            position: 0,
            current_window: 0,
            parent_stack: [],
            parent_depth: 0,
        }
    }

    fn current_token(&self): WndToken? {
        if self.position < self.tokens.length {
            return self.tokens[self.position]
        }
        return null
    }

    fn advance(&self) {
        if self.position < self.tokens.length {
            self.position = self.position + 1
        }
    }

    fn push_parent(&self, window_id: i32) {
        if self.parent_depth < MAX_PARENT_DEPTH {
            self.parent_stack = self.parent_stack + [window_id]
            self.parent_depth = self.parent_depth + 1
        }
    }

    fn pop_parent(&self) {
        if self.parent_depth > 0 {
            self.parent_depth = self.parent_depth - 1
            // Remove last element
            let new_stack: [i32] = []
            for i in 0..self.parent_depth {
                new_stack = new_stack + [self.parent_stack[i]]
            }
            self.parent_stack = new_stack
        }
    }

    fn get_current_parent(&self): i32 {
        if self.parent_depth > 0 {
            return self.parent_stack[self.parent_depth - 1]
        }
        return 0
    }
}

// ============================================================================
// LOADED FILE CACHE ENTRY
// ============================================================================

struct LoadedFileEntry {
    file_path: string,
    root_window_id: i32,
}

// ============================================================================
// WND LOADER
// ============================================================================

struct WndLoader {
    // Screen resolution for scaling
    design_width: i32,
    design_height: i32,
    screen_width: i32,
    screen_height: i32,

    // Error tracking
    parse_errors: [string],

    // Loaded files cache
    loaded_files: [LoadedFileEntry],
}

impl WndLoader {
    fn init(): WndLoader {
        return WndLoader {
            design_width: 800,
            design_height: 600,
            screen_width: 800,
            screen_height: 600,
            parse_errors: [],
            loaded_files: [],
        }
    }

    fn set_screen_resolution(&self, width: i32, height: i32) {
        self.screen_width = width
        self.screen_height = height
    }

    fn set_design_resolution(&self, width: i32, height: i32) {
        self.design_width = width
        self.design_height = height
    }

    // ========================================================================
    // File Loading
    // ========================================================================

    fn load_file(&self, file_path: string): i32 {
        // Check cache
        for i in 0..self.loaded_files.length {
            if self.loaded_files[i].file_path == file_path {
                return self.loaded_files[i].root_window_id
            }
        }

        // Read file content (in actual implementation, would use file system)
        let content = self.read_file(file_path)
        if content == "" {
            self.add_error("Failed to read file: " + file_path)
            return 0
        }

        // Tokenize
        let tokens = self.tokenize(content)
        if tokens.length == 0 {
            self.add_error("Failed to tokenize file: " + file_path)
            return 0
        }

        // Parse
        let context = WndParserContext::init()
        context.tokens = tokens

        let root_id = self.parse(context)
        if root_id != 0 {
            self.loaded_files = self.loaded_files + [LoadedFileEntry {
                file_path: file_path,
                root_window_id: root_id,
            }]
        }

        return root_id
    }

    fn read_file(&self, file_path: string): string {
        // Placeholder - actual implementation would read from file system
        return ""
    }

    // ========================================================================
    // Tokenization
    // ========================================================================

    fn tokenize(&self, content: string): [WndToken] {
        let tokens: [WndToken] = []
        let i: i32 = 0
        let line: i32 = 1
        let len = string_length(content)

        while i < len {
            let c = char_at(content, i)

            // Skip whitespace
            if c == " " || c == "\t" || c == "\r" {
                i = i + 1
                continue
            }

            if c == "\n" {
                line = line + 1
                i = i + 1
                continue
            }

            // Skip single-line comments
            if c == ";" || (c == "/" && i + 1 < len && char_at(content, i + 1) == "/") {
                while i < len && char_at(content, i) != "\n" {
                    i = i + 1
                }
                continue
            }

            // Skip multi-line comments
            if c == "/" && i + 1 < len && char_at(content, i + 1) == "*" {
                i = i + 2
                while i + 1 < len {
                    if char_at(content, i) == "*" && char_at(content, i + 1) == "/" {
                        i = i + 2
                        break
                    }
                    if char_at(content, i) == "\n" {
                        line = line + 1
                    }
                    i = i + 1
                }
                continue
            }

            // String literals
            if c == "\"" {
                let value = ""
                i = i + 1
                while i < len && char_at(content, i) != "\"" {
                    value = value + char_at(content, i)
                    i = i + 1
                }
                i = i + 1  // Skip closing quote

                tokens = tokens + [WndToken {
                    token_type: WndTokenType::STRING,
                    value: value,
                    line: line,
                }]
                continue
            }

            // Operators
            if c == "=" {
                tokens = tokens + [WndToken {
                    token_type: WndTokenType::EQUALS,
                    value: "=",
                    line: line,
                }]
                i = i + 1
                continue
            }

            if c == ";" {
                tokens = tokens + [WndToken {
                    token_type: WndTokenType::SEMICOLON,
                    value: ";",
                    line: line,
                }]
                i = i + 1
                continue
            }

            if c == "{" {
                tokens = tokens + [WndToken {
                    token_type: WndTokenType::OPEN_BRACE,
                    value: "{",
                    line: line,
                }]
                i = i + 1
                continue
            }

            if c == "}" {
                tokens = tokens + [WndToken {
                    token_type: WndTokenType::CLOSE_BRACE,
                    value: "}",
                    line: line,
                }]
                i = i + 1
                continue
            }

            if c == "," {
                tokens = tokens + [WndToken {
                    token_type: WndTokenType::COMMA,
                    value: ",",
                    line: line,
                }]
                i = i + 1
                continue
            }

            if c == ":" {
                tokens = tokens + [WndToken {
                    token_type: WndTokenType::COLON,
                    value: ":",
                    line: line,
                }]
                i = i + 1
                continue
            }

            // Numbers
            if is_digit(c) || (c == "-" && i + 1 < len && is_digit(char_at(content, i + 1))) {
                let value = ""
                if c == "-" {
                    value = "-"
                    i = i + 1
                }
                while i < len {
                    let ch = char_at(content, i)
                    if is_digit(ch) || ch == "." {
                        value = value + ch
                        i = i + 1
                    } else {
                        break
                    }
                }

                tokens = tokens + [WndToken {
                    token_type: WndTokenType::NUMBER,
                    value: value,
                    line: line,
                }]
                continue
            }

            // Identifiers
            if is_alpha(c) || c == "_" {
                let value = ""
                while i < len {
                    let ch = char_at(content, i)
                    if is_alphanumeric(ch) || ch == "_" {
                        value = value + ch
                        i = i + 1
                    } else {
                        break
                    }
                }

                tokens = tokens + [WndToken {
                    token_type: WndTokenType::IDENTIFIER,
                    value: value,
                    line: line,
                }]
                continue
            }

            // Unknown character, skip
            i = i + 1
        }

        return tokens
    }

    // ========================================================================
    // Parsing
    // ========================================================================

    fn parse(&self, context: WndParserContext): i32 {
        let root_id: i32 = 0

        while context.position < context.tokens.length {
            let token = context.tokens[context.position]

            if token.value == "WINDOW" {
                let window_id = self.parse_window(context)
                if root_id == 0 {
                    root_id = window_id
                }
            } else if token.value == "FILE_VERSION" || token.value == "FILEVERSION" {
                self.skip_to_semicolon(context)
            } else if token.value == "LAYOUT_BLOCK" {
                self.skip_block(context)
            } else if token.value == "SHELL_MAP" || token.value == "FONT" || token.value == "BACKGROUND" {
                self.skip_to_semicolon(context)
            } else {
                context.advance()
            }
        }

        return root_id
    }

    fn parse_window(&self, context: WndParserContext): i32 {
        context.advance()  // Skip "WINDOW"

        // Get window name
        let name = self.expect_identifier(context)
        if name == "" {
            return 0
        }

        // Expect open brace
        if !self.expect_token_type(context, WndTokenType::OPEN_BRACE) {
            return 0
        }

        // Create window (would call window manager)
        let window_id = self.create_window(name)

        // Set parent if we have one
        let parent_id = context.get_current_parent()
        if parent_id != 0 {
            self.set_window_parent(window_id, parent_id)
        }

        // Push as current parent for children
        context.push_parent(window_id)

        // Parse properties
        while context.position < context.tokens.length {
            let token = context.tokens[context.position]

            if token.token_type == WndTokenType::CLOSE_BRACE {
                context.advance()
                break
            } else if token.token_type == WndTokenType::IDENTIFIER {
                self.parse_window_property(context, window_id)
            } else {
                context.advance()
            }
        }

        // Pop parent
        context.pop_parent()

        return window_id
    }

    fn parse_window_property(&self, context: WndParserContext, window_id: i32) {
        let prop_name = context.tokens[context.position].value
        context.advance()

        if prop_name == "WINDOWTYPE" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let type_name = self.expect_identifier(context)
            self.skip_to_semicolon(context)
            self.set_window_type(window_id, type_name)
        } else if prop_name == "SCREENRECT" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let rect = self.parse_rect(context)
            self.skip_to_semicolon(context)
            self.set_window_rect(window_id, rect)
        } else if prop_name == "STATUS" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let status = self.parse_status_flags(context)
            self.skip_to_semicolon(context)
            self.set_window_status(window_id, status)
        } else if prop_name == "STYLE" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let style = self.parse_status_flags(context)
            self.skip_to_semicolon(context)
            self.set_window_style(window_id, style)
        } else if prop_name == "TEXT" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let text = self.expect_string(context)
            self.skip_to_semicolon(context)
            self.set_window_text(window_id, text)
        } else if prop_name == "FONT" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let font_info = self.parse_font(context)
            self.skip_to_semicolon(context)
            self.set_window_font(window_id, font_info.name, font_info.size)
        } else if prop_name == "TEXTCOLOR" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let color = self.parse_color(context)
            self.skip_to_semicolon(context)
            self.set_window_text_color(window_id, color)
        } else if prop_name == "ENABLEDDRAWDATA" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let draw_data = self.parse_draw_data(context)
            self.skip_to_semicolon(context)
            self.set_window_enabled_draw(window_id, draw_data)
        } else if prop_name == "DISABLEDDRAWDATA" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let draw_data = self.parse_draw_data(context)
            self.skip_to_semicolon(context)
            self.set_window_disabled_draw(window_id, draw_data)
        } else if prop_name == "HILITEDRAWDATA" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let draw_data = self.parse_draw_data(context)
            self.skip_to_semicolon(context)
            self.set_window_hilite_draw(window_id, draw_data)
        } else if prop_name == "SYSTEMCALLBACK" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let callback = self.expect_string(context)
            self.skip_to_semicolon(context)
            self.set_window_system_callback(window_id, callback)
        } else if prop_name == "INPUTCALLBACK" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let callback = self.expect_string(context)
            self.skip_to_semicolon(context)
            self.set_window_input_callback(window_id, callback)
        } else if prop_name == "TOOLTIPCALLBACK" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let callback = self.expect_string(context)
            self.skip_to_semicolon(context)
            self.set_window_tooltip_callback(window_id, callback)
        } else if prop_name == "TOOLTIPTEXT" {
            self.expect_token_type(context, WndTokenType::EQUALS)
            let text = self.expect_string(context)
            self.skip_to_semicolon(context)
            self.set_window_tooltip_text(window_id, text)
        } else if prop_name == "CHILD" {
            // Nested window
            self.parse_window(context)
        } else if prop_name == "END" {
            self.skip_to_semicolon(context)
        } else {
            // Unknown property, skip
            self.skip_to_semicolon(context)
        }
    }

    // ========================================================================
    // Rect Parsing
    // ========================================================================

    struct WndRect {
        x: i32,
        y: i32,
        width: i32,
        height: i32,
    }

    fn parse_rect(&self, context: WndParserContext): WndRect {
        let rect = WndRect { x: 0, y: 0, width: 0, height: 0 }

        if context.position < context.tokens.length {
            let token = context.tokens[context.position]

            if token.value == "UPPERLEFT" {
                // New format: UPPERLEFT: x y, BOTTOMRIGHT: x y
                context.advance()  // UPPERLEFT
                self.expect_token_type(context, WndTokenType::COLON)
                let x1 = self.expect_number(context)
                let y1 = self.expect_number(context)
                self.expect_token_type(context, WndTokenType::COMMA)

                self.expect_identifier(context)  // BOTTOMRIGHT
                self.expect_token_type(context, WndTokenType::COLON)
                let x2 = self.expect_number(context)
                let y2 = self.expect_number(context)

                rect.x = x1
                rect.y = y1
                rect.width = x2 - x1
                rect.height = y2 - y1
            } else {
                // Old format: x y width height
                rect.x = self.expect_number(context)
                rect.y = self.expect_number(context)
                rect.width = self.expect_number(context)
                rect.height = self.expect_number(context)
            }
        }

        return rect
    }

    fn scale_rect(&self, rect: WndRect): WndRect {
        let scale_x = self.screen_width as f32 / self.design_width as f32
        let scale_y = self.screen_height as f32 / self.design_height as f32

        return WndRect {
            x: (rect.x as f32 * scale_x) as i32,
            y: (rect.y as f32 * scale_y) as i32,
            width: (rect.width as f32 * scale_x) as i32,
            height: (rect.height as f32 * scale_y) as i32,
        }
    }

    // ========================================================================
    // Status/Style Flags Parsing
    // ========================================================================

    fn parse_status_flags(&self, context: WndParserContext): i32 {
        let flags: i32 = 0

        while context.position < context.tokens.length {
            let token = context.tokens[context.position]

            if token.token_type == WndTokenType::IDENTIFIER {
                flags = flags | self.parse_single_status_flag(token.value)
                context.advance()
            } else if token.token_type == WndTokenType::SEMICOLON {
                break
            } else {
                context.advance()
            }
        }

        return flags
    }

    fn parse_single_status_flag(&self, flag: string): i32 {
        let upper = to_uppercase(flag)

        if upper == "ENABLED" { return 1 << 0 }
        if upper == "HIDDEN" { return 1 << 1 }
        if upper == "BORDER" { return 1 << 2 }
        if upper == "IMAGE" { return 1 << 3 }
        if upper == "NOINPUT" { return 1 << 4 }
        if upper == "SEETHRU" || upper == "SEE_THRU" { return 1 << 5 }
        if upper == "WRAPTEXT" || upper == "WRAP_CENTERED_TEXT" { return 1 << 6 }
        if upper == "NOFOCUS" || upper == "NO_FOCUS" { return 1 << 7 }
        if upper == "RIGHTCLICK" || upper == "RIGHT_CLICK" { return 1 << 8 }
        if upper == "CHECKLIKE" || upper == "CHECK_LIKE" { return 1 << 9 }
        if upper == "HOTKEYTEXT" || upper == "HOTKEY_TEXT" { return 1 << 10 }
        if upper == "DRAGABLE" || upper == "DRAGGABLE" { return 1 << 11 }
        if upper == "TABSTOP" || upper == "TAB_STOP" { return 1 << 12 }

        return 0
    }

    // ========================================================================
    // Font Parsing
    // ========================================================================

    struct FontInfo {
        name: string,
        size: i32,
    }

    fn parse_font(&self, context: WndParserContext): FontInfo {
        let font = FontInfo { name: "Arial", size: 12 }

        while context.position < context.tokens.length {
            let token = context.tokens[context.position]

            if token.token_type == WndTokenType::IDENTIFIER {
                let prop = token.value
                context.advance()

                if prop == "NAME" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    font.name = self.expect_string(context)
                } else if prop == "SIZE" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    font.size = self.expect_number(context)
                }
            } else if token.token_type == WndTokenType::SEMICOLON {
                break
            } else {
                context.advance()
            }
        }

        return font
    }

    // ========================================================================
    // Color Parsing
    // ========================================================================

    fn parse_color(&self, context: WndParserContext): i32 {
        let r: i32 = 255
        let g: i32 = 255
        let b: i32 = 255
        let a: i32 = 255

        while context.position < context.tokens.length {
            let token = context.tokens[context.position]

            if token.token_type == WndTokenType::IDENTIFIER {
                let prop = token.value
                context.advance()

                if prop == "R" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    r = self.expect_number(context)
                } else if prop == "G" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    g = self.expect_number(context)
                } else if prop == "B" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    b = self.expect_number(context)
                } else if prop == "A" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    a = self.expect_number(context)
                }
            } else if token.token_type == WndTokenType::SEMICOLON {
                break
            } else {
                context.advance()
            }
        }

        return (a << 24) | (r << 16) | (g << 8) | b
    }

    // ========================================================================
    // Draw Data Parsing
    // ========================================================================

    struct DrawData {
        image: string,
        color: i32,
        border_color: i32,
    }

    fn parse_draw_data(&self, context: WndParserContext): DrawData {
        let draw_data = DrawData { image: "", color: 0xFFFFFFFF, border_color: 0xFF000000 }

        while context.position < context.tokens.length {
            let token = context.tokens[context.position]

            if token.token_type == WndTokenType::IDENTIFIER {
                let prop = token.value
                context.advance()

                if prop == "IMAGE" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    draw_data.image = self.expect_string(context)
                } else if prop == "COLOR" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    draw_data.color = self.parse_color_inline(context)
                } else if prop == "BORDERCOLOR" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    draw_data.border_color = self.parse_color_inline(context)
                }
            } else if token.token_type == WndTokenType::SEMICOLON {
                break
            } else {
                context.advance()
            }
        }

        return draw_data
    }

    fn parse_color_inline(&self, context: WndParserContext): i32 {
        let r: i32 = 255
        let g: i32 = 255
        let b: i32 = 255
        let a: i32 = 255

        while context.position < context.tokens.length {
            let token = context.tokens[context.position]

            if token.token_type == WndTokenType::IDENTIFIER {
                let prop = token.value
                context.advance()

                if prop == "R" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    r = self.expect_number(context)
                } else if prop == "G" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    g = self.expect_number(context)
                } else if prop == "B" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    b = self.expect_number(context)
                } else if prop == "A" {
                    self.expect_token_type(context, WndTokenType::COLON)
                    a = self.expect_number(context)
                } else {
                    // Next property, stop parsing color
                    context.position = context.position - 1  // Put back the identifier
                    break
                }
            } else if token.token_type == WndTokenType::COMMA || token.token_type == WndTokenType::SEMICOLON {
                break
            } else {
                context.advance()
            }
        }

        return (a << 24) | (r << 16) | (g << 8) | b
    }

    // ========================================================================
    // Token Helpers
    // ========================================================================

    fn expect_token_type(&self, context: WndParserContext, expected: WndTokenType): bool {
        if context.position < context.tokens.length {
            let token = context.tokens[context.position]
            if token.token_type == expected {
                context.advance()
                return true
            }
        }
        return false
    }

    fn expect_identifier(&self, context: WndParserContext): string {
        if context.position < context.tokens.length {
            let token = context.tokens[context.position]
            if token.token_type == WndTokenType::IDENTIFIER {
                context.advance()
                return token.value
            }
        }
        return ""
    }

    fn expect_string(&self, context: WndParserContext): string {
        if context.position < context.tokens.length {
            let token = context.tokens[context.position]
            if token.token_type == WndTokenType::STRING {
                context.advance()
                return token.value
            }
        }
        return ""
    }

    fn expect_number(&self, context: WndParserContext): i32 {
        if context.position < context.tokens.length {
            let token = context.tokens[context.position]
            if token.token_type == WndTokenType::NUMBER {
                context.advance()
                return parse_int(token.value)
            }
        }
        return 0
    }

    fn skip_to_semicolon(&self, context: WndParserContext) {
        while context.position < context.tokens.length {
            let token = context.tokens[context.position]
            context.advance()

            if token.token_type == WndTokenType::SEMICOLON {
                break
            }
        }
    }

    fn skip_block(&self, context: WndParserContext) {
        let depth: i32 = 0

        while context.position < context.tokens.length {
            let token = context.tokens[context.position]
            context.advance()

            if token.token_type == WndTokenType::OPEN_BRACE {
                depth = depth + 1
            } else if token.token_type == WndTokenType::CLOSE_BRACE {
                depth = depth - 1
                if depth <= 0 {
                    break
                }
            }
        }
    }

    // ========================================================================
    // Error Handling
    // ========================================================================

    fn add_error(&self, msg: string) {
        if self.parse_errors.length < MAX_PARSE_ERRORS {
            self.parse_errors = self.parse_errors + [msg]
        }
    }

    fn get_error_count(&self): i32 {
        return self.parse_errors.length
    }

    fn get_error(&self, index: i32): string? {
        if index >= 0 && index < self.parse_errors.length {
            return self.parse_errors[index]
        }
        return null
    }

    fn clear_errors(&self) {
        self.parse_errors = []
    }

