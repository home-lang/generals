// PROCESSOR IMPLEMENTATIONS
// ============================================================================

fn process_texture(raw: *u8, size: i64, output: **anyopaque): bool {
    // Would parse TGA/DDS and create GPU texture
    output.* = raw as *anyopaque
    return true
}

fn unload_texture(data: *anyopaque) {
    // Would release GPU texture
}

fn process_model(raw: *u8, size: i64, output: **anyopaque): bool {
    // Would parse W3D and create renderable model
    output.* = raw as *anyopaque
    return true
}

fn unload_model(data: *anyopaque) {
    // Would free model data
}

fn get_model_dependencies(raw: *u8, size: i64, deps: *[AssetDependency; 16]): i32 {
    // Would parse W3D header to find texture dependencies
    return 0
}

fn process_animation(raw: *u8, size: i64, output: **anyopaque): bool {
    // Would parse W3D animation data
    output.* = raw as *anyopaque
    return true
}

fn unload_animation(data: *anyopaque) {
    // Would free animation data
}

// ============================================================================
// GLOBAL INSTANCE
// ============================================================================
var g_asset_loader: ?AssetLoader = null

// ============================================================================
// PUBLIC API
// ============================================================================

export fn init_asset_loader(allocator: Allocator) {
    g_asset_loader = AssetLoader.init(allocator)
}

export fn shutdown_asset_loader() {
    if g_asset_loader != null {
        g_asset_loader.?.deinit()
        g_asset_loader = null
    }
}

export fn update_asset_loader() {
    if g_asset_loader != null {
        g_asset_loader.?.update()
    }
}

export fn load_asset_async(
    name: string,
    asset_type: AssetType,
    priority: AssetLoadPriority,
    callback: ?AssetLoadCallback
): i32 {
    if g_asset_loader != null {
        return g_asset_loader.?.load_asset(name, asset_type, priority, callback, null)
    }
    return -1
}

export fn get_asset(name: string, asset_type: AssetType): ?*anyopaque {
    if g_asset_loader != null {
        return g_asset_loader.?.get_asset(name, asset_type)
    }
    return null
}

export fn release_asset(name: string, asset_type: AssetType) {
    if g_asset_loader != null {
        g_asset_loader.?.release_asset(name, asset_type)
    }
}

export fn asset_exists(name: string, asset_type: AssetType): bool {
    if g_asset_loader != null {
        return g_asset_loader.?.asset_exists(name, asset_type)
    }
    return false
}

export fn set_asset_memory_budget(budget: i64) {
    if g_asset_loader != null {
        g_asset_loader.?.set_memory_budget(budget)
    }
}

export fn get_asset_loader_stats(): ?AssetLoaderStats {
    if g_asset_loader != null {
        return g_asset_loader.?.get_statistics()
    }
    return null
}

export fn preload_assets(names: *[string; 64], count: i32, asset_type: AssetType) {
    if g_asset_loader != null {
        g_asset_loader.?.preload_assets(names, count, asset_type)
    }
}

export fn free_all_assets() {
    if g_asset_loader != null {
        g_asset_loader.?.free_all_assets()
    }
}

export fn release_unused_assets() {
    if g_asset_loader != null {
        g_asset_loader.?.release_unused_assets()
    }
}
