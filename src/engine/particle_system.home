// Particle System - Explosions, smoke, fire, tracers, debris for C&C Generals
// Implements authentic Generals visual effects

// ============================================================================
// PARTICLE TYPES
// ============================================================================

enum ParticleType {
    SMOKE,
    FIRE,
    SPARK,
    DEBRIS,
    DUST,
    EXPLOSION,
    TRACER,
    MUZZLE_FLASH,
    BLOOD,
    WATER_SPLASH,
    STEAM,
    TOXIN,
    RADIATION,
    LASER,
    CONTRAIL,
}

enum BlendMode {
    ALPHA,
    ADDITIVE,
    MULTIPLY,
    SCREEN,
}

// ============================================================================
// VECTOR TYPES
// ============================================================================

struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(): Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }

    fn new(x: f32, y: f32, z: f32): Vec3 {
        return Vec3 { x: x, y: y, z: z }
    }
}

struct Vec4 {
    x: f32,
    y: f32,
    z: f32,
    w: f32,
}

impl Vec4 {
    fn init(): Vec4 {
        return Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
    }

    fn new(x: f32, y: f32, z: f32, w: f32): Vec4 {
        return Vec4 { x: x, y: y, z: z, w: w }
    }
}

// ============================================================================
// PARTICLE STRUCTURE
// ============================================================================

struct Particle {
    // Position/velocity
    position: Vec3,
    velocity: Vec3,
    acceleration: Vec3,

    // Rotation
    rotation: f32,
    rotation_speed: f32,

    // Scale
    scale: f32,
    scale_velocity: f32,

    // Color/alpha
    color: Vec4,
    start_color: Vec4,
    end_color: Vec4,

    // Lifetime
    lifetime: f32,
    max_lifetime: f32,
    age_normalized: f32,

    // State
    is_alive: bool,
    texture_frame: i32,
}

impl Particle {
    fn init(): Particle {
        return Particle {
            position: Vec3::init(),
            velocity: Vec3::init(),
            acceleration: Vec3::init(),
            rotation: 0.0,
            rotation_speed: 0.0,
            scale: 1.0,
            scale_velocity: 0.0,
            color: Vec4::new(1.0, 1.0, 1.0, 1.0),
            start_color: Vec4::new(1.0, 1.0, 1.0, 1.0),
            end_color: Vec4::new(1.0, 1.0, 1.0, 0.0),
            lifetime: 0.0,
            max_lifetime: 1.0,
            age_normalized: 0.0,
            is_alive: false,
            texture_frame: 0,
        }
    }

    fn update(&self, delta_time: f32) {
        if !self.is_alive {
            return
        }

        // Update lifetime
        self.lifetime = self.lifetime + delta_time
        if self.lifetime >= self.max_lifetime {
            self.is_alive = false
            return
        }

        self.age_normalized = self.lifetime / self.max_lifetime

        // Update velocity
        self.velocity.x = self.velocity.x + self.acceleration.x * delta_time
        self.velocity.y = self.velocity.y + self.acceleration.y * delta_time
        self.velocity.z = self.velocity.z + self.acceleration.z * delta_time

        // Update position
        self.position.x = self.position.x + self.velocity.x * delta_time
        self.position.y = self.position.y + self.velocity.y * delta_time
        self.position.z = self.position.z + self.velocity.z * delta_time

        // Update rotation
        self.rotation = self.rotation + self.rotation_speed * delta_time

        // Update scale
        self.scale = self.scale + self.scale_velocity * delta_time

        // Interpolate color
        let t = self.age_normalized
        self.color.x = self.start_color.x + (self.end_color.x - self.start_color.x) * t
        self.color.y = self.start_color.y + (self.end_color.y - self.start_color.y) * t
        self.color.z = self.start_color.z + (self.end_color.z - self.start_color.z) * t
        self.color.w = self.start_color.w + (self.end_color.w - self.start_color.w) * t
    }
}

// ============================================================================
// EMITTER CONFIGURATION
// ============================================================================

struct EmitterConfig {
    particle_type: ParticleType,
    texture_id: i32,
    blend_mode: BlendMode,

    // Spawn
    spawn_rate: f32,         // Particles per second
    burst_count: i32,        // Initial burst
    max_particles: i32,

    // Lifetime
    lifetime_min: f32,
    lifetime_max: f32,

    // Position
    spawn_offset: Vec3,
    spawn_radius: f32,
    spawn_cone_angle: f32,

    // Velocity
    velocity_min: Vec3,
    velocity_max: Vec3,
    inherit_velocity: f32,

    // Acceleration
    gravity: f32,
    drag: f32,

    // Rotation
    rotation_min: f32,
    rotation_max: f32,
    rotation_speed_min: f32,
    rotation_speed_max: f32,

    // Scale
    scale_min: f32,
    scale_max: f32,
    scale_over_life: f32,

    // Color
    start_color: Vec4,
    end_color: Vec4,
    color_variance: f32,

    // Animation
    frame_count: i32,
    frame_rate: f32,
    random_start_frame: bool,
}

impl EmitterConfig {
    fn init(): EmitterConfig {
        return EmitterConfig {
            particle_type: ParticleType::SMOKE,
            texture_id: -1,
            blend_mode: BlendMode::ALPHA,
            spawn_rate: 10.0,
            burst_count: 0,
            max_particles: 100,
            lifetime_min: 1.0,
            lifetime_max: 2.0,
            spawn_offset: Vec3::init(),
            spawn_radius: 1.0,
            spawn_cone_angle: 0.0,
            velocity_min: Vec3::init(),
            velocity_max: Vec3::init(),
            inherit_velocity: 0.0,
            gravity: 0.0,
            drag: 0.0,
            rotation_min: 0.0,
            rotation_max: 0.0,
            rotation_speed_min: 0.0,
            rotation_speed_max: 0.0,
            scale_min: 1.0,
            scale_max: 1.0,
            scale_over_life: 0.0,
            start_color: Vec4::new(1.0, 1.0, 1.0, 1.0),
            end_color: Vec4::new(1.0, 1.0, 1.0, 0.0),
            color_variance: 0.0,
            frame_count: 1,
            frame_rate: 0.0,
            random_start_frame: false,
        }
    }

    fn smoke(): EmitterConfig {
        return EmitterConfig {
            particle_type: ParticleType::SMOKE,
            texture_id: -1,
            blend_mode: BlendMode::ALPHA,
            spawn_rate: 20.0,
            burst_count: 0,
            max_particles: 100,
            lifetime_min: 2.0,
            lifetime_max: 4.0,
            spawn_offset: Vec3::init(),
