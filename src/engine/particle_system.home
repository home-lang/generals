            spawn_cone_angle: 30.0,
            velocity_min: Vec3::new(-5.0, 10.0, -5.0),
            velocity_max: Vec3::new(5.0, 20.0, 5.0),
            inherit_velocity: 0.0,
            gravity: 0.0,
            drag: 0.5,
            rotation_min: 0.0,
