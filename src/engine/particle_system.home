// ============================================================================
// PARTICLE EMITTER
// ============================================================================

let MAX_PARTICLES_PER_EMITTER: i32 = 256

struct ParticleEmitter {
    id: i32,
    config: EmitterConfig,
    particles: [Particle],
    particle_count: i32,
    active_count: i32,

    // Position
    position: Vec3,
    velocity: Vec3,
    rotation: f32,

    // State
    is_active: bool,
    spawn_accumulator: f32,
    time_alive: f32,
    duration: f32,          // 0 = infinite

    // Pool management
    next_free: i32,
}

impl ParticleEmitter {
    fn init(id: i32, config: EmitterConfig, position: Vec3): ParticleEmitter {
        // Initialize particle pool
        let particles: [Particle] = []
        for i in 0..MAX_PARTICLES_PER_EMITTER {
            particles = particles + [Particle::init()]
        }

        let emitter = ParticleEmitter {
            id: id,
            config: config,
            particles: particles,
            particle_count: MAX_PARTICLES_PER_EMITTER,
            active_count: 0,
            position: position,
            velocity: Vec3::init(),
            rotation: 0.0,
            is_active: true,
            spawn_accumulator: 0.0,
            time_alive: 0.0,
            duration: 0.0,
            next_free: 0,
        }

        // Initial burst
        if config.burst_count > 0 {
            for i in 0..config.burst_count {
                emitter.spawn_particle()
            }
        }

        return emitter
    }

    fn spawn_particle(&self) {
        if self.active_count >= self.config.max_particles {
            return
        }

        // Find free slot
        let slot = -1
        for i in 0..self.particle_count {
            if !self.particles[i].is_alive {
                slot = i
                break
            }
        }

        if slot < 0 {
            return
        }

        let config = self.config

        // Initialize particle
        let p = self.particles[slot]
        p.is_alive = true
        p.lifetime = 0.0
        p.max_lifetime = random_range(config.lifetime_min, config.lifetime_max)
        p.age_normalized = 0.0

        // Position with random offset in cone
        let angle = random_float() * 6.28318
        let radius = random_float() * config.spawn_radius
        p.position.x = self.position.x + config.spawn_offset.x + cos(angle) * radius
        p.position.y = self.position.y + config.spawn_offset.y
        p.position.z = self.position.z + config.spawn_offset.z + sin(angle) * radius

        // Velocity
        p.velocity.x = random_range(config.velocity_min.x, config.velocity_max.x)
        p.velocity.y = random_range(config.velocity_min.y, config.velocity_max.y)
        p.velocity.z = random_range(config.velocity_min.z, config.velocity_max.z)

        // Inherit emitter velocity
        p.velocity.x = p.velocity.x + self.velocity.x * config.inherit_velocity
        p.velocity.y = p.velocity.y + self.velocity.y * config.inherit_velocity
        p.velocity.z = p.velocity.z + self.velocity.z * config.inherit_velocity

        // Acceleration (gravity)
        p.acceleration = Vec3::new(0.0, -config.gravity, 0.0)

        // Rotation
        p.rotation = random_range(config.rotation_min, config.rotation_max)
        p.rotation_speed = random_range(config.rotation_speed_min, config.rotation_speed_max)

        // Scale
        p.scale = random_range(config.scale_min, config.scale_max)
        p.scale_velocity = config.scale_over_life

        // Color with variance
        let variance = (random_float() - 0.5) * 2.0 * config.color_variance
        p.start_color = Vec4::new(
            clamp(config.start_color.x + variance, 0.0, 1.0),
            clamp(config.start_color.y + variance, 0.0, 1.0),
            clamp(config.start_color.z + variance, 0.0, 1.0),
            config.start_color.w
        )
        p.end_color = config.end_color
        p.color = p.start_color

        // Animation frame
        if config.random_start_frame && config.frame_count > 1 {
            p.texture_frame = cast(i32, random_float() * cast(f32, config.frame_count))
        } else {
            p.texture_frame = 0
        }

        self.active_count = self.active_count + 1
    }

    fn update(&self, delta_time: f32) {
        if !self.is_active {
            return
        }

        self.time_alive = self.time_alive + delta_time

        // Check duration
        if self.duration > 0.0 && self.time_alive >= self.duration {
            self.is_active = false
        }

        // Spawn new particles
        if self.config.spawn_rate > 0.0 && self.is_active {
            self.spawn_accumulator = self.spawn_accumulator + self.config.spawn_rate * delta_time

            while self.spawn_accumulator >= 1.0 {
                self.spawn_particle()
                self.spawn_accumulator = self.spawn_accumulator - 1.0
            }
        }

        // Update particles
        self.active_count = 0
        for i in 0..self.particle_count {
            if self.particles[i].is_alive {
                // Apply drag
                let drag = self.config.drag
                self.particles[i].velocity.x = self.particles[i].velocity.x * (1.0 - drag * delta_time)
                self.particles[i].velocity.y = self.particles[i].velocity.y * (1.0 - drag * delta_time)
                self.particles[i].velocity.z = self.particles[i].velocity.z * (1.0 - drag * delta_time)

                self.particles[i].update(delta_time)

                if self.particles[i].is_alive {
                    self.active_count = self.active_count + 1
                }
            }
        }
    }

    fn stop(&self) {
        self.is_active = false
    }

    fn kill_all(&self) {
        for i in 0..self.particle_count {
            self.particles[i].is_alive = false
        }
        self.active_count = 0
    }
}

// ============================================================================
// PARTICLE SYSTEM MANAGER
// ============================================================================

let MAX_EMITTERS: i32 = 128

struct ParticleSystem {
    emitters: [ParticleEmitter],
    emitter_count: i32,
    next_emitter_id: i32,

    // Stats
    total_particles: i32,
    total_draw_calls: i32,
}

impl ParticleSystem {
    fn init(): ParticleSystem {
        return ParticleSystem {
            emitters: [],
            emitter_count: 0,
            next_emitter_id: 1,
            total_particles: 0,
            total_draw_calls: 0,
        }
    }

    fn spawn_effect(&self, effect_type: ParticleType, position: Vec3): i32 {
        if self.emitter_count >= MAX_EMITTERS {
            return -1
        }

        let config: EmitterConfig
        if effect_type == ParticleType::SMOKE {
            config = EmitterConfig::smoke()
        } else if effect_type == ParticleType::FIRE {
            config = EmitterConfig::fire()
        } else if effect_type == ParticleType::EXPLOSION {
            config = EmitterConfig::explosion()
        } else if effect_type == ParticleType::DEBRIS {
            config = EmitterConfig::debris()
        } else if effect_type == ParticleType::TRACER {
            config = EmitterConfig::tracer()
        } else if effect_type == ParticleType::TOXIN {
            config = EmitterConfig::toxin()
        } else {
            config = EmitterConfig::smoke()
        }

        let emitter = ParticleEmitter::init(self.next_emitter_id, config, position)
        self.emitters = self.emitters + [emitter]
        self.emitter_count = self.emitter_count + 1
        self.next_emitter_id = self.next_emitter_id + 1

        return emitter.id
    }

    fn spawn_explosion(&self, position: Vec3, size: f32): i32 {
        // Spawn multiple effects for big explosion
        let explosion_id = self.spawn_effect(ParticleType::EXPLOSION, position)
        self.spawn_effect(ParticleType::SMOKE, position)
        self.spawn_effect(ParticleType::DEBRIS, position)

        return explosion_id
    }

    fn update(&self, delta_time: f32) {
        self.total_particles = 0

        let i = 0
        while i < self.emitter_count {
            self.emitters[i].update(delta_time)
            self.total_particles = self.total_particles + self.emitters[i].active_count

            // Remove dead emitters with no particles
            if !self.emitters[i].is_active && self.emitters[i].active_count == 0 {
                // Remove by swapping with last
                if i < self.emitter_count - 1 {
                    self.emitters[i] = self.emitters[self.emitter_count - 1]
                }
                self.emitter_count = self.emitter_count - 1
            } else {
                i = i + 1
            }
        }
    }

    fn stop_all(&self) {
        for i in 0..self.emitter_count {
            self.emitters[i].stop()
        }
    }

    fn get_emitter_index(&self, id: i32): i32 {
        for i in 0..self.emitter_count {
            if self.emitters[i].id == id {
                return i
            }
        }
        return -1
    }

    fn get_emitter(&self, id: i32): ParticleEmitter? {
        let idx = self.get_emitter_index(id)
        if idx >= 0 {
            return self.emitters[idx]
        }
        return null
    }
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

let g_random_seed: i32 = 12345

fn random_float(): f32 {
    g_random_seed = g_random_seed * 1103515245 + 12345
    let val = g_random_seed
    if val < 0 {
        val = -val
    }
    return cast(f32, val % 10000) / 10000.0
}

fn random_range(min: f32, max: f32): f32 {
    return min + random_float() * (max - min)
}

fn clamp(x: f32, min: f32, max: f32): f32 {
    if x < min {
        return min
    }
    if x > max {
        return max
    }
    return x
}

fn sin(x: f32): f32 {
    let x_norm = x
    while x_norm > 3.14159 {
        x_norm = x_norm - 6.28318
    }
    while x_norm < -3.14159 {
        x_norm = x_norm + 6.28318
    }
    let x2 = x_norm * x_norm
    let x3 = x2 * x_norm
    let x5 = x3 * x2
    return x_norm - x3 / 6.0 + x5 / 120.0
}

fn cos(x: f32): f32 {
    return sin(x + 1.5708)
}

// ============================================================================
// GLOBAL PARTICLE SYSTEM INSTANCE
// ============================================================================

let g_particle_system: ParticleSystem? = null

fn init_particle_system(): ParticleSystem {
    let ps = ParticleSystem::init()
    g_particle_system = ps
    return ps
}

fn get_particle_system(): ParticleSystem? {
    return g_particle_system
}

fn shutdown_particle_system() {
    if g_particle_system != null {
        g_particle_system.stop_all()
        g_particle_system = null
    }
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

fn test_particle_system() {
    print("Testing Particle System...")

    // Create system
    let ps = init_particle_system()
    print("Particle system created")

    // Spawn effects
    let smoke_id = ps.spawn_effect(ParticleType::SMOKE, Vec3::new(0.0, 0.0, 0.0))
    print("Spawned smoke emitter: " + str(smoke_id))

    let fire_id = ps.spawn_effect(ParticleType::FIRE, Vec3::new(10.0, 0.0, 0.0))
    print("Spawned fire emitter: " + str(fire_id))

    let explosion_id = ps.spawn_explosion(Vec3::new(20.0, 0.0, 0.0), 1.0)
    print("Spawned explosion: " + str(explosion_id))

    print("Total emitters: " + str(ps.emitter_count))

    // Update
    for frame in 0..60 {
        ps.update(0.016)
    }
    print("After 1 second: " + str(ps.total_particles) + " particles")

    // Test configs
    let smoke_config = EmitterConfig::smoke()
    print("Smoke lifetime: " + str(smoke_config.lifetime_min) + "-" + str(smoke_config.lifetime_max) + "s")

    let toxin_config = EmitterConfig::toxin()
    print("Toxin color: green")

    // Test individual particle
    let p = Particle::init()
    p.is_alive = true
    p.max_lifetime = 2.0
    p.velocity = Vec3::new(10.0, 20.0, 0.0)
    p.acceleration = Vec3::new(0.0, -50.0, 0.0)

    for i in 0..10 {
        p.update(0.1)
    }
    print("Particle after 1s: pos=" + str(p.position.x) + "," + str(p.position.y))
    print("Age: " + str(p.age_normalized * 100.0) + "%")

    shutdown_particle_system()
    print("Particle System tests complete!")
}
