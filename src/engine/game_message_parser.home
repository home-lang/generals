// Game Message Parser - Network command parsing and validation
// Handles serialization and deserialization of game commands for multiplayer sync

// ============================================================================
// Message Types
// ============================================================================

enum GameMessageType {
    // Connection messages
    CONNECT,
    DISCONNECT,
    HEARTBEAT,
    SYNC,

    // Game state messages
    GAME_START,
    GAME_PAUSE,
    GAME_RESUME,
    GAME_END,

    // Player commands
    UNIT_MOVE,
    UNIT_ATTACK,
    UNIT_STOP,
    UNIT_GUARD,
    UNIT_PATROL,
    UNIT_ABILITY,
    UNIT_FORMATION,
    UNIT_STANCE,

    // Building commands
    BUILD_STRUCTURE,
    CANCEL_BUILD,
    SELL_STRUCTURE,
    REPAIR_STRUCTURE,
    SET_RALLY_POINT,

    // Production commands
    PRODUCE_UNIT,
    CANCEL_PRODUCTION,
    QUEUE_UPGRADE,
    CANCEL_UPGRADE,

    // Special powers
    ACTIVATE_POWER,
    SELECT_POWER,

    // Economy
    TRANSFER_CREDITS,

    // Chat
    CHAT_MESSAGE,
    TEAM_MESSAGE,

    // Sync/validation
    CHECKSUM,
    DESYNC_REPORT,
    STATE_REQUEST,
    STATE_RESPONSE,
}

fn message_type_to_int(msg_type: GameMessageType): i32 {
    if msg_type == GameMessageType::CONNECT { return 0 }
    if msg_type == GameMessageType::DISCONNECT { return 1 }
    if msg_type == GameMessageType::HEARTBEAT { return 2 }
    if msg_type == GameMessageType::SYNC { return 3 }
    if msg_type == GameMessageType::GAME_START { return 10 }
    if msg_type == GameMessageType::GAME_PAUSE { return 11 }
    if msg_type == GameMessageType::GAME_RESUME { return 12 }
    if msg_type == GameMessageType::GAME_END { return 13 }
    if msg_type == GameMessageType::UNIT_MOVE { return 20 }
    if msg_type == GameMessageType::UNIT_ATTACK { return 21 }
    if msg_type == GameMessageType::UNIT_STOP { return 22 }
    if msg_type == GameMessageType::UNIT_GUARD { return 23 }
    if msg_type == GameMessageType::UNIT_PATROL { return 24 }
    if msg_type == GameMessageType::UNIT_ABILITY { return 25 }
    if msg_type == GameMessageType::UNIT_FORMATION { return 26 }
    if msg_type == GameMessageType::UNIT_STANCE { return 27 }
    if msg_type == GameMessageType::BUILD_STRUCTURE { return 30 }
    if msg_type == GameMessageType::CANCEL_BUILD { return 31 }
    if msg_type == GameMessageType::SELL_STRUCTURE { return 32 }
    if msg_type == GameMessageType::REPAIR_STRUCTURE { return 33 }
    if msg_type == GameMessageType::SET_RALLY_POINT { return 34 }
    if msg_type == GameMessageType::PRODUCE_UNIT { return 40 }
    if msg_type == GameMessageType::CANCEL_PRODUCTION { return 41 }
    if msg_type == GameMessageType::QUEUE_UPGRADE { return 42 }
    if msg_type == GameMessageType::CANCEL_UPGRADE { return 43 }
    if msg_type == GameMessageType::ACTIVATE_POWER { return 50 }
    if msg_type == GameMessageType::SELECT_POWER { return 51 }
    if msg_type == GameMessageType::TRANSFER_CREDITS { return 60 }
    if msg_type == GameMessageType::CHAT_MESSAGE { return 70 }
    if msg_type == GameMessageType::TEAM_MESSAGE { return 71 }
    if msg_type == GameMessageType::CHECKSUM { return 80 }
    if msg_type == GameMessageType::DESYNC_REPORT { return 81 }
    if msg_type == GameMessageType::STATE_REQUEST { return 82 }
    if msg_type == GameMessageType::STATE_RESPONSE { return 83 }
    return 0
}

fn int_to_message_type(value: i32): GameMessageType {
    if value == 0 { return GameMessageType::CONNECT }
    if value == 1 { return GameMessageType::DISCONNECT }
    if value == 2 { return GameMessageType::HEARTBEAT }
    if value == 3 { return GameMessageType::SYNC }
    if value == 10 { return GameMessageType::GAME_START }
    if value == 20 { return GameMessageType::UNIT_MOVE }
    if value == 21 { return GameMessageType::UNIT_ATTACK }
    if value == 22 { return GameMessageType::UNIT_STOP }
    if value == 25 { return GameMessageType::UNIT_ABILITY }
    if value == 30 { return GameMessageType::BUILD_STRUCTURE }
    if value == 40 { return GameMessageType::PRODUCE_UNIT }
    if value == 50 { return GameMessageType::ACTIVATE_POWER }
    if value == 70 { return GameMessageType::CHAT_MESSAGE }
    if value == 80 { return GameMessageType::CHECKSUM }
    return GameMessageType::HEARTBEAT
}

// ============================================================================
// Message Header
// ============================================================================

struct MessageHeader {
    message_type: GameMessageType,
    player_id: i32,
    frame_number: i32,
    sequence: i32,
    payload_size: i32,
    checksum: i32,
}

impl MessageHeader {
    fn init(msg_type: GameMessageType, player_id: i32, frame: i32): MessageHeader {
        return MessageHeader {
            message_type: msg_type,
            player_id: player_id,
            frame_number: frame,
            sequence: 0,
            payload_size: 0,
            checksum: 0,
        }
    }
}

// ============================================================================
// Command Payloads
// ============================================================================

struct UnitMoveCommand {
    unit_ids: [i64],
    unit_count: i32,
    target_x: f32,
    target_y: f32,
    target_z: f32,
    formation: i32,
    queued: bool,
    attack_move: bool,
}

impl UnitMoveCommand {
    fn init(): UnitMoveCommand {
        let ids: [i64] = []
        for i in 0..32 {
            ids = ids + [0]
        }
        return UnitMoveCommand {
            unit_ids: ids,
            unit_count: 0,
            target_x: 0.0,
            target_y: 0.0,
            target_z: 0.0,
            formation: 0,
            queued: false,
            attack_move: false,
        }
    }
}

