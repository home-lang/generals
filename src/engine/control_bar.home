// Control Bar - Main in-game UI panel at bottom of screen
// Implements the C&C Generals control bar with command buttons, unit info, etc.

let MAX_COMMAND_BUTTONS: i32 = 18  // 6x3 grid
let MAX_SELECTION_CAMEOS: i32 = 20
let MAX_QUEUE_SLOTS: i32 = 9
let MAX_PREREQUISITE_OBJECTS: i32 = 4

// Control bar stages (different UI modes)
enum ControlBarStage {
    DEFAULT,           // Normal selection mode
    SINGLE_SELECTION,  // One unit selected
    MULTI_SELECTION,   // Multiple units selected
    BUILDING_PLACEMENT, // Placing a building
    SUPERWEAPON_TARGET, // Targeting a superweapon
    SELL_MODE,          // Selling structures
    REPAIR_MODE,        // Repairing structures
    POWER_MODE,         // Power toggle mode
}

// Command button types
enum CommandButtonType {
    NONE,
    DOZER_CONSTRUCT,
    DOZER_CONSTRUCT_CANCEL,
    UNIT_BUILD,
    UNIT_BUILD_CANCEL,
    UPGRADE,
    UPGRADE_CANCEL,
    SPECIAL_POWER,
    SPECIAL_POWER_FROM_SELF,
    SPECIAL_POWER_FROM_COMMAND_CENTER,
    OBJECT_UPGRADE,
    PLAYER_UPGRADE,
    EXIT_CONTAINER,
    EVACUATE,
    EVACUATE_CONTAINER,
    EXECUTE_RAILED_TRANSPORT,
    COMBAT_DROP,
    GUARD,
    GUARD_FLYOVER,
    ATTACK_MOVE,
    STOP,
    SCATTER,
    SET_RALLY_POINT,
    SELL,
    CANCEL_CONSTRUCTION,
    TOGGLE_POWER,
    TOGGLE_WEAPON,
    CONVERT_TO_CAR_BOMB,
    CONVERT_TO_MOB_SPEAKER,
    HIJACK,
    HACK_INTERNET,
    SABOTAGE,
    SNEAK_ATTACK,
    TOGGLE_STEALTH_MODE,
    CHEER_ATTACK,
    DEFECT,
    CAPTURE_BUILDING,
    DISARM_MINE_DEFECT,
    BOOBY_TRAP,
    REMOVE_BOOBY_TRAP,
    FIRE_WEAPON,
    SWITCH_WEAPON,
    DOCK,
    SELECT_ALL,
    FORMATION_MOVE,
    SPECIAL_MOVE,
    EMPTY_ALL_CONTAINERS_AT_ONCE,
    FORCE_ATTACK,
}

// Single command button
struct CommandButton {
    button_type: CommandButtonType,
    name: string,
    display_name: string,
    button_image: string,
    button_border_type: string,
    cursor_name: string,
    invalid_cursor_name: string,

    // Associated data
    object_name: string,       // For build commands
    upgrade_name: string,      // For upgrade commands
    special_power_name: string, // For special power commands
    science_name: string,      // For science requirements

    // Requirements
    required_upgrade: string,
    conflicting_upgrade: string,
    required_science: string,
    prerequisite_objects: [string],
    prerequisite_count: i32,

    // UI state
    is_enabled: bool,
    is_visible: bool,
    is_purchasable: bool,
    cooldown_percent: f32,
    build_progress: f32,

    // Position
    slot_row: i32,
    slot_column: i32,

    is_valid: bool,
}

impl CommandButton {
    fn init(): CommandButton {
        return CommandButton {
            button_type: CommandButtonType::NONE,
            name: "",
            display_name: "",
            button_image: "",
            button_border_type: "",
            cursor_name: "",
            invalid_cursor_name: "",
            object_name: "",
            upgrade_name: "",
            special_power_name: "",
            science_name: "",
            required_upgrade: "",
            conflicting_upgrade: "",
            required_science: "",
            prerequisite_objects: [],
            prerequisite_count: 0,
            is_enabled: false,
            is_visible: false,
            is_purchasable: false,
            cooldown_percent: 1.0,
            build_progress: 0.0,
            slot_row: 0,
            slot_column: 0,
            is_valid: false,
        }
    }
}

// Cameo (unit portrait) in selection display
struct SelectionCameo {
    thing_id: i32,
    portrait_image: string,
    health_percent: f32,
    veterancy_level: i32,
    is_selected: bool,
    is_valid: bool,
}

impl SelectionCameo {
    fn init(): SelectionCameo {
        return SelectionCameo {
            thing_id: 0,
            portrait_image: "",
            health_percent: 1.0,
            veterancy_level: 0,
            is_selected: false,
            is_valid: false,
        }
    }
}

// Build queue slot
struct QueueSlot {
    object_name: string,
    portrait_image: string,
    build_progress: f32,
    queue_position: i32,
    is_paused: bool,
    is_valid: bool,
}

impl QueueSlot {
    fn init(): QueueSlot {
        return QueueSlot {
            object_name: "",
            portrait_image: "",
            build_progress: 0.0,
            queue_position: 0,
            is_paused: false,
            is_valid: false,
        }
    }
}

// Control bar layout regions
struct ControlBarRegion {
    x: f32,
    y: f32,
    width: f32,
    height: f32,
}

impl ControlBarRegion {
    fn init(): ControlBarRegion {
        return ControlBarRegion {
            x: 0.0,
            y: 0.0,
            width: 0.0,
            height: 0.0,
        }
    }
}

// Main control bar structure
struct ControlBar {
    // Current state
    stage: ControlBarStage,
    is_visible: bool,

    // Command buttons grid (3 rows x 6 columns)
    command_buttons: [CommandButton],
    active_button_count: i32,

    // Selection display
    selection_cameos: [SelectionCameo],
    selection_count: i32,
    primary_selection: i32,

    // Build queue display
    queue_slots: [QueueSlot],
    queue_count: i32,

    // Unit info panel
    unit_name: string,
    unit_health: f32,
    unit_max_health: f32,
    unit_portrait: string,
    unit_veterancy: i32,

    // Resource display
    money: i32,
    power_produced: i32,
    power_consumed: i32,

    // Layout regions
    command_panel_region: ControlBarRegion,
    selection_region: ControlBarRegion,
    info_panel_region: ControlBarRegion,
    minimap_region: ControlBarRegion,
    resource_region: ControlBarRegion,

    // Interaction state
    hovered_button: i32,
    pressed_button: i32,
    tooltip_text: string,
    tooltip_visible: bool,

    is_initialized: bool,
}

impl ControlBar {
    fn init(): ControlBar {
        let bar = ControlBar {
            stage: ControlBarStage::DEFAULT,
            is_visible: true,
            command_buttons: [],
            active_button_count: 0,
            selection_cameos: [],
            selection_count: 0,
            primary_selection: 0,
            queue_slots: [],
            queue_count: 0,
            unit_name: "",
            unit_health: 0.0,
            unit_max_health: 0.0,
            unit_portrait: "",
            unit_veterancy: 0,
            money: 0,
            power_produced: 0,
            power_consumed: 0,
            command_panel_region: ControlBarRegion::init(),
            selection_region: ControlBarRegion::init(),
            info_panel_region: ControlBarRegion::init(),
            minimap_region: ControlBarRegion::init(),
            resource_region: ControlBarRegion::init(),
            hovered_button: -1,
            pressed_button: -1,
            tooltip_text: "",
            tooltip_visible: false,
            is_initialized: true,
        }

        // Initialize button and cameo arrays
        for i in 0..MAX_COMMAND_BUTTONS {
            bar.command_buttons = bar.command_buttons + [CommandButton::init()]
        }
        for i in 0..MAX_SELECTION_CAMEOS {
            bar.selection_cameos = bar.selection_cameos + [SelectionCameo::init()]
        }
        for i in 0..MAX_QUEUE_SLOTS {
            bar.queue_slots = bar.queue_slots + [QueueSlot::init()]
        }

        bar.setup_layout()

        return bar
    }

    fn setup_layout(&self) {
        // Standard C&C Generals control bar layout
        // Total bar: 800x200 at bottom of 800x600 window (scaled for other resolutions)

        // Minimap: left side
        self.minimap_region = ControlBarRegion {
            x: 0.0,
            y: 400.0,
            width: 200.0,
            height: 200.0,
        }

        // Resource display: top-right of minimap
        self.resource_region = ControlBarRegion {
            x: 200.0,
            y: 400.0,
            width: 150.0,
            height: 50.0,
        }

        // Selection/Info panel: center
        self.selection_region = ControlBarRegion {
            x: 200.0,
            y: 450.0,
            width: 200.0,
            height: 150.0,
        }

        self.info_panel_region = ControlBarRegion {
            x: 200.0,
            y: 450.0,
            width: 200.0,
            height: 150.0,
        }

        // Command buttons: right side (6 columns x 3 rows)
        self.command_panel_region = ControlBarRegion {
            x: 450.0,
            y: 400.0,
            width: 350.0,
            height: 200.0,
        }
    }

    // Update control bar based on current selection
    fn update(&self, delta_time: f32, selection_count: i32) {
        if selection_count == 0 {
            self.stage = ControlBarStage::DEFAULT
            self.clear_selection_display()
            self.setup_default_buttons()
        } else if selection_count == 1 {
            self.stage = ControlBarStage::SINGLE_SELECTION
            // update_single_selection would be called
        } else {
            self.stage = ControlBarStage::MULTI_SELECTION
            // update_multi_selection would be called
        }

        // Update build queue progress
        self.update_build_queue(delta_time)

        // Update button states (cooldowns, availability)
        self.update_button_states()
    }

    fn clear_selection_display(&self) {
        self.selection_count = 0
        self.unit_name = ""
        self.unit_health = 0.0
        self.unit_max_health = 0.0
        self.unit_portrait = ""
        self.unit_veterancy = 0

        for i in 0..self.selection_cameos.length {
            self.selection_cameos[i].is_valid = false
        }
    }

    fn setup_default_buttons(&self) {
        // Default buttons when nothing is selected
        self.active_button_count = 0

        // Add radar/diplomacy buttons if available
        self.add_default_button(0, 0, CommandButtonType::SELECT_ALL, "Select All Units")
    }

    fn add_command_button(&self, row: i32, col: i32, button_type: CommandButtonType, name: string, image: string) {
        let idx = row * 6 + col
        if idx >= MAX_COMMAND_BUTTONS {
            return
        }

        self.command_buttons[idx].button_type = button_type
        self.command_buttons[idx].name = name
        self.command_buttons[idx].button_image = image
        self.command_buttons[idx].slot_row = row
        self.command_buttons[idx].slot_column = col
        self.command_buttons[idx].is_enabled = true
        self.command_buttons[idx].is_visible = true
        self.command_buttons[idx].is_valid = true

        if idx + 1 > self.active_button_count {
            self.active_button_count = idx + 1
        }
    }

    fn add_build_button(&self, row: i32, col: i32, object_name: string) {
        let idx = row * 6 + col
        if idx >= MAX_COMMAND_BUTTONS {
            return
        }

        self.command_buttons[idx].button_type = CommandButtonType::UNIT_BUILD
        self.command_buttons[idx].object_name = object_name
        self.command_buttons[idx].name = object_name
        self.command_buttons[idx].button_image = "SCC" + object_name
        self.command_buttons[idx].slot_row = row
        self.command_buttons[idx].slot_column = col
        self.command_buttons[idx].is_enabled = true
        self.command_buttons[idx].is_visible = true
        self.command_buttons[idx].is_valid = true

        if idx + 1 > self.active_button_count {
            self.active_button_count = idx + 1
        }
    }

    fn add_special_power_button(&self, row: i32, col: i32, power_name: string) {
        let idx = row * 6 + col
        if idx >= MAX_COMMAND_BUTTONS {
            return
        }

        self.command_buttons[idx].button_type = CommandButtonType::SPECIAL_POWER
        self.command_buttons[idx].special_power_name = power_name
        self.command_buttons[idx].name = power_name
        self.command_buttons[idx].button_image = "SCC" + power_name
        self.command_buttons[idx].slot_row = row
        self.command_buttons[idx].slot_column = col
        self.command_buttons[idx].is_enabled = true
        self.command_buttons[idx].is_visible = true
        self.command_buttons[idx].is_valid = true

        if idx + 1 > self.active_button_count {
            self.active_button_count = idx + 1
        }
    }

    fn add_default_button(&self, row: i32, col: i32, button_type: CommandButtonType, name: string) {
        self.add_command_button(row, col, button_type, name, "")
    }

    fn update_build_queue(&self, delta_time: f32) {
        // Update queue display from selected structure
        // In real implementation, would query selected structure's production queue
    }

    fn update_button_states(&self) {
        // Update cooldown and availability for each button
        for i in 0..self.active_button_count {
            let button = self.command_buttons[i]
            if !button.is_valid {
                continue
            }

            if button.button_type == CommandButtonType::SPECIAL_POWER {
                // Check cooldown
                // button.cooldown_percent = get_power_cooldown(button.special_power_name)
                // button.is_enabled = button.cooldown_percent >= 1.0
            } else if button.button_type == CommandButtonType::UNIT_BUILD {
                // Check prerequisites and resources
                // button.is_enabled = can_build(button.object_name)
            } else if button.button_type == CommandButtonType::UPGRADE {
                // Check if upgrade is available
                // button.is_enabled = can_research(button.upgrade_name)
            }
        }
    }

    // Input handling
    fn handle_mouse_move(&self, x: f32, y: f32) {
        self.hovered_button = -1
        self.tooltip_visible = false

        // Check if in command panel region
        if x >= self.command_panel_region.x &&
           x < self.command_panel_region.x + self.command_panel_region.width &&
           y >= self.command_panel_region.y &&
           y < self.command_panel_region.y + self.command_panel_region.height {

            // Calculate which button
            let button_width = self.command_panel_region.width / 6.0
            let button_height = self.command_panel_region.height / 3.0

            let col = ((x - self.command_panel_region.x) / button_width) as i32
            let row = ((y - self.command_panel_region.y) / button_height) as i32

            let idx = row * 6 + col
            if idx < self.active_button_count && self.command_buttons[idx].is_valid {
                self.hovered_button = idx
                self.tooltip_text = self.command_buttons[idx].name
                self.tooltip_visible = true
            }
        }
    }

    fn handle_mouse_click(&self, x: f32, y: f32, button: i32): bool {
        if !self.is_visible {
            return false
        }

        // Check command buttons
        if self.hovered_button >= 0 {
            let btn = self.command_buttons[self.hovered_button]
            if btn.is_enabled {
                self.execute_command(btn)
                return true
            }
        }

        // Check selection cameos (right-click to deselect)
        if button == 1 {
            self.handle_selection_click(x, y)
        }

        // Check queue slots (right-click to cancel)
        if button == 1 && self.stage == ControlBarStage::SINGLE_SELECTION {
            self.handle_queue_click(x, y)
        }

        return false
    }

    fn execute_command(&self, button: CommandButton) {
        if button.button_type == CommandButtonType::UNIT_BUILD {
            // on_build_requested(button.object_name)
        } else if button.button_type == CommandButtonType::UPGRADE ||
                  button.button_type == CommandButtonType::OBJECT_UPGRADE ||
                  button.button_type == CommandButtonType::PLAYER_UPGRADE {
            // on_upgrade_requested(button.upgrade_name)
        } else {
            // on_command_issued(button.button_type, button.name)
        }
    }

    fn handle_selection_click(&self, x: f32, y: f32) {
        // Check if clicking on a selection cameo
        // Implementation: calculate cameo grid position and remove from selection
    }

    fn handle_queue_click(&self, x: f32, y: f32) {
        // Check if clicking on a queue slot to cancel production
        // Implementation: calculate queue slot and cancel that item
    }

    // Rendering data getters
    fn get_active_button_count(&self): i32 {
        return self.active_button_count
    }

    fn get_selection_count(&self): i32 {
        return self.selection_count
    }

    fn get_queue_count(&self): i32 {
        return self.queue_count
    }

    fn is_in_control_bar(&self, x: f32, y: f32): bool {
        return y >= self.minimap_region.y
    }

    // Stage controls
    fn enter_build_placement_mode(&self, building_name: string) {
        self.stage = ControlBarStage::BUILDING_PLACEMENT
        // Setup cancel button
        self.active_button_count = 1
        self.add_command_button(0, 0, CommandButtonType::CANCEL_CONSTRUCTION, "Cancel", "SCCCancel")
    }

    fn enter_superweapon_targeting(&self, power_name: string) {
        self.stage = ControlBarStage::SUPERWEAPON_TARGET
    }

    fn exit_special_mode(&self) {
        self.stage = ControlBarStage::DEFAULT
        self.update(0.0, 0) // Refresh buttons
    }

    fn set_resources(&self, money: i32, power_produced: i32, power_consumed: i32) {
        self.money = money
        self.power_produced = power_produced
        self.power_consumed = power_consumed
    }

    fn get_tooltip(&self): string {
        if self.tooltip_visible {
            return self.tooltip_text
        }
        return ""
    }
}

// ============================================================================
// GLOBAL CONTROL BAR INSTANCE
// ============================================================================

let g_control_bar: ControlBar? = null

fn init_control_bar(): ControlBar {
    let bar = ControlBar::init()
    g_control_bar = bar
    return bar
}

fn get_control_bar(): ControlBar? {
    return g_control_bar
}

fn shutdown_control_bar() {
    g_control_bar = null
}

fn control_bar_update(delta_time: f32, selection_count: i32) {
    if g_control_bar != null {
        g_control_bar.update(delta_time, selection_count)
    }
}

fn control_bar_handle_mouse_move(x: f32, y: f32) {
    if g_control_bar != null {
        g_control_bar.handle_mouse_move(x, y)
    }
}

fn control_bar_handle_click(x: f32, y: f32, button: i32): bool {
    if g_control_bar != null {
        return g_control_bar.handle_mouse_click(x, y, button)
    }
    return false
}

fn control_bar_set_resources(money: i32, power_produced: i32, power_consumed: i32) {
    if g_control_bar != null {
        g_control_bar.set_resources(money, power_produced, power_consumed)
    }
}
