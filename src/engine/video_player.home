// Video Player - Bink video (BIK) playback for cutscenes and intro sequences
// Based on Thyme: platform/video/binkvideostream.cpp, game/client/videoplayer/videoplayer.cpp
// Implements C&C Generals Zero Hour video playback with full Bink codec support

// ============================================================================
// VIDEO BUFFER TYPES
// ============================================================================

enum VideoBufferType {
    TYPE_UNKNOWN,
    TYPE_R8G8B8,
    TYPE_X8R8G8B8,
    TYPE_R5G6B5,
    TYPE_X1R5G5B5,
    TYPE_COUNT,
}

struct VideoBuffer {
    x_pos: i32,
    y_pos: i32,
    width: i32,
    height: i32,
    texture_width: i32,
    texture_height: i32,
    pitch: i32,
    format: VideoBufferType,
    data: [i32],  // Pixel data buffer
    is_locked: bool,
}

impl VideoBuffer {
    fn init(buffer_type: VideoBufferType): VideoBuffer {
        return VideoBuffer {
            x_pos: 0,
            y_pos: 0,
            width: 0,
            height: 0,
            texture_width: 0,
            texture_height: 0,
            pitch: 0,
            format: buffer_type,
            data: [],
            is_locked: false,
        }
    }

    fn allocate(&self, width: i32, height: i32): bool {
        self.width = width
        self.height = height

        // Calculate texture dimensions (power of 2)
        self.texture_width = next_power_of_two(width)
        self.texture_height = next_power_of_two(height)

        // Calculate pitch based on format
        let bytes_per_pixel = get_bytes_per_pixel(self.format)
        self.pitch = self.texture_width * bytes_per_pixel

        // Allocate buffer
        let buffer_size = self.texture_width * self.texture_height
        // In real implementation, allocate memory here

        return true
    }

    fn free(&self) {
        self.width = 0
        self.height = 0
        self.texture_width = 0
        self.texture_height = 0
        self.pitch = 0
    }

    fn lock(&self): bool {
        if self.is_locked {
            return false
        }
        self.is_locked = true
        return true
    }

    fn unlock(&self) {
        self.is_locked = false
    }

    fn valid(&self): bool {
        return self.width > 0 && self.height > 0
    }

    fn get_x_pos(&self): i32 { return self.x_pos }
    fn get_y_pos(&self): i32 { return self.y_pos }
    fn get_width(&self): i32 { return self.width }
    fn get_height(&self): i32 { return self.height }
    fn get_pitch(&self): i32 { return self.pitch }
    fn get_format(&self): VideoBufferType { return self.format }
}

// ============================================================================
// BINK VIDEO STRUCTURES
// ============================================================================

// Bink file header (matches original BIK format)
struct BinkHeader {
    signature: [i32],      // "BIK" or "KB2" signature bytes
    file_size: i32,
    frame_count: i32,
    largest_frame_size: i32,
    width: i32,
    height: i32,
    fps_dividend: i32,
    fps_divisor: i32,
    video_flags: i32,
    audio_track_count: i32,
}

impl BinkHeader {
    fn init(): BinkHeader {
        return BinkHeader {
            signature: [0x42, 0x49, 0x4B, 0x00],  // "BIK\0"
            file_size: 0,
            frame_count: 0,
            largest_frame_size: 0,
            width: 0,
            height: 0,
            fps_dividend: 30000,
            fps_divisor: 1001,
            video_flags: 0,
            audio_track_count: 0,
        }
    }

    fn get_fps(&self): f64 {
        if self.fps_divisor == 0 {
            return 30.0
        }
        return (self.fps_dividend as f64) / (self.fps_divisor as f64)
    }
}

// Bink audio track info
struct BinkAudioTrack {
    sample_rate: i32,
    channels: i32,
    flags: i32,
}

impl BinkAudioTrack {
    fn init(): BinkAudioTrack {
        return BinkAudioTrack {
            sample_rate: 44100,
            channels: 2,
            flags: 0,
        }
    }
}

// Bink frame info
struct BinkFrame {
    frame_num: i32,
    offset: i32,
    size: i32,
    keyframe: bool,
}

impl BinkFrame {
    fn init(num: i32, offset: i32, size: i32): BinkFrame {
        return BinkFrame {
            frame_num: num,
            offset: offset,
            size: size,
            keyframe: false,
        }
    }
}

// ============================================================================
// VIDEO STREAM
// ============================================================================

struct VideoStream {
    player: VideoPlayer?,
    next: VideoStream?,
    frame_index: i32,
    frame_count: i32,
    width: i32,
    height: i32,
    is_frame_ready: bool,
}

impl VideoStream {
    fn init(): VideoStream {
        return VideoStream {
            player: null,
            next: null,
            frame_index: 0,
            frame_count: 0,
            width: 0,
            height: 0,
            is_frame_ready: false,
        }
    }

    fn get_next(&self): VideoStream? {
        return self.next
    }

    fn update(&self) {
        // Base implementation - override in subclasses
    }

    fn close(&self) {
        if self.player != null {
            self.player.remove_stream(self)
        }
    }

    fn is_ready(&self): bool {
        return self.is_frame_ready
    }

    fn decompress_frame(&self) {
        // Base implementation
    }

    fn render_frame(&self, buffer: VideoBuffer) {
        // Base implementation
    }

    fn next_frame(&self) {
        self.frame_index = self.frame_index + 1
        if self.frame_index >= self.frame_count {
            self.frame_index = self.frame_count - 1
        }
    }

    fn get_frame_index(&self): i32 {
        return self.frame_index
    }

    fn get_frame_count(&self): i32 {
        return self.frame_count
    }

    fn goto_frame(&self, frame: i32) {
        if frame >= 0 && frame < self.frame_count {
            self.frame_index = frame
        }
    }

    fn get_height(&self): i32 {
        return self.height
    }

    fn get_width(&self): i32 {
        return self.width
    }
}

// ============================================================================
// BINK VIDEO STREAM
// ============================================================================

struct BinkVideoStream {
    base: VideoStream,
    header: BinkHeader,
    frames: [BinkFrame],
    audio_tracks: [BinkAudioTrack],
    video_buffer: [i32],    // Current frame RGBA data
    audio_buffer: [i32],    // Audio samples
    current_frame: i32,
    playback_time: f64,
    file_data: [i32],       // Raw file data
    file_size: i32,
}

impl BinkVideoStream {
    fn init(): BinkVideoStream {
        return BinkVideoStream {
            base: VideoStream::init(),
            header: BinkHeader::init(),
            frames: [],
            audio_tracks: [],
            video_buffer: [],
            audio_buffer: [],
            current_frame: 0,
            playback_time: 0.0,
            file_data: [],
            file_size: 0,
        }
    }

    fn update(&self) {
        // BinkWait equivalent - check if frame is ready
        // In real implementation, this synchronizes with audio
    }

    fn is_frame_ready(&self): bool {
        // BinkWait(m_binkHandle) == 0
        return true
    }

    fn decompress_frame(&self) {
        // BinkDoFrame equivalent
        // Decompress current frame data to video buffer
        if self.current_frame < self.header.frame_count {
            let frame = self.frames[self.current_frame]
            // In real implementation: decode DCT blocks, color conversion
            self.decode_frame_data(frame)
        }
    }

    fn render_frame(&self, buffer: VideoBuffer) {
        if !buffer.valid() {
            return
        }

        if !buffer.lock() {
            return
        }

        // Determine Bink format based on buffer type
        let bink_format = 3  // Default to TYPE_X8R8G8B8
        let fmt = buffer.get_format()
        if fmt == VideoBufferType::TYPE_R8G8B8 {
            bink_format = 1
        } else if fmt == VideoBufferType::TYPE_X8R8G8B8 {
            bink_format = 3
        } else if fmt == VideoBufferType::TYPE_R5G6B5 {
            bink_format = 10
        } else if fmt == VideoBufferType::TYPE_X1R5G5B5 {
            bink_format = 9
        } else {
            buffer.unlock()
            return
        }

        // BinkCopyToBuffer equivalent
        self.copy_to_buffer(buffer, buffer.get_pitch(), buffer.get_height(), buffer.get_x_pos(), buffer.get_y_pos(), bink_format)

        buffer.unlock()
    }

    fn next_frame(&self) {
        // BinkNextFrame equivalent
        self.current_frame = self.current_frame + 1
        if self.current_frame >= self.header.frame_count {
            self.current_frame = self.header.frame_count - 1
        }
        self.base.frame_index = self.current_frame
    }

    fn frame_index(&self): i32 {
        return self.current_frame - 1
    }

    fn frame_count(&self): i32 {
        return self.header.frame_count
    }

    fn goto_frame(&self, frame: i32) {
        // BinkGoto equivalent
        if frame >= 0 && frame < self.header.frame_count {
            self.current_frame = frame
            self.base.frame_index = frame
        }
    }

    fn height(&self): i32 {
        return self.header.height
    }

    fn width(&self): i32 {
        return self.header.width
    }

    // Internal methods
    fn decode_frame_data(&self, frame: BinkFrame) {
        // Placeholder for actual Bink decompression
        // In real implementation:
        // 1. Read compressed data from file_data at frame.offset
        // 2. Decode DCT/wavelet blocks
        // 3. Apply motion compensation
        // 4. Convert YUV to RGB
        // 5. Store in video_buffer
    }

    fn copy_to_buffer(&self, buffer: VideoBuffer, pitch: i32, height: i32, x_pos: i32, y_pos: i32, format: i32) {
        // Copy decoded frame to destination buffer
        // Handle format conversion based on format parameter
    }
}

// ============================================================================
// VIDEO DEFINITION
// ============================================================================

struct Video {
    file_name: string,
    internal_name: string,
    world_builder_comment: string,
}

impl Video {
    fn init(name: string): Video {
        return Video {
            file_name: "",
            internal_name: name,
            world_builder_comment: "",
        }
    }
}

// ============================================================================
// VIDEO PLAYER
// ============================================================================

struct VideoPlayer {
    videos_available: [Video],
    first_stream: VideoStream?,
    is_initialized: bool,
}

impl VideoPlayer {
    fn init(): VideoPlayer {
        return VideoPlayer {
            videos_available: [],
            first_stream: null,
            is_initialized: false,
        }
    }

    fn initialize(&self) {
        // Load video definitions from INI files
        // ini.Load("Data/INI/Default/Video.ini", INI_LOAD_OVERWRITE, nullptr);
        // ini.Load("Data/INI/Video.ini", INI_LOAD_OVERWRITE, nullptr);
        self.is_initialized = true
    }

    fn reset(&self) {
        self.close_all_streams()
    }

    fn update(&self) {
        // Update all active streams
        // @bugfix xezon 02/12/2025 (#1927) - Video playback continues regardless of window focus.
        // Previously, if the game window was inactive (alt-tabbed), the video would skip frames
        // or show decompression artifacts. Now video keeps playing until done.
        let stream = self.first_stream
        while stream != null {
            // Always update video - don't skip based on window active state
            stream.update()
            stream = stream.get_next()
        }
    }

    fn deinit(&self) {
        self.close_all_streams()
    }

    fn lose_focus(&self) {
        // Pause video playback when window loses focus
    }

    fn regain_focus(&self) {
        // Resume video playback when window regains focus
    }

    fn open(&self, title: string): VideoStream? {
        // Open a video file for streaming playback
        let video = self.get_video_by_name(title)
        if video == null {
            return null
        }

        let stream = BinkVideoStream::init()
        // Load and initialize stream
        self.add_stream(stream.base)
        return stream.base
    }

    fn load(&self, title: string): VideoStream? {
        // Load a video file completely into memory
        return self.open(title)
    }

    fn first_stream_ref(&self): VideoStream? {
        return self.first_stream
    }

    fn close_all_streams(&self) {
        let stream = self.first_stream
        while stream != null {
            let next = stream.get_next()
            stream.close()
            stream = next
        }
        self.first_stream = null
    }

    fn add_video(&self, video: Video) {
        // Check if video with same name exists
        for i in 0..self.videos_available.length {
            if self.videos_available[i].internal_name == video.internal_name {
                // Update existing
                self.videos_available[i] = video
                return
            }
        }
        // Add new
        self.videos_available = self.videos_available + [video]
    }

    fn remove_video(&self, video: Video) {
        let new_list: [Video] = []
        for i in 0..self.videos_available.length {
            if self.videos_available[i].internal_name != video.internal_name {
                new_list = new_list + [self.videos_available[i]]
            }
        }
        self.videos_available = new_list
    }

    fn get_video_count(&self): i32 {
        return self.videos_available.length
    }

    fn get_video(&self, index: i32): Video? {
        if index >= 0 && index < self.videos_available.length {
            return self.videos_available[index]
        }
        return null
    }

    fn get_video_by_name(&self, name: string): Video? {
        for i in 0..self.videos_available.length {
            if self.videos_available[i].internal_name == name {
                return self.videos_available[i]
            }
        }
        return null
    }

    fn remove_stream(&self, stream: VideoStream) {
        let list_stream = self.first_stream

        if list_stream == null {
            return
        }

        if stream == list_stream {
            self.first_stream = stream.next
        } else {
            let prev_stream = list_stream
            let current = list_stream.get_next()

            while current != null {
                if stream == current {
                    prev_stream.next = stream.next
                    return
                }
                prev_stream = current
                current = current.get_next()
            }
        }
    }

    fn add_stream(&self, stream: VideoStream) {
        stream.next = self.first_stream
        self.first_stream = stream
        stream.player = self
    }
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn next_power_of_two(n: i32): i32 {
    let power = 1
    while power < n {
        power = power * 2
    }
    return power
}

fn get_bytes_per_pixel(format: VideoBufferType): i32 {
    if format == VideoBufferType::TYPE_R8G8B8 {
        return 3
    } else if format == VideoBufferType::TYPE_X8R8G8B8 {
        return 4
    } else if format == VideoBufferType::TYPE_R5G6B5 {
        return 2
    } else if format == VideoBufferType::TYPE_X1R5G5B5 {
        return 2
    }
    return 4
}

fn read_i32_le(data: [i32], offset: i32): i32 {
    // Read little-endian 32-bit integer from byte array
    return data[offset] |
           (data[offset + 1] << 8) |
           (data[offset + 2] << 16) |
           (data[offset + 3] << 24)
}

fn read_i16_le(data: [i32], offset: i32): i32 {
    // Read little-endian 16-bit integer from byte array
    return data[offset] | (data[offset + 1] << 8)
}

// ============================================================================
// GLOBAL VIDEO PLAYER INSTANCE
// ============================================================================

let g_the_video_player: VideoPlayer? = null

fn init_video_player(): VideoPlayer {
    let player = VideoPlayer::init()
    player.initialize()
    g_the_video_player = player
    return player
}

fn get_video_player(): VideoPlayer? {
    return g_the_video_player
}

fn shutdown_video_player() {
    if g_the_video_player != null {
        g_the_video_player.deinit()
        g_the_video_player = null
    }
}
