// File Transfer System - Map and Replay File Transfer
// C&C Generals Zero Hour - Home Port
//
// Handles chunked file transfers for:
// - Map files for multiplayer
// - Replay files
// - Custom content
// - Screenshots
// - Save games
//
// Features:
// - CRC32 verification
// - Chunked transfer with retry
// - Progress tracking
// - Transfer rate calculation

let MAX_CHUNK_SIZE: i32 = 4096
let MAX_CONCURRENT_TRANSFERS: i32 = 4
let MAX_PENDING_CHUNKS: i32 = 16
let CHUNK_TIMEOUT_MS: i32 = 5000
let TRANSFER_TIMEOUT_MS: i32 = 300000  // 5 minutes
let MAX_RETRIES: i32 = 3
let MAX_FILE_CHUNKS: i32 = 16384  // Max 64MB file

// ============================================================================
// Transfer Types
// ============================================================================

enum TransferType {
    MAP,
    REPLAY,
    CUSTOM_CONTENT,
    SCREENSHOT,
    SAVE_GAME,
}

enum TransferDirection {
    UPLOAD,
    DOWNLOAD,
}

enum TransferState {
    IDLE,
    INITIALIZING,
    TRANSFERRING,
    VERIFYING,
    COMPLETE,
    FAILED,
    CANCELLED,
}

enum TransferError {
    NONE,
    FILE_NOT_FOUND,
    ACCESS_DENIED,
    DISK_FULL,
    NETWORK_ERROR,
    TIMEOUT,
    CHECKSUM_MISMATCH,
    INVALID_CHUNK,
    TRANSFER_CANCELLED,
    PEER_DISCONNECTED,
    TOO_MANY_RETRIES,
}

// ============================================================================
// File Metadata
// ============================================================================

struct FileMetadata {
    file_name: string,
    file_path: string,
    file_size: i64,
    chunk_count: i32,
    crc32: i32,
    md5_hash: [i32],  // 16 bytes
    transfer_type: TransferType,
    created_time: i64,
    modified_time: i64,
}

impl FileMetadata {
    fn init(): FileMetadata {
        let hash: [i32] = []
        for i in 0..16 {
            hash = hash + [0]
        }
        return FileMetadata {
            file_name: "",
            file_path: "",
            file_size: 0,
            chunk_count: 0,
            crc32: 0,
            md5_hash: hash,
            transfer_type: TransferType::MAP,
            created_time: 0,
            modified_time: 0,
        }
    }

    fn calculate_chunk_count(&self) {
        self.chunk_count = ((self.file_size + MAX_CHUNK_SIZE as i64 - 1) / MAX_CHUNK_SIZE as i64) as i32
    }

    fn serialize(&self, buffer: [i32]): i32 {
        let offset = 0

        // File name length + data (max 64 bytes)
        offset = write_string_to_buffer(buffer, offset, self.file_name, 64)

        // File size (8 bytes)
        offset = write_i64_to_buffer(buffer, offset, self.file_size)

        // Chunk count (4 bytes)
        offset = write_i32_to_buffer(buffer, offset, self.chunk_count)

        // CRC32 (4 bytes)
        offset = write_i32_to_buffer(buffer, offset, self.crc32)

        // MD5 hash (16 bytes)
        for i in 0..16 {
            if offset < buffer.length {
                buffer[offset] = self.md5_hash[i]
                offset = offset + 1
            }
        }

        // Transfer type (1 byte)
        if offset < buffer.length {
            buffer[offset] = transfer_type_to_int(self.transfer_type)
            offset = offset + 1
        }

        return offset
    }

    fn deserialize(&self, buffer: [i32]): i32 {
        let offset = 0

        // File name
        let name_result = read_string_from_buffer(buffer, offset, 64)
        self.file_name = name_result.value
        offset = name_result.new_offset

        // File size
        let size_result = read_i64_from_buffer(buffer, offset)
        self.file_size = size_result.value
        offset = size_result.new_offset

        // Chunk count
        let chunk_result = read_i32_from_buffer(buffer, offset)
        self.chunk_count = chunk_result.value
        offset = chunk_result.new_offset

        // CRC32
        let crc_result = read_i32_from_buffer(buffer, offset)
        self.crc32 = crc_result.value
        offset = crc_result.new_offset

        // MD5 hash
        for i in 0..16 {
            if offset < buffer.length {
                self.md5_hash[i] = buffer[offset]
                offset = offset + 1
            }
        }

        // Transfer type
        if offset < buffer.length {
            self.transfer_type = int_to_transfer_type(buffer[offset])
            offset = offset + 1
        }

        return offset
    }
}

// ============================================================================
// Chunk Data
// ============================================================================

struct ChunkHeader {
    transfer_id: i32,
    chunk_index: i32,
    chunk_size: i32,
    chunk_crc: i32,
    is_last: bool,
}

impl ChunkHeader {
    fn init(): ChunkHeader {
        return ChunkHeader {
            transfer_id: 0,
            chunk_index: 0,
            chunk_size: 0,
            chunk_crc: 0,
            is_last: false,
        }
    }

    fn serialize(&self, buffer: [i32]): i32 {
        let offset = 0
        offset = write_i32_to_buffer(buffer, offset, self.transfer_id)
        offset = write_i32_to_buffer(buffer, offset, self.chunk_index)
        offset = write_i32_to_buffer(buffer, offset, self.chunk_size)
        offset = write_i32_to_buffer(buffer, offset, self.chunk_crc)
        if offset < buffer.length {
            buffer[offset] = if self.is_last { 1 } else { 0 }
            offset = offset + 1
        }
        return offset
    }

    fn deserialize(buffer: [i32]): ChunkHeader {
        let header = ChunkHeader::init()
        let offset = 0

        let id_result = read_i32_from_buffer(buffer, offset)
        header.transfer_id = id_result.value
        offset = id_result.new_offset

        let idx_result = read_i32_from_buffer(buffer, offset)
        header.chunk_index = idx_result.value
        offset = idx_result.new_offset

        let size_result = read_i32_from_buffer(buffer, offset)
        header.chunk_size = size_result.value
        offset = size_result.new_offset

        let crc_result = read_i32_from_buffer(buffer, offset)
        header.chunk_crc = crc_result.value
        offset = crc_result.new_offset

        if offset < buffer.length {
            header.is_last = buffer[offset] != 0
        }

        return header
    }
}

struct ChunkData {
    header: ChunkHeader,
    data: [i32],
    actual_size: i32,
}

impl ChunkData {
    fn init(): ChunkData {
        return ChunkData {
            header: ChunkHeader::init(),
            data: [],
            actual_size: 0,
        }
    }
}

struct PendingChunk {
    chunk_index: i32,
    request_time: i64,
    retry_count: i32,
    received: bool,
}

impl PendingChunk {
    fn init(): PendingChunk {
        return PendingChunk {
            chunk_index: 0,
            request_time: 0,
            retry_count: 0,
            received: false,
        }
    }
}

// ============================================================================
// Transfer Progress
// ============================================================================

struct TransferProgress {
    bytes_transferred: i64,
    bytes_total: i64,
    chunks_complete: i32,
    chunks_total: i32,
    percent_complete: f64,
    transfer_rate_kbps: f64,
    estimated_time_remaining_ms: i64,
}

impl TransferProgress {
    fn init(): TransferProgress {
        return TransferProgress {
            bytes_transferred: 0,
            bytes_total: 0,
            chunks_complete: 0,
            chunks_total: 0,
            percent_complete: 0.0,
            transfer_rate_kbps: 0.0,
            estimated_time_remaining_ms: 0,
        }
    }
}

// ============================================================================
// File Transfer
// ============================================================================

struct FileTransfer {
    transfer_id: i32,
    direction: TransferDirection,
    state: TransferState,
    error: TransferError,

    // File info
    metadata: FileMetadata,
    local_path: string,

    // Peer info
    peer_id: i64,

    // Progress tracking
    chunks_received: [bool],  // Bitmap of received chunks
    chunks_complete: i32,
    bytes_transferred: i64,

    // Pending requests
    pending_chunks: [PendingChunk],
    pending_count: i32,
    next_chunk_to_request: i32,

    // Timing
    start_time: i64,
    last_activity_time: i64,
    last_progress_time: i64,

    // Rate tracking
    bytes_last_second: i64,
    rate_sample_time: i64,
    transfer_rate_kbps: f64,

    // File buffer
    file_buffer: [i32],
    buffer_offset: i64,
    buffer_used: i32,
}

impl FileTransfer {
    fn init(transfer_id: i32, direction: TransferDirection): FileTransfer {
        // Initialize chunks_received array
        let chunks: [bool] = []
        for i in 0..MAX_FILE_CHUNKS {
            chunks = chunks + [false]
        }

        // Initialize pending chunks array
        let pending: [PendingChunk] = []
        for i in 0..MAX_PENDING_CHUNKS {
            pending = pending + [PendingChunk::init()]
        }

        return FileTransfer {
            transfer_id: transfer_id,
            direction: direction,
            state: TransferState::IDLE,
            error: TransferError::NONE,
            metadata: FileMetadata::init(),
            local_path: "",
            peer_id: 0,
            chunks_received: chunks,
            chunks_complete: 0,
            bytes_transferred: 0,
            pending_chunks: pending,
            pending_count: 0,
            next_chunk_to_request: 0,
            start_time: 0,
            last_activity_time: 0,
            last_progress_time: 0,
            bytes_last_second: 0,
            rate_sample_time: 0,
            transfer_rate_kbps: 0.0,
            file_buffer: [],
            buffer_offset: 0,
            buffer_used: 0,
        }
    }

    fn get_progress(&self): TransferProgress {
        let percent = 0.0
        if self.metadata.file_size > 0 {
            percent = (self.bytes_transferred as f64 / self.metadata.file_size as f64) * 100.0
        }

        let eta: i64 = 0
        if self.transfer_rate_kbps > 0.0 {
            let remaining_kb = (self.metadata.file_size - self.bytes_transferred) as f64 / 1024.0
            eta = (remaining_kb / self.transfer_rate_kbps * 1000.0) as i64
        }

        return TransferProgress {
            bytes_transferred: self.bytes_transferred,
            bytes_total: self.metadata.file_size,
            chunks_complete: self.chunks_complete,
            chunks_total: self.metadata.chunk_count,
            percent_complete: percent,
            transfer_rate_kbps: self.transfer_rate_kbps,
            estimated_time_remaining_ms: eta,
        }
    }

    fn is_chunk_received(&self, chunk_index: i32): bool {
        if chunk_index < 0 || chunk_index >= MAX_FILE_CHUNKS {
            return false
        }
        return self.chunks_received[chunk_index]
    }

    fn mark_chunk_received(&self, chunk_index: i32, size: i32) {
        if chunk_index < 0 || chunk_index >= MAX_FILE_CHUNKS {
            return
        }

        if !self.chunks_received[chunk_index] {
            self.chunks_received[chunk_index] = true
            self.chunks_complete = self.chunks_complete + 1
            self.bytes_transferred = self.bytes_transferred + size as i64
        }
    }

    fn get_next_missing_chunk(&self): i32 {
        for i in 0..self.metadata.chunk_count {
            if !self.chunks_received[i] {
                // Check if not already pending
                let is_pending = false
                for j in 0..self.pending_count {
                    if self.pending_chunks[j].chunk_index == i {
                        is_pending = true
                        break
                    }
                }

                if !is_pending {
                    return i
                }
            }
        }
        return -1  // No missing chunks
    }

    fn add_pending_chunk(&self, chunk_index: i32, time_ms: i64) {
        if self.pending_count >= MAX_PENDING_CHUNKS {
            return
        }

        self.pending_chunks[self.pending_count] = PendingChunk {
            chunk_index: chunk_index,
            request_time: time_ms,
            retry_count: 0,
            received: false,
        }
        self.pending_count = self.pending_count + 1
    }

    fn remove_pending_chunk(&self, chunk_index: i32) {
        for i in 0..self.pending_count {
            if self.pending_chunks[i].chunk_index == chunk_index {
                // Shift remaining items
                for j in i..(self.pending_count - 1) {
                    self.pending_chunks[j] = self.pending_chunks[j + 1]
                }
                self.pending_count = self.pending_count - 1
                return
            }
        }
    }

    fn check_pending_timeouts(&self, current_time_ms: i64): [i32] {
        let timed_out: [i32] = []

        for i in 0..self.pending_count {
            let elapsed = current_time_ms - self.pending_chunks[i].request_time

            if elapsed > CHUNK_TIMEOUT_MS as i64 {
                if self.pending_chunks[i].retry_count >= MAX_RETRIES {
                    self.state = TransferState::FAILED
                    self.error = TransferError::TOO_MANY_RETRIES
                    return timed_out
                }

                timed_out = timed_out + [self.pending_chunks[i].chunk_index]

                // Reset for retry
                self.pending_chunks[i].request_time = current_time_ms
                self.pending_chunks[i].retry_count = self.pending_chunks[i].retry_count + 1
            }
        }

        return timed_out
    }

    fn update_transfer_rate(&self, current_time_ms: i64) {
        let elapsed = current_time_ms - self.rate_sample_time

        if elapsed >= 1000 {
            self.transfer_rate_kbps = (self.bytes_last_second as f64 / 1024.0) * (1000.0 / elapsed as f64)
            self.bytes_last_second = 0
            self.rate_sample_time = current_time_ms
        }
    }

    fn is_complete(&self): bool {
        return self.chunks_complete >= self.metadata.chunk_count
    }
}

// ============================================================================
// File Transfer Config
// ============================================================================

struct FileTransferConfig {
    download_path: string,
    max_concurrent: i32,
    chunk_size: i32,
    timeout_ms: i32,
    verify_checksums: bool,
    auto_resume: bool,
}

impl FileTransferConfig {
    fn init(): FileTransferConfig {
        return FileTransferConfig {
            download_path: "downloads/",
            max_concurrent: 4,
            chunk_size: MAX_CHUNK_SIZE,
            timeout_ms: TRANSFER_TIMEOUT_MS,
            verify_checksums: true,
            auto_resume: true,
        }
    }
}

// ============================================================================
// File Transfer Manager
// ============================================================================

struct FileTransferManager {
    config: FileTransferConfig,

    // Active transfers
    transfers: [FileTransfer],
    transfer_count: i32,
    next_transfer_id: i32,

    // Statistics
    total_bytes_downloaded: i64,
    total_bytes_uploaded: i64,
    total_transfers_complete: i32,
    total_transfers_failed: i32,
}

impl FileTransferManager {
    fn init(config: FileTransferConfig): FileTransferManager {
        let transfers: [FileTransfer] = []
        for i in 0..MAX_CONCURRENT_TRANSFERS {
            transfers = transfers + [FileTransfer::init(0, TransferDirection::DOWNLOAD)]
        }

        return FileTransferManager {
            config: config,
            transfers: transfers,
            transfer_count: 0,
            next_transfer_id: 1,
            total_bytes_downloaded: 0,
            total_bytes_uploaded: 0,
            total_transfers_complete: 0,
            total_transfers_failed: 0,
        }
    }

    // ========================================================================
    // Transfer Initiation
    // ========================================================================

    fn start_download(&self, peer_id: i64, metadata: FileMetadata): i32 {
        if self.transfer_count >= MAX_CONCURRENT_TRANSFERS {
            return 0
        }

        let transfer_id = self.next_transfer_id
        self.next_transfer_id = self.next_transfer_id + 1

        let transfer = FileTransfer::init(transfer_id, TransferDirection::DOWNLOAD)
        transfer.peer_id = peer_id
        transfer.metadata = metadata
        transfer.local_path = self.config.download_path + metadata.file_name
        transfer.state = TransferState::INITIALIZING
        transfer.start_time = get_current_time_ms()
        transfer.last_activity_time = transfer.start_time
        transfer.rate_sample_time = transfer.start_time

        self.transfers[self.transfer_count] = transfer
        self.transfer_count = self.transfer_count + 1

        return transfer_id
    }

    fn start_upload(&self, peer_id: i64, file_path: string): i32 {
        if self.transfer_count >= MAX_CONCURRENT_TRANSFERS {
            return 0
        }

        // Create metadata from file
        let metadata = create_metadata_from_file(file_path)
        if metadata.file_size == 0 {
            return 0
        }

        let transfer_id = self.next_transfer_id
        self.next_transfer_id = self.next_transfer_id + 1

        let transfer = FileTransfer::init(transfer_id, TransferDirection::UPLOAD)
        transfer.peer_id = peer_id
        transfer.metadata = metadata
        transfer.local_path = file_path
        transfer.state = TransferState::INITIALIZING
        transfer.start_time = get_current_time_ms()
        transfer.last_activity_time = transfer.start_time
        transfer.rate_sample_time = transfer.start_time

        self.transfers[self.transfer_count] = transfer
        self.transfer_count = self.transfer_count + 1

        return transfer_id
    }

    // ========================================================================
    // Transfer Operations
    // ========================================================================

    fn get_transfer(&self, transfer_id: i32): FileTransfer? {
        for i in 0..self.transfer_count {
            if self.transfers[i].transfer_id == transfer_id {
                return self.transfers[i]
            }
        }
        return null
    }

    fn cancel_transfer(&self, transfer_id: i32) {
        let transfer = self.get_transfer(transfer_id)
        if transfer == null {
            return
        }

        transfer.state = TransferState::CANCELLED
        transfer.error = TransferError::TRANSFER_CANCELLED

        self.remove_transfer(transfer_id)
    }

    fn remove_transfer(&self, transfer_id: i32) {
        for i in 0..self.transfer_count {
            if self.transfers[i].transfer_id == transfer_id {
                // Shift remaining transfers
                for j in i..(self.transfer_count - 1) {
                    self.transfers[j] = self.transfers[j + 1]
                }
                self.transfer_count = self.transfer_count - 1
                return
            }
        }
    }

    // ========================================================================
    // Chunk Handling
    // ========================================================================

    fn receive_chunk(&self, transfer_id: i32, chunk: ChunkData): bool {
        let transfer = self.get_transfer(transfer_id)
        if transfer == null {
            return false
        }

        // Verify chunk CRC
        if self.config.verify_checksums {
            let computed_crc = compute_crc32(chunk.data, chunk.actual_size)
            if computed_crc != chunk.header.chunk_crc {
                return false  // Invalid chunk
            }
        }

        // Already have this chunk?
        if transfer.is_chunk_received(chunk.header.chunk_index) {
            return true  // Duplicate, but not an error
        }

        // Write to file buffer
        let file_offset = chunk.header.chunk_index as i64 * MAX_CHUNK_SIZE as i64
        write_chunk_to_buffer(transfer, file_offset, chunk.data, chunk.actual_size)

        // Mark received
        transfer.mark_chunk_received(chunk.header.chunk_index, chunk.actual_size)
        transfer.remove_pending_chunk(chunk.header.chunk_index)
        transfer.last_activity_time = get_current_time_ms()
        transfer.bytes_last_second = transfer.bytes_last_second + chunk.actual_size as i64

        // Check completion
        if transfer.is_complete() {
            self.finalize_download(transfer_id)
        }

        return true
    }

    fn request_chunks(&self, transfer_id: i32) {
        let transfer = self.get_transfer(transfer_id)
        if transfer == null {
            return
        }

        if transfer.state != TransferState::TRANSFERRING {
            transfer.state = TransferState::TRANSFERRING
        }

        let current_time = get_current_time_ms()

        // Request up to MAX_PENDING_CHUNKS at a time
        while transfer.pending_count < MAX_PENDING_CHUNKS {
            let next_chunk = transfer.get_next_missing_chunk()
            if next_chunk < 0 {
                break
            }

            transfer.add_pending_chunk(next_chunk, current_time)

            // Notify to request this chunk (callback would go here)
        }
    }

    fn send_chunk(&self, transfer_id: i32, chunk_index: i32) {
        let transfer = self.get_transfer(transfer_id)
        if transfer == null {
            return
        }

        // Create chunk
        let chunk = ChunkData::init()
        chunk.header.transfer_id = transfer_id
        chunk.header.chunk_index = chunk_index

        let file_offset = chunk_index as i64 * MAX_CHUNK_SIZE as i64
        let remaining = transfer.metadata.file_size - file_offset
        let chunk_size = if remaining > MAX_CHUNK_SIZE as i64 {
            MAX_CHUNK_SIZE
        } else {
            remaining as i32
        }

        // Read from file
        chunk.data = read_file_chunk(transfer.local_path, file_offset, chunk_size)
        chunk.header.chunk_size = chunk_size
        chunk.actual_size = chunk_size
        chunk.header.chunk_crc = compute_crc32(chunk.data, chunk_size)
        chunk.header.is_last = chunk_index == transfer.metadata.chunk_count - 1

        // Track upload progress
        transfer.mark_chunk_received(chunk_index, chunk_size)
        transfer.last_activity_time = get_current_time_ms()
        transfer.bytes_last_second = transfer.bytes_last_second + chunk_size as i64

        // Check completion
        if transfer.is_complete() {
            self.finalize_upload(transfer_id)
        }
    }

    // ========================================================================
    // Transfer Completion
    // ========================================================================

    fn finalize_download(&self, transfer_id: i32) {
        let transfer = self.get_transfer(transfer_id)
        if transfer == null {
            return
        }

        transfer.state = TransferState::VERIFYING

        // Verify complete file
        if self.config.verify_checksums {
            // Write buffer to file first
            write_file(transfer.local_path, transfer.file_buffer, transfer.buffer_used)

            // Verify CRC
            let file_crc = calculate_file_crc32(transfer.local_path)
            if file_crc != transfer.metadata.crc32 {
                transfer.state = TransferState::FAILED
                transfer.error = TransferError::CHECKSUM_MISMATCH
                self.total_transfers_failed = self.total_transfers_failed + 1
                return
            }
        } else {
            // Just write the file
            write_file(transfer.local_path, transfer.file_buffer, transfer.buffer_used)
        }

        transfer.state = TransferState::COMPLETE
        self.total_bytes_downloaded = self.total_bytes_downloaded + transfer.bytes_transferred
        self.total_transfers_complete = self.total_transfers_complete + 1
    }

    fn finalize_upload(&self, transfer_id: i32) {
        let transfer = self.get_transfer(transfer_id)
        if transfer == null {
            return
        }

        transfer.state = TransferState::COMPLETE
        self.total_bytes_uploaded = self.total_bytes_uploaded + transfer.bytes_transferred
        self.total_transfers_complete = self.total_transfers_complete + 1
    }

    // ========================================================================
    // Update Loop
    // ========================================================================

    fn update(&self) {
        let current_time = get_current_time_ms()

        for i in 0..self.transfer_count {
            let transfer = self.transfers[i]

            // Skip completed/failed transfers
            if transfer.state == TransferState::COMPLETE ||
               transfer.state == TransferState::FAILED ||
               transfer.state == TransferState::CANCELLED {
                continue
            }

            // Check overall timeout
            let total_elapsed = current_time - transfer.start_time
            if total_elapsed > self.config.timeout_ms as i64 {
                transfer.state = TransferState::FAILED
                transfer.error = TransferError::TIMEOUT
                continue
            }

            // Check chunk timeouts and retry
            let timed_out = transfer.check_pending_timeouts(current_time)
            for j in 0..timed_out.length {
                // Re-request timed out chunks (callback would go here)
            }

            // Update transfer rate
            transfer.update_transfer_rate(current_time)

            // Request more chunks if downloading
            if transfer.direction == TransferDirection::DOWNLOAD {
                if transfer.pending_count < MAX_PENDING_CHUNKS && !transfer.is_complete() {
                    self.request_chunks(transfer.transfer_id)
                }
            }
        }

        // Clean up completed transfers
        self.cleanup_completed()
    }

    fn cleanup_completed(&self) {
        let i = 0
        while i < self.transfer_count {
            let state = self.transfers[i].state
            if state == TransferState::COMPLETE ||
               state == TransferState::FAILED ||
               state == TransferState::CANCELLED {
                // Remove transfer
                for j in i..(self.transfer_count - 1) {
                    self.transfers[j] = self.transfers[j + 1]
                }
                self.transfer_count = self.transfer_count - 1
            } else {
                i = i + 1
            }
        }
    }

    // ========================================================================
    // Utility
    // ========================================================================

    fn get_active_transfer_count(&self): i32 {
        let count = 0
        for i in 0..self.transfer_count {
            let state = self.transfers[i].state
            if state == TransferState::INITIALIZING ||
               state == TransferState::TRANSFERRING ||
               state == TransferState::VERIFYING {
                count = count + 1
            }
        }
        return count
    }

    fn get_transfer_progress(&self, transfer_id: i32): TransferProgress? {
        for i in 0..self.transfer_count {
            if self.transfers[i].transfer_id == transfer_id {
                return self.transfers[i].get_progress()
            }
        }
        return null
    }

    fn get_all_progress(&self): [TransferProgress] {
        let progress: [TransferProgress] = []
        for i in 0..self.transfer_count {
            progress = progress + [self.transfers[i].get_progress()]
        }
        return progress
    }
}

// ============================================================================
// Map Transfer
// ============================================================================

struct MapTransfer {
    manager: FileTransferManager,
    map_cache_path: string,
    pending_map_requests: [i64],
    pending_count: i32,
}

impl MapTransfer {
    fn init(cache_path: string): MapTransfer {
        let config = FileTransferConfig::init()
        config.download_path = cache_path

        let pending: [i64] = []
        for i in 0..8 {
            pending = pending + [0]
        }

        return MapTransfer {
            manager: FileTransferManager::init(config),
            map_cache_path: cache_path,
            pending_map_requests: pending,
            pending_count: 0,
        }
    }

    fn request_map(&self, peer_id: i64, map_name: string, map_crc: i32): bool {
        // Check if we already have this map
        if self.has_map(map_name, map_crc) {
            return true
        }

        // Check if already downloading
        for i in 0..self.manager.transfer_count {
            if self.manager.transfers[i].metadata.file_name == map_name {
                return true  // Already in progress
            }
        }

        // Queue request
        if self.pending_count < 8 {
            self.pending_map_requests[self.pending_count] = peer_id
            self.pending_count = self.pending_count + 1
        }

        return false
    }

    fn has_map(&self, map_name: string, expected_crc: i32): bool {
        let map_path = self.map_cache_path + map_name

        if !file_exists(map_path) {
            return false
        }

        // Verify CRC if provided
        if expected_crc != 0 {
            let actual_crc = calculate_file_crc32(map_path)
            return actual_crc == expected_crc
        }

        return true
    }

    fn get_map_path(&self, map_name: string): string {
        return self.map_cache_path + map_name
    }
}

// ============================================================================
// Replay Transfer
// ============================================================================

struct ReplayTransfer {
    manager: FileTransferManager,
    replay_path: string,
}

impl ReplayTransfer {
    fn init(replay_path: string): ReplayTransfer {
        let config = FileTransferConfig::init()
        config.download_path = replay_path

        return ReplayTransfer {
            manager: FileTransferManager::init(config),
            replay_path: replay_path,
        }
    }

    fn send_replay(&self, peer_id: i64, replay_name: string): i32 {
        let full_path = self.replay_path + replay_name
        return self.manager.start_upload(peer_id, full_path)
    }

    fn receive_replay(&self, peer_id: i64, metadata: FileMetadata): i32 {
        return self.manager.start_download(peer_id, metadata)
    }
}

// ============================================================================
// CRC32 Implementation
// ============================================================================

let CRC32_POLYNOMIAL: i32 = 0xEDB88320

fn compute_crc32(data: [i32], size: i32): i32 {
    let crc = 0xFFFFFFFF

    for i in 0..size {
        if i < data.length {
            crc = crc ^ (data[i] & 0xFF)

            for bit in 0..8 {
                if (crc & 1) != 0 {
                    crc = (crc >> 1) ^ CRC32_POLYNOMIAL
                } else {
                    crc = crc >> 1
                }
            }
        }
    }

    return crc ^ 0xFFFFFFFF
}

// ============================================================================
// Helper Functions
// ============================================================================

fn transfer_type_to_int(t: TransferType): i32 {
    if t == TransferType::MAP { return 0 }
    if t == TransferType::REPLAY { return 1 }
    if t == TransferType::CUSTOM_CONTENT { return 2 }
    if t == TransferType::SCREENSHOT { return 3 }
    if t == TransferType::SAVE_GAME { return 4 }
    return 0
}

fn int_to_transfer_type(i: i32): TransferType {
    if i == 0 { return TransferType::MAP }
    if i == 1 { return TransferType::REPLAY }
    if i == 2 { return TransferType::CUSTOM_CONTENT }
    if i == 3 { return TransferType::SCREENSHOT }
    if i == 4 { return TransferType::SAVE_GAME }
    return TransferType::MAP
}

struct StringReadResult {
    value: string,
    new_offset: i32,
}

struct I32ReadResult {
    value: i32,
    new_offset: i32,
}

struct I64ReadResult {
    value: i64,
    new_offset: i32,
}

fn write_i32_to_buffer(buffer: [i32], offset: i32, value: i32): i32 {
    if offset + 4 <= buffer.length {
        buffer[offset] = value & 0xFF
        buffer[offset + 1] = (value >> 8) & 0xFF
        buffer[offset + 2] = (value >> 16) & 0xFF
        buffer[offset + 3] = (value >> 24) & 0xFF
    }
    return offset + 4
}

fn write_i64_to_buffer(buffer: [i32], offset: i32, value: i64): i32 {
    let low = (value & 0xFFFFFFFF) as i32
    let high = ((value >> 32) & 0xFFFFFFFF) as i32
    let new_offset = write_i32_to_buffer(buffer, offset, low)
    return write_i32_to_buffer(buffer, new_offset, high)
}

fn write_string_to_buffer(buffer: [i32], offset: i32, value: string, max_len: i32): i32 {
    let len = value.length
    if len > max_len - 1 {
        len = max_len - 1
    }

    if offset < buffer.length {
        buffer[offset] = len
    }

    for i in 0..len {
        if offset + 1 + i < buffer.length {
            buffer[offset + 1 + i] = char_code(value, i)
        }
    }

    return offset + max_len
}

fn read_i32_from_buffer(buffer: [i32], offset: i32): I32ReadResult {
    let value = 0
    if offset + 4 <= buffer.length {
        value = buffer[offset] |
                (buffer[offset + 1] << 8) |
                (buffer[offset + 2] << 16) |
                (buffer[offset + 3] << 24)
    }
    return I32ReadResult { value: value, new_offset: offset + 4 }
}

fn read_i64_from_buffer(buffer: [i32], offset: i32): I64ReadResult {
    let low_result = read_i32_from_buffer(buffer, offset)
    let high_result = read_i32_from_buffer(buffer, low_result.new_offset)
    let value = (low_result.value as i64) | ((high_result.value as i64) << 32)
    return I64ReadResult { value: value, new_offset: high_result.new_offset }
}

fn read_string_from_buffer(buffer: [i32], offset: i32, max_len: i32): StringReadResult {
    let len = 0
    if offset < buffer.length {
        len = buffer[offset]
    }

    if len > max_len - 1 {
        len = max_len - 1
    }

    let result = ""
    for i in 0..len {
        if offset + 1 + i < buffer.length {
            result = result + char_from_code(buffer[offset + 1 + i])
        }
    }

    return StringReadResult { value: result, new_offset: offset + max_len }
}

fn create_metadata_from_file(path: string): FileMetadata {
    let metadata = FileMetadata::init()

    let file_size = get_file_size(path)
    if file_size == 0 {
        return metadata
    }

    metadata.file_path = path
    metadata.file_name = extract_filename(path)
    metadata.file_size = file_size
    metadata.calculate_chunk_count()
    metadata.crc32 = calculate_file_crc32(path)
    metadata.transfer_type = infer_transfer_type(path)

    return metadata
}

fn extract_filename(path: string): string {
    let last_sep = -1

    for i in 0..path.length {
        let c = char_at(path, i)
        if c == "/" || c == "\\" {
            last_sep = i
        }
    }

    if last_sep < 0 {
        return path
    }

    return substring(path, last_sep + 1, path.length)
}

fn infer_transfer_type(path: string): TransferType {
    let lower = to_lowercase(path)

    if ends_with(lower, ".map") {
        return TransferType::MAP
    }
    if ends_with(lower, ".rep") || ends_with(lower, ".replay") {
        return TransferType::REPLAY
    }
    if ends_with(lower, ".sav") {
        return TransferType::SAVE_GAME
    }
    if ends_with(lower, ".png") || ends_with(lower, ".jpg") {
        return TransferType::SCREENSHOT
    }

    return TransferType::CUSTOM_CONTENT
}

fn write_chunk_to_buffer(transfer: FileTransfer, offset: i64, data: [i32], size: i32) {
    for i in 0..size {
        if transfer.buffer_used < 1048576 && i < data.length {
            transfer.file_buffer = transfer.file_buffer + [data[i]]
            transfer.buffer_used = transfer.buffer_used + 1
        }
    }
}

fn min_i32(a: i32, b: i32): i32 {
    if a < b { return a }
    return b
}

