// ============================================================================
// Tests
// ============================================================================

fn test_crc32() {
    print("Testing CRC32...")

    let data: [i32] = [0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39]
    let crc = compute_crc32(data, 9)
    print("CRC32 of '123456789': " + str(crc))
    // Expected: 0xCBF43926
}

fn test_metadata_serialization() {
    print("Testing metadata serialization...")

    let metadata = FileMetadata::init()
    metadata.file_name = "test_map.map"
    metadata.file_size = 1048576
    metadata.chunk_count = 256
    metadata.crc32 = 0x12345678
    metadata.transfer_type = TransferType::MAP

    let buffer: [i32] = []
    for i in 0..128 {
        buffer = buffer + [0]
    }

    let written = metadata.serialize(buffer)
    print("Serialized " + str(written) + " bytes")

    let metadata2 = FileMetadata::init()
    metadata2.deserialize(buffer)

    print("Deserialized file_name: " + metadata2.file_name)
    print("Deserialized file_size: " + str(metadata2.file_size))
}

fn test_transfer_progress() {
    print("Testing transfer progress...")

    let transfer = FileTransfer::init(1, TransferDirection::DOWNLOAD)
    transfer.metadata.file_size = 1048576
    transfer.metadata.chunk_count = 256
    transfer.bytes_transferred = 524288
    transfer.chunks_complete = 128
    transfer.transfer_rate_kbps = 100.0

    let progress = transfer.get_progress()
    print("Progress: " + str(progress.percent_complete as i32) + "%")
    print("Rate: " + str(progress.transfer_rate_kbps as i32) + " KB/s")
}

fn test_chunk_tracking() {
    print("Testing chunk tracking...")

    let transfer = FileTransfer::init(1, TransferDirection::DOWNLOAD)
    transfer.metadata.chunk_count = 10

    // Mark some chunks as received
    transfer.mark_chunk_received(0, 4096)
    transfer.mark_chunk_received(2, 4096)
    transfer.mark_chunk_received(5, 4096)

    print("Chunks complete: " + str(transfer.chunks_complete))

    // Get next missing chunk
    let next = transfer.get_next_missing_chunk()
    print("Next missing chunk: " + str(next))

    // Check if specific chunks are received
    print("Chunk 0 received: " + str(transfer.is_chunk_received(0)))
    print("Chunk 1 received: " + str(transfer.is_chunk_received(1)))
    print("Chunk 2 received: " + str(transfer.is_chunk_received(2)))
}

fn run_all_tests() {
    print("Running file transfer tests...")
    test_crc32()
    test_metadata_serialization()
    test_transfer_progress()
    test_chunk_tracking()
    print("All file transfer tests complete!")
}
