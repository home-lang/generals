    SoundMoveLoop = 14
    SoundMoveLoopDamaged = 15
    SoundDie = 16
    SoundCrush = 17
    SoundAmbient = 18
    SoundAmbientDamaged = 19
    SoundAmbientReallyDamaged = 20
    SoundAmbientRubble = 21
    SoundStealthOn = 22
    SoundStealthOff = 23
