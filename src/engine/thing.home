// C&C Generals Zero Hour - Home Port
// Thing Base Class
//
// Things are the base class for Objects and Drawables:
// - Objects are logic-side representations (game simulation)
// - Drawables are client-side representations (rendering)
//
// Common data shared between them is held in Thing.
// Systems that need to work with both should work with Things.
//
// Based on original Thing.h and ThingTemplate.h

import engine/kindof

// ============================================================================
// EXPERIENCE LEVELS
// ============================================================================
const LEVEL_COUNT: i32 = 4
const LEVEL_REGULAR: i32 = 0
const LEVEL_VETERAN: i32 = 1
const LEVEL_ELITE: i32 = 2
const LEVEL_HERO: i32 = 3

// ============================================================================
// BUILD COMPLETION TYPE
// ============================================================================
enum BuildCompletionType {
    Invalid = 0
    AppearsAtRallyPoint = 1    // Unit appears at rally point of its #1 prereq
    PlacedByPlayer = 2         // Unit must be manually placed by player
}

// ============================================================================
// BUILDABLE STATUS
// ============================================================================
enum BuildableStatus {
    Yes = 0
    IgnorePrerequisites = 1
    No = 2
    OnlyByAI = 3
}

// ============================================================================
// RADAR PRIORITY
// ============================================================================
enum RadarPriority {
    NotOnRadar = 0
    UnitPriority = 1
    StructurePriority = 2
    LocalPlayerUnitPriority = 3
    LocalPlayerStructurePriority = 4
}

// ============================================================================
// SHADOW TYPE
// ============================================================================
enum ShadowType {
    None = 0
    Decal = 1
    Volume = 2
    Projection = 3
    Additive = 4
}

// ============================================================================
// EDITOR SORTING TYPE
// ============================================================================
enum EditorSortingType {
    None = 0
    Infantry = 1
    Vehicle = 2
    Aircraft = 3
    Structure = 4
    Resource = 5
    Shrubbery = 6
    Misc = 7
    System = 8
    Obsolete = 9
}

// ============================================================================
// THING TEMPLATE AUDIO TYPES
// ============================================================================
