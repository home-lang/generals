// selection_manager.home - Unit selection and control groups
// Handles click selection, box selection, and control groups 1-9

let MAX_SELECTION: i32 = 100
let MAX_CONTROL_GROUPS: i32 = 10

// ============================================================================
// Selection Types
// ============================================================================

struct Vec2 {
    x: f32,
    y: f32,
}

impl Vec2 {
    fn init(): Vec2 {
        return Vec2 { x: 0.0, y: 0.0 }
    }
}

struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(): Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }
}

struct Ray {
    origin: Vec3,
    direction: Vec3,
}

struct AABB {
    min: Vec3,
    max: Vec3,
}

struct SelectionBox {
    start_screen: Vec2,
    end_screen: Vec2,
    is_active: bool,
}

impl SelectionBox {
    fn init(): SelectionBox {
        return SelectionBox {
            start_screen: Vec2::init(),
            end_screen: Vec2::init(),
            is_active: false,
        }
    }
}

// ============================================================================
// Selection Manager
// ============================================================================

struct ControlGroup {
    thing_ids: [i32],
    count: i32,
    center: Vec3,
}

impl ControlGroup {
    fn init(): ControlGroup {
        let ids: [i32] = []
        for i in 0..MAX_SELECTION {
            ids = ids + [0]
        }
        return ControlGroup {
            thing_ids: ids,
            count: 0,
            center: Vec3::init(),
        }
    }
}

struct SelectionManager {
    // Current selection
    selected_ids: [i32],
    selection_count: i32,

    // Control groups (0-9)
    control_groups: [ControlGroup],

    // Drag selection
    selection_box: SelectionBox,
    box_start_world: Vec3,

    // Selection state
    primary_selected: i32,          // First/primary selected unit
    last_selection_time: f32,       // For double-click detection
    last_selected_type: i32,        // Template index for double-click select all

    // Filters
    local_player: i32,
    select_enemies: bool,           // Usually false
}

impl SelectionManager {
    fn init(local_player: i32): SelectionManager {
        let selected: [i32] = []
        for i in 0..MAX_SELECTION {
            selected = selected + [0]
        }
        let groups: [ControlGroup] = []
        for i in 0..MAX_CONTROL_GROUPS {
            groups = groups + [ControlGroup::init()]
        }
        return SelectionManager {
            selected_ids: selected,
            selection_count: 0,
            control_groups: groups,
            selection_box: SelectionBox::init(),
            box_start_world: Vec3::init(),
            primary_selected: 0,
            last_selection_time: 0.0,
            last_selected_type: 0,
            local_player: local_player,
            select_enemies: false,
        }
    }

    // ========================================================================
    // Click Selection
    // ========================================================================

    fn select_at_point(&self, screen_pos: Vec2, camera: Camera, add_to_selection: bool, current_time: f32) {
        // Cast ray from camera through screen point
        let ray = camera.screen_to_ray(screen_pos)

        // Find thing under cursor
        let closest_id = 0
        let closest_dist = 10000.0

        // In real implementation, would iterate through things
        // For now, simplified

        if closest_id == 0 {
            // Clicked on nothing
            if !add_to_selection {
                self.clear_selection()
            }
            return
        }

        // Normal click selection
        if add_to_selection {
            if self.is_selected(closest_id) {
                self.remove_from_selection(closest_id)
            } else {
                self.add_to_selection(closest_id)
            }
        } else {
            self.clear_selection()
            self.add_to_selection(closest_id)
        }
    }

    fn can_select(&self, player_index: i32, status: i32): bool {
        // Can't select dead things (status 2 or 3 = dead/dying)
        if status == 2 || status == 3 {
            return false
        }

        // Can't select enemy units (unless select_enemies is true)
        if !self.select_enemies && player_index != self.local_player {
            return false
        }

        return true
    }

    // ========================================================================
    // Box Selection
    // ========================================================================

    fn begin_box_select(&self, screen_pos: Vec2) {
        self.selection_box.start_screen = screen_pos
        self.selection_box.end_screen = screen_pos
        self.selection_box.is_active = true
    }

    fn update_box_select(&self, screen_pos: Vec2) {
        if !self.selection_box.is_active {
            return
        }
        self.selection_box.end_screen = screen_pos
    }

    fn end_box_select(&self, add_to_selection: bool) {
        if !self.selection_box.is_active {
            return
        }

        self.selection_box.is_active = false

        // Get box bounds in screen space
        let min_x = min_f32(self.selection_box.start_screen.x, self.selection_box.end_screen.x)
        let max_x = max_f32(self.selection_box.start_screen.x, self.selection_box.end_screen.x)
        let min_y = min_f32(self.selection_box.start_screen.y, self.selection_box.end_screen.y)
        let max_y = max_f32(self.selection_box.start_screen.y, self.selection_box.end_screen.y)

        // Box too small - treat as click
        if (max_x - min_x) < 5.0 && (max_y - min_y) < 5.0 {
            return
        }

        if !add_to_selection {
            self.clear_selection()
        }

        // Would select all units in box here
    }

    fn get_selection_box(&self): SelectionBox? {
        if self.selection_box.is_active {
            return self.selection_box
        }
        return null
    }

    // ========================================================================
    // Selection Management
    // ========================================================================

    fn add_to_selection(&self, thing_id: i32) {
        if self.is_selected(thing_id) {
            return
        }

        if self.selection_count >= MAX_SELECTION {
            return
        }

        self.selected_ids[self.selection_count] = thing_id
        self.selection_count = self.selection_count + 1

        // Set primary if first selection
        if self.selection_count == 1 {
            self.primary_selected = thing_id
        }
    }

    fn remove_from_selection(&self, thing_id: i32) {
        for i in 0..self.selection_count {
            if self.selected_ids[i] == thing_id {
                // Shift remaining
                for j in i..(self.selection_count - 1) {
                    self.selected_ids[j] = self.selected_ids[j + 1]
                }
                self.selection_count = self.selection_count - 1

                // Update primary if removed
                if self.primary_selected == thing_id {
                    if self.selection_count > 0 {
                        self.primary_selected = self.selected_ids[0]
                    } else {
                        self.primary_selected = 0
                    }
                }

                return
            }
        }
    }

    fn clear_selection(&self) {
        self.selection_count = 0
        self.primary_selected = 0
    }

    fn is_selected(&self, thing_id: i32): bool {
        for i in 0..self.selection_count {
            if self.selected_ids[i] == thing_id {
                return true
            }
        }
        return false
    }

    fn select_all_of_type(&self, template_index: i32) {
        self.clear_selection()
        // Would iterate through things and select matching types
    }

    fn select_all_visible(&self) {
        self.clear_selection()
        // Would iterate through things and select visible ones
    }

    fn get_primary(&self): i32 {
        return self.primary_selected
    }

    fn set_primary(&self, thing_id: i32) {
        if self.is_selected(thing_id) {
            self.primary_selected = thing_id
        }
    }

    fn has_selection(&self): bool {
        return self.selection_count > 0
    }

    fn is_single_selection(&self): bool {
        return self.selection_count == 1
    }

    // ========================================================================
    // Control Groups
    // ========================================================================

    fn assign_control_group(&self, group: i32) {
        if group >= MAX_CONTROL_GROUPS {
            return
        }

        // Copy current selection to control group
        self.control_groups[group].count = self.selection_count
        for i in 0..self.selection_count {
            self.control_groups[group].thing_ids[i] = self.selected_ids[i]
        }

        self.update_group_center(group)
    }

    fn add_to_control_group(&self, group: i32) {
        if group >= MAX_CONTROL_GROUPS {
            return
        }

        let cg = self.control_groups[group]

        for i in 0..self.selection_count {
            let id = self.selected_ids[i]

            // Check if already in group
            let found = false
            for j in 0..cg.count {
                if cg.thing_ids[j] == id {
                    found = true
                    break
                }
            }

            if !found && cg.count < MAX_SELECTION {
                cg.thing_ids[cg.count] = id
                cg.count = cg.count + 1
            }
        }

        self.update_group_center(group)
    }

    fn select_control_group(&self, group: i32, add_to_selection: bool) {
        if group >= MAX_CONTROL_GROUPS {
            return
        }

        let cg = self.control_groups[group]

        if cg.count == 0 {
            return
        }

        if !add_to_selection {
            self.clear_selection()
        }

        for i in 0..cg.count {
            self.add_to_selection(cg.thing_ids[i])
        }
    }

    fn center_on_control_group(&self, group: i32): Vec3? {
        if group >= MAX_CONTROL_GROUPS {
            return null
        }

        let cg = self.control_groups[group]
        if cg.count == 0 {
            return null
        }

        return cg.center
    }

    fn update_group_center(&self, group: i32) {
        // Would need access to thing factory to compute center
        // For now, just reset
        self.control_groups[group].center = Vec3::init()
    }

    // ========================================================================
    // Selection Utilities
    // ========================================================================

    fn get_selection_center(&self): Vec3 {
        if self.selection_count == 0 {
            return Vec3::init()
        }

        // Would compute center from thing positions
        return Vec3::init()
    }

    fn prune_dead(&self) {
        let i = 0
        while i < self.selection_count {
            // Would check if thing is dead and remove
            // For now, just increment
            i = i + 1
        }

        // Update primary
        if self.selection_count == 0 {
            self.primary_selected = 0
        } else if !self.is_selected(self.primary_selected) {
            self.primary_selected = self.selected_ids[0]
        }
    }
}

// ============================================================================
// Camera Interface
// ============================================================================

struct Camera {
    position: Vec3,
    target: Vec3,
    view_matrix: [f32],
    projection_matrix: [f32],
    screen_width: f32,
    screen_height: f32,
}

impl Camera {
    fn init(): Camera {
        let view: [f32] = []
        let proj: [f32] = []
        for i in 0..16 {
            view = view + [0.0]
            proj = proj + [0.0]
        }
        return Camera {
            position: Vec3::init(),
            target: Vec3::init(),
            view_matrix: view,
            projection_matrix: proj,
            screen_width: 1024.0,
            screen_height: 768.0,
        }
    }

    fn screen_to_ray(&self, screen_pos: Vec2): Ray {
        // Convert screen coordinates to normalized device coordinates
        let ndc_x = (2.0 * screen_pos.x / self.screen_width) - 1.0
        let ndc_y = 1.0 - (2.0 * screen_pos.y / self.screen_height)

        // Simplified direction calculation
        let dir = Vec3 {
            x: ndc_x,
            y: ndc_y,
            z: -1.0,
        }

        return Ray {
            origin: self.position,
            direction: normalize_vec3(dir),
        }
    }

    fn world_to_screen(&self, world_pos: Vec3): Vec2 {
        // Simplified projection
        let dx = world_pos.x - self.position.x
        let dz = world_pos.z - self.position.z

        return Vec2 {
            x: self.screen_width * 0.5 + dx * 2.0,
            y: self.screen_height * 0.5 + dz * 2.0,
        }
    }
}

// ============================================================================
// Thing Interface
// ============================================================================

enum ThingStatus {
    Alive,
    Dying,
    Dead,
    BeingConstructed,
}

struct Thing {
    id: i32,
    template_index: i32,
    position: Vec3,
    player_index: i32,
    status: ThingStatus,
    is_visible: bool,
}

impl Thing {
    fn init(): Thing {
        return Thing {
            id: 0,
            template_index: 0,
            position: Vec3::init(),
            player_index: 0,
            status: ThingStatus::Alive,
            is_visible: true,
        }
    }
}

// ============================================================================
// Math Helpers
// ============================================================================

fn ray_sphere_intersect(ray: Ray, center: Vec3, radius: f32): f32 {
    let oc = Vec3 {
        x: ray.origin.x - center.x,
        y: ray.origin.y - center.y,
        z: ray.origin.z - center.z,
    }

    let a = dot_vec3(ray.direction, ray.direction)
    let b = 2.0 * dot_vec3(oc, ray.direction)
    let c = dot_vec3(oc, oc) - radius * radius

    let discriminant = b * b - 4.0 * a * c

    if discriminant < 0.0 {
        return -1.0
    }

    return (-b - sqrt_f32(discriminant)) / (2.0 * a)
}

fn dot_vec3(a: Vec3, b: Vec3): f32 {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

fn normalize_vec3(v: Vec3): Vec3 {
    let len = sqrt_f32(v.x * v.x + v.y * v.y + v.z * v.z)
    if len < 0.0001 {
        return Vec3 { x: 0.0, y: 0.0, z: 1.0 }
    }
    let inv = 1.0 / len
    return Vec3 { x: v.x * inv, y: v.y * inv, z: v.z * inv }
}

fn min_f32(a: f32, b: f32): f32 {
    if a < b { return a }
    return b
}

fn max_f32(a: f32, b: f32): f32 {
    if a > b { return a }
    return b
}

fn sqrt_f32(x: f32): f32 {
    // Newton-Raphson approximation
    if x <= 0.0 { return 0.0 }
    let guess = x / 2.0
    let result = guess
    for i in 0..10 {
        result = (result + x / result) / 2.0
    }
    return result
}

// ============================================================================
// Tests
// ============================================================================

fn test_selection_manager() {
    print("Testing Selection Manager...")

    let manager = SelectionManager::init(0)
    print("  Created selection manager for player 0")

    // Test adding to selection
    manager.add_to_selection(1)
    manager.add_to_selection(2)
    manager.add_to_selection(3)
    print("  Selection count: " + str(manager.selection_count))
    print("  Primary selected: " + str(manager.primary_selected))

    // Test is_selected
    print("  Is 2 selected: " + str(manager.is_selected(2)))
    print("  Is 5 selected: " + str(manager.is_selected(5)))

    // Test remove from selection
    manager.remove_from_selection(1)
    print("  After removing 1, count: " + str(manager.selection_count))
    print("  New primary: " + str(manager.primary_selected))

    // Test control groups
    manager.assign_control_group(1)
    print("  Assigned control group 1")

    manager.clear_selection()
    print("  Cleared selection, count: " + str(manager.selection_count))

    manager.select_control_group(1, false)
    print("  Selected control group 1, count: " + str(manager.selection_count))

    // Test box selection
    manager.begin_box_select(Vec2 { x: 100.0, y: 100.0 })
    manager.update_box_select(Vec2 { x: 200.0, y: 200.0 })
    print("  Box selection active: " + str(manager.selection_box.is_active))
    manager.end_box_select(false)
    print("  Box selection ended")

    print("Selection Manager tests complete!")
}
