// Crate System - Complete crate spawning and pickup mechanics for C&C Generals
// Based on Crate.h, CrateCollide.cpp from original W3D engine
// Implements all crate types: veterancy, money, health, shroud, salvage, sabotage, etc.

const std = @import("std")
const math = @import("math")

// ============================================================================
// Crate Types (All from original game)
// ============================================================================

pub const CrateType = enum {
    // Common crates
    MONEY,              // Cash bonus
    HEALTH,             // Health/repair
    VETERANCY,          // Experience/level up
    SHROUD,             // Reveal map area

    // GLA Salvage crates
    SALVAGE,            // GLA unit upgrades from destroyed vehicles
    SALVAGE_SMALL,      // Small salvage
    SALVAGE_MEDIUM,     // Medium salvage
    SALVAGE_LARGE,      // Large salvage

    // Special crates
    FREE_UNIT,          // Free unit spawn
    FREE_CRUSADER,      // USA tank
    FREE_BATTLEMASTER,  // China tank
    FREE_SCORPION,      // GLA tank

    // Tech upgrade crates
    ARMOR_UPGRADE,      // Armor bonus
    FIREPOWER_UPGRADE,  // Damage bonus
    SPEED_UPGRADE,      // Speed bonus
    RANGE_UPGRADE,      // Range bonus

    // Map hazard crates
    SHROUD_CLEAR,       // Clear all shroud
    REVEAL_MAP,         // Full map reveal

    // Sabotage crates (GLA)
    SABOTAGE,           // Damage to picker-upper
    BOOBY_TRAP,         // Explodes on pickup

    // Hacker crates
    CASH_HACK,          // Steal money
    INTEL,              // Reveal enemy units

    // Neutral/Special
    MYSTERY,            // Random effect
    EMPTY,              // No effect (decoy)
}

pub const CrateFaction = enum {
    NEUTRAL,            // Any player can pick up
    USA,                // USA-specific
    CHINA,              // China-specific
    GLA,                // GLA-specific (especially salvage)
}

// ============================================================================
// Crate Definition
// ============================================================================

pub const CrateDefinition = struct {
    crate_type: CrateType,
    name: []const u8,
    display_name: []const u8,
    model_name: []const u8,
    icon_name: []const u8,

    // Effects
    money_amount: i32,              // For MONEY type
    health_amount: f32,             // For HEALTH type (percentage)
    experience_points: i32,         // For VETERANCY type
    shroud_radius: f32,             // For SHROUD reveal
    damage_amount: f32,             // For SABOTAGE type

    // Spawn settings
    faction: CrateFaction,
    spawn_chance: f32,              // 0.0 to 1.0
    lifetime: f32,                  // Seconds before despawn (0 = permanent)
    pickup_radius: f32,             // Collection radius

    // Visual
    scale: f32,
    spin_rate: f32,                 // Degrees per second
    bob_height: f32,                // Vertical bob amplitude
    glow_color: [4]f32,             // RGBA glow

    // Audio
    spawn_sound: []const u8,
    pickup_sound: []const u8,

    pub fn init(crate_type: CrateType, name: []const u8) CrateDefinition {
        return .{
            .crate_type = crate_type,
            .name = name,
            .display_name = name,
            .model_name = "NBCrate",
            .icon_name = "Crate",
            .money_amount = 0,
            .health_amount = 0.0,
            .experience_points = 0,
            .shroud_radius = 0.0,
            .damage_amount = 0.0,
            .faction = .NEUTRAL,
            .spawn_chance = 1.0,
            .lifetime = 0.0,
            .pickup_radius = 20.0,
            .scale = 1.0,
            .spin_rate = 45.0,
            .bob_height = 5.0,
            .glow_color = .{ 1.0, 1.0, 1.0, 0.5 },
            .spawn_sound = "CrateSpawn",
            .pickup_sound = "CratePickup",
        }
    }
}

