// Assisted Targeting Update - Target sharing and coordination between units
// Handles priority targets, target designation, and coordinated fire

// ============================================================================
// Configuration
// ============================================================================

let MAX_SHARED_TARGETS: i32 = 10
let MAX_VISIBLE_TARGETS: i32 = 16
let MAX_DESIGNATED_TARGETS: i32 = 8
let MAX_COORDINATION_GROUP_SIZE: i32 = 16
let MAX_UNITS: i32 = 256
let MAX_TARGETS: i32 = 512

struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}

impl Vec3 {
    fn init(): Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }
}

struct AssistedTargetingConfig {
    share_range: f32,
    target_priority_decay: f32,
    max_shared_targets: i32,
    coordination_bonus: f32,
    target_lock_duration: f32,
    auto_designate: bool,
    designation_cooldown: f32,
    requires_line_of_sight: bool,
    share_with_structures: bool,
    priority_multiplier: f32,
}

impl AssistedTargetingConfig {
    fn init(): AssistedTargetingConfig {
        return AssistedTargetingConfig {
            share_range: 200.0,
            target_priority_decay: 0.1,
            max_shared_targets: 10,
            coordination_bonus: 1.25,
            target_lock_duration: 5.0,
            auto_designate: true,
            designation_cooldown: 10.0,
            requires_line_of_sight: true,
            share_with_structures: false,
            priority_multiplier: 1.5,
        }
    }
}

// ============================================================================
// Target Priority System
// ============================================================================

enum TargetPriority {
    Low,
    Normal,
    High,
    Critical,
    Designated,
}

fn priority_to_value(priority: TargetPriority): f32 {
    if priority == TargetPriority::Low { return 1.0 }
    if priority == TargetPriority::Normal { return 2.0 }
    if priority == TargetPriority::High { return 3.0 }
    if priority == TargetPriority::Critical { return 4.0 }
    if priority == TargetPriority::Designated { return 5.0 }
    return 2.0
}

enum TargetType {
    Infantry,
    Vehicle,
    Aircraft,
    Structure,
    Harvester,
    Artillery,
    AntiAir,
    CommandUnit,
    Superweapon,
}

fn target_type_to_index(target_type: TargetType): i32 {
    if target_type == TargetType::Infantry { return 0 }
    if target_type == TargetType::Vehicle { return 1 }
    if target_type == TargetType::Aircraft { return 2 }
    if target_type == TargetType::Structure { return 3 }
    if target_type == TargetType::Harvester { return 4 }
    if target_type == TargetType::Artillery { return 5 }
    if target_type == TargetType::AntiAir { return 6 }
    if target_type == TargetType::CommandUnit { return 7 }
    if target_type == TargetType::Superweapon { return 8 }
    return 0
}

struct TargetInfo {
    target_id: i64,
    target_type: TargetType,
    position: Vec3,
    priority: TargetPriority,
    priority_value: f32,
    health_percent: f32,
    threat_level: f32,
    time_since_seen: f32,
    is_designated: bool,
    designated_by: i64,
    attackers_count: i32,
    last_damage_time: f32,
    is_valid: bool,
}

impl TargetInfo {
    fn init(): TargetInfo {
        return TargetInfo {
            target_id: 0,
            target_type: TargetType::Infantry,
            position: Vec3::init(),
            priority: TargetPriority::Normal,
            priority_value: 2.0,
            health_percent: 1.0,
            threat_level: 1.0,
            time_since_seen: 0.0,
            is_designated: false,
            designated_by: 0,
            attackers_count: 0,
            last_damage_time: 0.0,
            is_valid: false,
        }
    }
}

fn create_target_info(target_id: i64, target_type: TargetType, position: Vec3): TargetInfo {
    return TargetInfo {
        target_id: target_id,
        target_type: target_type,
        position: position,
        priority: TargetPriority::Normal,
        priority_value: 2.0,
        health_percent: 1.0,
        threat_level: 1.0,
        time_since_seen: 0.0,
        is_designated: false,
        designated_by: 0,
        attackers_count: 0,
        last_damage_time: 0.0,
        is_valid: true,
    }
}

// ============================================================================
// Target Priority Matrix
// ============================================================================

struct PriorityMatrix {
    // Priority values for unit types vs target types (9 target types)
    infantry_vs: [f32],
    vehicle_vs: [f32],
    aircraft_vs: [f32],
    antiair_vs: [f32],
    artillery_vs: [f32],
}

impl PriorityMatrix {
    fn init(): PriorityMatrix {
        // Initialize arrays with 9 elements each
        let infantry: [f32] = []
        let vehicle: [f32] = []
        let aircraft: [f32] = []
        let antiair: [f32] = []
        let artillery: [f32] = []

        for i in 0..9 {
            infantry = infantry + [1.0]
            vehicle = vehicle + [1.0]
            aircraft = aircraft + [1.0]
            antiair = antiair + [1.0]
            artillery = artillery + [1.0]
        }

        return PriorityMatrix {
            infantry_vs: infantry,
            vehicle_vs: vehicle,
            aircraft_vs: aircraft,
            antiair_vs: antiair,
            artillery_vs: artillery,
        }
    }
}

fn create_default_priority_matrix(): PriorityMatrix {
    let matrix = PriorityMatrix::init()

    // Infantry priorities: Infantry, Vehicle, Aircraft, Structure, Harvester, Artillery, AntiAir, CommandUnit, Superweapon
    matrix.infantry_vs[0] = 1.5
    matrix.infantry_vs[1] = 0.5
    matrix.infantry_vs[2] = 0.3
    matrix.infantry_vs[3] = 1.0
    matrix.infantry_vs[4] = 2.0
    matrix.infantry_vs[5] = 1.8
    matrix.infantry_vs[6] = 1.5
    matrix.infantry_vs[7] = 2.5
    matrix.infantry_vs[8] = 3.0

    // Vehicle priorities
    matrix.vehicle_vs[0] = 1.0
    matrix.vehicle_vs[1] = 1.2
    matrix.vehicle_vs[2] = 0.5
    matrix.vehicle_vs[3] = 1.5
    matrix.vehicle_vs[4] = 2.0
    matrix.vehicle_vs[5] = 1.5
    matrix.vehicle_vs[6] = 1.2
    matrix.vehicle_vs[7] = 2.5
    matrix.vehicle_vs[8] = 3.0

    // Aircraft priorities
    matrix.aircraft_vs[0] = 0.8
    matrix.aircraft_vs[1] = 1.5
    matrix.aircraft_vs[2] = 1.5
    matrix.aircraft_vs[3] = 2.0
    matrix.aircraft_vs[4] = 2.5
    matrix.aircraft_vs[5] = 2.0
    matrix.aircraft_vs[6] = 0.5
    matrix.aircraft_vs[7] = 2.5
    matrix.aircraft_vs[8] = 3.0

    // AntiAir priorities
    matrix.antiair_vs[0] = 0.5
    matrix.antiair_vs[1] = 0.5
    matrix.antiair_vs[2] = 3.0
    matrix.antiair_vs[3] = 0.3
    matrix.antiair_vs[4] = 0.5
    matrix.antiair_vs[5] = 0.8
    matrix.antiair_vs[6] = 0.5
    matrix.antiair_vs[7] = 1.0
    matrix.antiair_vs[8] = 0.5

    // Artillery priorities
    matrix.artillery_vs[0] = 1.2
    matrix.artillery_vs[1] = 1.0
    matrix.artillery_vs[2] = 0.3
    matrix.artillery_vs[3] = 2.5
    matrix.artillery_vs[4] = 1.5
    matrix.artillery_vs[5] = 2.0
    matrix.artillery_vs[6] = 1.8
    matrix.artillery_vs[7] = 3.0
    matrix.artillery_vs[8] = 3.5

    return matrix
}

fn get_priority_for_target(matrix: PriorityMatrix, attacker_type: TargetType, target_type: TargetType): f32 {
    let target_index = target_type_to_index(target_type)

    if attacker_type == TargetType::Infantry {
        return matrix.infantry_vs[target_index]
    }
    if attacker_type == TargetType::Vehicle {
        return matrix.vehicle_vs[target_index]
    }
    if attacker_type == TargetType::Aircraft {
        return matrix.aircraft_vs[target_index]
    }
    if attacker_type == TargetType::AntiAir {
        return matrix.antiair_vs[target_index]
    }
    if attacker_type == TargetType::Artillery {
        return matrix.artillery_vs[target_index]
    }

    return 1.0
}

// ============================================================================
// Unit Targeting State
// ============================================================================

struct UnitTargetingState {
    unit_id: i64,
    unit_type: TargetType,
    position: Vec3,
    weapon_range: f32,
    current_target_id: i64,
    target_lock_time: f32,
    visible_targets: [i64],
    visible_count: i32,
    shared_targets: [i64],
    shared_count: i32,
    can_designate: bool,
    designation_cooldown: f32,
    is_coordinating: bool,
    coordination_group: i64,
    is_valid: bool,
}

impl UnitTargetingState {
    fn init(): UnitTargetingState {
        let visible: [i64] = []
        let shared: [i64] = []
        for i in 0..MAX_VISIBLE_TARGETS {
            visible = visible + [0]
            shared = shared + [0]
        }

        return UnitTargetingState {
            unit_id: 0,
            unit_type: TargetType::Infantry,
            position: Vec3::init(),
            weapon_range: 100.0,
            current_target_id: 0,
            target_lock_time: 0.0,
            visible_targets: visible,
            visible_count: 0,
            shared_targets: shared,
            shared_count: 0,
            can_designate: true,
            designation_cooldown: 0.0,
            is_coordinating: false,
            coordination_group: 0,
            is_valid: false,
        }
    }
}

fn create_unit_targeting_state(unit_id: i64, unit_type: TargetType, position: Vec3, weapon_range: f32): UnitTargetingState {
    let state = UnitTargetingState::init()
    state.unit_id = unit_id
    state.unit_type = unit_type
    state.position = position
    state.weapon_range = weapon_range
    state.is_valid = true
    return state
}

// ============================================================================
// Coordination Group
// ============================================================================

struct CoordinationGroup {
    group_id: i64,
    unit_ids: [i64],
    unit_count: i32,
    is_valid: bool,
}

impl CoordinationGroup {
    fn init(): CoordinationGroup {
        let units: [i64] = []
        for i in 0..MAX_COORDINATION_GROUP_SIZE {
            units = units + [0]
        }
        return CoordinationGroup {
            group_id: 0,
            unit_ids: units,
            unit_count: 0,
            is_valid: false,
        }
    }
}

// ============================================================================
// Assisted Targeting Module
// ============================================================================

struct AssistedTargetingUpdateModule {
    config: AssistedTargetingConfig,
    priority_matrix: PriorityMatrix,

    // Global target pool
    targets: [TargetInfo],
    target_count: i32,

    // Designated targets
    designated_targets: [i64],
    designated_count: i32,

    // Unit states
    unit_states: [UnitTargetingState],
    unit_count: i32,

    // Coordination groups
    coordination_groups: [CoordinationGroup],
    group_count: i32,

    // Callback flags (since Home doesn't support function pointers)
    has_designation_callback: bool,
    has_elimination_callback: bool,
    has_coordination_callback: bool,
}

impl AssistedTargetingUpdateModule {
    fn init(): AssistedTargetingUpdateModule {
        let tgts: [TargetInfo] = []
        for i in 0..MAX_TARGETS {
            tgts = tgts + [TargetInfo::init()]
        }

        let designated: [i64] = []
        for i in 0..MAX_DESIGNATED_TARGETS {
            designated = designated + [0]
        }

        let units: [UnitTargetingState] = []
        for i in 0..MAX_UNITS {
            units = units + [UnitTargetingState::init()]
        }

        let groups: [CoordinationGroup] = []
        for i in 0..32 {
            groups = groups + [CoordinationGroup::init()]
        }

        return AssistedTargetingUpdateModule {
            config: AssistedTargetingConfig::init(),
            priority_matrix: create_default_priority_matrix(),
            targets: tgts,
            target_count: 0,
            designated_targets: designated,
            designated_count: 0,
            unit_states: units,
            unit_count: 0,
            coordination_groups: groups,
            group_count: 0,
            has_designation_callback: false,
            has_elimination_callback: false,
            has_coordination_callback: false,
        }
    }
}

fn create_assisted_targeting_module(config: AssistedTargetingConfig): AssistedTargetingUpdateModule {
    let module = AssistedTargetingUpdateModule::init()
    module.config = config
    return module
}

// ============================================================================
// Unit Registration
// ============================================================================

fn register_unit(module: AssistedTargetingUpdateModule, unit_id: i64, unit_type: TargetType, position: Vec3, weapon_range: f32) {
    if module.unit_count >= MAX_UNITS {
        return
    }

    let state = create_unit_targeting_state(unit_id, unit_type, position, weapon_range)
    module.unit_states[module.unit_count] = state
    module.unit_count = module.unit_count + 1
}

fn unregister_unit(module: AssistedTargetingUpdateModule, unit_id: i64) {
    for i in 0..module.unit_count {
        if module.unit_states[i].unit_id == unit_id {
            module.unit_states[i].is_valid = false
            return
        }
    }
}

fn find_unit_state(module: AssistedTargetingUpdateModule, unit_id: i64): UnitTargetingState? {
    for i in 0..module.unit_count {
        if module.unit_states[i].unit_id == unit_id && module.unit_states[i].is_valid {
            return module.unit_states[i]
        }
    }
    return null
}

// ============================================================================
// Target Management
// ============================================================================

fn add_target(module: AssistedTargetingUpdateModule, target_id: i64, target_type: TargetType, position: Vec3) {
    // Check if target already exists
    for i in 0..module.target_count {
        if module.targets[i].target_id == target_id && module.targets[i].is_valid {
            // Update position
            module.targets[i].position = position
            module.targets[i].time_since_seen = 0.0
            return
        }
    }

    // Add new target
    if module.target_count >= MAX_TARGETS {
        return
    }

    let target = create_target_info(target_id, target_type, position)
    module.targets[module.target_count] = target
    module.target_count = module.target_count + 1
}

fn remove_target(module: AssistedTargetingUpdateModule, target_id: i64) {
    for i in 0..module.target_count {
        if module.targets[i].target_id == target_id {
            module.targets[i].is_valid = false

            // Trigger elimination callback
            if module.has_elimination_callback {
                on_target_eliminated(module, target_id)
            }
            return
        }
    }
}

fn find_target(module: AssistedTargetingUpdateModule, target_id: i64): TargetInfo? {
    for i in 0..module.target_count {
        if module.targets[i].target_id == target_id && module.targets[i].is_valid {
            return module.targets[i]
        }
    }
    return null
}

fn on_target_eliminated(module: AssistedTargetingUpdateModule, target_id: i64) {
    // Clear from designated targets
    for i in 0..module.designated_count {
        if module.designated_targets[i] == target_id {
            // Shift remaining
            for j in i..(module.designated_count - 1) {
                module.designated_targets[j] = module.designated_targets[j + 1]
            }
            module.designated_count = module.designated_count - 1
            break
        }
    }

    // Clear from unit current targets
    for i in 0..module.unit_count {
        if module.unit_states[i].current_target_id == target_id {
            module.unit_states[i].current_target_id = 0
            module.unit_states[i].target_lock_time = 0.0
        }
    }
}

// ============================================================================
// Target Designation
// ============================================================================

fn designate_target(module: AssistedTargetingUpdateModule, target_id: i64, designator_id: i64): bool {
    // Find target
    let target = find_target(module, target_id)
    if target == null {
        return false
    }

    // Check if already designated
    for i in 0..module.designated_count {
        if module.designated_targets[i] == target_id {
            return true
        }
    }

    // Add to designated list
    if module.designated_count >= MAX_DESIGNATED_TARGETS {
        // Remove oldest designation
        for i in 0..(module.designated_count - 1) {
            module.designated_targets[i] = module.designated_targets[i + 1]
        }
        module.designated_count = module.designated_count - 1
    }

    module.designated_targets[module.designated_count] = target_id
    module.designated_count = module.designated_count + 1

    // Update target info
    let tgt = find_target(module, target_id)
    if tgt != null {
        tgt.is_designated = true
        tgt.designated_by = designator_id
        tgt.priority = TargetPriority::Designated
        tgt.priority_value = priority_to_value(TargetPriority::Designated) * module.config.priority_multiplier
    }

    // Trigger callback
    if module.has_designation_callback {
        on_target_designated(module, target_id, designator_id)
    }

    return true
}

fn on_target_designated(module: AssistedTargetingUpdateModule, target_id: i64, designator_id: i64) {
    // Share designated target with nearby allies
    let designator = find_unit_state(module, designator_id)
    if designator == null {
        return
    }

    let target = find_target(module, target_id)
    if target == null {
        return
    }

    // Share with units in range
    for i in 0..module.unit_count {
        let unit = module.unit_states[i]
        if !unit.is_valid || unit.unit_id == designator_id {
            continue
        }

        let dx = unit.position.x - designator.position.x
        let dy = unit.position.y - designator.position.y
        let dz = unit.position.z - designator.position.z
        let dist_sq = dx * dx + dy * dy + dz * dz

        if dist_sq <= module.config.share_range * module.config.share_range {
            add_shared_target(unit, target_id)
        }
    }
}

fn add_shared_target(state: UnitTargetingState, target_id: i64) {
    // Check if already in shared list
    for i in 0..state.shared_count {
        if state.shared_targets[i] == target_id {
            return
        }
    }

    if state.shared_count >= MAX_VISIBLE_TARGETS {
        return
    }

    state.shared_targets[state.shared_count] = target_id
    state.shared_count = state.shared_count + 1
}

fn undesignate_target(module: AssistedTargetingUpdateModule, target_id: i64) {
    for i in 0..module.designated_count {
        if module.designated_targets[i] == target_id {
            // Shift remaining
            for j in i..(module.designated_count - 1) {
                module.designated_targets[j] = module.designated_targets[j + 1]
            }
            module.designated_count = module.designated_count - 1

            // Update target info
            let target = find_target(module, target_id)
            if target != null {
                target.is_designated = false
                target.designated_by = 0
                target.priority = TargetPriority::Normal
                target.priority_value = priority_to_value(TargetPriority::Normal)
            }
            return
        }
    }
}

// ============================================================================
// Target Selection
// ============================================================================

fn select_best_target(module: AssistedTargetingUpdateModule, unit_id: i64): i64 {
    let state = find_unit_state(module, unit_id)
    if state == null {
        return 0
    }

    let best_target_id: i64 = 0
    let best_score: f32 = 0.0

    // Check designated targets first
    for i in 0..module.designated_count {
        let target_id = module.designated_targets[i]
        let target = find_target(module, target_id)
        if target == null || !target.is_valid {
            continue
        }

        let score = calculate_target_score(module, state, target)
        if score > best_score {
            best_score = score
            best_target_id = target_id
        }
    }

    // If designated target found with good score, use it
    if best_target_id != 0 && best_score > 5.0 {
        return best_target_id
    }

    // Check visible targets
    for i in 0..state.visible_count {
        let target_id = state.visible_targets[i]
        let target = find_target(module, target_id)
        if target == null || !target.is_valid {
            continue
        }

        let score = calculate_target_score(module, state, target)
        if score > best_score {
            best_score = score
            best_target_id = target_id
        }
    }

    // Check shared targets
    for i in 0..state.shared_count {
        let target_id = state.shared_targets[i]
        let target = find_target(module, target_id)
        if target == null || !target.is_valid {
            continue
        }

        let score = calculate_target_score(module, state, target)
        if score > best_score {
            best_score = score
            best_target_id = target_id
        }
    }

    return best_target_id
}

fn calculate_target_score(module: AssistedTargetingUpdateModule, state: UnitTargetingState, target: TargetInfo): f32 {
    // Base priority from matrix
    let base_priority = get_priority_for_target(module.priority_matrix, state.unit_type, target.target_type)

    // Apply target's priority value
    let score = base_priority * target.priority_value

    // Distance factor (prefer closer targets)
    let dx = target.position.x - state.position.x
    let dy = target.position.y - state.position.y
    let dz = target.position.z - state.position.z
    let dist_sq = dx * dx + dy * dy + dz * dz
    let dist = sqrt_f32(dist_sq)

    if dist > state.weapon_range {
        score = score * 0.5
    } else {
        let range_factor = 1.0 - (dist / state.weapon_range) * 0.3
        score = score * range_factor
    }

    // Health factor (prefer damaged targets)
    let health_factor = 2.0 - target.health_percent
    score = score * health_factor

    // Threat factor
    score = score * target.threat_level

    // Coordination bonus (prefer targets being attacked by allies)
    if target.attackers_count > 0 {
        score = score * module.config.coordination_bonus
    }

    // Freshness factor (prefer recently seen targets)
    if target.time_since_seen > 5.0 {
        score = score * 0.5
    }

    return score
}

// ============================================================================
// Update
// ============================================================================

fn update_assisted_targeting(module: AssistedTargetingUpdateModule, delta_time: f32) {
    // Update target decay
    for i in 0..module.target_count {
        if !module.targets[i].is_valid {
            continue
        }

        module.targets[i].time_since_seen = module.targets[i].time_since_seen + delta_time

        // Decay priority over time
        if !module.targets[i].is_designated {
            module.targets[i].priority_value = module.targets[i].priority_value - module.config.target_priority_decay * delta_time
            if module.targets[i].priority_value < 1.0 {
                module.targets[i].priority_value = 1.0
            }
        }

        // Remove stale targets
        if module.targets[i].time_since_seen > 30.0 {
            module.targets[i].is_valid = false
        }
    }

    // Update unit states
    for i in 0..module.unit_count {
        if !module.unit_states[i].is_valid {
            continue
        }

        // Update designation cooldown
        if module.unit_states[i].designation_cooldown > 0.0 {
            module.unit_states[i].designation_cooldown = module.unit_states[i].designation_cooldown - delta_time
            if module.unit_states[i].designation_cooldown < 0.0 {
                module.unit_states[i].designation_cooldown = 0.0
                module.unit_states[i].can_designate = true
            }
        }

        // Update target lock
        if module.unit_states[i].current_target_id != 0 {
            module.unit_states[i].target_lock_time = module.unit_states[i].target_lock_time + delta_time

            // Check if target still valid
            let target = find_target(module, module.unit_states[i].current_target_id)
            if target == null || !target.is_valid {
                module.unit_states[i].current_target_id = 0
                module.unit_states[i].target_lock_time = 0.0
            } else if module.unit_states[i].target_lock_time > module.config.target_lock_duration {
                // Target lock expired, allow retargeting
                module.unit_states[i].target_lock_time = 0.0
            }
        }
    }

    // Auto-designate high-value targets
    if module.config.auto_designate {
        auto_designate_targets(module)
    }
}

fn auto_designate_targets(module: AssistedTargetingUpdateModule) {
    // Find high-value undesignated targets
    for i in 0..module.target_count {
        let target = module.targets[i]
        if !target.is_valid || target.is_designated {
            continue
        }

        // Check if target type warrants auto-designation
        let should_designate = false
        if target.target_type == TargetType::CommandUnit {
            should_designate = true
        } else if target.target_type == TargetType::Superweapon {
            should_designate = true
        } else if target.target_type == TargetType::Artillery && target.attackers_count == 0 {
            should_designate = true
        }

        if should_designate && module.designated_count < MAX_DESIGNATED_TARGETS {
            designate_target(module, target.target_id, 0)
        }
    }
}

// ============================================================================
// Coordination Groups
// ============================================================================

fn create_coordination_group(module: AssistedTargetingUpdateModule, unit_ids: [i64], count: i32): i64 {
    if module.group_count >= 32 {
        return 0
    }

    let group_id: i64 = (module.group_count + 1) as i64

    let group = CoordinationGroup::init()
    group.group_id = group_id
    group.is_valid = true

    for i in 0..count {
        if i >= MAX_COORDINATION_GROUP_SIZE {
            break
        }
        group.unit_ids[i] = unit_ids[i]
        group.unit_count = group.unit_count + 1

        // Update unit state
        let state = find_unit_state(module, unit_ids[i])
        if state != null {
            state.is_coordinating = true
            state.coordination_group = group_id
        }
    }

    module.coordination_groups[module.group_count] = group
    module.group_count = module.group_count + 1

    if module.has_coordination_callback {
        // Trigger coordination started callback
    }

    return group_id
}

fn disband_coordination_group(module: AssistedTargetingUpdateModule, group_id: i64) {
    for i in 0..module.group_count {
        if module.coordination_groups[i].group_id == group_id {
            let group = module.coordination_groups[i]

            // Clear unit states
            for j in 0..group.unit_count {
                let state = find_unit_state(module, group.unit_ids[j])
                if state != null {
                    state.is_coordinating = false
                    state.coordination_group = 0
                }
            }

            group.is_valid = false
            return
        }
    }
}

// ============================================================================
// Utility Functions
// ============================================================================

fn sqrt_f32(x: f32): f32 {
    if x <= 0.0 { return 0.0 }
    let guess = x / 2.0
    let result = guess
    for i in 0..10 {
        result = (result + x / result) / 2.0
    }
    return result
}

fn update_unit_position(module: AssistedTargetingUpdateModule, unit_id: i64, position: Vec3) {
    let state = find_unit_state(module, unit_id)
    if state != null {
        state.position = position
    }
}

fn update_target_health(module: AssistedTargetingUpdateModule, target_id: i64, health_percent: f32) {
    let target = find_target(module, target_id)
    if target != null {
        target.health_percent = health_percent
    }
}

fn add_visible_target(module: AssistedTargetingUpdateModule, unit_id: i64, target_id: i64) {
    let state = find_unit_state(module, unit_id)
    if state == null {
        return
    }

    // Check if already visible
    for i in 0..state.visible_count {
        if state.visible_targets[i] == target_id {
            return
        }
    }

    if state.visible_count >= MAX_VISIBLE_TARGETS {
        return
    }

    state.visible_targets[state.visible_count] = target_id
    state.visible_count = state.visible_count + 1
}

fn remove_visible_target(module: AssistedTargetingUpdateModule, unit_id: i64, target_id: i64) {
    let state = find_unit_state(module, unit_id)
    if state == null {
        return
    }

    for i in 0..state.visible_count {
        if state.visible_targets[i] == target_id {
            // Shift remaining
            for j in i..(state.visible_count - 1) {
                state.visible_targets[j] = state.visible_targets[j + 1]
            }
            state.visible_count = state.visible_count - 1
            return
        }
    }
}

fn increment_attackers(module: AssistedTargetingUpdateModule, target_id: i64) {
    let target = find_target(module, target_id)
    if target != null {
        target.attackers_count = target.attackers_count + 1
    }
}

fn decrement_attackers(module: AssistedTargetingUpdateModule, target_id: i64) {
    let target = find_target(module, target_id)
    if target != null && target.attackers_count > 0 {
        target.attackers_count = target.attackers_count - 1
    }
}

// ============================================================================
// Tests
// ============================================================================

fn test_assisted_targeting() {
    print("Testing Assisted Targeting Update...")

    let config = AssistedTargetingConfig::init()
    let module = create_assisted_targeting_module(config)
    print("  Created targeting module")

    // Register some units
    register_unit(module, 1, TargetType::Infantry, Vec3 { x: 0.0, y: 0.0, z: 0.0 }, 100.0)
    register_unit(module, 2, TargetType::Vehicle, Vec3 { x: 50.0, y: 0.0, z: 0.0 }, 150.0)
    print("  Registered 2 units")

    // Add some targets
    add_target(module, 100, TargetType::Vehicle, Vec3 { x: 80.0, y: 0.0, z: 0.0 })
    add_target(module, 101, TargetType::Infantry, Vec3 { x: 60.0, y: 0.0, z: 0.0 })
    print("  Added 2 targets")

    // Make targets visible to unit 1
    add_visible_target(module, 1, 100)
    add_visible_target(module, 1, 101)

    // Select best target for unit 1
    let best = select_best_target(module, 1)
    print("  Best target for unit 1: " + str(best))

    // Designate a target
    designate_target(module, 100, 1)
    print("  Designated target 100")

    // Update
    update_assisted_targeting(module, 0.1)
    print("  Updated targeting system")

    // Create coordination group
    let group_units: [i64] = []
    group_units = group_units + [1]
    group_units = group_units + [2]
    let group_id = create_coordination_group(module, group_units, 2)
    print("  Created coordination group: " + str(group_id))

    print("Assisted Targeting tests complete!")
}
