// C&C Generals Zero Hour - Particle Editor Tool
// Complete particle system editor for creating and modifying effects
//
// Features:
// - W15-020: Particle preview with real-time rendering
// - W15-021: Emitter property editing
// - W15-022: Velocity/physics editing
// - W15-023: Shader/material editing
// - W15-024: Particle system export

// ============================================================================
// PARTICLE PREVIEW (W15-020)
// ============================================================================

enum PreviewBackgroundType {
    Solid
    Gradient
    Checkerboard
    Skybox
    Custom
}

struct ParticlePreviewSettings {
    background_type: PreviewBackgroundType
    background_color: [f32; 4]
    gradient_top: [f32; 4]
    gradient_bottom: [f32; 4]
    grid_visible: bool
    grid_size: f32
    axis_visible: bool
    camera_distance: f32
    camera_rotation: [f32; 2]
    playback_speed: f32
    loop_preview: bool

    fn default(): ParticlePreviewSettings {
        return ParticlePreviewSettings {
            background_type: PreviewBackgroundType::Gradient
            background_color: [0.2, 0.2, 0.2, 1.0]
            gradient_top: [0.3, 0.3, 0.4, 1.0]
            gradient_bottom: [0.1, 0.1, 0.15, 1.0]
            grid_visible: true
            grid_size: 1.0
            axis_visible: true
            camera_distance: 10.0
            camera_rotation: [30.0, 45.0]
            playback_speed: 1.0
            loop_preview: true
        }
    }
}

struct ParticlePreviewState {
    is_playing: bool
    current_time: f32
    total_duration: f32
    active_particles: u32
    peak_particles: u32
    frame_time_ms: f32

    fn init(): ParticlePreviewState {
        return ParticlePreviewState {
            is_playing: true
            current_time: 0.0
            total_duration: 0.0
            active_particles: 0
            peak_particles: 0
            frame_time_ms: 0.0
        }
    }

    fn reset(&self) {
        self.current_time = 0.0
        self.active_particles = 0
        self.peak_particles = 0
    }
}

struct ParticlePreview {
    settings: ParticlePreviewSettings
    state: ParticlePreviewState
    viewport_width: u32
    viewport_height: u32

    fn init(width: u32, height: u32): ParticlePreview {
        return ParticlePreview {
            settings: ParticlePreviewSettings.default()
            state: ParticlePreviewState.init()
            viewport_width: width
            viewport_height: height
        }
    }

    fn update(&self, delta_time: f32) {
        if self.state.is_playing {
            self.state.current_time = self.state.current_time + delta_time * self.settings.playback_speed

            if self.settings.loop_preview and self.state.total_duration > 0.0 {
                if self.state.current_time >= self.state.total_duration {
                    self.state.current_time = 0.0
                }
            }
        }
    }

    fn play(&self) {
        self.state.is_playing = true
    }

    fn pause(&self) {
        self.state.is_playing = false
    }

    fn stop(&self) {
        self.state.is_playing = false
        self.state.reset()
    }

    fn restart(&self) {
        self.state.reset()
        self.state.is_playing = true
    }

    fn set_time(&self, time: f32) {
        self.state.current_time = time
    }
}

// ============================================================================
// EMITTER EDITING (W15-021)
// ============================================================================

enum EmitterShape {
    Point
    Line
    Circle
    Sphere
    Box
    Cylinder
    Cone
    Mesh
}

enum EmissionMode {
    Continuous
    Burst
    Distance
    Event
}

struct EmitterShapeParams {
    shape: EmitterShape
    // Point - no params
    // Line
    line_length: f32
    line_direction: [f32; 3]
    // Circle/Cylinder
    radius: f32
    inner_radius: f32
    // Sphere
    sphere_radius: f32
    emit_from_surface: bool
    // Box
    box_size: [f32; 3]
    // Cone
    cone_angle: f32
    cone_length: f32

    fn default(): EmitterShapeParams {
        return EmitterShapeParams {
            shape: EmitterShape::Point
            line_length: 1.0
            line_direction: [0.0, 1.0, 0.0]
            radius: 1.0
            inner_radius: 0.0
            sphere_radius: 1.0
            emit_from_surface: false
            box_size: [1.0, 1.0, 1.0]
            cone_angle: 30.0
            cone_length: 2.0
        }
    }
}

struct EmissionParams {
    mode: EmissionMode
    rate: f32                    // Particles per second (Continuous)
    burst_count: u32             // Particles per burst
    burst_interval: f32          // Time between bursts
    distance_interval: f32       // Distance between emissions
    max_particles: u32
    lifetime_min: f32
    lifetime_max: f32
    start_delay: f32
    duration: f32                // 0 = infinite

    fn default(): EmissionParams {
        return EmissionParams {
            mode: EmissionMode::Continuous
            rate: 50.0
            burst_count: 10
            burst_interval: 0.5
            distance_interval: 1.0
            max_particles: 1000
            lifetime_min: 1.0
            lifetime_max: 2.0
            start_delay: 0.0
            duration: 0.0
        }
    }
}

struct ColorOverLifetime {
    enabled: bool
    gradient_keys: [ColorKey; 8]
    num_keys: u32

    fn default(): ColorOverLifetime {
        var col = ColorOverLifetime {
            enabled: true
            gradient_keys: undefined
            num_keys: 2
        }
        col.gradient_keys[0] = ColorKey { time: 0.0, color: [1.0, 1.0, 1.0, 1.0] }
        col.gradient_keys[1] = ColorKey { time: 1.0, color: [1.0, 1.0, 1.0, 0.0] }
        return col
    }

    fn evaluate(&self, t: f32): [f32; 4] {
        if self.num_keys == 0 {
            return [1.0, 1.0, 1.0, 1.0]
        }
        if self.num_keys == 1 or t <= self.gradient_keys[0].time {
            return self.gradient_keys[0].color
        }
        if t >= self.gradient_keys[self.num_keys - 1].time {
            return self.gradient_keys[self.num_keys - 1].color
        }

        for i in 0..self.num_keys - 1 {
            let k0 = self.gradient_keys[i]
            let k1 = self.gradient_keys[i + 1]
            if t >= k0.time and t < k1.time {
                let blend = (t - k0.time) / (k1.time - k0.time)
                return [
                    k0.color[0] + blend * (k1.color[0] - k0.color[0]),
                    k0.color[1] + blend * (k1.color[1] - k0.color[1]),
                    k0.color[2] + blend * (k1.color[2] - k0.color[2]),
                    k0.color[3] + blend * (k1.color[3] - k0.color[3])
                ]
            }
        }
        return [1.0, 1.0, 1.0, 1.0]
    }
}

struct ColorKey {
    time: f32
    color: [f32; 4]
}

struct SizeOverLifetime {
    enabled: bool
    curve_keys: [SizeKey; 8]
    num_keys: u32
    size_multiplier: f32

    fn default(): SizeOverLifetime {
        var size = SizeOverLifetime {
            enabled: true
            curve_keys: undefined
            num_keys: 2
            size_multiplier: 1.0
        }
        size.curve_keys[0] = SizeKey { time: 0.0, size: 0.5 }
        size.curve_keys[1] = SizeKey { time: 1.0, size: 1.5 }
        return size
    }

    fn evaluate(&self, t: f32): f32 {
        if self.num_keys == 0 {
            return self.size_multiplier
        }
        if self.num_keys == 1 or t <= self.curve_keys[0].time {
            return self.curve_keys[0].size * self.size_multiplier
        }
        if t >= self.curve_keys[self.num_keys - 1].time {
            return self.curve_keys[self.num_keys - 1].size * self.size_multiplier
        }

        for i in 0..self.num_keys - 1 {
            let k0 = self.curve_keys[i]
            let k1 = self.curve_keys[i + 1]
            if t >= k0.time and t < k1.time {
                let blend = (t - k0.time) / (k1.time - k0.time)
                return (k0.size + blend * (k1.size - k0.size)) * self.size_multiplier
            }
        }
        return self.size_multiplier
    }
}

struct SizeKey {
    time: f32
    size: f32
}

struct EmitterDefinition {
    name: string
    shape: EmitterShapeParams
    emission: EmissionParams
    color_over_lifetime: ColorOverLifetime
    size_over_lifetime: SizeOverLifetime
    rotation_over_lifetime: RotationOverLifetime
    texture_animation: TextureAnimation

    fn init(name: string): EmitterDefinition {
        return EmitterDefinition {
            name: name
            shape: EmitterShapeParams.default()
            emission: EmissionParams.default()
            color_over_lifetime: ColorOverLifetime.default()
            size_over_lifetime: SizeOverLifetime.default()
            rotation_over_lifetime: RotationOverLifetime.default()
            texture_animation: TextureAnimation.default()
        }
    }
}

struct RotationOverLifetime {
    enabled: bool
    angular_velocity_min: f32
    angular_velocity_max: f32
    align_to_velocity: bool

    fn default(): RotationOverLifetime {
        return RotationOverLifetime {
            enabled: false
            angular_velocity_min: 0.0
            angular_velocity_max: 0.0
            align_to_velocity: false
        }
    }
}

struct TextureAnimation {
    enabled: bool
    rows: u32
    columns: u32
    frame_rate: f32
    start_frame: u32
    loop_animation: bool
    random_start: bool

    fn default(): TextureAnimation {
        return TextureAnimation {
            enabled: false
            rows: 1
            columns: 1
            frame_rate: 30.0
            start_frame: 0
            loop_animation: true
            random_start: false
        }
    }
}

// ============================================================================
// VELOCITY/PHYSICS EDITING (W15-022)
// ============================================================================

struct VelocityParams {
    initial_speed_min: f32
    initial_speed_max: f32
    direction: [f32; 3]
    direction_randomness: f32
    inherit_velocity: f32
    radial_velocity: f32

    fn default(): VelocityParams {
        return VelocityParams {
            initial_speed_min: 1.0
            initial_speed_max: 3.0
            direction: [0.0, 1.0, 0.0]
            direction_randomness: 0.2
            inherit_velocity: 0.0
            radial_velocity: 0.0
        }
    }
}

struct PhysicsParams {
    gravity: [f32; 3]
    drag: f32
    turbulence_strength: f32
    turbulence_frequency: f32
    wind: [f32; 3]
    collision_enabled: bool
    collision_bounce: f32
    collision_friction: f32
    collision_lifetime_loss: f32

    fn default(): PhysicsParams {
        return PhysicsParams {
            gravity: [0.0, -9.8, 0.0]
            drag: 0.1
            turbulence_strength: 0.0
            turbulence_frequency: 1.0
            wind: [0.0, 0.0, 0.0]
            collision_enabled: false
            collision_bounce: 0.5
            collision_friction: 0.2
            collision_lifetime_loss: 0.1
        }
    }
}

struct VelocityOverLifetime {
    enabled: bool
    velocity_multiplier_keys: [VelocityKey; 8]
    num_keys: u32
    orbital_velocity: [f32; 3]
    radial_velocity_curve: bool

    fn default(): VelocityOverLifetime {
        return VelocityOverLifetime {
            enabled: false
            velocity_multiplier_keys: undefined
            num_keys: 0
            orbital_velocity: [0.0, 0.0, 0.0]
            radial_velocity_curve: false
        }
    }
}

struct VelocityKey {
    time: f32
    multiplier: f32
}

struct ForceField {
    field_type: ForceFieldType
    position: [f32; 3]
    strength: f32
    radius: f32
    falloff: f32

    fn default(): ForceField {
        return ForceField {
            field_type: ForceFieldType::Directional
            position: [0.0, 0.0, 0.0]
            strength: 1.0
            radius: 5.0
            falloff: 1.0
        }
    }
}

enum ForceFieldType {
    Directional
    Point
    Vortex
    Turbulence
    Drag
}

// ============================================================================
// SHADER/MATERIAL EDITING (W15-023)
// ============================================================================

enum ParticleBlendMode {
    Opaque
    AlphaBlend
    Additive
    Multiply
    SoftAdditive
    PremultipliedAlpha
}

enum ParticleRenderMode {
    Billboard
    StretchedBillboard
    HorizontalBillboard
    VerticalBillboard
    Mesh
    Trail
}

struct ParticleMaterial {
    texture_path: string
    normal_map_path: string
    blend_mode: ParticleBlendMode
    render_mode: ParticleRenderMode
    base_color: [f32; 4]
    emissive_color: [f32; 3]
    emissive_intensity: f32
    soft_particles: bool
    soft_particle_distance: f32
    depth_write: bool
    two_sided: bool
    receive_shadows: bool
    cast_shadows: bool

    fn default(): ParticleMaterial {
        return ParticleMaterial {
            texture_path: ""
            normal_map_path: ""
            blend_mode: ParticleBlendMode::Additive
            render_mode: ParticleRenderMode::Billboard
            base_color: [1.0, 1.0, 1.0, 1.0]
            emissive_color: [0.0, 0.0, 0.0]
            emissive_intensity: 0.0
            soft_particles: true
            soft_particle_distance: 0.5
            depth_write: false
            two_sided: true
            receive_shadows: false
            cast_shadows: false
        }
    }
}

struct TrailSettings {
    enabled: bool
    lifetime: f32
    min_vertex_distance: f32
    width_over_trail: SizeOverLifetime
    color_over_trail: ColorOverLifetime
    texture_mode: TrailTextureMode
    texture_scale: f32

    fn default(): TrailSettings {
        return TrailSettings {
            enabled: false
            lifetime: 0.5
            min_vertex_distance: 0.1
            width_over_trail: SizeOverLifetime.default()
            color_over_trail: ColorOverLifetime.default()
            texture_mode: TrailTextureMode::Stretch
            texture_scale: 1.0
        }
    }
}

enum TrailTextureMode {
    Stretch
    Tile
    DistributePerSegment
}

struct SubEmitter {
    trigger: SubEmitterTrigger
    emitter_name: string
    inherit_color: bool
    inherit_size: f32
    inherit_rotation: bool

    fn default(): SubEmitter {
        return SubEmitter {
            trigger: SubEmitterTrigger::Birth
            emitter_name: ""
            inherit_color: true
            inherit_size: 0.5
            inherit_rotation: false
        }
    }
}

enum SubEmitterTrigger {
    Birth
    Death
    Collision
    Manual
}

// ============================================================================
// PARTICLE EXPORT (W15-024)
// ============================================================================

enum ParticleExportFormat {
    GeneralsINI      // Original C&C Generals INI format
    W3DEmitter       // Embedded W3D emitter
    JSON             // JSON for modern tools
    Binary           // Optimized binary format
}

struct ParticleExportSettings {
    format: ParticleExportFormat
    output_path: string
    include_textures: bool
    compress_output: bool
    generate_preview: bool

    fn default(): ParticleExportSettings {
        return ParticleExportSettings {
            format: ParticleExportFormat::GeneralsINI
            output_path: ""
            include_textures: true
            compress_output: false
            generate_preview: true
        }
    }
}

struct ParticleExporter {
    settings: ParticleExportSettings

    fn init(): ParticleExporter {
        return ParticleExporter {
            settings: ParticleExportSettings.default()
        }
    }

    fn export(&self, system: *ParticleSystemDefinition): bool {
        match self.settings.format {
            ParticleExportFormat::GeneralsINI => {
                return self.export_ini(system)
            }
            ParticleExportFormat::W3DEmitter => {
                return self.export_w3d(system)
            }
            ParticleExportFormat::JSON => {
                return self.export_json(system)
            }
            ParticleExportFormat::Binary => {
                return self.export_binary(system)
            }
        }
    }

    fn export_ini(&self, system: *ParticleSystemDefinition): bool {
        var output = ""

        output = output + "ParticleSystem " + system.name + "\n"
        output = output + "  Priority = MEDIUM_PRIORITY\n"

        for i in 0..system.emitters.len() {
            let emitter = system.emitters[i]
            output = output + self.emitter_to_ini(emitter)
        }

        output = output + "End\n"

        // Write to file
        return self.write_file(output)
    }

    fn emitter_to_ini(&self, emitter: *EmitterDefinition): string {
        var s = ""
        s = s + "  ParticleEmitter\n"
        s = s + "    Name = " + emitter.name + "\n"
        s = s + "    EmissionRate = " + emitter.emission.rate.to_string() + "\n"
        s = s + "    EmissionBurstCount = " + emitter.emission.burst_count.to_string() + "\n"
        s = s + "    ParticleLifetime = " + emitter.emission.lifetime_min.to_string() + " " + emitter.emission.lifetime_max.to_string() + "\n"
        s = s + "  End\n"
        return s
    }

    fn export_w3d(&self, system: *ParticleSystemDefinition): bool {
        // Export as W3D embedded emitter format
        return true
    }

    fn export_json(&self, system: *ParticleSystemDefinition): bool {
        // Export as JSON
        return true
    }

    fn export_binary(&self, system: *ParticleSystemDefinition): bool {
        // Export as optimized binary
        return true
    }

    fn write_file(&self, content: string): bool {
        // Write content to settings.output_path
        return true
    }
}

// ============================================================================
// PARTICLE SYSTEM DEFINITION
// ============================================================================

struct ParticleSystemDefinition {
    name: string
    emitters: [EmitterDefinition]
    global_physics: PhysicsParams
    force_fields: [ForceField]
    sub_emitters: [SubEmitter]
    material: ParticleMaterial
    trail: TrailSettings

    // Metadata
    author: string
    description: string
    tags: [string]
    version: u32

    fn init(name: string): ParticleSystemDefinition {
        return ParticleSystemDefinition {
            name: name
            emitters: []
            global_physics: PhysicsParams.default()
            force_fields: []
            sub_emitters: []
            material: ParticleMaterial.default()
            trail: TrailSettings.default()
            author: ""
            description: ""
            tags: []
            version: 1
        }
    }

    fn add_emitter(&self, emitter: EmitterDefinition) {
        self.emitters.push(emitter)
    }

    fn remove_emitter(&self, index: u32) {
        if index < self.emitters.len() as u32 {
            self.emitters.remove(index as usize)
        }
    }

    fn duplicate_emitter(&self, index: u32) {
        if index < self.emitters.len() as u32 {
            let copy = self.emitters[index]
            copy.name = copy.name + "_copy"
            self.emitters.push(copy)
        }
    }

    fn get_total_duration(&self): f32 {
        var max_duration: f32 = 0.0
        for i in 0..self.emitters.len() {
            let emitter = self.emitters[i]
            let duration = emitter.emission.start_delay + emitter.emission.duration + emitter.emission.lifetime_max
            if duration > max_duration {
                max_duration = duration
            }
        }
        return max_duration
    }
}

// ============================================================================
// MAIN PARTICLE EDITOR
// ============================================================================

struct ParticleEditor {
    preview: ParticlePreview
    current_system: ?ParticleSystemDefinition
    selected_emitter: i32
    exporter: ParticleExporter

    // Clipboard
    clipboard_emitter: ?EmitterDefinition

    // Undo/Redo
    undo_stack: [EditorState]
    redo_stack: [EditorState]

    // File state
    current_file: string
    is_modified: bool

    fn init(viewport_width: u32, viewport_height: u32): ParticleEditor {
        return ParticleEditor {
            preview: ParticlePreview.init(viewport_width, viewport_height)
            current_system: null
            selected_emitter: -1
            exporter: ParticleExporter.init()
            clipboard_emitter: null
            undo_stack: []
            redo_stack: []
            current_file: ""
            is_modified: false
        }
    }

    fn new_system(&self, name: string) {
        self.current_system = ParticleSystemDefinition.init(name)
        self.selected_emitter = -1
        self.is_modified = false
        self.current_file = ""
        self.undo_stack = []
        self.redo_stack = []
    }

    fn add_emitter(&self) {
        if self.current_system != null {
            let name = "Emitter_" + self.current_system.?.emitters.len().to_string()
            let emitter = EmitterDefinition.init(name)
            self.current_system.?.add_emitter(emitter)
            self.selected_emitter = (self.current_system.?.emitters.len() - 1) as i32
            self.is_modified = true
        }
    }

    fn delete_selected_emitter(&self) {
        if self.current_system != null and self.selected_emitter >= 0 {
            self.current_system.?.remove_emitter(self.selected_emitter as u32)
            self.selected_emitter = -1
            self.is_modified = true
        }
    }

    fn copy_emitter(&self) {
        if self.current_system != null and self.selected_emitter >= 0 {
            self.clipboard_emitter = self.current_system.?.emitters[self.selected_emitter]
        }
    }

    fn paste_emitter(&self) {
        if self.current_system != null and self.clipboard_emitter != null {
            var emitter = self.clipboard_emitter.?
            emitter.name = emitter.name + "_paste"
            self.current_system.?.add_emitter(emitter)
            self.is_modified = true
        }
    }

    fn save(&self, path: string): bool {
        if self.current_system == null {
            return false
        }

        self.exporter.settings.output_path = path
        let success = self.exporter.export(&self.current_system.?)

        if success {
            self.current_file = path
            self.is_modified = false
        }

        return success
    }

    fn update(&self, delta_time: f32) {
        self.preview.update(delta_time)

        if self.current_system != null {
            self.preview.state.total_duration = self.current_system.?.get_total_duration()
        }
    }
}

struct EditorState {
    system_snapshot: ParticleSystemDefinition
}

// ============================================================================
// GLOBAL INSTANCE
// ============================================================================

var g_particle_editor: ?ParticleEditor = null

export fn init_particle_editor(viewport_width: u32, viewport_height: u32) {
    g_particle_editor = ParticleEditor.init(viewport_width, viewport_height)
}

export fn shutdown_particle_editor() {
    g_particle_editor = null
}

export fn get_particle_editor(): ?*ParticleEditor {
    if g_particle_editor != null {
        return &g_particle_editor.?
    }
    return null
}
