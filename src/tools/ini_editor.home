// C&C Generals Zero Hour - INI Editor Tool
// Complete INI file editor with syntax highlighting and validation
//
// Features:
// - W15-040: INI file editing with tree view
// - W15-041: Syntax highlighting
// - W15-042: Real-time validation
// - W15-043: Auto-complete suggestions

// ============================================================================
// INI FILE EDITING (W15-040)
// ============================================================================

enum INIValueType {
    String
    Integer
    Float
    Boolean
    Color
    Vector2
    Vector3
    Percentage
    Angle
    Time
    ObjectReference
    Enumeration
    List
    Block
}

struct INIProperty {
    name: string
    value: string
    value_type: INIValueType
    line_number: u32
    is_inherited: bool
    is_modified: bool
    comment: string

    fn init(name: string, value: string): INIProperty {
        return INIProperty {
            name: name
            value: value
            value_type: INIValueType::String
            line_number: 0
            is_inherited: false
            is_modified: false
            comment: ""
        }
    }
}

struct INIBlock {
    block_type: string         // "Object", "Weapon", "Upgrade", etc.
    name: string
    parent_name: string        // For inheritance
    properties: [INIProperty]
    sub_blocks: [INIBlock]
    start_line: u32
    end_line: u32
    is_expanded: bool
    is_modified: bool

    fn init(block_type: string, name: string): INIBlock {
        return INIBlock {
            block_type: block_type
            name: name
            parent_name: ""
            properties: []
            sub_blocks: []
            start_line: 0
            end_line: 0
            is_expanded: true
            is_modified: false
        }
    }

    fn get_property(&self, name: string): ?*INIProperty {
        for i in 0..self.properties.len() {
            if self.properties[i].name == name {
                return &self.properties[i]
            }
        }
        return null
    }

    fn set_property(&self, name: string, value: string) {
        let prop = self.get_property(name)
        if prop != null {
            prop.?.value = value
            prop.?.is_modified = true
        } else {
            var new_prop = INIProperty.init(name, value)
            new_prop.is_modified = true
            self.properties.push(new_prop)
        }
        self.is_modified = true
    }

    fn remove_property(&self, name: string): bool {
        for i in 0..self.properties.len() {
            if self.properties[i].name == name {
                self.properties.remove(i)
                self.is_modified = true
                return true
            }
        }
        return false
    }
}

struct INIDocument {
    file_path: string
    blocks: [INIBlock]
    global_properties: [INIProperty]
    includes: [string]
    is_modified: bool
    parse_errors: [ParseError]

    fn init(): INIDocument {
        return INIDocument {
            file_path: ""
            blocks: []
            global_properties: []
            includes: []
            is_modified: false
            parse_errors: []
        }
    }

    fn get_block(&self, block_type: string, name: string): ?*INIBlock {
        for i in 0..self.blocks.len() {
            if self.blocks[i].block_type == block_type and self.blocks[i].name == name {
                return &self.blocks[i]
            }
        }
        return null
    }

    fn add_block(&self, block: INIBlock) {
        self.blocks.push(block)
        self.is_modified = true
    }

    fn remove_block(&self, block_type: string, name: string): bool {
        for i in 0..self.blocks.len() {
            if self.blocks[i].block_type == block_type and self.blocks[i].name == name {
                self.blocks.remove(i)
                self.is_modified = true
                return true
            }
        }
        return false
    }

    fn get_blocks_of_type(&self, block_type: string): [*INIBlock] {
        var result: [*INIBlock] = []
        for i in 0..self.blocks.len() {
            if self.blocks[i].block_type == block_type {
                result.push(&self.blocks[i])
            }
        }
        return result
    }
}

// ============================================================================
// SYNTAX HIGHLIGHTING (W15-041)
// ============================================================================

enum TokenType {
    Keyword          // Object, Weapon, End, etc.
    BlockName        // AmericaTank, TankGun, etc.
    PropertyName     // BuildCost, Health, etc.
    PropertyValue    // Values after =
    Number           // Numeric values
    String           // Quoted strings
    Comment          // ; comments
    Operator         // = :
    Bracket          // [ ] { }
    Include          // #include
    Preprocessor     // #define, #ifdef, etc.
    Error            // Invalid tokens
    Whitespace
}

struct SyntaxToken {
    token_type: TokenType
    text: string
    start_column: u32
    end_column: u32
    line: u32
}

struct SyntaxHighlighter {
    keywords: [string]
    block_types: [string]
    property_names: [string]
    enum_values: [string]

    fn init(): SyntaxHighlighter {
        var highlighter = SyntaxHighlighter {
            keywords: []
            block_types: []
            property_names: []
            enum_values: []
        }

        // Common keywords
        highlighter.keywords = [
            "End", "Include", "Define", "Object", "Weapon", "Upgrade",
            "CommandButton", "CommandSet", "Science", "SpecialPower",
            "Armor", "DamageFX", "FXList", "ParticleSystem", "Audio",
            "Locomotor", "ObjectCreationList", "DrawModule", "Body",
            "Behavior", "AIUpdate", "Update", "Draw", "ClientUpdate",
            "Create", "Die", "Damage", "Module"
        ]

        // Block types
        highlighter.block_types = [
            "Object", "Weapon", "Upgrade", "CommandButton", "CommandSet",
            "Science", "SpecialPower", "Armor", "DamageFX", "FXList",
            "ParticleSystem", "AudioEvent", "MusicTrack", "DialogEvent",
            "Locomotor", "ObjectCreationList", "Player", "Team", "Side",
            "Campaign", "Mission", "ChallengeMode", "LoadSubsystem"
        ]

        return highlighter
    }

    fn tokenize_line(&self, line: string, line_number: u32): [SyntaxToken] {
        var tokens: [SyntaxToken] = []
        var pos: u32 = 0
        let len = line.len() as u32

        while pos < len {
            // Skip whitespace
            if line[pos] == ' ' or line[pos] == '\t' {
                let start = pos
                while pos < len and (line[pos] == ' ' or line[pos] == '\t') {
                    pos = pos + 1
                }
                tokens.push(SyntaxToken {
                    token_type: TokenType::Whitespace
                    text: line.substring(start, pos)
                    start_column: start
                    end_column: pos
                    line: line_number
                })
                continue
            }

            // Comment
            if line[pos] == ';' {
                tokens.push(SyntaxToken {
                    token_type: TokenType::Comment
                    text: line.substring(pos, len)
                    start_column: pos
                    end_column: len
                    line: line_number
                })
                break
            }

            // Preprocessor
            if line[pos] == '#' {
                let start = pos
                while pos < len and line[pos] != ' ' and line[pos] != '\t' {
                    pos = pos + 1
                }
                tokens.push(SyntaxToken {
                    token_type: TokenType::Preprocessor
                    text: line.substring(start, pos)
                    start_column: start
                    end_column: pos
                    line: line_number
                })
                continue
            }

            // Operator
            if line[pos] == '=' or line[pos] == ':' {
                tokens.push(SyntaxToken {
                    token_type: TokenType::Operator
                    text: line.substring(pos, pos + 1)
                    start_column: pos
                    end_column: pos + 1
                    line: line_number
                })
                pos = pos + 1
                continue
            }

            // Quoted string
            if line[pos] == '"' {
                let start = pos
                pos = pos + 1
                while pos < len and line[pos] != '"' {
                    pos = pos + 1
                }
                if pos < len {
                    pos = pos + 1
                }
                tokens.push(SyntaxToken {
                    token_type: TokenType::String
                    text: line.substring(start, pos)
                    start_column: start
                    end_column: pos
                    line: line_number
                })
                continue
            }

            // Number
            if is_digit(line[pos]) or (line[pos] == '-' and pos + 1 < len and is_digit(line[pos + 1])) {
                let start = pos
                if line[pos] == '-' {
                    pos = pos + 1
                }
                while pos < len and (is_digit(line[pos]) or line[pos] == '.') {
                    pos = pos + 1
                }
                // Check for % suffix
                if pos < len and line[pos] == '%' {
                    pos = pos + 1
                }
                tokens.push(SyntaxToken {
                    token_type: TokenType::Number
                    text: line.substring(start, pos)
                    start_column: start
                    end_column: pos
                    line: line_number
                })
                continue
            }

            // Identifier (keyword, block name, property)
            if is_alpha(line[pos]) or line[pos] == '_' {
                let start = pos
                while pos < len and (is_alnum(line[pos]) or line[pos] == '_') {
                    pos = pos + 1
                }
                let text = line.substring(start, pos)
                let token_type = self.classify_identifier(text)
                tokens.push(SyntaxToken {
                    token_type: token_type
                    text: text
                    start_column: start
                    end_column: pos
                    line: line_number
                })
                continue
            }

            // Unknown character
            tokens.push(SyntaxToken {
                token_type: TokenType::Error
                text: line.substring(pos, pos + 1)
                start_column: pos
                end_column: pos + 1
                line: line_number
            })
            pos = pos + 1
        }

        return tokens
    }

    fn classify_identifier(&self, text: string): TokenType {
        for i in 0..self.keywords.len() {
            if self.keywords[i] == text {
                return TokenType::Keyword
            }
        }

        for i in 0..self.block_types.len() {
            if self.block_types[i] == text {
                return TokenType::Keyword
            }
        }

        return TokenType::PropertyName
    }
}

fn is_digit(c: u8): bool {
    return c >= '0' and c <= '9'
}

fn is_alpha(c: u8): bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

fn is_alnum(c: u8): bool {
    return is_digit(c) or is_alpha(c)
}

// ============================================================================
// VALIDATION (W15-042)
// ============================================================================

enum ErrorSeverity {
    Error
    Warning
    Info
    Hint
}

struct ParseError {
    severity: ErrorSeverity
    message: string
    line: u32
    column: u32
    length: u32
    code: string

    fn init(severity: ErrorSeverity, message: string, line: u32): ParseError {
        return ParseError {
            severity: severity
            message: message
            line: line
            column: 0
            length: 0
            code: ""
        }
    }
}

struct PropertySchema {
    name: string
    value_type: INIValueType
    required: bool
    default_value: string
    min_value: f32
    max_value: f32
    enum_values: [string]
    description: string
}

struct BlockSchema {
    block_type: string
    required_properties: [string]
    optional_properties: [PropertySchema]
    allowed_sub_blocks: [string]
    can_inherit: bool
}

struct INIValidator {
    schemas: [BlockSchema]
    errors: [ParseError]

    fn init(): INIValidator {
        return INIValidator {
            schemas: []
            errors: []
        }
    }

    fn add_schema(&self, schema: BlockSchema) {
        self.schemas.push(schema)
    }

    fn validate(&self, document: *INIDocument): [ParseError] {
        self.errors = []

        // Validate each block
        for i in 0..document.blocks.len() {
            self.validate_block(&document.blocks[i])
        }

        return self.errors
    }

    fn validate_block(&self, block: *INIBlock) {
        // Find schema for this block type
        var schema: ?*BlockSchema = null
        for i in 0..self.schemas.len() {
            if self.schemas[i].block_type == block.block_type {
                schema = &self.schemas[i]
                break
            }
        }

        if schema == null {
            // Unknown block type - warning only
            self.errors.push(ParseError.init(
                ErrorSeverity::Warning,
                "Unknown block type: " + block.block_type,
                block.start_line
            ))
            return
        }

        let s = schema.?

        // Check required properties
        for i in 0..s.required_properties.len() {
            let prop_name = s.required_properties[i]
            let prop = block.get_property(prop_name)
            if prop == null {
                self.errors.push(ParseError.init(
                    ErrorSeverity::Error,
                    "Missing required property: " + prop_name,
                    block.start_line
                ))
            }
        }

        // Validate property values
        for i in 0..block.properties.len() {
            self.validate_property(&block.properties[i], s)
        }

        // Validate sub-blocks
        for i in 0..block.sub_blocks.len() {
            self.validate_block(&block.sub_blocks[i])
        }
    }

    fn validate_property(&self, prop: *INIProperty, schema: *BlockSchema) {
        // Find property schema
        var prop_schema: ?*PropertySchema = null
        for i in 0..schema.optional_properties.len() {
            if schema.optional_properties[i].name == prop.name {
                prop_schema = &schema.optional_properties[i]
                break
            }
        }

        if prop_schema == null {
            return  // Unknown property - allow it
        }

        let ps = prop_schema.?

        // Validate value based on type
        match ps.value_type {
            INIValueType::Integer => {
                let val = parse_int(prop.value)
                if val == null {
                    self.errors.push(ParseError.init(
                        ErrorSeverity::Error,
                        "Expected integer value for " + prop.name,
                        prop.line_number
                    ))
                }
            }
            INIValueType::Float => {
                let val = parse_float(prop.value)
                if val == null {
                    self.errors.push(ParseError.init(
                        ErrorSeverity::Error,
                        "Expected numeric value for " + prop.name,
                        prop.line_number
                    ))
                } else if val.? < ps.min_value or val.? > ps.max_value {
                    self.errors.push(ParseError.init(
                        ErrorSeverity::Warning,
                        "Value out of range for " + prop.name + " (expected " + ps.min_value.to_string() + "-" + ps.max_value.to_string() + ")",
                        prop.line_number
                    ))
                }
            }
            INIValueType::Boolean => {
                let lower = prop.value.to_lowercase()
                if lower != "yes" and lower != "no" and lower != "true" and lower != "false" and lower != "1" and lower != "0" {
                    self.errors.push(ParseError.init(
                        ErrorSeverity::Error,
                        "Expected boolean value for " + prop.name,
                        prop.line_number
                    ))
                }
            }
            INIValueType::Enumeration => {
                var found = false
                for i in 0..ps.enum_values.len() {
                    if ps.enum_values[i] == prop.value {
                        found = true
                        break
                    }
                }
                if !found {
                    self.errors.push(ParseError.init(
                        ErrorSeverity::Error,
                        "Invalid enum value for " + prop.name,
                        prop.line_number
                    ))
                }
            }
            _ => {}
        }
    }
}

fn parse_int(s: string): ?i32 {
    // Simple integer parsing
    return null
}

fn parse_float(s: string): ?f32 {
