}

// ============================================================================
// AUTO-COMPLETE (W15-043)
// ============================================================================

struct CompletionItem {
    label: string
    kind: CompletionKind
    detail: string
    documentation: string
    insert_text: string
    sort_priority: u32
}

enum CompletionKind {
    Keyword
    BlockType
    Property
    Value
    Enumeration
    ObjectReference
    Snippet
}

struct AutoCompleteProvider {
    block_type_completions: [CompletionItem]
    keyword_completions: [CompletionItem]
    property_completions: [PropertyCompletions]
    object_references: [string]

    fn init(): AutoCompleteProvider {
        var provider = AutoCompleteProvider {
            block_type_completions: []
            keyword_completions: []
            property_completions: []
            object_references: []
        }

        // Add block type completions
        let block_types = ["Object", "Weapon", "Upgrade", "CommandButton", "CommandSet", "Science", "SpecialPower", "Armor", "FXList", "ParticleSystem"]
        for i in 0..block_types.len() {
            provider.block_type_completions.push(CompletionItem {
                label: block_types[i]
                kind: CompletionKind::BlockType
                detail: "Block type"
                documentation: ""
                insert_text: block_types[i] + " $1\n  $0\nEnd"
                sort_priority: 0
            })
        }

        // Add keyword completions
        let keywords = ["End", "Include"]
        for i in 0..keywords.len() {
            provider.keyword_completions.push(CompletionItem {
                label: keywords[i]
                kind: CompletionKind::Keyword
                detail: "Keyword"
                documentation: ""
                insert_text: keywords[i]
                sort_priority: 1
            })
        }

        return provider
    }

    fn get_completions(&self, context: *CompletionContext): [CompletionItem] {
        var results: [CompletionItem] = []

        match context.context_type {
            CompletionContextType::BlockStart => {
                for i in 0..self.block_type_completions.len() {
                    if self.block_type_completions[i].label.starts_with(context.prefix) {
                        results.push(self.block_type_completions[i])
                    }
                }
            }
            CompletionContextType::PropertyName => {
                // Find property completions for current block type
                for i in 0..self.property_completions.len() {
                    if self.property_completions[i].block_type == context.current_block_type {
                        for j in 0..self.property_completions[i].properties.len() {
                            let prop = self.property_completions[i].properties[j]
                            if prop.label.starts_with(context.prefix) {
                                results.push(prop)
                            }
                        }
                    }
                }
            }
            CompletionContextType::PropertyValue => {
                // Get value completions based on property type
                self.add_value_completions(&results, context)
            }
            CompletionContextType::ObjectReference => {
                for i in 0..self.object_references.len() {
                    if self.object_references[i].starts_with(context.prefix) {
                        results.push(CompletionItem {
                            label: self.object_references[i]
                            kind: CompletionKind::ObjectReference
                            detail: "Object"
                            documentation: ""
                            insert_text: self.object_references[i]
                            sort_priority: 2
                        })
                    }
                }
            }
        }

        return results
    }

    fn add_value_completions(&self, results: *[CompletionItem], context: *CompletionContext) {
        // Add common value completions based on property
        if context.current_property == "KindOf" {
            let kinds = ["INFANTRY", "VEHICLE", "AIRCRAFT", "STRUCTURE", "SELECTABLE", "ATTACKABLE"]
            for i in 0..kinds.len() {
                results.push(CompletionItem {
                    label: kinds[i]
                    kind: CompletionKind::Enumeration
                    detail: "KindOf flag"
                    documentation: ""
                    insert_text: kinds[i]
                    sort_priority: 0
                })
            }
        }
    }

    fn update_object_references(&self, document: *INIDocument) {
        self.object_references = []
        for i in 0..document.blocks.len() {
            if document.blocks[i].block_type == "Object" {
                self.object_references.push(document.blocks[i].name)
            }
        }
    }
}

struct PropertyCompletions {
    block_type: string
    properties: [CompletionItem]
}

enum CompletionContextType {
    BlockStart
    PropertyName
    PropertyValue
    ObjectReference
}

struct CompletionContext {
    context_type: CompletionContextType
    prefix: string
    current_block_type: string
    current_property: string
    line: u32
    column: u32
}

// ============================================================================
// MAIN INI EDITOR
// ============================================================================

struct INIEditor {
    document: ?INIDocument
    highlighter: SyntaxHighlighter
    validator: INIValidator
    auto_complete: AutoCompleteProvider

    // Editor state
    cursor_line: u32
    cursor_column: u32
    selection_start: [u32; 2]
    selection_end: [u32; 2]
    scroll_offset: u32

    // File state
    current_file: string
    is_modified: bool

    // UI state
    show_line_numbers: bool
    show_minimap: bool
    word_wrap: bool
    tab_size: u32

    fn init(): INIEditor {
        return INIEditor {
            document: null
            highlighter: SyntaxHighlighter.init()
            validator: INIValidator.init()
            auto_complete: AutoCompleteProvider.init()
            cursor_line: 0
            cursor_column: 0
            selection_start: [0, 0]
            selection_end: [0, 0]
            scroll_offset: 0
            current_file: ""
            is_modified: false
            show_line_numbers: true
            show_minimap: true
            word_wrap: false
            tab_size: 4
        }
    }

    fn open(&self, path: string): bool {
        // Parse INI file
        self.document = INIDocument.init()
        self.document.?.file_path = path
        self.current_file = path
        self.is_modified = false

        // Update auto-complete with object references
        self.auto_complete.update_object_references(&self.document.?)

        // Validate
        self.validate()

        return true
    }

    fn save(&self): bool {
        if self.document == null {
            return false
        }

        // Serialize document back to INI format
        // Write to current_file

        self.is_modified = false
        return true
    }

    fn save_as(&self, path: string): bool {
        self.current_file = path
        if self.document != null {
            self.document.?.file_path = path
        }
        return self.save()
    }

    fn validate(&self) {
        if self.document != null {
            let errors = self.validator.validate(&self.document.?)
            self.document.?.parse_errors = errors
        }
    }

    fn get_completions(&self): [CompletionItem] {
        let context = CompletionContext {
            context_type: CompletionContextType::PropertyName
            prefix: ""
            current_block_type: ""
            current_property: ""
            line: self.cursor_line
            column: self.cursor_column
        }

        return self.auto_complete.get_completions(&context)
    }

    fn go_to_definition(&self, name: string): bool {
        if self.document == null {
            return false
        }

        for i in 0..self.document.?.blocks.len() {
            if self.document.?.blocks[i].name == name {
                self.cursor_line = self.document.?.blocks[i].start_line
                self.cursor_column = 0
                return true
            }
        }

        return false
    }

    fn find_references(&self, name: string): [u32] {
        var lines: [u32] = []

        // Search through document for references to name
        // Return line numbers where name appears

        return lines
    }
}

// ============================================================================
// GLOBAL INSTANCE
// ============================================================================

var g_ini_editor: ?INIEditor = null

export fn init_ini_editor() {
    g_ini_editor = INIEditor.init()
}

export fn shutdown_ini_editor() {
    g_ini_editor = null
}

export fn get_ini_editor(): ?*INIEditor {
    if g_ini_editor != null {
        return &g_ini_editor.?
    }
    return null
}
