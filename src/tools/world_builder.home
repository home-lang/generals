struct MapExportSettings {
    output_path: string
    map_name: string
    export_terrain: bool
    export_objects: bool
    export_scripts: bool
    export_teams: bool
    compress_output: bool
    generate_preview: bool
    preview_size: u32
}

struct MapExporter {
    settings: MapExportSettings

    fn init(): MapExporter {
        return MapExporter {
            settings: MapExportSettings {
                output_path: ""
                map_name: "Untitled"
                export_terrain: true
                export_objects: true
                export_scripts: true
                export_teams: true
                compress_output: true
                generate_preview: true
                preview_size: 256
            }
        }
    }

    fn export_map(&self, editor: *WorldBuilder): bool {
        // Export terrain heightmap
        if self.settings.export_terrain {
            self.export_terrain_data(editor)
        }

        // Export objects
        if self.settings.export_objects {
            self.export_object_data(editor)
        }

        // Export scripts
        if self.settings.export_scripts {
            self.export_script_data(editor)
        }

        // Export teams/players
        if self.settings.export_teams {
            self.export_team_data(editor)
        }

        // Generate preview
        if self.settings.generate_preview {
            self.generate_preview_image(editor)
        }

        return true
    }

    fn export_terrain_data(&self, editor: *WorldBuilder) {
        // Write .map terrain format
