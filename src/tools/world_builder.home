}

// ============================================================================
// TERRAIN DATA STRUCTURE
// ============================================================================

struct TerrainData {
    width: i32
    height: i32
    cell_size: f32
    heightmap: [f32]
    texture_indices: [u8]
    blend_weights: [f32]
    cliff_texture_indices: [u8]
    macro_texture_weights: [f32]

    fn init(width: i32, height: i32, cell_size: f32): TerrainData {
        let size = (width * height) as usize
        return TerrainData {
            width: width
            height: height
            cell_size: cell_size
            heightmap: [0.0; size]
            texture_indices: [0; size]
            blend_weights: [0.0; size * 4]
            cliff_texture_indices: [0; size]
            macro_texture_weights: [0.0; size]
        }
    }

    fn get_height_at(&self, x: f32, z: f32): f32 {
        let fx = x / self.cell_size
        let fz = z / self.cell_size

        let ix = fx as i32
        let iz = fz as i32

        if ix < 0 or ix >= self.width - 1 or iz < 0 or iz >= self.height - 1 {
            return 0.0
        }

        let tx = fx - ix as f32
        let tz = fz - iz as f32

        let h00 = self.heightmap[iz * self.width + ix]
        let h10 = self.heightmap[iz * self.width + ix + 1]
        let h01 = self.heightmap[(iz + 1) * self.width + ix]
        let h11 = self.heightmap[(iz + 1) * self.width + ix + 1]

        let h0 = h00 + tx * (h10 - h00)
        let h1 = h01 + tx * (h11 - h01)

        return h0 + tz * (h1 - h0)
    }
}

// ============================================================================
// MAIN WORLDBUILDER CLASS
// ============================================================================

struct WorldBuilder {
    // Current mode
    mode: EditorMode

    // Tools
    sculpt_tool: TerrainSculptTool
    paint_tool: TexturePaintTool
    object_tool: ObjectPlacementTool
    road_tool: RoadTool
    water_tool: WaterTool
    fence_tool: FenceTool
    bridge_tool: BridgeTool
    script_editor: ScriptEditor
    team_setup: TeamPlayerSetup
    exporter: MapExporter

    // Map data
    terrain: TerrainData
    objects: [PlaceableObject]
    next_object_id: u32

    // Editor state
    is_modified: bool
    current_file: string
    undo_stack: [EditorAction]
    redo_stack: [EditorAction]

    fn init(terrain_width: i32, terrain_height: i32): WorldBuilder {
        return WorldBuilder {
            mode: EditorMode::Select
            sculpt_tool: TerrainSculptTool.init()
            paint_tool: TexturePaintTool.init()
            object_tool: ObjectPlacementTool.init()
            road_tool: RoadTool.init()
            water_tool: WaterTool.init()
            fence_tool: FenceTool.init()
            bridge_tool: BridgeTool.init()
            script_editor: ScriptEditor.init()
            team_setup: TeamPlayerSetup.init()
            exporter: MapExporter.init()
            terrain: TerrainData.init(terrain_width, terrain_height, 10.0)
            objects: []
            next_object_id: 1
            is_modified: false
            current_file: ""
            undo_stack: []
            redo_stack: []
        }
    }

    fn set_mode(&self, mode: EditorMode) {
        self.mode = mode
    }

    fn place_object(&self, x: f32, z: f32): u32 {
        var obj = self.object_tool.create_object(x, z, &self.terrain)
        obj.unique_id = self.next_object_id
        self.next_object_id = self.next_object_id + 1

        self.objects.push(obj)
        self.is_modified = true

        return obj.unique_id
    }

    fn delete_object(&self, object_id: u32): bool {
        for i in 0..self.objects.len() {
            if self.objects[i].unique_id == object_id {
                self.objects.remove(i)
                self.is_modified = true
                return true
            }
        }
        return false
    }

    fn save(&self, path: string): bool {
        self.exporter.settings.output_path = path
        self.exporter.settings.map_name = path
        let success = self.exporter.export_map(self)
        if success {
            self.is_modified = false
            self.current_file = path
        }
        return success
    }

    fn new_map(&self, width: i32, height: i32) {
        self.terrain = TerrainData.init(width, height, 10.0)
        self.objects = []
        self.road_tool.all_roads = []
        self.water_tool.all_water_areas = []
        self.fence_tool.segments = []
        self.bridge_tool.bridges = []
        self.script_editor.scripts = []
        self.team_setup = TeamPlayerSetup.init()
        self.next_object_id = 1
        self.is_modified = false
        self.current_file = ""
        self.undo_stack = []
        self.redo_stack = []
    }
}

struct EditorAction {
    action_type: string
    data: *anyopaque
}

// Utility function
fn random_f32(): f32 {
    // Simple LCG
    static var seed: u32 = 12345
    seed = seed * 1103515245 + 12345
    return (seed & 0x7FFFFFFF) as f32 / 2147483647.0
}

// ============================================================================
// GLOBAL INSTANCE
// ============================================================================

var g_world_builder: ?WorldBuilder = null

export fn init_world_builder(terrain_width: i32, terrain_height: i32) {
    g_world_builder = WorldBuilder.init(terrain_width, terrain_height)
}

export fn shutdown_world_builder() {
    g_world_builder = null
}

export fn get_world_builder(): ?*WorldBuilder {
    if g_world_builder != null {
        return &g_world_builder.?
    }
    return null
}
