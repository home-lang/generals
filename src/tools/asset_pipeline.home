// ============================================================================
// EXPORTED FUNCTIONS FOR BIG ARCHIVE CREATION
// ============================================================================

var g_big_builder: ?BIGArchiveBuilder = null

export fn big_archive_init() {
    let allocator = get_global_allocator()
    g_big_builder = BIGArchiveBuilder.init(allocator)
}

export fn big_archive_add_file(path: string, archive_name: string): bool {
    if !g_big_builder {
        return false
    }
    return g_big_builder.?.add_file(path, archive_name)
}

export fn big_archive_add_directory(dir_path: string, archive_prefix: string): u32 {
    if !g_big_builder {
        return 0
    }
    return g_big_builder.?.add_directory(dir_path, archive_prefix)
}

export fn big_archive_set_compression(use_compression: bool, use_refpack: bool) {
    if !g_big_builder {
        return
    }

    if use_compression {
        if use_refpack {
            g_big_builder.?.set_compression(BIGCompression.RefPack)
        } else {
            g_big_builder.?.set_compression(BIGCompression.ZLib)
        }
    } else {
        g_big_builder.?.set_compression(BIGCompression.None)
    }
}

export fn big_archive_build(output_path: string): bool {
    if !g_big_builder {
        return false
    }
    return g_big_builder.?.build(output_path)
}

export fn big_archive_shutdown() {
    if g_big_builder {
        g_big_builder.?.deinit()
        g_big_builder = null
    }
}

// ============================================================================
// EXPORTED FUNCTIONS FOR TEXTURE CONVERSION
// ============================================================================

export fn convert_texture_file(source: string, dest: string, generate_mipmaps: bool): bool {
    let allocator = get_global_allocator()
    var converter = TextureConverter.init(allocator)
    converter.generate_mipmaps = generate_mipmaps

    let source_lower = source.to_lower()

    if source_lower.ends_with(".dds") {
        return converter.convert_dds(source, dest)
    } else if source_lower.ends_with(".tga") {
        return converter.convert_tga(source, dest)
    } else if source_lower.ends_with(".bmp") {
        return converter.convert_bmp(source, dest)
    }

    return false
}

// ============================================================================
// EXPORTED FUNCTIONS FOR MODEL IMPORT
// ============================================================================

export fn import_w3d_model(source: string, dest: string): bool {
    let allocator = get_global_allocator()
    var importer = W3DImporter.init(allocator)

    if !importer.import(source) {
        return false
    }

    return importer.export_to_binary(dest)
}

// ============================================================================
// EXPORTED FUNCTIONS FOR AUDIO CONVERSION
// ============================================================================

export fn convert_audio_file(source: string, dest: string, target_sample_rate: u32): bool {
    let allocator = get_global_allocator()
    var converter = AudioConverter.init(allocator)
    converter.target_sample_rate = target_sample_rate

    let source_lower = source.to_lower()

    if source_lower.ends_with(".wav") {
        return converter.convert_wav(source, dest)
    } else if source_lower.ends_with(".mp3") {
        return converter.convert_mp3(source, dest)
    } else if source_lower.ends_with(".ogg") {
        return converter.convert_ogg(source, dest)
    }

    return false
}
