// C&C Generals Zero Hour - Home Port
// Asset Pipeline Controller
//
// Coordinates conversion of EA's original assets to Home-compatible formats:
// - W3D models → Home binary mesh format
// - DDS/TGA textures → optimized GPU textures
// - WAV/MP3 audio → platform audio format
// - INI data files → loaded into game database
//
// Original EA asset structure (from Data/ directory):
// Data/
//   W3D/              - 3D models (.w3d)
//   Textures/         - Texture files (.dds, .tga)
//   Audio/
//     Sounds/         - Sound effects (.wav)
//     Music/          - Music tracks (.mp3)
//     Voice/          - Voice-overs (.wav)
//   INI/              - Game data definitions
//     Object/         - Unit/building definitions
//     Weapon.ini      - Weapon stats
//     CommandSet.ini  - UI commands
//   Maps/             - Map files (.map)
//   Shaders/          - HLSL shaders (.fx)

import basics/allocator
import basics/string
import basics/filesystem
import tools/w3d_importer
import tools/ini_parser

// Asset type categories
enum AssetType {
    Model       // 3D meshes
    Texture     // 2D images
    Audio       // Sound files
    Data        // INI configuration
    Map         // Map files
    Shader      // Shader code
}

// Asset conversion task
struct AssetConversionTask {
    asset_type: AssetType
    source_path: string
    output_path: string
    priority: i32       // Higher = convert first
    completed: bool
}

// Asset conversion statistics
struct ConversionStats {
    total_tasks: u32
    completed_tasks: u32
    failed_tasks: u32
    total_bytes_processed: u64
    start_time: f64
    end_time: f64

    fn get_progress(&self): f32 {
        if self.total_tasks == 0 {
            return 0.0
        }
        return @intToFloat(f32, self.completed_tasks) / @intToFloat(f32, self.total_tasks)
    }

    fn get_elapsed_time(&self): f64 {
        return self.end_time - self.start_time
    }
}

// Asset pipeline configuration
struct PipelineConfig {
    source_data_dir: string         // EA's original Data/ directory
    output_dir: string              // Converted assets directory
    num_worker_threads: u32         // Parallel conversion workers
    compress_textures: bool         // Enable texture compression
    generate_mipmaps: bool          // Generate texture mipmaps
    optimize_meshes: bool           // Optimize mesh data
    validate_assets: bool           // Validate after conversion

    fn default(): PipelineConfig {
        return PipelineConfig {
            source_data_dir: "Data/"
            output_dir: "ProcessedAssets/"
            num_worker_threads: 4
            compress_textures: true
            generate_mipmaps: true
            optimize_meshes: true
            validate_assets: true
        }
    }
}

// ============================================================================
// TEXTURE CONVERTER (W15-050)
// Converts DDS/TGA/BMP/PNG textures to optimized GPU formats
// ============================================================================

enum TextureFormat {
    DDS_DXT1       // BC1 compression (RGB, 1-bit alpha)
    DDS_DXT3       // BC2 compression (RGBA, explicit alpha)
    DDS_DXT5       // BC3 compression (RGBA, interpolated alpha)
    DDS_BC7        // BC7 compression (high quality RGBA)
    TGA_RGBA       // Uncompressed TGA
    TGA_RGB        // Uncompressed TGA no alpha
    BMP_RGB        // Windows bitmap
    PNG_RGBA       // PNG with alpha
    Raw            // Raw pixel data
}

struct DDSHeader {
    magic: u32                  // "DDS " = 0x20534444
    size: u32                   // Always 124
    flags: u32
    height: u32
    width: u32
    pitch_or_linear_size: u32
    depth: u32
    mip_map_count: u32
    reserved: [11]u32
    pixel_format: DDSPixelFormat
    caps: u32
    caps2: u32
    caps3: u32
    caps4: u32
    reserved2: u32
}

struct DDSPixelFormat {
    size: u32                   // Always 32
    flags: u32
    four_cc: u32                // DXT1, DXT3, DXT5, etc.
    rgb_bit_count: u32
    r_bit_mask: u32
    g_bit_mask: u32
    b_bit_mask: u32
    a_bit_mask: u32
}

struct TGAHeader {
    id_length: u8
    color_map_type: u8
    image_type: u8
    color_map_start: u16
    color_map_length: u16
    color_map_entry_size: u8
    x_origin: u16
    y_origin: u16
    width: u16
    height: u16
    bits_per_pixel: u8
    image_descriptor: u8
}

struct TextureData {
    width: u32
    height: u32
    format: TextureFormat
    mip_levels: u32
    data: []u8
    data_size: usize
}

struct TextureConverter {
    allocator: Allocator
    generate_mipmaps: bool
    target_format: TextureFormat
    max_texture_size: u32

    fn init(allocator: Allocator): TextureConverter {
        return TextureConverter {
            allocator: allocator
            generate_mipmaps: true
            target_format: TextureFormat.DDS_DXT5
            max_texture_size: 4096
        }
    }

    fn convert_dds(self, source_path: string, dest_path: string): bool {
        // Read DDS file
        let file_data = read_file(source_path)
        if file_data.len < 128 {
            println("Error: DDS file too small")
            return false
        }

        // Parse DDS header
        let header = @ptrCast(*DDSHeader, file_data.ptr)

        if header.magic != 0x20534444 {
            println("Error: Invalid DDS magic")
            return false
        }

        let texture = TextureData {
            width: header.width
            height: header.height
            format: self.parse_dds_format(header.pixel_format.four_cc)
            mip_levels: if header.mip_map_count > 0 { header.mip_map_count } else { 1 }
            data: file_data[128..]
            data_size: file_data.len - 128
        }

        // Optionally transcode to target format
        if self.target_format != texture.format {
            return self.transcode_texture(&texture, dest_path)
        }

        // Write output
        return self.write_texture(&texture, dest_path)
    }

    fn convert_tga(self, source_path: string, dest_path: string): bool {
        let file_data = read_file(source_path)
        if file_data.len < 18 {
            println("Error: TGA file too small")
            return false
        }

        let header = @ptrCast(*TGAHeader, file_data.ptr)

        // Only support uncompressed true-color images
        if header.image_type != 2 and header.image_type != 10 {
            println("Error: Unsupported TGA image type")
            return false
        }

        let bpp = header.bits_per_pixel
        if bpp != 24 and bpp != 32 {
            println("Error: Unsupported TGA bit depth")
            return false
        }

        let format = if bpp == 32 { TextureFormat.TGA_RGBA } else { TextureFormat.TGA_RGB }

        let texture = TextureData {
            width: @intCast(u32, header.width)
            height: @intCast(u32, header.height)
            format: format
            mip_levels: 1
            data: file_data[18 + header.id_length..]
            data_size: file_data.len - 18 - header.id_length
        }

        // Generate mipmaps if requested
        if self.generate_mipmaps {
            return self.generate_and_write_mipmaps(&texture, dest_path)
        }

        return self.write_texture(&texture, dest_path)
    }

    fn convert_bmp(self, source_path: string, dest_path: string): bool {
        let file_data = read_file(source_path)
        if file_data.len < 54 {
            println("Error: BMP file too small")
            return false
        }

        // Check BMP magic
        if file_data[0] != 'B' or file_data[1] != 'M' {
            println("Error: Invalid BMP magic")
            return false
        }

        // Parse BMP header (BITMAPINFOHEADER at offset 14)
        let width = @ptrCast(*u32, &file_data[18]).*
        let height = @ptrCast(*u32, &file_data[22]).*
        let bpp = @ptrCast(*u16, &file_data[28]).*
        let data_offset = @ptrCast(*u32, &file_data[10]).*

        if bpp != 24 and bpp != 32 {
            println("Error: Unsupported BMP bit depth")
            return false
        }

        let texture = TextureData {
            width: width
            height: height
            format: TextureFormat.BMP_RGB
            mip_levels: 1
            data: file_data[data_offset..]
            data_size: file_data.len - data_offset
        }

        return self.write_texture(&texture, dest_path)
    }

    fn parse_dds_format(&self, four_cc: u32): TextureFormat {
        return match four_cc {
            0x31545844 => TextureFormat.DDS_DXT1  // "DXT1"
            0x33545844 => TextureFormat.DDS_DXT3  // "DXT3"
            0x35545844 => TextureFormat.DDS_DXT5  // "DXT5"
            _ => TextureFormat.Raw
        }
    }

    fn transcode_texture(self, texture: *TextureData, dest_path: string): bool {
        // Decompress source format
        let raw_data = self.decompress_texture(texture)

        // Compress to target format
        let compressed = self.compress_texture(raw_data, texture.width, texture.height)

        // Write output
        return write_file(dest_path, compressed)
    }

    fn decompress_texture(self, texture: *TextureData): []u8 {
        // DXT decompression would go here
        // For now, return raw data as placeholder
        return texture.data
    }

    fn compress_texture(self, raw_data: []u8, width: u32, height: u32): []u8 {
        // DXT compression would go here
        // For now, return raw data as placeholder
        return raw_data
    }

    fn generate_and_write_mipmaps(self, texture: *TextureData, dest_path: string): bool {
        // Generate mipmap chain
        var mip_width = texture.width
        var mip_height = texture.height
        var mip_level: u32 = 0

        while mip_width > 1 or mip_height > 1 {
            // Downsample would go here
            mip_width = @max(1, mip_width / 2)
            mip_height = @max(1, mip_height / 2)
            mip_level += 1
        }

        return self.write_texture(texture, dest_path)
    }

    fn write_texture(self, texture: *TextureData, dest_path: string): bool {
        // Write custom texture format
        // Header: magic (4), width (4), height (4), format (4), mips (4), data_size (4)
        let header_size: usize = 24
        let total_size = header_size + texture.data_size

        var output = self.allocator.alloc(u8, total_size)

        // Write header
        @ptrCast(*u32, &output[0]).* = 0x54455854  // "TEXT"
        @ptrCast(*u32, &output[4]).* = texture.width
        @ptrCast(*u32, &output[8]).* = texture.height
        @ptrCast(*u32, &output[12]).* = @enumToInt(texture.format)
        @ptrCast(*u32, &output[16]).* = texture.mip_levels
        @ptrCast(*u32, &output[20]).* = @intCast(u32, texture.data_size)

        // Copy pixel data
        @memcpy(&output[header_size], texture.data.ptr, texture.data_size)

        return write_file(dest_path, output)
    }
}

// ============================================================================
// W3D MODEL IMPORTER (W15-051)
// Imports W3D models with mesh, skeleton, and animation data
// ============================================================================

struct W3DChunkHeader {
    chunk_type: u32
    chunk_size: u32
    sub_chunk_size: u32
}

enum W3DChunkType {
    MESH                = 0x00000000
    MESH_HEADER         = 0x0000001F
    VERTICES            = 0x00000002
    VERTEX_NORMALS      = 0x00000003
    MESH_USER_TEXT      = 0x0000000C
    TRIANGLES           = 0x00000020
    VERTEX_SHADE_INDICES = 0x00000022
    MATERIAL_INFO       = 0x00000028
    SHADERS             = 0x00000029
    VERTEX_MATERIALS    = 0x0000002A
    TEXTURES            = 0x00000030
    TEXTURE_INFO        = 0x00000031
    HIERARCHY           = 0x00000100
    ANIMATION           = 0x00000200
    COMPRESSED_ANIMATION = 0x00000280
    HLOD                = 0x00000700
    BOX                 = 0x00000740
}

struct W3DMeshHeader {
    version: u32
    attrs: u32
    mesh_name: [16]u8
    container_name: [16]u8
    num_tris: u32
    num_vertices: u32
    num_materials: u32
    num_damage_stages: u32
    sort_level: i32
    prelit_version: u32
    future_count: u32
    vert_channel_flags: u32
    face_channel_flags: u32
    min_corner: [3]f32
    max_corner: [3]f32
    sph_center: [3]f32
    sph_radius: f32
}

struct ImportedMesh {
    name: [16]u8
    vertices: []f32         // x, y, z per vertex
    normals: []f32          // nx, ny, nz per vertex
    uvs: []f32              // u, v per vertex
    indices: []u16          // Triangle indices
    vertex_count: u32
    triangle_count: u32
    material_index: u32
}

struct ImportedSkeleton {
    bone_names: [][32]u8
    bone_parents: []i32
    bone_transforms: []f32  // 4x4 matrix per bone
    bone_count: u32
}

struct ImportedAnimation {
    name: [32]u8
    frame_count: u32
    frame_rate: f32
    bone_channels: []AnimationChannel
    channel_count: u32
}

struct AnimationChannel {
    bone_index: u32
    translation_keys: []TranslationKey
    rotation_keys: []RotationKey
    translation_count: u32
    rotation_count: u32
}

struct TranslationKey {
    frame: u32
    x: f32
    y: f32
    z: f32
}

struct RotationKey {
    frame: u32
    x: f32
    y: f32
    z: f32
    w: f32
}

struct W3DImporter {
    allocator: Allocator
    meshes: []ImportedMesh
    mesh_count: u32
    skeleton: ?ImportedSkeleton
    animations: []ImportedAnimation
    animation_count: u32

    fn init(allocator: Allocator): W3DImporter {
        return W3DImporter {
            allocator: allocator
            meshes: []
            mesh_count: 0
            skeleton: null
            animations: []
            animation_count: 0
        }
    }

    fn import(self, source_path: string): bool {
        let file_data = read_file(source_path)
        if file_data.len < 8 {
            println("Error: W3D file too small")
            return false
        }

        var offset: usize = 0

        while offset + 8 <= file_data.len {
            let header = @ptrCast(*W3DChunkHeader, &file_data[offset])
            let chunk_type = header.chunk_type & 0x7FFFFFFF
            let chunk_size = header.chunk_size & 0x7FFFFFFF

            match @intToEnum(W3DChunkType, chunk_type) {
                W3DChunkType.MESH => {
                    self.parse_mesh(file_data, offset + 8, chunk_size)
                }
                W3DChunkType.HIERARCHY => {
                    self.parse_hierarchy(file_data, offset + 8, chunk_size)
                }
                W3DChunkType.ANIMATION => {
                    self.parse_animation(file_data, offset + 8, chunk_size)
                }
                W3DChunkType.COMPRESSED_ANIMATION => {
                    self.parse_compressed_animation(file_data, offset + 8, chunk_size)
                }
                W3DChunkType.HLOD => {
                    self.parse_hlod(file_data, offset + 8, chunk_size)
                }
                _ => {
                    // Skip unknown chunk
                }
            }

            offset += 8 + chunk_size
        }

        return true
    }

    fn parse_mesh(self, data: []u8, offset: usize, size: u32) {
        var pos = offset
        let end_pos = offset + size

        var mesh = ImportedMesh {
            name: [0; 16]
            vertices: []
            normals: []
            uvs: []
            indices: []
            vertex_count: 0
            triangle_count: 0
            material_index: 0
        }

        while pos + 8 <= end_pos {
            let header = @ptrCast(*W3DChunkHeader, &data[pos])
            let chunk_type = header.chunk_type & 0x7FFFFFFF
            let chunk_size = header.chunk_size & 0x7FFFFFFF

            match @intToEnum(W3DChunkType, chunk_type) {
                W3DChunkType.MESH_HEADER => {
                    let mesh_header = @ptrCast(*W3DMeshHeader, &data[pos + 8])
                    mesh.name = mesh_header.mesh_name
                    mesh.vertex_count = mesh_header.num_vertices
                    mesh.triangle_count = mesh_header.num_tris
                }
                W3DChunkType.VERTICES => {
                    mesh.vertices = self.allocator.alloc(f32, mesh.vertex_count * 3)
                    @memcpy(mesh.vertices.ptr, &data[pos + 8], mesh.vertex_count * 12)
                }
                W3DChunkType.VERTEX_NORMALS => {
                    mesh.normals = self.allocator.alloc(f32, mesh.vertex_count * 3)
                    @memcpy(mesh.normals.ptr, &data[pos + 8], mesh.vertex_count * 12)
                }
                W3DChunkType.TRIANGLES => {
                    mesh.indices = self.allocator.alloc(u16, mesh.triangle_count * 3)
                    // Triangle data includes vert indices + attributes
                    // Extract just the indices
                    for i in 0..mesh.triangle_count {
                        let tri_offset = pos + 8 + i * 32  // 32 bytes per triangle
                        mesh.indices[i * 3 + 0] = @ptrCast(*u16, &data[tri_offset + 0]).*
                        mesh.indices[i * 3 + 1] = @ptrCast(*u16, &data[tri_offset + 2]).*
                        mesh.indices[i * 3 + 2] = @ptrCast(*u16, &data[tri_offset + 4]).*
                    }
                }
                _ => {}
            }

            pos += 8 + chunk_size
        }

        // Add mesh to list
        self.add_mesh(mesh)
    }

    fn parse_hierarchy(self, data: []u8, offset: usize, size: u32) {
        // Parse bone hierarchy for skinned meshes
        var skeleton = ImportedSkeleton {
            bone_names: []
            bone_parents: []
            bone_transforms: []
            bone_count: 0
        }

        // Parse hierarchy header and pivots
        // ... (implementation details)

        self.skeleton = skeleton
    }

    fn parse_animation(self, data: []u8, offset: usize, size: u32) {
        // Parse uncompressed animation
        var anim = ImportedAnimation {
            name: [0; 32]
            frame_count: 0
            frame_rate: 30.0
            bone_channels: []
            channel_count: 0
        }

        // Parse animation header and channels
        // ... (implementation details)

        self.add_animation(anim)
    }

    fn parse_compressed_animation(self, data: []u8, offset: usize, size: u32) {
        // Parse time-coded or adaptive delta compressed animation
        var anim = ImportedAnimation {
            name: [0; 32]
            frame_count: 0
            frame_rate: 30.0
            bone_channels: []
            channel_count: 0
        }

        // Decompress animation data
        // ... (implementation details)

        self.add_animation(anim)
    }

    fn parse_hlod(self, data: []u8, offset: usize, size: u32) {
        // Parse hierarchical LOD data
        // Links meshes to skeleton bones and defines LOD levels
    }

    fn add_mesh(self, mesh: ImportedMesh) {
        let new_meshes = self.allocator.alloc(ImportedMesh, self.mesh_count + 1)
        for i in 0..self.mesh_count {
            new_meshes[i] = self.meshes[i]
        }
        new_meshes[self.mesh_count] = mesh

        if self.mesh_count > 0 {
            self.allocator.free(self.meshes)
        }

        self.meshes = new_meshes
        self.mesh_count += 1
    }

    fn add_animation(self, anim: ImportedAnimation) {
        let new_anims = self.allocator.alloc(ImportedAnimation, self.animation_count + 1)
        for i in 0..self.animation_count {
            new_anims[i] = self.animations[i]
        }
        new_anims[self.animation_count] = anim

        if self.animation_count > 0 {
            self.allocator.free(self.animations)
        }

        self.animations = new_anims
        self.animation_count += 1
    }

    fn export_to_binary(self, dest_path: string): bool {
        // Export to Home binary mesh format
        // Header: magic (4), mesh_count (4), skeleton_present (4), anim_count (4)
        // Then mesh data, skeleton data, animation data

        var total_size: usize = 16  // Header

        // Calculate total size
        for i in 0..self.mesh_count {
            let mesh = &self.meshes[i]
            total_size += 16  // mesh header
            total_size += mesh.vertex_count * 12  // vertices
            total_size += mesh.vertex_count * 12  // normals
            total_size += mesh.vertex_count * 8   // uvs
            total_size += mesh.triangle_count * 6 // indices
        }

        var output = self.allocator.alloc(u8, total_size)

        // Write header
        @ptrCast(*u32, &output[0]).* = 0x4853454D  // "MESH"
        @ptrCast(*u32, &output[4]).* = self.mesh_count
        @ptrCast(*u32, &output[8]).* = if self.skeleton { 1 } else { 0 }
        @ptrCast(*u32, &output[12]).* = self.animation_count

        // Write mesh data
        var pos: usize = 16
        for i in 0..self.mesh_count {
            let mesh = &self.meshes[i]

            @ptrCast(*u32, &output[pos]).* = mesh.vertex_count
            @ptrCast(*u32, &output[pos + 4]).* = mesh.triangle_count
            @ptrCast(*u32, &output[pos + 8]).* = mesh.material_index
            pos += 16

            // Vertices
            let vert_size = mesh.vertex_count * 12
            @memcpy(&output[pos], mesh.vertices.ptr, vert_size)
            pos += vert_size

            // Normals
            @memcpy(&output[pos], mesh.normals.ptr, vert_size)
            pos += vert_size

            // Indices
            let idx_size = mesh.triangle_count * 6
            @memcpy(&output[pos], mesh.indices.ptr, idx_size)
            pos += idx_size
        }

        return write_file(dest_path, output)
    }
}

// ============================================================================
// AUDIO CONVERTER (W15-052)
// Converts WAV/MP3/OGG audio to platform-optimized formats
// ============================================================================

enum AudioFormat {
    WAV_PCM_8       // 8-bit PCM
    WAV_PCM_16      // 16-bit PCM
    WAV_PCM_24      // 24-bit PCM
    WAV_PCM_32      // 32-bit PCM
    MP3             // MPEG Layer 3
    OGG_VORBIS      // Ogg Vorbis
    ADPCM           // IMA ADPCM (compressed)
    Platform        // Platform-specific optimal format
}

struct WAVHeader {
    riff_magic: u32         // "RIFF"
    file_size: u32
    wave_magic: u32         // "WAVE"
    fmt_magic: u32          // "fmt "
    fmt_size: u32
    audio_format: u16       // 1 = PCM
    num_channels: u16
    sample_rate: u32
    byte_rate: u32
    block_align: u16
    bits_per_sample: u16
    data_magic: u32         // "data"
    data_size: u32
}

struct AudioData {
    sample_rate: u32
    channels: u16
    bits_per_sample: u16
    format: AudioFormat
    samples: []u8
    sample_count: u32
    duration_ms: u32
}

struct AudioConverter {
    allocator: Allocator
    target_sample_rate: u32
    target_channels: u16
    target_bits: u16
    normalize_volume: bool

    fn init(allocator: Allocator): AudioConverter {
        return AudioConverter {
            allocator: allocator
            target_sample_rate: 44100
            target_channels: 2
            target_bits: 16
            normalize_volume: true
        }
    }

    fn convert_wav(self, source_path: string, dest_path: string): bool {
        let file_data = read_file(source_path)
        if file_data.len < 44 {
            println("Error: WAV file too small")
            return false
        }

        let header = @ptrCast(*WAVHeader, file_data.ptr)

        // Verify WAV magic
        if header.riff_magic != 0x46464952 or header.wave_magic != 0x45564157 {
            println("Error: Invalid WAV magic")
            return false
        }

        let audio = AudioData {
            sample_rate: header.sample_rate
            channels: header.num_channels
            bits_per_sample: header.bits_per_sample
            format: self.bits_to_format(header.bits_per_sample)
            samples: file_data[44..]
            sample_count: header.data_size / (header.num_channels * header.bits_per_sample / 8)
            duration_ms: @intCast(u32, header.data_size * 1000 / header.byte_rate)
        }

        // Resample if needed
        if audio.sample_rate != self.target_sample_rate {
            return self.resample_and_write(&audio, dest_path)
        }

        // Convert channels if needed
        if audio.channels != self.target_channels {
            return self.convert_channels_and_write(&audio, dest_path)
        }

        // Normalize volume if requested
        if self.normalize_volume {
            return self.normalize_and_write(&audio, dest_path)
        }

        return self.write_audio(&audio, dest_path)
    }

    fn convert_mp3(self, source_path: string, dest_path: string): bool {
        // MP3 decoding would use an external decoder library
        // For now, just copy the file
        return copy_file(source_path, dest_path)
    }

    fn convert_ogg(self, source_path: string, dest_path: string): bool {
        // Ogg Vorbis decoding would use stb_vorbis or similar
        // For now, just copy the file
        return copy_file(source_path, dest_path)
    }

    fn bits_to_format(&self, bits: u16): AudioFormat {
        return match bits {
            8 => AudioFormat.WAV_PCM_8
            16 => AudioFormat.WAV_PCM_16
            24 => AudioFormat.WAV_PCM_24
            32 => AudioFormat.WAV_PCM_32
            _ => AudioFormat.WAV_PCM_16
        }
    }

    fn resample_and_write(self, audio: *AudioData, dest_path: string): bool {
        // Linear interpolation resampling
        let ratio = @intToFloat(f32, self.target_sample_rate) / @intToFloat(f32, audio.sample_rate)
        let new_sample_count = @floatToInt(u32, @intToFloat(f32, audio.sample_count) * ratio)

        let bytes_per_sample = audio.channels * audio.bits_per_sample / 8
        let new_size = new_sample_count * bytes_per_sample

        var resampled = self.allocator.alloc(u8, new_size)

        // Perform resampling
        for i in 0..new_sample_count {
            let src_pos = @intToFloat(f32, i) / ratio
            let src_idx = @floatToInt(u32, src_pos)
            let frac = src_pos - @intToFloat(f32, src_idx)

            // Linear interpolation between samples
            // ... (implementation details)
        }

        let new_audio = AudioData {
            sample_rate: self.target_sample_rate
            channels: audio.channels
            bits_per_sample: audio.bits_per_sample
            format: audio.format
            samples: resampled
            sample_count: new_sample_count
            duration_ms: new_sample_count * 1000 / self.target_sample_rate
        }

        return self.write_audio(&new_audio, dest_path)
    }

    fn convert_channels_and_write(self, audio: *AudioData, dest_path: string): bool {
        if audio.channels == 1 and self.target_channels == 2 {
            // Mono to stereo
            return self.mono_to_stereo(audio, dest_path)
        } else if audio.channels == 2 and self.target_channels == 1 {
            // Stereo to mono
            return self.stereo_to_mono(audio, dest_path)
        }

        return self.write_audio(audio, dest_path)
    }

    fn mono_to_stereo(self, audio: *AudioData, dest_path: string): bool {
        let bytes_per_sample = audio.bits_per_sample / 8
        let new_size = audio.sample_count * 2 * bytes_per_sample

        var stereo_data = self.allocator.alloc(u8, new_size)

        // Duplicate mono samples to both channels
        for i in 0..audio.sample_count {
            let src_offset = i * bytes_per_sample
            let dst_offset = i * bytes_per_sample * 2

            @memcpy(&stereo_data[dst_offset], &audio.samples[src_offset], bytes_per_sample)
            @memcpy(&stereo_data[dst_offset + bytes_per_sample], &audio.samples[src_offset], bytes_per_sample)
        }

        let new_audio = AudioData {
            sample_rate: audio.sample_rate
            channels: 2
            bits_per_sample: audio.bits_per_sample
            format: audio.format
            samples: stereo_data
            sample_count: audio.sample_count
            duration_ms: audio.duration_ms
        }

        return self.write_audio(&new_audio, dest_path)
    }

    fn stereo_to_mono(self, audio: *AudioData, dest_path: string): bool {
        let bytes_per_sample = audio.bits_per_sample / 8
        let new_size = audio.sample_count * bytes_per_sample

        var mono_data = self.allocator.alloc(u8, new_size)

        // Average left and right channels
        for i in 0..audio.sample_count {
            let src_offset = i * bytes_per_sample * 2
            let dst_offset = i * bytes_per_sample

            if audio.bits_per_sample == 16 {
                let left = @ptrCast(*i16, &audio.samples[src_offset]).*
                let right = @ptrCast(*i16, &audio.samples[src_offset + 2]).*
                let mixed = (left + right) / 2
                @ptrCast(*i16, &mono_data[dst_offset]).* = mixed
            }
        }

        let new_audio = AudioData {
            sample_rate: audio.sample_rate
            channels: 1
            bits_per_sample: audio.bits_per_sample
            format: audio.format
            samples: mono_data
            sample_count: audio.sample_count
            duration_ms: audio.duration_ms
        }

        return self.write_audio(&new_audio, dest_path)
    }

    fn normalize_and_write(self, audio: *AudioData, dest_path: string): bool {
        // Find peak amplitude
        var peak: i32 = 0

        if audio.bits_per_sample == 16 {
            for i in 0..audio.sample_count * audio.channels {
                let sample = @abs(@ptrCast(*i16, &audio.samples[i * 2]).*)
                if sample > peak {
                    peak = sample
                }
            }

            // Calculate normalization factor
            if peak > 0 {
                let factor = 32767.0 / @intToFloat(f32, peak)

                // Apply normalization
                for i in 0..audio.sample_count * audio.channels {
                    let sample = @ptrCast(*i16, &audio.samples[i * 2]).*
                    let normalized = @floatToInt(i16, @intToFloat(f32, sample) * factor)
                    @ptrCast(*i16, &audio.samples[i * 2]).* = normalized
                }
            }
        }

        return self.write_audio(audio, dest_path)
    }

    fn write_audio(self, audio: *AudioData, dest_path: string): bool {
        // Write as WAV format
        let header_size: usize = 44
        let data_size = audio.samples.len
        let file_size = header_size + data_size

        var output = self.allocator.alloc(u8, file_size)

        // RIFF header
        @ptrCast(*u32, &output[0]).* = 0x46464952   // "RIFF"
        @ptrCast(*u32, &output[4]).* = @intCast(u32, file_size - 8)
        @ptrCast(*u32, &output[8]).* = 0x45564157   // "WAVE"

        // fmt chunk
        @ptrCast(*u32, &output[12]).* = 0x20746D66  // "fmt "
        @ptrCast(*u32, &output[16]).* = 16          // fmt chunk size
        @ptrCast(*u16, &output[20]).* = 1           // PCM format
        @ptrCast(*u16, &output[22]).* = audio.channels
        @ptrCast(*u32, &output[24]).* = audio.sample_rate
        @ptrCast(*u32, &output[28]).* = audio.sample_rate * audio.channels * audio.bits_per_sample / 8
        @ptrCast(*u16, &output[32]).* = audio.channels * audio.bits_per_sample / 8
        @ptrCast(*u16, &output[34]).* = audio.bits_per_sample

        // data chunk
        @ptrCast(*u32, &output[36]).* = 0x61746164  // "data"
        @ptrCast(*u32, &output[40]).* = @intCast(u32, data_size)

        // Copy audio data
        @memcpy(&output[44], audio.samples.ptr, data_size)

        return write_file(dest_path, output)
    }
}

// ============================================================================
// BIG ARCHIVE BUILDER (W15-053)
// Creates EA BIG archive files for packaging assets
// ============================================================================

struct BIGHeader {
    magic: u32              // "BIGF" or "BIG4"
    archive_size: u32       // Total archive size
    num_files: u32          // Number of files
    first_file_offset: u32  // Offset to first file data
}

struct BIGFileEntry {
    offset: u32             // Offset in archive
    size: u32               // File size
    name: [256]u8           // Null-terminated filename
}

enum BIGCompression {
    None            // No compression
    RefPack         // EA RefPack compression
    ZLib            // ZLib compression
}

struct BIGArchiveBuilder {
    allocator: Allocator
    files: []BIGFileEntry
    file_data: [][]u8
    file_count: u32
    compression: BIGCompression
    use_big4_format: bool   // BIG4 vs BIGF

    fn init(allocator: Allocator): BIGArchiveBuilder {
        return BIGArchiveBuilder {
            allocator: allocator
            files: []
            file_data: []
            file_count: 0
            compression: BIGCompression.None
            use_big4_format: true
        }
    }

    fn add_file(self, path: string, archive_name: string): bool {
        let data = read_file(path)
        if data.len == 0 {
            println("Error: Could not read file: {path}")
            return false
        }

        var entry = BIGFileEntry {
            offset: 0  // Will be calculated during build
            size: @intCast(u32, data.len)
            name: [0; 256]
        }

        // Copy archive name (convert forward slashes to backslashes for EA format)
        for i in 0..@min(archive_name.len, 255) {
            if archive_name[i] == '/' {
                entry.name[i] = '\\'
            } else {
                entry.name[i] = archive_name[i]
            }
        }

        // Add to file list
        let new_files = self.allocator.alloc(BIGFileEntry, self.file_count + 1)
        let new_data = self.allocator.alloc([]u8, self.file_count + 1)

        for i in 0..self.file_count {
            new_files[i] = self.files[i]
            new_data[i] = self.file_data[i]
        }

        new_files[self.file_count] = entry
        new_data[self.file_count] = data

        if self.file_count > 0 {
            self.allocator.free(self.files)
            self.allocator.free(self.file_data)
        }

        self.files = new_files
        self.file_data = new_data
        self.file_count += 1

        return true
    }

    fn add_directory(self, dir_path: string, archive_prefix: string): u32 {
        var files_added: u32 = 0

        let file_list = scan_directory_recursive(dir_path)

        for file_path in file_list {
            // Calculate relative path for archive name
            let relative_path = file_path[dir_path.len..]
            let archive_name = archive_prefix + relative_path

            if self.add_file(file_path, archive_name) {
                files_added += 1
            }
        }

        return files_added
    }

    fn build(self, output_path: string): bool {
        if self.file_count == 0 {
            println("Error: No files to archive")
            return false
        }

        // Calculate header and directory size
        let header_size: usize = 16
        var dir_size: usize = 0

        for i in 0..self.file_count {
            // Each entry: offset (4) + size (4) + name (variable, null-terminated)
            let name_len = self.get_name_length(&self.files[i])
            dir_size += 8 + name_len + 1
        }

        let first_file_offset = header_size + dir_size

        // Calculate file offsets
        var current_offset = first_file_offset
        for i in 0..self.file_count {
            self.files[i].offset = @intCast(u32, current_offset)
            current_offset += self.files[i].size
        }

        let total_size = current_offset

        // Allocate output buffer
        var output = self.allocator.alloc(u8, total_size)

        // Write header
        if self.use_big4_format {
            @ptrCast(*u32, &output[0]).* = 0x34474942  // "BIG4"
        } else {
            @ptrCast(*u32, &output[0]).* = 0x46474942  // "BIGF"
        }
        @ptrCast(*u32, &output[4]).* = @intCast(u32, total_size)

        // BIG format uses big-endian for these fields
        output[8] = @intCast(u8, (self.file_count >> 24) & 0xFF)
        output[9] = @intCast(u8, (self.file_count >> 16) & 0xFF)
        output[10] = @intCast(u8, (self.file_count >> 8) & 0xFF)
        output[11] = @intCast(u8, self.file_count & 0xFF)

        output[12] = @intCast(u8, (first_file_offset >> 24) & 0xFF)
        output[13] = @intCast(u8, (first_file_offset >> 16) & 0xFF)
        output[14] = @intCast(u8, (first_file_offset >> 8) & 0xFF)
        output[15] = @intCast(u8, first_file_offset & 0xFF)

        // Write file directory
        var dir_pos: usize = header_size
        for i in 0..self.file_count {
            let entry = &self.files[i]

            // Offset (big-endian)
            output[dir_pos + 0] = @intCast(u8, (entry.offset >> 24) & 0xFF)
            output[dir_pos + 1] = @intCast(u8, (entry.offset >> 16) & 0xFF)
            output[dir_pos + 2] = @intCast(u8, (entry.offset >> 8) & 0xFF)
            output[dir_pos + 3] = @intCast(u8, entry.offset & 0xFF)

            // Size (big-endian)
            output[dir_pos + 4] = @intCast(u8, (entry.size >> 24) & 0xFF)
            output[dir_pos + 5] = @intCast(u8, (entry.size >> 16) & 0xFF)
            output[dir_pos + 6] = @intCast(u8, (entry.size >> 8) & 0xFF)
            output[dir_pos + 7] = @intCast(u8, entry.size & 0xFF)

            dir_pos += 8

            // Name (null-terminated)
            let name_len = self.get_name_length(entry)
            @memcpy(&output[dir_pos], &entry.name[0], name_len)
            output[dir_pos + name_len] = 0
            dir_pos += name_len + 1
        }

        // Write file data
        for i in 0..self.file_count {
            let entry = &self.files[i]
            let data = self.file_data[i]

            // Optionally compress data
            if self.compression != BIGCompression.None {
                let compressed = self.compress_data(data)
                @memcpy(&output[entry.offset], compressed.ptr, compressed.len)
            } else {
                @memcpy(&output[entry.offset], data.ptr, data.len)
            }
        }

        // Write output file
        let success = write_file(output_path, output)

        if success {
            println("Created BIG archive: {output_path}")
            println("  Files: {self.file_count}")
            println("  Size: {total_size} bytes")
        }

        return success
    }

    fn get_name_length(&self, entry: *BIGFileEntry): usize {
        var len: usize = 0
        while len < 256 and entry.name[len] != 0 {
            len += 1
        }
        return len
    }

    fn compress_data(self, data: []u8): []u8 {
        match self.compression {
            BIGCompression.RefPack => {
                return self.refpack_compress(data)
            }
            BIGCompression.ZLib => {
                return self.zlib_compress(data)
            }
            _ => {
                return data
            }
        }
    }

    fn refpack_compress(self, data: []u8): []u8 {
        // EA RefPack compression algorithm
        // This is a custom LZ77 variant used by EA games

        // For now, return uncompressed data
        // Full implementation would use sliding window compression
        return data
    }

    fn zlib_compress(self, data: []u8): []u8 {
        // ZLib compression
        // Would use system zlib or miniz

        // For now, return uncompressed data
        return data
    }

    fn set_compression(self, compression: BIGCompression) {
        self.compression = compression
    }

    fn deinit(self) {
        for i in 0..self.file_count {
            self.allocator.free(self.file_data[i])
        }

        if self.file_count > 0 {
            self.allocator.free(self.files)
            self.allocator.free(self.file_data)
        }
    }
}

// ============================================================================
// ASSET PIPELINE (Original code continues below)
// ============================================================================

// Asset pipeline
struct AssetPipeline {
    config: PipelineConfig
    tasks: []AssetConversionTask
    task_count: usize
    stats: ConversionStats
    allocator: Allocator

    fn init(allocator: Allocator, config: PipelineConfig): AssetPipeline {
        return AssetPipeline {
            config: config
            tasks: []
            task_count: 0
            stats: ConversionStats {
                total_tasks: 0
                completed_tasks: 0
                failed_tasks: 0
                total_bytes_processed: 0
                start_time: 0.0
                end_time: 0.0
            }
            allocator: allocator
        }
    }

    fn scan_assets(self) {
        println("Scanning asset directories...")

        // Scan for W3D models
        self.scan_directory_for_type(
            self.config.source_data_dir + "W3D/",
            "*.w3d",
            AssetType.Model,
            self.config.output_dir + "Models/"
        )

        // Scan for textures
        self.scan_directory_for_type(
            self.config.source_data_dir + "Textures/",
            "*.dds",
            AssetType.Texture,
            self.config.output_dir + "Textures/"
        )

        self.scan_directory_for_type(
            self.config.source_data_dir + "Textures/",
            "*.tga",
            AssetType.Texture,
            self.config.output_dir + "Textures/"
        )

        // Scan for audio
        self.scan_directory_for_type(
            self.config.source_data_dir + "Audio/Sounds/",
            "*.wav",
            AssetType.Audio,
            self.config.output_dir + "Audio/Sounds/"
        )

        self.scan_directory_for_type(
            self.config.source_data_dir + "Audio/Music/",
            "*.mp3",
            AssetType.Audio,
            self.config.output_dir + "Audio/Music/"
        )

        // Scan for INI data files
        self.scan_directory_for_type(
            self.config.source_data_dir + "INI/",
            "*.ini",
            AssetType.Data,
            self.config.output_dir + "Data/"
        )

        println("Found {self.task_count} assets to convert")
    }

    fn scan_directory_for_type(
        self,
        source_dir: string,
        pattern: string,
        asset_type: AssetType,
        output_dir: string
    ) {
        let files = filesystem_scan_directory(source_dir, pattern)

        for file_path in files {
            let filename = filesystem_get_filename(file_path)
            let output_path = output_dir + filename

            // Change extension based on asset type
            match asset_type {
                AssetType.Model => {
                    output_path = output_path.replace(".w3d", ".mesh")
                }
                AssetType.Texture => {
                    output_path = output_path.replace(".dds", ".tex")
                    output_path = output_path.replace(".tga", ".tex")
                }
                AssetType.Audio => {
                    // Keep original format for now
                }
                AssetType.Data => {
                    output_path = output_path.replace(".ini", ".dat")
                }
                _ => {}
            }

            self.add_task(AssetConversionTask {
                asset_type: asset_type
                source_path: file_path
                output_path: output_path
                priority: self.get_asset_priority(asset_type)
                completed: false
            })
        }
    }

    fn get_asset_priority(&self, asset_type: AssetType): i32 {
        // Convert critical assets first
        return match asset_type {
            AssetType.Data => 100      // INI data is critical for loading
            AssetType.Model => 80      // Models needed for rendering
            AssetType.Texture => 70    // Textures needed for models
            AssetType.Audio => 50      // Audio can load later
            AssetType.Shader => 90     // Shaders needed early
            _ => 0
        }
    }

    fn add_task(self, task: AssetConversionTask) {
        let new_tasks = self.allocator.alloc(AssetConversionTask, self.task_count + 1)

        for i in 0..self.task_count {
            new_tasks[i] = self.tasks[i]
        }

        new_tasks[self.task_count] = task

        if self.task_count > 0 {
            self.allocator.free(self.tasks)
        }

        self.tasks = new_tasks
        self.task_count += 1
    }

    fn sort_tasks_by_priority(self) {
        // Simple bubble sort by priority (descending)
        for i in 0..self.task_count {
            for j in 0..(self.task_count - i - 1) {
                if self.tasks[j].priority < self.tasks[j + 1].priority {
                    let temp = self.tasks[j]
                    self.tasks[j] = self.tasks[j + 1]
                    self.tasks[j + 1] = temp
                }
            }
        }
    }

    fn process_all_assets(self) {
        println("=== Starting Asset Pipeline ===")

        self.stats.total_tasks = @intCast(u32, self.task_count)
        self.stats.start_time = get_current_time()

        // Sort by priority
        self.sort_tasks_by_priority()

        // Create output directories
        self.create_output_directories()

        // Process each task
        for i in 0..self.task_count {
            let success = self.process_task(&self.tasks[i])

            if success {
                self.tasks[i].completed = true
                self.stats.completed_tasks += 1
            } else {
                self.stats.failed_tasks += 1
            }

            // Print progress
            if (i + 1) % 100 == 0 {
                self.print_progress()
            }
        }

        self.stats.end_time = get_current_time()

        self.print_final_report()
    }

    fn create_output_directories(&self) {
        filesystem_create_directory(self.config.output_dir)
        filesystem_create_directory(self.config.output_dir + "Models/")
        filesystem_create_directory(self.config.output_dir + "Textures/")
        filesystem_create_directory(self.config.output_dir + "Audio/")
        filesystem_create_directory(self.config.output_dir + "Audio/Sounds/")
        filesystem_create_directory(self.config.output_dir + "Audio/Music/")
        filesystem_create_directory(self.config.output_dir + "Data/")
    }

    fn process_task(self, task: *AssetConversionTask): bool {
        println("Converting: {task.source_path}")

        match task.asset_type {
            AssetType.Model => {
                return self.convert_model(task)
            }
            AssetType.Texture => {
                return self.convert_texture(task)
            }
            AssetType.Audio => {
                return self.convert_audio(task)
            }
            AssetType.Data => {
                return self.convert_data_file(task)
            }
            _ => {
                println("  Skipped: Unknown asset type")
                return false
            }
        }
    }

    fn convert_model(self, task: *AssetConversionTask): bool {
        // Use W3D importer
        var importer = W3DImporter.init(self.allocator)

        if !importer.import(task.source_path) {
            println("  ✗ Failed to parse W3D model")
            return false
        }

        let result = importer.export_to_binary(task.output_path)

        if result {
            println("  ✓ Model converted ({importer.mesh_count} meshes, {importer.animation_count} anims)")
        } else {
            println("  ✗ Model export failed")
        }

        return result
    }

    fn convert_texture(self, task: *AssetConversionTask): bool {
        var converter = TextureConverter.init(self.allocator)

        let source_lower = task.source_path.to_lower()
        var success = false

        if source_lower.ends_with(".dds") {
            success = converter.convert_dds(task.source_path, task.output_path)
        } else if source_lower.ends_with(".tga") {
            success = converter.convert_tga(task.source_path, task.output_path)
        } else if source_lower.ends_with(".bmp") {
            success = converter.convert_bmp(task.source_path, task.output_path)
        } else {
            // Unknown format, try to copy
            success = filesystem_copy_file(task.source_path, task.output_path)
        }

        if success {
            println("  ✓ Texture converted")
        } else {
            println("  ✗ Texture conversion failed")
        }

        return success
    }

    fn convert_audio(self, task: *AssetConversionTask): bool {
        var converter = AudioConverter.init(self.allocator)

        let source_lower = task.source_path.to_lower()
        var success = false

        if source_lower.ends_with(".wav") {
            success = converter.convert_wav(task.source_path, task.output_path)
        } else if source_lower.ends_with(".mp3") {
            success = converter.convert_mp3(task.source_path, task.output_path)
        } else if source_lower.ends_with(".ogg") {
            success = converter.convert_ogg(task.source_path, task.output_path)
        } else {
            // Unknown format, copy directly
            success = filesystem_copy_file(task.source_path, task.output_path)
        }

        if success {
            println("  ✓ Audio converted")
        } else {
            println("  ✗ Audio conversion failed")
        }

        return success
    }

    fn convert_data_file(self, task: *AssetConversionTask): bool {
        // Parse INI file and convert to binary format
        let mut parser = INIParser.init(self.allocator)
        let doc = parser.parse_file(task.source_path)

        if !doc {
            println("  ✗ Failed to parse INI file")
            return false
        }

        // For now, just validate that it parsed correctly
        println("  ✓ INI file parsed ({doc.?.sections.len} sections)")

        // TODO: Serialize to binary format
        return true
    }

    fn print_progress(&self) {
        let progress = self.stats.get_progress() * 100.0
        println("Progress: {self.stats.completed_tasks}/{self.stats.total_tasks} ({progress:.1}%)")
    }

    fn print_final_report(&self) {
        println("\n=== Asset Pipeline Complete ===")
        println("Total Assets: {self.stats.total_tasks}")
        println("Converted: {self.stats.completed_tasks}")
        println("Failed: {self.stats.failed_tasks}")
        println("Time Elapsed: {self.stats.get_elapsed_time():.2}s")
        println("Success Rate: {self.stats.get_progress() * 100.0:.1}%")
    }

    fn deinit(self) {
        if self.task_count > 0 {
            self.allocator.free(self.tasks)
        }
    }
}

// Global asset pipeline instance
var g_asset_pipeline: ?AssetPipeline = null

export fn init_asset_pipeline(config: PipelineConfig) {
    let allocator = get_global_allocator()
    g_asset_pipeline = AssetPipeline.init(allocator, config)
}

export fn run_asset_pipeline() {
    if !g_asset_pipeline {
        println("Error: Asset pipeline not initialized")
        return
    }

    g_asset_pipeline.?.scan_assets()
    g_asset_pipeline.?.process_all_assets()
}

export fn shutdown_asset_pipeline() {
    if g_asset_pipeline {
        g_asset_pipeline.?.deinit()
        g_asset_pipeline = null
    }
}

