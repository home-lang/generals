// Global Steam instance
var g_steam: ?Steam = null

// Exported functions
export fn steam_init(): bool {
    let steam = Steam::init()
    if steam {
        g_steam = steam
        return true
    }
    return false
}

export fn steam_shutdown() {
    if g_steam {
        g_steam.?.shutdown()
        g_steam = null
    }
}

export fn steam_update() {
    if g_steam {
        g_steam.?.update()
    }
}

export fn steam_unlock_achievement(id: string): bool {
    if g_steam {
        return g_steam.?.unlock_achievement(id)
    }
    return false
}

export fn steam_create_lobby(lobby_type: i32, max_members: u32): bool {
    if g_steam {
        return g_steam.?.create_lobby(@intToEnum(ELobbyType, lobby_type), max_members)
    }
    return false
}

export fn steam_join_lobby(lobby_id: u64): bool {
    if g_steam {
        return g_steam.?.join_lobby(lobby_id)
    }
    return false
}

export fn steam_leave_lobby() {
    if g_steam {
        g_steam.?.leave_lobby()
    }
}

export fn steam_cloud_save(filename: string, data: []u8): bool {
    if g_steam {
        return g_steam.?.cloud_save(filename, data)
    }
    return false
}

export fn steam_cloud_load(filename: string): ?[]u8 {
    if g_steam {
        return g_steam.?.cloud_load(filename)
    }
    return null
}

export fn steam_set_rich_presence(key: string, value: string) {
    if g_steam {
        g_steam.?.set_rich_presence(key, value)
    }
}

export fn steam_is_initialized(): bool {
    return g_steam != null and g_steam.?.is_initialized
}

export fn steam_get_persona_name(): string {
    if g_steam {
        return g_steam.?.persona_name
    }
    return "Unknown"
}

export fn steam_get_steam_id(): u64 {
    if g_steam {
        return g_steam.?.steam_id
    }
    return 0
}
