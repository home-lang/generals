// Steam Integration
// C&C Generals Zero Hour - Home Port
// Steamworks SDK wrapper for achievements, cloud saves, multiplayer

// Steam API types
type HSteamPipe = i32
type HSteamUser = i32
type AppId_t = u32
type SteamAPICall_t = u64
type CSteamID = u64
type HAuthTicket = u32
type DepotId_t = u32
type PublishedFileId_t = u64

// Steam result codes
enum EResult {
    OK = 1
    Fail = 2
    NoConnection = 3
    InvalidPassword = 5
    LoggedInElsewhere = 6
    InvalidProtocolVer = 7
    InvalidParam = 8
    FileNotFound = 9
    Busy = 10
    InvalidState = 11
    InvalidName = 12
    InvalidEmail = 13
    DuplicateName = 14
    AccessDenied = 15
    Timeout = 16
    Banned = 17
    AccountNotFound = 18
    InvalidSteamID = 19
    ServiceUnavailable = 20
    NotLoggedOn = 21
    Pending = 22
    EncryptionFailure = 23
    InsufficientPrivilege = 24
    LimitExceeded = 25
}

// Lobby types
enum ELobbyType {
    Private = 0
    FriendsOnly = 1
    Public = 2
    Invisible = 3
}

// Achievement display type
enum AchievementDisplayType {
    Hidden = 0
    Progress = 1
    Complete = 2
}

// Steam persona state
enum EPersonaState {
    Offline = 0
    Online = 1
    Busy = 2
    Away = 3
    Snooze = 4
    LookingToTrade = 5
    LookingToPlay = 6
    Invisible = 7
}

// Leaderboard data request type
enum ELeaderboardDataRequest {
    Global = 0
    GlobalAroundUser = 1
    Friends = 2
    Users = 3
}

// Steam achievement definition
struct Achievement {
    id: string
    name: string
    description: string
    icon_name: string
    unlocked: bool
    unlock_time: u32
    progress: f32
    max_progress: f32
}

// Steam friend info
struct FriendInfo {
    steam_id: CSteamID
    persona_name: string
    persona_state: EPersonaState
    is_playing_this_game: bool
    game_lobby_id: CSteamID
}

// Lobby info
struct LobbyInfo {
    lobby_id: CSteamID
    owner_id: CSteamID
    max_members: u32
    current_members: u32
    lobby_type: ELobbyType
    data: [32]LobbyDataPair
    data_count: u32
}

struct LobbyDataPair {
    key: string
    value: string
}

// Leaderboard entry
struct LeaderboardEntry {
    steam_id: CSteamID
    global_rank: i32
    score: i32
    details: [64]i32
    detail_count: i32
}

// Cloud file info
struct CloudFileInfo {
    filename: string
    size: i32
    timestamp: u64
}

// External function declarations (Steamworks SDK)
extern "steam_api" fn SteamAPI_Init(): bool
extern "steam_api" fn SteamAPI_Shutdown()
extern "steam_api" fn SteamAPI_RunCallbacks()
extern "steam_api" fn SteamAPI_RestartAppIfNecessary(appId: AppId_t): bool
extern "steam_api" fn SteamAPI_GetHSteamPipe(): HSteamPipe
extern "steam_api" fn SteamAPI_GetHSteamUser(): HSteamUser

// User interface
extern "steam_api" fn SteamUser(): *ISteamUser
extern "steam_api" fn SteamFriends(): *ISteamFriends
extern "steam_api" fn SteamUtils(): *ISteamUtils
extern "steam_api" fn SteamMatchmaking(): *ISteamMatchmaking
extern "steam_api" fn SteamUserStats(): *ISteamUserStats
extern "steam_api" fn SteamApps(): *ISteamApps
extern "steam_api" fn SteamNetworking(): *ISteamNetworking
extern "steam_api" fn SteamRemoteStorage(): *ISteamRemoteStorage

// Interface types (opaque pointers)
type ISteamUser = void
type ISteamFriends = void
type ISteamUtils = void
type ISteamMatchmaking = void
type ISteamUserStats = void
type ISteamApps = void
type ISteamNetworking = void
type ISteamRemoteStorage = void

// C&C Generals Steam App ID
const GENERALS_STEAM_APP_ID: AppId_t = 0  // Replace with actual Steam App ID when available

// Steam integration singleton
struct Steam {
    is_initialized: bool
    steam_id: CSteamID
    persona_name: string

    // Cached data
    achievements: [64]Achievement
    achievement_count: u32
    friends: [256]FriendInfo
    friend_count: u32

    // Active lobby
    current_lobby: CSteamID
    is_in_lobby: bool

    // Cloud save state
    cloud_enabled: bool
    cloud_quota: u64
    cloud_used: u64

    fn init(): ?Steam {
        // Check if we need to restart through Steam
        if SteamAPI_RestartAppIfNecessary(GENERALS_STEAM_APP_ID) {
            // Steam will restart the application through the Steam client
            return null
        }

        // Initialize Steam API
        if !SteamAPI_Init() {
            log_error("Steam API initialization failed")
            return null
        }

        // Get user info
        let user = SteamUser()
        if user == null {
            SteamAPI_Shutdown()
            return null
        }

        let steam = Steam {
            is_initialized: true
            steam_id: get_steam_id()
            persona_name: get_persona_name()
            achievements: undefined
            achievement_count: 0
            friends: undefined
            friend_count: 0
            current_lobby: 0
            is_in_lobby: false
            cloud_enabled: false
            cloud_quota: 0
            cloud_used: 0
        }

        // Load achievements
        steam.load_achievements()

        // Load friends list
        steam.load_friends()

        // Check cloud status
        steam.check_cloud_status()

        log_info("Steam initialized: " + steam.persona_name)

        return steam
    }

    fn update(self) {
        if !self.is_initialized {
            return
        }

        // Process Steam callbacks
        SteamAPI_RunCallbacks()
    }

    fn shutdown(self) {
        if self.is_initialized {
            // Leave any active lobby
            if self.is_in_lobby {
                self.leave_lobby()
            }

            SteamAPI_Shutdown()
            self.is_initialized = false
            log_info("Steam shutdown")
        }
    }

    // --- Achievements ---

    fn load_achievements(self) {
        // Request achievement data from Steam
        let stats = SteamUserStats()
        if stats == null {
            return
        }

        // Define game achievements
        let achievement_defs = [
            ("ACH_FIRST_VICTORY", "First Victory", "Win your first skirmish match"),
            ("ACH_CAMPAIGN_USA", "American Hero", "Complete the USA campaign"),
            ("ACH_CAMPAIGN_CHINA", "Dragon's Fury", "Complete the China campaign"),
            ("ACH_CAMPAIGN_GLA", "Liberation", "Complete the GLA campaign"),
            ("ACH_CAMPAIGN_ALL", "World Dominator", "Complete all campaigns"),
            ("ACH_ONLINE_10", "Online Warrior", "Win 10 online matches"),
            ("ACH_ONLINE_100", "Online Commander", "Win 100 online matches"),
            ("ACH_GENERAL_POINTS", "Five Star General", "Earn all General's points in a match"),
            ("ACH_NUKE", "Nuclear Option", "Build and use a nuclear missile"),
            ("ACH_SUPERWEAPON_ALL", "Arsenal", "Use every superweapon in the game"),
            ("ACH_SPEEDRUN", "Blitzkrieg", "Complete a campaign mission in under 10 minutes"),
            ("ACH_NO_CASUALTIES", "Perfect Commander", "Win a match with no unit losses"),
            ("ACH_ARMY_SIZE", "Overwhelming Force", "Build an army of 200+ units"),
            ("ACH_ECONOMY", "War Profiteer", "Accumulate 100,000 credits in a single match"),
            ("ACH_DEFENSE", "Fortress", "Survive for 30 minutes against AI on Brutal"),
        ]

        for i in 0..achievement_defs.len {
            let (id, name, desc) = achievement_defs[i]
            self.achievements[i] = Achievement {
                id: id
                name: name
                description: desc
                icon_name: id + "_icon"
                unlocked: false
                unlock_time: 0
                progress: 0.0
                max_progress: 1.0
            }
        }
        self.achievement_count = @intCast(u32, achievement_defs.len)

        // Sync with Steam
        // request_user_stats() would be called here
    }

    fn unlock_achievement(self, achievement_id: string): bool {
        if !self.is_initialized {
            return false
        }

        // Find achievement
        for i in 0..self.achievement_count {
            if self.achievements[i].id == achievement_id {
                if self.achievements[i].unlocked {
                    return true  // Already unlocked
                }

                // Unlock through Steam
                // SteamUserStats()->SetAchievement(achievement_id)
                // SteamUserStats()->StoreStats()

                self.achievements[i].unlocked = true
                self.achievements[i].unlock_time = get_current_time()

                log_info("Achievement unlocked: " + self.achievements[i].name)
                return true
            }
        }

        return false
    }

    fn set_achievement_progress(self, achievement_id: string, progress: f32, max_progress: f32): bool {
        if !self.is_initialized {
            return false
        }

        for i in 0..self.achievement_count {
            if self.achievements[i].id == achievement_id {
                self.achievements[i].progress = progress
                self.achievements[i].max_progress = max_progress

                // Update Steam
                // SteamUserStats()->SetStat(achievement_id + "_progress", progress)

                // Check if complete
                if progress >= max_progress {
                    self.unlock_achievement(achievement_id)
                }

                return true
            }
        }

        return false
    }

    fn get_achievement(self, achievement_id: string): ?*Achievement {
        for i in 0..self.achievement_count {
            if self.achievements[i].id == achievement_id {
                return &self.achievements[i]
            }
        }
        return null
    }

    // --- Friends ---

    fn load_friends(self) {
        let friends_api = SteamFriends()
        if friends_api == null {
            return
        }

        // Get friend count
        // let count = SteamFriends()->GetFriendCount(k_EFriendFlagImmediate)

        // For now, initialize empty list
        self.friend_count = 0
    }

    fn get_friends_playing(self): []FriendInfo {
        var playing: [64]FriendInfo = undefined
        var count: u32 = 0

        for i in 0..self.friend_count {
            if self.friends[i].is_playing_this_game {
                playing[count] = self.friends[i]
                count += 1
            }
        }

        return playing[0..count]
    }

