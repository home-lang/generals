// Windows Platform Layer - Window Management
// C&C Generals Zero Hour - Home Port
// Win32 API wrapper for window creation and event handling

// Win32 types and constants
type HWND = *void
type HINSTANCE = *void
type HDC = *void
type HGLRC = *void
type WPARAM = usize
type LPARAM = isize
type LRESULT = isize
type ATOM = u16
type DWORD = u32
type BOOL = i32
type UINT = u32
type WNDPROC = fn(HWND, UINT, WPARAM, LPARAM): LRESULT

const WS_OVERLAPPEDWINDOW: DWORD = 0x00CF0000
const WS_VISIBLE: DWORD = 0x10000000
const WS_POPUP: DWORD = 0x80000000
const WS_CAPTION: DWORD = 0x00C00000
const WS_SYSMENU: DWORD = 0x00080000
const WS_MINIMIZEBOX: DWORD = 0x00020000
const WS_MAXIMIZEBOX: DWORD = 0x00010000

const WM_CREATE: UINT = 0x0001
const WM_DESTROY: UINT = 0x0002
const WM_CLOSE: UINT = 0x0010
const WM_PAINT: UINT = 0x000F
const WM_SIZE: UINT = 0x0005
const WM_KEYDOWN: UINT = 0x0100
const WM_KEYUP: UINT = 0x0101
const WM_MOUSEMOVE: UINT = 0x0200
const WM_LBUTTONDOWN: UINT = 0x0201
const WM_LBUTTONUP: UINT = 0x0202
const WM_RBUTTONDOWN: UINT = 0x0204
const WM_RBUTTONUP: UINT = 0x0205
const WM_MOUSEWHEEL: UINT = 0x020A

const CS_HREDRAW: UINT = 0x0002
const CS_VREDRAW: UINT = 0x0001
const CS_OWNDC: UINT = 0x0020

const CW_USEDEFAULT: i32 = 0x80000000

const PM_REMOVE: UINT = 0x0001

// Win32 structures
struct WNDCLASSEXW {
    cbSize: UINT
    style: UINT
    lpfnWndProc: WNDPROC
    cbClsExtra: i32
    cbWndExtra: i32
    hInstance: HINSTANCE
    hIcon: *void
    hCursor: *void
    hbrBackground: *void
    lpszMenuName: *const u16
    lpszClassName: *const u16
    hIconSm: *void
}

struct POINT {
    x: i32
    y: i32
}

struct MSG {
    hwnd: HWND
    message: UINT
    wParam: WPARAM
    lParam: LPARAM
    time: DWORD
    pt: POINT
}

struct RECT {
    left: i32
    top: i32
    right: i32
    bottom: i32
}

struct PAINTSTRUCT {
    hdc: HDC
    fErase: BOOL
    rcPaint: RECT
    fRestore: BOOL
    fIncUpdate: BOOL
    rgbReserved: [32]u8
}

// Win32 API declarations (imported from kernel32.dll, user32.dll, gdi32.dll)
extern "kernel32" fn GetModuleHandleW(lpModuleName: ?*const u16): HINSTANCE
extern "user32" fn RegisterClassExW(lpWndClass: *const WNDCLASSEXW): ATOM
extern "user32" fn CreateWindowExW(
    dwExStyle: DWORD,
    lpClassName: *const u16,
    lpWindowName: *const u16,
    dwStyle: DWORD,
    x: i32,
    y: i32,
    nWidth: i32,
    nHeight: i32,
    hWndParent: ?HWND,
    hMenu: ?*void,
    hInstance: HINSTANCE,
    lpParam: ?*void
): HWND
extern "user32" fn ShowWindow(hWnd: HWND, nCmdShow: i32): BOOL
extern "user32" fn UpdateWindow(hWnd: HWND): BOOL
extern "user32" fn DestroyWindow(hWnd: HWND): BOOL
extern "user32" fn PeekMessageW(lpMsg: *MSG, hWnd: ?HWND, wMsgFilterMin: UINT, wMsgFilterMax: UINT, wRemoveMsg: UINT): BOOL
extern "user32" fn TranslateMessage(lpMsg: *const MSG): BOOL
extern "user32" fn DispatchMessageW(lpMsg: *const MSG): LRESULT
extern "user32" fn DefWindowProcW(hWnd: HWND, uMsg: UINT, wParam: WPARAM, lParam: LPARAM): LRESULT
extern "user32" fn PostQuitMessage(nExitCode: i32)
extern "user32" fn GetClientRect(hWnd: HWND, lpRect: *RECT): BOOL
extern "user32" fn SetWindowTextW(hWnd: HWND, lpString: *const u16): BOOL
extern "user32" fn GetDC(hWnd: HWND): HDC
extern "user32" fn ReleaseDC(hWnd: HWND, hDC: HDC): i32
extern "user32" fn BeginPaint(hWnd: HWND, lpPaint: *PAINTSTRUCT): HDC
extern "user32" fn EndPaint(hWnd: HWND, lpPaint: *const PAINTSTRUCT): BOOL
extern "user32" fn LoadCursorW(hInstance: ?HINSTANCE, lpCursorName: *const u16): *void
extern "user32" fn SetCursor(hCursor: *void): *void
extern "user32" fn GetCursorPos(lpPoint: *POINT): BOOL
extern "user32" fn ScreenToClient(hWnd: HWND, lpPoint: *POINT): BOOL
extern "user32" fn SetCapture(hWnd: HWND): HWND
extern "user32" fn ReleaseCapture(): BOOL
extern "user32" fn ShowCursor(bShow: BOOL): i32
extern "user32" fn GetKeyState(nVirtKey: i32): i16
extern "user32" fn GetAsyncKeyState(vKey: i32): i16

// Virtual key codes
const VK_ESCAPE: i32 = 0x1B
const VK_RETURN: i32 = 0x0D
const VK_SPACE: i32 = 0x20
const VK_LEFT: i32 = 0x25
const VK_UP: i32 = 0x26
const VK_RIGHT: i32 = 0x27
const VK_DOWN: i32 = 0x28
const VK_SHIFT: i32 = 0x10
const VK_CONTROL: i32 = 0x11
const VK_MENU: i32 = 0x12  // Alt key
const VK_F1: i32 = 0x70
const VK_F2: i32 = 0x71
const VK_F3: i32 = 0x72
const VK_F4: i32 = 0x73
const VK_F5: i32 = 0x74
const VK_F6: i32 = 0x75
const VK_F7: i32 = 0x76
const VK_F8: i32 = 0x77
const VK_F9: i32 = 0x78
const VK_F10: i32 = 0x79
const VK_F11: i32 = 0x7A
const VK_F12: i32 = 0x7B

// Window state
struct WindowsWindow {
    hwnd: HWND
    hdc: HDC
    hInstance: HINSTANCE
    width: u32
    height: u32
    is_fullscreen: bool
    is_running: bool
    is_focused: bool
    title: string

    // Input state
    mouse_x: i32
    mouse_y: i32
    mouse_buttons: u32
    key_states: [256]bool

    fn init(title: string, width: u32, height: u32): ?WindowsWindow {
        let hInstance = GetModuleHandleW(null)
        if hInstance == null {
            return null
        }

        // Convert title to wide string
        let wTitle = string_to_wstring(title)

        // Register window class
        let class_name = string_to_wstring("GeneralsWindowClass")

        let wc = WNDCLASSEXW {
            cbSize: @sizeOf(WNDCLASSEXW)
            style: CS_HREDRAW | CS_VREDRAW | CS_OWNDC
            lpfnWndProc: window_proc
            cbClsExtra: 0
            cbWndExtra: 0
            hInstance: hInstance
            hIcon: null
            hCursor: LoadCursorW(null, @intToPtr(*const u16, 32512))  // IDC_ARROW
            hbrBackground: null
            lpszMenuName: null
            lpszClassName: class_name
            hIconSm: null
        }

        let atom = RegisterClassExW(&wc)
        if atom == 0 {
            return null
        }

        // Create window
        let style = WS_OVERLAPPEDWINDOW | WS_VISIBLE

        let hwnd = CreateWindowExW(
            0,
            class_name,
            wTitle,
            style,
            CW_USEDEFAULT,
            CW_USEDEFAULT,
            @intCast(i32, width),
            @intCast(i32, height),
            null,
            null,
            hInstance,
            null
        )

        if hwnd == null {
            return null
        }

        ShowWindow(hwnd, 1)  // SW_SHOW
        UpdateWindow(hwnd)

        let hdc = GetDC(hwnd)

        return WindowsWindow {
            hwnd: hwnd
            hdc: hdc
            hInstance: hInstance
            width: width
            height: height
            is_fullscreen: false
            is_running: true
            is_focused: true
            title: title
            mouse_x: 0
            mouse_y: 0
            mouse_buttons: 0
            key_states: [false; 256]
        }
    }

    fn poll_events(self): bool {
        var msg: MSG = undefined

        while PeekMessageW(&msg, null, 0, 0, PM_REMOVE) != 0 {
            if msg.message == WM_QUIT {
                self.is_running = false
                return false
            }
            TranslateMessage(&msg)
            DispatchMessageW(&msg)
        }

        return self.is_running
    }

    fn set_title(self, title: string) {
        let wTitle = string_to_wstring(title)
        SetWindowTextW(self.hwnd, wTitle)
        self.title = title
    }

    fn set_fullscreen(self, fullscreen: bool) {
        if fullscreen == self.is_fullscreen {
            return
        }

        // TODO: Implement fullscreen toggle using ChangeDisplaySettings
        self.is_fullscreen = fullscreen
    }

    fn get_size(self): (u32, u32) {
        var rect: RECT = undefined
        GetClientRect(self.hwnd, &rect)
        return (
            @intCast(u32, rect.right - rect.left),
            @intCast(u32, rect.bottom - rect.top)
        )
    }

    fn is_key_pressed(self, key: i32): bool {
        if key >= 0 and key < 256 {
            return self.key_states[@intCast(usize, key)]
        }
        return false
    }

    fn get_mouse_position(self): (i32, i32) {
        return (self.mouse_x, self.mouse_y)
    }

    fn is_mouse_button_pressed(self, button: u32): bool {
        return (self.mouse_buttons & (1 << button)) != 0
    }

    fn set_cursor_visible(self, visible: bool) {
        ShowCursor(if visible { 1 } else { 0 })
    }

    fn capture_mouse(self, capture: bool) {
        if capture {
            SetCapture(self.hwnd)
        } else {
            ReleaseCapture()
        }
    }

    fn close(self) {
        self.is_running = false
        if self.hdc {
            ReleaseDC(self.hwnd, self.hdc)
        }
        if self.hwnd {
            DestroyWindow(self.hwnd)
        }
    }
}

// Global window pointer for window proc
var g_window: ?*WindowsWindow = null

fn window_proc(hwnd: HWND, msg: UINT, wParam: WPARAM, lParam: LPARAM): LRESULT {
    if g_window == null {
        return DefWindowProcW(hwnd, msg, wParam, lParam)
    }

    let window = g_window.?

    match msg {
        WM_CLOSE => {
            window.is_running = false
            PostQuitMessage(0)
            return 0
        }
        WM_DESTROY => {
            PostQuitMessage(0)
            return 0
        }
        WM_SIZE => {
            let width = @intCast(u32, lParam & 0xFFFF)
            let height = @intCast(u32, (lParam >> 16) & 0xFFFF)
            window.width = width
            window.height = height
            return 0
        }
        WM_KEYDOWN => {
            let key = @intCast(usize, wParam)
            if key < 256 {
                window.key_states[key] = true
            }
            return 0
        }
        WM_KEYUP => {
            let key = @intCast(usize, wParam)
            if key < 256 {
                window.key_states[key] = false
            }
            return 0
        }
        WM_MOUSEMOVE => {
            window.mouse_x = @intCast(i32, lParam & 0xFFFF)
            window.mouse_y = @intCast(i32, (lParam >> 16) & 0xFFFF)
            return 0
        }
        WM_LBUTTONDOWN => {
            window.mouse_buttons |= 1
            return 0
        }
        WM_LBUTTONUP => {
            window.mouse_buttons &= ~1
            return 0
        }
        WM_RBUTTONDOWN => {
            window.mouse_buttons |= 2
            return 0
        }
        WM_RBUTTONUP => {
            window.mouse_buttons &= ~2
            return 0
        }
        WM_MOUSEWHEEL => {
            // Handle mouse wheel
            let delta = @intCast(i16, (wParam >> 16) & 0xFFFF)
            // TODO: Send wheel event
            return 0
        }
        _ => {
            return DefWindowProcW(hwnd, msg, wParam, lParam)
        }
    }
}

// Helper function to convert UTF-8 string to wide string
fn string_to_wstring(s: string): *const u16 {
    // Allocate buffer for wide string
    let len = s.len + 1
    var buffer = @alloc(u16, len)

    // Simple ASCII to UTF-16 conversion
    for i in 0..s.len {
        buffer[i] = @intCast(u16, s[i])
    }
    buffer[s.len] = 0  // Null terminator

    return buffer
}

// Export functions
export fn create_window(title: string, width: u32, height: u32): ?*WindowsWindow {
    let window = WindowsWindow::init(title, width, height)
    if window {
        let ptr = @alloc(WindowsWindow, 1)
        ptr.* = window.?
        g_window = ptr
        return ptr
    }
    return null
}

export fn destroy_window(window: *WindowsWindow) {
    window.close()
    g_window = null
}
