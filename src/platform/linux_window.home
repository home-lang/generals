// Linux Platform Layer - Window Management (X11/Wayland)
// C&C Generals Zero Hour - Home Port
// X11 API wrapper for window creation and event handling

// X11 types
type Display = *void
type Window = u64
type Colormap = u64
type Atom = u64
type XID = u64
type Time = u64
type Cursor = u64
type KeySym = u64
type KeyCode = u8
type Bool = i32
type Status = i32

// X11 constants
const None: u64 = 0
const True: Bool = 1
const False: Bool = 0

// Event masks
const KeyPressMask: i64 = 1 << 0
const KeyReleaseMask: i64 = 1 << 1
const ButtonPressMask: i64 = 1 << 2
const ButtonReleaseMask: i64 = 1 << 3
const EnterWindowMask: i64 = 1 << 4
const LeaveWindowMask: i64 = 1 << 5
const PointerMotionMask: i64 = 1 << 6
const ExposureMask: i64 = 1 << 15
const StructureNotifyMask: i64 = 1 << 17
const FocusChangeMask: i64 = 1 << 21

// Event types
const KeyPress: i32 = 2
const KeyRelease: i32 = 3
const ButtonPress: i32 = 4
const ButtonRelease: i32 = 5
const MotionNotify: i32 = 6
const EnterNotify: i32 = 7
const LeaveNotify: i32 = 8
const FocusIn: i32 = 9
const FocusOut: i32 = 10
const Expose: i32 = 12
const DestroyNotify: i32 = 17
const ConfigureNotify: i32 = 22
const ClientMessage: i32 = 33

// Window attributes
const CWBackPixel: u64 = 1 << 1
const CWBorderPixel: u64 = 1 << 3
const CWEventMask: u64 = 1 << 11
const CWColormap: u64 = 1 << 13

const InputOutput: u32 = 1

// Mouse buttons
const Button1: u32 = 1  // Left
const Button2: u32 = 2  // Middle
const Button3: u32 = 3  // Right
const Button4: u32 = 4  // Wheel up
const Button5: u32 = 5  // Wheel down

// X11 structures
struct XSetWindowAttributes {
    background_pixmap: u64
    background_pixel: u64
    border_pixmap: u64
    border_pixel: u64
    bit_gravity: i32
    win_gravity: i32
    backing_store: i32
    backing_planes: u64
    backing_pixel: u64
    save_under: Bool
    event_mask: i64
    do_not_propagate_mask: i64
    override_redirect: Bool
    colormap: Colormap
    cursor: Cursor
}

struct XWindowAttributes {
    x: i32
    y: i32
    width: i32
    height: i32
    border_width: i32
    depth: i32
    visual: *void
    root: Window
    class: i32
    bit_gravity: i32
    win_gravity: i32
    backing_store: i32
    backing_planes: u64
    backing_pixel: u64
    save_under: Bool
    colormap: Colormap
    map_installed: Bool
    map_state: i32
    all_event_masks: i64
    your_event_mask: i64
    do_not_propagate_mask: i64
    override_redirect: Bool
    screen: *void
}

struct XEvent {
    type: i32
    serial: u64
    send_event: Bool
    display: Display
    window: Window
    // Union of event types - we use the largest
    data: [24]i64
}

struct XKeyEvent {
    type: i32
    serial: u64
    send_event: Bool
    display: Display
    window: Window
    root: Window
    subwindow: Window
    time: Time
    x: i32
    y: i32
    x_root: i32
    y_root: i32
    state: u32
    keycode: u32
    same_screen: Bool
}

struct XButtonEvent {
    type: i32
    serial: u64
    send_event: Bool
    display: Display
    window: Window
    root: Window
    subwindow: Window
    time: Time
    x: i32
    y: i32
    x_root: i32
    y_root: i32
    state: u32
    button: u32
    same_screen: Bool
}

struct XMotionEvent {
    type: i32
    serial: u64
    send_event: Bool
    display: Display
    window: Window
    root: Window
    subwindow: Window
    time: Time
    x: i32
    y: i32
    x_root: i32
    y_root: i32
    state: u32
    is_hint: u8
    same_screen: Bool
}

struct XConfigureEvent {
    type: i32
    serial: u64
    send_event: Bool
    display: Display
    event: Window
    window: Window
    x: i32
    y: i32
    width: i32
    height: i32
    border_width: i32
    above: Window
    override_redirect: Bool
}

struct XClientMessageEvent {
    type: i32
    serial: u64
    send_event: Bool
    display: Display
    window: Window
    message_type: Atom
    format: i32
    data: [5]i64
}

// X11 API declarations
extern "X11" fn XOpenDisplay(display_name: ?*const u8): Display
extern "X11" fn XCloseDisplay(display: Display): i32
extern "X11" fn XDefaultScreen(display: Display): i32
extern "X11" fn XDefaultRootWindow(display: Display): Window
extern "X11" fn XDefaultVisual(display: Display, screen: i32): *void
extern "X11" fn XDefaultColormap(display: Display, screen: i32): Colormap
extern "X11" fn XDefaultDepth(display: Display, screen: i32): i32
extern "X11" fn XBlackPixel(display: Display, screen: i32): u64
extern "X11" fn XWhitePixel(display: Display, screen: i32): u64

extern "X11" fn XCreateWindow(
    display: Display,
    parent: Window,
    x: i32,
    y: i32,
    width: u32,
    height: u32,
    border_width: u32,
    depth: i32,
    class: u32,
    visual: *void,
    valuemask: u64,
    attributes: *XSetWindowAttributes
): Window

extern "X11" fn XDestroyWindow(display: Display, window: Window): i32
extern "X11" fn XMapWindow(display: Display, window: Window): i32
extern "X11" fn XUnmapWindow(display: Display, window: Window): i32
extern "X11" fn XStoreName(display: Display, window: Window, name: *const u8): i32
extern "X11" fn XFlush(display: Display): i32
extern "X11" fn XSync(display: Display, discard: Bool): i32

extern "X11" fn XPending(display: Display): i32
extern "X11" fn XNextEvent(display: Display, event: *XEvent): i32
extern "X11" fn XPeekEvent(display: Display, event: *XEvent): i32

extern "X11" fn XInternAtom(display: Display, atom_name: *const u8, only_if_exists: Bool): Atom
extern "X11" fn XSetWMProtocols(display: Display, window: Window, protocols: *Atom, count: i32): Status

extern "X11" fn XLookupKeysym(event: *XKeyEvent, index: i32): KeySym
extern "X11" fn XKeysymToKeycode(display: Display, keysym: KeySym): KeyCode

extern "X11" fn XWarpPointer(display: Display, src_w: Window, dest_w: Window, src_x: i32, src_y: i32, src_width: u32, src_height: u32, dest_x: i32, dest_y: i32): i32
extern "X11" fn XGrabPointer(display: Display, window: Window, owner_events: Bool, event_mask: u32, pointer_mode: i32, keyboard_mode: i32, confine_to: Window, cursor: Cursor, time: Time): i32
extern "X11" fn XUngrabPointer(display: Display, time: Time): i32

extern "X11" fn XGetWindowAttributes(display: Display, window: Window, attributes: *XWindowAttributes): Status

// Common keysyms
const XK_Escape: KeySym = 0xFF1B
const XK_Return: KeySym = 0xFF0D
const XK_space: KeySym = 0x0020
const XK_Left: KeySym = 0xFF51
const XK_Up: KeySym = 0xFF52
const XK_Right: KeySym = 0xFF53
const XK_Down: KeySym = 0xFF54
const XK_Shift_L: KeySym = 0xFFE1
const XK_Shift_R: KeySym = 0xFFE2
const XK_Control_L: KeySym = 0xFFE3
const XK_Control_R: KeySym = 0xFFE4
const XK_Alt_L: KeySym = 0xFFE9
const XK_Alt_R: KeySym = 0xFFEA
const XK_F1: KeySym = 0xFFBE
const XK_F2: KeySym = 0xFFBF
const XK_F3: KeySym = 0xFFC0
const XK_F4: KeySym = 0xFFC1
const XK_F5: KeySym = 0xFFC2
const XK_F6: KeySym = 0xFFC3
const XK_F7: KeySym = 0xFFC4
const XK_F8: KeySym = 0xFFC5
const XK_F9: KeySym = 0xFFC6
const XK_F10: KeySym = 0xFFC7
const XK_F11: KeySym = 0xFFC8
const XK_F12: KeySym = 0xFFC9

// Linux window state
struct LinuxWindow {
    display: Display
    window: Window
    screen: i32
    width: u32
    height: u32
    is_running: bool
    is_fullscreen: bool
    is_focused: bool
    title: string

    // Atoms for window close
    wm_delete_window: Atom
    wm_protocols: Atom

    // Input state
    mouse_x: i32
    mouse_y: i32
    mouse_buttons: u32
    key_states: [256]bool

    fn init(title: string, width: u32, height: u32): ?LinuxWindow {
        // Open display
        let display = XOpenDisplay(null)
        if display == null {
            return null
        }

        let screen = XDefaultScreen(display)
        let root = XDefaultRootWindow(display)
        let visual = XDefaultVisual(display, screen)
        let colormap = XDefaultColormap(display, screen)
        let depth = XDefaultDepth(display, screen)

        // Set up window attributes
        var attributes = XSetWindowAttributes {
            background_pixmap: None
            background_pixel: XBlackPixel(display, screen)
            border_pixmap: None
            border_pixel: 0
            bit_gravity: 0
            win_gravity: 0
            backing_store: 0
            backing_planes: 0
            backing_pixel: 0
            save_under: False
            event_mask: KeyPressMask | KeyReleaseMask | ButtonPressMask | ButtonReleaseMask |
                        PointerMotionMask | ExposureMask | StructureNotifyMask | FocusChangeMask
            do_not_propagate_mask: 0
            override_redirect: False
            colormap: colormap
            cursor: None
        }

        let valuemask = CWBackPixel | CWBorderPixel | CWEventMask | CWColormap

        // Create window
        let window = XCreateWindow(
            display,
            root,
            0, 0,
            width, height,
            0,
            depth,
            InputOutput,
            visual,
            valuemask,
            &attributes
        )

        if window == None {
            XCloseDisplay(display)
            return null
        }

        // Set window title
        XStoreName(display, window, title.ptr)

        // Set up window close handling
        let wm_delete_window = XInternAtom(display, "WM_DELETE_WINDOW", False)
        let wm_protocols = XInternAtom(display, "WM_PROTOCOLS", False)
        var protocols = [wm_delete_window]
        XSetWMProtocols(display, window, &protocols[0], 1)

        // Map (show) window
        XMapWindow(display, window)
        XFlush(display)

        return LinuxWindow {
            display: display
            window: window
            screen: screen
            width: width
            height: height
            is_running: true
            is_fullscreen: false
            is_focused: true
            title: title
            wm_delete_window: wm_delete_window
            wm_protocols: wm_protocols
            mouse_x: 0
            mouse_y: 0
            mouse_buttons: 0
            key_states: [false; 256]
        }
    }

    fn poll_events(self): bool {
        while XPending(self.display) > 0 {
            var event: XEvent = undefined
            XNextEvent(self.display, &event)

            match event.type {
                ClientMessage => {
                    let client_event = @ptrCast(*XClientMessageEvent, &event)
                    if client_event.data[0] == @intCast(i64, self.wm_delete_window) {
                        self.is_running = false
                        return false
                    }
                }
                KeyPress => {
                    let key_event = @ptrCast(*XKeyEvent, &event)
                    let keysym = XLookupKeysym(key_event, 0)
                    let keycode = self.keysym_to_keycode(keysym)
                    if keycode < 256 {
                        self.key_states[@intCast(usize, keycode)] = true
                    }
                }
                KeyRelease => {
                    let key_event = @ptrCast(*XKeyEvent, &event)
                    let keysym = XLookupKeysym(key_event, 0)
                    let keycode = self.keysym_to_keycode(keysym)
                    if keycode < 256 {
                        self.key_states[@intCast(usize, keycode)] = false
                    }
                }
                ButtonPress => {
                    let button_event = @ptrCast(*XButtonEvent, &event)
                    match button_event.button {
                        Button1 => { self.mouse_buttons |= 1 }
                        Button2 => { self.mouse_buttons |= 4 }
                        Button3 => { self.mouse_buttons |= 2 }
                        _ => {}
                    }
                }
                ButtonRelease => {
                    let button_event = @ptrCast(*XButtonEvent, &event)
                    match button_event.button {
                        Button1 => { self.mouse_buttons &= ~1 }
                        Button2 => { self.mouse_buttons &= ~4 }
                        Button3 => { self.mouse_buttons &= ~2 }
                        _ => {}
                    }
                }
                MotionNotify => {
                    let motion_event = @ptrCast(*XMotionEvent, &event)
                    self.mouse_x = motion_event.x
                    self.mouse_y = motion_event.y
                }
                ConfigureNotify => {
                    let config_event = @ptrCast(*XConfigureEvent, &event)
                    self.width = @intCast(u32, config_event.width)
                    self.height = @intCast(u32, config_event.height)
                }
                FocusIn => {
                    self.is_focused = true
                }
                FocusOut => {
                    self.is_focused = false
                }
                _ => {}
            }
        }

        return self.is_running
    }

    fn keysym_to_keycode(&self, keysym: KeySym): u32 {
        // Convert X11 keysym to our keycode
        match keysym {
            XK_Escape => { return 0x1B }
            XK_Return => { return 0x0D }
            XK_space => { return 0x20 }
            XK_Left => { return 0x25 }
            XK_Up => { return 0x26 }
            XK_Right => { return 0x27 }
            XK_Down => { return 0x28 }
            XK_Shift_L, XK_Shift_R => { return 0x10 }
            XK_Control_L, XK_Control_R => { return 0x11 }
            XK_Alt_L, XK_Alt_R => { return 0x12 }
            XK_F1 => { return 0x70 }
            XK_F2 => { return 0x71 }
            XK_F3 => { return 0x72 }
            XK_F4 => { return 0x73 }
            XK_F5 => { return 0x74 }
            XK_F6 => { return 0x75 }
            XK_F7 => { return 0x76 }
            XK_F8 => { return 0x77 }
            XK_F9 => { return 0x78 }
            XK_F10 => { return 0x79 }
            XK_F11 => { return 0x7A }
            XK_F12 => { return 0x7B }
            _ => {
                // ASCII characters
                if keysym >= 0x20 and keysym <= 0x7E {
                    return @intCast(u32, keysym)
                }
                return 0
            }
        }
    }

    fn set_title(self, title: string) {
        XStoreName(self.display, self.window, title.ptr)
        self.title = title
    }

    fn get_size(self): (u32, u32) {
        return (self.width, self.height)
    }

    fn is_key_pressed(self, key: i32): bool {
        if key >= 0 and key < 256 {
            return self.key_states[@intCast(usize, key)]
        }
        return false
    }

    fn get_mouse_position(self): (i32, i32) {
        return (self.mouse_x, self.mouse_y)
    }

    fn is_mouse_button_pressed(self, button: u32): bool {
        return (self.mouse_buttons & (1 << button)) != 0
    }

    fn capture_mouse(self, capture: bool) {
        if capture {
            XGrabPointer(self.display, self.window, True,
                        ButtonPressMask | ButtonReleaseMask | PointerMotionMask,
                        1, 1, self.window, None, 0)
        } else {
            XUngrabPointer(self.display, 0)
        }
    }

    fn close(self) {
        self.is_running = false
        XDestroyWindow(self.display, self.window)
        XCloseDisplay(self.display)
    }
}

// Export functions
export fn create_window(title: string, width: u32, height: u32): ?*LinuxWindow {
    let window = LinuxWindow::init(title, width, height)
    if window {
        let ptr = @alloc(LinuxWindow, 1)
        ptr.* = window.?
        return ptr
    }
    return null
}

export fn destroy_window(window: *LinuxWindow) {
    window.close()
}
