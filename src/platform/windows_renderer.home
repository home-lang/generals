// Windows Platform Layer - Renderer (OpenGL/Direct3D)
// C&C Generals Zero Hour - Home Port
// Supports OpenGL 4.x and Direct3D 11 for Windows

// OpenGL types
type GLuint = u32
type GLint = i32
type GLenum = u32
type GLsizei = i32
type GLfloat = f32
type GLboolean = u8
type GLchar = u8
type GLbitfield = u32
type GLclampf = f32

// OpenGL constants
const GL_COLOR_BUFFER_BIT: GLbitfield = 0x00004000
const GL_DEPTH_BUFFER_BIT: GLbitfield = 0x00000100
const GL_STENCIL_BUFFER_BIT: GLbitfield = 0x00000400

const GL_TRIANGLES: GLenum = 0x0004
const GL_TRIANGLE_STRIP: GLenum = 0x0005
const GL_LINES: GLenum = 0x0001
const GL_POINTS: GLenum = 0x0000

const GL_TEXTURE_2D: GLenum = 0x0DE1
const GL_TEXTURE_MIN_FILTER: GLenum = 0x2801
const GL_TEXTURE_MAG_FILTER: GLenum = 0x2800
const GL_LINEAR: GLint = 0x2601
const GL_NEAREST: GLint = 0x2600
const GL_LINEAR_MIPMAP_LINEAR: GLint = 0x2703

const GL_RGBA: GLenum = 0x1908
const GL_RGB: GLenum = 0x1907
const GL_UNSIGNED_BYTE: GLenum = 0x1401
const GL_FLOAT: GLenum = 0x1406

const GL_ARRAY_BUFFER: GLenum = 0x8892
const GL_ELEMENT_ARRAY_BUFFER: GLenum = 0x8893
const GL_STATIC_DRAW: GLenum = 0x88E4
const GL_DYNAMIC_DRAW: GLenum = 0x88E8

const GL_VERTEX_SHADER: GLenum = 0x8B31
const GL_FRAGMENT_SHADER: GLenum = 0x8B30
const GL_COMPILE_STATUS: GLenum = 0x8B81
const GL_LINK_STATUS: GLenum = 0x8B82

const GL_DEPTH_TEST: GLenum = 0x0B71
const GL_BLEND: GLenum = 0x0BE2
const GL_CULL_FACE: GLenum = 0x0B44

const GL_SRC_ALPHA: GLenum = 0x0302
const GL_ONE_MINUS_SRC_ALPHA: GLenum = 0x0303

const GL_FRAMEBUFFER: GLenum = 0x8D40
const GL_COLOR_ATTACHMENT0: GLenum = 0x8CE0
const GL_DEPTH_ATTACHMENT: GLenum = 0x8D00
const GL_FRAMEBUFFER_COMPLETE: GLenum = 0x8CD5

// WGL types
type HGLRC = *void
type HDC = *void
type HWND = *void

// OpenGL function pointers (loaded at runtime)
var glClear: fn(GLbitfield) = null
var glClearColor: fn(GLclampf, GLclampf, GLclampf, GLclampf) = null
var glViewport: fn(GLint, GLint, GLsizei, GLsizei) = null
var glEnable: fn(GLenum) = null
var glDisable: fn(GLenum) = null
var glBlendFunc: fn(GLenum, GLenum) = null
var glDepthFunc: fn(GLenum) = null

var glGenBuffers: fn(GLsizei, *GLuint) = null
var glBindBuffer: fn(GLenum, GLuint) = null
var glBufferData: fn(GLenum, isize, *const void, GLenum) = null
var glDeleteBuffers: fn(GLsizei, *const GLuint) = null

var glGenVertexArrays: fn(GLsizei, *GLuint) = null
var glBindVertexArray: fn(GLuint) = null
var glDeleteVertexArrays: fn(GLsizei, *const GLuint) = null
var glEnableVertexAttribArray: fn(GLuint) = null
var glDisableVertexAttribArray: fn(GLuint) = null
var glVertexAttribPointer: fn(GLuint, GLint, GLenum, GLboolean, GLsizei, *const void) = null

var glGenTextures: fn(GLsizei, *GLuint) = null
var glBindTexture: fn(GLenum, GLuint) = null
var glTexImage2D: fn(GLenum, GLint, GLint, GLsizei, GLsizei, GLint, GLenum, GLenum, *const void) = null
var glTexParameteri: fn(GLenum, GLenum, GLint) = null
var glDeleteTextures: fn(GLsizei, *const GLuint) = null
var glGenerateMipmap: fn(GLenum) = null
var glActiveTexture: fn(GLenum) = null

var glCreateShader: fn(GLenum): GLuint = null
var glShaderSource: fn(GLuint, GLsizei, **const GLchar, *const GLint) = null
var glCompileShader: fn(GLuint) = null
var glGetShaderiv: fn(GLuint, GLenum, *GLint) = null
var glGetShaderInfoLog: fn(GLuint, GLsizei, *GLsizei, *GLchar) = null
var glDeleteShader: fn(GLuint) = null

var glCreateProgram: fn(): GLuint = null
var glAttachShader: fn(GLuint, GLuint) = null
var glLinkProgram: fn(GLuint) = null
var glUseProgram: fn(GLuint) = null
var glGetProgramiv: fn(GLuint, GLenum, *GLint) = null
var glGetProgramInfoLog: fn(GLuint, GLsizei, *GLsizei, *GLchar) = null
var glDeleteProgram: fn(GLuint) = null
var glGetUniformLocation: fn(GLuint, *const GLchar): GLint = null
var glUniform1i: fn(GLint, GLint) = null
var glUniform1f: fn(GLint, GLfloat) = null
var glUniform2f: fn(GLint, GLfloat, GLfloat) = null
var glUniform3f: fn(GLint, GLfloat, GLfloat, GLfloat) = null
var glUniform4f: fn(GLint, GLfloat, GLfloat, GLfloat, GLfloat) = null
var glUniformMatrix4fv: fn(GLint, GLsizei, GLboolean, *const GLfloat) = null

var glDrawArrays: fn(GLenum, GLint, GLsizei) = null
var glDrawElements: fn(GLenum, GLsizei, GLenum, *const void) = null

var glGenFramebuffers: fn(GLsizei, *GLuint) = null
var glBindFramebuffer: fn(GLenum, GLuint) = null
var glFramebufferTexture2D: fn(GLenum, GLenum, GLenum, GLuint, GLint) = null
var glCheckFramebufferStatus: fn(GLenum): GLenum = null
var glDeleteFramebuffers: fn(GLsizei, *const GLuint) = null

// WGL functions
extern "opengl32" fn wglCreateContext(hdc: HDC): HGLRC
extern "opengl32" fn wglMakeCurrent(hdc: HDC, hglrc: HGLRC): i32
extern "opengl32" fn wglDeleteContext(hglrc: HGLRC): i32
extern "opengl32" fn wglGetProcAddress(lpszProc: *const u8): *void
extern "gdi32" fn SwapBuffers(hdc: HDC): i32

// Pixel format for OpenGL
struct PIXELFORMATDESCRIPTOR {
    nSize: u16
    nVersion: u16
    dwFlags: u32
    iPixelType: u8
    cColorBits: u8
    cRedBits: u8
    cRedShift: u8
    cGreenBits: u8
    cGreenShift: u8
    cBlueBits: u8
    cBlueShift: u8
    cAlphaBits: u8
    cAlphaShift: u8
    cAccumBits: u8
    cAccumRedBits: u8
    cAccumGreenBits: u8
    cAccumBlueBits: u8
    cAccumAlphaBits: u8
    cDepthBits: u8
    cStencilBits: u8
    cAuxBuffers: u8
    iLayerType: u8
    bReserved: u8
    dwLayerMask: u32
    dwVisibleMask: u32
    dwDamageMask: u32
}

const PFD_DRAW_TO_WINDOW: u32 = 0x00000004
const PFD_SUPPORT_OPENGL: u32 = 0x00000020
const PFD_DOUBLEBUFFER: u32 = 0x00000001
const PFD_TYPE_RGBA: u8 = 0

extern "gdi32" fn ChoosePixelFormat(hdc: HDC, ppfd: *const PIXELFORMATDESCRIPTOR): i32
extern "gdi32" fn SetPixelFormat(hdc: HDC, format: i32, ppfd: *const PIXELFORMATDESCRIPTOR): i32
extern "gdi32" fn DescribePixelFormat(hdc: HDC, format: i32, nBytes: u32, ppfd: *PIXELFORMATDESCRIPTOR): i32

// Windows OpenGL Renderer
struct WindowsRenderer {
    hdc: HDC
    hglrc: HGLRC
    width: u32
    height: u32
    is_initialized: bool

    // Default shader
    default_shader: GLuint
    view_matrix_location: GLint
    projection_matrix_location: GLint
    model_matrix_location: GLint

    fn init(hdc: HDC, width: u32, height: u32): ?WindowsRenderer {
        // Set up pixel format
        let pfd = PIXELFORMATDESCRIPTOR {
            nSize: @sizeOf(PIXELFORMATDESCRIPTOR)
            nVersion: 1
            dwFlags: PFD_DRAW_TO_WINDOW | PFD_SUPPORT_OPENGL | PFD_DOUBLEBUFFER
            iPixelType: PFD_TYPE_RGBA
            cColorBits: 32
            cRedBits: 0
            cRedShift: 0
            cGreenBits: 0
            cGreenShift: 0
            cBlueBits: 0
            cBlueShift: 0
            cAlphaBits: 8
            cAlphaShift: 0
            cAccumBits: 0
            cAccumRedBits: 0
            cAccumGreenBits: 0
            cAccumBlueBits: 0
            cAccumAlphaBits: 0
            cDepthBits: 24
            cStencilBits: 8
            cAuxBuffers: 0
            iLayerType: 0
            bReserved: 0
            dwLayerMask: 0
            dwVisibleMask: 0
            dwDamageMask: 0
        }

        let format = ChoosePixelFormat(hdc, &pfd)
        if format == 0 {
            return null
        }

        if SetPixelFormat(hdc, format, &pfd) == 0 {
            return null
        }

        // Create OpenGL context
        let hglrc = wglCreateContext(hdc)
        if hglrc == null {
            return null
        }

        if wglMakeCurrent(hdc, hglrc) == 0 {
            wglDeleteContext(hglrc)
            return null
        }

        // Load OpenGL functions
        load_gl_functions()

        // Set up default state
        glEnable(GL_DEPTH_TEST)
        glEnable(GL_BLEND)
        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA)
        glViewport(0, 0, @intCast(GLsizei, width), @intCast(GLsizei, height))

        return WindowsRenderer {
            hdc: hdc
            hglrc: hglrc
            width: width
            height: height
            is_initialized: true
            default_shader: 0
            view_matrix_location: -1
            projection_matrix_location: -1
            model_matrix_location: -1
        }
    }

    fn begin_frame(self) {
        glClearColor(0.0, 0.0, 0.0, 1.0)
        glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)
    }

    fn end_frame(self) {
        SwapBuffers(self.hdc)
    }

    fn resize(self, width: u32, height: u32) {
        self.width = width
        self.height = height
        glViewport(0, 0, @intCast(GLsizei, width), @intCast(GLsizei, height))
    }

    fn create_shader(self, vertex_source: string, fragment_source: string): GLuint {
        // Create vertex shader
        let vertex_shader = glCreateShader(GL_VERTEX_SHADER)
        let vertex_src_ptr = vertex_source.ptr
        let vertex_src_len = @intCast(GLint, vertex_source.len)
        glShaderSource(vertex_shader, 1, &vertex_src_ptr, &vertex_src_len)
        glCompileShader(vertex_shader)

        var success: GLint = 0
        glGetShaderiv(vertex_shader, GL_COMPILE_STATUS, &success)
        if success == 0 {
            glDeleteShader(vertex_shader)
            return 0
        }

        // Create fragment shader
        let fragment_shader = glCreateShader(GL_FRAGMENT_SHADER)
        let fragment_src_ptr = fragment_source.ptr
        let fragment_src_len = @intCast(GLint, fragment_source.len)
        glShaderSource(fragment_shader, 1, &fragment_src_ptr, &fragment_src_len)
        glCompileShader(fragment_shader)

        glGetShaderiv(fragment_shader, GL_COMPILE_STATUS, &success)
        if success == 0 {
            glDeleteShader(vertex_shader)
            glDeleteShader(fragment_shader)
            return 0
        }

        // Link program
        let program = glCreateProgram()
        glAttachShader(program, vertex_shader)
        glAttachShader(program, fragment_shader)
        glLinkProgram(program)

        glGetProgramiv(program, GL_LINK_STATUS, &success)
        if success == 0 {
            glDeleteProgram(program)
            glDeleteShader(vertex_shader)
            glDeleteShader(fragment_shader)
            return 0
        }

        // Clean up shaders (linked into program)
        glDeleteShader(vertex_shader)
        glDeleteShader(fragment_shader)

        return program
    }

    fn create_texture(self, width: u32, height: u32, data: []u8): GLuint {
        var texture: GLuint = 0
        glGenTextures(1, &texture)
        glBindTexture(GL_TEXTURE_2D, texture)

        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR)
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR)

        glTexImage2D(
            GL_TEXTURE_2D,
            0,
            @intCast(GLint, GL_RGBA),
            @intCast(GLsizei, width),
            @intCast(GLsizei, height),
            0,
            GL_RGBA,
            GL_UNSIGNED_BYTE,
            data.ptr
        )

        glGenerateMipmap(GL_TEXTURE_2D)

        return texture
    }

    fn create_vertex_buffer(self, vertices: []f32): GLuint {
        var vbo: GLuint = 0
        glGenBuffers(1, &vbo)
        glBindBuffer(GL_ARRAY_BUFFER, vbo)
        glBufferData(GL_ARRAY_BUFFER, @intCast(isize, vertices.len * @sizeOf(f32)), vertices.ptr, GL_STATIC_DRAW)
        return vbo
    }

    fn create_index_buffer(self, indices: []u32): GLuint {
        var ebo: GLuint = 0
        glGenBuffers(1, &ebo)
        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, ebo)
        glBufferData(GL_ELEMENT_ARRAY_BUFFER, @intCast(isize, indices.len * @sizeOf(u32)), indices.ptr, GL_STATIC_DRAW)
        return ebo
    }

    fn draw_elements(self, vao: GLuint, count: u32, shader: GLuint) {
        glUseProgram(shader)
        glBindVertexArray(vao)
        glDrawElements(GL_TRIANGLES, @intCast(GLsizei, count), GL_UNSIGNED_INT, null)
    }

    fn shutdown(self) {
        if self.hglrc {
            wglMakeCurrent(null, null)
            wglDeleteContext(self.hglrc)
        }
        self.is_initialized = false
    }
}

fn load_gl_functions() {
    // Load core OpenGL functions via wglGetProcAddress
    glClear = @ptrCast(fn(GLbitfield), wglGetProcAddress("glClear"))
    glClearColor = @ptrCast(fn(GLclampf, GLclampf, GLclampf, GLclampf), wglGetProcAddress("glClearColor"))
    glViewport = @ptrCast(fn(GLint, GLint, GLsizei, GLsizei), wglGetProcAddress("glViewport"))
    glEnable = @ptrCast(fn(GLenum), wglGetProcAddress("glEnable"))
    glDisable = @ptrCast(fn(GLenum), wglGetProcAddress("glDisable"))
    glBlendFunc = @ptrCast(fn(GLenum, GLenum), wglGetProcAddress("glBlendFunc"))

    // Load extension functions
    glGenBuffers = @ptrCast(fn(GLsizei, *GLuint), wglGetProcAddress("glGenBuffers"))
    glBindBuffer = @ptrCast(fn(GLenum, GLuint), wglGetProcAddress("glBindBuffer"))
    glBufferData = @ptrCast(fn(GLenum, isize, *const void, GLenum), wglGetProcAddress("glBufferData"))
    glDeleteBuffers = @ptrCast(fn(GLsizei, *const GLuint), wglGetProcAddress("glDeleteBuffers"))

    glGenVertexArrays = @ptrCast(fn(GLsizei, *GLuint), wglGetProcAddress("glGenVertexArrays"))
    glBindVertexArray = @ptrCast(fn(GLuint), wglGetProcAddress("glBindVertexArray"))
    glDeleteVertexArrays = @ptrCast(fn(GLsizei, *const GLuint), wglGetProcAddress("glDeleteVertexArrays"))
    glEnableVertexAttribArray = @ptrCast(fn(GLuint), wglGetProcAddress("glEnableVertexAttribArray"))
    glVertexAttribPointer = @ptrCast(fn(GLuint, GLint, GLenum, GLboolean, GLsizei, *const void), wglGetProcAddress("glVertexAttribPointer"))

    glGenTextures = @ptrCast(fn(GLsizei, *GLuint), wglGetProcAddress("glGenTextures"))
    glBindTexture = @ptrCast(fn(GLenum, GLuint), wglGetProcAddress("glBindTexture"))
    glTexImage2D = @ptrCast(fn(GLenum, GLint, GLint, GLsizei, GLsizei, GLint, GLenum, GLenum, *const void), wglGetProcAddress("glTexImage2D"))
    glTexParameteri = @ptrCast(fn(GLenum, GLenum, GLint), wglGetProcAddress("glTexParameteri"))
    glDeleteTextures = @ptrCast(fn(GLsizei, *const GLuint), wglGetProcAddress("glDeleteTextures"))
    glGenerateMipmap = @ptrCast(fn(GLenum), wglGetProcAddress("glGenerateMipmap"))
    glActiveTexture = @ptrCast(fn(GLenum), wglGetProcAddress("glActiveTexture"))

    glCreateShader = @ptrCast(fn(GLenum): GLuint, wglGetProcAddress("glCreateShader"))
    glShaderSource = @ptrCast(fn(GLuint, GLsizei, **const GLchar, *const GLint), wglGetProcAddress("glShaderSource"))
    glCompileShader = @ptrCast(fn(GLuint), wglGetProcAddress("glCompileShader"))
    glGetShaderiv = @ptrCast(fn(GLuint, GLenum, *GLint), wglGetProcAddress("glGetShaderiv"))
    glDeleteShader = @ptrCast(fn(GLuint), wglGetProcAddress("glDeleteShader"))

    glCreateProgram = @ptrCast(fn(): GLuint, wglGetProcAddress("glCreateProgram"))
    glAttachShader = @ptrCast(fn(GLuint, GLuint), wglGetProcAddress("glAttachShader"))
    glLinkProgram = @ptrCast(fn(GLuint), wglGetProcAddress("glLinkProgram"))
    glUseProgram = @ptrCast(fn(GLuint), wglGetProcAddress("glUseProgram"))
    glGetProgramiv = @ptrCast(fn(GLuint, GLenum, *GLint), wglGetProcAddress("glGetProgramiv"))
    glDeleteProgram = @ptrCast(fn(GLuint), wglGetProcAddress("glDeleteProgram"))
    glGetUniformLocation = @ptrCast(fn(GLuint, *const GLchar): GLint, wglGetProcAddress("glGetUniformLocation"))
    glUniform1i = @ptrCast(fn(GLint, GLint), wglGetProcAddress("glUniform1i"))
    glUniform1f = @ptrCast(fn(GLint, GLfloat), wglGetProcAddress("glUniform1f"))
    glUniform4f = @ptrCast(fn(GLint, GLfloat, GLfloat, GLfloat, GLfloat), wglGetProcAddress("glUniform4f"))
    glUniformMatrix4fv = @ptrCast(fn(GLint, GLsizei, GLboolean, *const GLfloat), wglGetProcAddress("glUniformMatrix4fv"))

    glDrawArrays = @ptrCast(fn(GLenum, GLint, GLsizei), wglGetProcAddress("glDrawArrays"))
    glDrawElements = @ptrCast(fn(GLenum, GLsizei, GLenum, *const void), wglGetProcAddress("glDrawElements"))

    glGenFramebuffers = @ptrCast(fn(GLsizei, *GLuint), wglGetProcAddress("glGenFramebuffers"))
    glBindFramebuffer = @ptrCast(fn(GLenum, GLuint), wglGetProcAddress("glBindFramebuffer"))
    glFramebufferTexture2D = @ptrCast(fn(GLenum, GLenum, GLenum, GLuint, GLint), wglGetProcAddress("glFramebufferTexture2D"))
    glCheckFramebufferStatus = @ptrCast(fn(GLenum): GLenum, wglGetProcAddress("glCheckFramebufferStatus"))
    glDeleteFramebuffers = @ptrCast(fn(GLsizei, *const GLuint), wglGetProcAddress("glDeleteFramebuffers"))
}

// Export functions
export fn create_renderer(hdc: HDC, width: u32, height: u32): ?*WindowsRenderer {
    let renderer = WindowsRenderer::init(hdc, width, height)
    if renderer {
        let ptr = @alloc(WindowsRenderer, 1)
        ptr.* = renderer.?
        return ptr
    }
    return null
}

export fn destroy_renderer(renderer: *WindowsRenderer) {
    renderer.shutdown()
}
