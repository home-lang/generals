// Vulkan Renderer Backend
// C&C Generals Zero Hour - Home Port
// Cross-platform Vulkan 1.2 renderer

// Vulkan types
type VkInstance = *void
type VkPhysicalDevice = *void
type VkDevice = *void
type VkQueue = *void
type VkSurfaceKHR = u64
type VkSwapchainKHR = u64
type VkImage = u64
type VkImageView = u64
type VkFramebuffer = u64
type VkRenderPass = u64
type VkPipeline = u64
type VkPipelineLayout = u64
type VkShaderModule = u64
type VkCommandPool = u64
type VkCommandBuffer = *void
type VkSemaphore = u64
type VkFence = u64
type VkBuffer = u64
type VkDeviceMemory = u64
type VkDescriptorSetLayout = u64
type VkDescriptorPool = u64
type VkDescriptorSet = u64
type VkSampler = u64

type VkResult = i32
type VkFormat = i32
type VkColorSpaceKHR = i32
type VkPresentModeKHR = i32
type VkBool32 = u32
type VkFlags = u32
type VkDeviceSize = u64

// Vulkan result codes
const VK_SUCCESS: VkResult = 0
const VK_NOT_READY: VkResult = 1
const VK_TIMEOUT: VkResult = 2
const VK_INCOMPLETE: VkResult = 5
const VK_ERROR_OUT_OF_HOST_MEMORY: VkResult = -1
const VK_ERROR_OUT_OF_DEVICE_MEMORY: VkResult = -2
const VK_ERROR_INITIALIZATION_FAILED: VkResult = -3
const VK_ERROR_DEVICE_LOST: VkResult = -4
const VK_ERROR_SURFACE_LOST_KHR: VkResult = -1000000000

// Vulkan formats
const VK_FORMAT_UNDEFINED: VkFormat = 0
const VK_FORMAT_R8G8B8A8_UNORM: VkFormat = 37
const VK_FORMAT_R8G8B8A8_SRGB: VkFormat = 43
const VK_FORMAT_B8G8R8A8_UNORM: VkFormat = 44
const VK_FORMAT_B8G8R8A8_SRGB: VkFormat = 50
const VK_FORMAT_D32_SFLOAT: VkFormat = 126
const VK_FORMAT_D24_UNORM_S8_UINT: VkFormat = 129
const VK_FORMAT_D32_SFLOAT_S8_UINT: VkFormat = 130

// Color space
const VK_COLOR_SPACE_SRGB_NONLINEAR_KHR: VkColorSpaceKHR = 0

// Present modes
const VK_PRESENT_MODE_IMMEDIATE_KHR: VkPresentModeKHR = 0
const VK_PRESENT_MODE_MAILBOX_KHR: VkPresentModeKHR = 1
const VK_PRESENT_MODE_FIFO_KHR: VkPresentModeKHR = 2
const VK_PRESENT_MODE_FIFO_RELAXED_KHR: VkPresentModeKHR = 3

// Buffer usage flags
const VK_BUFFER_USAGE_TRANSFER_SRC_BIT: VkFlags = 0x00000001
const VK_BUFFER_USAGE_TRANSFER_DST_BIT: VkFlags = 0x00000002
const VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT: VkFlags = 0x00000010
const VK_BUFFER_USAGE_STORAGE_BUFFER_BIT: VkFlags = 0x00000020
const VK_BUFFER_USAGE_INDEX_BUFFER_BIT: VkFlags = 0x00000040
const VK_BUFFER_USAGE_VERTEX_BUFFER_BIT: VkFlags = 0x00000080

// Memory property flags
const VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT: VkFlags = 0x00000001
const VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT: VkFlags = 0x00000002
const VK_MEMORY_PROPERTY_HOST_COHERENT_BIT: VkFlags = 0x00000004

// Image usage flags
const VK_IMAGE_USAGE_TRANSFER_SRC_BIT: VkFlags = 0x00000001
const VK_IMAGE_USAGE_TRANSFER_DST_BIT: VkFlags = 0x00000002
const VK_IMAGE_USAGE_SAMPLED_BIT: VkFlags = 0x00000004
const VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT: VkFlags = 0x00000010
const VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT: VkFlags = 0x00000020

// Shader stage flags
const VK_SHADER_STAGE_VERTEX_BIT: VkFlags = 0x00000001
const VK_SHADER_STAGE_FRAGMENT_BIT: VkFlags = 0x00000010
const VK_SHADER_STAGE_COMPUTE_BIT: VkFlags = 0x00000020

// Pipeline stage flags
const VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT: VkFlags = 0x00000001
const VK_PIPELINE_STAGE_VERTEX_SHADER_BIT: VkFlags = 0x00000008
const VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT: VkFlags = 0x00000080
const VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT: VkFlags = 0x00000400
const VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT: VkFlags = 0x00002000

// Command buffer level
const VK_COMMAND_BUFFER_LEVEL_PRIMARY: i32 = 0
const VK_COMMAND_BUFFER_LEVEL_SECONDARY: i32 = 1

// Vulkan structures
struct VkApplicationInfo {
    sType: i32
    pNext: *const void
    pApplicationName: *const u8
    applicationVersion: u32
    pEngineName: *const u8
    engineVersion: u32
    apiVersion: u32
}

struct VkInstanceCreateInfo {
    sType: i32
    pNext: *const void
    flags: VkFlags
    pApplicationInfo: *const VkApplicationInfo
    enabledLayerCount: u32
    ppEnabledLayerNames: **const u8
    enabledExtensionCount: u32
    ppEnabledExtensionNames: **const u8
}

struct VkDeviceQueueCreateInfo {
    sType: i32
    pNext: *const void
    flags: VkFlags
    queueFamilyIndex: u32
    queueCount: u32
    pQueuePriorities: *const f32
}

struct VkDeviceCreateInfo {
    sType: i32
    pNext: *const void
    flags: VkFlags
    queueCreateInfoCount: u32
    pQueueCreateInfos: *const VkDeviceQueueCreateInfo
    enabledLayerCount: u32
    ppEnabledLayerNames: **const u8
    enabledExtensionCount: u32
    ppEnabledExtensionNames: **const u8
    pEnabledFeatures: *const void
}

struct VkExtent2D {
    width: u32
    height: u32
}

struct VkExtent3D {
    width: u32
    height: u32
    depth: u32
}

struct VkViewport {
    x: f32
    y: f32
    width: f32
    height: f32
    minDepth: f32
    maxDepth: f32
}

struct VkRect2D {
    offset_x: i32
    offset_y: i32
    extent: VkExtent2D
}

struct VkClearValue {
    color: [4]f32
}

struct VkSubmitInfo {
    sType: i32
    pNext: *const void
    waitSemaphoreCount: u32
    pWaitSemaphores: *const VkSemaphore
    pWaitDstStageMask: *const VkFlags
    commandBufferCount: u32
    pCommandBuffers: *const VkCommandBuffer
    signalSemaphoreCount: u32
    pSignalSemaphores: *const VkSemaphore
}

struct VkPresentInfoKHR {
    sType: i32
    pNext: *const void
    waitSemaphoreCount: u32
    pWaitSemaphores: *const VkSemaphore
    swapchainCount: u32
    pSwapchains: *const VkSwapchainKHR
    pImageIndices: *const u32
    pResults: *VkResult
}

// Structure types
const VK_STRUCTURE_TYPE_APPLICATION_INFO: i32 = 0
const VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO: i32 = 1
const VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO: i32 = 2
const VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO: i32 = 3
const VK_STRUCTURE_TYPE_SUBMIT_INFO: i32 = 4
const VK_STRUCTURE_TYPE_PRESENT_INFO_KHR: i32 = 1000001001

// Vulkan API version
const VK_API_VERSION_1_2: u32 = 0x00402000  // Vulkan 1.2

// Vulkan functions (loaded at runtime)
var vkCreateInstance: fn(*const VkInstanceCreateInfo, *const void, *VkInstance): VkResult = null
var vkDestroyInstance: fn(VkInstance, *const void) = null
var vkEnumeratePhysicalDevices: fn(VkInstance, *u32, *VkPhysicalDevice): VkResult = null
var vkCreateDevice: fn(VkPhysicalDevice, *const VkDeviceCreateInfo, *const void, *VkDevice): VkResult = null
var vkDestroyDevice: fn(VkDevice, *const void) = null
var vkGetDeviceQueue: fn(VkDevice, u32, u32, *VkQueue) = null
var vkQueueSubmit: fn(VkQueue, u32, *const VkSubmitInfo, VkFence): VkResult = null
var vkQueuePresentKHR: fn(VkQueue, *const VkPresentInfoKHR): VkResult = null
var vkQueueWaitIdle: fn(VkQueue): VkResult = null
var vkDeviceWaitIdle: fn(VkDevice): VkResult = null

var vkCreateSwapchainKHR: fn(VkDevice, *const void, *const void, *VkSwapchainKHR): VkResult = null
var vkDestroySwapchainKHR: fn(VkDevice, VkSwapchainKHR, *const void) = null
var vkGetSwapchainImagesKHR: fn(VkDevice, VkSwapchainKHR, *u32, *VkImage): VkResult = null
var vkAcquireNextImageKHR: fn(VkDevice, VkSwapchainKHR, u64, VkSemaphore, VkFence, *u32): VkResult = null

var vkCreateImageView: fn(VkDevice, *const void, *const void, *VkImageView): VkResult = null
var vkDestroyImageView: fn(VkDevice, VkImageView, *const void) = null
var vkCreateFramebuffer: fn(VkDevice, *const void, *const void, *VkFramebuffer): VkResult = null
var vkDestroyFramebuffer: fn(VkDevice, VkFramebuffer, *const void) = null
var vkCreateRenderPass: fn(VkDevice, *const void, *const void, *VkRenderPass): VkResult = null
var vkDestroyRenderPass: fn(VkDevice, VkRenderPass, *const void) = null

var vkCreateShaderModule: fn(VkDevice, *const void, *const void, *VkShaderModule): VkResult = null
var vkDestroyShaderModule: fn(VkDevice, VkShaderModule, *const void) = null
var vkCreatePipelineLayout: fn(VkDevice, *const void, *const void, *VkPipelineLayout): VkResult = null
var vkDestroyPipelineLayout: fn(VkDevice, VkPipelineLayout, *const void) = null
var vkCreateGraphicsPipelines: fn(VkDevice, u64, u32, *const void, *const void, *VkPipeline): VkResult = null
var vkDestroyPipeline: fn(VkDevice, VkPipeline, *const void) = null

var vkCreateCommandPool: fn(VkDevice, *const void, *const void, *VkCommandPool): VkResult = null
var vkDestroyCommandPool: fn(VkDevice, VkCommandPool, *const void) = null
var vkAllocateCommandBuffers: fn(VkDevice, *const void, *VkCommandBuffer): VkResult = null
var vkFreeCommandBuffers: fn(VkDevice, VkCommandPool, u32, *const VkCommandBuffer) = null
var vkBeginCommandBuffer: fn(VkCommandBuffer, *const void): VkResult = null
var vkEndCommandBuffer: fn(VkCommandBuffer): VkResult = null
var vkResetCommandBuffer: fn(VkCommandBuffer, VkFlags): VkResult = null

var vkCmdBeginRenderPass: fn(VkCommandBuffer, *const void, i32) = null
var vkCmdEndRenderPass: fn(VkCommandBuffer) = null
var vkCmdBindPipeline: fn(VkCommandBuffer, i32, VkPipeline) = null
var vkCmdBindVertexBuffers: fn(VkCommandBuffer, u32, u32, *const VkBuffer, *const VkDeviceSize) = null
var vkCmdBindIndexBuffer: fn(VkCommandBuffer, VkBuffer, VkDeviceSize, i32) = null
var vkCmdBindDescriptorSets: fn(VkCommandBuffer, i32, VkPipelineLayout, u32, u32, *const VkDescriptorSet, u32, *const u32) = null
var vkCmdDraw: fn(VkCommandBuffer, u32, u32, u32, u32) = null
var vkCmdDrawIndexed: fn(VkCommandBuffer, u32, u32, u32, i32, u32) = null
var vkCmdSetViewport: fn(VkCommandBuffer, u32, u32, *const VkViewport) = null
var vkCmdSetScissor: fn(VkCommandBuffer, u32, u32, *const VkRect2D) = null
var vkCmdPushConstants: fn(VkCommandBuffer, VkPipelineLayout, VkFlags, u32, u32, *const void) = null

var vkCreateBuffer: fn(VkDevice, *const void, *const void, *VkBuffer): VkResult = null
var vkDestroyBuffer: fn(VkDevice, VkBuffer, *const void) = null
var vkAllocateMemory: fn(VkDevice, *const void, *const void, *VkDeviceMemory): VkResult = null
var vkFreeMemory: fn(VkDevice, VkDeviceMemory, *const void) = null
var vkBindBufferMemory: fn(VkDevice, VkBuffer, VkDeviceMemory, VkDeviceSize): VkResult = null
var vkMapMemory: fn(VkDevice, VkDeviceMemory, VkDeviceSize, VkDeviceSize, VkFlags, **void): VkResult = null
var vkUnmapMemory: fn(VkDevice, VkDeviceMemory) = null

var vkCreateSemaphore: fn(VkDevice, *const void, *const void, *VkSemaphore): VkResult = null
var vkDestroySemaphore: fn(VkDevice, VkSemaphore, *const void) = null
var vkCreateFence: fn(VkDevice, *const void, *const void, *VkFence): VkResult = null
var vkDestroyFence: fn(VkDevice, VkFence, *const void) = null
var vkWaitForFences: fn(VkDevice, u32, *const VkFence, VkBool32, u64): VkResult = null
var vkResetFences: fn(VkDevice, u32, *const VkFence): VkResult = null

// Maximum frames in flight
const MAX_FRAMES_IN_FLIGHT: u32 = 2

// Vulkan renderer state
struct VulkanRenderer {
    instance: VkInstance
    physical_device: VkPhysicalDevice
    device: VkDevice
    graphics_queue: VkQueue
    present_queue: VkQueue
    surface: VkSurfaceKHR

    swapchain: VkSwapchainKHR
    swapchain_images: [8]VkImage
    swapchain_image_views: [8]VkImageView
    swapchain_image_count: u32
    swapchain_format: VkFormat
    swapchain_extent: VkExtent2D

    render_pass: VkRenderPass
    framebuffers: [8]VkFramebuffer

    command_pool: VkCommandPool
    command_buffers: [2]VkCommandBuffer

    image_available_semaphores: [2]VkSemaphore
    render_finished_semaphores: [2]VkSemaphore
    in_flight_fences: [2]VkFence
    current_frame: u32

    width: u32
    height: u32
    is_initialized: bool
    vsync_enabled: bool

    fn init(width: u32, height: u32): ?VulkanRenderer {
        // Load Vulkan library
        if !load_vulkan_functions() {
            return null
        }

        // Create instance
        let app_info = VkApplicationInfo {
            sType: VK_STRUCTURE_TYPE_APPLICATION_INFO
            pNext: null
            pApplicationName: "C&C Generals Zero Hour"
            applicationVersion: 0x00010000  // 1.0.0
            pEngineName: "Home Engine"
            engineVersion: 0x00010000
            apiVersion: VK_API_VERSION_1_2
        }

        // Extensions needed for platform surface
        let extensions = [
            "VK_KHR_surface",
            // Platform-specific extension added at runtime
        ]

        let create_info = VkInstanceCreateInfo {
            sType: VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
            pNext: null
            flags: 0
            pApplicationInfo: &app_info
            enabledLayerCount: 0
            ppEnabledLayerNames: null
            enabledExtensionCount: @intCast(u32, extensions.len)
            ppEnabledExtensionNames: &extensions[0]
        }

        var instance: VkInstance = null
        if vkCreateInstance(&create_info, null, &instance) != VK_SUCCESS {
            return null
        }

        return VulkanRenderer {
            instance: instance
            physical_device: null
            device: null
            graphics_queue: null
            present_queue: null
            surface: 0
            swapchain: 0
            swapchain_images: [0; 8]
            swapchain_image_views: [0; 8]
            swapchain_image_count: 0
            swapchain_format: VK_FORMAT_B8G8R8A8_SRGB
            swapchain_extent: VkExtent2D { width: width, height: height }
            render_pass: 0
            framebuffers: [0; 8]
            command_pool: 0
            command_buffers: [null; 2]
            image_available_semaphores: [0; 2]
            render_finished_semaphores: [0; 2]
            in_flight_fences: [0; 2]
            current_frame: 0
            width: width
            height: height
            is_initialized: true
            vsync_enabled: true
        }
    }

    fn begin_frame(self): bool {
        // Wait for previous frame
        let fence = self.in_flight_fences[self.current_frame]
        if fence != 0 {
            vkWaitForFences(self.device, 1, &fence, 1, 0xFFFFFFFFFFFFFFFF)
            vkResetFences(self.device, 1, &fence)
        }

        // Acquire next swapchain image
        var image_index: u32 = 0
        let result = vkAcquireNextImageKHR(
            self.device,
            self.swapchain,
            0xFFFFFFFFFFFFFFFF,
            self.image_available_semaphores[self.current_frame],
            0,
            &image_index
        )

        if result != VK_SUCCESS {
            return false
        }

        // Reset and begin command buffer
        let cmd = self.command_buffers[self.current_frame]
        vkResetCommandBuffer(cmd, 0)

        // Begin command buffer recording
        // ... (simplified for brevity)

        return true
    }

    fn end_frame(self) {
        let cmd = self.command_buffers[self.current_frame]
        vkEndCommandBuffer(cmd)

        // Submit command buffer
        let wait_stages: VkFlags = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT
        let submit_info = VkSubmitInfo {
            sType: VK_STRUCTURE_TYPE_SUBMIT_INFO
            pNext: null
            waitSemaphoreCount: 1
            pWaitSemaphores: &self.image_available_semaphores[self.current_frame]
            pWaitDstStageMask: &wait_stages
            commandBufferCount: 1
            pCommandBuffers: &cmd
            signalSemaphoreCount: 1
            pSignalSemaphores: &self.render_finished_semaphores[self.current_frame]
        }

        vkQueueSubmit(self.graphics_queue, 1, &submit_info, self.in_flight_fences[self.current_frame])

        // Present
        var image_index: u32 = 0  // Would be set from begin_frame
        let present_info = VkPresentInfoKHR {
            sType: VK_STRUCTURE_TYPE_PRESENT_INFO_KHR
            pNext: null
            waitSemaphoreCount: 1
            pWaitSemaphores: &self.render_finished_semaphores[self.current_frame]
            swapchainCount: 1
            pSwapchains: &self.swapchain
            pImageIndices: &image_index
            pResults: null
        }

        vkQueuePresentKHR(self.present_queue, &present_info)

        self.current_frame = (self.current_frame + 1) % MAX_FRAMES_IN_FLIGHT
    }

    fn resize(self, width: u32, height: u32) {
        vkDeviceWaitIdle(self.device)

        self.width = width
        self.height = height
        self.swapchain_extent = VkExtent2D { width: width, height: height }

        // Recreate swapchain
        self.recreate_swapchain()
    }

    fn recreate_swapchain(self) {
        // Cleanup old swapchain resources
        for i in 0..self.swapchain_image_count {
            if self.framebuffers[i] != 0 {
                vkDestroyFramebuffer(self.device, self.framebuffers[i], null)
            }
            if self.swapchain_image_views[i] != 0 {
                vkDestroyImageView(self.device, self.swapchain_image_views[i], null)
            }
        }

        // Recreate swapchain, image views, and framebuffers
        // ... (implementation details)
    }

    fn create_shader_module(self, spirv_code: []u8): VkShaderModule {
        var shader_module: VkShaderModule = 0
        // Create shader module from SPIR-V bytecode
        // ... (implementation details)
        return shader_module
    }

    fn create_buffer(self, size: VkDeviceSize, usage: VkFlags, properties: VkFlags): (VkBuffer, VkDeviceMemory) {
        var buffer: VkBuffer = 0
        var memory: VkDeviceMemory = 0
        // Create buffer and allocate memory
        // ... (implementation details)
        return (buffer, memory)
    }

    fn create_vertex_buffer(self, vertices: []f32): VkBuffer {
        let size = @intCast(VkDeviceSize, vertices.len * @sizeOf(f32))
        let (buffer, memory) = self.create_buffer(
            size,
            VK_BUFFER_USAGE_VERTEX_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
            VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT
        )

        // Copy data to buffer via staging buffer
        // ... (implementation details)

        return buffer
    }

    fn create_index_buffer(self, indices: []u32): VkBuffer {
        let size = @intCast(VkDeviceSize, indices.len * @sizeOf(u32))
        let (buffer, memory) = self.create_buffer(
            size,
            VK_BUFFER_USAGE_INDEX_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
            VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT
        )

        return buffer
    }

    fn draw_indexed(self, index_count: u32, pipeline: VkPipeline) {
        let cmd = self.command_buffers[self.current_frame]

        vkCmdBindPipeline(cmd, 0, pipeline)  // VK_PIPELINE_BIND_POINT_GRAPHICS = 0
        vkCmdDrawIndexed(cmd, index_count, 1, 0, 0, 0)
    }

    fn set_viewport(self, x: f32, y: f32, width: f32, height: f32) {
        let cmd = self.command_buffers[self.current_frame]

        let viewport = VkViewport {
            x: x
            y: y
            width: width
            height: height
            minDepth: 0.0
            maxDepth: 1.0
        }

        vkCmdSetViewport(cmd, 0, 1, &viewport)
    }

    fn shutdown(self) {
        if self.device {
            vkDeviceWaitIdle(self.device)

            // Destroy sync objects
            for i in 0..MAX_FRAMES_IN_FLIGHT {
                if self.image_available_semaphores[i] != 0 {
                    vkDestroySemaphore(self.device, self.image_available_semaphores[i], null)
                }
                if self.render_finished_semaphores[i] != 0 {
                    vkDestroySemaphore(self.device, self.render_finished_semaphores[i], null)
                }
                if self.in_flight_fences[i] != 0 {
                    vkDestroyFence(self.device, self.in_flight_fences[i], null)
                }
            }

            // Destroy command pool
            if self.command_pool != 0 {
                vkDestroyCommandPool(self.device, self.command_pool, null)
            }

            // Destroy framebuffers
            for i in 0..self.swapchain_image_count {
                if self.framebuffers[i] != 0 {
                    vkDestroyFramebuffer(self.device, self.framebuffers[i], null)
                }
            }

            // Destroy render pass
            if self.render_pass != 0 {
                vkDestroyRenderPass(self.device, self.render_pass, null)
            }

            // Destroy image views
            for i in 0..self.swapchain_image_count {
                if self.swapchain_image_views[i] != 0 {
                    vkDestroyImageView(self.device, self.swapchain_image_views[i], null)
                }
            }

            // Destroy swapchain
            if self.swapchain != 0 {
                vkDestroySwapchainKHR(self.device, self.swapchain, null)
            }

            vkDestroyDevice(self.device, null)
        }

        if self.instance {
            vkDestroyInstance(self.instance, null)
        }

        self.is_initialized = false
    }
}

fn load_vulkan_functions(): bool {
    // Load Vulkan library (platform-specific)
    // For Windows: vulkan-1.dll
    // For Linux: libvulkan.so.1
    // For macOS: libMoltenVK.dylib

    // Load global functions
    // vkGetInstanceProcAddr, vkCreateInstance, etc.

    return true
}

// Export functions
export fn create_vulkan_renderer(width: u32, height: u32): ?*VulkanRenderer {
    let renderer = VulkanRenderer::init(width, height)
    if renderer {
        let ptr = @alloc(VulkanRenderer, 1)
        ptr.* = renderer.?
        return ptr
    }
    return null
}

export fn destroy_vulkan_renderer(renderer: *VulkanRenderer) {
    renderer.shutdown()
}
