// Mouse button codes
enum MouseButton {
    Left
    Right
    Middle
    X1
    X2
}

// Input state structure
struct InputState {
    keys_pressed: [bool; 128]
    keys_down: [bool; 128]
    mouse_x: i32
    mouse_y: i32
    mouse_buttons: [bool; 5]
    scroll_delta: f32
}

fn create_input_state(): InputState {
    return InputState {
        keys_pressed: [false; 128],
        keys_down: [false; 128],
        mouse_x: 0,
        mouse_y: 0,
        mouse_buttons: [false; 5],
        scroll_delta: 0.0,
    }
}
