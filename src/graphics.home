// Graphics module - re-exports common graphics types
// This module provides a unified entry point for graphics-related types

import math/vector2
import math/vector3
import math/vector4
import math/quaternion

// Re-export vector types from math module
type Vec2 = vector2::Vec2
type Vec3 = vector3::Vec3
type Vec4 = vector4::Vec4
type Quaternion = quaternion::Quaternion

// Re-export graphics components from graphics directory
import graphics/mesh
import graphics/shader
import graphics/terrain
import graphics/particles
import graphics/renderer
import graphics/render_optimizer
import graphics/w3d_loader

// Re-export common types
type Mesh = mesh::Mesh
type MeshVertex = mesh::MeshVertex
type Shader = shader::Shader
type Terrain = terrain::Terrain
type ParticleSystem = particles::ParticleSystem
type ParticleEmitter = particles::ParticleEmitter
