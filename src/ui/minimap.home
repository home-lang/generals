// C&C Generals Zero Hour - Home Port
// Minimap System
//
// Simplified implementation for Home language

// Minimap constants
let MINIMAP_WIDTH: i32 = 180
let MINIMAP_HEIGHT: i32 = 160
let MINIMAP_SCALE: f64 = 0.1

// Minimap icon types
enum MinimapIconType {
    Infantry,
    Vehicle,
    Aircraft,
    Building,
    Resource,
    Rally,
    Ping,
}

// Color struct
struct Color {
    r: f64,
    g: f64,
    b: f64,
    a: f64,
}

impl Color {
    fn init(r: f64, g: f64, b: f64, a: f64): Color {
        return Color { r: r, g: g, b: b, a: a }
    }
}

// Vec2 helper
struct Vec2 {
    x: f64,
    y: f64,
}

impl Vec2 {
    fn init(x: f64, y: f64): Vec2 {
        return Vec2 { x: x, y: y }
    }
}

// Vec3 helper
struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

impl Vec3 {
    fn init(x: f64, y: f64, z: f64): Vec3 {
        return Vec3 { x: x, y: y, z: z }
    }
}

// Rect helper
struct Rect {
    x: i32,
    y: i32,
    width: i32,
    height: i32,
}

impl Rect {
    fn init(x: i32, y: i32, width: i32, height: i32): Rect {
        return Rect { x: x, y: y, width: width, height: height }
    }
}

// Minimap icon
struct MinimapIcon {
    icon_type: MinimapIconType,
    position: Vec2,
    color: Color,
    size: i32,
    team: i32,
    is_visible: bool,
}

impl MinimapIcon {
    fn init(icon_type: MinimapIconType, x: f64, y: f64, color: Color): MinimapIcon {
        return MinimapIcon {
            icon_type: icon_type,
            position: Vec2::init(x, y),
            color: color,
            size: 2,
            team: 0,
            is_visible: true,
        }
    }
}

// Minimap display
struct Minimap {
    map_width: f64,
    map_height: f64,
    pixels_per_world_unit: f64,
    buffer_width: i32,
    buffer_height: i32,
    needs_terrain_update: bool,
    icon_count: i32,
    camera_rect: Rect,
    camera_position: Vec3,
    camera_zoom: f64,
    is_dragging: bool,
    show_terrain: bool,
    show_shroud: bool,
    show_units: bool,
    show_buildings: bool,
}

impl Minimap {
    fn init(): Minimap {
        return Minimap {
            map_width: 1000.0,
            map_height: 1000.0,
            pixels_per_world_unit: 0.18,
            buffer_width: MINIMAP_WIDTH,
            buffer_height: MINIMAP_HEIGHT,
            needs_terrain_update: true,
            icon_count: 0,
            camera_rect: Rect::init(0, 0, 100, 100),
            camera_position: Vec3::init(0.0, 0.0, 0.0),
            camera_zoom: 1.0,
            is_dragging: false,
            show_terrain: true,
            show_shroud: true,
            show_units: true,
            show_buildings: true,
        }
    }

    fn update(&self, delta_time: f64, camera_pos: Vec3, camera_zoom: f64) {
        self.camera_position = camera_pos
        self.camera_zoom = camera_zoom
    }

    fn render(&self, renderer: Renderer) {
        // Render minimap
    }
}

// Helper function to get team color
fn get_team_color(team: i32): Color {
    if team == 0 {
        return Color::init(1.0, 0.0, 0.0, 1.0)  // Red
    } else if team == 1 {
        return Color::init(0.0, 0.0, 1.0, 1.0)  // Blue
    } else if team == 2 {
        return Color::init(0.0, 1.0, 0.0, 1.0)  // Green
    } else {
        return Color::init(0.5, 0.5, 0.5, 1.0)  // Gray
    }
}
